#include <cmath>
#include "kernel_operator.h"

/*
 * Sub Kernel — Ascend C Direct Invocation
 * z = x - y (element-wise, ND, float32 / float16)
 *
 * 实现要点：
 *   1. host 侧 run_kernel 依据张量 shape 计算总元素数，按 32B 对齐做多核切分 + tile 切分；
 *   2. kernel 侧 KernelSub 用 TPipe + 3 个 TQue（x / y / z）做 double buffer 流水；
 *   3. CopyIn -> Compute(Sub) -> CopyOut 三段式，搬入搬出统一用 DataCopyPad 兜住尾块非对齐；
 *   4. dtypes 在 kernel 入口按 tiling.dtype 分发到 float / half 两个模板实例。
 */

using namespace AscendC;

namespace {
constexpr int32_t BUFFER_NUM = 2;              // double buffer
constexpr int32_t BLOCK_BYTES = 32;            // Ascend 一个 block 的字节数
constexpr int64_t UB_BUDGET = 96 * 1024;       // x/y/z 三组队列可用的 UB 预算
constexpr int32_t DTYPE_FP32 = 0;
constexpr int32_t DTYPE_FP16 = 1;
}  // namespace

struct SubCustomTilingData {
    int64_t totalLength;    // 元素总数
    int64_t blockNum;       // 实际启用的核数
    int64_t perCoreLength;  // 单核负责的元素数（32B 对齐）
    int64_t tileLength;     // 单次搬入搬出的元素数（32B 对齐）
    int32_t dtype;          // 0=fp32 1=fp16
    int32_t elemBytes;      // 单元素字节数
};

template <typename T>
class KernelSub {
public:
    __aicore__ inline KernelSub() {}

    __aicore__ inline void Init(GM_ADDR x, GM_ADDR y, GM_ADDR z, const SubCustomTilingData& tiling)
    {
        int64_t blockIdx = static_cast<int64_t>(GetBlockIdx());
        startOffset = blockIdx * tiling.perCoreLength;

        int64_t left = tiling.totalLength - startOffset;
        if (left <= 0) {
            coreLength = 0;
            return;
        }
        coreLength = (left > tiling.perCoreLength) ? tiling.perCoreLength : left;
        tileLength = (tiling.tileLength > 0) ? tiling.tileLength : coreLength;

        // GM 上按核切片的基址，后续 CopyIn/CopyOut 只在核内偏移
        xGm.SetGlobalBuffer((__gm__ T*)x + startOffset, coreLength);
        yGm.SetGlobalBuffer((__gm__ T*)y + startOffset, coreLength);
        zGm.SetGlobalBuffer((__gm__ T*)z + startOffset, coreLength);

        uint32_t bufferBytes = static_cast<uint32_t>(tileLength * sizeof(T));
        pipe.InitBuffer(inQueueX, BUFFER_NUM, bufferBytes);
        pipe.InitBuffer(inQueueY, BUFFER_NUM, bufferBytes);
        pipe.InitBuffer(outQueueZ, BUFFER_NUM, bufferBytes);
    }

    __aicore__ inline void Process()
    {
        if (coreLength <= 0) {
            return;
        }
        for (int64_t done = 0; done < coreLength; done += tileLength) {
            int64_t count = coreLength - done;
            if (count > tileLength) {
                count = tileLength;
            }
            CopyIn(done, count);
            Compute(count);
            CopyOut(done, count);
        }
    }

private:
    __aicore__ inline void CopyIn(int64_t offset, int64_t count)
    {
        LocalTensor<T> xLocal = inQueueX.AllocTensor<T>();
        LocalTensor<T> yLocal = inQueueY.AllocTensor<T>();

        // blockLen 以字节为单位；DataCopyPad 自动补齐 tail，容忍非 32B 对齐长度
        DataCopyExtParams copyParams{1, static_cast<uint32_t>(count * sizeof(T)), 0, 0, 0};
        DataCopyPadExtParams<T> padParams{false, 0, 0, 0};

        DataCopyPad(xLocal, xGm[offset], copyParams, padParams);
        DataCopyPad(yLocal, yGm[offset], copyParams, padParams);

        inQueueX.EnQue(xLocal);
        inQueueY.EnQue(yLocal);
    }

    __aicore__ inline void Compute(int64_t count)
    {
        LocalTensor<T> xLocal = inQueueX.DeQue<T>();
        LocalTensor<T> yLocal = inQueueY.DeQue<T>();
        LocalTensor<T> zLocal = outQueueZ.AllocTensor<T>();

        Sub(zLocal, xLocal, yLocal, static_cast<int32_t>(count));

        outQueueZ.EnQue<T>(zLocal);
        inQueueX.FreeTensor(xLocal);
        inQueueY.FreeTensor(yLocal);
    }

    __aicore__ inline void CopyOut(int64_t offset, int64_t count)
    {
        LocalTensor<T> zLocal = outQueueZ.DeQue<T>();
        DataCopyExtParams copyParams{1, static_cast<uint32_t>(count * sizeof(T)), 0, 0, 0};
        DataCopyPad(zGm[offset], zLocal, copyParams);
        outQueueZ.FreeTensor(zLocal);
    }

    TPipe pipe;
    TQue<QuePosition::VECIN, BUFFER_NUM> inQueueX;
    TQue<QuePosition::VECIN, BUFFER_NUM> inQueueY;
    TQue<QuePosition::VECOUT, BUFFER_NUM> outQueueZ;
    GlobalTensor<T> xGm;
    GlobalTensor<T> yGm;
    GlobalTensor<T> zGm;
    int64_t startOffset = 0;
    int64_t coreLength = 0;
    int64_t tileLength = 1;
};

__global__ __vector__ void sub_custom(GM_ADDR x, GM_ADDR y, GM_ADDR z, SubCustomTilingData tiling)
{
    if (tiling.dtype == DTYPE_FP32) {
        KernelSub<float> op;
        op.Init(x, y, z, tiling);
        op.Process();
    } else {
        KernelSub<half> op;
        op.Init(x, y, z, tiling);
        op.Process();
    }
}

extern "C" void run_kernel(GM_ADDR x, const TensorGroupInfo& info_x, GM_ADDR y, const TensorGroupInfo& info_y, GM_ADDR z, const TensorGroupInfo& info_z, int64_t availableCoreNum, aclrtStream stream)
{
    (void)info_y;
    (void)info_z;

    const TensorInfo& info = info_x.tensors[0];

    int64_t totalLength = 1;
    for (int64_t i = 0; i < info.numDims; ++i) {
        totalLength *= info.shape[i];
    }
    if (totalLength <= 0) {
        return;
    }

    int32_t elemBytes = 4;
    if (info.dtype == DTYPE_FP16 || info.dtype == 2) {  // fp16 / bf16 均按 2 字节
        elemBytes = 2;
    }

    // 32B 对齐粒度：fp32 为 8 个元素，fp16 为 16 个元素
    int64_t alignElem = BLOCK_BYTES / elemBytes;
    int64_t units = (totalLength + alignElem - 1) / alignElem;

    // 多核切分：核数不超过 32B 单元数，避免空核启动
    int64_t cores = (availableCoreNum > 0) ? availableCoreNum : units;
    if (cores > units) {
        cores = units;
    }
    if (cores < 1) {
        cores = 1;
    }
    int64_t perCoreUnits = (units + cores - 1) / cores;
    int64_t perCoreLength = perCoreUnits * alignElem;
    int64_t blockNum = (units + perCoreUnits - 1) / perCoreUnits;

    // tile 切分：受 UB 预算约束，始终保持 32B 对齐
    int64_t maxTile = UB_BUDGET / (BUFFER_NUM * 3 * elemBytes);
    maxTile = maxTile / alignElem * alignElem;
    if (maxTile < alignElem) {
        maxTile = alignElem;
    }
    int64_t tileLength = (perCoreLength < maxTile) ? perCoreLength : maxTile;
    tileLength = (tileLength + alignElem - 1) / alignElem * alignElem;

    SubCustomTilingData tiling;
    tiling.totalLength = totalLength;
    tiling.blockNum = blockNum;
    tiling.perCoreLength = perCoreLength;
    tiling.tileLength = tileLength;
    tiling.dtype = (elemBytes == 4) ? DTYPE_FP32 : DTYPE_FP16;
    tiling.elemBytes = elemBytes;

    sub_custom<<<static_cast<uint32_t>(blockNum), nullptr, stream>>>(x, y, z, tiling);
}
