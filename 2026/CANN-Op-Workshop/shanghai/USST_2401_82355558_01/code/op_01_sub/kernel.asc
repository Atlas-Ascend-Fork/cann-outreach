#include <cmath>
#include "kernel_operator.h"

// ---------------------------------------------------------------------------
// Tiling 参数：由 host 侧 run_kernel 计算后按值传给核函数
// ---------------------------------------------------------------------------
struct SubCustomTilingData {
    uint32_t totalLength; // 待处理数据总长度（单位：元素个数）
    uint32_t tileNum;     // 单核内将数据进一步切分为多少块（Tile）
};

constexpr uint32_t BUFFER_NUM = 2;
constexpr uint32_t QUEUE_DEPTH = 1;

// ---------------------------------------------------------------------------
// KernelSub：z = x - y
// 每个核按 tileNum × BUFFER_NUM 分块循环计算
// 模板化实现，支持 float / half 等类型
// ---------------------------------------------------------------------------
template <typename T>
class KernelSub {
public:
    __aicore__ inline KernelSub() {}

    __aicore__ inline void Init(
        GM_ADDR x,
        GM_ADDR y,
        GM_ADDR z,
        const SubCustomTilingData& tiling)
    {
        uint32_t totalLength = tiling.totalLength;
        uint32_t tileNum = tiling.tileNum;

        // 计算每个核处理的数据长度
        this->blockLength = totalLength / AscendC::GetBlockNum();

        // 单核内分块数
        this->tileNum = tileNum;

        // 单次处理的元素数
        this->tileLength =
            this->blockLength / tileNum / BUFFER_NUM;

        // 设置每个核的 Global Memory 起始地址
        xGm.SetGlobalBuffer(
            (__gm__ T*)x +
            this->blockLength * AscendC::GetBlockIdx(),
            this->blockLength);

        yGm.SetGlobalBuffer(
            (__gm__ T*)y +
            this->blockLength * AscendC::GetBlockIdx(),
            this->blockLength);

        zGm.SetGlobalBuffer(
            (__gm__ T*)z +
            this->blockLength * AscendC::GetBlockIdx(),
            this->blockLength);

        // 为输入和输出队列分配 UB 内存
        pipe.InitBuffer(
            inQueueX,
            BUFFER_NUM,
            this->tileLength * sizeof(T));

        pipe.InitBuffer(
            inQueueY,
            BUFFER_NUM,
            this->tileLength * sizeof(T));

        pipe.InitBuffer(
            outQueueZ,
            BUFFER_NUM,
            this->tileLength * sizeof(T));
    }

    __aicore__ inline void Process()
    {
        // 总循环次数
        int32_t loopCount = this->tileNum * BUFFER_NUM;

        // 依次处理每个数据块
        for (int32_t i = 0; i < loopCount; i++) {
            CopyIn(i);    // 搬入输入数据
            Compute(i);   // 执行减法运算
            CopyOut(i);   // 搬出计算结果
        }
    }

private:
    // -----------------------------------------------------------------------
    // CopyIn：将 Global Memory 中的数据搬运到 Local Memory
    // -----------------------------------------------------------------------
    __aicore__ inline void CopyIn(int32_t progress)
    {
        // 分配输入数据的 LocalTensor
        AscendC::LocalTensor<T> xLocal =
            inQueueX.AllocTensor<T>();

        AscendC::LocalTensor<T> yLocal =
            inQueueY.AllocTensor<T>();

        // 将当前数据块搬入本地内存
        AscendC::DataCopy(
            xLocal,
            xGm[progress * this->tileLength],
            this->tileLength);

        AscendC::DataCopy(
            yLocal,
            yGm[progress * this->tileLength],
            this->tileLength);

        // 将输入数据放入队列
        inQueueX.EnQue(xLocal);
        inQueueY.EnQue(yLocal);
    }

    // -----------------------------------------------------------------------
    // Compute：执行逐元素减法 z = x - y
    // -----------------------------------------------------------------------
    __aicore__ inline void Compute(int32_t progress)
    {
        // 从输入队列获取数据
        AscendC::LocalTensor<T> xLocal =
            inQueueX.DeQue<T>();

        AscendC::LocalTensor<T> yLocal =
            inQueueY.DeQue<T>();

        // 分配输出数据的 LocalTensor
        AscendC::LocalTensor<T> zLocal =
            outQueueZ.AllocTensor<T>();

        // 执行矢量减法：zLocal[i] = xLocal[i] - yLocal[i]
        AscendC::Sub(
            zLocal,
            xLocal,
            yLocal,
            this->tileLength);

        // 将计算结果放入输出队列
        outQueueZ.EnQue<T>(zLocal);

        // 释放输入数据占用的本地内存
        inQueueX.FreeTensor(xLocal);
        inQueueY.FreeTensor(yLocal);
    }

    // -----------------------------------------------------------------------
    // CopyOut：将计算结果从 Local Memory 搬运到 Global Memory
    // -----------------------------------------------------------------------
    __aicore__ inline void CopyOut(int32_t progress)
    {
        // 从输出队列获取计算结果
        AscendC::LocalTensor<T> zLocal =
            outQueueZ.DeQue<T>();

        // 将结果写回 Global Memory
        AscendC::DataCopy(
            zGm[progress * this->tileLength],
            zLocal,
            this->tileLength);

        // 释放输出数据占用的本地内存
        outQueueZ.FreeTensor(zLocal);
    }

private:
    AscendC::TPipe pipe;

    // 输入队列
    AscendC::TQue<AscendC::QuePosition::VECIN, QUEUE_DEPTH>
        inQueueX, inQueueY;

    // 输出队列
    AscendC::TQue<AscendC::QuePosition::VECOUT, QUEUE_DEPTH>
        outQueueZ;

    // 输入和输出的 Global Memory
    AscendC::GlobalTensor<T> xGm, yGm, zGm;

    uint32_t blockLength; // 每个核处理的元素数
    uint32_t tileNum;     // 单核内分块数
    uint32_t tileLength;  // 每个数据块的元素数
};

// ---------------------------------------------------------------------------
// 核函数入口：实例化 KernelSub<T> 并执行
// ---------------------------------------------------------------------------
template <typename T>
__global__ __vector__ void sub_custom(
    GM_ADDR x,
    GM_ADDR y,
    GM_ADDR z,
    SubCustomTilingData tiling)
{
    KernelSub<T> op;

    op.Init(x, y, z, tiling);
    op.Process();
}

// ---------------------------------------------------------------------------
// Host 侧启动函数：计算 tiling 参数并启动核函数
// ---------------------------------------------------------------------------
extern "C" void run_kernel(
    GM_ADDR x,
    const TensorGroupInfo& info_x,
    GM_ADDR y,
    const TensorGroupInfo& info_y,
    GM_ADDR z,
    const TensorGroupInfo& info_z,
    int64_t availableCoreNum,
    aclrtStream stream)
{
    // 启动 8 个核
    constexpr uint32_t blockDim = 8;

    // 1. 获取总元素数
    const TensorInfo& t0 = info_x.tensors[0];

    int64_t totalLength = 1;

    for (int64_t i = 0; i < t0.numDims; i++) {
        totalLength *= t0.shape[i];
    }

    // 2. 根据输入数据类型选择核函数实例
    // dtype: 0 = fp32, 1 = fp16, 2 = bf16 等
    int32_t dtype = t0.dtype;

    // 单核内分块数
    uint32_t tileNum = 8;

    // 3. 构造 tiling 参数
    SubCustomTilingData tiling = {
        (uint32_t)totalLength,
        tileNum
    };

    // 4. 根据数据类型启动对应的核函数
    if (dtype == 1) {
        // FP16 减法
        sub_custom<half>
            <<<blockDim, nullptr, stream>>>(x, y, z, tiling);
    } else {
        // FP32 减法
        sub_custom<float>
            <<<blockDim, nullptr, stream>>>(x, y, z, tiling);
    }
}

