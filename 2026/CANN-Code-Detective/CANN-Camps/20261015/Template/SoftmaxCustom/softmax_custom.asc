/* !
 * \file softmax_custom.asc
 * \brief CANN训练营 · SoftmaxCustom 代码骨架：基于 RegBase（reg 矢量编程）实现行 Softmax
 *
 * softmax 的数学定义（按最后一维，即每一行做归一化）：
 *
 *     Softmax(x[i][j]) = exp(x[i][j] - max_j(x[i][j])) / Σ_j exp(x[i][j] - max_j(x[i][j]))
 *
 * 本题采用 **RegBase（reg 矢量编程）**：核函数以 __global__ __vector__ 声明，
 * 计算主体写成 __simd_vf__ 向量函数，直接在向量寄存器上完成运算，
 * 而不使用 TPipe/TQue + LocalTensor 的 MemBase 三段式流水。
 *
 * 核函数以外的主机侧代码（数据准备、<<<>>> 启动配置、golden 计算、精度校验）已给出，无需修改；
 * 需要你补全的是 VF 函数 softmax_vf() 的函数体。
 *
 * 完成填空后，VF 内的计算流程（对每一行）为：
 *   步骤1: 求每行最大值          步骤2: 对最大值做填充扩展
 *   步骤3: 各元素减去最大值        步骤4: 指数运算
 *   步骤5: 每行求和              步骤6: 求和结果填充扩展
 *   步骤7: 归一化
 */

#include <iostream>
#include <iomanip>
#include <vector>
#include <algorithm>
#include <random>
#include <cmath>
#include "acl/acl.h"
#include "c_api/asc_simd.h"

// ===========================================================================
// 算子常量
// ===========================================================================
namespace Custom {
union DataUnion {
    constexpr __aicore__ DataUnion() : f(0.0f) {}
    constexpr __aicore__ DataUnion(uint32_t val) : i(val) {}
    float f;
    uint32_t i;
};
// float32 能表示的最小规格化正数，可用作 ReduceMax 的初值（比任何输入都小）
constexpr DataUnion fp32_min_value(0x00800000u);
} // namespace Custom

constexpr uint32_t LOOP_COUNT = 1024;                              // 单核上划分成多少个 VF
constexpr uint32_t WIDTH = 128;                                    // 输入数据的列数（每行长度）
constexpr uint32_t SINGLE_VF_HEIGHT = 80;                          // 单个 VF 处理的数据行数
constexpr uint32_t SINGLE_VF_DATA_LEN = SINGLE_VF_HEIGHT * WIDTH;   // 单个 VF 的数据量

// ===========================================================================
// 【请补充】VF 函数：reg 矢量编程核心
// ---------------------------------------------------------------------------
// 在向量寄存器上逐行完成 softmax：
//   第一部分: ReduceMax(行最大值) -> Sub(x - max) -> Exp，结果写入 exp_ub
//   第二部分: ReduceSum(行内和)  -> Div(exp / sum)，结果写入 dst_ub
//
// 参数说明:
//   dst_ub : 输出 UB 地址
//   src_ub : 输入 UB 地址
//   exp_ub : 中间结果 exp(x - max) 的 UB 地址
//   sum_ub : 预留 UB 地址（可按需使用或不用）
//   one_repeat_cnt : 一条向量指令可处理的 float 元素个数，由核函数传入（不要在本函数内调用 asc_get_vf_len()）
//
// 可供参考的接口（签名以 CANN 自带头文件 c_api/ 为准）:
//   掩码  : asc_create_mask_b32(PAT_ALL) / asc_update_mask_b32(count)
//   搬运  : asc_loadalign(reg, ub_ptr) / asc_storealign(ub_ptr, reg, mask)
//   计算  : asc_max / asc_sub / asc_exp / asc_add / asc_div
//   归约  : asc_reduce_max / asc_reduce_sum
//   广播  : asc_duplicate_scalar(reg, scalar, mask) / asc_duplicate(reg, reg, mask)
//   同步  : asc_mem_bar(VST_VLD)   —— 写 exp_ub 后要读回，必须同步
//
// 提示: 每个 repeat 最多处理 one_repeat_cnt 个元素，WIDTH=128、one_repeat_cnt=64 时
//       repeat_times = 2；可用 asc_update_mask_b32(count) 递减掩码来处理尾部。
// ===========================================================================
__simd_vf__ inline void softmax_vf(__ubuf__ float* dst_ub, __ubuf__ float* src_ub, __ubuf__ float* exp_ub,
                                   __ubuf__ float* sum_ub, const uint16_t one_repeat_cnt)
{
    // 请补充……
}

// ===========================================================================
// 核函数（已给出，无需修改）
// ---------------------------------------------------------------------------
// 1) 申请 UB 内存；2) 把数据搬入 UB；3) 调用 VF 完成计算；4) 搬出到 GM。
// ===========================================================================
__global__ __vector__ void softmax_custom(__gm__ uint8_t* x, __gm__ uint8_t* y)
{
    asc_init();

    // 向量寄存器位宽（字节）需在核函数（__aicore__ 作用域）内取得后传入 VF 函数：
    // asc_get_vf_len() 是 __aicore__ 接口，不能在 __simd_vf__ 函数内直接调用。
    const uint16_t one_repeat_cnt = asc_get_vf_len() / sizeof(float);

    // 申请 UB 内存
    __ubuf__ float src_ub[SINGLE_VF_DATA_LEN];
    __ubuf__ float dst_ub[SINGLE_VF_DATA_LEN];
    __ubuf__ float exp_ub[SINGLE_VF_DATA_LEN];
    __ubuf__ float sum_ub[SINGLE_VF_DATA_LEN];

    __gm__ float* x_gm = reinterpret_cast<__gm__ float*>(x);
    __gm__ float* y_gm = reinterpret_cast<__gm__ float*>(y);

    uint8_t mutex_id = 1;

    for (uint32_t i = 0; i < LOOP_COUNT; i++) {
        // 搬入操作需要独占 UB
        asc_lock(PIPE_MTE2, mutex_id);
        asc_set_copy_pad_val(float(0.0));
        for (uint32_t j = 0; j < SINGLE_VF_HEIGHT; j++) {
            asc_copy_gm2ub_align(&src_ub[j * WIDTH], &x_gm[i * SINGLE_VF_DATA_LEN + j * WIDTH], 1,
                                 static_cast<uint16_t>(WIDTH * sizeof(float)), 0, 0, true, 0, 0, 0);
        }
        asc_unlock(PIPE_MTE2, mutex_id);

        // 数据搬入完成后才能启动计算
        asc_lock(PIPE_V, mutex_id);
        softmax_vf(dst_ub, src_ub, exp_ub, sum_ub, one_repeat_cnt);
        asc_unlock(PIPE_V, mutex_id);

        // 计算完成后才能启动数据搬出
        asc_lock(PIPE_MTE3, mutex_id);
        for (uint32_t j = 0; j < SINGLE_VF_HEIGHT; j++) {
            asc_copy_ub2gm_align(&y_gm[i * SINGLE_VF_DATA_LEN + j * WIDTH], &dst_ub[j * WIDTH], 1,
                                 static_cast<uint16_t>(WIDTH * sizeof(float)), 0, 0, 0);
        }
        asc_unlock(PIPE_MTE3, mutex_id);
    }
}

// ===========================================================================
// 以下 host 侧代码（数据准备、golden、精度校验、main）已给出，无需修改
// ===========================================================================
constexpr uint32_t HEIGHT = SINGLE_VF_HEIGHT * LOOP_COUNT;   // 行数
constexpr uint32_t WIDTH_HOST = WIDTH;                       // 列数
constexpr uint32_t TOTAL_LEN = HEIGHT * WIDTH;

// 构造 [0, 1) 均匀分布随机输入
float random_value()
{
    static std::random_device rd;
    static std::mt19937_64 gen(rd());
    static std::uniform_real_distribution<double> dist(0.0, 1.0);
    return static_cast<float>(dist(gen));
}

void generate_test_data(std::vector<float>& values, uint32_t num, uint32_t value_dim)
{
    values.resize(static_cast<size_t>(num) * value_dim);
    for (uint32_t i = 0; i < num; ++i) {
        for (uint32_t j = 0; j < value_dim; ++j) {
            values[static_cast<size_t>(i) * value_dim + j] = random_value();
        }
    }
}

// CPU golden：按 max -> exp(x-max) -> sum -> div 逐行计算
std::vector<float> softmax_reference(const std::vector<float>& src, uint32_t height, uint32_t width)
{
    std::vector<float> dst(src.size());
    for (uint32_t row = 0; row < height; row++) {
        size_t offset = static_cast<size_t>(row) * width;
        float max_val = src[offset];
        for (uint32_t col = 1; col < width; col++) {
            max_val = std::max(max_val, src[offset + col]);
        }
        float sum_val = 0.0f;
        for (uint32_t col = 0; col < width; col++) {
            float tmp = std::exp(src[offset + col] - max_val);
            dst[offset + col] = tmp;
            sum_val += tmp;
        }
        for (uint32_t col = 0; col < width; col++) {
            dst[offset + col] = dst[offset + col] / sum_val;
        }
    }
    return dst;
}

// 精度校验：打印前 8 个元素与最大绝对误差，abs_err < 1e-4 判定通过
uint32_t verify_result(const std::vector<float>& output, const std::vector<float>& golden)
{
    constexpr size_t print_size = 8;
    std::cout << std::setprecision(8);
    std::cout << "Output: ";
    for (size_t i = 0; i < print_size && i < output.size(); i++) {
        std::cout << output[i] << " ";
    }
    std::cout << "..." << std::endl;

    std::cout << "Golden: ";
    for (size_t i = 0; i < print_size && i < golden.size(); i++) {
        std::cout << golden[i] << " ";
    }
    std::cout << "..." << std::endl;

    float max_abs_err = 0.0f;
    for (size_t i = 0; i < golden.size(); i++) {
        float err = std::abs(output[i] - golden[i]);
        if (err > max_abs_err) {
            max_abs_err = err;
        }
    }
    std::cout << "Max abs err: " << max_abs_err << std::endl;

    if (max_abs_err < 1e-4f) {
        std::cout << "[Success] Case accuracy verification passed." << std::endl;
        return 0;
    }
    std::cout << "[Failed] Case accuracy verification failed!" << std::endl;
    return 1;
}

int32_t main(int32_t argc, char* argv[])
{
    constexpr uint32_t blocks_num = 1;

    std::vector<float> src(TOTAL_LEN);
    generate_test_data(src, HEIGHT, WIDTH_HOST);
    size_t input_size = static_cast<size_t>(TOTAL_LEN) * sizeof(float);

    uint8_t* src_device = nullptr;
    uint8_t* dst_device = nullptr;

    int32_t device_id = 0;
    aclrtStream stream = nullptr;

    aclInit(nullptr);
    aclrtSetDevice(device_id);
    aclrtCreateStream(&stream);

    aclrtMalloc(reinterpret_cast<void**>(&src_device), input_size, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc(reinterpret_cast<void**>(&dst_device), input_size, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMemcpy(src_device, input_size, src.data(), input_size, ACL_MEMCPY_HOST_TO_DEVICE);

    softmax_custom<<<blocks_num, 0, stream>>>(src_device, dst_device);
    aclrtSynchronizeStream(stream);

    std::vector<float> output(TOTAL_LEN);
    aclrtMemcpy(output.data(), input_size, dst_device, input_size, ACL_MEMCPY_DEVICE_TO_HOST);

    aclrtFree(src_device);
    aclrtFree(dst_device);

    const char* err = aclGetRecentErrMsg();
    if (err != nullptr) {
        fprintf(stderr, "%s\n", err);
    }

    aclrtDestroyStream(stream);
    aclrtResetDevice(device_id);
    aclFinalize();

    std::vector<float> golden = softmax_reference(src, HEIGHT, WIDTH_HOST);
    return static_cast<int32_t>(verify_result(output, golden));
}
