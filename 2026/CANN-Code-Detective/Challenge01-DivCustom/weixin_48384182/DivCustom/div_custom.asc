// div_custom.asc

#include <cstdint>
#include <iostream>
#include <vector>
#include <algorithm>
#include <iterator>
#include "acl/acl.h"
#include "kernel_operator.h"

using namespace AscendC;

constexpr uint32_t BUFFER_NUM = 2;
constexpr uint32_t TILE_LENGTH = 256;

struct DivCustomTilingData
{
    uint32_t totalLength;
    uint32_t tileNum;
};

class KernelDiv {
public:
    __aicore__ inline KernelDiv(TPipe* pipe)
    {
        pipe_ = pipe;
    }
    
    __aicore__ inline void Init(GM_ADDR x, GM_ADDR y, GM_ADDR z, const __gm__ DivCustomTilingData* tiling)
    {
        this->tiling = tiling;
        
        totalLength = tiling->totalLength;
        tileNum = (totalLength + TILE_LENGTH - 1) / TILE_LENGTH;
        
        uint32_t elementsPerBlock = totalLength;
        
        xGm.SetGlobalBuffer((__gm__ float*)x, elementsPerBlock);
        yGm.SetGlobalBuffer((__gm__ float*)y, elementsPerBlock);
        zGm.SetGlobalBuffer((__gm__ float*)z, elementsPerBlock);
        
        pipe_->InitBuffer(inQueueX, BUFFER_NUM, TILE_LENGTH * sizeof(float));
        pipe_->InitBuffer(inQueueY, BUFFER_NUM, TILE_LENGTH * sizeof(float));
        pipe_->InitBuffer(outQueueZ, BUFFER_NUM, TILE_LENGTH * sizeof(float));
    }
    
    __aicore__ inline void Process()
    {
        for (uint32_t i = 0; i < tileNum; i++)
        {
            uint32_t count = (i == tileNum - 1) ? (totalLength - i * TILE_LENGTH) : TILE_LENGTH;
            CopyIn(count);
            Compute(count);
            CopyOut(count);
        }
    }
    
private:
    __aicore__ inline void CopyIn(uint32_t count)
    {
        LocalTensor<float> xLocal = inQueueX.AllocTensor<float>();
        LocalTensor<float> yLocal = inQueueY.AllocTensor<float>();
        
        uint32_t offset = curOffset;
        DataCopy(xLocal, xGm[offset], count);
        DataCopy(yLocal, yGm[offset], count);
        
        curOffset += count;
        
        inQueueX.EnQue(xLocal);
        inQueueY.EnQue(yLocal);
    }
    
    __aicore__ inline void Compute(uint32_t count)
    {
        LocalTensor<float> xLocal = inQueueX.DeQue<float>();
        LocalTensor<float> yLocal = inQueueY.DeQue<float>();
        LocalTensor<float> zLocal = outQueueZ.AllocTensor<float>();
        
        for (uint32_t i = 0; i < count; i++) {
            float valX = xLocal.GetValue(i);
            float valY = yLocal.GetValue(i);
            zLocal.SetValue(i, valX / valY);
        }
        
        outQueueZ.EnQue<float>(zLocal);
        inQueueX.FreeTensor(xLocal);
        inQueueY.FreeTensor(yLocal);
    }
    
    __aicore__ inline void CopyOut(uint32_t count)
    {
        LocalTensor<float> zLocal = outQueueZ.DeQue<float>();
        
        uint32_t offset = curOutOffset;
        DataCopy(zGm[offset], zLocal, count);
        
        curOutOffset += count;
        
        outQueueZ.FreeTensor(zLocal);
    }
    
private:
    TPipe* pipe_;
    const __gm__ DivCustomTilingData* tiling;
    
    GlobalTensor<float> xGm;
    GlobalTensor<float> yGm;
    GlobalTensor<float> zGm;
    
    TQue<TPosition::VECIN, BUFFER_NUM> inQueueX;
    TQue<TPosition::VECIN, BUFFER_NUM> inQueueY;
    TQue<TPosition::VECOUT, BUFFER_NUM> outQueueZ;
    
    uint32_t totalLength;
    uint32_t tileNum;
    uint32_t curOffset = 0;
    uint32_t curOutOffset = 0;
};

extern "C" __global__ __aicore__ void div_custom(GM_ADDR x, GM_ADDR y, GM_ADDR z, const __gm__ DivCustomTilingData* tiling)
{
    TPipe pipe;
    KernelDiv op(&pipe);
    op.Init(x, y, z, tiling);
    op.Process();
}

std::vector<float> kernel_div(std::vector<float> &x, std::vector<float> &y)
{
    if (x.size() != y.size()) {
        std::cerr << "Error: x and y must have the same size!" << std::endl;
        return {};
    }
    
    uint32_t totalLength = x.size();
    
    if (totalLength == 0) {
        std::cerr << "Error: input vectors cannot be empty!" << std::endl;
        return {};
    }
    
    std::vector<float> output(totalLength, 0.0f);
    
    aclError ret = ACL_SUCCESS;
    
    ret = aclInit(nullptr);
    if (ret != ACL_SUCCESS) {
        std::cerr << "Error: aclInit failed" << std::endl;
        return {};
    }
    
    ret = aclrtSetDevice(0);
    if (ret != ACL_SUCCESS) {
        std::cerr << "Error: aclrtSetDevice failed" << std::endl;
        aclFinalize();
        return {};
    }
    
    aclrtStream stream = nullptr;
    ret = aclrtCreateStream(&stream);
    if (ret != ACL_SUCCESS) {
        std::cerr << "Error: aclrtCreateStream failed" << std::endl;
        aclrtResetDevice(0);
        aclFinalize();
        return {};
    }
    
    void* xDev = nullptr;
    void* yDev = nullptr;
    void* zDev = nullptr;
    void* tilingDev = nullptr;
    
    ret = aclrtMalloc((void**)&xDev, totalLength * sizeof(float), ACL_MEM_MALLOC_HUGE_FIRST);
    ret = aclrtMalloc((void**)&yDev, totalLength * sizeof(float), ACL_MEM_MALLOC_HUGE_FIRST);
    ret = aclrtMalloc((void**)&zDev, totalLength * sizeof(float), ACL_MEM_MALLOC_HUGE_FIRST);
    ret = aclrtMalloc((void**)&tilingDev, sizeof(DivCustomTilingData), ACL_MEM_MALLOC_HUGE_FIRST);
    
    if (xDev == nullptr || yDev == nullptr || zDev == nullptr || tilingDev == nullptr) {
        std::cerr << "Error: aclrtMalloc failed" << std::endl;
        aclrtFree(xDev);
        aclrtFree(yDev);
        aclrtFree(zDev);
        aclrtFree(tilingDev);
        aclrtDestroyStream(stream);
        aclrtResetDevice(0);
        aclFinalize();
        return {};
    }
    
    ret = aclrtMemcpy(xDev, totalLength * sizeof(float), x.data(), totalLength * sizeof(float), ACL_MEMCPY_HOST_TO_DEVICE);
    ret = aclrtMemcpy(yDev, totalLength * sizeof(float), y.data(), totalLength * sizeof(float), ACL_MEMCPY_HOST_TO_DEVICE);
    
    DivCustomTilingData tiling;
    tiling.totalLength = totalLength;
    tiling.tileNum = (totalLength + TILE_LENGTH - 1) / TILE_LENGTH;
    
    ret = aclrtMemcpy(tilingDev, sizeof(DivCustomTilingData), &tiling, sizeof(DivCustomTilingData), ACL_MEMCPY_HOST_TO_DEVICE);
    
    div_custom<<<1, nullptr, stream>>>(
        (GM_ADDR)xDev,
        (GM_ADDR)yDev,
        (GM_ADDR)zDev,
        (const __gm__ DivCustomTilingData*)tilingDev
    );
    
    ret = aclrtSynchronizeStream(stream);
    
    ret = aclrtMemcpy(output.data(), totalLength * sizeof(float), zDev, totalLength * sizeof(float), ACL_MEMCPY_DEVICE_TO_HOST);
    
    aclrtFree(xDev);
    aclrtFree(yDev);
    aclrtFree(zDev);
    aclrtFree(tilingDev);
    aclrtDestroyStream(stream);
    aclrtResetDevice(0);
    aclFinalize();
    
    return output;
}

uint32_t VerifyResult(std::vector<float> &output, std::vector<float> &golden)
{
    auto printTensor = [](std::vector<float> &tensor, const char *name) {
        constexpr size_t maxPrintSize = 20;
        std::cout << name << ": ";
        std::copy(tensor.begin(), tensor.begin() + std::min(tensor.size(), maxPrintSize),
            std::ostream_iterator<float>(std::cout, " "));
        if (tensor.size() > maxPrintSize) {
            std::cout << "...";
        }
        std::cout << std::endl;
    };
    printTensor(output, "Output");
    printTensor(golden, "Golden");
    if (std::equal(golden.begin(), golden.end(), output.begin())) {
        std::cout << "[Success] Case accuracy is verification passed." << std::endl;
        return 0;
    } else {
        std::cout << "[Failed] Case accuracy is verification failed!" << std::endl;
        return 1;
    }
}

int32_t main(int32_t argc, char *argv[])
{
    constexpr uint32_t totalLength = 8 * 2048;
    constexpr float valueX = 1.2f;
    constexpr float valueY = 2.3f;
    std::vector<float> x(totalLength, valueX);
    std::vector<float> y(totalLength, valueY);

    std::vector<float> output = kernel_div(x, y);
    std::vector<float> golden(totalLength, valueX / valueY);
    return VerifyResult(output, golden);
}
