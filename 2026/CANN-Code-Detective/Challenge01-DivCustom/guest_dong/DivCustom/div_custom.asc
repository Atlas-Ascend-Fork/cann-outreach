// div_custom.asc

#include <cstdint>
#include <iostream>
#include <vector>
#include <algorithm>
#include <iterator>
#include "acl/acl.h"
#include "kernel_operator.h"

constexpr uint32_t BUFFER_NUM = 2; // tensor num for each queue

struct DivCustomTilingData
{
    uint32_t totalLength;
    uint32_t tileNum;
};

class KernelDiv {
public:
    __aicore__ inline KernelDiv(){}
    __aicore__ inline void Init(GM_ADDR x, GM_ADDR y, GM_ADDR z, uint32_t totalLength, uint32_t tileNum)
    {
        // 每个核处理的数据量，向上取整确保覆盖所有元素（尾部核可能处理少一些）
        uint32_t blockNum = AscendC::GetBlockNum();
        this->blockLength = (totalLength + blockNum - 1) / blockNum;
        // 最后一个核可能不足一个完整的blockLength
        uint32_t blockIdx = AscendC::GetBlockIdx();
        uint32_t remaining = totalLength - blockIdx * this->blockLength;
        uint32_t thisBlockLength = remaining < this->blockLength ? remaining : this->blockLength;
        // 调整blockLength为本核实际数据量
        this->blockLength = thisBlockLength;

        this->tileNum = tileNum;
        // tileLength = ceil(blockLength / (tileNum * BUFFER_NUM))，确保不遗漏元素
        uint32_t totalTiles = tileNum * BUFFER_NUM;
        this->tileLength = (this->blockLength + totalTiles - 1) / totalTiles;

        // 当前核在整个数据上的偏移
        uint32_t blockOffset = blockIdx * this->blockLength;

        xGm.SetGlobalBuffer((__gm__ float *)x + blockOffset, this->blockLength);
        yGm.SetGlobalBuffer((__gm__ float *)y + blockOffset, this->blockLength);
        zGm.SetGlobalBuffer((__gm__ float *)z + blockOffset, this->blockLength);

        pipe.InitBuffer(inQueueX, BUFFER_NUM, this->tileLength * sizeof(float));
        pipe.InitBuffer(inQueueY, BUFFER_NUM, this->tileLength * sizeof(float));
        pipe.InitBuffer(outQueueZ, BUFFER_NUM, this->tileLength * sizeof(float));
    }
    __aicore__ inline void Process()
    {
        // 主处理循环，按tile迭代执行 CopyIn -> Compute -> CopyOut
        // 总迭代次数 = tileNum * BUFFER_NUM，充分利用double buffer
        int32_t loopCount = this->tileNum * BUFFER_NUM;
        for (int32_t i = 0; i < loopCount; i++) {
            // 计算当前tile的起始位置，如果超出block长度则跳过
            uint32_t offset = i * this->tileLength;
            if (offset >= this->blockLength) break;
            CopyIn(i);
            Compute(i);
            CopyOut(i);
        }
    }

private:
    __aicore__ inline void CopyIn(int32_t progress)
    {
        uint32_t offset = progress * this->tileLength;
        uint32_t remaining = this->blockLength - offset;
        uint32_t actualTileLength = remaining < this->tileLength ? remaining : this->tileLength;

        AscendC::LocalTensor<float> xLocal = inQueueX.AllocTensor<float>();
        AscendC::LocalTensor<float> yLocal = inQueueY.AllocTensor<float>();

        AscendC::DataCopy(xLocal, xGm[offset], actualTileLength);
        AscendC::DataCopy(yLocal, yGm[offset], actualTileLength);

        inQueueX.EnQue(xLocal);
        inQueueY.EnQue(yLocal);
    }
    __aicore__ inline void Compute(int32_t progress)
    {
        AscendC::LocalTensor<float> xLocal = inQueueX.DeQue<float>();
        AscendC::LocalTensor<float> yLocal = inQueueY.DeQue<float>();
        AscendC::LocalTensor<float> zLocal = outQueueZ.AllocTensor<float>();

        // 实际tile长度（最后一块可能不满）
        uint32_t offset = progress * this->tileLength;
        uint32_t remaining = this->blockLength - offset;
        uint32_t actualTileLength = remaining < this->tileLength ? remaining : this->tileLength;

        // z[i] = x[i] / y[i]，逐元素除法
        AscendC::Div(zLocal, xLocal, yLocal, actualTileLength);

        outQueueZ.EnQue<float>(zLocal);

        inQueueX.FreeTensor(xLocal);
        inQueueY.FreeTensor(yLocal);
    }
    __aicore__ inline void CopyOut(int32_t progress)
    {
        uint32_t offset = progress * this->tileLength;
        uint32_t remaining = this->blockLength - offset;
        uint32_t actualTileLength = remaining < this->tileLength ? remaining : this->tileLength;

        AscendC::LocalTensor<float> zLocal = outQueueZ.DeQue<float>();

        AscendC::DataCopy(zGm[offset], zLocal, actualTileLength);

        outQueueZ.FreeTensor(zLocal);
    }

private:
    AscendC::TPipe pipe;

    AscendC::TQue<AscendC::QuePosition::VECIN, BUFFER_NUM> inQueueX;
    AscendC::TQue<AscendC::QuePosition::VECIN, BUFFER_NUM> inQueueY;
    AscendC::TQue<AscendC::QuePosition::VECOUT, BUFFER_NUM> outQueueZ;

    AscendC::GlobalTensor<float> xGm;
    AscendC::GlobalTensor<float> yGm;
    AscendC::GlobalTensor<float> zGm;

    uint32_t blockLength;
    uint32_t tileNum;
    uint32_t tileLength;
};

__global__ __aicore__ void div_custom(GM_ADDR x, GM_ADDR y, GM_ADDR z, DivCustomTilingData tiling)
{
    KernelDiv div;
    div.Init(x, y, z, tiling.totalLength, tiling.tileNum);
    div.Process();
}

std::vector<float> kernel_div(std::vector<float> &x, std::vector<float> &y)
{
    const uint32_t totalLength = static_cast<uint32_t>(x.size());
    const uint32_t blockDim = 8;
    const uint32_t tileNum = 8;
    const size_t byteSize = totalLength * sizeof(float);

    std::vector<float> output(totalLength, 0.0f);

    // 1. 初始化 ACL 与设备
    auto check_acl = [](aclError ret, const char *msg) -> bool {
        if (ret != ACL_SUCCESS) {
            std::cerr << "[ACL Error] " << msg << " — code: " << ret
                      << ", detail: " << aclGetRecentErrMsg() << std::endl;
            return false;
        }
        return true;
    };

    if (!check_acl(aclInit(nullptr), "aclInit")) {
        return std::vector<float>();
    }

    int32_t deviceId = 0;
    if (!check_acl(aclrtSetDevice(deviceId), "aclrtSetDevice")) {
        aclFinalize();
        return std::vector<float>();
    }

    aclrtStream stream = nullptr;
    if (!check_acl(aclrtCreateStream(&stream), "aclrtCreateStream")) {
        aclrtResetDevice(deviceId);
        aclFinalize();
        return std::vector<float>();
    }

    // 2. 申请 Host / Device 内存
    float *xHost = nullptr;
    float *yHost = nullptr;
    float *zHost = nullptr;

    uint8_t *xDevice = nullptr;
    uint8_t *yDevice = nullptr;
    uint8_t *zDevice = nullptr;

    auto safe_free_host = [&]() {
        if (xHost) aclrtFreeHost(xHost);
        if (yHost) aclrtFreeHost(yHost);
        if (zHost) aclrtFreeHost(zHost);
    };
    auto safe_free_device = [&]() {
        if (xDevice) aclrtFree(xDevice);
        if (yDevice) aclrtFree(yDevice);
        if (zDevice) aclrtFree(zDevice);
    };
    auto cleanup = [&]() {
        safe_free_host();
        safe_free_device();
        aclrtDestroyStream(stream);
        aclrtResetDevice(deviceId);
        aclFinalize();
    };

    if (!check_acl(aclrtMallocHost(reinterpret_cast<void **>(&xHost), byteSize), "aclrtMallocHost(xHost)")) {
        cleanup();
        return std::vector<float>();
    }
    if (!check_acl(aclrtMallocHost(reinterpret_cast<void **>(&yHost), byteSize), "aclrtMallocHost(yHost)")) {
        cleanup();
        return std::vector<float>();
    }
    if (!check_acl(aclrtMallocHost(reinterpret_cast<void **>(&zHost), byteSize), "aclrtMallocHost(zHost)")) {
        cleanup();
        return std::vector<float>();
    }

    std::copy(x.begin(), x.end(), xHost);
    std::copy(y.begin(), y.end(), yHost);

    if (!check_acl(aclrtMalloc(reinterpret_cast<void **>(&xDevice), byteSize, ACL_MEM_MALLOC_HUGE_FIRST), "aclrtMalloc(xDevice)")) {
        cleanup();
        return std::vector<float>();
    }
    if (!check_acl(aclrtMalloc(reinterpret_cast<void **>(&yDevice), byteSize, ACL_MEM_MALLOC_HUGE_FIRST), "aclrtMalloc(yDevice)")) {
        cleanup();
        return std::vector<float>();
    }
    if (!check_acl(aclrtMalloc(reinterpret_cast<void **>(&zDevice), byteSize, ACL_MEM_MALLOC_HUGE_FIRST), "aclrtMalloc(zDevice)")) {
        cleanup();
        return std::vector<float>();
    }

    // 3. 拷贝输入数据 Host -> Device
    if (!check_acl(aclrtMemcpy(xDevice, byteSize, xHost, byteSize, ACL_MEMCPY_HOST_TO_DEVICE), "aclrtMemcpy(x Host->Device)")) {
        cleanup();
        return std::vector<float>();
    }
    if (!check_acl(aclrtMemcpy(yDevice, byteSize, yHost, byteSize, ACL_MEMCPY_HOST_TO_DEVICE), "aclrtMemcpy(y Host->Device)")) {
        cleanup();
        return std::vector<float>();
    }

    // 4. 准备tiling并启动核函数（使用 <<<>>> CUDA风格调用）
    DivCustomTilingData tiling;
    tiling.totalLength = totalLength;
    tiling.tileNum = tileNum;

    div_custom<<<blockDim, nullptr, stream>>>(xDevice, yDevice, zDevice, tiling);

    if (!check_acl(aclrtSynchronizeStream(stream), "aclrtSynchronizeStream")) {
        cleanup();
        return std::vector<float>();
    }

    // 5. 拷贝结果 Device -> Host
    if (!check_acl(aclrtMemcpy(zHost, byteSize, zDevice, byteSize, ACL_MEMCPY_DEVICE_TO_HOST), "aclrtMemcpy(z Device->Host)")) {
        cleanup();
        return std::vector<float>();
    }

    std::copy(zHost, zHost + totalLength, output.begin());

    // 6. 释放资源
    aclrtFree(xDevice);
    aclrtFree(yDevice);
    aclrtFree(zDevice);

    aclrtFreeHost(xHost);
    aclrtFreeHost(yHost);
    aclrtFreeHost(zHost);

    aclrtDestroyStream(stream);
    aclrtResetDevice(deviceId);
    aclFinalize();

    return output;
}

uint32_t VerifyResult(std::vector<float> &output, std::vector<float> &golden)
{
    auto printTensor = [](std::vector<float> &tensor, const char *name) {
        constexpr size_t maxPrintSize = 20;
        std::cout << name << ": ";
        std::copy(tensor.begin(), tensor.begin() + std::min(tensor.size(), maxPrintSize),
            std::ostream_iterator<float>(std::cout, " "));
        if (tensor.size() > maxPrintSize) {
            std::cout << "...";
        }
        std::cout << std::endl;
    };
    printTensor(output, "Output");
    printTensor(golden, "Golden");
    if (std::equal(golden.begin(), golden.end(), output.begin())) {
        std::cout << "[Success] Case accuracy is verification passed." << std::endl;
        return 0;
    } else {
        std::cout << "[Failed] Case accuracy is verification failed!" << std::endl;
        return 1;
    }
}

int32_t main(int32_t argc, char *argv[])
{
    constexpr uint32_t totalLength = 8 * 2048;
    constexpr float valueX = 1.2f;
    constexpr float valueY = 2.3f;
    std::vector<float> x(totalLength, valueX);
    std::vector<float> y(totalLength, valueY);

    std::vector<float> output = kernel_div(x, y);

    std::vector<float> golden(totalLength, valueX / valueY);
    return VerifyResult(output, golden);
}

