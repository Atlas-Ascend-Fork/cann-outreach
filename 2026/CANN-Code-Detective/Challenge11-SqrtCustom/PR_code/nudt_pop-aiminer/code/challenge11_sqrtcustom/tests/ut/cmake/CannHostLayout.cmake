include_guard(GLOBAL)

# Use one host-layout policy for both host and kernel UTs.
function(sqrt_resolve_cann_host_paths root host_output lib_output)
    if(EXISTS "${root}/aarch64-linux")
        set(host_path "${root}/aarch64-linux")
    elseif(EXISTS "${root}/x86_64-linux")
        set(host_path "${root}/x86_64-linux")
    else()
        set(host_path "${root}/host-libs")
    endif()
    if(EXISTS "${root}/lib64")
        set(lib_path "${root}/lib64")
    else()
        set(lib_path "${host_path}/lib64")
    endif()
    set(${host_output} "${host_path}" PARENT_SCOPE)
    set(${lib_output} "${lib_path}" PARENT_SCOPE)
endfunction()
