// cosh_custom.asc
// 代码侦探 Challenge03 - CoshCustom 双曲余弦算子
// 核心流程：Tiling 切分 -> CopyIn -> Compute -> CopyOut
// 计算：cosh(x) = (Exp(x) + Exp(-x)) / 2，使用 TBuf 管理中间结果

#include <cstdint>
#include <iostream>
#include <vector>
#include <cmath>
#include <algorithm>
#include <iterator>
#include "acl/acl.h"
#include "kernel_operator.h"

constexpr uint32_t BUFFER_NUM = 2; // tensor num for each queue

struct CoshCustomTilingData
{
    uint32_t totalLength;
    uint32_t tileNum;
};

class KernelCosh {
public:
    __aicore__ inline KernelCosh(){}

    __aicore__ inline void Init(GM_ADDR x, GM_ADDR y, uint32_t totalLength, uint32_t tileNum)
    {
        // 每个核处理的数据长度 = 总长度 / 核数
        this->blockLength = totalLength / AscendC::GetBlockNum();
        // 每个核内的 tile 切分数
        this->tileNum = tileNum;
        // 每个 tile 的长度：考虑 double buffer，需再除以 BUFFER_NUM
        this->tileLength = this->blockLength / tileNum / BUFFER_NUM;

        // 设置 GM 地址，按核号 GetBlockIdx() 偏移，实现多核数据切分
        xGm.SetGlobalBuffer((__gm__ float *)x + this->blockLength * AscendC::GetBlockIdx(), this->blockLength);
        yGm.SetGlobalBuffer((__gm__ float *)y + this->blockLength * AscendC::GetBlockIdx(), this->blockLength);

        // 初始化输入队列（double buffer 流水）
        pipe.InitBuffer(inQueueX, BUFFER_NUM, this->tileLength * sizeof(float));
        // 初始化输出队列（double buffer 流水）
        pipe.InitBuffer(outQueueY, BUFFER_NUM, this->tileLength * sizeof(float));

        // 初始化两个 TBuf 临时内存，存放 Exp(x) 与 Exp(-x) 的中间结果
        // 位置为 VECCALC，大小为 tileLength * sizeof(float)
        pipe.InitBuffer(tmpBuf0, this->tileLength * sizeof(float));
        pipe.InitBuffer(tmpBuf1, this->tileLength * sizeof(float));
    }

    __aicore__ inline void Process()
    {
        // double buffer 模式下迭代次数 = tileNum * BUFFER_NUM
        int32_t loopCount = this->tileNum * BUFFER_NUM;
        for (int32_t i = 0; i < loopCount; ++i) {
            CopyIn(i);   // 搬入第 i 个 tile 的 x
            Compute(i);  // 计算 cosh(x) = (Exp(x) + Exp(-x)) / 2
            CopyOut(i);  // 搬出第 i 个 tile 的结果 y
        }
    }

private:
    __aicore__ inline void CopyIn(int32_t progress)
    {
        // 从输入队列分配 UB Tensor
        AscendC::LocalTensor<float> xLocal = inQueueX.AllocTensor<float>();
        // 将当前 tile 数据从 GM 拷贝到 UB
        AscendC::DataCopy(xLocal, xGm[progress * this->tileLength], this->tileLength);
        // 入队，等待 Compute 消费
        inQueueX.EnQue(xLocal);
    }

    __aicore__ inline void Compute(int32_t progress)
    {
        // 1. 从 inQueueX 中 DeQue 获取 xLocal
        AscendC::LocalTensor<float> xLocal = inQueueX.DeQue<float>();
        // 2. 从 outQueueY 中 AllocTensor 获取 yLocal
        AscendC::LocalTensor<float> yLocal = outQueueY.AllocTensor<float>();
        // 3. 从 tmpBuf0、tmpBuf1 中 Get<float> 获取临时 tensor
        AscendC::LocalTensor<float> tmpTensor0 = tmpBuf0.Get<float>();
        AscendC::LocalTensor<float> tmpTensor1 = tmpBuf1.Get<float>();

        // 4. 使用 Exp 计算 tmpTensor0 = Exp(xLocal)
        AscendC::Exp(tmpTensor0, xLocal, this->tileLength);
        // 5. 对 xLocal 取反（Muls(xLocal, xLocal, -1.0f)），再使用 Exp 计算 tmpTensor1 = Exp(-x)
        AscendC::Muls(xLocal, xLocal, -1.0f, this->tileLength);
        AscendC::Exp(tmpTensor1, xLocal, this->tileLength);
        // 6. 将两个中间结果相加：tmpTensor0 = tmpTensor0 + tmpTensor1
        AscendC::Add(tmpTensor0, tmpTensor0, tmpTensor1, this->tileLength);
        // 7. 除以 2：yLocal = tmpTensor0 * 0.5f
        AscendC::Muls(yLocal, tmpTensor0, 0.5f, this->tileLength);

        // 8. 结果入队，释放输入 Tensor
        outQueueY.EnQue(yLocal);
        inQueueX.FreeTensor(xLocal);
    }

    __aicore__ inline void CopyOut(int32_t progress)
    {
        // 出队输出数据
        AscendC::LocalTensor<float> yLocal = outQueueY.DeQue<float>();
        // 将结果从 UB 拷贝回 GM 对应 tile 位置
        AscendC::DataCopy(yGm[progress * this->tileLength], yLocal, this->tileLength);
        // 释放输出 Tensor
        outQueueY.FreeTensor(yLocal);
    }

private:
    AscendC::TPipe pipe;  // TPipe 内存管理对象
    AscendC::TQue<AscendC::TPosition::VECIN, BUFFER_NUM> inQueueX;   // 输入队列（VECIN）
    AscendC::TQue<AscendC::TPosition::VECOUT, BUFFER_NUM> outQueueY; // 输出队列（VECOUT）
    // 两个 TBuf，用于存放 Exp(x) 与 Exp(-x) 的中间结果（只参与计算，无需入队/释放）
    AscendC::TBuf<AscendC::TPosition::VECCALC> tmpBuf0;
    AscendC::TBuf<AscendC::TPosition::VECCALC> tmpBuf1;
    AscendC::GlobalTensor<float> xGm;  // 输入 x 的 GM 管理对象
    AscendC::GlobalTensor<float> yGm;  // 输出 y 的 GM 管理对象
    uint32_t blockLength;  // 每个核处理的数据长度
    uint32_t tileNum;      // 每个核内的 tile 个数
    uint32_t tileLength;   // 每个 tile 的长度
};

extern "C" __global__ __aicore__ void cosh_custom(GM_ADDR x, GM_ADDR y, CoshCustomTilingData tiling)
{
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);  // 标注为 Vector 核
    KernelCosh op;
    op.Init(x, y, tiling.totalLength, tiling.tileNum);
    op.Process();
}

std::vector<float> kernel_cosh(std::vector<float> &x)
{
    constexpr uint32_t blockDim = 8;   // 使用 8 个 AI Core 核并行
    constexpr uint32_t tileNum = 8;    // 每个核内切 8 个 tile
    uint32_t totalLength = x.size();
    size_t totalByteSize = totalLength * sizeof(float);
    int32_t deviceId = 0;
    aclrtStream stream = nullptr;
    CoshCustomTilingData tiling = {totalLength, tileNum};
    uint8_t *xHost = reinterpret_cast<uint8_t *>(x.data());
    uint8_t *yHost = nullptr;
    uint8_t *xDevice = nullptr;
    uint8_t *yDevice = nullptr;

    // 初始化 ACL
    aclInit(nullptr);
    // 运行管理资源申请：设置设备、创建 Stream
    aclrtSetDevice(deviceId);
    aclrtCreateStream(&stream);
    // 分配 Host 侧输出内存
    aclrtMallocHost((void **)(&yHost), totalByteSize);
    // 分配 Device 侧 GM 内存
    aclrtMalloc((void **)&xDevice, totalByteSize, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void **)&yDevice, totalByteSize, ACL_MEM_MALLOC_HUGE_FIRST);
    // 将 Host 上的输入数据拷贝到 Device 侧
    aclrtMemcpy(xDevice, totalByteSize, xHost, totalByteSize, ACL_MEMCPY_HOST_TO_DEVICE);
    // 用内核调用符 <<<...>>> 调用核函数完成逐元素 cosh 运算
    cosh_custom<<<blockDim, nullptr, stream>>>(xDevice, yDevice, tiling);
    aclrtSynchronizeStream(stream);
    // 将 Device 上的运算结果拷贝回 Host
    aclrtMemcpy(yHost, totalByteSize, yDevice, totalByteSize, ACL_MEMCPY_DEVICE_TO_HOST);
    std::vector<float> y((float *)yHost, (float *)yHost + totalLength);
    // 释放资源
    aclrtFree(xDevice);
    aclrtFree(yDevice);
    aclrtFreeHost(yHost);
    // 去初始化
    aclrtDestroyStream(stream);
    aclrtResetDevice(deviceId);
    aclFinalize();
    return y;
}

uint32_t VerifyResult(std::vector<float> &output, std::vector<float> &golden)
{
    auto printTensor = [](std::vector<float> &tensor, const char *name) {
        constexpr size_t maxPrintSize = 20;
        std::cout << name << ": ";
        std::copy(tensor.begin(), tensor.begin() + std::min(tensor.size(), maxPrintSize),
            std::ostream_iterator<float>(std::cout, " "));
        if (tensor.size() > maxPrintSize) {
            std::cout << "...";
        }
        std::cout << std::endl;
    };
    printTensor(output, "Output");
    printTensor(golden, "Golden");
    if (std::equal(golden.begin(), golden.end(), output.begin())) {
        std::cout << "[Success] Case accuracy is verification passed." << std::endl;
        return 0;
    } else {
        std::cout << "[Failed] Case accuracy is verification failed!" << std::endl;
        return 1;
    }
}

int32_t main(int32_t argc, char *argv[])
{
    constexpr uint32_t totalLength = 8 * 2048;
    constexpr float valueX = 5.5f;
    std::vector<float> x(totalLength, valueX);

    // 调用 kernel_cosh 执行算子计算，得到输出结果
    std::vector<float> output = kernel_cosh(x);

    // golden 值使用 std::cosh 计算
    std::vector<float> golden(totalLength, std::cosh(valueX));
    return VerifyResult(output, golden);
}
