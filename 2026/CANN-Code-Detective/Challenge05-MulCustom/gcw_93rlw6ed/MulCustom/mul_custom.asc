// mul_custom.asc
// 逐元素乘法算子：z[i] = x[i] * y[i]
//
// 学习自第2章 Add 算子示例，实现包含以下部分：
//   1. KernelMul 类成员变量声明
//   2. Init  —— 初始化 TPipe、TQue、GlobalTensor
//   3. Process —— 主循环调用 CopyIn → Compute → CopyOut
//   4. CopyIn  —— 从 GM 搬入数据到 UB
//   5. Compute —— 执行 Mul 计算
//   6. CopyOut —— 将结果从 UB 搬回 GM
//   7. mul_custom kernel 入口函数
//   8. kernel_mul host 侧函数
//   9. main 函数中调用 kernel_mul

#include <cstdint>
#include <iostream>
#include <vector>
#include <algorithm>
#include <iterator>
#include "acl/acl.h"
#include "kernel_operator.h"

constexpr uint32_t BUFFER_NUM = 2;      // Double Buffer 队列深度

struct MulCustomTilingData
{
    uint32_t totalLength;
    uint32_t tileNum;
};

class KernelMul {
public:
    __aicore__ inline KernelMul() {}
    __aicore__ inline void Init(GM_ADDR x, GM_ADDR y, GM_ADDR z, uint32_t totalLength, uint32_t tileNum)
    {
        // 1. 单核处理长度：totalLength 均分到每个 AI Core
        this->blockLength = totalLength / AscendC::GetBlockNum();
        this->tileNum = tileNum;
        // 2. 分片长度：单核数据按 tileNum 切分，每份再拆成 BUFFER_NUM 块构成双缓冲
        this->tileLength = this->blockLength / tileNum / BUFFER_NUM;

        // 3. 每个核通过 GetBlockIdx() 偏移，只处理自己的那段 Global Memory
        uint32_t blockOffset = this->blockLength * AscendC::GetBlockIdx();
        xGm.SetGlobalBuffer((__gm__ float *)x + blockOffset, this->blockLength);
        yGm.SetGlobalBuffer((__gm__ float *)y + blockOffset, this->blockLength);
        zGm.SetGlobalBuffer((__gm__ float *)z + blockOffset, this->blockLength);

        // 4. 为三个队列各分配 BUFFER_NUM 块 UB 缓冲，每块 tileLength 个 float
        pipe.InitBuffer(inQueueX, BUFFER_NUM, this->tileLength * sizeof(float));
        pipe.InitBuffer(inQueueY, BUFFER_NUM, this->tileLength * sizeof(float));
        pipe.InitBuffer(outQueueZ, BUFFER_NUM, this->tileLength * sizeof(float));
    }
    __aicore__ inline void Process()
    {
        // 主循环：tileNum * BUFFER_NUM 次迭代，三段流水通过队列解耦
        int32_t loopCount = this->tileNum * BUFFER_NUM;
        for (int32_t i = 0; i < loopCount; ++i) {
            CopyIn(i);
            Compute(i);
            CopyOut(i);
        }
    }

private:
    __aicore__ inline void CopyIn(int32_t progress)
    {
        // 从 GM 搬入第 progress 个分片到 UB，并入队
        AscendC::LocalTensor<float> xLocal = inQueueX.AllocTensor<float>();
        AscendC::LocalTensor<float> yLocal = inQueueY.AllocTensor<float>();

        AscendC::DataCopy(xLocal, xGm[progress * this->tileLength], this->tileLength);
        AscendC::DataCopy(yLocal, yGm[progress * this->tileLength], this->tileLength);

        inQueueX.EnQue(xLocal);
        inQueueY.EnQue(yLocal);
    }
    __aicore__ inline void Compute(int32_t progress)
    {
        // 出队输入，执行逐元素乘法 zLocal = xLocal * yLocal，结果入队
        AscendC::LocalTensor<float> xLocal = inQueueX.DeQue<float>();
        AscendC::LocalTensor<float> yLocal = inQueueY.DeQue<float>();
        AscendC::LocalTensor<float> zLocal = outQueueZ.AllocTensor<float>();

        AscendC::Mul(zLocal, xLocal, yLocal, this->tileLength);

        outQueueZ.EnQue<float>(zLocal);

        inQueueX.FreeTensor(xLocal);
        inQueueY.FreeTensor(yLocal);
    }
    __aicore__ inline void CopyOut(int32_t progress)
    {
        // 出队结果，从 UB 搬回 GM
        AscendC::LocalTensor<float> zLocal = outQueueZ.DeQue<float>();

        AscendC::DataCopy(zGm[progress * this->tileLength], zLocal, this->tileLength);

        outQueueZ.FreeTensor(zLocal);
    }

private:
    AscendC::TPipe pipe;

    AscendC::TQue<AscendC::TPosition::VECIN, BUFFER_NUM> inQueueX;
    AscendC::TQue<AscendC::TPosition::VECIN, BUFFER_NUM> inQueueY;
    AscendC::TQue<AscendC::TPosition::VECOUT, BUFFER_NUM> outQueueZ;

    AscendC::GlobalTensor<float> xGm;
    AscendC::GlobalTensor<float> yGm;
    AscendC::GlobalTensor<float> zGm;

    uint32_t blockLength;
    uint32_t tileNum;
    uint32_t tileLength;
};

// Kernel 入口函数
__global__ __aicore__ void mul_custom(GM_ADDR x, GM_ADDR y, GM_ADDR z, MulCustomTilingData tiling)
{
    // 显式指定 Kernel 任务类型为 AIV-only（Vector 核）
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);
    KernelMul op;
    op.Init(x, y, z, tiling.totalLength, tiling.tileNum);
    op.Process();
}

// ----- Host 侧：kernel 直调封装 -----

std::vector<float> kernel_mul(std::vector<float> &x, std::vector<float> &y)
{
    if (x.size() != y.size()) {
        std::cerr << "Error: input vectors must have the same size." << std::endl;
        return {};
    }
    if (x.empty()) {
        std::cerr << "Error: input vectors must not be empty." << std::endl;
        return {};
    }

    // 1~2. 多核与分片参数：8 核并行，每核数据再分 8 个 tile（×BUFFER_NUM 双缓冲）
    const uint32_t totalLength = static_cast<uint32_t>(x.size());
    constexpr uint32_t blockDim = 8;
    constexpr uint32_t tileNum = 8;
    const size_t byteSize = totalLength * sizeof(float);

    std::vector<float> output(totalLength, 0.0f);

    // 3. 初始化 ACL 运行环境
    auto ret = aclInit(nullptr);
    if (ret != ACL_SUCCESS) {
        std::cerr << "aclInit failed. ERROR: " << ret << std::endl;
        return output;
    }

    int32_t deviceId = 0;
    ret = aclrtSetDevice(deviceId);
    if (ret != ACL_SUCCESS) {
        std::cerr << "aclrtSetDevice failed. ERROR: " << ret << std::endl;
        aclFinalize();
        return output;
    }

    aclrtStream stream = nullptr;
    ret = aclrtCreateStream(&stream);
    if (ret != ACL_SUCCESS) {
        std::cerr << "aclrtCreateStream failed. ERROR: " << ret << std::endl;
        aclrtResetDevice(deviceId);
        aclFinalize();
        return output;
    }

    float *xHost = nullptr;
    float *yHost = nullptr;
    float *zHost = nullptr;

    uint8_t *xDevice = nullptr;
    uint8_t *yDevice = nullptr;
    uint8_t *zDevice = nullptr;

    // 4. 申请 Host/Device 内存
    ret = aclrtMallocHost(reinterpret_cast<void **>(&xHost), byteSize);
    if (ret != ACL_SUCCESS) {
        std::cerr << "aclrtMallocHost for xHost failed. ERROR: " << ret << std::endl;
        aclrtDestroyStream(stream);
        aclrtResetDevice(deviceId);
        aclFinalize();
        return output;
    }
    ret = aclrtMallocHost(reinterpret_cast<void **>(&yHost), byteSize);
    if (ret != ACL_SUCCESS) {
        std::cerr << "aclrtMallocHost for yHost failed. ERROR: " << ret << std::endl;
        aclrtFreeHost(xHost);
        aclrtDestroyStream(stream);
        aclrtResetDevice(deviceId);
        aclFinalize();
        return output;
    }
    ret = aclrtMallocHost(reinterpret_cast<void **>(&zHost), byteSize);
    if (ret != ACL_SUCCESS) {
        std::cerr << "aclrtMallocHost for zHost failed. ERROR: " << ret << std::endl;
        aclrtFreeHost(xHost);
        aclrtFreeHost(yHost);
        aclrtDestroyStream(stream);
        aclrtResetDevice(deviceId);
        aclFinalize();
        return output;
    }

    std::copy(x.begin(), x.end(), xHost);
    std::copy(y.begin(), y.end(), yHost);

    ret = aclrtMalloc(reinterpret_cast<void **>(&xDevice), byteSize, ACL_MEM_MALLOC_HUGE_FIRST);
    if (ret != ACL_SUCCESS) {
        std::cerr << "aclrtMalloc for xDevice failed. ERROR: " << ret << std::endl;
        aclrtFreeHost(xHost);
        aclrtFreeHost(yHost);
        aclrtFreeHost(zHost);
        aclrtDestroyStream(stream);
        aclrtResetDevice(deviceId);
        aclFinalize();
        return output;
    }
    ret = aclrtMalloc(reinterpret_cast<void **>(&yDevice), byteSize, ACL_MEM_MALLOC_HUGE_FIRST);
    if (ret != ACL_SUCCESS) {
        std::cerr << "aclrtMalloc for yDevice failed. ERROR: " << ret << std::endl;
        aclrtFree(xDevice);
        aclrtFreeHost(xHost);
        aclrtFreeHost(yHost);
        aclrtFreeHost(zHost);
        aclrtDestroyStream(stream);
        aclrtResetDevice(deviceId);
        aclFinalize();
        return output;
    }
    ret = aclrtMalloc(reinterpret_cast<void **>(&zDevice), byteSize, ACL_MEM_MALLOC_HUGE_FIRST);
    if (ret != ACL_SUCCESS) {
        std::cerr << "aclrtMalloc for zDevice failed. ERROR: " << ret << std::endl;
        aclrtFree(xDevice);
        aclrtFree(yDevice);
        aclrtFreeHost(xHost);
        aclrtFreeHost(yHost);
        aclrtFreeHost(zHost);
        aclrtDestroyStream(stream);
        aclrtResetDevice(deviceId);
        aclFinalize();
        return output;
    }

    // 5. 输入数据 Host -> Device
    ret = aclrtMemcpy(xDevice, byteSize, xHost, byteSize, ACL_MEMCPY_HOST_TO_DEVICE);
    if (ret != ACL_SUCCESS) {
        std::cerr << "aclrtMemcpy to xDevice failed. ERROR: " << ret << std::endl;
        aclrtFree(xDevice);
        aclrtFree(yDevice);
        aclrtFree(zDevice);
        aclrtFreeHost(xHost);
        aclrtFreeHost(yHost);
        aclrtFreeHost(zHost);
        aclrtDestroyStream(stream);
        aclrtResetDevice(deviceId);
        aclFinalize();
        return output;
    }
    ret = aclrtMemcpy(yDevice, byteSize, yHost, byteSize, ACL_MEMCPY_HOST_TO_DEVICE);
    if (ret != ACL_SUCCESS) {
        std::cerr << "aclrtMemcpy to yDevice failed. ERROR: " << ret << std::endl;
        aclrtFree(xDevice);
        aclrtFree(yDevice);
        aclrtFree(zDevice);
        aclrtFreeHost(xHost);
        aclrtFreeHost(yHost);
        aclrtFreeHost(zHost);
        aclrtDestroyStream(stream);
        aclrtResetDevice(deviceId);
        aclFinalize();
        return output;
    }

    // 6. 组装 tiling 并启动 kernel：8 核 × tileNum 8 × BUFFER_NUM 2
    MulCustomTilingData tiling;
    tiling.totalLength = totalLength;
    tiling.tileNum = tileNum;

    mul_custom<<<blockDim, nullptr, stream>>>(xDevice, yDevice, zDevice, tiling);

    // 7. 同步流，等待 kernel 执行完成
    ret = aclrtSynchronizeStream(stream);
    if (ret != ACL_SUCCESS) {
        std::cerr << "aclrtSynchronizeStream failed. ERROR: " << ret << std::endl;
        aclrtFree(xDevice);
        aclrtFree(yDevice);
        aclrtFree(zDevice);
        aclrtFreeHost(xHost);
        aclrtFreeHost(yHost);
        aclrtFreeHost(zHost);
        aclrtDestroyStream(stream);
        aclrtResetDevice(deviceId);
        aclFinalize();
        return output;
    }

    // 8. 结果 Device -> Host
    ret = aclrtMemcpy(zHost, byteSize, zDevice, byteSize, ACL_MEMCPY_DEVICE_TO_HOST);
    if (ret != ACL_SUCCESS) {
        std::cerr << "aclrtMemcpy to zHost failed. ERROR: " << ret << std::endl;
        aclrtFree(xDevice);
        aclrtFree(yDevice);
        aclrtFree(zDevice);
        aclrtFreeHost(xHost);
        aclrtFreeHost(yHost);
        aclrtFreeHost(zHost);
        aclrtDestroyStream(stream);
        aclrtResetDevice(deviceId);
        aclFinalize();
        return output;
    }

    // 9. 构造返回值
    std::copy(zHost, zHost + totalLength, output.begin());

    // 10. 释放资源，去初始化
    aclrtFree(xDevice);
    aclrtFree(yDevice);
    aclrtFree(zDevice);

    aclrtFreeHost(xHost);
    aclrtFreeHost(yHost);
    aclrtFreeHost(zHost);

    aclrtDestroyStream(stream);
    aclrtResetDevice(deviceId);
    aclFinalize();

    return output;
}

// ----- 验证与主函数 -----

uint32_t VerifyResult(std::vector<float> &output, std::vector<float> &golden)
{
    auto printTensor = [](std::vector<float> &tensor, const char *name) {
        constexpr size_t maxPrintSize = 20;
        std::cout << name << ": ";
        std::copy(tensor.begin(), tensor.begin() + std::min(tensor.size(), maxPrintSize),
            std::ostream_iterator<float>(std::cout, " "));
        if (tensor.size() > maxPrintSize) {
            std::cout << "...";
        }
        std::cout << std::endl;
    };
    printTensor(output, "Output");
    printTensor(golden, "Golden");
    if (std::equal(golden.begin(), golden.end(), output.begin())) {
        std::cout << "[Success] Case accuracy is verification passed." << std::endl;
        return 0;
    } else {
        std::cout << "[Failed] Case accuracy is verification failed!" << std::endl;
        return 1;
    }
}

int32_t main(int32_t argc, char *argv[])
{
    constexpr uint32_t totalLength = 8 * 2048;
    constexpr float valueX = 1.2f;
    constexpr float valueY = 2.3f;
    std::vector<float> x(totalLength, valueX);
    std::vector<float> y(totalLength, valueY);

    // 调用 kernel_mul 执行逐元素乘法
    std::vector<float> output = kernel_mul(x, y);

    std::vector<float> golden(totalLength, valueX * valueY);
    return VerifyResult(output, golden);
}
