// mul_custom.asc
// 逐元素乘法算子：z[i] = x[i] * y[i]
//
// 学习自第2章 Add 算子示例，需完成以下部分：
//   1. KernelMul 类成员变量声明
//   2. Init  —— 初始化 TPipe、TQue、GlobalTensor
//   3. Process —— 主循环调用 CopyIn → Compute → CopyOut
//   4. CopyIn  —— 从 GM 搬入数据到 UB
//   5. Compute —— 执行 Mul 计算
//   6. CopyOut —— 将结果从 UB 搬回 GM
//   7. mul_custom kernel 入口函数
//   8. kernel_mul host 侧函数
//   9. main 函数中调用 kernel_mul

#include <cstdint>
#include <iostream>
#include <vector>
#include <algorithm>
#include <iterator>
#include "acl/acl.h"
#include "kernel_operator.h"

constexpr uint32_t BUFFER_NUM = 2;      // Double Buffer 队列深度
using namespace AscendC;
struct MulCustomTilingData
{
    uint32_t totalLength;
    uint32_t tileNum;
};

class KernelMul {
public:
    __aicore__ inline KernelMul() {}
    __aicore__ inline void Init(GM_ADDR x, GM_ADDR y, GM_ADDR z, uint32_t totalLength, uint32_t tileNum)
    {
         this->tileNum = tileNum;
        blockLength = totalLength / GetBlockNum();
        tileLength = blockLength / BUFFER_NUM / tileNum;
        
        gmX.SetGlobalBuffer((__gm__ float*)x + blockLength * GetBlockIdx(), blockLength);
        gmY.SetGlobalBuffer((__gm__ float*)y + blockLength * GetBlockIdx(), blockLength);
        gmZ.SetGlobalBuffer((__gm__ float*)z + blockLength * GetBlockIdx(), blockLength);

        pipe.InitBuffer(inX, BUFFER_NUM, tileLength * sizeof(float));
        pipe.InitBuffer(inY, BUFFER_NUM, tileLength * sizeof(float));
        pipe.InitBuffer(outZ, BUFFER_NUM, tileLength * sizeof(float));
    }
    __aicore__ inline void Process()
    {
        for(int i = 0; i < tileNum * BUFFER_NUM; i++) {
            CopyIn(i);
            Compute(i);
            CopyOut(i);
        }
    }

private:
    __aicore__ inline void CopyIn(int32_t progress)
    {
        LocalTensor<float> x = inX.AllocTensor<float>();
        LocalTensor<float> y = inY.AllocTensor<float>();
        DataCopy(x, gmX[progress * tileLength], tileLength);
        DataCopy(y, gmY[progress * tileLength], tileLength);
        inX.EnQue(x);
        inY.EnQue(y);
    }
    __aicore__ inline void Compute(int32_t progress)
    {
        LocalTensor<float> x = inX.DeQue<float>();
        LocalTensor<float> y = inY.DeQue<float>();
        LocalTensor<float> z = outZ.AllocTensor<float>();
        Mul(z, x, y, tileLength);
        outZ.EnQue(z);
        inX.FreeTensor(x);
        inY.FreeTensor(y);
    }
    __aicore__ inline void CopyOut(int32_t progress)
    {
        LocalTensor<float> z = outZ.DeQue<float>();
        DataCopy(gmZ[progress * tileLength], z, tileLength);
        outZ.FreeTensor(z);
    }

private:
    int tileLength, blockLength, tileNum;
    TPipe pipe;
    TQue<TPosition::VECIN, BUFFER_NUM> inX, inY;
    TQue<TPosition::VECOUT, BUFFER_NUM> outZ;
    GlobalTensor<float> gmX, gmY, gmZ;
};

// Kernel 入口函数
__global__ __aicore__ void mul_custom(GM_ADDR x, GM_ADDR y, GM_ADDR z, MulCustomTilingData tiling)
{
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);
    KernelMul op;
    op.Init(x, y, z, tiling.totalLength, tiling.tileNum);
    op.Process();
}

// ----- Host 侧：kernel 直调封装 -----

std::vector<float> kernel_mul(std::vector<float> &x, std::vector<float> &y)
{
    // 请补充……
    // 1. 定义 blockDim = 8, totalLength = x.size()
    // 2. 定义 tiling: totalLength, tileNum = 8
    // 3. 初始化 ACL: aclInit, aclrtSetDevice, aclrtCreateStream
    // 4. 申请 Host/Device 内存 (aclrtMallocHost, aclrtMalloc)
    // 5. 将输入数据拷贝到 Device (aclrtMemcpy H2D)
    // 6. 调用 kernel: mul_custom<<<blockDim, nullptr, stream>>>(xDevice, yDevice, zDevice, tiling)
    // 7. 同步流 (aclrtSynchronizeStream)
    // 8. 将结果从 Device 拷贝回 Host (aclrtMemcpy D2H)
    // 9. 构造 vector<float> 返回
    // 10. 释放内存，销毁流，重置设备，aclFinalize
    uint32_t totalLength = x.size();
    uint32_t tileNum = 8;
    uint32_t bufferSize = totalLength * sizeof(float);
    uint32_t blockDim = 8;
    aclInit(nullptr);
    aclrtSetDevice(0);
    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);
    uint8_t *xDevice = nullptr;
    uint8_t *yDevice = nullptr;
    uint8_t *zDevice = nullptr;
    uint8_t *zHost = nullptr;
    aclrtMallocHost((void **)(&zHost), bufferSize);
    aclrtMalloc((void**)&xDevice, bufferSize, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&yDevice, bufferSize, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&zDevice, bufferSize, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMemcpy(xDevice, bufferSize, x.data(), bufferSize, ACL_MEMCPY_HOST_TO_DEVICE);
    aclrtMemcpy(yDevice, bufferSize, y.data(), bufferSize, ACL_MEMCPY_HOST_TO_DEVICE);
    MulCustomTilingData tiling = {
        .totalLength=totalLength,
        .tileNum=tileNum
    };
    mul_custom<<<blockDim, nullptr, stream>>>(xDevice, yDevice, zDevice, tiling);
    aclrtSynchronizeStream(stream);
    aclrtMemcpy(zHost, bufferSize, zDevice, bufferSize, ACL_MEMCPY_DEVICE_TO_HOST);
    std::vector<float>ans((float*)zHost, (float*)zHost + totalLength);
    aclrtFree(xDevice);
    aclrtFree(yDevice);
    aclrtFree(zDevice);
    aclrtFreeHost(zHost);
    aclrtDestroyStream(stream);
    aclrtResetDevice(0);
    aclFinalize();
    return ans;
}

// ----- 验证与主函数 -----

uint32_t VerifyResult(std::vector<float> &output, std::vector<float> &golden)
{
    auto printTensor = [](std::vector<float> &tensor, const char *name) {
        constexpr size_t maxPrintSize = 20;
        std::cout << name << ": ";
        std::copy(tensor.begin(), tensor.begin() + std::min(tensor.size(), maxPrintSize),
            std::ostream_iterator<float>(std::cout, " "));
        if (tensor.size() > maxPrintSize) {
            std::cout << "...";
        }
        std::cout << std::endl;
    };
    printTensor(output, "Output");
    printTensor(golden, "Golden");
    if (std::equal(golden.begin(), golden.end(), output.begin())) {
        std::cout << "[Success] Case accuracy is verification passed." << std::endl;
        return 0;
    } else {
        std::cout << "[Failed] Case accuracy is verification failed!" << std::endl;
        return 1;
    }
}

int32_t main(int32_t argc, char *argv[])
{
    constexpr uint32_t totalLength = 8 * 2048;
    constexpr float valueX = 1.2f;
    constexpr float valueY = 2.3f;
    std::vector<float> x(totalLength, valueX);
    std::vector<float> y(totalLength, valueY);

    // 请补充……
    // 调用 kernel_mul(x, y) 获取 output
    std::vector<float> output = kernel_mul(x, y);

    std::vector<float> golden(totalLength, valueX * valueY);
    return VerifyResult(output, golden);
}