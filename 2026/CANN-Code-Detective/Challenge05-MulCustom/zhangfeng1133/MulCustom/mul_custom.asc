// mul_custom.asc
// 逐元素乘法算子：z[i] = x[i] * y[i]
//
// 学习自第2章 Add 算子示例，需完成以下部分：
//   1. KernelMul 类成员变量声明
//   2. Init  —— 初始化 TPipe、TQue、GlobalTensor
//   3. Process —— 主循环调用 CopyIn → Compute → CopyOut
//   4. CopyIn  —— 从 GM 搬入数据到 UB
//   5. Compute —— 执行 Mul 计算
//   6. CopyOut —— 将结果从 UB 搬回 GM
//   7. mul_custom kernel 入口函数
//   8. kernel_mul host 侧函数
//   9. main 函数中调用 kernel_mul

#include <cstdint>
#include <iostream>
#include <vector>
#include <algorithm>
#include <iterator>
#include "acl/acl.h"
#include "kernel_operator.h"

using namespace AscendC; // AscendC 算子相关类型均位于该命名空间

constexpr uint32_t BUFFER_NUM = 2;      // Double Buffer 队列深度

struct MulCustomTilingData
{
    uint32_t totalLength;
    uint32_t tileNum;
};

class KernelMul {
public:
    __aicore__ inline KernelMul() {}
    __aicore__ inline void Init(GM_ADDR x, GM_ADDR y, GM_ADDR z, uint32_t totalLength, uint32_t tileNum)
    {
        // 1. 计算单核处理长度 blockLength = totalLength / GetBlockNum()
        this->blockLength = totalLength / GetBlockNum();
        this->tileNum = tileNum;
        // 2. 计算 tileLength = blockLength / tileNum / BUFFER_NUM
        this->tileLength = this->blockLength / this->tileNum / BUFFER_NUM;
        // 3. 使用 SetGlobalBuffer 设置 xGm, yGm, zGm 的起始地址和长度
        //    （注意用 GetBlockIdx() 计算每个核的偏移）
        xGm.SetGlobalBuffer((__gm__ float *)x + this->blockLength * GetBlockIdx(), this->blockLength);
        yGm.SetGlobalBuffer((__gm__ float *)y + this->blockLength * GetBlockIdx(), this->blockLength);
        zGm.SetGlobalBuffer((__gm__ float *)z + this->blockLength * GetBlockIdx(), this->blockLength);
        // 4. 使用 pipe.InitBuffer 为 inQueueX, inQueueY, outQueueZ 分配内存
        //    每个队列分配 BUFFER_NUM 个块，每块大小 tileLength * sizeof(float)
        pipe.InitBuffer(inQueueX, BUFFER_NUM, this->tileLength * sizeof(float));
        pipe.InitBuffer(inQueueY, BUFFER_NUM, this->tileLength * sizeof(float));
        pipe.InitBuffer(outQueueZ, BUFFER_NUM, this->tileLength * sizeof(float));
    }
    __aicore__ inline void Process()
    {
        // 循环次数 = tileNum * BUFFER_NUM
        // 每次迭代调用 CopyIn(i) → Compute(i) → CopyOut(i)
        for (int32_t i = 0; i < this->tileNum * BUFFER_NUM; i++) {
            CopyIn(i);
            Compute(i);
            CopyOut(i);
        }
    }

private:
    __aicore__ inline void CopyIn(int32_t progress)
    {
        // 1. 从 inQueueX 中 AllocTensor<float> 获取 xLocal
        LocalTensor<float> xLocal = inQueueX.AllocTensor<float>();
        // 2. 从 inQueueY 中 AllocTensor<float> 获取 yLocal
        LocalTensor<float> yLocal = inQueueY.AllocTensor<float>();
        // 3. 使用 DataCopy 从 xGm[progress * tileLength] 搬入 tileLength 个元素到 xLocal
        DataCopy(xLocal, xGm[progress * this->tileLength], this->tileLength);
        // 4. 使用 DataCopy 从 yGm[progress * tileLength] 搬入 tileLength 个元素到 yLocal
        DataCopy(yLocal, yGm[progress * this->tileLength], this->tileLength);
        // 5. 将 xLocal, yLocal 入队 (EnQue)
        inQueueX.EnQue(xLocal);
        inQueueY.EnQue(yLocal);
    }
    __aicore__ inline void Compute(int32_t progress)
    {
        // 1. 从 inQueueX 中 DeQue<float> 获取 xLocal
        LocalTensor<float> xLocal = inQueueX.DeQue<float>();
        // 2. 从 inQueueY 中 DeQue<float> 获取 yLocal
        LocalTensor<float> yLocal = inQueueY.DeQue<float>();
        // 3. 从 outQueueZ 中 AllocTensor<float> 获取 zLocal
        LocalTensor<float> zLocal = outQueueZ.AllocTensor<float>();
        // 4. 使用 Mul(zLocal, xLocal, yLocal, tileLength) 计算逐元素乘法
        Mul(zLocal, xLocal, yLocal, this->tileLength);
        // 5. 将 zLocal 入队 (EnQue)
        outQueueZ.EnQue(zLocal);
        // 6. 释放 xLocal, yLocal (FreeTensor)
        inQueueX.FreeTensor(xLocal);
        inQueueY.FreeTensor(yLocal);
    }
    __aicore__ inline void CopyOut(int32_t progress)
    {
        // 1. 从 outQueueZ 中 DeQue<float> 获取 zLocal
        LocalTensor<float> zLocal = outQueueZ.DeQue<float>();
        // 2. 使用 DataCopy 将 zLocal 搬出到 zGm[progress * tileLength]
        DataCopy(zGm[progress * this->tileLength], zLocal, this->tileLength);
        // 3. 释放 zLocal (FreeTensor)
        outQueueZ.FreeTensor(zLocal);
    }

private:
    // 声明以下成员变量：
    //   TPipe pipe;
    //   TQue<TPosition::VECIN, BUFFER_NUM> inQueueX, inQueueY;
    //   TQue<TPosition::VECOUT, BUFFER_NUM> outQueueZ;
    //   GlobalTensor<float> xGm, yGm, zGm;
    //   uint32_t blockLength, tileNum, tileLength;
    TPipe pipe;
    TQue<TPosition::VECIN, BUFFER_NUM> inQueueX, inQueueY;
    TQue<TPosition::VECOUT, BUFFER_NUM> outQueueZ;
    GlobalTensor<float> xGm, yGm, zGm;
    uint32_t blockLength = 0;
    uint32_t tileNum = 0;
    uint32_t tileLength = 0;
};

// Kernel 入口函数
__global__ __aicore__ void mul_custom(GM_ADDR x, GM_ADDR y, GM_ADDR z, MulCustomTilingData tiling)
{
    // 1. 添加 KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY)
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);
    // 2. 实例化 KernelMul op
    KernelMul op;
    // 3. 调用 op.Init(x, y, z, tiling.totalLength, tiling.tileNum)
    op.Init(x, y, z, tiling.totalLength, tiling.tileNum);
    // 4. 调用 op.Process()
    op.Process();
}

// ----- Host 侧：kernel 直调封装 -----

std::vector<float> kernel_mul(std::vector<float> &x, std::vector<float> &y)
{
    uint32_t blockDim = 8;
    uint32_t totalLength = x.size();
    MulCustomTilingData tiling;
    tiling.totalLength = totalLength;
    tiling.tileNum = 8;

    aclError ret = ACL_SUCCESS;
    aclrtStream stream = nullptr;
    size_t byteSize = totalLength * sizeof(float);
    float *xHost = nullptr, *yHost = nullptr, *zHost = nullptr;
    float *xDevice = nullptr, *yDevice = nullptr, *zDevice = nullptr;
    std::vector<float> output;

    // 1. 初始化 ACL
    ret = aclInit(nullptr);
    if (ret != ACL_SUCCESS) {
        std::cerr << "[ACL_ERROR] aclInit failed, code=" << ret << std::endl;
        return output;
    }
    ret = aclrtSetDevice(0);
    if (ret != ACL_SUCCESS) {
        std::cerr << "[ACL_ERROR] aclrtSetDevice failed, code=" << ret << std::endl;
        return output;
    }
    ret = aclrtCreateStream(&stream);
    if (ret != ACL_SUCCESS) {
        std::cerr << "[ACL_ERROR] aclrtCreateStream failed, code=" << ret << std::endl;
        return output;
    }
    // 2. 申请 Host 内存
    ret = aclrtMallocHost((void **)&xHost, byteSize);
    if (ret != ACL_SUCCESS) {
        std::cerr << "[ACL_ERROR] aclrtMallocHost(xHost) failed, code=" << ret << std::endl;
        goto cleanup;
    }
    ret = aclrtMallocHost((void **)&yHost, byteSize);
    if (ret != ACL_SUCCESS) {
        std::cerr << "[ACL_ERROR] aclrtMallocHost(yHost) failed, code=" << ret << std::endl;
        goto cleanup;
    }
    ret = aclrtMallocHost((void **)&zHost, byteSize);
    if (ret != ACL_SUCCESS) {
        std::cerr << "[ACL_ERROR] aclrtMallocHost(zHost) failed, code=" << ret << std::endl;
        goto cleanup;
    }
    // 3. 申请 Device 内存
    ret = aclrtMalloc((void **)&xDevice, byteSize, ACL_MEM_MALLOC_HUGE_FIRST);
    if (ret != ACL_SUCCESS) {
        std::cerr << "[ACL_ERROR] aclrtMalloc(xDevice) failed, code=" << ret << std::endl;
        goto cleanup;
    }
    ret = aclrtMalloc((void **)&yDevice, byteSize, ACL_MEM_MALLOC_HUGE_FIRST);
    if (ret != ACL_SUCCESS) {
        std::cerr << "[ACL_ERROR] aclrtMalloc(yDevice) failed, code=" << ret << std::endl;
        goto cleanup;
    }
    ret = aclrtMalloc((void **)&zDevice, byteSize, ACL_MEM_MALLOC_HUGE_FIRST);
    if (ret != ACL_SUCCESS) {
        std::cerr << "[ACL_ERROR] aclrtMalloc(zDevice) failed, code=" << ret << std::endl;
        goto cleanup;
    }
    // 4. Host -> Device 拷贝
    ret = aclrtMemcpy(xDevice, byteSize, x.data(), byteSize, ACL_MEMCPY_HOST_TO_DEVICE);
    if (ret != ACL_SUCCESS) {
        std::cerr << "[ACL_ERROR] aclrtMemcpy(x H2D) failed, code=" << ret << std::endl;
        goto cleanup;
    }
    ret = aclrtMemcpy(yDevice, byteSize, y.data(), byteSize, ACL_MEMCPY_HOST_TO_DEVICE);
    if (ret != ACL_SUCCESS) {
        std::cerr << "[ACL_ERROR] aclrtMemcpy(y H2D) failed, code=" << ret << std::endl;
        goto cleanup;
    }
    // 5. 启动 kernel
    mul_custom<<<blockDim, nullptr, stream>>>((GM_ADDR)xDevice, (GM_ADDR)yDevice, (GM_ADDR)zDevice, tiling);
    // 6. 同步并 Device -> Host 拷贝
    ret = aclrtSynchronizeStream(stream);
    if (ret != ACL_SUCCESS) {
        std::cerr << "[ACL_ERROR] aclrtSynchronizeStream failed, code=" << ret << std::endl;
        goto cleanup;
    }
    ret = aclrtMemcpy(zHost, byteSize, zDevice, byteSize, ACL_MEMCPY_DEVICE_TO_HOST);
    if (ret != ACL_SUCCESS) {
        std::cerr << "[ACL_ERROR] aclrtMemcpy(z D2H) failed, code=" << ret << std::endl;
        goto cleanup;
    }
    // 7. 构造输出
    output.assign(zHost, zHost + totalLength);

cleanup:
    if (ret != ACL_SUCCESS) {
        std::cerr << "[ACL_ERROR] last error code=" << ret
                  << " (" << __FILE__ << ":" << __LINE__ << ")" << std::endl;
    }
    if (zDevice != nullptr) { aclrtFree(zDevice); }
    if (yDevice != nullptr) { aclrtFree(yDevice); }
    if (xDevice != nullptr) { aclrtFree(xDevice); }
    if (zHost != nullptr)    { aclrtFreeHost(zHost); }
    if (yHost != nullptr)    { aclrtFreeHost(yHost); }
    if (xHost != nullptr)    { aclrtFreeHost(xHost); }
    if (stream != nullptr)   { aclrtDestroyStream(stream); }
    aclrtResetDevice(0);
    aclFinalize();
    return output;
}

// ----- 验证与主函数 -----

uint32_t VerifyResult(std::vector<float> &output, std::vector<float> &golden)
{
    auto printTensor = [](std::vector<float> &tensor, const char *name) {
        constexpr size_t maxPrintSize = 20;
        std::cout << name << ": ";
        std::copy(tensor.begin(), tensor.begin() + std::min(tensor.size(), maxPrintSize),
            std::ostream_iterator<float>(std::cout, " "));
        if (tensor.size() > maxPrintSize) {
            std::cout << "...";
        }
        std::cout << std::endl;
    };
    printTensor(output, "Output");
    printTensor(golden, "Golden");
    if (std::equal(golden.begin(), golden.end(), output.begin())) {
        std::cout << "[Success] Case accuracy is verification passed." << std::endl;
        return 0;
    } else {
        std::cout << "[Failed] Case accuracy is verification failed!" << std::endl;
        return 1;
    }
}

int32_t main(int32_t argc, char *argv[])
{
    constexpr uint32_t totalLength = 8 * 2048;
    constexpr float valueX = 1.2f;
    constexpr float valueY = 2.3f;
    std::vector<float> x(totalLength, valueX);
    std::vector<float> y(totalLength, valueY);

    // 调用 kernel_mul(x, y) 获取 output
    std::vector<float> output = kernel_mul(x, y);

    std::vector<float> golden(totalLength, valueX * valueY);
    return VerifyResult(output, golden);
}