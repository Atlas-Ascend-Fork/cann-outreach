// mul_custom.asc
// 逐元素乘法算子：z[i] = x[i] * y[i]
//
// 学习自第2章 Add 算子示例，需完成以下部分：
//   1. KernelMul 类成员变量声明
//   2. Init  —— 初始化 TPipe、TQue、GlobalTensor
//   3. Process —— 主循环调用 CopyIn → Compute → CopyOut
//   4. CopyIn  —— 从 GM 搬入数据到 UB
//   5. Compute —— 执行 Mul 计算
//   6. CopyOut —— 将结果从 UB 搬回 GM
//   7. mul_custom kernel 入口函数
//   8. kernel_mul host 侧函数
//   9. main 函数中调用 kernel_mul

#include <cstdint>
#include <iostream>
#include <vector>
#include <algorithm>
#include <iterator>
#include "acl/acl.h"
#include "kernel_operator.h"

constexpr uint32_t BUFFER_NUM = 2;      // Double Buffer 队列深度

struct MulCustomTilingData
{
    uint32_t totalLength;
    uint32_t tileNum;
};

class KernelMul {
public:
    __aicore__ inline KernelMul() {}
    __aicore__ inline void Init(GM_ADDR x, GM_ADDR y, GM_ADDR z, uint32_t totalLength, uint32_t tileNum)
    {
        // 1. 计算单核处理长度 blockLength = totalLength / GetBlockNum()
        this->blockLength = totalLength / AscendC::GetBlockNum();
        this->tileNum = tileNum;
        // 2. 计算 tileLength = blockLength / tileNum / BUFFER_NUM（Double Buffer）
        this->tileLength = this->blockLength / tileNum / BUFFER_NUM;
        // 3. 使用 SetGlobalBuffer 设置每个核的 Global Memory 起始地址与长度
        //    （用 GetBlockIdx() 计算每个核的偏移，实现多核数据切分）
        uint32_t blockOffset = this->blockLength * AscendC::GetBlockIdx();
        xGm.SetGlobalBuffer((__gm__ float *)x + blockOffset, this->blockLength);
        yGm.SetGlobalBuffer((__gm__ float *)y + blockOffset, this->blockLength);
        zGm.SetGlobalBuffer((__gm__ float *)z + blockOffset, this->blockLength);
        // 4. 使用 pipe.InitBuffer 为各队列分配内存
        //    每个队列分配 BUFFER_NUM 个块，每块大小 tileLength * sizeof(float)
        pipe.InitBuffer(inQueueX, BUFFER_NUM, this->tileLength * sizeof(float));
        pipe.InitBuffer(inQueueY, BUFFER_NUM, this->tileLength * sizeof(float));
        pipe.InitBuffer(outQueueZ, BUFFER_NUM, this->tileLength * sizeof(float));
    }
    __aicore__ inline void Process()
    {
        // 主处理循环，按 tile 迭代执行 CopyIn → Compute → CopyOut
        // 循环次数 = tileNum * BUFFER_NUM
        int32_t loopCount = this->tileNum * BUFFER_NUM;
        for (int32_t i = 0; i < loopCount; ++i) {
            CopyIn(i);
            Compute(i);
            CopyOut(i);
        }
    }

private:
    __aicore__ inline void CopyIn(int32_t progress)
    {
        // 1. 从 inQueueX / inQueueY 中 AllocTensor<float> 获取 xLocal / yLocal
        AscendC::LocalTensor<float> xLocal = inQueueX.AllocTensor<float>();
        AscendC::LocalTensor<float> yLocal = inQueueY.AllocTensor<float>();
        // 2. 使用 DataCopy 从 GM 搬入 tileLength 个元素到 Local Memory
        uint32_t tileOffset = progress * this->tileLength;
        AscendC::DataCopy(xLocal, xGm[tileOffset], this->tileLength);
        AscendC::DataCopy(yLocal, yGm[tileOffset], this->tileLength);
        // 3. 将 xLocal, yLocal 入队 (EnQue)
        inQueueX.EnQue(xLocal);
        inQueueY.EnQue(yLocal);
    }
    __aicore__ inline void Compute(int32_t)
    {
        // 1. 从 inQueueX / inQueueY 中 DeQue<float> 获取 xLocal / yLocal
        AscendC::LocalTensor<float> xLocal = inQueueX.DeQue<float>();
        AscendC::LocalTensor<float> yLocal = inQueueY.DeQue<float>();
        // 2. 从 outQueueZ 中 AllocTensor<float> 获取 zLocal
        AscendC::LocalTensor<float> zLocal = outQueueZ.AllocTensor<float>();
        // 3. 使用 Mul 执行逐元素乘法：z[i] = x[i] * y[i]
        AscendC::Mul(zLocal, xLocal, yLocal, this->tileLength);
        // 4. 将 zLocal 入队 (EnQue)
        outQueueZ.EnQue(zLocal);
        // 5. 释放 xLocal, yLocal (FreeTensor)
        inQueueX.FreeTensor(xLocal);
        inQueueY.FreeTensor(yLocal);
    }
    __aicore__ inline void CopyOut(int32_t progress)
    {
        // 1. 从 outQueueZ 中 DeQue<float> 获取 zLocal
        AscendC::LocalTensor<float> zLocal = outQueueZ.DeQue<float>();
        // 2. 使用 DataCopy 将 zLocal 搬出到 GM
        AscendC::DataCopy(zGm[progress * this->tileLength], zLocal, this->tileLength);
        // 3. 释放 zLocal (FreeTensor)
        outQueueZ.FreeTensor(zLocal);
    }

private:
    // 成员变量声明
    AscendC::TPipe pipe;
    AscendC::TQue<AscendC::TPosition::VECIN, BUFFER_NUM> inQueueX, inQueueY;
    AscendC::TQue<AscendC::TPosition::VECOUT, BUFFER_NUM> outQueueZ;
    AscendC::GlobalTensor<float> xGm, yGm, zGm;
    uint32_t blockLength;
    uint32_t tileNum;
    uint32_t tileLength;
};

// Kernel 入口函数
__global__ __aicore__ void mul_custom(GM_ADDR x, GM_ADDR y, GM_ADDR z, MulCustomTilingData tiling)
{
    // 1. 添加 KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY)
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);
    // 2. 实例化 KernelMul op
    // 3. 调用 op.Init(...)
    // 4. 调用 op.Process()
    KernelMul op;
    op.Init(x, y, z, tiling.totalLength, tiling.tileNum);
    op.Process();
}

// ----- Host 侧：kernel 直调封装 -----

std::vector<float> kernel_mul(std::vector<float> &x, std::vector<float> &y)
{
    // 1. 定义 blockDim = 8, totalLength = x.size()
    constexpr uint32_t blockDim = 8;
    uint32_t totalLength = x.size();
    size_t totalByteSize = totalLength * sizeof(float);
    constexpr int32_t deviceId = 0;
    aclrtStream stream = nullptr;
    // 2. 定义 tiling: totalLength, tileNum = 8
    MulCustomTilingData tiling = {totalLength, 8};
    uint8_t *xHost = reinterpret_cast<uint8_t *>(x.data());
    uint8_t *yHost = reinterpret_cast<uint8_t *>(y.data());
    uint8_t *zHost = nullptr;
    uint8_t *xDevice = nullptr;
    uint8_t *yDevice = nullptr;
    uint8_t *zDevice = nullptr;

    // 3. 初始化 ACL: aclInit, aclrtSetDevice, aclrtCreateStream
    aclInit(nullptr);
    aclrtSetDevice(deviceId);
    aclrtCreateStream(&stream);

    // 4. 申请 Host / Device 内存
    aclrtMallocHost(reinterpret_cast<void **>(&zHost), totalByteSize);
    aclrtMalloc(reinterpret_cast<void **>(&xDevice), totalByteSize, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc(reinterpret_cast<void **>(&yDevice), totalByteSize, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc(reinterpret_cast<void **>(&zDevice), totalByteSize, ACL_MEM_MALLOC_HUGE_FIRST);

    // 5. 将输入数据拷贝到 Device (H2D)
    aclrtMemcpy(xDevice, totalByteSize, xHost, totalByteSize, ACL_MEMCPY_HOST_TO_DEVICE);
    aclrtMemcpy(yDevice, totalByteSize, yHost, totalByteSize, ACL_MEMCPY_HOST_TO_DEVICE);

    // 6. 调用 kernel: mul_custom<<<blockDim, nullptr, stream>>>(...)
    mul_custom<<<blockDim, nullptr, stream>>>(xDevice, yDevice, zDevice, tiling);
    // 7. 同步流
    aclrtSynchronizeStream(stream);

    // 8. 将结果从 Device 拷贝回 Host (D2H)
    aclrtMemcpy(zHost, totalByteSize, zDevice, totalByteSize, ACL_MEMCPY_DEVICE_TO_HOST);
    std::vector<float> z(reinterpret_cast<float *>(zHost),
        reinterpret_cast<float *>(zHost + totalByteSize));

    // 9. 释放内存，销毁流，重置设备，aclFinalize
    aclrtFree(xDevice);
    aclrtFree(yDevice);
    aclrtFree(zDevice);
    aclrtFreeHost(zHost);
    aclrtDestroyStream(stream);
    aclrtResetDevice(deviceId);
    aclFinalize();

    return z;
}

// ----- 验证与主函数 -----

uint32_t VerifyResult(std::vector<float> &output, std::vector<float> &golden)
{
    auto printTensor = [](std::vector<float> &tensor, const char *name) {
        constexpr size_t maxPrintSize = 20;
        std::cout << name << ": ";
        std::copy(tensor.begin(), tensor.begin() + std::min(tensor.size(), maxPrintSize),
            std::ostream_iterator<float>(std::cout, " "));
        if (tensor.size() > maxPrintSize) {
            std::cout << "...";
        }
        std::cout << std::endl;
    };
    printTensor(output, "Output");
    printTensor(golden, "Golden");
    if (std::equal(golden.begin(), golden.end(), output.begin())) {
        std::cout << "[Success] Case accuracy is verification passed." << std::endl;
        return 0;
    } else {
        std::cout << "[Failed] Case accuracy is verification failed!" << std::endl;
        return 1;
    }
}

int32_t main(int32_t argc, char *argv[])
{
    constexpr uint32_t totalLength = 8 * 2048;
    constexpr float valueX = 1.2f;
    constexpr float valueY = 2.3f;
    std::vector<float> x(totalLength, valueX);
    std::vector<float> y(totalLength, valueY);

    // 调用 kernel_mul(x, y) 获取 output
    std::vector<float> output = kernel_mul(x, y);

    std::vector<float> golden(totalLength, valueX * valueY);
    return VerifyResult(output, golden);
}
