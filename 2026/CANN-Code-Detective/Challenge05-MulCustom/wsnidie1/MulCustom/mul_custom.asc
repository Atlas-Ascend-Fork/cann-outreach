// mul_custom.asc
// 逐元素乘法算子：z[i] = x[i] * y[i]
// 实现：Vector 编程范式 CopyIn → Compute → CopyOut，Double Buffer + 多核数据切分

#include <cstdint>
#include <iostream>
#include <vector>
#include <algorithm>
#include <iterator>
#include "acl/acl.h"
#include "kernel_operator.h"

constexpr uint32_t BUFFER_NUM = 2;      // Double Buffer 队列深度

struct MulCustomTilingData
{
    uint32_t totalLength;
    uint32_t tileNum;
};

class KernelMul {
public:
    __aicore__ inline KernelMul() {}
    __aicore__ inline void Init(GM_ADDR x, GM_ADDR y, GM_ADDR z, uint32_t totalLength, uint32_t tileNum)
    {
        // 1. 单核处理长度：向上取整 + 尾核截断，任意 totalLength 全覆盖无丢失
        uint32_t blockNum = AscendC::GetBlockNum();
        uint32_t blockIdx = AscendC::GetBlockIdx();
        uint32_t base = totalLength / blockNum;
        uint32_t rem = totalLength % blockNum;
        this->blockLength = base + ((blockIdx < rem) ? 1u : 0u);
        uint32_t offset = blockIdx * base + ((blockIdx < rem) ? blockIdx : rem);
        this->tileNum = tileNum;
        // 2. 每个 tile 的长度：向上取整，尾块由 curLen 收窄（不再整除截断）
        this->tileLength = (this->blockLength + tileNum * BUFFER_NUM - 1) / (tileNum * BUFFER_NUM);
        if (this->tileLength == 0) {
            this->tileLength = 1;  // 防御：极短 blockLength
        }
        if (this->blockLength == 0) {
            return;  // 防御：越界核空转
        }

        // 3. 设置每个核处理的 GM 起始地址与长度（按核索引偏移）
        xGm.SetGlobalBuffer((__gm__ float *)x + offset, this->blockLength);
        yGm.SetGlobalBuffer((__gm__ float *)y + offset, this->blockLength);
        zGm.SetGlobalBuffer((__gm__ float *)z + offset, this->blockLength);

        // 4. 为输入/输出队列分配 UB 内存
        pipe.InitBuffer(inQueueX, BUFFER_NUM, this->tileLength * sizeof(float));
        pipe.InitBuffer(inQueueY, BUFFER_NUM, this->tileLength * sizeof(float));
        pipe.InitBuffer(outQueueZ, BUFFER_NUM, this->tileLength * sizeof(float));
    }
    __aicore__ inline uint32_t CurLen(int32_t progress)
    {
        uint32_t offset = static_cast<uint32_t>(progress) * this->tileLength;
        uint32_t curLen = this->tileLength;
        if (offset + curLen > this->blockLength) {
            curLen = this->blockLength - offset;
        }
        return curLen;
    }
    __aicore__ inline void Process()
    {
        if (this->blockLength == 0) {
            return;
        }
        // 迭代次数：按实际 blockLength 向上取整（尾块 curLen 收窄），无元素丢失
        int32_t loopCount = static_cast<int32_t>((this->blockLength + this->tileLength - 1) / this->tileLength);
        for (int32_t i = 0; i < loopCount; i++) {
            CopyIn(i);
            Compute(i);
            CopyOut(i);
        }
    }

private:
    __aicore__ inline void CopyIn(int32_t progress)
    {
        // 分配 UB 空间并从 GM 搬入数据（DataCopyPad 支持任意长度，尾部无丢失）
        uint32_t curLen = CurLen(progress);
        AscendC::LocalTensor<float> xLocal = inQueueX.AllocTensor<float>();
        AscendC::LocalTensor<float> yLocal = inQueueY.AllocTensor<float>();
        AscendC::DataCopyExtParams cp{1, static_cast<uint32_t>(curLen * sizeof(float)), 0, 0, 0};
        AscendC::DataCopyPadExtParams<float> padParams{};
        AscendC::DataCopyPad(xLocal, xGm[progress * this->tileLength], cp, padParams);
        AscendC::DataCopyPad(yLocal, yGm[progress * this->tileLength], cp, padParams);
        inQueueX.EnQue(xLocal);
        inQueueY.EnQue(yLocal);
    }
    __aicore__ inline void Compute(int32_t progress)
    {
        AscendC::LocalTensor<float> xLocal = inQueueX.DeQue<float>();
        AscendC::LocalTensor<float> yLocal = inQueueY.DeQue<float>();
        AscendC::LocalTensor<float> zLocal = outQueueZ.AllocTensor<float>();
        // 逐元素乘法 z = x * y（按当前块实际长度计算）
        AscendC::Mul(zLocal, xLocal, yLocal, CurLen(progress));
        outQueueZ.EnQue(zLocal);
        inQueueX.FreeTensor(xLocal);
        inQueueY.FreeTensor(yLocal);
    }
    __aicore__ inline void CopyOut(int32_t progress)
    {
        uint32_t curLen = CurLen(progress);
        AscendC::LocalTensor<float> zLocal = outQueueZ.DeQue<float>();
        AscendC::DataCopyParams cp{1, static_cast<uint16_t>(curLen * sizeof(float)), 0, 0};
        AscendC::DataCopyPad(zGm[progress * this->tileLength], zLocal, cp);
        outQueueZ.FreeTensor(zLocal);
    }

private:
    AscendC::TPipe pipe;
    AscendC::TQue<AscendC::TPosition::VECIN, BUFFER_NUM> inQueueX, inQueueY;
    AscendC::TQue<AscendC::TPosition::VECOUT, BUFFER_NUM> outQueueZ;
    AscendC::GlobalTensor<float> xGm, yGm, zGm;
    uint32_t blockLength = 0;
    uint32_t tileNum = 0;
    uint32_t tileLength = 0;
};

// Kernel 入口函数
__global__ __aicore__ void mul_custom(GM_ADDR x, GM_ADDR y, GM_ADDR z, MulCustomTilingData tiling)
{
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);
    KernelMul op;
    op.Init(x, y, z, tiling.totalLength, tiling.tileNum);
    op.Process();
}

// ----- Host 侧：kernel 直调封装 -----

std::vector<float> kernel_mul(std::vector<float> &x, std::vector<float> &y)
{
    constexpr uint32_t blockDim = 8;
    uint32_t totalLength = static_cast<uint32_t>(x.size());

    // 设置 tiling：totalLength 均分给 8 个核，每核再分 8 个 tile
    MulCustomTilingData tiling;
    tiling.totalLength = totalLength;
    tiling.tileNum = 8;

    // 初始化 ACL 环境（每步检查返回值）
    aclError ret = aclInit(nullptr);
    if (ret != ACL_SUCCESS) {
        std::cerr << "[ERROR] aclInit failed, ret=" << ret << std::endl;
        return {};
    }
    ret = aclrtSetDevice(0);
    if (ret != ACL_SUCCESS) {
        std::cerr << "[ERROR] aclrtSetDevice failed, ret=" << ret << std::endl;
        aclFinalize();
        return {};
    }
    aclrtStream stream = nullptr;
    ret = aclrtCreateStream(&stream);
    if (ret != ACL_SUCCESS) {
        std::cerr << "[ERROR] aclrtCreateStream failed, ret=" << ret << std::endl;
        aclrtResetDevice(0);
        aclFinalize();
        return {};
    }

    // 申请 Host / Device 内存
    size_t byteSize = totalLength * sizeof(float);
    float *xHost = nullptr;
    float *yHost = nullptr;
    float *zHost = nullptr;
    void *xDevice = nullptr;
    void *yDevice = nullptr;
    void *zDevice = nullptr;

    // 统一失败清理
    auto cleanup = [&]() {
        if (xHost != nullptr) { aclrtFreeHost(xHost); }
        if (yHost != nullptr) { aclrtFreeHost(yHost); }
        if (zHost != nullptr) { aclrtFreeHost(zHost); }
        if (xDevice != nullptr) { aclrtFree(xDevice); }
        if (yDevice != nullptr) { aclrtFree(yDevice); }
        if (zDevice != nullptr) { aclrtFree(zDevice); }
        if (stream != nullptr) { aclrtDestroyStream(stream); }
        aclrtResetDevice(0);
        aclFinalize();
    };

    ret = aclrtMallocHost((void **)&xHost, byteSize);
    if (ret != ACL_SUCCESS) { std::cerr << "[ERROR] mallocHost x failed, ret=" << ret << std::endl; cleanup(); return {}; }
    ret = aclrtMallocHost((void **)&yHost, byteSize);
    if (ret != ACL_SUCCESS) { std::cerr << "[ERROR] mallocHost y failed, ret=" << ret << std::endl; cleanup(); return {}; }
    ret = aclrtMallocHost((void **)&zHost, byteSize);
    if (ret != ACL_SUCCESS) { std::cerr << "[ERROR] mallocHost z failed, ret=" << ret << std::endl; cleanup(); return {}; }
    ret = aclrtMalloc(&xDevice, byteSize, ACL_MEM_MALLOC_HUGE_FIRST);
    if (ret != ACL_SUCCESS) { std::cerr << "[ERROR] malloc x failed, ret=" << ret << std::endl; cleanup(); return {}; }
    ret = aclrtMalloc(&yDevice, byteSize, ACL_MEM_MALLOC_HUGE_FIRST);
    if (ret != ACL_SUCCESS) { std::cerr << "[ERROR] malloc y failed, ret=" << ret << std::endl; cleanup(); return {}; }
    ret = aclrtMalloc(&zDevice, byteSize, ACL_MEM_MALLOC_HUGE_FIRST);
    if (ret != ACL_SUCCESS) { std::cerr << "[ERROR] malloc z failed, ret=" << ret << std::endl; cleanup(); return {}; }

    // 准备输入数据并拷贝到 Device
    for (uint32_t i = 0; i < totalLength; i++) {
        xHost[i] = x[i];
        yHost[i] = y[i];
    }
    ret = aclrtMemcpy(xDevice, byteSize, xHost, byteSize, ACL_MEMCPY_HOST_TO_DEVICE);
    if (ret != ACL_SUCCESS) { std::cerr << "[ERROR] memcpy x failed, ret=" << ret << std::endl; cleanup(); return {}; }
    ret = aclrtMemcpy(yDevice, byteSize, yHost, byteSize, ACL_MEMCPY_HOST_TO_DEVICE);
    if (ret != ACL_SUCCESS) { std::cerr << "[ERROR] memcpy y failed, ret=" << ret << std::endl; cleanup(); return {}; }

    // 调用 kernel 并同步
    mul_custom<<<blockDim, nullptr, stream>>>((__gm__ uint8_t *)xDevice,
        (__gm__ uint8_t *)yDevice, (__gm__ uint8_t *)zDevice, tiling);
    ret = aclrtSynchronizeStream(stream);
    if (ret != ACL_SUCCESS) { std::cerr << "[ERROR] synchronize failed, ret=" << ret << std::endl; cleanup(); return {}; }

    // 结果拷回 Host
    ret = aclrtMemcpy(zHost, byteSize, zDevice, byteSize, ACL_MEMCPY_DEVICE_TO_HOST);
    if (ret != ACL_SUCCESS) { std::cerr << "[ERROR] memcpy z failed, ret=" << ret << std::endl; cleanup(); return {}; }
    std::vector<float> output(zHost, zHost + totalLength);

    // 释放资源
    cleanup();
    return output;
}

// ----- 验证与主函数 -----

uint32_t VerifyResult(std::vector<float> &output, std::vector<float> &golden)
{
    auto printTensor = [](std::vector<float> &tensor, const char *name) {
        constexpr size_t maxPrintSize = 20;
        std::cout << name << ": ";
        std::copy(tensor.begin(), tensor.begin() + std::min(tensor.size(), maxPrintSize),
            std::ostream_iterator<float>(std::cout, " "));
        if (tensor.size() > maxPrintSize) {
            std::cout << "...";
        }
        std::cout << std::endl;
    };
    printTensor(output, "Output");
    printTensor(golden, "Golden");
    if (std::equal(golden.begin(), golden.end(), output.begin())) {
        std::cout << "[Success] Case accuracy is verification passed." << std::endl;
        return 0;
    } else {
        std::cout << "[Failed] Case accuracy is verification failed!" << std::endl;
        return 1;
    }
}

int32_t main(int32_t argc, char *argv[])
{
    constexpr uint32_t totalLength = 8 * 2048;
    constexpr float valueX = 1.2f;
    constexpr float valueY = 2.3f;
    std::vector<float> x(totalLength, valueX);
    std::vector<float> y(totalLength, valueY);

    std::vector<float> output = kernel_mul(x, y);

    std::vector<float> golden(totalLength, valueX * valueY);
    return VerifyResult(output, golden);
}
