#include "inplace_rsqrt.h"
#include "inplace_rsqrt_api.h"
#include "shape_utils.h"

// Contiguous 4D ND is flattened by the host; every tile owns disjoint GM bytes.
extern "C" __global__ __vector__ void inplace_rsqrt_fp16_kernel(
    GM_ADDR selfGm, uint64_t elements)
{
    constexpr uint32_t TILE = inplace_rsqrt_host::TILE_ELEMENTS;
    const uint64_t tiles = elements / TILE + (elements % TILE != 0);
    const uint64_t group = AscendC::GetBlockIdx();
    const uint64_t groups = AscendC::GetBlockNum();
    if (group >= tiles) return;

    AscendC::TPipe pipe;
    // A2/A3 DataCopyPad supports GM <-> VECIN; keep this single UB in VECIN.
    AscendC::TBuf<AscendC::TPosition::VECIN> selfBuffer;
    pipe.InitBuffer(selfBuffer, TILE * sizeof(half));
    auto self = selfBuffer.Get<half>();
    AscendC::GlobalTensor<half> gm;
    gm.SetGlobalBuffer(reinterpret_cast<__gm__ half *>(selfGm), elements);
    const auto inputReady = pipe.FetchEventID(AscendC::HardEvent::MTE2_V);
    const auto resultReady = pipe.FetchEventID(AscendC::HardEvent::V_MTE3);
    const auto outputDone = pipe.FetchEventID(AscendC::HardEvent::MTE3_S);

    for (uint64_t tile = group; tile < tiles; tile += groups) {
        const uint64_t offset = tile * TILE;
        const uint32_t valid = static_cast<uint32_t>(
            elements - offset < TILE ? elements - offset : TILE);
        const AscendC::DataCopyExtParams copy{
            1, static_cast<uint32_t>(valid * sizeof(half)), 0, 0, 0};
        const AscendC::DataCopyPadExtParams<half> padding{false, 0, 0, 0};
        AscendC::DataCopyPad(self, gm[offset], copy, padding);
        AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(inputReady);
        AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(inputReady);
        // valid<=TILE, so the helper's shape/capacity checks succeed.
        (void)local_ops::InplaceRsqrt(self, 1, 1, 1, valid);
        AscendC::SetFlag<AscendC::HardEvent::V_MTE3>(resultReady);
        AscendC::WaitFlag<AscendC::HardEvent::V_MTE3>(resultReady);
        AscendC::DataCopyPad(gm[offset], self, copy);
        // Finish the store before reusing this same UB in the next tile.
        AscendC::SetFlag<AscendC::HardEvent::MTE3_S>(outputDone);
        AscendC::WaitFlag<AscendC::HardEvent::MTE3_S>(outputDone);
    }
}

extern "C" aclError InplaceRsqrtFp16(void *deviceSelf,
    uint64_t n4, uint64_t n3, uint64_t n2, uint64_t n1, aclrtStream stream)
{
    const uint64_t shape[4] = {n4, n3, n2, n1};
    uint64_t elements = 0;
    size_t bytes = 0;
    if (!inplace_rsqrt_host::ShapeSize(shape, elements, bytes)) return ACL_ERROR_INVALID_PARAM;
    if (elements == 0) return ACL_SUCCESS;
    if (deviceSelf == nullptr || (reinterpret_cast<uintptr_t>(deviceSelf) & 1u) != 0) {
        return ACL_ERROR_INVALID_PARAM;
    }
    int32_t device = 0;
    aclError status = aclrtGetDevice(&device);
    if (status != ACL_SUCCESS) return status;
    int64_t vectorCores = 0;
    status = aclrtGetDeviceInfo(device, ACL_DEV_ATTR_VECTOR_CORE_NUM, &vectorCores);
    if (status != ACL_SUCCESS) return status;
    if (vectorCores <= 0 || static_cast<uint64_t>(vectorCores) > 0xffffffffu) {
        return ACL_ERROR_INVALID_PARAM;
    }
    const uint64_t tiles = elements / inplace_rsqrt_host::TILE_ELEMENTS +
        (elements % inplace_rsqrt_host::TILE_ELEMENTS != 0);
    const uint32_t blocks = static_cast<uint32_t>(
        tiles < static_cast<uint64_t>(vectorCores) ? tiles : vectorCores);
    inplace_rsqrt_fp16_kernel<<<blocks, nullptr, stream>>>(
        reinterpret_cast<GM_ADDR>(deviceSelf), elements);
    return aclrtSynchronizeStream(stream);
}
