// ============================================================================
// Ascend C Kernel 实现 - add_custom 算子（纯 kernel，不含 host 代码）
//   z = x + y，float16，ND，2 维 [N2, N1]
//
// 数据流：CopyIn(MTE2) → Compute(Vector) → CopyOut(MTE3)，三段流水配合双缓冲。
//
// 关于 2 维形状：ND 格式下 [N2, N1] 在 GM 上按行优先连续排布，
// 逐元素加法与形状无关，因此核内按连续一维区间切分处理；
// N2/N1 在 tiling 中保留并由 host 侧做形状校验，便于后续扩展为按行切分。
// ============================================================================

#include "kernel_operator.h"
#include "add_custom_tiling.h"

using AscendC::TPipe;
using AscendC::TQue;
using AscendC::GlobalTensor;
using AscendC::LocalTensor;
using AscendC::DataCopyExtParams;
using AscendC::DataCopyPadExtParams;

// Kernel 类 - 封装单核上的计算逻辑
class KernelAddCustom {
public:
    __aicore__ inline KernelAddCustom(TPipe* pipe)
    {
        pipe_ = pipe;
    }

    __aicore__ inline void Init(GM_ADDR x, GM_ADDR y, GM_ADDR z, const __gm__ AddCustomTilingData* tiling)
    {
        uint32_t blockIdx = AscendC::GetBlockIdx();
        uint64_t coreOffset = static_cast<uint64_t>(blockIdx) * tiling->numPerCore;
        // 前 blockNum-1 个核处理 numPerCore 个元素，最后一个核处理 tailNumLastCore 个
        bool isLastCore = (blockIdx + 1 == tiling->blockNum);
        coreLength_ = isLastCore ? tiling->tailNumLastCore : tiling->numPerCore;

        // float16 张量在 GM 中连续存放，按元素偏移定位本核负责的区间
        // SetGlobalBuffer 的第二个参数是元素个数
        uint32_t bufferLen = static_cast<uint32_t>(coreLength_);
        xGm_.SetGlobalBuffer((__gm__ half*)x + coreOffset, bufferLen);
        yGm_.SetGlobalBuffer((__gm__ half*)y + coreOffset, bufferLen);
        zGm_.SetGlobalBuffer((__gm__ half*)z + coreOffset, bufferLen);

        pipe_->InitBuffer(inQueueX_, DOUBLE_BUFFER, TILE_LENGTH * sizeof(half));
        pipe_->InitBuffer(inQueueY_, DOUBLE_BUFFER, TILE_LENGTH * sizeof(half));
        pipe_->InitBuffer(outQueueZ_, DOUBLE_BUFFER, TILE_LENGTH * sizeof(half));
    }

    __aicore__ inline void Process()
    {
        uint64_t tileNum = (coreLength_ + TILE_LENGTH - 1) / TILE_LENGTH;
        for (uint64_t i = 0; i < tileNum; i++) {
            uint64_t offset = i * TILE_LENGTH;
            uint64_t remain = coreLength_ - offset;
            uint32_t count = (remain > TILE_LENGTH) ? TILE_LENGTH : static_cast<uint32_t>(remain);
            CopyIn(offset, count);
            Compute(count);
            CopyOut(offset, count);
        }
    }

private:
    __aicore__ inline void CopyIn(uint64_t offset, uint32_t count)
    {
        LocalTensor<half> xLocal = inQueueX_.AllocTensor<half>();
        LocalTensor<half> yLocal = inQueueY_.AllocTensor<half>();

        // 尾块元素数不是 32B 整数倍，用 DataCopyPad 搬运，越界部分由 pad 补零
        DataCopyExtParams copyParams{1, static_cast<uint16_t>(count * sizeof(half)), 0, 0};
        DataCopyPadExtParams<half> padParams{false, 0, 0, 0};

        AscendC::DataCopyPad(xLocal, xGm_[offset], copyParams, padParams);
        AscendC::DataCopyPad(yLocal, yGm_[offset], copyParams, padParams);

        inQueueX_.EnQue(xLocal);
        inQueueY_.EnQue(yLocal);
    }

    __aicore__ inline void Compute(uint32_t count)
    {
        LocalTensor<half> xLocal = inQueueX_.DeQue<half>();
        LocalTensor<half> yLocal = inQueueY_.DeQue<half>();
        LocalTensor<half> zLocal = outQueueZ_.AllocTensor<half>();

        // z = x + y（逐元素，count 个元素）
        AscendC::Add(zLocal, xLocal, yLocal, count);

        outQueueZ_.EnQue<half>(zLocal);
        inQueueX_.FreeTensor(xLocal);
        inQueueY_.FreeTensor(yLocal);
    }

    __aicore__ inline void CopyOut(uint64_t offset, uint32_t count)
    {
        LocalTensor<half> zLocal = outQueueZ_.DeQue<half>();

        DataCopyExtParams copyParams{1, static_cast<uint16_t>(count * sizeof(half)), 0, 0};
        AscendC::DataCopyPad(zGm_[offset], zLocal, copyParams);

        outQueueZ_.FreeTensor(zLocal);
    }

    TPipe* pipe_;
    GlobalTensor<half> xGm_;
    GlobalTensor<half> yGm_;
    GlobalTensor<half> zGm_;

    TQue<AscendC::TPosition::VECIN, 1> inQueueX_;
    TQue<AscendC::TPosition::VECIN, 1> inQueueY_;
    TQue<AscendC::TPosition::VECOUT, 1> outQueueZ_;

    uint64_t coreLength_;  // 本核负责的元素数
};

// 核函数入口：x, y 为输入，z 为输出，tiling 为 host 下发的 tiling 数据
extern "C" __global__ __vector__ void add_custom_kernel(GM_ADDR x, GM_ADDR y, GM_ADDR z, GM_ADDR tiling)
{
    TPipe pipe;
    KernelAddCustom op(&pipe);
    op.Init(x, y, z, (__gm__ AddCustomTilingData*)tiling);
    op.Process();
}
