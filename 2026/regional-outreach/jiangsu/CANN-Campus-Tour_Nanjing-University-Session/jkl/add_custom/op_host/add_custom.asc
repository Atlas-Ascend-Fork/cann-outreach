// ============================================================================
// Ascend C Kernel 直调样例 - add_custom 算子（Host + Main 入口）
//   z = x + y，float16，ND，2 维 [N2, N1]
//
// 文件分工：
//   op_kernel/add_custom_tiling.h   - Tiling 常量 + 结构体 + tiling 计算（host/kernel 共用）
//   op_kernel/add_custom_kernel.asc - Kernel 实现（KernelAddCustom 类 + 核函数入口）
//   op_host/add_custom.asc          - 本文件：Host 端代码 + main 入口
// ============================================================================

#include <cstdint>
#include <cstdio>
#include <string>
#include <vector>
#include "acl/acl.h"
#include "../op_kernel/add_custom_tiling.h"
#include "data_utils.h"

// 引用纯 kernel 文件（其内部包含 kernel_operator.h）
#include "../op_kernel/add_custom_kernel.asc"

// ============================================================================
// Host 端代码 - 运行在 CPU 上
// ============================================================================

// 直调验证用例的输入形状：[N2, N1]，float16
// 需与 scripts/case_config.py 中的 DIM0 / DIM1 保持一致
constexpr uint32_t kDim0 = 512;
constexpr uint32_t kDim1 = 1024;

struct ArgInfo {
    std::string fileName;
    size_t length;
};

// KernelCall 封装 - 处理数据搬运与核函数调用的完整流程
void KernelCall(uint32_t blockNum, aclrtStream stream,
    std::vector<ArgInfo> &inputsInfo, std::vector<ArgInfo> &outputsInfo,
    uint8_t *tilingData)
{
    std::vector<uint8_t *> inputHost(inputsInfo.size());
    std::vector<uint8_t *> inputDevice(inputsInfo.size());
    std::vector<uint8_t *> outputHost(outputsInfo.size());
    std::vector<uint8_t *> outputDevice(outputsInfo.size());
    uint8_t *tilingDevice = nullptr;

    aclrtMalloc((void **)&tilingDevice, sizeof(AddCustomTilingData), ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMemcpy(tilingDevice, sizeof(AddCustomTilingData), tilingData,
        sizeof(AddCustomTilingData), ACL_MEMCPY_HOST_TO_DEVICE);

    for (size_t i = 0; i < inputsInfo.size(); i++) {
        aclrtMallocHost((void **)&inputHost[i], inputsInfo[i].length);
        aclrtMalloc((void **)&inputDevice[i], inputsInfo[i].length, ACL_MEM_MALLOC_HUGE_FIRST);
        ReadFile(inputsInfo[i].fileName, inputsInfo[i].length, inputHost[i], inputsInfo[i].length);
        aclrtMemcpy(inputDevice[i], inputsInfo[i].length, inputHost[i],
            inputsInfo[i].length, ACL_MEMCPY_HOST_TO_DEVICE);
    }

    for (size_t i = 0; i < outputsInfo.size(); i++) {
        aclrtMallocHost((void **)&outputHost[i], outputsInfo[i].length);
        aclrtMalloc((void **)&outputDevice[i], outputsInfo[i].length, ACL_MEM_MALLOC_HUGE_FIRST);
    }

    // 核函数调用：2 个输入 + 1 个输出 + tiling
    add_custom_kernel<<<blockNum, nullptr, stream>>>(
        inputDevice[0], inputDevice[1],
        outputDevice[0], tilingDevice);
    aclrtSynchronizeStream(stream);

    aclrtFree(tilingDevice);
    for (size_t i = 0; i < outputsInfo.size(); i++) {
        aclrtMemcpy(outputHost[i], outputsInfo[i].length, outputDevice[i],
            outputsInfo[i].length, ACL_MEMCPY_DEVICE_TO_HOST);
        WriteFile(outputsInfo[i].fileName, outputHost[i], outputsInfo[i].length);
        aclrtFree(outputDevice[i]);
        aclrtFreeHost(outputHost[i]);
    }

    for (size_t i = 0; i < inputsInfo.size(); i++) {
        aclrtFree(inputDevice[i]);
        aclrtFreeHost(inputHost[i]);
    }
}

// ACL 标准初始化流程
int32_t main(int32_t argc, char *argv[])
{
    aclInit(nullptr);
    int32_t deviceId = 0;
    auto ret = aclrtSetDevice(deviceId);
    if (ret != ACL_SUCCESS) {
        printf("aclrtSetDevice failed, ret=%d\n", ret);
        return ret;
    }

    // 获取设备的 Vector 核数，用于计算 tiling
    int64_t availableCoreNum = 0;
    ret = aclrtGetDeviceInfo(deviceId, ACL_DEV_ATTR_VECTOR_CORE_NUM, &availableCoreNum);
    if (ret != ACL_SUCCESS) {
        printf("aclrtGetDeviceInfo failed, ret=%d\n", ret);
        aclrtResetDevice(deviceId);
        return ret;
    }

    // 输入/输出规格：2 维 [kDim0, kDim1]，float16
    uint64_t totalLength = static_cast<uint64_t>(kDim0) * kDim1;
    size_t byteSize = static_cast<size_t>(totalLength) * DTYPE_BYTES;

    // 下发 tiling
    AddCustomTilingData tiling = ComputeAddCustomTiling(totalLength, kDim0, kDim1,
                                                        static_cast<uint32_t>(availableCoreNum));
    if (tiling.blockNum == 0) {
        printf("ComputeAddCustomTiling failed, totalLength=%llu\n",
               static_cast<unsigned long long>(totalLength));
        aclrtResetDevice(deviceId);
        return -1;
    }
    printf("[info] shape=[%u, %u], dtype=float16, total=%llu, coreNum=%lld, "
           "blockNum=%u, numPerCore=%llu, tailNumLastCore=%llu\n",
           kDim0, kDim1, static_cast<unsigned long long>(totalLength),
           static_cast<long long>(availableCoreNum), tiling.blockNum,
           static_cast<unsigned long long>(tiling.numPerCore),
           static_cast<unsigned long long>(tiling.tailNumLastCore));

    std::vector<ArgInfo> inputsInfo = {
        {"./input/input_x.bin", byteSize},
        {"./input/input_y.bin", byteSize}
    };
    std::vector<ArgInfo> outputsInfo = {
        {"./output/output.bin", byteSize}
    };

    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);

    KernelCall(tiling.blockNum, stream, inputsInfo, outputsInfo, (uint8_t *)&tiling);

    aclrtDestroyStream(stream);
    aclrtResetDevice(deviceId);
    aclFinalize();

    printf("[info] output written to ./output/output.bin\n");
    return 0;
}
