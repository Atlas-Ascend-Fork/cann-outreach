#include <cmath>
#include <stdexcept>
#include "kernel_operator.h"

// Each core processes independent tiles; queues synchronize copy and compute.
constexpr uint32_t MUL_TILE_LENGTH = 1024;

template <typename T>
class KernelMul {
public:
    __aicore__ inline void Init(GM_ADDR x, GM_ADDR y, GM_ADDR z, uint64_t length)
    {
        length_ = length;
        xGm_.SetGlobalBuffer((__gm__ T*)x, length);
        yGm_.SetGlobalBuffer((__gm__ T*)y, length);
        zGm_.SetGlobalBuffer((__gm__ T*)z, length);
        pipe_.InitBuffer(xQueue_, 1, MUL_TILE_LENGTH * sizeof(T));
        pipe_.InitBuffer(yQueue_, 1, MUL_TILE_LENGTH * sizeof(T));
        pipe_.InitBuffer(zQueue_, 1, MUL_TILE_LENGTH * sizeof(T));
    }

    __aicore__ inline void Process()
    {
        for (uint64_t offset = static_cast<uint64_t>(AscendC::GetBlockIdx()) * MUL_TILE_LENGTH;
             offset < length_;
             offset += static_cast<uint64_t>(AscendC::GetBlockNum()) * MUL_TILE_LENGTH) {
            uint32_t count = length_ - offset < MUL_TILE_LENGTH
                ? static_cast<uint32_t>(length_ - offset) : MUL_TILE_LENGTH;
            AscendC::DataCopyExtParams copyParams{1, static_cast<uint32_t>(count * sizeof(T)), 0, 0, 0};
            AscendC::DataCopyPadExtParams<T> padParams{false, 0, 0, 0};
            auto xLocal = xQueue_.template AllocTensor<T>();
            auto yLocal = yQueue_.template AllocTensor<T>();
            AscendC::DataCopyPad(xLocal, xGm_[offset], copyParams, padParams);
            AscendC::DataCopyPad(yLocal, yGm_[offset], copyParams, padParams);
            xQueue_.EnQue(xLocal);
            yQueue_.EnQue(yLocal);

            xLocal = xQueue_.template DeQue<T>();
            yLocal = yQueue_.template DeQue<T>();
            auto zLocal = zQueue_.template AllocTensor<T>();
            AscendC::Mul(zLocal, xLocal, yLocal, count);
            zQueue_.EnQue(zLocal);
            xQueue_.FreeTensor(xLocal);
            yQueue_.FreeTensor(yLocal);

            zLocal = zQueue_.template DeQue<T>();
            // Copy only valid bytes, including a final tile shorter than 32 bytes.
            AscendC::DataCopyPad(zGm_[offset], zLocal, copyParams);
            zQueue_.FreeTensor(zLocal);
        }
    }

private:
    AscendC::TPipe pipe_;
    AscendC::TQue<AscendC::QuePosition::VECIN, 1> xQueue_, yQueue_;
    AscendC::TQue<AscendC::QuePosition::VECOUT, 1> zQueue_;
    AscendC::GlobalTensor<T> xGm_, yGm_, zGm_;
    uint64_t length_ = 0;
};

template <typename T>
__global__ __vector__ void mul_custom(GM_ADDR x, GM_ADDR y, GM_ADDR z, uint64_t length)
{
    KernelMul<T> op;
    op.Init(x, y, z, length);
    op.Process();
}

extern "C" void run_kernel(
    GM_ADDR x,
    const TensorGroupInfo& info_x,
    GM_ADDR y,
    const TensorGroupInfo& info_y,
    GM_ADDR z,
    const TensorGroupInfo& info_z,
    int64_t availableCoreNum,
    aclrtStream stream)
{
    if (info_x.numTensors != 1 || info_y.numTensors != 1 || info_z.numTensors != 1)
        throw std::invalid_argument("Mul expects one tensor per input/output");
    const auto& tx = info_x.tensors[0];
    const auto& ty = info_y.tensors[0];
    const auto& tz = info_z.tensors[0];
    if ((tx.dtype != 0 && tx.dtype != 1) || ty.dtype != tx.dtype || tz.dtype != tx.dtype ||
        tx.numDims != ty.numDims || tx.numDims != tz.numDims)
        throw std::invalid_argument("Mul expects matching float32 or float16 tensors with identical shapes");
    uint64_t length = 1;
    for (int64_t i = 0; i < tx.numDims; ++i) {
        if (tx.shape[i] < 0 || tx.shape[i] != ty.shape[i] || tx.shape[i] != tz.shape[i])
            throw std::invalid_argument("Mul expects identical nonnegative shapes");
        length *= static_cast<uint64_t>(tx.shape[i]);
    }
    if (length == 0)
        return;
    if (availableCoreNum <= 0)
        throw std::invalid_argument("Mul requires at least one vector core");
    const uint64_t tiles = (length + MUL_TILE_LENGTH - 1) / MUL_TILE_LENGTH;
    const uint32_t blockNum = static_cast<uint32_t>(
        tiles < static_cast<uint64_t>(availableCoreNum) ? tiles : availableCoreNum);
    if (tx.dtype == 0)
        mul_custom<float><<<blockNum, nullptr, stream>>>(x, y, z, length);
    else
        mul_custom<half><<<blockNum, nullptr, stream>>>(x, y, z, length);
}


