#include <array>
#include <fstream>
#include <iostream>
#include <stdexcept>
#include <string>
#include <vector>
#include <cstdint>
#include <cstdio>
#include <cstdlib>
#include <cstring>
#include <ctime>
#include <cmath>
#include "acl/acl.h"
#ifndef GM_ADDR
#define GM_ADDR __gm__ uint8_t*
#endif
#ifndef TENSOR_GROUP_INFO_DEFINED
#define TENSOR_GROUP_INFO_DEFINED
struct TensorInfo {
    const int64_t* shape;
    int64_t numDims;
    int32_t dtype;
};
struct TensorGroupInfo {
    const TensorInfo* tensors;
    int64_t numTensors;
};
#endif
#ifdef ASCENDC_CPU_DEBUG
#include "cpu_debug_launch.h"
#endif
#include "kernel.asc"

static void check(aclError code) {
    if (code != ACL_SUCCESS)
        throw std::runtime_error("ACL call failed: " + std::to_string(code));
}
struct DeviceMemory {
    std::vector<void*> pointers;
    void* allocate(size_t bytes) {
        void* ptr = nullptr;
        check(aclrtMalloc(&ptr, bytes ? bytes : 1, ACL_MEM_MALLOC_HUGE_FIRST));
        pointers.push_back(ptr);
        return ptr;
    }
    ~DeviceMemory() {
        for (auto ptr : pointers)
            aclrtFree(ptr);
    }
};
struct Session {
    int device;
    aclrtStream stream = nullptr;
    bool initialized = false, selected = false;
    explicit Session(int number) : device(number) {
    }
    void start() {
        check(aclInit(nullptr));
        initialized = true;
        check(aclrtSetDevice(device));
        selected = true;
        check(aclrtCreateStream(&stream));
    }
    ~Session() {
        if (stream)
            aclrtDestroyStream(stream);
        if (selected)
            aclrtResetDevice(device);
        if (initialized)
            aclFinalize();
    }
};
struct Tensor {
    std::vector<int64_t> shape;
    int32_t dtype;
    size_t bytes;
    std::string file;
};
struct Group {
    std::vector<Tensor> tensors;
    std::vector<void*> data;
    std::vector<TensorInfo> infos;
    DeviceMemory memory;
    void* pointer = nullptr;
    TensorGroupInfo info{nullptr, 0};
    Group(std::vector<Tensor> specs, bool dynamic, bool input) : tensors(std::move(specs)) {
        for (auto& spec : tensors) {
            void* ptr = memory.allocate(spec.bytes);
            data.push_back(ptr);
            infos.push_back(
                {spec.shape.data(), static_cast<int64_t>(spec.shape.size()), spec.dtype});
            if (input) {
                std::ifstream file("input/" + spec.file, std::ios::binary | std::ios::ate);
                if (!file || file.tellg() != static_cast<std::streamoff>(spec.bytes))
                    throw std::runtime_error("input size mismatch: " + spec.file);
                std::vector<char> host(spec.bytes);
                file.seekg(0);
                if (spec.bytes && !file.read(host.data(), spec.bytes))
                    throw std::runtime_error("input read failed: " + spec.file);
                if (spec.bytes)
                    check(aclrtMemcpy(ptr, spec.bytes, host.data(), spec.bytes,
                                      ACL_MEMCPY_HOST_TO_DEVICE));
            } else if (spec.bytes) {
                check(aclrtMemset(ptr, spec.bytes, 0xA5, spec.bytes));
            }
        }
        info = {infos.data(), static_cast<int64_t>(infos.size())};
        if (data.empty())
            return;
        if (dynamic) {
            std::vector<uint64_t> addresses;
            for (auto ptr : data)
                addresses.push_back(reinterpret_cast<uint64_t>(ptr));
            size_t bytes = addresses.size() * sizeof(uint64_t);
            pointer = memory.allocate(bytes);
            check(aclrtMemcpy(pointer, bytes, addresses.data(), bytes, ACL_MEMCPY_HOST_TO_DEVICE));
        } else
            pointer = data[0];
    }
    void save() {
        for (size_t i = 0; i < tensors.size(); ++i) {
            auto& spec = tensors[i];
            std::vector<char> host(spec.bytes);
            if (spec.bytes)
                check(aclrtMemcpy(host.data(), spec.bytes, data[i], spec.bytes,
                                  ACL_MEMCPY_DEVICE_TO_HOST));
            std::ofstream file("output/" + spec.file, std::ios::binary | std::ios::trunc);
            if (!file || (spec.bytes && !file.write(host.data(), spec.bytes)))
                throw std::runtime_error("output write failed: " + spec.file);
        }
    }
};

int main(int argc, char** argv) {
    try {
        if (argc > 2)
            throw std::runtime_error("usage: ./sample [device_id]");
        std::string value = argc == 2 ? argv[1] : "0";
        size_t used = 0;
        int device = std::stoi(value, &used);
        if (used != value.size() || device < 0 || device > 1023)
            throw std::runtime_error("invalid device ID");
        Session session(device);
        session.start();
#ifdef ASCENDC_CPU_DEBUG
        int64_t cores = 1;
#else
        int64_t cores = 0;
        check(aclrtGetDeviceInfo(device, ACL_DEV_ATTR_VECTOR_CORE_NUM, &cores));
#endif
        if (cores <= 0)
            throw std::runtime_error("device has no matching cores");
        Group group_0({Tensor{{8, 2048}, 0, 65536, "x.bin"}}, false, true);
        Group group_1({Tensor{{8, 2048}, 0, 65536, "y.bin"}}, false, true);
        Group group_2({Tensor{{8, 2048}, 0, 65536, "z.bin"}}, false, false);
        run_kernel(
            (GM_ADDR)group_0.pointer,
            group_0.info,
            (GM_ADDR)group_1.pointer,
            group_1.info,
            (GM_ADDR)group_2.pointer,
            group_2.info,
            cores,
            session.stream);
        check(aclrtSynchronizeStream(session.stream));
        group_2.save();
        std::cout << "Sample kernel completed; outputs saved for verification.\n";
        return 0;
    } catch (const std::exception& error) {
        std::cerr << "RUN ERROR: " << error.what() << '\n';
        return 2;
    }
}
