#include "kernel_operator.h"

namespace {
constexpr uint32_t kTileElements = 1024;
constexpr uint32_t kQueueDepth = 1;
}

template <typename T>
class KernelMul {
public:
    __aicore__ inline void Init(GM_ADDR x, GM_ADDR y, GM_ADDR z, uint32_t totalElements)
    {
        totalElements_ = totalElements;
        tileCount_ = (totalElements + kTileElements - 1) / kTileElements;
        xGm_.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(x), totalElements);
        yGm_.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(y), totalElements);
        zGm_.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(z), totalElements);

        pipe_.InitBuffer(xQueue_, kQueueDepth, kTileElements * sizeof(T));
        pipe_.InitBuffer(yQueue_, kQueueDepth, kTileElements * sizeof(T));
        pipe_.InitBuffer(zQueue_, kQueueDepth, kTileElements * sizeof(T));
    }

    __aicore__ inline void Process()
    {
        const uint32_t blockCount = AscendC::GetBlockNum();
        for (uint32_t tile = AscendC::GetBlockIdx(); tile < tileCount_; tile += blockCount) {
            const uint32_t offset = tile * kTileElements;
            const uint32_t length = (totalElements_ - offset < kTileElements)
                ? totalElements_ - offset
                : kTileElements;
            CopyIn(offset, length);
            Compute(length);
            CopyOut(offset, length);
        }
    }

private:
    __aicore__ inline void CopyIn(uint32_t offset, uint32_t length)
    {
        AscendC::LocalTensor<T> xLocal = xQueue_.AllocTensor<T>();
        AscendC::LocalTensor<T> yLocal = yQueue_.AllocTensor<T>();
        AscendC::DataCopy(xLocal, xGm_[offset], length);
        AscendC::DataCopy(yLocal, yGm_[offset], length);
        xQueue_.EnQue(xLocal);
        yQueue_.EnQue(yLocal);
    }

    __aicore__ inline void Compute(uint32_t length)
    {
        AscendC::LocalTensor<T> xLocal = xQueue_.DeQue<T>();
        AscendC::LocalTensor<T> yLocal = yQueue_.DeQue<T>();
        AscendC::LocalTensor<T> zLocal = zQueue_.AllocTensor<T>();
        AscendC::Mul(zLocal, xLocal, yLocal, length);
        zQueue_.EnQue(zLocal);
        xQueue_.FreeTensor(xLocal);
        yQueue_.FreeTensor(yLocal);
    }

    __aicore__ inline void CopyOut(uint32_t offset, uint32_t length)
    {
        AscendC::LocalTensor<T> zLocal = zQueue_.DeQue<T>();
        AscendC::DataCopy(zGm_[offset], zLocal, length);
        zQueue_.FreeTensor(zLocal);
    }

    AscendC::TPipe pipe_;
    AscendC::TQue<AscendC::QuePosition::VECIN, kQueueDepth> xQueue_, yQueue_;
    AscendC::TQue<AscendC::QuePosition::VECOUT, kQueueDepth> zQueue_;
    AscendC::GlobalTensor<T> xGm_, yGm_, zGm_;
    uint32_t totalElements_ = 0;
    uint32_t tileCount_ = 0;
};

template <typename T>
__global__ __vector__ void mul_custom(GM_ADDR x, GM_ADDR y, GM_ADDR z, uint32_t totalElements)
{
    KernelMul<T> op;
    op.Init(x, y, z, totalElements);
    op.Process();
}

extern "C" void run_kernel(
    GM_ADDR x,
    const TensorGroupInfo& info_x,
    GM_ADDR y,
    const TensorGroupInfo& info_y,
    GM_ADDR z,
    const TensorGroupInfo& info_z,
    int64_t availableCoreNum,
    aclrtStream stream)
{
    if (info_x.numTensors < 1 || info_y.numTensors < 1 || info_z.numTensors < 1 ||
        availableCoreNum <= 0) {
        return;
    }

    const TensorInfo& xInfo = info_x.tensors[0];
    uint64_t totalElements = 1;
    for (int64_t dim = 0; dim < xInfo.numDims; ++dim) {
        if (xInfo.shape[dim] <= 0) {
            return;
        }
        totalElements *= static_cast<uint64_t>(xInfo.shape[dim]);
    }
    if (totalElements == 0 || totalElements > UINT32_MAX) {
        return;
    }

    const uint32_t tileCount =
        (static_cast<uint32_t>(totalElements) + kTileElements - 1) / kTileElements;
    const uint32_t blockNum = static_cast<uint32_t>(
        availableCoreNum < tileCount ? availableCoreNum : tileCount);

    if (xInfo.dtype == 0) {
        mul_custom<float><<<blockNum, nullptr, stream>>>(
            x, y, z, static_cast<uint32_t>(totalElements));
    } else if (xInfo.dtype == 1) {
        mul_custom<half><<<blockNum, nullptr, stream>>>(
            x, y, z, static_cast<uint32_t>(totalElements));
    }
}
