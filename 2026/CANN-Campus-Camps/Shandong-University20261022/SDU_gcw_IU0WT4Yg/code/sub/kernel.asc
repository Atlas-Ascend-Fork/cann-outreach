#include <cmath>
#include "kernel_operator.h"
using namespace AscendC;

constexpr int32_t TILE_LENGTH = 2048; 

template <typename T>
class KernelSub {
public:
    __aicore__ inline void Init(GM_ADDR x, GM_ADDR y, GM_ADDR z)
    {
        blockIdx = GetBlockIdx();
        xGm.SetGlobalBuffer((__gm__ T *)x);
        yGm.SetGlobalBuffer((__gm__ T *)y);
        zGm.SetGlobalBuffer((__gm__ T *)z);
        pipe.InitBuffer(inQueueX, 1, TILE_LENGTH);
        pipe.InitBuffer(inQueueY, 1, TILE_LENGTH);
        pipe.InitBuffer(outQueueZ, 1, TILE_LENGTH);
    }

    __aicore__ inline void Process(int64_t totalNum, int32_t blockNum)
    {
        constexpr int32_t ALIGN = 32 / sizeof(T);
        int64_t per = (totalNum + (int64_t)blockNum * ALIGN - 1) / ((int64_t)blockNum * ALIGN) * ALIGN;
        int64_t start = (int64_t)blockIdx * per;
        if (start >= totalNum) {
            return;
        }
        int64_t end = (start + per < totalNum) ? (start + per) : totalNum;
        for (int64_t i = start; i < end; i += TILE_LENGTH) {
            int32_t len = (int32_t)((end - i) < TILE_LENGTH ? (end - i) : TILE_LENGTH);
            CopyIn(i, len);
            Compute(len);
            CopyOut(i, len);
        }
    }

private:
    __aicore__ inline void CopyIn(int64_t offset, int32_t len)
    {
        LocalTensor<T> xLocal = inQueueX.AllocTensor<T>();
        LocalTensor<T> yLocal = inQueueY.AllocTensor<T>();
        DataCopy(xLocal, xGm[offset], len);
        DataCopy(yLocal, yGm[offset], len);
        inQueueX.EnQue(xLocal);
        inQueueY.EnQue(yLocal);
    }

    __aicore__ inline void Compute(int32_t len)
    {
        LocalTensor<T> xLocal = inQueueX.DeQue<T>();
        LocalTensor<T> yLocal = inQueueY.DeQue<T>();
        LocalTensor<T> zLocal = outQueueZ.AllocTensor<T>();
        Sub(zLocal, xLocal, yLocal, len);
        outQueueZ.EnQue(zLocal);
        inQueueX.FreeTensor(xLocal);
        inQueueY.FreeTensor(yLocal);
    }

    __aicore__ inline void CopyOut(int64_t offset, int32_t len)
    {
        LocalTensor<T> zLocal = outQueueZ.DeQue<T>();
        DataCopy(zGm[offset], zLocal, len);
        outQueueZ.FreeTensor(zLocal);
    }

private:
    TPipe pipe;
    TQue<QuePosition::VECIN, 1> inQueueX, inQueueY;
    TQue<QuePosition::VECOUT, 1> outQueueZ;
    GlobalTensor<T> xGm, yGm, zGm;
    int32_t blockIdx = 0;
};

extern "C" __global__ __vector__ void sub_custom(GM_ADDR x, GM_ADDR y, GM_ADDR z,
                                                 int64_t totalNum, int32_t blockNum)
{
    KernelSub<float> op;
    op.Init(x, y, z);
    op.Process(totalNum, blockNum);
}

extern "C" __global__ __vector__ void sub_custom_half(GM_ADDR x, GM_ADDR y, GM_ADDR z,
                                                      int64_t totalNum, int32_t blockNum)
{
    KernelSub<half> op;
    op.Init(x, y, z);
    op.Process(totalNum, blockNum);
}

extern "C" void run_kernel(GM_ADDR x, const TensorGroupInfo& info_x, GM_ADDR y,
                           const TensorGroupInfo& info_y, GM_ADDR z,
                           const TensorGroupInfo& info_z, int64_t availableCoreNum,
                           aclrtStream stream)
{
    int64_t totalNum = 1;
    for (int64_t i = 0; i < info_x.tensors[0].numDims; ++i) {
        totalNum *= info_x.tensors[0].shape[i];
    }
    int32_t dtype = info_x.tensors[0].dtype;
    int32_t blockNum = availableCoreNum > 0 ? (int32_t)availableCoreNum : 8;

    if (dtype == 1) {
        sub_custom_half<<<blockNum, nullptr, stream>>>(x, y, z, totalNum, blockNum);
    } else {
        sub_custom<<<blockNum, nullptr, stream>>>(x, y, z, totalNum, blockNum);
    }
}