#include <cmath>
#include <cstdint>
#include "kernel_operator.h"

// 本文件由评测程序包含，不要添加 main()。
// TensorGroupInfo、TensorInfo 由评测程序预先定义。

struct SubCustomTilingData {
    uint32_t totalLength;
    uint32_t blockLength;
    uint32_t tileLength;
    int32_t dtype;
};

template <typename T>
class KernelSub {
public:
    __aicore__ inline KernelSub() {}

    __aicore__ inline void Init(
        GM_ADDR x, GM_ADDR y, GM_ADDR z,
        const SubCustomTilingData& tiling)
    {
        blockLength_ = tiling.blockLength;
        tileLength_ = tiling.tileLength;

        const uint32_t offset =
            AscendC::GetBlockIdx() * blockLength_;

        xGm_.SetGlobalBuffer(
            (__gm__ T*)x + offset, blockLength_);
        yGm_.SetGlobalBuffer(
            (__gm__ T*)y + offset, blockLength_);
        zGm_.SetGlobalBuffer(
            (__gm__ T*)z + offset, blockLength_);

        pipe_.InitBuffer(
            inQueueX_, BUFFER_NUM, tileLength_ * sizeof(T));
        pipe_.InitBuffer(
            inQueueY_, BUFFER_NUM, tileLength_ * sizeof(T));
        pipe_.InitBuffer(
            outQueueZ_, BUFFER_NUM, tileLength_ * sizeof(T));
    }

    __aicore__ inline void Process()
    {
        for (uint32_t offset = 0;
             offset < blockLength_;
             offset += tileLength_) {
            const uint32_t remaining = blockLength_ - offset;
            const uint32_t count =
                remaining < tileLength_ ? remaining : tileLength_;

            CopyIn(offset, count);
            Compute(count);
            CopyOut(offset, count);
        }
    }

private:
    __aicore__ inline void CopyIn(
        uint32_t offset, uint32_t count)
    {
        AscendC::LocalTensor<T> xLocal =
            inQueueX_.AllocTensor<T>();
        AscendC::LocalTensor<T> yLocal =
            inQueueY_.AllocTensor<T>();

        AscendC::DataCopy(xLocal, xGm_[offset], count);
        AscendC::DataCopy(yLocal, yGm_[offset], count);

        inQueueX_.EnQue<T>(xLocal);
        inQueueY_.EnQue<T>(yLocal);
    }

    __aicore__ inline void Compute(uint32_t count)
    {
        AscendC::LocalTensor<T> xLocal =
            inQueueX_.DeQue<T>();
        AscendC::LocalTensor<T> yLocal =
            inQueueY_.DeQue<T>();
        AscendC::LocalTensor<T> zLocal =
            outQueueZ_.AllocTensor<T>();

        // 逐元素计算 z = x - y
        AscendC::Sub(zLocal, xLocal, yLocal, count);

        outQueueZ_.EnQue<T>(zLocal);
        inQueueX_.FreeTensor(xLocal);
        inQueueY_.FreeTensor(yLocal);
    }

    __aicore__ inline void CopyOut(
        uint32_t offset, uint32_t count)
    {
        AscendC::LocalTensor<T> zLocal =
            outQueueZ_.DeQue<T>();

        AscendC::DataCopy(zGm_[offset], zLocal, count);
        outQueueZ_.FreeTensor(zLocal);
    }

    static constexpr int32_t BUFFER_NUM = 2;

    AscendC::TPipe pipe_;
    AscendC::TQue<AscendC::QuePosition::VECIN, BUFFER_NUM>
        inQueueX_;
    AscendC::TQue<AscendC::QuePosition::VECIN, BUFFER_NUM>
        inQueueY_;
    AscendC::TQue<AscendC::QuePosition::VECOUT, BUFFER_NUM>
        outQueueZ_;

    AscendC::GlobalTensor<T> xGm_, yGm_, zGm_;

    uint32_t blockLength_;
    uint32_t tileLength_;
};

__global__ __vector__ void sub_custom(
    GM_ADDR x,
    GM_ADDR y,
    GM_ADDR z,
    SubCustomTilingData tiling)
{
    if (tiling.dtype == 0) {
        KernelSub<float> op;
        op.Init(x, y, z, tiling);
        op.Process();
    } else if (tiling.dtype == 1) {
        KernelSub<half> op;
        op.Init(x, y, z, tiling);
        op.Process();
    }
}

extern "C" void run_kernel(
    GM_ADDR x, const TensorGroupInfo& info_x,
    GM_ADDR y, const TensorGroupInfo& info_y,
    GM_ADDR z, const TensorGroupInfo& info_z,
    int64_t availableCoreNum,
    aclrtStream stream)
{
    if (info_x.numTensors < 1 ||
        info_y.numTensors < 1 ||
        info_z.numTensors < 1 ||
        availableCoreNum <= 0) {
        return;
    }

    const auto& tx = info_x.tensors[0];
    const auto& ty = info_y.tensors[0];
    const auto& tz = info_z.tensors[0];

    // 要求三个张量形状相同，且均为同一种浮点类型。
    if ((tx.dtype != 0 && tx.dtype != 1) ||
        ty.dtype != tx.dtype ||
        tz.dtype != tx.dtype ||
        ty.numDims != tx.numDims ||
        tz.numDims != tx.numDims) {
        return;
    }

    uint64_t totalLength = 1;

    for (int64_t i = 0; i < tx.numDims; ++i) {
        if (tx.shape[i] <= 0 ||
            ty.shape[i] != tx.shape[i] ||
            tz.shape[i] != tx.shape[i]) {
            return;
        }

        if (static_cast<uint64_t>(tx.shape[i]) >
            0xffffffffULL / totalLength) {
            return;
        }

        totalLength *= static_cast<uint64_t>(tx.shape[i]);
    }

    // 普通 DataCopy 的搬运量需要满足 32 字节对齐。
    // 题目规定的 (8, 2048) 对两种数据类型都满足要求。
    const uint32_t alignElements =
        tx.dtype == 0 ? 8U : 16U;

    if (totalLength % alignElements != 0) {
        return;
    }

    // 最多使用 8 个核，并保证每个核处理的数据量对齐。
    uint32_t blockNum =
        availableCoreNum < 8
            ? static_cast<uint32_t>(availableCoreNum)
            : 8U;

    while (blockNum > 1 &&
           totalLength %
               (static_cast<uint64_t>(blockNum) * alignElements)
               != 0) {
        --blockNum;
    }

    SubCustomTilingData tiling{};
    tiling.totalLength = static_cast<uint32_t>(totalLength);
    tiling.blockLength = tiling.totalLength / blockNum;
    tiling.tileLength =
        tiling.blockLength < 256U ? tiling.blockLength : 256U;
    tiling.dtype = tx.dtype;

    sub_custom<<<blockNum, nullptr, stream>>>(
        x, y, z, tiling);
}