#include <cstdint>
#include "kernel_operator.h"

// TensorInfo and TensorGroupInfo are supplied by main.asc.
// Elementwise subtraction for equally shaped float32 / float16 tensors.
namespace sub_impl {

constexpr uint32_t TILE_LENGTH = 2048;

template <typename T>
class KernelSub {
public:
    __aicore__ inline void Init(GM_ADDR x, GM_ADDR y, GM_ADDR z)
    {
        xGm_.SetGlobalBuffer((__gm__ T*)x);
        yGm_.SetGlobalBuffer((__gm__ T*)y);
        zGm_.SetGlobalBuffer((__gm__ T*)z);
        pipe_.InitBuffer(inX_, 1, TILE_LENGTH * sizeof(T));
        pipe_.InitBuffer(inY_, 1, TILE_LENGTH * sizeof(T));
        pipe_.InitBuffer(outZ_, 1, TILE_LENGTH * sizeof(T));
    }

    __aicore__ inline void Process(uint64_t totalLength)
    {
        // Disjoint tiles; for (8,2048), eight cores each process one row.
        const uint64_t step = static_cast<uint64_t>(AscendC::GetBlockNum()) * TILE_LENGTH;
        for (uint64_t offset = static_cast<uint64_t>(AscendC::GetBlockIdx()) * TILE_LENGTH;
             offset < totalLength; offset += step) {
            const uint32_t count = static_cast<uint32_t>(
                totalLength - offset < TILE_LENGTH ? totalLength - offset : TILE_LENGTH);
            const AscendC::DataCopyExtParams copyParams{
                1, count * static_cast<uint32_t>(sizeof(T)), 0, 0, 0};
            const AscendC::DataCopyPadExtParams<T> padParams{};

            auto xLocal = inX_.template AllocTensor<T>();
            auto yLocal = inY_.template AllocTensor<T>();
            AscendC::DataCopyPad(xLocal, xGm_[offset], copyParams, padParams);
            AscendC::DataCopyPad(yLocal, yGm_[offset], copyParams, padParams);
            inX_.EnQue(xLocal);
            inY_.EnQue(yLocal);

            xLocal = inX_.template DeQue<T>();
            yLocal = inY_.template DeQue<T>();
            auto zLocal = outZ_.template AllocTensor<T>();
            AscendC::Sub(zLocal, xLocal, yLocal, static_cast<int32_t>(count));
            outZ_.EnQue(zLocal);
            inX_.FreeTensor(xLocal);
            inY_.FreeTensor(yLocal);

            zLocal = outZ_.template DeQue<T>();
            // Copy valid bytes only, including a possible partial final tile.
            AscendC::DataCopyPad(zGm_[offset], zLocal, copyParams);
            outZ_.FreeTensor(zLocal);
        }
    }

private:
    AscendC::TPipe pipe_;
    AscendC::TQue<AscendC::QuePosition::VECIN, 1> inX_, inY_;
    AscendC::TQue<AscendC::QuePosition::VECOUT, 1> outZ_;
    AscendC::GlobalTensor<T> xGm_, yGm_, zGm_;
};

} // namespace sub_impl

template <typename T>
__global__ __vector__ void sub_custom(GM_ADDR x, GM_ADDR y, GM_ADDR z, uint64_t totalLength)
{
    sub_impl::KernelSub<T> op;
    op.Init(x, y, z);
    op.Process(totalLength);
}

extern "C" void run_kernel(GM_ADDR x, const TensorGroupInfo& info_x,
    GM_ADDR y, const TensorGroupInfo& info_y, GM_ADDR z,
    const TensorGroupInfo& info_z, int64_t availableCoreNum, aclrtStream stream)
{
    if (x == nullptr || y == nullptr || z == nullptr ||
        info_x.tensors == nullptr || info_y.tensors == nullptr || info_z.tensors == nullptr ||
        info_x.numTensors != 1 || info_y.numTensors != 1 || info_z.numTensors != 1) {
        return;
    }
    const TensorInfo& tx = info_x.tensors[0];
    const TensorInfo& ty = info_y.tensors[0];
    const TensorInfo& tz = info_z.tensors[0];
    if (tx.shape == nullptr || ty.shape == nullptr || tz.shape == nullptr ||
        tx.numDims <= 0 || tx.numDims != ty.numDims || tx.numDims != tz.numDims ||
        (tx.dtype != 0 && tx.dtype != 1) || ty.dtype != tx.dtype || tz.dtype != tx.dtype) {
        return;
    }
    uint64_t totalLength = 1;
    for (int64_t dim = 0; dim < tx.numDims; ++dim) {
        if (tx.shape[dim] <= 0 || tx.shape[dim] != ty.shape[dim] || tx.shape[dim] != tz.shape[dim]) {
            return;
        }
        totalLength *= static_cast<uint64_t>(tx.shape[dim]);
    }
    const uint64_t tileCount = (totalLength + sub_impl::TILE_LENGTH - 1) / sub_impl::TILE_LENGTH;
    uint32_t blockNum = static_cast<uint32_t>(tileCount < 8 ? tileCount : 8);
    if (availableCoreNum > 0 && static_cast<uint64_t>(availableCoreNum) < blockNum) {
        blockNum = static_cast<uint32_t>(availableCoreNum);
    }
    if (availableCoreNum <= 0) {
        blockNum = 1;
    }
    if (tx.dtype == 0) {
        sub_custom<float><<<blockNum, nullptr, stream>>>(x, y, z, totalLength);
    } else {
        sub_custom<half><<<blockNum, nullptr, stream>>>(x, y, z, totalLength);
    }
}
