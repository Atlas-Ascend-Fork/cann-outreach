#include "kernel_operator.h"

template <typename T>
__global__ __vector__ void sub_custom(GM_ADDR x, GM_ADDR y, GM_ADDR z)
{
    constexpr uint32_t ROWS = 8;
    constexpr uint32_t COLS = 2048;
    constexpr uint32_t TOTAL = ROWS * COLS;

    AscendC::TPipe pipe;
    AscendC::TQue<AscendC::QuePosition::VECIN, 1> queueX;
    AscendC::TQue<AscendC::QuePosition::VECIN, 1> queueY;
    AscendC::TQue<AscendC::QuePosition::VECOUT, 1> queueZ;

    pipe.InitBuffer(queueX, 1, COLS * sizeof(T));
    pipe.InitBuffer(queueY, 1, COLS * sizeof(T));
    pipe.InitBuffer(queueZ, 1, COLS * sizeof(T));

    AscendC::GlobalTensor<T> xGm;
    AscendC::GlobalTensor<T> yGm;
    AscendC::GlobalTensor<T> zGm;

    xGm.SetGlobalBuffer((__gm__ T*)x, TOTAL);
    yGm.SetGlobalBuffer((__gm__ T*)y, TOTAL);
    zGm.SetGlobalBuffer((__gm__ T*)z, TOTAL);

    for (uint32_t row = AscendC::GetBlockIdx();
         row < ROWS;
         row += AscendC::GetBlockNum()) {
        uint32_t offset = row * COLS;

        auto xLocal = queueX.AllocTensor<T>();
        auto yLocal = queueY.AllocTensor<T>();

        AscendC::DataCopy(xLocal, xGm[offset], COLS);
        AscendC::DataCopy(yLocal, yGm[offset], COLS);

        queueX.EnQue(xLocal);
        queueY.EnQue(yLocal);

        auto xReady = queueX.DeQue<T>();
        auto yReady = queueY.DeQue<T>();
        auto zLocal = queueZ.AllocTensor<T>();

        AscendC::Sub(zLocal, xReady, yReady, COLS);

        queueZ.EnQue(zLocal);
        queueX.FreeTensor(xReady);
        queueY.FreeTensor(yReady);

        auto zReady = queueZ.DeQue<T>();
        AscendC::DataCopy(zGm[offset], zReady, COLS);
        queueZ.FreeTensor(zReady);
    }
}

extern "C" void run_kernel(
    GM_ADDR x, const TensorGroupInfo& info_x,
    GM_ADDR y, const TensorGroupInfo& info_y,
    GM_ADDR z, const TensorGroupInfo& info_z,
    int64_t availableCoreNum, aclrtStream stream)
{
    uint32_t blockNum = 1;
    if (availableCoreNum > 0) {
        blockNum = availableCoreNum >= 8
            ? 8
            : static_cast<uint32_t>(availableCoreNum);
    }

    // dtype: 0 = float32, 1 = float16
    if (info_x.tensors[0].dtype == 0) {
        sub_custom<float><<<blockNum, nullptr, stream>>>(x, y, z);
    } else if (info_x.tensors[0].dtype == 1) {
        sub_custom<half><<<blockNum, nullptr, stream>>>(x, y, z);
    }
}