#include "kernel_operator.h"

// Host 端计算并传给核函数的 tiling 参数。
struct SubCustomTilingData {
    uint64_t totalLength;
    uint32_t tileLength;
    int32_t dtype;
};

template <typename T>
class KernelSub {
public:
    __aicore__ inline void Init(
        GM_ADDR x,
        GM_ADDR y,
        GM_ADDR z,
        SubCustomTilingData tiling)
    {
        totalLength_ = tiling.totalLength;
        tileLength_ = tiling.tileLength;

        xGm_.SetGlobalBuffer((__gm__ T*)x, totalLength_);
        yGm_.SetGlobalBuffer((__gm__ T*)y, totalLength_);
        zGm_.SetGlobalBuffer((__gm__ T*)z, totalLength_);

        pipe_.InitBuffer(queueX_, 1, tileLength_ * sizeof(T));
        pipe_.InitBuffer(queueY_, 1, tileLength_ * sizeof(T));
        pipe_.InitBuffer(queueZ_, 1, tileLength_ * sizeof(T));
    }

    __aicore__ inline void Process()
    {
        uint64_t offset =
            static_cast<uint64_t>(AscendC::GetBlockIdx()) * tileLength_;
        uint64_t stride =
            static_cast<uint64_t>(AscendC::GetBlockNum()) * tileLength_;

        for (; offset < totalLength_; offset += stride) {
            uint64_t remaining = totalLength_ - offset;
            uint32_t count = remaining < tileLength_
                ? static_cast<uint32_t>(remaining)
                : tileLength_;

            CopyIn(offset, count);
            Compute(count);
            CopyOut(offset, count);
        }
    }

private:
    __aicore__ inline void CopyIn(uint64_t offset, uint32_t count)
    {
        auto xLocal = queueX_.AllocTensor<T>();
        auto yLocal = queueY_.AllocTensor<T>();

        // blockLen 的单位为字节；支持末尾不足一个 tile 的数据。
        AscendC::DataCopyExtParams copyParams{
            1,
            static_cast<uint32_t>(count * sizeof(T)),
            0, 0, 0
        };
        AscendC::DataCopyPadExtParams<T> padParams{
            false, 0, 0, static_cast<T>(0)
        };

        AscendC::DataCopyPad(
            xLocal, xGm_[offset], copyParams, padParams);
        AscendC::DataCopyPad(
            yLocal, yGm_[offset], copyParams, padParams);

        queueX_.EnQue(xLocal);
        queueY_.EnQue(yLocal);
    }

    __aicore__ inline void Compute(uint32_t count)
    {
        auto xLocal = queueX_.DeQue<T>();
        auto yLocal = queueY_.DeQue<T>();
        auto zLocal = queueZ_.AllocTensor<T>();

        // z = x - y
        AscendC::Sub(zLocal, xLocal, yLocal, count);

        queueZ_.EnQue(zLocal);
        queueX_.FreeTensor(xLocal);
        queueY_.FreeTensor(yLocal);
    }

    __aicore__ inline void CopyOut(uint64_t offset, uint32_t count)
    {
        auto zLocal = queueZ_.DeQue<T>();

        AscendC::DataCopyExtParams copyParams{
            1,
            static_cast<uint32_t>(count * sizeof(T)),
            0, 0, 0
        };

        AscendC::DataCopyPad(zGm_[offset], zLocal, copyParams);
        queueZ_.FreeTensor(zLocal);
    }

private:
    AscendC::TPipe pipe_;

    AscendC::TQue<AscendC::QuePosition::VECIN, 1> queueX_;
    AscendC::TQue<AscendC::QuePosition::VECIN, 1> queueY_;
    AscendC::TQue<AscendC::QuePosition::VECOUT, 1> queueZ_;

    AscendC::GlobalTensor<T> xGm_;
    AscendC::GlobalTensor<T> yGm_;
    AscendC::GlobalTensor<T> zGm_;

    uint64_t totalLength_;
    uint32_t tileLength_;
};

// 核函数入口。
__global__ __vector__ void sub_custom(
    GM_ADDR x,
    GM_ADDR y,
    GM_ADDR z,
    SubCustomTilingData tiling)
{
    if (tiling.dtype == 0) {
        KernelSub<float> op;
        op.Init(x, y, z, tiling);
        op.Process();
    } else if (tiling.dtype == 1) {
        KernelSub<half> op;
        op.Init(x, y, z, tiling);
        op.Process();
    }
}

// Host 侧：计算 tiling 参数并启动核函数。
extern "C" void run_kernel(
    GM_ADDR x, const TensorGroupInfo& info_x,
    GM_ADDR y, const TensorGroupInfo& info_y,
    GM_ADDR z, const TensorGroupInfo& info_z,
    int64_t availableCoreNum,
    aclrtStream stream)
{
    SubCustomTilingData tiling{};
    tiling.totalLength = 1;
    tiling.tileLength = 2048;
    tiling.dtype = info_x.tensors[0].dtype;

    const auto& tensor = info_x.tensors[0];
    for (int64_t i = 0; i < tensor.numDims; ++i) {
        tiling.totalLength *= static_cast<uint64_t>(tensor.shape[i]);
    }

    if (tiling.totalLength == 0) {
        return;
    }

    uint64_t tileCount =
        (tiling.totalLength + tiling.tileLength - 1) / tiling.tileLength;

    uint64_t coreCount = availableCoreNum > 0
        ? static_cast<uint64_t>(availableCoreNum)
        : 1;

    uint32_t blockNum = static_cast<uint32_t>(
        tileCount < coreCount ? tileCount : coreCount);

    sub_custom<<<blockNum, nullptr, stream>>>(x, y, z, tiling);
}