#include "kernel_operator.h"

using namespace AscendC;

constexpr int32_t BUFFER_NUM = 2; // 启用双缓冲提升搬运与计算流水效率

template <typename T>
class KernelSub {
public:
    __aicore__ inline KernelSub() {}

    __aicore__ inline void Init(GM_ADDR x, GM_ADDR y, GM_ADDR z, uint32_t totalLength, uint32_t colLength)
    {
        this->totalLength = totalLength;
        this->colLength = colLength;

        // 绑定全局内存
        xGm.SetGlobalBuffer((__gm__ T *)x, totalLength);
        yGm.SetGlobalBuffer((__gm__ T *)y, totalLength);
        zGm.SetGlobalBuffer((__gm__ T *)z, totalLength);

        // 按行分配片上内存 Buffer (每行 colLength 个元素)
        pipe.InitBuffer(inQueueX, BUFFER_NUM, colLength * sizeof(T));
        pipe.InitBuffer(inQueueY, BUFFER_NUM, colLength * sizeof(T));
        pipe.InitBuffer(outQueueZ, BUFFER_NUM, colLength * sizeof(T));
    }

    __aicore__ inline void Process()
    {
        uint32_t blockIdx = GetBlockIdx();
        uint32_t blockNum = GetBlockNum();
        uint32_t totalRow = totalLength / colLength;

        // 多核按行切分任务：例如 8 行，若启动了 8 个核，则每个核处理 1 行
        for (uint32_t row = blockIdx; row < totalRow; row += blockNum) {
            CopyIn(row);
            Compute();
            CopyOut(row);
        }
    }

private:
    __aicore__ inline void CopyIn(uint32_t row)
    {
        LocalTensor<T> xLocal = inQueueX.AllocTensor<T>();
        LocalTensor<T> yLocal = inQueueY.AllocTensor<T>();

        // 搬运当前行的数据到 UB
        DataCopy(xLocal, xGm[row * colLength], colLength);
        DataCopy(yLocal, yGm[row * colLength], colLength);

        inQueueX.EnQue(xLocal);
        inQueueY.EnQue(yLocal);
    }

    __aicore__ inline void Compute()
    {
        LocalTensor<T> xLocal = inQueueX.DeQue<T>();
        LocalTensor<T> yLocal = inQueueY.DeQue<T>();
        LocalTensor<T> zLocal = outQueueZ.AllocTensor<T>();

        // 向量减法计算 z = x - y
        Sub(zLocal, xLocal, yLocal, colLength);

        outQueueZ.EnQue<T>(zLocal);
        inQueueX.FreeTensor(xLocal);
        inQueueY.FreeTensor(yLocal);
    }

    __aicore__ inline void CopyOut(uint32_t row)
    {
        LocalTensor<T> zLocal = outQueueZ.DeQue<T>();
        
        // 将结果搬运回全局内存
        DataCopy(zGm[row * colLength], zLocal, colLength);
        
        outQueueZ.FreeTensor(zLocal);
    }

private:
    TPipe pipe;
    TQue<TPosition::VECIN, BUFFER_NUM> inQueueX;
    TQue<TPosition::VECIN, BUFFER_NUM> inQueueY;
    TQue<TPosition::VECOUT, BUFFER_NUM> outQueueZ;

    GlobalTensor<T> xGm;
    GlobalTensor<T> yGm;
    GlobalTensor<T> zGm;

    uint32_t totalLength;
    uint32_t colLength;
};

// ==========================================
// 1. 定义不同数据类型的 NPU 核函数 (kernel entry)
// ==========================================
extern "C" __global__ __aicore__ void sub_custom_float(GM_ADDR x, GM_ADDR y, GM_ADDR z, uint32_t totalLength, uint32_t colLength)
{
    KernelSub<float> op;
    op.Init(x, y, z, totalLength, colLength);
    op.Process();
}

extern "C" __global__ __aicore__ void sub_custom_half(GM_ADDR x, GM_ADDR y, GM_ADDR z, uint32_t totalLength, uint32_t colLength)
{
    KernelSub<half> op;
    op.Init(x, y, z, totalLength, colLength);
    op.Process();
}

// ==========================================
// 2. Host 侧启动函数 (必须叫 run_kernel 且签名与模板一致)
// ==========================================
extern "C" void run_kernel(GM_ADDR x, const TensorGroupInfo& info_x, GM_ADDR y, const TensorGroupInfo& info_y, GM_ADDR z, const TensorGroupInfo& info_z, int64_t availableCoreNum, aclrtStream stream)
{
    if (info_x.numTensors == 0) return;
    const TensorInfo& info = info_x.tensors[0];
    
    // 计算总元素个数和最后一个维度的长度（本题即列长度 2048）
    uint32_t totalLength = 1;
    for (int64_t i = 0; i < info.numDims; ++i) {
        totalLength *= info.shape[i];
    }
    
    uint32_t colLength = info.shape[info.numDims - 1];
    uint32_t totalRow = (colLength > 0) ? (totalLength / colLength) : 1;
    
    // 规划多核策略：有 8 行就启用 8 个核（每核一行），最多不超过设备可用核数
    uint32_t blockNum = totalRow;
    if (blockNum > (uint32_t)availableCoreNum) {
        blockNum = (uint32_t)availableCoreNum;
    }
    if (blockNum == 0) blockNum = 1;

    // 根据 dtype 选择启动对应的核函数
    // dtype: 0=fp32, 1=fp16
    if (info.dtype == 0) { 
        sub_custom_float<<<blockNum, nullptr, stream>>>(x, y, z, totalLength, colLength);
    } else if (info.dtype == 1) { 
        sub_custom_half<<<blockNum, nullptr, stream>>>(x, y, z, totalLength, colLength);
    }
}