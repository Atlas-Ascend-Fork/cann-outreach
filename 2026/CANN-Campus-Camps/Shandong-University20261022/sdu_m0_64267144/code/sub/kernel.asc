#include <cstdint>
#include "kernel_operator.h"

// 题目固定输入形状：(8, 2048)
constexpr uint32_t SUB_TOTAL_LENGTH = 8 * 2048;

// 每块处理256个元素，共64块。
// 对float32和float16，搬运长度均满足32字节对齐。
constexpr uint32_t SUB_TILE_LENGTH = 256;
constexpr uint32_t SUB_TILE_COUNT =
    SUB_TOTAL_LENGTH / SUB_TILE_LENGTH;

template <typename T>
class KernelSub {
public:
    __aicore__ inline KernelSub() {}

    __aicore__ inline void Init(GM_ADDR x, GM_ADDR y, GM_ADDR z)
    {
        xGm.SetGlobalBuffer((__gm__ T*)x, SUB_TOTAL_LENGTH);
        yGm.SetGlobalBuffer((__gm__ T*)y, SUB_TOTAL_LENGTH);
        zGm.SetGlobalBuffer((__gm__ T*)z, SUB_TOTAL_LENGTH);

        pipe.InitBuffer(inQueueX, 1, SUB_TILE_LENGTH * sizeof(T));
        pipe.InitBuffer(inQueueY, 1, SUB_TILE_LENGTH * sizeof(T));
        pipe.InitBuffer(outQueueZ, 1, SUB_TILE_LENGTH * sizeof(T));
    }

    __aicore__ inline void Process()
    {
        const uint32_t coreId = AscendC::GetBlockIdx();
        const uint32_t coreNum = AscendC::GetBlockNum();

        // 各核轮流处理数据块，不要求核数整除数据块总数。
        for (uint32_t tile = coreId;
             tile < SUB_TILE_COUNT;
             tile += coreNum) {
            const uint32_t offset = tile * SUB_TILE_LENGTH;

            CopyIn(offset);
            Compute();
            CopyOut(offset);
        }
    }

private:
    __aicore__ inline void CopyIn(uint32_t offset)
    {
        AscendC::LocalTensor<T> xLocal = inQueueX.AllocTensor<T>();
        AscendC::LocalTensor<T> yLocal = inQueueY.AllocTensor<T>();

        AscendC::DataCopy(xLocal, xGm[offset], SUB_TILE_LENGTH);
        AscendC::DataCopy(yLocal, yGm[offset], SUB_TILE_LENGTH);

        inQueueX.EnQue(xLocal);
        inQueueY.EnQue(yLocal);
    }

    __aicore__ inline void Compute()
    {
        AscendC::LocalTensor<T> xLocal = inQueueX.DeQue<T>();
        AscendC::LocalTensor<T> yLocal = inQueueY.DeQue<T>();
        AscendC::LocalTensor<T> zLocal = outQueueZ.AllocTensor<T>();

        // z = x - y
        AscendC::Sub(zLocal, xLocal, yLocal, SUB_TILE_LENGTH);

        outQueueZ.EnQue(zLocal);

        inQueueX.FreeTensor(xLocal);
        inQueueY.FreeTensor(yLocal);
    }

    __aicore__ inline void CopyOut(uint32_t offset)
    {
        AscendC::LocalTensor<T> zLocal = outQueueZ.DeQue<T>();

        AscendC::DataCopy(zGm[offset], zLocal, SUB_TILE_LENGTH);

        outQueueZ.FreeTensor(zLocal);
    }

private:
    AscendC::TPipe pipe;

    AscendC::TQue<AscendC::TPosition::VECIN, 1> inQueueX;
    AscendC::TQue<AscendC::TPosition::VECIN, 1> inQueueY;
    AscendC::TQue<AscendC::TPosition::VECOUT, 1> outQueueZ;

    AscendC::GlobalTensor<T> xGm;
    AscendC::GlobalTensor<T> yGm;
    AscendC::GlobalTensor<T> zGm;
};

// float32核函数
__global__ __vector__ void sub_custom_fp32(
    GM_ADDR x, GM_ADDR y, GM_ADDR z)
{
    KernelSub<float> op;
    op.Init(x, y, z);
    op.Process();
}

// float16核函数
__global__ __vector__ void sub_custom_fp16(
    GM_ADDR x, GM_ADDR y, GM_ADDR z)
{
    KernelSub<half> op;
    op.Init(x, y, z);
    op.Process();
}

// 保持与main中的调用接口一致。
// TensorInfo和TensorGroupInfo已经由外部定义，不要重复定义。
extern "C" void run_kernel(
    GM_ADDR x, const TensorGroupInfo& info_x,
    GM_ADDR y, const TensorGroupInfo& info_y,
    GM_ADDR z, const TensorGroupInfo& info_z,
    int64_t availableCoreNum,
    aclrtStream stream)
{
    if (availableCoreNum <= 0) {
        return;
    }

    const uint32_t blockNum =
        availableCoreNum < static_cast<int64_t>(SUB_TILE_COUNT)
            ? static_cast<uint32_t>(availableCoreNum)
            : SUB_TILE_COUNT;

    const int32_t dtype = info_x.tensors[0].dtype;

    if (dtype == 0) {
        sub_custom_fp32<<<blockNum, nullptr, stream>>>(x, y, z);
    } else if (dtype == 1) {
        sub_custom_fp16<<<blockNum, nullptr, stream>>>(x, y, z);
    }
}