#include "kernel_operator.h"
using namespace AscendC;
struct SubCustomTilingData { uint32_t n, chunk; };
template<class T> class KernelSub {
public:
 __aicore__ inline void Init(GM_ADDR x, GM_ADDR y, GM_ADDR z, SubCustomTilingData t) {
  uint32_t start = GetBlockIdx() * t.chunk;
  len = start < t.n ? (t.n - start < t.chunk ? t.n - start : t.chunk) : 0;
  gx.SetGlobalBuffer((__gm__ T*)x + start); gy.SetGlobalBuffer((__gm__ T*)y + start); gz.SetGlobalBuffer((__gm__ T*)z + start);
  pipe.InitBuffer(qx, 2, 4096*sizeof(T)); pipe.InitBuffer(qy, 2, 4096*sizeof(T)); pipe.InitBuffer(qz, 2, 4096*sizeof(T));
 }
 __aicore__ inline void Process() {
  for(uint32_t off=0; off<len; off+=4096) {
   uint32_t count = len-off < 4096 ? len-off : 4096;
   auto a=qx.template AllocTensor<T>(); auto b=qy.template AllocTensor<T>();
   DataCopyExtParams cp{1, (uint32_t)(count*sizeof(T)), 0, 0, 0}; DataCopyPadExtParams<T> pad{false,0,0,(T)0};
   DataCopyPad(a,gx[off],cp,pad); DataCopyPad(b,gy[off],cp,pad); qx.EnQue(a); qy.EnQue(b);
   a=qx.template DeQue<T>(); b=qy.template DeQue<T>(); auto c=qz.template AllocTensor<T>();
   Sub(c,a,b,count); qz.EnQue(c); qx.FreeTensor(a); qy.FreeTensor(b);
   c=qz.template DeQue<T>(); DataCopyPad(gz[off],c,cp); qz.FreeTensor(c);
  }
 }
private: GlobalTensor<T> gx,gy,gz; TPipe pipe; TQue<TPosition::VECIN,2> qx,qy; TQue<TPosition::VECOUT,2> qz; uint32_t len;
};
template<class T> __global__ __vector__ void sub_custom(GM_ADDR x, GM_ADDR y, GM_ADDR z, SubCustomTilingData t) { KernelSub<T> op; op.Init(x,y,z,t); op.Process(); }
extern "C" void run_kernel(GM_ADDR x, const TensorGroupInfo& info_x, GM_ADDR y, const TensorGroupInfo& info_y, GM_ADDR z, const TensorGroupInfo& info_z, int64_t availableCoreNum, aclrtStream stream) {
 uint32_t n=1; const auto& out=info_z.tensors[0]; for(int64_t i=0;i<out.numDims;++i) n*=out.shape[i];
 uint32_t cores=(n+2047)/2048; if(cores>availableCoreNum) cores=availableCoreNum;
 uint32_t chunk=((n+cores-1)/cores+255)/256*256; cores=(n+chunk-1)/chunk;
 SubCustomTilingData t{n,chunk};
 if(out.dtype==0) sub_custom<float><<<cores,nullptr,stream>>>(x,y,z,t); else sub_custom<half><<<cores,nullptr,stream>>>(x,y,z,t);
}
