#include <cmath>
#include "kernel_operator.h"

// Tiling 参数结构体
struct SubCustomTilingData {
    int64_t totalLength;
    int64_t tileLength;
    int32_t dtype;
};

// 核心计算类
template <typename T>
class KernelSub {
public:
    __aicore__ inline void Init(
        GM_ADDR x,
        GM_ADDR y,
        GM_ADDR z,
        int64_t totalLength,
        int64_t tileLength)
    {
        this->totalLength = totalLength;
        this->tileLength = tileLength;

        int64_t blockIdx = AscendC::GetBlockIdx();
        this->offset = blockIdx * tileLength;

        this->length = totalLength - offset;
        if (length > tileLength) {
            length = tileLength;
        }

        xGm.SetGlobalBuffer(
            reinterpret_cast<__gm__ T*>(x), totalLength);
        yGm.SetGlobalBuffer(
            reinterpret_cast<__gm__ T*>(y), totalLength);
        zGm.SetGlobalBuffer(
            reinterpret_cast<__gm__ T*>(z), totalLength);

        pipe.InitBuffer(
            queueX, 1, tileLength * sizeof(T));
        pipe.InitBuffer(
            queueY, 1, tileLength * sizeof(T));
        pipe.InitBuffer(
            queueZ, 1, tileLength * sizeof(T));
    }

    __aicore__ inline void Process()
    {
        // 输入 x 搬运到本地缓冲区
        AscendC::LocalTensor<T> xLocal =
            queueX.AllocTensor<T>();

        AscendC::DataCopy(
            xLocal, xGm[offset], length);

        queueX.EnQue(xLocal);
        xLocal = queueX.DeQue<T>();

        // 输入 y 搬运到本地缓冲区
        AscendC::LocalTensor<T> yLocal =
            queueY.AllocTensor<T>();

        AscendC::DataCopy(
            yLocal, yGm[offset], length);

        queueY.EnQue(yLocal);
        yLocal = queueY.DeQue<T>();

        // 为输出分配本地缓冲区
        AscendC::LocalTensor<T> zLocal =
            queueZ.AllocTensor<T>();

        // 逐元素计算 z = x - y
        AscendC::Sub(
            zLocal, xLocal, yLocal, length);

        // 将结果写回全局内存
        AscendC::DataCopy(
            zGm[offset], zLocal, length);

        // 释放缓冲区
        queueX.FreeTensor(xLocal);
        queueY.FreeTensor(yLocal);
        queueZ.FreeTensor(zLocal);
    }

private:
    AscendC::TPipe pipe;

    AscendC::TQue<AscendC::QuePosition::VECIN, 1> queueX;
    AscendC::TQue<AscendC::QuePosition::VECIN, 1> queueY;
    AscendC::TQue<AscendC::QuePosition::VECOUT, 1> queueZ;

    AscendC::GlobalTensor<T> xGm;
    AscendC::GlobalTensor<T> yGm;
    AscendC::GlobalTensor<T> zGm;

    int64_t totalLength;
    int64_t tileLength;
    int64_t offset;
    int64_t length;
};

// 核函数入口
__global__ __vector__ void sub_custom(
    GM_ADDR x,
    GM_ADDR y,
    GM_ADDR z,
    SubCustomTilingData tiling)
{
    if (tiling.dtype == 0) {
        KernelSub<float> op;
        op.Init(
            x, y, z,
            tiling.totalLength,
            tiling.tileLength);
        op.Process();
    } else if (tiling.dtype == 1) {
        KernelSub<half> op;
        op.Init(
            x, y, z,
            tiling.totalLength,
            tiling.tileLength);
        op.Process();
    }
}

// Host 侧启动函数
extern "C" void run_kernel(
    GM_ADDR x,
    const TensorGroupInfo& info_x,
    GM_ADDR y,
    const TensorGroupInfo& info_y,
    GM_ADDR z,
    const TensorGroupInfo& info_z,
    int64_t availableCoreNum,
    aclrtStream stream)
{
    // 本题输入形状固定为 (8, 2048)
    constexpr int64_t totalLength = 8 * 2048;
    constexpr int64_t tileLength = 2048;

    SubCustomTilingData tiling;
    tiling.totalLength = totalLength;
    tiling.tileLength = tileLength;

    // 截图中 dtype 编码：0 = float32，1 = float16
    tiling.dtype = info_x.tensors[0].dtype;

    // 每个计算块处理 2048 个元素
    int64_t blockNum =
        (totalLength + tileLength - 1) / tileLength;

    // 当前题目固定形状需要 8 个计算块
    sub_custom<<<blockNum, nullptr, stream>>>(
        x, y, z, tiling);
}
