#include <cstdint>
#include "kernel_operator.h"

using namespace AscendC;

struct SubCustomTilingData {
    uint64_t totalLength;
    uint32_t tileLength;
    int32_t dtype; // TensorInfo: 0 = float32, 1 = float16
};

template <typename T>
class KernelSub {
public:
    __aicore__ inline void Init(GM_ADDR x, GM_ADDR y, GM_ADDR z,
                               const SubCustomTilingData& tiling)
    {
        totalLength_ = tiling.totalLength;
        tileLength_ = tiling.tileLength;
        xGm_.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(x), totalLength_);
        yGm_.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(y), totalLength_);
        zGm_.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(z), totalLength_);
        uint32_t bytes = tileLength_ * static_cast<uint32_t>(sizeof(T));
        pipe_.InitBuffer(xQueue_, BUFFER_NUM, bytes);
        pipe_.InitBuffer(yQueue_, BUFFER_NUM, bytes);
        pipe_.InitBuffer(zQueue_, BUFFER_NUM, bytes);
    }

    __aicore__ inline void Process()
    {
        // Tiles start on 32-byte boundaries and have unique core owners.
        uint64_t step = static_cast<uint64_t>(GetBlockNum()) * tileLength_;
        for (uint64_t offset = static_cast<uint64_t>(GetBlockIdx()) * tileLength_;
             offset < totalLength_; offset += step) {
            uint64_t remaining = totalLength_ - offset;
            uint32_t count = remaining < tileLength_ ?
                             static_cast<uint32_t>(remaining) : tileLength_;
            CopyIn(offset, count);
            Compute(count);
            CopyOut(offset, count);
        }
    }

private:
    __aicore__ inline void CopyIn(uint64_t offset, uint32_t count)
    {
        LocalTensor<T> xLocal = xQueue_.template AllocTensor<T>();
        LocalTensor<T> yLocal = yQueue_.template AllocTensor<T>();
        DataCopyExtParams copy{1, count * static_cast<uint32_t>(sizeof(T)), 0, 0, 0};
        DataCopyPadExtParams<T> pad{};
        DataCopyPad(xLocal, xGm_[offset], copy, pad);
        DataCopyPad(yLocal, yGm_[offset], copy, pad);
        xQueue_.template EnQue<T>(xLocal);
        yQueue_.template EnQue<T>(yLocal);
    }

    __aicore__ inline void Compute(uint32_t count)
    {
        LocalTensor<T> xLocal = xQueue_.template DeQue<T>();
        LocalTensor<T> yLocal = yQueue_.template DeQue<T>();
        LocalTensor<T> zLocal = zQueue_.template AllocTensor<T>();
        Sub(zLocal, xLocal, yLocal, static_cast<int32_t>(count));
        zQueue_.template EnQue<T>(zLocal);
        xQueue_.FreeTensor(xLocal);
        yQueue_.FreeTensor(yLocal);
    }

    __aicore__ inline void CopyOut(uint64_t offset, uint32_t count)
    {
        LocalTensor<T> zLocal = zQueue_.template DeQue<T>();
        DataCopyExtParams copy{1, count * static_cast<uint32_t>(sizeof(T)), 0, 0, 0};
        DataCopyPad(zGm_[offset], zLocal, copy);
        zQueue_.FreeTensor(zLocal);
    }

    static constexpr int32_t BUFFER_NUM = 2;
    TPipe pipe_;
    TQue<QuePosition::VECIN, BUFFER_NUM> xQueue_, yQueue_;
    TQue<QuePosition::VECOUT, BUFFER_NUM> zQueue_;
    GlobalTensor<T> xGm_, yGm_, zGm_;
    uint64_t totalLength_;
    uint32_t tileLength_;
};

__global__ __vector__ void sub_custom(GM_ADDR x, GM_ADDR y, GM_ADDR z,
                                     SubCustomTilingData tiling)
{
    if (tiling.dtype == 0) {
        KernelSub<float> op;
        op.Init(x, y, z, tiling);
        op.Process();
    } else if (tiling.dtype == 1) {
        KernelSub<half> op;
        op.Init(x, y, z, tiling);
        op.Process();
    }
}

extern "C" void run_kernel(GM_ADDR x, const TensorGroupInfo& info_x,
    GM_ADDR y, const TensorGroupInfo& info_y,
    GM_ADDR z, const TensorGroupInfo& info_z,
    int64_t availableCoreNum, aclrtStream stream)
{
    if (!x || !y || !z || availableCoreNum <= 0 ||
        info_x.numTensors != 1 || info_y.numTensors != 1 || info_z.numTensors != 1 ||
        !info_x.tensors || !info_y.tensors || !info_z.tensors) return;
    const TensorInfo& tx = info_x.tensors[0];
    const TensorInfo& ty = info_y.tensors[0];
    const TensorInfo& tz = info_z.tensors[0];
    if (!tx.shape || !ty.shape || !tz.shape || tx.numDims <= 0 ||
        tx.numDims != ty.numDims || tx.numDims != tz.numDims ||
        (tx.dtype != 0 && tx.dtype != 1) || ty.dtype != tx.dtype || tz.dtype != tx.dtype) return;

    uint64_t total = 1;
    for (int64_t d = 0; d < tx.numDims; ++d) {
        if (tx.shape[d] <= 0 || tx.shape[d] != ty.shape[d] || tx.shape[d] != tz.shape[d]) return;
        uint64_t dim = static_cast<uint64_t>(tx.shape[d]);
        if (total > 0x7fffffffffffffffULL / dim) return;
        total *= dim;
    }

    SubCustomTilingData tiling{};
    tiling.totalLength = total;
    tiling.tileLength = 1024;
    tiling.dtype = tx.dtype;
    uint64_t tiles = (total + tiling.tileLength - 1) / tiling.tileLength;
    uint64_t cores = static_cast<uint64_t>(availableCoreNum);
    uint32_t blockNum = static_cast<uint32_t>(cores < tiles ? cores : tiles);
    sub_custom<<<blockNum, nullptr, stream>>>(x, y, z, tiling);
}
