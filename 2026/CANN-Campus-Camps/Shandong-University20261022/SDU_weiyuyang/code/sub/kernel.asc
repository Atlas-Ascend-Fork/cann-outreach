
#include <cmath>
#include "kernel_operator.h"

// 每个输入张量形状为 (8, 2048)
constexpr uint32_t ROW_COUNT = 8;
constexpr uint32_t ROW_LENGTH = 2048;

// 向量减法计算类
template <typename T>
class KernelSub {
public:
    __aicore__ inline KernelSub() {}

    __aicore__ inline void Init(
        GM_ADDR x, GM_ADDR y, GM_ADDR z)
    {
        xGm.SetGlobalBuffer(
            (__gm__ T *)x, ROW_COUNT * ROW_LENGTH);
        yGm.SetGlobalBuffer(
            (__gm__ T *)y, ROW_COUNT * ROW_LENGTH);
        zGm.SetGlobalBuffer(
            (__gm__ T *)z, ROW_COUNT * ROW_LENGTH);

        // 为输入与输出分配片上缓冲区
        pipe.InitBuffer(
            inQueueX, 1, ROW_LENGTH * sizeof(T));
        pipe.InitBuffer(
            inQueueY, 1, ROW_LENGTH * sizeof(T));
        pipe.InitBuffer(
            outQueueZ, 1, ROW_LENGTH * sizeof(T));
    }

    __aicore__ inline void Process()
    {
        const uint32_t coreId =
            AscendC::GetBlockIdx();
        const uint32_t coreNum =
            AscendC::GetBlockNum();

        // 每次处理一整行2048个元素
        for (uint32_t row = coreId;
             row < ROW_COUNT;
             row += coreNum) {
            uint32_t offset = row * ROW_LENGTH;
            CopyIn(offset);
            Compute();
            CopyOut(offset);
        }
    }

private:
    __aicore__ inline void CopyIn(uint32_t offset)
    {
        AscendC::LocalTensor<T> xLocal =
            inQueueX.AllocTensor<T>();
        AscendC::LocalTensor<T> yLocal =
            inQueueY.AllocTensor<T>();

        AscendC::DataCopy(
            xLocal, xGm[offset], ROW_LENGTH);
        AscendC::DataCopy(
            yLocal, yGm[offset], ROW_LENGTH);

        inQueueX.EnQue(xLocal);
        inQueueY.EnQue(yLocal);
    }

    __aicore__ inline void Compute()
    {
        AscendC::LocalTensor<T> xLocal =
            inQueueX.DeQue<T>();
        AscendC::LocalTensor<T> yLocal =
            inQueueY.DeQue<T>();
        AscendC::LocalTensor<T> zLocal =
            outQueueZ.AllocTensor<T>();

        // 核心计算：z = x - y
        AscendC::Sub(
            zLocal, xLocal, yLocal, ROW_LENGTH);

        outQueueZ.EnQue(zLocal);

        inQueueX.FreeTensor(xLocal);
        inQueueY.FreeTensor(yLocal);
    }

    __aicore__ inline void CopyOut(uint32_t offset)
    {
        AscendC::LocalTensor<T> zLocal =
            outQueueZ.DeQue<T>();

        AscendC::DataCopy(
            zGm[offset], zLocal, ROW_LENGTH);

        outQueueZ.FreeTensor(zLocal);
    }

private:
    AscendC::TPipe pipe;

    AscendC::TQue<AscendC::TPosition::VECIN, 1>
        inQueueX;
    AscendC::TQue<AscendC::TPosition::VECIN, 1>
        inQueueY;
    AscendC::TQue<AscendC::TPosition::VECOUT, 1>
        outQueueZ;

    AscendC::GlobalTensor<T> xGm;
    AscendC::GlobalTensor<T> yGm;
    AscendC::GlobalTensor<T> zGm;
};

// NPU 核函数入口
template <typename T>
__global__ __vector__ void sub_custom(
    GM_ADDR x, GM_ADDR y, GM_ADDR z)
{
    KernelSub<T> op;
    op.Init(x, y, z);
    op.Process();
}

// Host 侧启动入口
extern "C" void run_kernel(
    GM_ADDR x, const TensorGroupInfo& info_x,
    GM_ADDR y, const TensorGroupInfo& info_y,
    GM_ADDR z, const TensorGroupInfo& info_z,
    int64_t availableCoreNum,
    aclrtStream stream)
{
    if (availableCoreNum <= 0) {
        return;
    }

    const uint32_t blockDim =
        static_cast<uint32_t>(
            availableCoreNum < ROW_COUNT
                ? availableCoreNum : ROW_COUNT);

    const int32_t dtype =
        info_x.tensors[0].dtype;

    if (dtype == 0) {
        sub_custom<float><<<blockDim, nullptr, stream>>>(
            x, y, z);
    } else if (dtype == 1) {
        sub_custom<half><<<blockDim, nullptr, stream>>>(
            x, y, z);
    }
}

