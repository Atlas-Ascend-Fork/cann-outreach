
#include <cmath>
#include "kernel_operator.h"

constexpr int32_t TOTAL_LENGTH = 8 * 2048;
constexpr int32_t BLOCK_NUM = 8;
constexpr int32_t BLOCK_LENGTH = TOTAL_LENGTH / BLOCK_NUM;

template <typename T>
class KernelSub {
public:
    __aicore__ inline KernelSub() {}

    __aicore__ inline void Init(GM_ADDR x, GM_ADDR y, GM_ADDR z)
    {
        int32_t blockIdx = AscendC::GetBlockIdx();
        xGm.SetGlobalBuffer(
            reinterpret_cast<__gm__ T *>(x) + blockIdx * BLOCK_LENGTH,
            BLOCK_LENGTH);
        yGm.SetGlobalBuffer(
            reinterpret_cast<__gm__ T *>(y) + blockIdx * BLOCK_LENGTH,
            BLOCK_LENGTH);
        zGm.SetGlobalBuffer(
            reinterpret_cast<__gm__ T *>(z) + blockIdx * BLOCK_LENGTH,
            BLOCK_LENGTH);

        pipe.InitBuffer(queueX, 1, BLOCK_LENGTH * sizeof(T));
        pipe.InitBuffer(queueY, 1, BLOCK_LENGTH * sizeof(T));
        pipe.InitBuffer(queueZ, 1, BLOCK_LENGTH * sizeof(T));
    }

    __aicore__ inline void Process()
    {
        CopyIn();
        Compute();
        CopyOut();
    }

private:
    __aicore__ inline void CopyIn()
    {
        AscendC::LocalTensor<T> xLocal = queueX.AllocTensor<T>();
        AscendC::LocalTensor<T> yLocal = queueY.AllocTensor<T>();

        AscendC::DataCopy(xLocal, xGm, BLOCK_LENGTH);
        AscendC::DataCopy(yLocal, yGm, BLOCK_LENGTH);

        queueX.EnQue(xLocal);
        queueY.EnQue(yLocal);
    }

    __aicore__ inline void Compute()
    {
        AscendC::LocalTensor<T> xLocal = queueX.DeQue<T>();
        AscendC::LocalTensor<T> yLocal = queueY.DeQue<T>();
        AscendC::LocalTensor<T> zLocal = queueZ.AllocTensor<T>();

        AscendC::Sub(zLocal, xLocal, yLocal, BLOCK_LENGTH);

        queueZ.EnQue(zLocal);
        queueX.FreeTensor(xLocal);
        queueY.FreeTensor(yLocal);
    }

    __aicore__ inline void CopyOut()
    {
        AscendC::LocalTensor<T> zLocal = queueZ.DeQue<T>();

        AscendC::DataCopy(zGm, zLocal, BLOCK_LENGTH);

        queueZ.FreeTensor(zLocal);
    }

private:
    AscendC::TPipe pipe;
    AscendC::TQue<AscendC::TPosition::VECIN, 1> queueX;
    AscendC::TQue<AscendC::TPosition::VECIN, 1> queueY;
    AscendC::TQue<AscendC::TPosition::VECOUT, 1> queueZ;

    AscendC::GlobalTensor<T> xGm;
    AscendC::GlobalTensor<T> yGm;
    AscendC::GlobalTensor<T> zGm;
};

template <typename T>
__global__ __vector__ void sub_custom(
    GM_ADDR x, GM_ADDR y, GM_ADDR z)
{
    KernelSub<T> op;
    op.Init(x, y, z);
    op.Process();
}

extern "C" void run_kernel(
    GM_ADDR x,
    const TensorGroupInfo& info_x,
    GM_ADDR y,
    const TensorGroupInfo& info_y,
    GM_ADDR z,
    const TensorGroupInfo& info_z,
    int64_t availableCoreNum,
    aclrtStream stream)
{
    // The input shape is (8, 2048), containing 16384 elements.
    // Each block processes 2048 elements.
    if (availableCoreNum <= 0) {
        return;
    }

    int32_t dtype = info_x.tensors[0].dtype;

    if (dtype == 0) {
        // float32
        sub_custom<float><<<BLOCK_NUM, nullptr, stream>>>(x, y, z);
    } else if (dtype == 1) {
        // float16
        sub_custom<half><<<BLOCK_NUM, nullptr, stream>>>(x, y, z);
    }
}
