#include <cmath>
#include <cstdint>
#include "kernel_operator.h"
// Direct invocation; TensorInfo and TensorGroupInfo are provided by the caller.
// Supported contract: x/y/z have shape (8, 2048), identical FP32 or FP16 dtype.
struct SubCustomTilingData {
    uint32_t baseLength;
    uint32_t extraCoreNum;
    uint32_t dtype;
};
template <typename T>
class KernelSub {
public:
    __aicore__ inline KernelSub() {}
    __aicore__ inline void Init(GM_ADDR x, GM_ADDR y, GM_ADDR z,
                               const SubCustomTilingData& tiling,
                               AscendC::TPipe& pipe)
    {
        constexpr uint32_t ALIGN_ELEMS = 512u / sizeof(T);
        const uint32_t coreId = AscendC::GetBlockIdx();
        const uint32_t extraBefore =
            coreId < tiling.extraCoreNum ? coreId : tiling.extraCoreNum;
        const uint32_t offset =
            coreId * tiling.baseLength + extraBefore * ALIGN_ELEMS;
        length_ = tiling.baseLength +
                  (coreId < tiling.extraCoreNum ? ALIGN_ELEMS : 0u);
        xGm_.SetGlobalBuffer((__gm__ T*)x + offset, length_);
        yGm_.SetGlobalBuffer((__gm__ T*)y + offset, length_);
        zGm_.SetGlobalBuffer((__gm__ T*)z + offset, length_);
        // Allocate x and y together. Reuse the y region for the result.
        pipe.InitBuffer(buffer_, 2u * length_ * sizeof(T));
    }
    __aicore__ inline void Process(AscendC::TPipe& pipe)
    {
        AscendC::LocalTensor<T> xLocal = buffer_.Get<T>();
        AscendC::LocalTensor<T> yLocal = xLocal[length_];
        AscendC::DataCopy(xLocal, xGm_, length_);
        AscendC::DataCopy(yLocal, yGm_, length_);
        const auto inputReady = pipe.FetchEventID(AscendC::HardEvent::MTE2_V);
        AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(inputReady);
        AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(inputReady);
        // Complete overlap with src1 is intentional: yLocal = xLocal - yLocal.
        AscendC::Sub(yLocal, xLocal, yLocal, length_);
        const auto outputReady = pipe.FetchEventID(AscendC::HardEvent::V_MTE3);
        AscendC::SetFlag<AscendC::HardEvent::V_MTE3>(outputReady);
        AscendC::WaitFlag<AscendC::HardEvent::V_MTE3>(outputReady);
        AscendC::DataCopy(zGm_, yLocal, length_);
    }
private:
    uint32_t length_;
    AscendC::GlobalTensor<T> xGm_;
    AscendC::GlobalTensor<T> yGm_;
    AscendC::GlobalTensor<T> zGm_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> buffer_;
};
__global__ __vector__ void sub_custom(GM_ADDR x, GM_ADDR y, GM_ADDR z,
                                    SubCustomTilingData tiling)
{
    // Keep TPipe outside KernelSub to facilitate scalar compiler optimizations.
    AscendC::TPipe pipe;
    if (tiling.dtype == 0u) {
        KernelSub<float> op;
        op.Init(x, y, z, tiling, pipe);
        op.Process(pipe);
    } else {
        KernelSub<half> op;
        op.Init(x, y, z, tiling, pipe);
        op.Process(pipe);
    }
}
extern "C" void run_kernel(GM_ADDR x, const TensorGroupInfo& info_x,
                           GM_ADDR y, const TensorGroupInfo& info_y,
                           GM_ADDR z, const TensorGroupInfo& info_z,
                           int64_t availableCoreNum, aclrtStream stream)
{
    constexpr uint32_t TOTAL_LENGTH = 8u * 2048u;
    // Tuning parameter: benchmark 8, 16 and 32 on the evaluation hardware.
    constexpr uint32_t MAX_CORES = 8u;
    (void)info_y;
    (void)info_z;
    if (availableCoreNum <= 0) {
        return;
    }
    const uint32_t dtype = static_cast<uint32_t>(info_x.tensors[0].dtype);
    if (dtype != 0u && dtype != 1u) {
        return;
    }
    const uint32_t elementBytes = dtype == 0u ? 4u : 2u;
    const uint32_t alignElems = 512u / elementBytes;
    const uint32_t totalUnits = TOTAL_LENGTH / alignElems;
    uint32_t blockNum = availableCoreNum < static_cast<int64_t>(MAX_CORES)
                            ? static_cast<uint32_t>(availableCoreNum)
                            : MAX_CORES;
    if (blockNum > totalUnits) {
        blockNum = totalUnits;
    }
    SubCustomTilingData tiling;
    tiling.baseLength = (totalUnits / blockNum) * alignElems;
    tiling.extraCoreNum = totalUnits % blockNum;
    tiling.dtype = dtype;
    sub_custom<<<blockNum, nullptr, stream>>>(x, y, z, tiling);
}
