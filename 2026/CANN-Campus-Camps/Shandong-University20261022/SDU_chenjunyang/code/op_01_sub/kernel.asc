#include <cmath>
#include "kernel_operator.h"
/*
 * Sub Kernel -- Ascend C Direct Invocation
 * This file is #included -- do NOT add main(), #pragma once, or include guards.
 *
 * TensorGroupInfo / TensorInfo (predefined):
 *   struct TensorInfo { const int64_t* shape; int64_t numDims; int32_t dtype; };
 *   struct TensorGroupInfo { const TensorInfo* tensors; int64_t numTensors; };
 *   dtype: 0=fp32 1=fp16 2=bf16 3=int8 4=int16 5=int32 6=int64 7=uint8 8=uint16 9=uint32 10=uint64 11=bool
 *   Usage: info_x.tensors[0].shape[0]  // first dim of first tensor in input x
 */

using namespace AscendC;

constexpr uint32_t SUB_BUFFER_NUM = 2;
constexpr uint32_t SUB_TILE_LENGTH = 4096;
constexpr uint32_t SUB_ALIGN_LENGTH = 16;

struct SubCustomTilingData {
    uint32_t totalLength;
    uint32_t blockLength;
    uint32_t tileLength;
    int32_t dtype;
};

template <typename T>
class KernelSub {
public:
    __aicore__ inline KernelSub() {}

    __aicore__ inline void Init(GM_ADDR x, GM_ADDR y, GM_ADDR z,
                                const SubCustomTilingData& tiling)
    {
        uint32_t blockIdx = static_cast<uint32_t>(GetBlockIdx());
        uint32_t blockOffset = blockIdx * tiling.blockLength;
        if (blockOffset >= tiling.totalLength) {
            coreLength = 0;
            return;
        }

        coreOffset = blockOffset;
        coreLength = tiling.totalLength - blockOffset;
        if (coreLength > tiling.blockLength) {
            coreLength = tiling.blockLength;
        }
        tileLength = tiling.tileLength;

        xGm.SetGlobalBuffer((__gm__ T*)x, tiling.totalLength);
        yGm.SetGlobalBuffer((__gm__ T*)y, tiling.totalLength);
        zGm.SetGlobalBuffer((__gm__ T*)z, tiling.totalLength);

        uint32_t bufferSize = tileLength * static_cast<uint32_t>(sizeof(T));
        pipe.InitBuffer(inQueueX, SUB_BUFFER_NUM, bufferSize);
        pipe.InitBuffer(inQueueY, SUB_BUFFER_NUM, bufferSize);
        pipe.InitBuffer(outQueueZ, SUB_BUFFER_NUM, bufferSize);
    }

    __aicore__ inline void Process()
    {
        if (coreLength == 0) {
            return;
        }

        uint32_t loopCount = (coreLength + tileLength - 1) / tileLength;
        for (uint32_t i = 0; i < loopCount; ++i) {
            uint32_t currentLength = coreLength - i * tileLength;
            if (currentLength > tileLength) {
                currentLength = tileLength;
            }
            CopyIn(i, currentLength);
            Compute(currentLength);
            CopyOut(i, currentLength);
        }
    }

private:
    __aicore__ inline void CopyIn(uint32_t progress, uint32_t length)
    {
        LocalTensor<T> xLocal = inQueueX.AllocTensor<T>();
        LocalTensor<T> yLocal = inQueueY.AllocTensor<T>();
        uint32_t offset = coreOffset + progress * tileLength;
        DataCopy(xLocal, xGm[offset], length);
        DataCopy(yLocal, yGm[offset], length);
        inQueueX.EnQue(xLocal);
        inQueueY.EnQue(yLocal);
    }

    __aicore__ inline void Compute(uint32_t length)
    {
        LocalTensor<T> xLocal = inQueueX.DeQue<T>();
        LocalTensor<T> yLocal = inQueueY.DeQue<T>();
        LocalTensor<T> zLocal = outQueueZ.AllocTensor<T>();
        Sub(zLocal, xLocal, yLocal, length);
        outQueueZ.EnQue(zLocal);
        inQueueX.FreeTensor(xLocal);
        inQueueY.FreeTensor(yLocal);
    }

    __aicore__ inline void CopyOut(uint32_t progress, uint32_t length)
    {
        LocalTensor<T> zLocal = outQueueZ.DeQue<T>();
        uint32_t offset = coreOffset + progress * tileLength;
        DataCopy(zGm[offset], zLocal, length);
        outQueueZ.FreeTensor(zLocal);
    }

private:
    TPipe pipe;
    TQue<QuePosition::VECIN, SUB_BUFFER_NUM> inQueueX;
    TQue<QuePosition::VECIN, SUB_BUFFER_NUM> inQueueY;
    TQue<QuePosition::VECOUT, SUB_BUFFER_NUM> outQueueZ;
    GlobalTensor<T> xGm;
    GlobalTensor<T> yGm;
    GlobalTensor<T> zGm;
    uint32_t coreOffset = 0;
    uint32_t coreLength = 0;
    uint32_t tileLength = SUB_TILE_LENGTH;
};

__global__ __vector__ void sub_custom(GM_ADDR x, GM_ADDR y, GM_ADDR z,
                                      SubCustomTilingData tiling)
{
    if (tiling.dtype == 0) {
        KernelSub<float> op;
        op.Init(x, y, z, tiling);
        op.Process();
    } else if (tiling.dtype == 1) {
        KernelSub<half> op;
        op.Init(x, y, z, tiling);
        op.Process();
    }
}

extern "C" void run_kernel(GM_ADDR x, const TensorGroupInfo& info_x, GM_ADDR y,
                           const TensorGroupInfo& info_y, GM_ADDR z,
                           const TensorGroupInfo& info_z, int64_t availableCoreNum,
                           aclrtStream stream)
{
    if (info_x.numTensors <= 0 || info_x.tensors[0].numDims <= 0) {
        return;
    }

    int64_t totalLength64 = 1;
    for (int64_t i = 0; i < info_x.tensors[0].numDims; ++i) {
        totalLength64 *= info_x.tensors[0].shape[i];
    }
    if (totalLength64 <= 0) {
        return;
    }

    uint32_t totalLength = static_cast<uint32_t>(totalLength64);
    uint32_t blockNum = availableCoreNum > 0 ? static_cast<uint32_t>(availableCoreNum) : 1U;
    uint32_t usefulBlocks = (totalLength + SUB_ALIGN_LENGTH - 1) / SUB_ALIGN_LENGTH;
    if (blockNum > usefulBlocks) {
        blockNum = usefulBlocks;
    }

    uint32_t averageLength = (totalLength + blockNum - 1) / blockNum;
    uint32_t blockLength = ((averageLength + SUB_ALIGN_LENGTH - 1) / SUB_ALIGN_LENGTH) * SUB_ALIGN_LENGTH;
    blockNum = (totalLength + blockLength - 1) / blockLength;

    SubCustomTilingData tiling;
    tiling.totalLength = totalLength;
    tiling.blockLength = blockLength;
    tiling.tileLength = SUB_TILE_LENGTH;
    tiling.dtype = info_x.tensors[0].dtype;

    sub_custom<<<blockNum, nullptr, stream>>>(x, y, z, tiling);
}
