#include <cmath>
#include "kernel_operator.h"

// ===========================================================================
// Tiling 参数（值传递）
// ===========================================================================
struct SubCustomTilingData {
    uint32_t totalLength;    // 总元素数
    uint32_t blockDim;       // 实际启动核数
    uint32_t formerNum;      // 多处理 1 个元素的核数（= totalLength % blockDim）
    uint32_t formerLength;   // 这些核每个处理 = baseLength + 1
    uint32_t tailLength;     // 其余核每个处理 = baseLength
    uint32_t alignNum;       // 32B 对齐对应元素数（fp32=8, fp16=16）
};

constexpr uint32_t BUFFER_NUM = 2;   // Double Buffer
constexpr uint32_t QUEUE_DEPTH = 1;  // 队列深度保持 1

// ===========================================================================
// KernelSub<T>
// ===========================================================================
template <typename T>
class KernelSub {
public:
    __aicore__ inline KernelSub() {}

    __aicore__ inline void Init(GM_ADDR x, GM_ADDR y, GM_ADDR z,
                                const SubCustomTilingData& tiling)
    {
        this->alignNum = tiling.alignNum;

        // ---- 多核负载均衡：前 formerNum 个核多处理 1 个元素 ----
        uint32_t blockIdx = AscendC::GetBlockIdx();
        uint32_t offset = 0;
        uint32_t currentLength = 0;
        if (blockIdx < tiling.formerNum) {
            offset = blockIdx * tiling.formerLength;
            currentLength = tiling.formerLength;
        } else {
            offset = tiling.formerNum * tiling.formerLength
                   + (blockIdx - tiling.formerNum) * tiling.tailLength;
            currentLength = tiling.tailLength;
        }

        xGm.SetGlobalBuffer((__gm__ T *)x + offset, currentLength);
        yGm.SetGlobalBuffer((__gm__ T *)y + offset, currentLength);
        zGm.SetGlobalBuffer((__gm__ T *)z + offset, currentLength);

        // ---- 关键：用 UB 预算反推 tileLength 上限，避免 UB 溢出 ----
        // 3 个队列（x/y/z）× BUFFER_NUM 个 buffer；120KB 是保守预算，可按型号调大
        constexpr uint32_t UB_BUDGET_BYTES = 120 * 1024;
        uint32_t maxTileLen = UB_BUDGET_BYTES / (3 * BUFFER_NUM * (uint32_t)sizeof(T));
        maxTileLen = maxTileLen / this->alignNum * this->alignNum;  // 32B 对齐
        if (maxTileLen == 0) {
            maxTileLen = this->alignNum;  // 极端兜底：至少一个对齐块
        }

        // 本核实际可对齐的上限
        uint32_t alignedCur = currentLength / this->alignNum * this->alignNum;
        this->tileLength = (maxTileLen < alignedCur) ? maxTileLen : alignedCur;

        // 块数 / 尾块（lastTileLength 恒 < tileLength，除非 tileLength==0）
        if (this->tileLength == 0) {
            this->blockCount = 0;
            this->lastTileLength = currentLength;
        } else {
            this->blockCount = currentLength / this->tileLength;
            this->lastTileLength = currentLength - this->blockCount * this->tileLength;
        }

        // bufLen：尾块长度恒 < tileLength；仅 tileLength==0 时用 lastTileLength
        uint32_t bufLen = (this->tileLength > this->lastTileLength)
                          ? this->tileLength : this->lastTileLength;
        if (bufLen == 0) {
            bufLen = 1;  // 防止 InitBuffer 传 0 长度
        }

        // ---- Double Buffer：第二个参数 = BUFFER_NUM ----
        pipe.InitBuffer(inQueueX, BUFFER_NUM, bufLen * (uint32_t)sizeof(T));
        pipe.InitBuffer(inQueueY, BUFFER_NUM, bufLen * (uint32_t)sizeof(T));
        pipe.InitBuffer(outQueueZ, BUFFER_NUM, bufLen * (uint32_t)sizeof(T));
    }

    __aicore__ inline void Process()
    {
        // 主块：等长块循环，Double Buffer 由框架自动重叠
        for (uint32_t i = 0; i < this->blockCount; i++) {
            uint32_t off = i * this->tileLength;
            CopyIn(off, this->tileLength);
            Compute(this->tileLength);
            CopyOut(off, this->tileLength);
        }
        // 尾块：单独处理一次
        if (this->lastTileLength > 0) {
            uint32_t off = this->blockCount * this->tileLength;
            CopyIn(off, this->lastTileLength);
            Compute(this->lastTileLength);
            CopyOut(off, this->lastTileLength);
        }
    }

private:
    // -------------------- GM -> UB --------------------
    __aicore__ inline void CopyGmToUb(AscendC::LocalTensor<T> &local,
                                      AscendC::GlobalTensor<T> &gm,
                                      uint32_t offset, uint32_t len)
    {
        if (len % this->alignNum == 0) {
            AscendC::DataCopy(local, gm[offset], len);
        } else {
            // 非对齐尾块：显式字段赋值，避免不同版本结构体字段数差异
            AscendC::DataCopyExtParams extParams;
            extParams.blockCount = 1;
            extParams.blockLen = len * (uint32_t)sizeof(T);
            extParams.srcStride = 0;
            extParams.dstStride = 0;
            AscendC::DataCopyPadExtParams<T> padParams{false, 0, 0, 0};
            AscendC::DataCopyPad(local, gm[offset], extParams, padParams);
        }
    }

    __aicore__ inline void CopyIn(uint32_t offset, uint32_t len)
    {
        AscendC::LocalTensor<T> xLocal = inQueueX.AllocTensor<T>();
        AscendC::LocalTensor<T> yLocal = inQueueY.AllocTensor<T>();
        CopyGmToUb(xLocal, xGm, offset, len);
        CopyGmToUb(yLocal, yGm, offset, len);
        inQueueX.EnQue(xLocal);
        inQueueY.EnQue(yLocal);
    }

    // -------------------- Compute --------------------
    __aicore__ inline void Compute(uint32_t len)
    {
        AscendC::LocalTensor<T> xLocal = inQueueX.DeQue<T>();
        AscendC::LocalTensor<T> yLocal = inQueueY.DeQue<T>();
        AscendC::LocalTensor<T> zLocal = outQueueZ.AllocTensor<T>();
        AscendC::Sub(zLocal, xLocal, yLocal, len);
        outQueueZ.EnQue<T>(zLocal);
        inQueueX.FreeTensor(xLocal);
        inQueueY.FreeTensor(yLocal);
    }

    // -------------------- UB -> GM --------------------
    __aicore__ inline void CopyOut(uint32_t offset, uint32_t len)
    {
        AscendC::LocalTensor<T> zLocal = outQueueZ.DeQue<T>();
        if (len % this->alignNum == 0) {
            AscendC::DataCopy(zGm[offset], zLocal, len);
        } else {
            AscendC::DataCopyExtParams extParams;
            extParams.blockCount = 1;
            extParams.blockLen = len * (uint32_t)sizeof(T);
            extParams.srcStride = 0;
            extParams.dstStride = 0;
            AscendC::DataCopyPad(zGm[offset], zLocal, extParams);
        }
        outQueueZ.FreeTensor(zLocal);
    }

private:
    AscendC::TPipe pipe;
    AscendC::TQue<AscendC::QuePosition::VECIN,  QUEUE_DEPTH> inQueueX, inQueueY;
    AscendC::TQue<AscendC::QuePosition::VECOUT, QUEUE_DEPTH> outQueueZ;
    AscendC::GlobalTensor<T> xGm, yGm, zGm;

    uint32_t alignNum;
    uint32_t blockCount;      // 等长主块数
    uint32_t tileLength;      // 单个 buffer 元素数（32B 对齐）
    uint32_t lastTileLength;  // 尾块元素数（< tileLength）
};

// ===========================================================================
// 核函数入口
// ===========================================================================
template <typename T>
__global__ __vector__ void sub_custom(GM_ADDR x, GM_ADDR y, GM_ADDR z,
                                      SubCustomTilingData tiling)
{
    KernelSub<T> op;
    op.Init(x, y, z, tiling);
    op.Process();
}

// ===========================================================================
// Host 侧启动函数
// ===========================================================================
extern "C" void run_kernel(GM_ADDR x, const TensorGroupInfo& info_x,
                           GM_ADDR y, const TensorGroupInfo& info_y,
                           GM_ADDR z, const TensorGroupInfo& info_z,
                           int64_t availableCoreNum, aclrtStream stream)
{
    const TensorInfo& t0 = info_x.tensors[0];

    // 1. 总元素数
    int64_t totalLength = 1;
    for (int64_t i = 0; i < t0.numDims; i++) {
        totalLength *= t0.shape[i];
    }
    if (totalLength <= 0) {
        return;
    }

    // 2. dtype 与 32B 对齐元素数
    int32_t dtype = t0.dtype;
    uint32_t alignNum = (dtype == 1) ? 16 : 8;  // fp16:16, fp32:8

    // 3. 保持原代码 blockDim=8 的语义，仅在数据量不足时收缩
    uint32_t blockDim = 8;
    if ((int64_t)blockDim > totalLength) {
        blockDim = (uint32_t)totalLength;
    }

    uint32_t baseLength = (uint32_t)totalLength / blockDim;
    uint32_t remainder  = (uint32_t)totalLength % blockDim;

    SubCustomTilingData tiling;
    tiling.totalLength  = (uint32_t)totalLength;
    tiling.blockDim     = blockDim;
    tiling.formerNum    = remainder;
    tiling.formerLength = baseLength + 1;
    tiling.tailLength   = baseLength;
    tiling.alignNum     = alignNum;

    // 4. 按 dtype 实例化
    if (dtype == 1) {
        sub_custom<half><<<blockDim, nullptr, stream>>>(x, y, z, tiling);
    } else {
        // 其他类型（含 bf16）默认走 float 实例，与原始加法代码保持一致
        sub_custom<float><<<blockDim, nullptr, stream>>>(x, y, z, tiling);
    }
}