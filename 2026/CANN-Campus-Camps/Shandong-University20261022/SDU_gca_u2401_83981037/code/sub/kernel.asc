#include <cmath>
#include "kernel_operator.h"

// TensorInfo、TensorGroupInfo 由评测框架提供，不要重复定义。

template <typename T>
__global__ __vector__ void sub_custom(
    GM_ADDR x, GM_ADDR y, GM_ADDR z)
{
    constexpr uint32_t totalLength = 8 * 2048;
    constexpr uint32_t tileLength = 1024;

    AscendC::TPipe pipe;
    AscendC::TQue<AscendC::TPosition::VECIN, 1> xQueue;
    AscendC::TQue<AscendC::TPosition::VECIN, 1> yQueue;
    AscendC::TQue<AscendC::TPosition::VECOUT, 1> zQueue;

    pipe.InitBuffer(xQueue, 1, tileLength * sizeof(T));
    pipe.InitBuffer(yQueue, 1, tileLength * sizeof(T));
    pipe.InitBuffer(zQueue, 1, tileLength * sizeof(T));

    AscendC::GlobalTensor<T> xGm, yGm, zGm;
    xGm.SetGlobalBuffer((__gm__ T*)x, totalLength);
    yGm.SetGlobalBuffer((__gm__ T*)y, totalLength);
    zGm.SetGlobalBuffer((__gm__ T*)z, totalLength);

    // 各核轮流处理完整的数据块。
    const uint32_t step = AscendC::GetBlockNum() * tileLength;

    for (uint32_t offset = AscendC::GetBlockIdx() * tileLength;
         offset < totalLength; offset += step) {
        // 1. 将输入从全局内存搬入片上缓存。
        AscendC::LocalTensor<T> xLocal = xQueue.AllocTensor<T>();
        AscendC::LocalTensor<T> yLocal = yQueue.AllocTensor<T>();

        AscendC::DataCopy(xLocal, xGm[offset], tileLength);
        AscendC::DataCopy(yLocal, yGm[offset], tileLength);

        xQueue.EnQue(xLocal);
        yQueue.EnQue(yLocal);

        // 2. 计算 z = x - y。
        xLocal = xQueue.DeQue<T>();
        yLocal = yQueue.DeQue<T>();
        AscendC::LocalTensor<T> zLocal = zQueue.AllocTensor<T>();

        AscendC::Sub(zLocal, xLocal, yLocal, tileLength);

        zQueue.EnQue(zLocal);
        xQueue.FreeTensor(xLocal);
        yQueue.FreeTensor(yLocal);

        // 3. 将结果写回全局内存。
        zLocal = zQueue.DeQue<T>();
        AscendC::DataCopy(zGm[offset], zLocal, tileLength);
        zQueue.FreeTensor(zLocal);
    }
}

extern "C" void run_kernel(
    GM_ADDR x, const TensorGroupInfo& info_x,
    GM_ADDR y, const TensorGroupInfo& info_y,
    GM_ADDR z, const TensorGroupInfo& info_z,
    int64_t availableCoreNum, aclrtStream stream)
{
    // 共 16384 / 1024 = 16 块，最多使用 16 个核。
    const uint32_t blockNum = static_cast<uint32_t>(
        availableCoreNum > 16 ? 16 :
        (availableCoreNum > 0 ? availableCoreNum : 1));

    const int32_t dtype = info_x.tensors[0].dtype;

    if (dtype == 0) {
        sub_custom<float><<<blockNum, nullptr, stream>>>(x, y, z);
    } else if (dtype == 1) {
        sub_custom<half><<<blockNum, nullptr, stream>>>(x, y, z);
    }
}