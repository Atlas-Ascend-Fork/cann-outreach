
#include <cmath>
#include "kernel_operator.h"

// Sub Kernel — Ascend C Direct Invocation
// TensorInfo / TensorGroupInfo 由平台预定义
// 不要添加 main()、include guards

constexpr uint32_t BUFFER_NUM = 2;
constexpr uint32_t TILE_NUM = 8;

// 1. Tiling 参数结构体
struct SubCustomTilingData {
    uint32_t totalLength;
    uint32_t tileNum;
    uint32_t dtype;
};

// 2. 核函数主体类
// 模板支持 float32 和 float16
template <typename T>
class KernelSub {
public:
    __aicore__ inline KernelSub() {}

    __aicore__ inline void Init(
        GM_ADDR x, GM_ADDR y, GM_ADDR z,
        uint32_t totalLength, uint32_t tileNum)
    {
        blockLength = totalLength / AscendC::GetBlockNum();
        tileLength = blockLength / tileNum / BUFFER_NUM;
        loopCount = tileNum * BUFFER_NUM;

        uint32_t offset =
            blockLength * AscendC::GetBlockIdx();

        xGm.SetGlobalBuffer(
            (__gm__ T*)x + offset, blockLength);
        yGm.SetGlobalBuffer(
            (__gm__ T*)y + offset, blockLength);
        zGm.SetGlobalBuffer(
            (__gm__ T*)z + offset, blockLength);

        pipe.InitBuffer(
            inQueueX, BUFFER_NUM,
            tileLength * sizeof(T));
        pipe.InitBuffer(
            inQueueY, BUFFER_NUM,
            tileLength * sizeof(T));
        pipe.InitBuffer(
            outQueueZ, BUFFER_NUM,
            tileLength * sizeof(T));
    }

    __aicore__ inline void Process()
    {
        for (uint32_t i = 0; i < loopCount; ++i) {
            CopyIn(i);
            Compute();
            CopyOut(i);
        }
    }

private:
    // GM -> UB
    __aicore__ inline void CopyIn(uint32_t i)
    {
        AscendC::LocalTensor<T> xLocal =
            inQueueX.AllocTensor<T>();
        AscendC::LocalTensor<T> yLocal =
            inQueueY.AllocTensor<T>();

        AscendC::DataCopy(
            xLocal, xGm[i * tileLength], tileLength);
        AscendC::DataCopy(
            yLocal, yGm[i * tileLength], tileLength);

        inQueueX.EnQue(xLocal);
        inQueueY.EnQue(yLocal);
    }

    // UB 上执行逐元素减法
    __aicore__ inline void Compute()
    {
        AscendC::LocalTensor<T> xLocal =
            inQueueX.DeQue<T>();
        AscendC::LocalTensor<T> yLocal =
            inQueueY.DeQue<T>();
        AscendC::LocalTensor<T> zLocal =
            outQueueZ.AllocTensor<T>();

        AscendC::Sub(
            zLocal, xLocal, yLocal, tileLength);

        outQueueZ.EnQue(zLocal);

        inQueueX.FreeTensor(xLocal);
        inQueueY.FreeTensor(yLocal);
    }

    // UB -> GM
    __aicore__ inline void CopyOut(uint32_t i)
    {
        AscendC::LocalTensor<T> zLocal =
            outQueueZ.DeQue<T>();

        AscendC::DataCopy(
            zGm[i * tileLength], zLocal, tileLength);

        outQueueZ.FreeTensor(zLocal);
    }

private:
    AscendC::TPipe pipe;

    AscendC::TQue<
        AscendC::TPosition::VECIN, BUFFER_NUM
    > inQueueX, inQueueY;

    AscendC::TQue<
        AscendC::TPosition::VECOUT, BUFFER_NUM
    > outQueueZ;

    AscendC::GlobalTensor<T> xGm;
    AscendC::GlobalTensor<T> yGm;
    AscendC::GlobalTensor<T> zGm;

    uint32_t blockLength = 0;
    uint32_t tileLength = 0;
    uint32_t loopCount = 0;
};

// 3. Device 侧核函数入口
__global__ __vector__ void sub_custom(
    GM_ADDR x, GM_ADDR y, GM_ADDR z,
    SubCustomTilingData tiling)
{
    if (tiling.dtype == 1) {
        // float16
        KernelSub<half> op;
        op.Init(
            x, y, z,
            tiling.totalLength, tiling.tileNum);
        op.Process();
    } else {
        // float32
        KernelSub<float> op;
        op.Init(
            x, y, z,
            tiling.totalLength, tiling.tileNum);
        op.Process();
    }
}

// 4. Host 侧启动入口
extern "C" void run_kernel(
    GM_ADDR x, const TensorGroupInfo& info_x,
    GM_ADDR y, const TensorGroupInfo& info_y,
    GM_ADDR z, const TensorGroupInfo& info_z,
    int64_t availableCoreNum,
    aclrtStream stream)
{
    if (info_x.numTensors < 1 ||
        info_y.numTensors < 1 ||
        info_z.numTensors < 1) {
        return;
    }

    const TensorInfo& tx = info_x.tensors[0];
    const TensorInfo& ty = info_y.tensors[0];
    const TensorInfo& tz = info_z.tensors[0];

    // 本题支持的类型：0=FP32，1=FP16
    if (tx.dtype != 0 && tx.dtype != 1) {
        return;
    }

    if (tx.dtype != ty.dtype ||
        tx.dtype != tz.dtype) {
        return;
    }

    // 题目要求的输入输出形状：(8, 2048)
    if (tx.numDims != 2 ||
        ty.numDims != 2 ||
        tz.numDims != 2) {
        return;
    }

    if (tx.shape[0] != 8 || tx.shape[1] != 2048 ||
        ty.shape[0] != 8 || ty.shape[1] != 2048 ||
        tz.shape[0] != 8 || tz.shape[1] != 2048) {
        return;
    }

    uint32_t totalLength =
        static_cast<uint32_t>(
            tx.shape[0] * tx.shape[1]);

    // 最多使用 8 个核
    uint32_t blockNum = 1;
    if (availableCoreNum > 0) {
        blockNum = static_cast<uint32_t>(
            availableCoreNum < 8 ? availableCoreNum : 8);
    }

    // 确保每个 tile 满足 32 字节搬运对齐要求
    while (blockNum > 1 &&
           totalLength % (blockNum * TILE_NUM *
                          BUFFER_NUM * 16) != 0) {
        --blockNum;
    }

    SubCustomTilingData tiling;
    tiling.totalLength = totalLength;
    tiling.tileNum = TILE_NUM;
    tiling.dtype = static_cast<uint32_t>(tx.dtype);

    // 启动 NPU 核函数
    sub_custom<<<blockNum, nullptr, stream>>>(
        x, y, z, tiling);
}

