
#include <cmath>
#include "kernel_operator.h"

// ---------------------------------------------------------------------------
// Tiling parameters
// ---------------------------------------------------------------------------
struct SubCustomTilingData {
    uint32_t totalLength;  // Total number of elements
    uint32_t tileNum;      // Number of tiles per core and buffer
};

constexpr uint32_t BUFFER_NUM = 2;
constexpr uint32_t QUEUE_DEPTH = 1;

// ---------------------------------------------------------------------------
// KernelSub: z = x - y
// Supports float32 and float16.
// ---------------------------------------------------------------------------
template <typename T>
class KernelSub {
public:
    __aicore__ inline KernelSub() {}

    __aicore__ inline void Init(
        GM_ADDR x,
        GM_ADDR y,
        GM_ADDR z,
        const SubCustomTilingData& tiling)
    {
        // Total length and tiling configuration
        uint32_t totalLength = tiling.totalLength;
        this->tileNum = tiling.tileNum;

        // Number of elements processed by each core
        this->blockLength =
            totalLength / AscendC::GetBlockNum();

        // Number of elements processed in each tile
        this->tileLength =
            this->blockLength / this->tileNum / BUFFER_NUM;

        // Set global memory addresses for the current core
        uint32_t blockOffset =
            this->blockLength * AscendC::GetBlockIdx();

        xGm.SetGlobalBuffer(
            reinterpret_cast<__gm__ T*>(x) + blockOffset,
            this->blockLength);

        yGm.SetGlobalBuffer(
            reinterpret_cast<__gm__ T*>(y) + blockOffset,
            this->blockLength);

        zGm.SetGlobalBuffer(
            reinterpret_cast<__gm__ T*>(z) + blockOffset,
            this->blockLength);

        // Allocate local buffers
        pipe.InitBuffer(
            inQueueX, BUFFER_NUM,
            this->tileLength * sizeof(T));

        pipe.InitBuffer(
            inQueueY, BUFFER_NUM,
            this->tileLength * sizeof(T));

        pipe.InitBuffer(
            outQueueZ, BUFFER_NUM,
            this->tileLength * sizeof(T));
    }

    __aicore__ inline void Process()
    {
        // Each core processes tileNum * BUFFER_NUM tiles
        int32_t loopCount = this->tileNum * BUFFER_NUM;

        for (int32_t i = 0; i < loopCount; ++i) {
            CopyIn(i);
            Compute();
            CopyOut(i);
        }
    }

private:
    __aicore__ inline void CopyIn(int32_t progress)
    {
        // Allocate local input tensors
        AscendC::LocalTensor<T> xLocal =
            inQueueX.AllocTensor<T>();

        AscendC::LocalTensor<T> yLocal =
            inQueueY.AllocTensor<T>();

        // Copy data from global memory to local memory
        uint32_t offset = progress * this->tileLength;

        AscendC::DataCopy(
            xLocal,
            xGm[offset],
            this->tileLength);

        AscendC::DataCopy(
            yLocal,
            yGm[offset],
            this->tileLength);

        // Enqueue input tensors
        inQueueX.EnQue(xLocal);
        inQueueY.EnQue(yLocal);
    }

    __aicore__ inline void Compute()
    {
        // Dequeue input tensors
        AscendC::LocalTensor<T> xLocal =
            inQueueX.DeQue<T>();

        AscendC::LocalTensor<T> yLocal =
            inQueueY.DeQue<T>();

        // Allocate output tensor
        AscendC::LocalTensor<T> zLocal =
            outQueueZ.AllocTensor<T>();

        // Vector subtraction: z = x - y
        AscendC::Sub(
            zLocal,
            xLocal,
            yLocal,
            this->tileLength);

        // Enqueue output tensor
        outQueueZ.EnQue<T>(zLocal);

        // Release input tensors
        inQueueX.FreeTensor(xLocal);
        inQueueY.FreeTensor(yLocal);
    }

    __aicore__ inline void CopyOut(int32_t progress)
    {
        // Dequeue output tensor
        AscendC::LocalTensor<T> zLocal =
            outQueueZ.DeQue<T>();

        // Copy results back to global memory
        uint32_t offset = progress * this->tileLength;

        AscendC::DataCopy(
            zGm[offset],
            zLocal,
            this->tileLength);

        // Release output tensor
        outQueueZ.FreeTensor(zLocal);
    }

private:
    AscendC::TPipe pipe;

    AscendC::TQue<
        AscendC::QuePosition::VECIN,
        QUEUE_DEPTH> inQueueX, inQueueY;

    AscendC::TQue<
        AscendC::QuePosition::VECOUT,
        QUEUE_DEPTH> outQueueZ;

    AscendC::GlobalTensor<T> xGm;
    AscendC::GlobalTensor<T> yGm;
    AscendC::GlobalTensor<T> zGm;

    uint32_t blockLength;
    uint32_t tileNum;
    uint32_t tileLength;
};

// ---------------------------------------------------------------------------
// Kernel entry
// ---------------------------------------------------------------------------
template <typename T>
__global__ __vector__ void sub_custom(
    GM_ADDR x,
    GM_ADDR y,
    GM_ADDR z,
    SubCustomTilingData tiling)
{
    KernelSub<T> op;
    op.Init(x, y, z, tiling);
    op.Process();
}

// ---------------------------------------------------------------------------
// Host launch function
// ---------------------------------------------------------------------------
extern "C" void run_kernel(
    GM_ADDR x,
    const TensorGroupInfo& info_x,
    GM_ADDR y,
    const TensorGroupInfo& info_y,
    GM_ADDR z,
    const TensorGroupInfo& info_z,
    int64_t availableCoreNum,
    aclrtStream stream)
{
    // The test shape is fixed at (8, 2048).
    constexpr uint32_t blockDim = 8;
    constexpr uint32_t tileNum = 8;

    // Calculate the total number of elements.
    const TensorInfo& t0 = info_x.tensors[0];

    int64_t totalLength = 1;
    for (int64_t i = 0; i < t0.numDims; ++i) {
        totalLength *= t0.shape[i];
    }

    // Configure tiling parameters.
    SubCustomTilingData tiling = {
        static_cast<uint32_t>(totalLength),
        tileNum
    };

    // Dispatch according to the input dtype.
    if (t0.dtype == 1) {
        // float16
        sub_custom<half>
            <<<blockDim, nullptr, stream>>>(
                x, y, z, tiling);
    } else if (t0.dtype == 0) {
        // float32
        sub_custom<float>
            <<<blockDim, nullptr, stream>>>(
                x, y, z, tiling);
    }
}
