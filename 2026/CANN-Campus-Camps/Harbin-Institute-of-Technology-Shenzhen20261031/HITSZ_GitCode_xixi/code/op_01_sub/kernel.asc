#include "kernel_operator.h"

constexpr uint32_t BLOCK_DIM = 8;
constexpr uint32_t BLOCK_LENGTH = 2048;
constexpr uint32_t CHUNK = 1024;
constexpr uint32_t BANK_PAD_BYTES = 32;

template <typename T>
__global__ __vector__ void sub_custom(GM_ADDR x, GM_ADDR y, GM_ADDR z);

template <>
__global__ __vector__ void sub_custom<float>(GM_ADDR x, GM_ADDR y, GM_ADDR z)
{
    AscendC::InitSocState();
    uint32_t offset = AscendC::GetBlockIdx() * BLOCK_LENGTH;
    AscendC::GlobalTensor<float> gx, gy, gz;
    gx.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(x) + offset, BLOCK_LENGTH);
    gy.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(y) + offset, BLOCK_LENGTH);
    gz.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(z) + offset, BLOCK_LENGTH);

    constexpr uint32_t byteSize = BLOCK_LENGTH * sizeof(float);
    constexpr uint32_t step = byteSize + BANK_PAD_BYTES;
    constexpr uint32_t xAddr = 0;
    constexpr uint32_t yAddr = step;
    constexpr uint32_t zAddr = 2 * step;

    AscendC::LocalTensor<float> xLocal(AscendC::TPosition::VECIN, xAddr, BLOCK_LENGTH);
    AscendC::LocalTensor<float> yLocal(AscendC::TPosition::VECIN, yAddr, BLOCK_LENGTH);
    AscendC::LocalTensor<float> zLocal(AscendC::TPosition::VECOUT, zAddr, BLOCK_LENGTH);

    AscendC::DataCopy(xLocal, gx, BLOCK_LENGTH);
    AscendC::DataCopy(yLocal, gy, BLOCK_LENGTH);
    AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);
    AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);

    AscendC::Sub(zLocal, xLocal, yLocal, BLOCK_LENGTH);

    AscendC::SetFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
    AscendC::WaitFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
    AscendC::DataCopy(gz, zLocal, BLOCK_LENGTH);
}

template <>
__global__ __vector__ void sub_custom<half>(GM_ADDR x, GM_ADDR y, GM_ADDR z)
{
    AscendC::InitSocState();
    uint32_t blockIdx = AscendC::GetBlockIdx();
    uint32_t offset0 = blockIdx * BLOCK_LENGTH;
    uint32_t offset1 = offset0 + CHUNK;

    constexpr uint32_t byteSize = CHUNK * sizeof(half);
    constexpr uint32_t step = byteSize + BANK_PAD_BYTES;

    constexpr uint32_t xPingAddr = 0;
    constexpr uint32_t yPingAddr = step;
    constexpr uint32_t zPingAddr = 2 * step;

    constexpr uint32_t xPongAddr = 3 * step;
    constexpr uint32_t yPongAddr = 4 * step;
    constexpr uint32_t zPongAddr = 5 * step;

    AscendC::GlobalTensor<half> gx0, gy0, gz0;
    gx0.SetGlobalBuffer(reinterpret_cast<__gm__ half*>(x) + offset0, CHUNK);
    gy0.SetGlobalBuffer(reinterpret_cast<__gm__ half*>(y) + offset0, CHUNK);
    gz0.SetGlobalBuffer(reinterpret_cast<__gm__ half*>(z) + offset0, CHUNK);

    AscendC::GlobalTensor<half> gx1, gy1, gz1;
    gx1.SetGlobalBuffer(reinterpret_cast<__gm__ half*>(x) + offset1, CHUNK);
    gy1.SetGlobalBuffer(reinterpret_cast<__gm__ half*>(y) + offset1, CHUNK);
    gz1.SetGlobalBuffer(reinterpret_cast<__gm__ half*>(z) + offset1, CHUNK);

    AscendC::LocalTensor<half> xPing(AscendC::TPosition::VECIN, xPingAddr, CHUNK);
    AscendC::LocalTensor<half> yPing(AscendC::TPosition::VECIN, yPingAddr, CHUNK);
    AscendC::LocalTensor<half> zPing(AscendC::TPosition::VECOUT, zPingAddr, CHUNK);

    AscendC::LocalTensor<half> xPong(AscendC::TPosition::VECIN, xPongAddr, CHUNK);
    AscendC::LocalTensor<half> yPong(AscendC::TPosition::VECIN, yPongAddr, CHUNK);
    AscendC::LocalTensor<half> zPong(AscendC::TPosition::VECOUT, zPongAddr, CHUNK);

    // 1. Copy in Ping
    AscendC::DataCopy(xPing, gx0, CHUNK);
    AscendC::DataCopy(yPing, gy0, CHUNK);
    AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);

    // 2. Copy in Pong
    AscendC::DataCopy(xPong, gx1, CHUNK);
    AscendC::DataCopy(yPong, gy1, CHUNK);
    AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID1);

    // 3. Compute Ping
    AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);
    AscendC::Sub(zPing, xPing, yPing, CHUNK);
    AscendC::SetFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);

    // 4. Copy out Ping
    AscendC::WaitFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
    AscendC::DataCopy(gz0, zPing, CHUNK);

    // 5. Compute Pong
    AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID1);
    AscendC::Sub(zPong, xPong, yPong, CHUNK);
    AscendC::SetFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID1);

    // 6. Copy out Pong
    AscendC::WaitFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID1);
    AscendC::DataCopy(gz1, zPong, CHUNK);
}

extern "C" void run_kernel(
    GM_ADDR x,
    const TensorGroupInfo& info_x,
    GM_ADDR y,
    const TensorGroupInfo& info_y,
    GM_ADDR z,
    const TensorGroupInfo& info_z,
    int64_t availableCoreNum,
    aclrtStream stream)
{
    (void)info_y;
    (void)info_z;
    (void)availableCoreNum;

    if (info_x.tensors[0].dtype == 1) {
        sub_custom<half><<<BLOCK_DIM, nullptr, stream>>>(x, y, z);
    } else {
        sub_custom<float><<<BLOCK_DIM, nullptr, stream>>>(x, y, z);
    }
}
