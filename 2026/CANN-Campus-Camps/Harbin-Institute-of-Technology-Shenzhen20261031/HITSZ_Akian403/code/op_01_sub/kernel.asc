#include <cstdint>
#include "kernel_operator.h"

// Fixed task: contiguous 8 x 2048 tensors, fp32 or fp16.
namespace {
constexpr uint32_t TOTAL_LENGTH = 8 * 2048;

inline bool IsSupportedTensor(const TensorGroupInfo& info, int32_t dtype)
{
    if (info.numTensors != 1 || info.tensors == nullptr) {
        return false;
    }
    const TensorInfo& t = info.tensors[0];
    return t.dtype == dtype && t.numDims == 2 && t.shape != nullptr &&
        t.shape[0] == 8 && t.shape[1] == 2048;
}
} // namespace

template <typename T, uint32_t BLOCK_LENGTH, bool ALIGNED>
__global__ __vector__ void sub_static(GM_ADDR x, GM_ADDR y, GM_ADDR z)
{
    // Required for static Tensor programming: reset hardware state inherited
    // from any preceding kernel, then manage UB and events explicitly.
    AscendC::InitSocState();

    // Limit UB use even if only one or two cores are available. For the normal
    // 8-core case this is one 2048-element chunk per core.
    constexpr uint32_t CHUNK_LENGTH = BLOCK_LENGTH < 4096 ? BLOCK_LENGTH : 4096;
    constexpr uint32_t CHUNK_BYTES = CHUNK_LENGTH * sizeof(T);
    static_assert(CHUNK_BYTES % 32 == 0, "DataCopy length must be 32-byte aligned");

    // The 32-byte gap helps avoid the two input buffers starting in the same
    // UB bank group; the result reuses the first input buffer.
    AscendC::LocalTensor<T> xLocal(AscendC::TPosition::VECCALC, 0, CHUNK_LENGTH);
    AscendC::LocalTensor<T> yLocal(AscendC::TPosition::VECCALC, CHUNK_BYTES + 32, CHUNK_LENGTH);

    const uint32_t offset = AscendC::GetBlockIdx() * BLOCK_LENGTH;
    AscendC::GlobalTensor<T> xGm, yGm, zGm;
    xGm.SetGlobalBuffer((__gm__ T*)x + offset, BLOCK_LENGTH);
    yGm.SetGlobalBuffer((__gm__ T*)y + offset, BLOCK_LENGTH);
    zGm.SetGlobalBuffer((__gm__ T*)z + offset, BLOCK_LENGTH);

    for (uint32_t pos = 0; pos < BLOCK_LENGTH; pos += CHUNK_LENGTH) {
        if (ALIGNED) {
            AscendC::DataCopy(xLocal, xGm[pos], CHUNK_LENGTH);
            AscendC::DataCopy(yLocal, yGm[pos], CHUNK_LENGTH);
        } else {
            const AscendC::DataCopyExtParams copyParams{1, CHUNK_BYTES, 0, 0, 0};
            const AscendC::DataCopyPadExtParams<T> padParams{false, 0, 0, 0};
            AscendC::DataCopyPad(xLocal, xGm[pos], copyParams, padParams);
            AscendC::DataCopyPad(yLocal, yGm[pos], copyParams, padParams);
        }

        AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(0);
        AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(0);
        AscendC::Sub(xLocal, xLocal, yLocal, CHUNK_LENGTH);
        AscendC::SetFlag<AscendC::HardEvent::V_MTE3>(0);
        AscendC::WaitFlag<AscendC::HardEvent::V_MTE3>(0);

        if (ALIGNED) {
            AscendC::DataCopy(zGm[pos], xLocal, CHUNK_LENGTH);
        } else {
            const AscendC::DataCopyExtParams copyParams{1, CHUNK_BYTES, 0, 0, 0};
            AscendC::DataCopyPad(zGm[pos], xLocal, copyParams);
        }
        // Finish output before reusing UB, and finish all work before exit.
        AscendC::PipeBarrier<PIPE_ALL>();
    }
}

template <typename T, bool ALIGNED>
inline void LaunchSub(GM_ADDR x, GM_ADDR y, GM_ADDR z,
                      int64_t availableCoreNum, aclrtStream stream)
{
    if (availableCoreNum >= 8) {
        sub_static<T, TOTAL_LENGTH / 8, ALIGNED><<<8, nullptr, stream>>>(x, y, z);
    } else if (availableCoreNum >= 4) {
        sub_static<T, TOTAL_LENGTH / 4, ALIGNED><<<4, nullptr, stream>>>(x, y, z);
    } else if (availableCoreNum >= 2) {
        sub_static<T, TOTAL_LENGTH / 2, ALIGNED><<<2, nullptr, stream>>>(x, y, z);
    } else {
        sub_static<T, TOTAL_LENGTH, ALIGNED><<<1, nullptr, stream>>>(x, y, z);
    }
}

extern "C" void run_kernel(GM_ADDR x, const TensorGroupInfo& info_x,
    GM_ADDR y, const TensorGroupInfo& info_y, GM_ADDR z,
    const TensorGroupInfo& info_z, int64_t availableCoreNum, aclrtStream stream)
{
    if (x == nullptr || y == nullptr || z == nullptr || availableCoreNum <= 0 ||
        info_x.numTensors != 1 || info_x.tensors == nullptr) {
        return;
    }
    const int32_t dtype = info_x.tensors[0].dtype;
    if ((dtype != 0 && dtype != 1) || !IsSupportedTensor(info_x, dtype) ||
        !IsSupportedTensor(info_y, dtype) || !IsSupportedTensor(info_z, dtype)) {
        return;
    }
    // DataCopyPad keeps the original kernel's behavior for unaligned pointers.
    const std::uintptr_t outputAddress = reinterpret_cast<std::uintptr_t>(z);
    const bool aligned = ((reinterpret_cast<std::uintptr_t>(x) |
        reinterpret_cast<std::uintptr_t>(y) | outputAddress) & 31u) == 0;
    // Adjacent cores could otherwise write the same boundary block when z is
    // unaligned. A single core handles this uncommon case without a race.
    const int64_t safeCoreNum = (outputAddress & 31u) == 0 ? availableCoreNum : 1;
    if (dtype == 0) {
        if (aligned) LaunchSub<float, true>(x, y, z, safeCoreNum, stream);
        else LaunchSub<float, false>(x, y, z, safeCoreNum, stream);
    } else {
        if (aligned) LaunchSub<half, true>(x, y, z, safeCoreNum, stream);
        else LaunchSub<half, false>(x, y, z, safeCoreNum, stream);
    }
}