#include <cstdint>
#include "kernel_operator.h"

// Included by main.asc after TensorInfo / TensorGroupInfo are defined.
namespace sub_detail {
constexpr uint32_t kTotalLength = 8 * 2048;
constexpr uint32_t kTileLength = 1024;
constexpr uint32_t kTileCount = kTotalLength / kTileLength;

template <typename T>
class KernelSub {
public:
    __aicore__ inline void Init(GM_ADDR x, GM_ADDR y, GM_ADDR z)
    {
        xGm.SetGlobalBuffer((__gm__ T*)x, kTotalLength);
        yGm.SetGlobalBuffer((__gm__ T*)y, kTotalLength);
        zGm.SetGlobalBuffer((__gm__ T*)z, kTotalLength);
        pipe.InitBuffer(xQueue, 1, kTileLength * sizeof(T));
        pipe.InitBuffer(yQueue, 1, kTileLength * sizeof(T));
        pipe.InitBuffer(zQueue, 1, kTileLength * sizeof(T));
    }

    __aicore__ inline void Process()
    {
        // Whole tiles keep every DMA transfer 32-byte aligned for both dtypes.
        // A strided assignment also handles core counts that do not divide 16.
        for (uint32_t tile = AscendC::GetBlockIdx(); tile < kTileCount;
             tile += AscendC::GetBlockNum()) {
            const uint32_t offset = tile * kTileLength;
            CopyIn(offset);
            Compute();
            CopyOut(offset);
        }
    }

private:
    __aicore__ inline void CopyIn(uint32_t offset)
    {
        AscendC::LocalTensor<T> xLocal = xQueue.AllocTensor<T>();
        AscendC::LocalTensor<T> yLocal = yQueue.AllocTensor<T>();
        AscendC::DataCopy(xLocal, xGm[offset], kTileLength);
        AscendC::DataCopy(yLocal, yGm[offset], kTileLength);
        xQueue.EnQue(xLocal);
        yQueue.EnQue(yLocal);
    }

    __aicore__ inline void Compute()
    {
        AscendC::LocalTensor<T> xLocal = xQueue.DeQue<T>();
        AscendC::LocalTensor<T> yLocal = yQueue.DeQue<T>();
        AscendC::LocalTensor<T> zLocal = zQueue.AllocTensor<T>();
        AscendC::Sub(zLocal, xLocal, yLocal, kTileLength);
        zQueue.EnQue(zLocal);
        xQueue.FreeTensor(xLocal);
        yQueue.FreeTensor(yLocal);
    }

    __aicore__ inline void CopyOut(uint32_t offset)
    {
        AscendC::LocalTensor<T> zLocal = zQueue.DeQue<T>();
        AscendC::DataCopy(zGm[offset], zLocal, kTileLength);
        zQueue.FreeTensor(zLocal);
    }

    AscendC::TPipe pipe;
    AscendC::TQue<AscendC::QuePosition::VECIN, 1> xQueue;
    AscendC::TQue<AscendC::QuePosition::VECIN, 1> yQueue;
    AscendC::TQue<AscendC::QuePosition::VECOUT, 1> zQueue;
    AscendC::GlobalTensor<T> xGm, yGm, zGm;
};

inline bool IsSupportedTensor(const TensorGroupInfo& info)
{
    if (info.numTensors != 1 || info.tensors == nullptr) {
        return false;
    }
    const TensorInfo& tensor = info.tensors[0];
    return tensor.numDims == 2 && tensor.shape != nullptr &&
           tensor.shape[0] == 8 && tensor.shape[1] == 2048 &&
           (tensor.dtype == 0 || tensor.dtype == 1);
}
} // namespace sub_detail

template <typename T>
__global__ __vector__ void sub_custom(GM_ADDR x, GM_ADDR y, GM_ADDR z)
{
    sub_detail::KernelSub<T> op;
    op.Init(x, y, z);
    op.Process();
}

extern "C" void run_kernel(GM_ADDR x, const TensorGroupInfo& info_x, GM_ADDR y, const TensorGroupInfo& info_y, GM_ADDR z, const TensorGroupInfo& info_z, int64_t availableCoreNum, aclrtStream stream)
{
    if (availableCoreNum <= 0 || !sub_detail::IsSupportedTensor(info_x) ||
        !sub_detail::IsSupportedTensor(info_y) || !sub_detail::IsSupportedTensor(info_z)) {
        return;
    }
    const int32_t dtype = info_x.tensors[0].dtype;
    if (info_y.tensors[0].dtype != dtype || info_z.tensors[0].dtype != dtype) {
        return;
    }
    const uint32_t blockNum = availableCoreNum < sub_detail::kTileCount
                                 ? static_cast<uint32_t>(availableCoreNum)
                                 : sub_detail::kTileCount;
    if (dtype == 0) {
        sub_custom<float><<<blockNum, nullptr, stream>>>(x, y, z);
    } else {
        sub_custom<half><<<blockNum, nullptr, stream>>>(x, y, z);
    }
}
