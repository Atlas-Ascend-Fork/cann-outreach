#include "kernel_operator.h"

using namespace AscendC;

template<typename T>
__global__ __vector__ void sub_custom(GM_ADDR x, GM_ADDR y, GM_ADDR z)
{
    TPipe pipe;
    TBuf<TPosition::VECCALC> xBuf, yBuf, zBuf;
    pipe.InitBuffer(xBuf, 2048 * sizeof(T));
    pipe.InitBuffer(yBuf, 2048 * sizeof(T));
    pipe.InitBuffer(zBuf, 2048 * sizeof(T));
    auto xLocal = xBuf.Get<T>();
    auto yLocal = yBuf.Get<T>();
    auto zLocal = zBuf.Get<T>();
    GlobalTensor<T> xGm, yGm, zGm;
    xGm.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(x), 16384);
    yGm.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(y), 16384);
    zGm.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(z), 16384);
    for (uint32_t tile = GetBlockIdx(); tile < 8; tile += GetBlockNum()) {
        uint32_t offset = tile * 2048;
        DataCopy(xLocal, xGm[offset], 2048);
        DataCopy(yLocal, yGm[offset], 2048);
        SetFlag<HardEvent::MTE2_V>(EVENT_ID0);
        WaitFlag<HardEvent::MTE2_V>(EVENT_ID0);
        Sub(zLocal, xLocal, yLocal, 2048);
        SetFlag<HardEvent::V_MTE3>(EVENT_ID0);
        WaitFlag<HardEvent::V_MTE3>(EVENT_ID0);
        DataCopy(zGm[offset], zLocal, 2048);
        PipeBarrier<PIPE_ALL>();
    }
}

extern "C" void run_kernel(GM_ADDR x, const TensorGroupInfo& info_x,
    GM_ADDR y, const TensorGroupInfo& info_y,
    GM_ADDR z, const TensorGroupInfo& info_z,
    int64_t availableCoreNum, aclrtStream stream)
{
    uint32_t blockNum = availableCoreNum < 8 ? static_cast<uint32_t>(availableCoreNum) : 8;
    if (blockNum == 0) return;
    if (info_x.tensors[0].dtype == 0) {
        sub_custom<float><<<blockNum, nullptr, stream>>>(x, y, z);
    } else if (info_x.tensors[0].dtype == 1) {
        sub_custom<half><<<blockNum, nullptr, stream>>>(x, y, z);
    }
}
