#include <cmath>
#include <cstdint>
#include <stdexcept>
#include "kernel_operator.h"
/*
 * Sub Kernel — Ascend C Direct Invocation
 * This file is #included — do NOT add main(), #pragma once, or include guards.
 *
 * TensorGroupInfo / TensorInfo (predefined):
 *   struct TensorInfo { const int64_t* shape; int64_t numDims; int32_t dtype; };
 *   struct TensorGroupInfo { const TensorInfo* tensors; int64_t numTensors; };
 *   dtype: 0=fp32 1=fp16 2=bf16 3=int8 4=int16 5=int32 6=int64 7=uint8 8=uint16 9=uint32 10=uint64 11=bool
 *   Usage: info_x.tensors[0].shape[0]  // first dim of first tensor in input x
 *
 * __global__ __vector__ void sub_custom(...)
 * {
 *     // TODO: implement your kernel logic
 *     // Available APIs: AscendC::TPipe, AscendC::TQue, AscendC::DataCopy, AscendC::Add, ...
 * }
 */

namespace {
constexpr uint32_t SUB_TILE_LENGTH = 2048;
constexpr uint32_t SUB_BUFFER_COUNT = 2;

__aicore__ inline void ComputeSub(AscendC::LocalTensor<float> z,
    AscendC::LocalTensor<float> x, AscendC::LocalTensor<float> y,
    AscendC::TBuf<AscendC::TPosition::VECCALC>& scratch, uint32_t count)
{
    AscendC::Sub(z, x, y, count);
}

__aicore__ inline void ComputeSub(AscendC::LocalTensor<half> z,
    AscendC::LocalTensor<half> x, AscendC::LocalTensor<half> y,
    AscendC::TBuf<AscendC::TPosition::VECCALC>& scratch, uint32_t count)
{
    auto xFloat = scratch.Get<float>();
    auto yFloat = xFloat[SUB_TILE_LENGTH];
    AscendC::Cast(xFloat, x, AscendC::RoundMode::CAST_NONE, count);
    AscendC::Cast(yFloat, y, AscendC::RoundMode::CAST_NONE, count);
    AscendC::PipeBarrier<PIPE_V>();
    AscendC::Sub(xFloat, xFloat, yFloat, count);
    AscendC::PipeBarrier<PIPE_V>();
    AscendC::Cast(z, xFloat, AscendC::RoundMode::CAST_ROUND, count);
    AscendC::PipeBarrier<PIPE_V>();
}

template <typename T>
class KernelSub {
public:
    __aicore__ inline void Init(GM_ADDR x, GM_ADDR y, GM_ADDR z, uint64_t total)
    {
        // Split complete 32-byte blocks so cores never share an output block
        constexpr uint32_t align = 32 / sizeof(T);
        const uint64_t units = (total + align - 1) / align;
        const uint64_t cores = AscendC::GetBlockNum();
        const uint64_t core = AscendC::GetBlockIdx();
        const uint64_t base = units / cores;
        const uint64_t extra = units % cores;
        const uint64_t offset = (core * base + (core < extra ? core : extra)) * align;
        const uint64_t capacity = (base + (core < extra ? 1 : 0)) * align;
        length_ = total - offset < capacity ? total - offset : capacity;
        xGm_.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(x) + offset, length_);
        yGm_.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(y) + offset, length_);
        zGm_.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(z) + offset, length_);
        pipe_.InitBuffer(xQueue_, SUB_BUFFER_COUNT, SUB_TILE_LENGTH * sizeof(T));
        pipe_.InitBuffer(yQueue_, SUB_BUFFER_COUNT, SUB_TILE_LENGTH * sizeof(T));
        pipe_.InitBuffer(zQueue_, SUB_BUFFER_COUNT, SUB_TILE_LENGTH * sizeof(T));
        if (sizeof(T) == sizeof(half)) {
            pipe_.InitBuffer(scratch_, 2 * SUB_TILE_LENGTH * sizeof(float));
        }
    }

    __aicore__ inline void Process()
    {
        for (uint64_t offset = 0; offset < length_; offset += SUB_TILE_LENGTH) {
            const uint32_t count = length_ - offset < SUB_TILE_LENGTH
                ? static_cast<uint32_t>(length_ - offset) : SUB_TILE_LENGTH;
            AscendC::DataCopyExtParams params{
                1, static_cast<uint32_t>(count * sizeof(T)), 0, 0, 0};
            AscendC::DataCopyPadExtParams<T> padding{false, 0, 0, static_cast<T>(0)};
            auto x = xQueue_.template AllocTensor<T>();
            auto y = yQueue_.template AllocTensor<T>();
            AscendC::DataCopyPad(x, xGm_[offset], params, padding);
            AscendC::DataCopyPad(y, yGm_[offset], params, padding);
            xQueue_.EnQue(x);
            yQueue_.EnQue(y);

            x = xQueue_.template DeQue<T>();
            y = yQueue_.template DeQue<T>();
            auto z = zQueue_.template AllocTensor<T>();
            ComputeSub(z, x, y, scratch_, count);
            zQueue_.EnQue(z);
            xQueue_.FreeTensor(x);
            yQueue_.FreeTensor(y);

            z = zQueue_.template DeQue<T>();
            AscendC::DataCopyPad(zGm_[offset], z, params);
            zQueue_.FreeTensor(z);
        }
    }

private:
    AscendC::TPipe pipe_;
    AscendC::GlobalTensor<T> xGm_, yGm_, zGm_;
    AscendC::TQue<AscendC::TPosition::VECIN, 1> xQueue_, yQueue_;
    AscendC::TQue<AscendC::TPosition::VECOUT, 1> zQueue_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> scratch_;
    uint64_t length_ = 0;
};

// Contiguous tensors with identical shapes and dtypes, without broadcasting
inline uint64_t GetSubElementCount(const TensorGroupInfo& x,
    const TensorGroupInfo& y, const TensorGroupInfo& z)
{
    if (x.numTensors != 1 || y.numTensors != 1 || z.numTensors != 1 ||
        x.tensors == nullptr || y.tensors == nullptr || z.tensors == nullptr) {
        throw std::invalid_argument("sub expects one tensor in each group");
    }
    const auto& a = x.tensors[0];
    const auto& b = y.tensors[0];
    const auto& c = z.tensors[0];
    if ((a.dtype != 0 && a.dtype != 1) || a.dtype != b.dtype || a.dtype != c.dtype ||
        a.numDims < 0 || a.numDims != b.numDims || a.numDims != c.numDims ||
        (a.numDims > 0 && (a.shape == nullptr || b.shape == nullptr || c.shape == nullptr))) {
        throw std::invalid_argument("sub requires matching shapes and float32/float16 dtypes");
    }
    bool empty = false;
    for (int64_t i = 0; i < a.numDims; ++i) {
        if (a.shape[i] < 0 || a.shape[i] != b.shape[i] || a.shape[i] != c.shape[i]) {
            throw std::invalid_argument("sub requires matching nonnegative dimensions");
        }
        empty = empty || a.shape[i] == 0;
    }
    if (empty) {
        return 0;
    }
    uint64_t total = 1;
    for (int64_t i = 0; i < a.numDims; ++i) {
        if (total > static_cast<uint64_t>(INT64_MAX) / a.shape[i]) {
            throw std::overflow_error("sub tensor element count overflows int64");
        }
        total *= a.shape[i];
    }
    return total;
}
} // namespace

template <typename T>
__global__ __vector__ void sub_custom(GM_ADDR x, GM_ADDR y, GM_ADDR z, uint64_t total)
{
    KernelSub<T> op;
    op.Init(x, y, z, total);
    op.Process();
}

extern "C" void run_kernel(GM_ADDR x, const TensorGroupInfo& info_x, GM_ADDR y, const TensorGroupInfo& info_y, GM_ADDR z, const TensorGroupInfo& info_z, int64_t availableCoreNum, aclrtStream stream)
{
    const uint64_t total = GetSubElementCount(info_x, info_y, info_z);
    if (total == 0) {
        return;
    }
    if (x == nullptr || y == nullptr || z == nullptr || availableCoreNum <= 0) {
        throw std::invalid_argument("sub requires valid device buffers and a positive core count");
    }
    const uint64_t usefulCores = (total + 255) / 256;
    const uint32_t blockNum = static_cast<uint32_t>(
        usefulCores < static_cast<uint64_t>(availableCoreNum) ? usefulCores : availableCoreNum);
    if (info_x.tensors[0].dtype == 0) {
        sub_custom<float><<<blockNum, nullptr, stream>>>(x, y, z, total);
    } else {
        sub_custom<half><<<blockNum, nullptr, stream>>>(x, y, z, total);
    }
}
