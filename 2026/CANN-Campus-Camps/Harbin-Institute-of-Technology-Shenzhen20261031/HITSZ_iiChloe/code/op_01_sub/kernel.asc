#include <cmath>
#include "kernel_operator.h"

constexpr uint32_t SUB_TILE_LENGTH = 1024;

template <typename T>
__global__ __vector__ void sub_custom(
    GM_ADDR x,
    GM_ADDR y,
    GM_ADDR z,
    int64_t totalLength)
{
    AscendC::GlobalTensor<T> xGlobal, yGlobal, zGlobal;
    xGlobal.SetGlobalBuffer((__gm__ T*)x, totalLength);
    yGlobal.SetGlobalBuffer((__gm__ T*)y, totalLength);
    zGlobal.SetGlobalBuffer((__gm__ T*)z, totalLength);

    AscendC::TPipe pipe;
    AscendC::TQue<AscendC::QuePosition::VECIN, 2> xQueue, yQueue;
    AscendC::TQue<AscendC::QuePosition::VECOUT, 2> zQueue;

    pipe.InitBuffer(xQueue, 2, SUB_TILE_LENGTH * sizeof(T));
    pipe.InitBuffer(yQueue, 2, SUB_TILE_LENGTH * sizeof(T));
    pipe.InitBuffer(zQueue, 2, SUB_TILE_LENGTH * sizeof(T));

    const int64_t stride =
        static_cast<int64_t>(AscendC::GetBlockNum()) * SUB_TILE_LENGTH;

    for (
        int64_t offset =
            static_cast<int64_t>(AscendC::GetBlockIdx()) * SUB_TILE_LENGTH;
        offset < totalLength;
        offset += stride)
    {
        const uint32_t count = totalLength - offset < SUB_TILE_LENGTH
            ? static_cast<uint32_t>(totalLength - offset)
            : SUB_TILE_LENGTH;

        const bool aligned = (count * sizeof(T)) % 32 == 0;

        const AscendC::DataCopyExtParams copyParams{
            1,
            static_cast<uint32_t>(count * sizeof(T)),
            0,
            0,
            0
        };

        auto xLocal = xQueue.AllocTensor<T>();
        auto yLocal = yQueue.AllocTensor<T>();

        if (aligned) {
            AscendC::DataCopy(xLocal, xGlobal[offset], count);
            AscendC::DataCopy(yLocal, yGlobal[offset], count);
        } else {
            const AscendC::DataCopyPadExtParams<T> padParams{
                false, 0, 0, 0
            };

            AscendC::DataCopyPad(
                xLocal, xGlobal[offset], copyParams, padParams);
            AscendC::DataCopyPad(
                yLocal, yGlobal[offset], copyParams, padParams);
        }

        xQueue.EnQue(xLocal);
        yQueue.EnQue(yLocal);

        xLocal = xQueue.DeQue<T>();
        yLocal = yQueue.DeQue<T>();

        auto zLocal = zQueue.AllocTensor<T>();
        AscendC::Sub(zLocal, xLocal, yLocal, count);

        zQueue.EnQue(zLocal);

        xQueue.FreeTensor(xLocal);
        yQueue.FreeTensor(yLocal);

        zLocal = zQueue.DeQue<T>();

        if (aligned) {
            AscendC::DataCopy(zGlobal[offset], zLocal, count);
        } else {
            AscendC::DataCopyPad(zGlobal[offset], zLocal, copyParams);
        }

        zQueue.FreeTensor(zLocal);
    }
}

extern "C" void run_kernel(
    GM_ADDR x,
    const TensorGroupInfo& info_x,
    GM_ADDR y,
    const TensorGroupInfo& info_y,
    GM_ADDR z,
    const TensorGroupInfo& info_z,
    int64_t availableCoreNum,
    aclrtStream stream)
{
    if (availableCoreNum <= 0 ||
        info_x.numTensors == 0 ||
        info_y.numTensors == 0 ||
        info_z.numTensors == 0) {
        return;
    }

    const TensorInfo& input = info_x.tensors[0];

    if (input.dtype != info_y.tensors[0].dtype ||
        input.dtype != info_z.tensors[0].dtype) {
        return;
    }

    int64_t totalLength = 1;

    for (int64_t dim = 0; dim < input.numDims; ++dim) {
        totalLength *= input.shape[dim];
    }

    if (totalLength <= 0) {
        return;
    }

    const int64_t tileCount =
        (totalLength - 1) / SUB_TILE_LENGTH + 1;

    const uint32_t blockNum = static_cast<uint32_t>(
        tileCount < availableCoreNum ? tileCount : availableCoreNum);

    if (input.dtype == 0) {
        sub_custom<float><<<blockNum, nullptr, stream>>>(
            x, y, z, totalLength);
    } else if (input.dtype == 1) {
        sub_custom<half><<<blockNum, nullptr, stream>>>(
            x, y, z, totalLength);
    }
}