#include <cmath>
#include "kernel_operator.h"

using namespace AscendC;

constexpr uint32_t BUFFER_NUM = 2;
constexpr uint32_t TILE_LENGTH = 1024;
constexpr uint32_t MAX_BLOCK_NUM = 8;

template <typename T>
class KernelSub {
public:
    __aicore__ inline void Init(GM_ADDR x, GM_ADDR y, GM_ADDR z, uint32_t totalLength)
    {
        const uint32_t blockIdx = GetBlockIdx();
        const uint32_t blockNum = GetBlockNum();
        const uint32_t baseLength = totalLength / blockNum;
        const uint32_t remainder = totalLength % blockNum;

        blockLength = baseLength + (blockIdx < remainder ? 1 : 0);
        blockOffset = blockIdx * baseLength + (blockIdx < remainder ? blockIdx : remainder);

        xGm.SetGlobalBuffer((__gm__ T *)x + blockOffset, blockLength);
        yGm.SetGlobalBuffer((__gm__ T *)y + blockOffset, blockLength);
        zGm.SetGlobalBuffer((__gm__ T *)z + blockOffset, blockLength);

        pipe.InitBuffer(inQueueX, BUFFER_NUM, TILE_LENGTH * sizeof(T));
        pipe.InitBuffer(inQueueY, BUFFER_NUM, TILE_LENGTH * sizeof(T));
        pipe.InitBuffer(outQueueZ, BUFFER_NUM, TILE_LENGTH * sizeof(T));
    }

    __aicore__ inline void Process()
    {
        for (uint32_t offset = 0; offset < blockLength; offset += TILE_LENGTH) {
            const uint32_t length = (blockLength - offset < TILE_LENGTH) ? blockLength - offset : TILE_LENGTH;
            CopyIn(offset, length);
            Compute(length);
            CopyOut(offset, length);
        }
    }

private:
    __aicore__ inline void CopyIn(uint32_t offset, uint32_t length)
    {
        LocalTensor<T> xLocal = inQueueX.AllocTensor<T>();
        LocalTensor<T> yLocal = inQueueY.AllocTensor<T>();
        DataCopy(xLocal, xGm[offset], length);
        DataCopy(yLocal, yGm[offset], length);
        inQueueX.EnQue(xLocal);
        inQueueY.EnQue(yLocal);
    }

    __aicore__ inline void Compute(uint32_t length)
    {
        LocalTensor<T> xLocal = inQueueX.DeQue<T>();
        LocalTensor<T> yLocal = inQueueY.DeQue<T>();
        LocalTensor<T> zLocal = outQueueZ.AllocTensor<T>();
        Sub(zLocal, xLocal, yLocal, length);
        outQueueZ.EnQue(zLocal);
        inQueueX.FreeTensor(xLocal);
        inQueueY.FreeTensor(yLocal);
    }

    __aicore__ inline void CopyOut(uint32_t offset, uint32_t length)
    {
        LocalTensor<T> zLocal = outQueueZ.DeQue<T>();
        DataCopy(zGm[offset], zLocal, length);
        outQueueZ.FreeTensor(zLocal);
    }

    TPipe pipe;
    TQue<TPosition::VECIN, BUFFER_NUM> inQueueX;
    TQue<TPosition::VECIN, BUFFER_NUM> inQueueY;
    TQue<TPosition::VECOUT, BUFFER_NUM> outQueueZ;
    GlobalTensor<T> xGm;
    GlobalTensor<T> yGm;
    GlobalTensor<T> zGm;
    uint32_t blockLength = 0;
    uint32_t blockOffset = 0;
};

__global__ __vector__ void sub_custom(GM_ADDR x, GM_ADDR y, GM_ADDR z, uint32_t totalLength)
{
    KernelSub<float> op;
    op.Init(x, y, z, totalLength);
    op.Process();
}

__global__ __vector__ void sub_custom_fp16(GM_ADDR x, GM_ADDR y, GM_ADDR z, uint32_t totalLength)
{
    KernelSub<half> op;
    op.Init(x, y, z, totalLength);
    op.Process();
}

extern "C" void run_kernel(GM_ADDR x, const TensorGroupInfo& info_x, GM_ADDR y, const TensorGroupInfo& info_y, GM_ADDR z, const TensorGroupInfo& info_z, int64_t availableCoreNum, aclrtStream stream)
{
    uint32_t totalLength = 1;
    for (int64_t i = 0; i < info_x.tensors[0].numDims; ++i) {
        totalLength *= static_cast<uint32_t>(info_x.tensors[0].shape[i]);
    }

    uint32_t blockNum = static_cast<uint32_t>(availableCoreNum);
    if (blockNum > MAX_BLOCK_NUM) {
        blockNum = MAX_BLOCK_NUM;
    }
    const uint32_t usefulBlockNum = (totalLength + TILE_LENGTH - 1) / TILE_LENGTH;
    if (blockNum > usefulBlockNum) {
        blockNum = usefulBlockNum;
    }

    if (info_x.tensors[0].dtype == 1) {
        sub_custom_fp16<<<blockNum, nullptr, stream>>>(x, y, z, totalLength);
    } else {
        sub_custom<<<blockNum, nullptr, stream>>>(x, y, z, totalLength);
    }
}
