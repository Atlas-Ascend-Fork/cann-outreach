#include "kernel_operator.h"

constexpr uint32_t SUB_TOTAL_LENGTH = 8 * 2048;
constexpr uint32_t SUB_TILE_LENGTH = 256;
constexpr uint32_t SUB_TILE_COUNT = SUB_TOTAL_LENGTH / SUB_TILE_LENGTH;

template <typename T>
class KernelSub {
public:
    __aicore__ inline void Init(GM_ADDR x, GM_ADDR y, GM_ADDR z)
    {
        xGm.SetGlobalBuffer((__gm__ T*)x, SUB_TOTAL_LENGTH);
        yGm.SetGlobalBuffer((__gm__ T*)y, SUB_TOTAL_LENGTH);
        zGm.SetGlobalBuffer((__gm__ T*)z, SUB_TOTAL_LENGTH);

        pipe.InitBuffer(xQueue, 1, SUB_TILE_LENGTH * sizeof(T));
        pipe.InitBuffer(yQueue, 1, SUB_TILE_LENGTH * sizeof(T));
        pipe.InitBuffer(zQueue, 1, SUB_TILE_LENGTH * sizeof(T));
    }

    __aicore__ inline void Process()
    {
        for (uint32_t tile = AscendC::GetBlockIdx();
             tile < SUB_TILE_COUNT;
             tile += AscendC::GetBlockNum()) {
            const uint32_t offset = tile * SUB_TILE_LENGTH;

            AscendC::LocalTensor<T> xLocal = xQueue.AllocTensor<T>();
            AscendC::LocalTensor<T> yLocal = yQueue.AllocTensor<T>();

            AscendC::DataCopy(xLocal, xGm[offset], SUB_TILE_LENGTH);
            AscendC::DataCopy(yLocal, yGm[offset], SUB_TILE_LENGTH);

            xQueue.EnQue(xLocal);
            yQueue.EnQue(yLocal);

            xLocal = xQueue.DeQue<T>();
            yLocal = yQueue.DeQue<T>();

            AscendC::LocalTensor<T> zLocal = zQueue.AllocTensor<T>();
            AscendC::Sub(zLocal, xLocal, yLocal, SUB_TILE_LENGTH);

            zQueue.EnQue(zLocal);
            xQueue.FreeTensor(xLocal);
            yQueue.FreeTensor(yLocal);

            zLocal = zQueue.DeQue<T>();
            AscendC::DataCopy(zGm[offset], zLocal, SUB_TILE_LENGTH);
            zQueue.FreeTensor(zLocal);
        }
    }

private:
    AscendC::TPipe pipe;
    AscendC::TQue<AscendC::QuePosition::VECIN, 1> xQueue, yQueue;
    AscendC::TQue<AscendC::QuePosition::VECOUT, 1> zQueue;
    AscendC::GlobalTensor<T> xGm, yGm, zGm;
};

template <typename T>
__global__ __vector__ void sub_custom(GM_ADDR x, GM_ADDR y, GM_ADDR z)
{
    KernelSub<T> op;
    op.Init(x, y, z);
    op.Process();
}

extern "C" void run_kernel(
    GM_ADDR x, const TensorGroupInfo& info_x,
    GM_ADDR y, const TensorGroupInfo& info_y,
    GM_ADDR z, const TensorGroupInfo& info_z,
    int64_t availableCoreNum, aclrtStream stream)
{
    if (availableCoreNum <= 0) {
        return;
    }

    const uint32_t blockNum = availableCoreNum < SUB_TILE_COUNT
        ? static_cast<uint32_t>(availableCoreNum)
        : SUB_TILE_COUNT;

    if (info_x.tensors[0].dtype == 0) {
        sub_custom<float><<<blockNum, nullptr, stream>>>(x, y, z);
    } else if (info_x.tensors[0].dtype == 1) {
        sub_custom<half><<<blockNum, nullptr, stream>>>(x, y, z);
    }
}