#include "kernel_operator.h"

constexpr uint32_t kSubRows = 8;
constexpr uint32_t kSubCols = 2048;

template <typename T>
__global__ __vector__ void sub_custom(GM_ADDR x, GM_ADDR y, GM_ADDR z)
{
    AscendC::TPipe pipe;
    AscendC::TQue<AscendC::TPosition::VECIN, 1> xQueue, yQueue;
    AscendC::TQue<AscendC::TPosition::VECOUT, 1> zQueue;
    pipe.InitBuffer(xQueue, 1, kSubCols * sizeof(T));
    pipe.InitBuffer(yQueue, 1, kSubCols * sizeof(T));
    pipe.InitBuffer(zQueue, 1, kSubCols * sizeof(T));

    AscendC::GlobalTensor<T> xGm, yGm, zGm;
    xGm.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(x), kSubRows * kSubCols);
    yGm.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(y), kSubRows * kSubCols);
    zGm.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(z), kSubRows * kSubCols);

    // Each block handles whole rows, including any extra rows when fewer than 8 cores run.
    const uint32_t blockCount = AscendC::GetBlockNum();
    for (uint32_t row = AscendC::GetBlockIdx(); row < kSubRows; row += blockCount) {
        const uint32_t offset = row * kSubCols;
        auto xLocal = xQueue.AllocTensor<T>();
        auto yLocal = yQueue.AllocTensor<T>();
        AscendC::DataCopy(xLocal, xGm[offset], kSubCols);
        AscendC::DataCopy(yLocal, yGm[offset], kSubCols);
        xQueue.EnQue(xLocal);
        yQueue.EnQue(yLocal);

        auto xInput = xQueue.DeQue<T>();
        auto yInput = yQueue.DeQue<T>();
        auto zLocal = zQueue.AllocTensor<T>();
        AscendC::Sub(zLocal, xInput, yInput, kSubCols);
        zQueue.EnQue(zLocal);
        xQueue.FreeTensor(xInput);
        yQueue.FreeTensor(yInput);

        auto zOutput = zQueue.DeQue<T>();
        AscendC::DataCopy(zGm[offset], zOutput, kSubCols);
        zQueue.FreeTensor(zOutput);
    }
}

extern "C" void run_kernel(GM_ADDR x, const TensorGroupInfo& info_x,
                           GM_ADDR y, const TensorGroupInfo& info_y,
                           GM_ADDR z, const TensorGroupInfo& info_z,
                           int64_t availableCoreNum, aclrtStream stream)
{
    if (availableCoreNum <= 0) {
        return;
    }
    const uint32_t blocks = availableCoreNum < kSubRows
                                ? static_cast<uint32_t>(availableCoreNum) : kSubRows;
    const int32_t dtype = info_x.tensors[0].dtype;
    if (dtype != info_y.tensors[0].dtype || dtype != info_z.tensors[0].dtype) {
        return;
    }
    if (dtype == 0) {
        sub_custom<float><<<blocks, nullptr, stream>>>(x, y, z);
    } else if (dtype == 1) {
        sub_custom<half><<<blocks, nullptr, stream>>>(x, y, z);
    }
}
