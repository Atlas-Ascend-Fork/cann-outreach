#include <cmath>
#include "kernel_operator.h"

/*
 * Sub Kernel - Ascend C Direct Invocation
 * z = x - y, shape (8, 2048), dtype fp32 / fp16
 */

constexpr int32_t TOTAL_LENGTH = 8 * 2048;
constexpr int32_t BLOCK_NUM = 8;
constexpr int32_t BLOCK_LENGTH = TOTAL_LENGTH / BLOCK_NUM;

template <typename T>
class KernelSub {
public:
    __aicore__ inline KernelSub() {}
    __aicore__ inline void Init(GM_ADDR x, GM_ADDR y, GM_ADDR z, AscendC::TPipe* pipe) {
        xGm.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(x) + BLOCK_LENGTH * AscendC::GetBlockIdx(), BLOCK_LENGTH);
        yGm.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(y) + BLOCK_LENGTH * AscendC::GetBlockIdx(), BLOCK_LENGTH);
        zGm.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(z) + BLOCK_LENGTH * AscendC::GetBlockIdx(), BLOCK_LENGTH);
        pipe->InitBuffer(inQueueX, 1, BLOCK_LENGTH * sizeof(T));
        pipe->InitBuffer(inQueueY, 1, BLOCK_LENGTH * sizeof(T));
        pipe->InitBuffer(outQueueZ, 1, BLOCK_LENGTH * sizeof(T));
    }
    __aicore__ inline void Process() {
        CopyIn();
        Compute();
        CopyOut();
    }
private:
    __aicore__ inline void CopyIn() {
        AscendC::LocalTensor<T> xLocal = inQueueX.template AllocTensor<T>();
        AscendC::LocalTensor<T> yLocal = inQueueY.template AllocTensor<T>();
        AscendC::DataCopy(xLocal, xGm, BLOCK_LENGTH);
        AscendC::DataCopy(yLocal, yGm, BLOCK_LENGTH);
        inQueueX.EnQue(xLocal);
        inQueueY.EnQue(yLocal);
    }
    __aicore__ inline void Compute() {
        AscendC::LocalTensor<T> xLocal = inQueueX.template DeQue<T>();
        AscendC::LocalTensor<T> yLocal = inQueueY.template DeQue<T>();
        AscendC::LocalTensor<T> zLocal = outQueueZ.template AllocTensor<T>();
        AscendC::Sub(zLocal, xLocal, yLocal, BLOCK_LENGTH);
        outQueueZ.EnQue(zLocal);
        inQueueX.FreeTensor(xLocal);
        inQueueY.FreeTensor(yLocal);
    }
    __aicore__ inline void CopyOut() {
        AscendC::LocalTensor<T> zLocal = outQueueZ.template DeQue<T>();
        AscendC::DataCopy(zGm, zLocal, BLOCK_LENGTH);
        outQueueZ.FreeTensor(zLocal);
    }
private:
    AscendC::TQue<AscendC::TPosition::VECIN, 1> inQueueX;
    AscendC::TQue<AscendC::TPosition::VECIN, 1> inQueueY;
    AscendC::TQue<AscendC::TPosition::VECOUT, 1> outQueueZ;
    AscendC::GlobalTensor<T> xGm;
    AscendC::GlobalTensor<T> yGm;
    AscendC::GlobalTensor<T> zGm;
};

template <typename T>
__global__ __vector__ void sub_custom(GM_ADDR x, GM_ADDR y, GM_ADDR z) {
    AscendC::TPipe pipe;
    KernelSub<T> op;
    op.Init(x, y, z, &pipe);
    op.Process();
}

extern "C" void run_kernel(GM_ADDR x, const TensorGroupInfo& info_x, GM_ADDR y, const TensorGroupInfo& info_y, GM_ADDR z, const TensorGroupInfo& info_z, int64_t availableCoreNum, aclrtStream stream)
{
    int32_t dtype = info_x.tensors[0].dtype;
    if (dtype == 1) {
        sub_custom<half><<<BLOCK_NUM, nullptr, stream>>>(x, y, z);
    } else {
        sub_custom<float><<<BLOCK_NUM, nullptr, stream>>>(x, y, z);
    }
}