#include <cmath>
#include "kernel_operator.h"

constexpr uint32_t SUB_TILE_LENGTH = 1024;

template <typename T>
class HomeworkSubKernel {
public:
    __aicore__ inline HomeworkSubKernel() {}

    __aicore__ inline void Init(GM_ADDR x, GM_ADDR y, GM_ADDR z,
                               uint32_t totalLength)
    {
        blockLength_ = totalLength / AscendC::GetBlockNum();
        uint32_t start = blockLength_ * AscendC::GetBlockIdx();

        xGm_.SetGlobalBuffer((__gm__ T*)x + start, blockLength_);
        yGm_.SetGlobalBuffer((__gm__ T*)y + start, blockLength_);
        zGm_.SetGlobalBuffer((__gm__ T*)z + start, blockLength_);

        pipe_.InitBuffer(xQueue_, 1, SUB_TILE_LENGTH * sizeof(T));
        pipe_.InitBuffer(yQueue_, 1, SUB_TILE_LENGTH * sizeof(T));
        pipe_.InitBuffer(zQueue_, 1, SUB_TILE_LENGTH * sizeof(T));
    }

    __aicore__ inline void Process()
    {
        for (uint32_t offset = 0; offset < blockLength_;
             offset += SUB_TILE_LENGTH) {
            CopyIn(offset);
            Compute();
            CopyOut(offset);
        }
    }

private:
    __aicore__ inline void CopyIn(uint32_t offset)
    {
        AscendC::LocalTensor<T> xLocal = xQueue_.AllocTensor<T>();
        AscendC::LocalTensor<T> yLocal = yQueue_.AllocTensor<T>();
        AscendC::DataCopy(xLocal, xGm_[offset], SUB_TILE_LENGTH);
        AscendC::DataCopy(yLocal, yGm_[offset], SUB_TILE_LENGTH);
        xQueue_.EnQue(xLocal);
        yQueue_.EnQue(yLocal);
    }

    __aicore__ inline void Compute()
    {
        AscendC::LocalTensor<T> xLocal = xQueue_.DeQue<T>();
        AscendC::LocalTensor<T> yLocal = yQueue_.DeQue<T>();
        AscendC::LocalTensor<T> zLocal = zQueue_.AllocTensor<T>();

        AscendC::Sub(zLocal, xLocal, yLocal, SUB_TILE_LENGTH);

        zQueue_.EnQue(zLocal);
        xQueue_.FreeTensor(xLocal);
        yQueue_.FreeTensor(yLocal);
    }

    __aicore__ inline void CopyOut(uint32_t offset)
    {
        AscendC::LocalTensor<T> zLocal = zQueue_.DeQue<T>();
        AscendC::DataCopy(zGm_[offset], zLocal, SUB_TILE_LENGTH);
        zQueue_.FreeTensor(zLocal);
    }

private:
    AscendC::TPipe pipe_;
    AscendC::TQue<AscendC::QuePosition::VECIN, 1> xQueue_, yQueue_;
    AscendC::TQue<AscendC::QuePosition::VECOUT, 1> zQueue_;
    AscendC::GlobalTensor<T> xGm_, yGm_, zGm_;
    uint32_t blockLength_;
};

template <typename T>
__global__ __aicore__ __vector__ void sub_custom(
    GM_ADDR x, GM_ADDR y, GM_ADDR z, uint32_t totalLength)
{
    HomeworkSubKernel<T> op;
    op.Init(x, y, z, totalLength);
    op.Process();
}

extern "C" void run_kernel(
    GM_ADDR x, const TensorGroupInfo& info_x,
    GM_ADDR y, const TensorGroupInfo& info_y,
    GM_ADDR z, const TensorGroupInfo& info_z,
    int64_t availableCoreNum, aclrtStream stream)
{
    uint32_t totalLength = 1;
    for (int64_t i = 0; i < info_x.tensors[0].numDims; ++i) {
        totalLength *= static_cast<uint32_t>(info_x.tensors[0].shape[i]);
    }

    uint32_t blockNum = 1;
    while (blockNum * 2 <= 8 &&
           static_cast<int64_t>(blockNum * 2) <= availableCoreNum &&
           totalLength % (blockNum * 2 * SUB_TILE_LENGTH) == 0) {
        blockNum *= 2;
    }

    if (info_x.tensors[0].dtype == 0) {
        sub_custom<float><<<blockNum, nullptr, stream>>>(x, y, z, totalLength);
    } else if (info_x.tensors[0].dtype == 1) {
        sub_custom<half><<<blockNum, nullptr, stream>>>(x, y, z, totalLength);
    }
}
