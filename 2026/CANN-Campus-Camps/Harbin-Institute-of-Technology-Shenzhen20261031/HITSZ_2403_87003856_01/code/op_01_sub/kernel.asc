#include <cstdint>
#include "kernel_operator.h"

// Vector subtraction: z = x - y (contiguous ND tensor, fp32/fp16).

using namespace AscendC;

namespace {
constexpr uint32_t TILE_LENGTH = 4096;
constexpr uint32_t BUFFER_NUM = 2;
constexpr uint32_t UB_BLOCK_BYTES = 32;

template <typename T>
class KernelSub {
public:
    __aicore__ inline explicit KernelSub(TPipe* pipe) : pipe_(pipe) {}

    __aicore__ inline void Init(GM_ADDR x, GM_ADDR y, GM_ADDR z,
                                uint32_t totalLength, uint32_t numPerCore)
    {
        uint32_t blockIdx = GetBlockIdx();
        uint64_t offset = static_cast<uint64_t>(blockIdx) * numPerCore;
        if (offset >= totalLength) {
            length_ = 0;
            return;
        }

        uint64_t remaining = static_cast<uint64_t>(totalLength) - offset;
        length_ = remaining < numPerCore ? static_cast<uint32_t>(remaining) : numPerCore;

        xGm_.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(x) + offset, length_);
        yGm_.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(y) + offset, length_);
        zGm_.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(z) + offset, length_);

        pipe_->InitBuffer(inQueueX_, BUFFER_NUM, TILE_LENGTH * sizeof(T));
        pipe_->InitBuffer(inQueueY_, BUFFER_NUM, TILE_LENGTH * sizeof(T));
        pipe_->InitBuffer(outQueueZ_, BUFFER_NUM, TILE_LENGTH * sizeof(T));
    }

    __aicore__ inline void Process()
    {
        uint32_t offset = 0;
        while (offset < length_) {
            uint32_t count = length_ - offset;
            if (count > TILE_LENGTH) {
                count = TILE_LENGTH;
            }
            CopyIn(offset, count);
            Compute(count);
            CopyOut(offset, count);
            offset += count;
        }
    }

private:
    __aicore__ inline void CopyIn(uint32_t offset, uint32_t count)
    {
        LocalTensor<T> xLocal = inQueueX_.template AllocTensor<T>();
        LocalTensor<T> yLocal = inQueueY_.template AllocTensor<T>();

        DataCopyExtParams copyParams{1, static_cast<uint32_t>(count * sizeof(T)), 0, 0, 0};
        DataCopyPadExtParams<T> padParams{false, 0, 0, static_cast<T>(0)};
        DataCopyPad(xLocal, xGm_[offset], copyParams, padParams);
        DataCopyPad(yLocal, yGm_[offset], copyParams, padParams);

        inQueueX_.EnQue(xLocal);
        inQueueY_.EnQue(yLocal);
    }

    __aicore__ inline void Compute(uint32_t count)
    {
        LocalTensor<T> xLocal = inQueueX_.template DeQue<T>();
        LocalTensor<T> yLocal = inQueueY_.template DeQue<T>();
        LocalTensor<T> zLocal = outQueueZ_.template AllocTensor<T>();

        Sub(zLocal, xLocal, yLocal, static_cast<int32_t>(count));

        outQueueZ_.EnQue(zLocal);
        inQueueX_.FreeTensor(xLocal);
        inQueueY_.FreeTensor(yLocal);
    }

    __aicore__ inline void CopyOut(uint32_t offset, uint32_t count)
    {
        LocalTensor<T> zLocal = outQueueZ_.template DeQue<T>();
        DataCopyExtParams copyParams{1, static_cast<uint32_t>(count * sizeof(T)), 0, 0, 0};
        DataCopyPad(zGm_[offset], zLocal, copyParams);
        outQueueZ_.FreeTensor(zLocal);
    }

    TPipe* pipe_;
    GlobalTensor<T> xGm_;
    GlobalTensor<T> yGm_;
    GlobalTensor<T> zGm_;
    TQue<TPosition::VECIN, BUFFER_NUM> inQueueX_;
    TQue<TPosition::VECIN, BUFFER_NUM> inQueueY_;
    TQue<TPosition::VECOUT, BUFFER_NUM> outQueueZ_;
    uint32_t length_{0};
};
} // namespace

template <typename T>
__global__ __vector__ void sub_custom(GM_ADDR x, GM_ADDR y, GM_ADDR z,
                                      uint32_t totalLength, uint32_t numPerCore)
{
    TPipe pipe;
    KernelSub<T> op(&pipe);
    op.Init(x, y, z, totalLength, numPerCore);
    op.Process();
}

extern "C" void run_kernel(GM_ADDR x, const TensorGroupInfo& info_x, GM_ADDR y,
                           const TensorGroupInfo& info_y, GM_ADDR z,
                           const TensorGroupInfo& info_z, int64_t availableCoreNum,
                           aclrtStream stream)
{
    (void)info_y;
    (void)info_z;

    if (info_x.numTensors < 1 || info_x.tensors == nullptr) {
        return;
    }
    const TensorInfo& xInfo = info_x.tensors[0];
    const int32_t dtype = xInfo.dtype;
    if (dtype != 0 && dtype != 1) {
        return;
    }

    if (xInfo.numDims < 0 || (xInfo.numDims > 0 && xInfo.shape == nullptr)) {
        return;
    }

    uint64_t totalLength = 1;
    for (int64_t i = 0; i < xInfo.numDims; ++i) {
        const int64_t dim = xInfo.shape[i];
        if (dim < 0) {
            return;
        }
        totalLength *= static_cast<uint64_t>(dim);
        if (totalLength > 0xFFFFFFFFull) {
            return;
        }
    }
    if (totalLength == 0) {
        return;
    }

    const uint32_t elemBytes = (dtype == 0) ? sizeof(float) : sizeof(half);
    const uint32_t alignElems = UB_BLOCK_BYTES / elemBytes;
    const uint32_t coreNum = (availableCoreNum > 0)
                                 ? static_cast<uint32_t>(availableCoreNum)
                                 : 1U;

    const uint64_t rawPerCore =
        (totalLength + static_cast<uint64_t>(coreNum) - 1) / coreNum;
    const uint64_t alignedPerCore =
        ((rawPerCore + alignElems - 1) / alignElems) * alignElems;
    if (alignedPerCore == 0 || alignedPerCore > 0xFFFFFFFFull) {
        return;
    }
    const uint32_t numPerCore = static_cast<uint32_t>(alignedPerCore);
    const uint32_t blockNum =
        static_cast<uint32_t>((totalLength + numPerCore - 1) / numPerCore);

    if (dtype == 0) {
        sub_custom<float><<<blockNum, nullptr, stream>>>(
            x, y, z, static_cast<uint32_t>(totalLength), numPerCore);
    } else {
        sub_custom<half><<<blockNum, nullptr, stream>>>(
            x, y, z, static_cast<uint32_t>(totalLength), numPerCore);
    }
}

