#include <cstdint>
#include "kernel_operator.h"

namespace {
constexpr uint32_t DMA_BYTES = 32;
// Heuristic starting points; tune on the target device with profiling.
// Restore the original 2048-element/core launch granularity first.
// More cores are not necessarily faster for small, launch-bound inputs.
constexpr uint32_t MIN_CORE_ELEMENTS = 2048;
constexpr uint32_t MAX_TILE_BYTES = 16384;

template <typename T, uint32_t BufferNum>
class SubKernel {
public:
    __aicore__ inline void Init(GM_ADDR x, GM_ADDR y, GM_ADDR z,
                               uint64_t count, uint64_t blocksPerCore,
                               uint32_t extraBlocks, uint32_t tileElements)
    {
        constexpr uint32_t alignElements = DMA_BYTES / sizeof(T);
        const uint32_t core = AscendC::GetBlockIdx();
        const uint64_t startBlock = core * blocksPerCore +
            (core < extraBlocks ? core : extraBlocks);
        const uint64_t coreBlocks = blocksPerCore + (core < extraBlocks ? 1 : 0);
        const uint64_t start = startBlock * alignElements;
        const uint64_t capacity = coreBlocks * alignElements;
        length_ = count - start < capacity ? count - start : capacity;
        tileElements_ = tileElements;
        x_.SetGlobalBuffer((__gm__ T*)x + start, length_);
        y_.SetGlobalBuffer((__gm__ T*)y + start, length_);
        z_.SetGlobalBuffer((__gm__ T*)z + start, length_);
        pipe_.InitBuffer(xQueue_, BufferNum, tileElements * sizeof(T));
        pipe_.InitBuffer(yQueue_, BufferNum, tileElements * sizeof(T));
        pipe_.InitBuffer(zQueue_, BufferNum, tileElements * sizeof(T));
    }

    __aicore__ inline void Process()
    {
        const uint64_t fullTiles = length_ / tileElements_;
        uint64_t offset = 0;
        for (uint64_t i = 0; i < fullTiles; ++i) {
            CopyIn<true>(offset, tileElements_);
            Compute(tileElements_);
            CopyOut<true>(offset, tileElements_);
            offset += tileElements_;
        }
        const uint32_t tail = static_cast<uint32_t>(length_ - offset);
        if (tail != 0) {
            if (tail % (DMA_BYTES / sizeof(T)) == 0) {
                CopyIn<true>(offset, tail);
                Compute(tail);
                CopyOut<true>(offset, tail);
            } else {
                CopyIn<false>(offset, tail);
                Compute(tail);
                CopyOut<false>(offset, tail);
            }
        }
    }

private:
    template <bool Aligned>
    __aicore__ inline void CopyIn(uint64_t offset, uint32_t length)
    {
        auto xLocal = xQueue_.template AllocTensor<T>();
        auto yLocal = yQueue_.template AllocTensor<T>();
        if (Aligned) {
            AscendC::DataCopy(xLocal, x_[offset], length);
            AscendC::DataCopy(yLocal, y_[offset], length);
        } else {
            // Only the last core can have an unaligned end. Never overread GM.
            AscendC::DataCopyExtParams params{1, static_cast<uint32_t>(length * sizeof(T)), 0, 0, 0};
            AscendC::DataCopyPadExtParams<T> pad{false, 0, 0, 0};
            AscendC::DataCopyPad(xLocal, x_[offset], params, pad);
            AscendC::DataCopyPad(yLocal, y_[offset], params, pad);
        }
        xQueue_.EnQue(xLocal);
        yQueue_.EnQue(yLocal);
    }

    __aicore__ inline void Compute(uint32_t length)
    {
        auto xLocal = xQueue_.template DeQue<T>();
        auto yLocal = yQueue_.template DeQue<T>();
        auto zLocal = zQueue_.template AllocTensor<T>();
        AscendC::Sub(zLocal, xLocal, yLocal, length);
        zQueue_.EnQue(zLocal);
        xQueue_.FreeTensor(xLocal);
        yQueue_.FreeTensor(yLocal);
    }

    template <bool Aligned>
    __aicore__ inline void CopyOut(uint64_t offset, uint32_t length)
    {
        auto zLocal = zQueue_.template DeQue<T>();
        if (Aligned) {
            AscendC::DataCopy(z_[offset], zLocal, length);
        } else {
            AscendC::DataCopyExtParams params{1, static_cast<uint32_t>(length * sizeof(T)), 0, 0, 0};
            AscendC::DataCopyPad(z_[offset], zLocal, params);
        }
        zQueue_.FreeTensor(zLocal);
    }

    AscendC::TPipe pipe_;
    AscendC::TQue<AscendC::QuePosition::VECIN, BufferNum> xQueue_, yQueue_;
    AscendC::TQue<AscendC::QuePosition::VECOUT, BufferNum> zQueue_;
    AscendC::GlobalTensor<T> x_, y_, z_;
    uint64_t length_;
    uint32_t tileElements_;
};
} // namespace

// Fixed-shape fast path. Keep core counts independently tunable by dtype.
#ifndef SUB_FIXED_FP32_CORES
#define SUB_FIXED_FP32_CORES 8
#endif
#ifndef SUB_FIXED_FP16_CORES
#define SUB_FIXED_FP16_CORES 8
#endif
static_assert(SUB_FIXED_FP32_CORES == 1 || SUB_FIXED_FP32_CORES == 2 ||
              SUB_FIXED_FP32_CORES == 4 || SUB_FIXED_FP32_CORES == 8 ||
              SUB_FIXED_FP32_CORES == 16 || SUB_FIXED_FP32_CORES == 32,
              "FP32 core count must be a power of two between 1 and 32");
static_assert(SUB_FIXED_FP16_CORES == 1 || SUB_FIXED_FP16_CORES == 2 ||
              SUB_FIXED_FP16_CORES == 4 || SUB_FIXED_FP16_CORES == 8 ||
              SUB_FIXED_FP16_CORES == 16 || SUB_FIXED_FP16_CORES == 32,
              "FP16 core count must be a power of two between 1 and 32");

template <typename T, uint32_t CoreNum>
__global__ __vector__ void sub_fixed(GM_ADDR x, GM_ADDR y, GM_ADDR z)
{
    constexpr uint32_t elements = 16384 / CoreNum;
    const uint32_t offset = AscendC::GetBlockIdx() * elements;
    AscendC::GlobalTensor<T> xGm, yGm, zGm;
    xGm.SetGlobalBuffer((__gm__ T*)x + offset, elements);
    yGm.SetGlobalBuffer((__gm__ T*)y + offset, elements);
    zGm.SetGlobalBuffer((__gm__ T*)z + offset, elements);

    AscendC::TPipe pipe;
    AscendC::TBuf<AscendC::QuePosition::VECCALC> buffer;
    pipe.InitBuffer(buffer, 3 * elements * sizeof(T));
    auto xLocal = buffer.Get<T>();
    auto yLocal = xLocal[elements];
    auto zLocal = xLocal[2 * elements];

    AscendC::DataCopy(xLocal, xGm, elements);
    AscendC::DataCopy(yLocal, yGm, elements);
    // Both inputs must arrive before the vector instruction reads UB.
    const auto inputReady = pipe.FetchEventID(AscendC::HardEvent::MTE2_V);
    AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(inputReady);
    AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(inputReady);

    AscendC::Sub(zLocal, xLocal, yLocal, elements);
    const auto outputReady = pipe.FetchEventID(AscendC::HardEvent::V_MTE3);
    AscendC::SetFlag<AscendC::HardEvent::V_MTE3>(outputReady);
    AscendC::WaitFlag<AscendC::HardEvent::V_MTE3>(outputReady);
    AscendC::DataCopy(zGm, zLocal, elements);
    // No buffer reuse: no reverse-direction synchronization is needed.
}

template <typename T, uint32_t BufferNum>
__global__ __vector__ void sub_custom(GM_ADDR x, GM_ADDR y, GM_ADDR z,
                                    uint64_t count, uint64_t blocksPerCore,
                                    uint32_t extraBlocks, uint32_t tileElements)
{
    SubKernel<T, BufferNum> kernel;
    kernel.Init(x, y, z, count, blocksPerCore, extraBlocks, tileElements);
    kernel.Process();
}

template <typename T>
static inline void LaunchSub(GM_ADDR x, GM_ADDR y, GM_ADDR z, uint64_t count,
                             int64_t availableCoreNum, aclrtStream stream)
{
    constexpr uint32_t alignElements = DMA_BYTES / sizeof(T);
    constexpr uint32_t minCoreElements = MIN_CORE_ELEMENTS;
    constexpr uint32_t maxTileBlocks = MAX_TILE_BYTES / DMA_BYTES;
    const uint64_t desiredCores = (count - 1) / minCoreElements + 1;
    const uint32_t blockNum = static_cast<uint32_t>(
        desiredCores < static_cast<uint64_t>(availableCoreNum) ? desiredCores : availableCoreNum);
    const uint64_t totalBlocks = (count - 1) / alignElements + 1;
    const uint64_t blocksPerCore = totalBlocks / blockNum;
    const uint32_t extraBlocks = static_cast<uint32_t>(totalBlocks % blockNum);
    const uint64_t largestCoreBlocks = blocksPerCore + (extraBlocks != 0 ? 1 : 0);
    const uint32_t tileElements = static_cast<uint32_t>(
        largestCoreBlocks < maxTileBlocks ? largestCoreBlocks : maxTileBlocks) * alignElements;

    if (largestCoreBlocks <= maxTileBlocks) {
        sub_custom<T, 1><<<blockNum, nullptr, stream>>>(
            x, y, z, count, blocksPerCore, extraBlocks, tileElements);
    } else {
        // At most 3 * 2 * 16 KiB = 96 KiB of queue buffers.
        sub_custom<T, 2><<<blockNum, nullptr, stream>>>(
            x, y, z, count, blocksPerCore, extraBlocks, tileElements);
    }
}

extern "C" void run_kernel(GM_ADDR x, const TensorGroupInfo& info_x,
                           GM_ADDR y, const TensorGroupInfo& info_y,
                           GM_ADDR z, const TensorGroupInfo& info_z,
                           int64_t availableCoreNum, aclrtStream stream)
{
    // As in the original kernel: contiguous, same-shape operands; no broadcasting.
    const auto& tx = info_x.tensors[0];
    uint64_t count = 1;
    for (int64_t i = 0; i < tx.numDims; ++i) {
        count *= static_cast<uint64_t>(tx.shape[i]);
    }
    if (count == 0 || availableCoreNum <= 0) {
        return;
    }
    if (count == 16384) {
        if (tx.dtype == 0 && availableCoreNum >= SUB_FIXED_FP32_CORES) {
            sub_fixed<float, SUB_FIXED_FP32_CORES>
                <<<SUB_FIXED_FP32_CORES, nullptr, stream>>>(x, y, z);
            return;
        }
        if (tx.dtype == 1 && availableCoreNum >= SUB_FIXED_FP16_CORES) {
            sub_fixed<half, SUB_FIXED_FP16_CORES>
                <<<SUB_FIXED_FP16_CORES, nullptr, stream>>>(x, y, z);
            return;
        }
    }
    if (tx.dtype == 0) {
        LaunchSub<float>(x, y, z, count, availableCoreNum, stream);
    } else if (tx.dtype == 5) {
        LaunchSub<int32_t>(x, y, z, count, availableCoreNum, stream);
    } else {
        LaunchSub<half>(x, y, z, count, availableCoreNum, stream);
    }
}
