#include <cmath>
#include "kernel_operator.h"

template <typename DataType, uint32_t CoreCount>
class KernelSub {
public:
    __aicore__ inline void Init(GM_ADDR x, GM_ADDR y, GM_ADDR z)
    {
        const uint32_t offset = AscendC::GetBlockIdx() * BLOCK_LENGTH;
        xGm.SetGlobalBuffer((__gm__ DataType*)x + offset, BLOCK_LENGTH);
        yGm.SetGlobalBuffer((__gm__ DataType*)y + offset, BLOCK_LENGTH);
        zGm.SetGlobalBuffer((__gm__ DataType*)z + offset, BLOCK_LENGTH);

        pipe.InitBuffer(inQueueXY, 1, XY_LENGTH * sizeof(DataType));
        pipe.InitBuffer(outQueueZ, 1, TILE_LENGTH * sizeof(DataType));
    }

    __aicore__ inline void Process()
    {
        for (uint32_t offset = 0; offset < BLOCK_LENGTH;
             offset += TILE_LENGTH) {
            CopyIn(offset);
            Compute();
            CopyOut(offset);
        }
    }

private:
    __aicore__ inline void CopyIn(uint32_t offset)
    {
        AscendC::LocalTensor<DataType> xyLocal =
            inQueueXY.AllocTensor<DataType>();

        AscendC::DataCopy(xyLocal, xGm[offset], TILE_LENGTH);
        AscendC::DataCopy(xyLocal[TILE_LENGTH], yGm[offset], TILE_LENGTH);
        inQueueXY.EnQue(xyLocal);
    }

    __aicore__ inline void Compute()
    {
        AscendC::LocalTensor<DataType> xyLocal =
            inQueueXY.DeQue<DataType>();
        AscendC::LocalTensor<DataType> zLocal =
            outQueueZ.AllocTensor<DataType>();

        AscendC::Sub(zLocal, xyLocal, xyLocal[TILE_LENGTH], TILE_LENGTH);
        outQueueZ.EnQue(zLocal);
        inQueueXY.FreeTensor(xyLocal);
    }

    __aicore__ inline void CopyOut(uint32_t offset)
    {
        AscendC::LocalTensor<DataType> zLocal =
            outQueueZ.DeQue<DataType>();
        AscendC::DataCopy(zGm[offset], zLocal, TILE_LENGTH);
        outQueueZ.FreeTensor(zLocal);
    }

    static constexpr uint32_t TOTAL_LENGTH = 8 * 2048;
    static constexpr uint32_t BLOCK_LENGTH = TOTAL_LENGTH / CoreCount;
    static constexpr uint32_t TILE_LENGTH =
        BLOCK_LENGTH < 8192 ? BLOCK_LENGTH : 8192;
    static constexpr uint32_t XY_LENGTH = 2 * TILE_LENGTH;

    AscendC::TPipe pipe;
    AscendC::TQue<AscendC::TPosition::VECIN, 1> inQueueXY;
    AscendC::TQue<AscendC::TPosition::VECOUT, 1> outQueueZ;
    AscendC::GlobalTensor<DataType> xGm;
    AscendC::GlobalTensor<DataType> yGm;
    AscendC::GlobalTensor<DataType> zGm;
};

template <typename DataType, uint32_t CoreCount>
__global__ __vector__ void sub_custom(GM_ADDR x, GM_ADDR y, GM_ADDR z)
{
    KernelSub<DataType, CoreCount> kernel;
    kernel.Init(x, y, z);
    kernel.Process();
}

template <typename DataType>
inline void LaunchSub(GM_ADDR x, GM_ADDR y, GM_ADDR z,
                      int64_t availableCoreNum, aclrtStream stream)
{
    if (availableCoreNum >= 8) {
        sub_custom<DataType, 8><<<8, nullptr, stream>>>(x, y, z);
    } else if (availableCoreNum >= 4) {
        sub_custom<DataType, 4><<<4, nullptr, stream>>>(x, y, z);
    } else if (availableCoreNum >= 2) {
        sub_custom<DataType, 2><<<2, nullptr, stream>>>(x, y, z);
    } else {
        sub_custom<DataType, 1><<<1, nullptr, stream>>>(x, y, z);
    }
}

extern "C" void run_kernel(GM_ADDR x, const TensorGroupInfo& info_x, GM_ADDR y, const TensorGroupInfo& info_y, GM_ADDR z, const TensorGroupInfo& info_z, int64_t availableCoreNum, aclrtStream stream)
{
    (void)info_y;
    (void)info_z;

    if (info_x.tensors[0].dtype == 0) {
        LaunchSub<float>(x, y, z, availableCoreNum, stream);
    } else if (info_x.tensors[0].dtype == 1) {
        LaunchSub<half>(x, y, z, availableCoreNum, stream);
    }
}
