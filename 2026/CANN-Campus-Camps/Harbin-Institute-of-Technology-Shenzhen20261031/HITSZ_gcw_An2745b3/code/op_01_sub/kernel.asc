#include <cstdint>
#include "kernel_operator.h"

// Elementwise subtraction: z = x - y, shape [8, 2048].
// Only this file is #included from main.asc; no main() here.
namespace {
constexpr uint32_t TOTAL_ELEMENTS = 8U * 2048U;
constexpr uint32_t TILE_ELEMENTS = 2048U;

template <typename T>
class KernelSub {
public:
    __aicore__ inline void Init(GM_ADDR x, GM_ADDR y, GM_ADDR z,
                                uint32_t elementsPerCore, AscendC::TPipe *pipe)
    {
        this->elementsPerCore = elementsPerCore;
        const uint32_t base = AscendC::GetBlockIdx() * elementsPerCore;
        xGm.SetGlobalBuffer((__gm__ T *)x + base, elementsPerCore);
        yGm.SetGlobalBuffer((__gm__ T *)y + base, elementsPerCore);
        zGm.SetGlobalBuffer((__gm__ T *)z + base, elementsPerCore);
        pipe->InitBuffer(xQueue, 1, TILE_ELEMENTS * sizeof(T));
        pipe->InitBuffer(yQueue, 1, TILE_ELEMENTS * sizeof(T));
        pipe->InitBuffer(zQueue, 1, TILE_ELEMENTS * sizeof(T));
    }

    __aicore__ inline void Process()
    {
        const uint32_t tiles = elementsPerCore / TILE_ELEMENTS;
        for (uint32_t i = 0; i < tiles; ++i) {
            const uint32_t offset = i * TILE_ELEMENTS;
            CopyIn(offset);
            Compute();
            CopyOut(offset);
        }
    }

private:
    __aicore__ inline void CopyIn(uint32_t offset)
    {
        AscendC::LocalTensor<T> xLocal = xQueue.AllocTensor<T>();
        AscendC::LocalTensor<T> yLocal = yQueue.AllocTensor<T>();
        AscendC::DataCopy(xLocal, xGm[offset], TILE_ELEMENTS);
        AscendC::DataCopy(yLocal, yGm[offset], TILE_ELEMENTS);
        xQueue.EnQue(xLocal);
        yQueue.EnQue(yLocal);
    }

    __aicore__ inline void Compute()
    {
        AscendC::LocalTensor<T> xLocal = xQueue.DeQue<T>();
        AscendC::LocalTensor<T> yLocal = yQueue.DeQue<T>();
        AscendC::LocalTensor<T> zLocal = zQueue.AllocTensor<T>();
        AscendC::Sub(zLocal, xLocal, yLocal, TILE_ELEMENTS);
        zQueue.EnQue(zLocal);
        xQueue.FreeTensor(xLocal);
        yQueue.FreeTensor(yLocal);
    }

    __aicore__ inline void CopyOut(uint32_t offset)
    {
        AscendC::LocalTensor<T> zLocal = zQueue.DeQue<T>();
        AscendC::DataCopy(zGm[offset], zLocal, TILE_ELEMENTS);
        zQueue.FreeTensor(zLocal);
    }

    AscendC::GlobalTensor<T> xGm;
    AscendC::GlobalTensor<T> yGm;
    AscendC::GlobalTensor<T> zGm;
    AscendC::TQue<AscendC::TPosition::VECIN, 1> xQueue;
    AscendC::TQue<AscendC::TPosition::VECIN, 1> yQueue;
    AscendC::TQue<AscendC::TPosition::VECOUT, 1> zQueue;
    uint32_t elementsPerCore = 0;
};
} // namespace

extern "C" __global__ __vector__ void sub_custom_fp32(
    GM_ADDR x, GM_ADDR y, GM_ADDR z, uint32_t elementsPerCore)
{
    AscendC::TPipe pipe;
    KernelSub<float> op;
    op.Init(x, y, z, elementsPerCore, &pipe);
    op.Process();
}

extern "C" __global__ __vector__ void sub_custom_fp16(
    GM_ADDR x, GM_ADDR y, GM_ADDR z, uint32_t elementsPerCore)
{
    AscendC::TPipe pipe;
    KernelSub<half> op;
    op.Init(x, y, z, elementsPerCore, &pipe);
    op.Process();
}

extern "C" void run_kernel(GM_ADDR x, const TensorGroupInfo& info_x,
                            GM_ADDR y, const TensorGroupInfo& info_y,
                            GM_ADDR z, const TensorGroupInfo& info_z,
                            int64_t availableCoreNum, aclrtStream stream)
{
    // Choose a divisor of 8 to keep per-core work and tile size aligned.
    const uint32_t blockNum = availableCoreNum >= 8 ? 8U :
                              availableCoreNum >= 4 ? 4U :
                              availableCoreNum >= 2 ? 2U : 1U;
    const uint32_t elementsPerCore = TOTAL_ELEMENTS / blockNum;
    if (info_x.tensors[0].dtype == 1) { // float16
        sub_custom_fp16<<<blockNum, 0, stream>>>(x, y, z, elementsPerCore);
    } else { // float32 (dtype == 0)
        sub_custom_fp32<<<blockNum, 0, stream>>>(x, y, z, elementsPerCore);
    }
}
