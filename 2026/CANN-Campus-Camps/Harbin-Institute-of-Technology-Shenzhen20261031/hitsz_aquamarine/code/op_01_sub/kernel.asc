#include <cmath>
#include "kernel_operator.h"

struct SubCustomTilingData {
    uint32_t totalLength;
    uint32_t tileNum;
};

constexpr uint32_t kBufferNum = 2;
constexpr uint32_t kQueueDepth = 1;

template <typename T>
class KernelSub {
public:
    __aicore__ inline void Init(GM_ADDR x, GM_ADDR y, GM_ADDR z,
                                const SubCustomTilingData &tiling)
    {
        const uint32_t blockLength = tiling.totalLength / AscendC::GetBlockNum();
        tileNum_ = tiling.tileNum;
        tileLength_ = blockLength / tileNum_ / kBufferNum;

        const uint32_t blockOffset = blockLength * AscendC::GetBlockIdx();
        x_.SetGlobalBuffer(reinterpret_cast<__gm__ T *>(x) + blockOffset, blockLength);
        y_.SetGlobalBuffer(reinterpret_cast<__gm__ T *>(y) + blockOffset, blockLength);
        z_.SetGlobalBuffer(reinterpret_cast<__gm__ T *>(z) + blockOffset, blockLength);

        pipe_.InitBuffer(inX_, kBufferNum, tileLength_ * sizeof(T));
        pipe_.InitBuffer(inY_, kBufferNum, tileLength_ * sizeof(T));
        pipe_.InitBuffer(outZ_, kBufferNum, tileLength_ * sizeof(T));
    }

    __aicore__ inline void Process()
    {
        const uint32_t loopCount = tileNum_ * kBufferNum;
        for (uint32_t i = 0; i < loopCount; ++i) {
            auto xLocal = inX_.AllocTensor<T>();
            auto yLocal = inY_.AllocTensor<T>();
            AscendC::DataCopy(xLocal, x_[i * tileLength_], tileLength_);
            AscendC::DataCopy(yLocal, y_[i * tileLength_], tileLength_);
            inX_.EnQue(xLocal);
            inY_.EnQue(yLocal);

            xLocal = inX_.DeQue<T>();
            yLocal = inY_.DeQue<T>();
            auto zLocal = outZ_.AllocTensor<T>();
            AscendC::Sub(zLocal, xLocal, yLocal, tileLength_);
            outZ_.EnQue(zLocal);
            inX_.FreeTensor(xLocal);
            inY_.FreeTensor(yLocal);

            zLocal = outZ_.DeQue<T>();
            AscendC::DataCopy(z_[i * tileLength_], zLocal, tileLength_);
            outZ_.FreeTensor(zLocal);
        }
    }

private:
    AscendC::TPipe pipe_;
    AscendC::TQue<AscendC::QuePosition::VECIN, kQueueDepth> inX_;
    AscendC::TQue<AscendC::QuePosition::VECIN, kQueueDepth> inY_;
    AscendC::TQue<AscendC::QuePosition::VECOUT, kQueueDepth> outZ_;
    AscendC::GlobalTensor<T> x_, y_, z_;
    uint32_t tileNum_ = 0;
    uint32_t tileLength_ = 0;
};

template <typename T>
__global__ __vector__ void sub_custom(GM_ADDR x, GM_ADDR y, GM_ADDR z,
                                      SubCustomTilingData tiling)
{
    KernelSub<T> op;
    op.Init(x, y, z, tiling);
    op.Process();
}

extern "C" void run_kernel(GM_ADDR x, const TensorGroupInfo &info_x,
                            GM_ADDR y, const TensorGroupInfo &, GM_ADDR z,
                            const TensorGroupInfo &, int64_t, aclrtStream stream)
{
    const TensorInfo &tensor = info_x.tensors[0];
    uint64_t totalLength = 1;
    for (int64_t i = 0; i < tensor.numDims; ++i) {
        totalLength *= static_cast<uint64_t>(tensor.shape[i]);
    }

    constexpr uint32_t blockDim = 8;
    constexpr uint32_t tileNum = 8;
    const SubCustomTilingData tiling{static_cast<uint32_t>(totalLength), tileNum};
    if (tensor.dtype == 1) {
        sub_custom<half><<<blockDim, nullptr, stream>>>(x, y, z, tiling);
    } else {
        sub_custom<float><<<blockDim, nullptr, stream>>>(x, y, z, tiling);
    }
}