#include <cmath>
#include "kernel_operator.h"
/*
 * Sub Kernel — Ascend C Direct Invocation
 * This file is #included — do NOT add main(), #pragma once, or include guards.
 *
 * TensorGroupInfo / TensorInfo (predefined):
 *   struct TensorInfo { const int64_t* shape; int64_t numDims; int32_t dtype; };
 *   struct TensorGroupInfo { const TensorInfo* tensors; int64_t numTensors; };
 *   dtype: 0=fp32 1=fp16 2=bf16 3=int8 4=int16 5=int32 6=int64 7=uint8 8=uint16 9=uint32 10=uint64 11=bool
 *   Usage: info_x.tensors[0].shape[0]  // first dim of first tensor in input x
 *
 * 实现说明（参考 kernel_add.asc）：
 *   - z = x - y，总数据量 = tileNum × BUFFER_NUM 次拷贝-计算-写回循环完成
 *   - 8 个 Vector Core 并行，每核处理 blockLength 个元素，核内再按 tile 分块搬运
 *   - 双缓冲（BUFFER_NUM=2）通过 TQue 管理内存，DataCopy 要求 32B 对齐，
 *     本题 tileLength=1024 元素（fp32=4KB / fp16=2KB），满足对齐要求
 *
 * 已知前提与边界（对应评审意见）：
 *   - kernel 内不设尾块分支：要求 totalLength 能被 blockDim×tileNum×BUFFER_NUM 整除。
 *     本题固定形状 (8,2048) 满足；run_kernel 中已加整除校验，不满足时拒绝启动
 *     （宁可不算，不写脏数据）。若需支持非整除形状，须在 Process 中追加尾块拷回逻辑。
 *   - dtype 仅支持 0=fp32 / 1=fp16，其余 dtype 在 run_kernel 中显式拒绝启动，
 *     避免按错误字节宽度解读 Global Memory 缓冲。
 *   - tileNum 取 1（不再按 batch 细分），单次搬运粒度放大至 blockLength/BUFFER_NUM，
 *     减少 MTE2/MTE3 发起与同步开销。
 */

// ---------------------------------------------------------------------------
// Tiling 结构体：由 host 端 run_kernel 填充并按值传入 kernel
// ---------------------------------------------------------------------------
struct SubCustomTilingData {
    uint32_t totalLength; // 张量总元素数（本题 8 * 2048 = 16384）
    uint32_t tileNum;     // 每个 core 内部的分块数（本题取 1，搬运粒度优先）
};

constexpr uint32_t BUFFER_NUM = 2;   // double buffer，隐藏搬运延迟
constexpr uint32_t QUEUE_DEPTH = 1;

// ---------------------------------------------------------------------------
// KernelSub：z = x - y，模板参数 T 支持 float / half，编译期按 dtype 实例化
// ---------------------------------------------------------------------------
template <typename T>
class KernelSub {
public:
    __aicore__ inline KernelSub() {}

    __aicore__ inline void Init(GM_ADDR x, GM_ADDR y, GM_ADDR z, const SubCustomTilingData& tiling)
    {
        uint32_t totalLength = tiling.totalLength;
        uint32_t tileNum = tiling.tileNum;
        // 每个 core 需要处理的数据长度（均分给所有核）
        this->blockLength = totalLength / AscendC::GetBlockNum();
        // 每个核内部的分块数，本题等于 batch
        this->tileNum = tileNum;
        // 每个 tile 的数据长度（单次搬运大小），blockLength / tileNum / BUFFER_NUM
        this->tileLength = this->blockLength / tileNum / BUFFER_NUM;
        // 设置各张量在 Global Memory 中的起始地址（每核偏移 blockLength，核间不重叠）
        xGm.SetGlobalBuffer((__gm__ T *)x + this->blockLength * AscendC::GetBlockIdx(), this->blockLength);
        yGm.SetGlobalBuffer((__gm__ T *)y + this->blockLength * AscendC::GetBlockIdx(), this->blockLength);
        zGm.SetGlobalBuffer((__gm__ T *)z + this->blockLength * AscendC::GetBlockIdx(), this->blockLength);
        // 初始化排队通信管理队列内存（UB 上每块缓冲 tileLength * sizeof(T) 字节）
        pipe.InitBuffer(inQueueX, BUFFER_NUM, this->tileLength * sizeof(T));
        pipe.InitBuffer(inQueueY, BUFFER_NUM, this->tileLength * sizeof(T));
        pipe.InitBuffer(outQueueZ, BUFFER_NUM, this->tileLength * sizeof(T));
    }

    __aicore__ inline void Process()
    {
        // 循环次数 = tileNum × BUFFER_NUM，tileLength 相应缩小 BUFFER_NUM 倍
        int32_t loopCount = this->tileNum * BUFFER_NUM;
        // 顺序执行每次分块的数据搬运与计算
        for (int32_t i = 0; i < loopCount; i++) {
            CopyIn(i);    // 搬入第 i 层数据
            Compute(i);   // 计算第 i 层数据
            CopyOut(i);   // 搬出第 i 层结果
        }
    }

private:
    __aicore__ inline void CopyIn(int32_t progress)
    {
        // 为 LocalTensor 申请内存
        AscendC::LocalTensor<T> xLocal = inQueueX.AllocTensor<T>();
        AscendC::LocalTensor<T> yLocal = inQueueY.AllocTensor<T>();
        // 将 Global Memory 上的输入拷贝到 Local Memory
        AscendC::DataCopy(xLocal, xGm[progress * this->tileLength], this->tileLength);
        AscendC::DataCopy(yLocal, yGm[progress * this->tileLength], this->tileLength);
        // 将数据加入队列，等待 Compute 消费
        inQueueX.EnQue(xLocal);
        inQueueY.EnQue(yLocal);
    }

    __aicore__ inline void Compute(int32_t progress)
    {
        // 从输入队列取出数据
        AscendC::LocalTensor<T> xLocal = inQueueX.DeQue<T>();
        AscendC::LocalTensor<T> yLocal = inQueueY.DeQue<T>();
        // 申请计算输出内存
        AscendC::LocalTensor<T> zLocal = outQueueZ.AllocTensor<T>();
        // 矢量减法：z = x - y（注意操作数顺序）
        AscendC::Sub(zLocal, xLocal, yLocal, this->tileLength);
        // 将计算结果加入输出队列，等待 CopyOut 消费
        outQueueZ.EnQue<T>(zLocal);
        // 释放输入队列内存（无需再使用）
        inQueueX.FreeTensor(xLocal);
        inQueueY.FreeTensor(yLocal);
    }

    __aicore__ inline void CopyOut(int32_t progress)
    {
        // 从输出队列取出计算结果
        AscendC::LocalTensor<T> zLocal = outQueueZ.DeQue<T>();
        // 将 Local Memory 上的结果拷贝至 Global Memory
        AscendC::DataCopy(zGm[progress * this->tileLength], zLocal, this->tileLength);
        // 释放输出队列内存
        outQueueZ.FreeTensor(zLocal);
    }

private:
    AscendC::TPipe pipe; // TPipe 内存管理对象
    AscendC::TQue<AscendC::QuePosition::VECIN, QUEUE_DEPTH> inQueueX, inQueueY;  // 输入队列，VECIN 位置
    AscendC::TQue<AscendC::QuePosition::VECOUT, QUEUE_DEPTH> outQueueZ;          // 输出队列，VECOUT 位置
    AscendC::GlobalTensor<T> xGm, yGm, zGm; // Global Memory 上的张量，xGm、yGm 为输入，zGm 为输出

    uint32_t blockLength; // 每个 core 的计算数据量
    uint32_t tileNum;     // 每个 core 内部数据被分为的块数（host 端配置）
    uint32_t tileLength;  // 每个 tile 包含的数据量 = blockLength / tileNum / BUFFER_NUM
};

// ---------------------------------------------------------------------------
// 核函数启动入口：实例化 KernelSub<T>（T 由 run_kernel 根据 dtype 选择）
// ---------------------------------------------------------------------------
template <typename T>
__global__ __vector__ void sub_custom(GM_ADDR x, GM_ADDR y, GM_ADDR z, SubCustomTilingData tiling)
{
    KernelSub<T> op;
    op.Init(x, y, z, tiling);
    op.Process();
}

// ---------------------------------------------------------------------------
// host 端启动代码：从 TensorGroupInfo 解析 tiling 并启动核函数
// ---------------------------------------------------------------------------
extern "C" void run_kernel(GM_ADDR x, const TensorGroupInfo& info_x, GM_ADDR y, const TensorGroupInfo& info_y, GM_ADDR z, const TensorGroupInfo& info_z, int64_t availableCoreNum, aclrtStream stream)
{
    constexpr uint32_t blockDim = 8;
    // 每核内部不再按 batch 细分（tileNum=1），单次搬运粒度放大到 blockLength/BUFFER_NUM，
    // 减少 MTE2/MTE3 发起与同步开销（评审建议：减小 tileNum 放大搬运粒度）
    constexpr uint32_t tileNum = 1;

    // 1. 计算总长度（x/y/z 形状一致）
    const TensorInfo& t0 = info_x.tensors[0];
    int64_t totalLength = 1;
    for (int64_t i = 0; i < t0.numDims; i++) {
        totalLength *= t0.shape[i];
    }

    // 2. 前提校验：总长度必须能被 blockDim × tileNum × BUFFER_NUM 整除，且单块非 0。
    //    kernel 内无尾块分支，前提不满足时拒绝启动，避免输出残留脏数据或以 0 长度调用
    //    InitBuffer/DataCopy。
    uint32_t tileLength = (uint32_t)totalLength / blockDim / tileNum / BUFFER_NUM;
    if (totalLength <= 0 || (uint32_t)totalLength % (blockDim * tileNum * BUFFER_NUM) != 0 || tileLength == 0) {
        return;
    }

    // 3. 依据 dtype 选择实例化类型：仅支持 0=fp32 / 1=fp16，其余 dtype 显式拒绝启动，
    //    避免按错误字节宽度解读 Global Memory 缓冲
    int32_t dtype = t0.dtype;
    if (dtype != 0 && dtype != 1) {
        return;
    }

    SubCustomTilingData tiling = {(uint32_t)totalLength, tileNum};
    if (dtype == 1) {
        // fp16 → half 类型
        sub_custom<half><<<blockDim, nullptr, stream>>>(x, y, z, tiling);
    } else {
        // fp32 → float 类型
        sub_custom<float><<<blockDim, nullptr, stream>>>(x, y, z, tiling);
    }
}
