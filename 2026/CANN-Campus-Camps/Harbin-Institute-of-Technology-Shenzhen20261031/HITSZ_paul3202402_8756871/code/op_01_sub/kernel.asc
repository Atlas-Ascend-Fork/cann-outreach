#include <cmath>
#include "kernel_operator.h"

template <typename T>
class SubKernel {
public:
    __aicore__ inline void Init(
        GM_ADDR x, GM_ADDR y, GM_ADDR z, int64_t total)
    {
        xGm.SetGlobalBuffer((__gm__ T*)x);
        yGm.SetGlobalBuffer((__gm__ T*)y);
        zGm.SetGlobalBuffer((__gm__ T*)z);
        total_ = total;

        pipe.InitBuffer(xQueue, 1, TILE * sizeof(T));
        pipe.InitBuffer(yQueue, 1, TILE * sizeof(T));
        pipe.InitBuffer(zQueue, 1, TILE * sizeof(T));
    }

    __aicore__ inline void Process()
    {
        const int64_t step =
            (int64_t)AscendC::GetBlockNum() * TILE;

        for (int64_t offset =
                 (int64_t)AscendC::GetBlockIdx() * TILE;
             offset < total_;
             offset += step) {
            const uint32_t count =
                (uint32_t)((total_ - offset < TILE)
                               ? total_ - offset
                               : TILE);

            AscendC::DataCopyExtParams params{
                1, (uint32_t)(count * sizeof(T)), 0, 0, 0
            };
            AscendC::DataCopyPadExtParams<T> pad{
                false, 0, 0, 0
            };

            // GM -> UB
            auto xLocal = xQueue.AllocTensor<T>();
            auto yLocal = yQueue.AllocTensor<T>();

            AscendC::DataCopyPad(
                xLocal, xGm[offset], params, pad);
            AscendC::DataCopyPad(
                yLocal, yGm[offset], params, pad);

            xQueue.EnQue(xLocal);
            yQueue.EnQue(yLocal);

            // z = x - y
            xLocal = xQueue.DeQue<T>();
            yLocal = yQueue.DeQue<T>();
            auto zLocal = zQueue.AllocTensor<T>();

            AscendC::Sub(zLocal, xLocal, yLocal, count);

            zQueue.EnQue(zLocal);
            xQueue.FreeTensor(xLocal);
            yQueue.FreeTensor(yLocal);

            // UB -> GM
            zLocal = zQueue.DeQue<T>();
            AscendC::DataCopyPad(
                zGm[offset], zLocal, params);
            zQueue.FreeTensor(zLocal);
        }
    }

private:
    static constexpr int64_t TILE = 4096;

    int64_t total_;
    AscendC::TPipe pipe;

    AscendC::TQue<AscendC::QuePosition::VECIN, 1> xQueue;
    AscendC::TQue<AscendC::QuePosition::VECIN, 1> yQueue;
    AscendC::TQue<AscendC::QuePosition::VECOUT, 1> zQueue;

    AscendC::GlobalTensor<T> xGm;
    AscendC::GlobalTensor<T> yGm;
    AscendC::GlobalTensor<T> zGm;
};

template <typename T>
__global__ __vector__ void sub_custom(
    GM_ADDR x, GM_ADDR y, GM_ADDR z, int64_t total)
{
    SubKernel<T> kernel;
    kernel.Init(x, y, z, total);
    kernel.Process();
}

extern "C" void run_kernel(
    GM_ADDR x, const TensorGroupInfo& info_x,
    GM_ADDR y, const TensorGroupInfo& info_y,
    GM_ADDR z, const TensorGroupInfo& info_z,
    int64_t availableCoreNum, aclrtStream stream)
{
    // 前提：输入输出同形状、同类型，类型为 FP32 / FP16。
    int64_t total = 1;
    for (int64_t i = 0; i < info_z.tensors[0].numDims; ++i) {
        total *= info_z.tensors[0].shape[i];
    }

    if (total == 0) {
        return;
    }

    int64_t cores =
        availableCoreNum > 0 ? availableCoreNum : 1;
    int64_t tiles = (total + 4095) / 4096;
    uint32_t blockNum =
        (uint32_t)(cores < tiles ? cores : tiles);

    if (info_x.tensors[0].dtype == 0) {
        sub_custom<float><<<blockNum, nullptr, stream>>>(
            x, y, z, total);
    } else if (info_x.tensors[0].dtype == 1) {
        sub_custom<half><<<blockNum, nullptr, stream>>>(
            x, y, z, total);
    }
}