#include <cmath>
#include "kernel_operator.h"

using namespace AscendC;

constexpr int32_t BUFFER_NUM = 2;

// 核心计算模板类
template <typename T>
class KernelSub {
public:
    __aicore__ inline KernelSub() {}
    
    __aicore__ inline void Init(GM_ADDR x, GM_ADDR y, GM_ADDR z, uint32_t totalLength) {
        uint32_t blockNum = GetBlockNum();
        uint32_t blockIdx = GetBlockIdx();
        
        // 计算当前核处理的数据长度和偏移量
        this->blockLength = totalLength / blockNum;
        uint32_t remainder = totalLength % blockNum;
        uint32_t gmOffset = this->blockLength * blockIdx + (blockIdx < remainder ? blockIdx : remainder);
        if (blockIdx < remainder) {
            this->blockLength += 1;
        }
        
        // 绑定全局内存 (Global Memory)
        xGm.SetGlobalBuffer((__gm__ T*)x + gmOffset, this->blockLength);
        yGm.SetGlobalBuffer((__gm__ T*)y + gmOffset, this->blockLength);
        zGm.SetGlobalBuffer((__gm__ T*)z + gmOffset, this->blockLength);

        // 设置每个 Tile 的长度（单次搬运处理量），防止 UB 溢出
        this->tileLength = 1024; 
        if (this->blockLength < this->tileLength) {
            this->tileLength = this->blockLength;
        }
        
        // 对齐到 32 Bytes (8 个 float 或 16 个 half)
        int32_t alignElem = 32 / sizeof(T);
        if (this->tileLength % alignElem != 0) {
            this->tileLength = (this->tileLength / alignElem) * alignElem;
        }
        if (this->tileLength == 0) {
            this->tileLength = alignElem;
        }

        this->tileNum = this->blockLength / this->tileLength;
        if (this->blockLength % this->tileLength != 0) {
            this->tileNum += 1;
        }

        // 初始化队列缓冲
        pipe.InitBuffer(inQueueX, BUFFER_NUM, this->tileLength * sizeof(T));
        pipe.InitBuffer(inQueueY, BUFFER_NUM, this->tileLength * sizeof(T));
        pipe.InitBuffer(outQueueZ, BUFFER_NUM, this->tileLength * sizeof(T));
    }

    __aicore__ inline void Process() {
        for (uint32_t i = 0; i < this->tileNum; i++) {
            uint32_t currentTileLength = this->tileLength;
            // 处理最后一个非对齐的尾块
            if (i == this->tileNum - 1) {
                currentTileLength = this->blockLength - i * this->tileLength;
            }
            if (currentTileLength == 0) continue;
            
            CopyIn(i, currentTileLength);
            Compute(i, currentTileLength);
            CopyOut(i, currentTileLength);
        }
    }

private:
    __aicore__ inline void CopyIn(uint32_t progress, uint32_t length) {
        LocalTensor<T> xLocal = inQueueX.AllocTensor<T>();
        LocalTensor<T> yLocal = inQueueY.AllocTensor<T>();
        uint32_t offset = progress * this->tileLength;
        
        // 将数据从 GM 搬运至 UB
        DataCopy(xLocal, xGm[offset], length);
        DataCopy(yLocal, yGm[offset], length);
        
        inQueueX.EnQue(xLocal);
        inQueueY.EnQue(yLocal);
    }

    __aicore__ inline void Compute(uint32_t progress, uint32_t length) {
        LocalTensor<T> xLocal = inQueueX.DeQue<T>();
        LocalTensor<T> yLocal = inQueueY.DeQue<T>();
        LocalTensor<T> zLocal = outQueueZ.AllocTensor<T>();

        // 执行矢量减法：z = x - y
        Sub(zLocal, xLocal, yLocal, length);

        outQueueZ.EnQue<T>(zLocal);
        inQueueX.FreeTensor(xLocal);
        inQueueY.FreeTensor(yLocal);
    }

    __aicore__ inline void CopyOut(uint32_t progress, uint32_t length) {
        LocalTensor<T> zLocal = outQueueZ.DeQue<T>();
        uint32_t offset = progress * this->tileLength;
        
        // 将计算结果搬出至 GM
        DataCopy(zGm[offset], zLocal, length);
        outQueueZ.FreeTensor(zLocal);
    }

private:
    TPipe pipe;
    TQue<QuePosition::VECIN, BUFFER_NUM> inQueueX;
    TQue<QuePosition::VECIN, BUFFER_NUM> inQueueY;
    TQue<QuePosition::VECOUT, BUFFER_NUM> outQueueZ;

    GlobalTensor<T> xGm, yGm, zGm;
    uint32_t blockLength, tileLength, tileNum;
};

// 设备侧: float32 专属 Kernel 入口
extern "C" __global__ __aicore__ void sub_custom_fp32(GM_ADDR x, GM_ADDR y, GM_ADDR z, uint32_t totalLength) {
    KernelSub<float> op;
    op.Init(x, y, z, totalLength);
    op.Process();
}

// 设备侧: float16 专属 Kernel 入口
extern "C" __global__ __aicore__ void sub_custom_fp16(GM_ADDR x, GM_ADDR y, GM_ADDR z, uint32_t totalLength) {
    KernelSub<half> op;
    op.Init(x, y, z, totalLength);
    op.Process();
}

// 主机侧: 核心调度入口
extern "C" void run_kernel(GM_ADDR x, const TensorGroupInfo& info_x, GM_ADDR y, const TensorGroupInfo& info_y, GM_ADDR z, const TensorGroupInfo& info_z, int64_t availableCoreNum, aclrtStream stream)
{
    // 计算总元素数量
    int64_t numDims = info_x.tensors[0].numDims;
    uint32_t totalLength = 1;
    for (int i = 0; i < numDims; ++i) {
        totalLength *= info_x.tensors[0].shape[i];
    }

    // 获取数据类型 (0=fp32, 1=fp16)
    int32_t dtype = info_x.tensors[0].dtype;
    
    // 设置启动的核数 (不能超过可用核数，且不能超过数据总长度)
    uint32_t blockNum = availableCoreNum;
    if (blockNum > 16) blockNum = 16; // 本题shape为8x2048，最大用16个核处理已经非常充足
    if (blockNum > totalLength) blockNum = totalLength;

    // 根据数据类型分派不同的 Kernel
    if (dtype == 0) { // fp32
        sub_custom_fp32<<<blockNum, nullptr, stream>>>(x, y, z, totalLength);
    } else if (dtype == 1) { // fp16
        sub_custom_fp16<<<blockNum, nullptr, stream>>>(x, y, z, totalLength);
    }
}