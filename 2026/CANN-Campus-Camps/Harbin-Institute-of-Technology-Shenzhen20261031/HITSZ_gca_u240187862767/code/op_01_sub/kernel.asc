#include <cmath>
#include "kernel_operator.h"
/*
 * Sub Kernel — Ascend C Direct Invocation
 * This file is #included — do NOT add main(), #pragma once, or include guards.
 */

namespace {

constexpr uint32_t kBufferNum  = 2;     // UB 双缓冲
constexpr uint32_t kTileElems  = 4096;  // 单 tile 元素个数 (fp32 16KB / fp16 8KB)
constexpr uint32_t kAlignElems = 32;    // 32B 对齐粒度 (fp32: 128B, fp16: 64B)
constexpr int32_t  kDtypeFp16  = 1;     // TensorInfo.dtype: 1 = float16

template <typename T>
__aicore__ inline void SubTile(GM_ADDR x, GM_ADDR y, GM_ADDR z, uint64_t offset, uint32_t length)
{
    using namespace AscendC;

    if (length == 0U) {
        return;
    }

    GlobalTensor<T> xGm;
    GlobalTensor<T> yGm;
    GlobalTensor<T> zGm;
    xGm.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(x) + offset, length);
    yGm.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(y) + offset, length);
    zGm.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(z) + offset, length);

    const uint32_t tileBytes = static_cast<uint32_t>(kTileElems * sizeof(T));
    TPipe pipe;
    TQue<QuePosition::VECIN, kBufferNum> inQueX;
    TQue<QuePosition::VECIN, kBufferNum> inQueY;
    TQue<QuePosition::VECOUT, kBufferNum> outQueZ;
    pipe.InitBuffer(inQueX, static_cast<int32_t>(kBufferNum), tileBytes);
    pipe.InitBuffer(inQueY, static_cast<int32_t>(kBufferNum), tileBytes);
    pipe.InitBuffer(outQueZ, static_cast<int32_t>(kBufferNum), tileBytes);

    const uint32_t tileNum = (length + kTileElems - 1U) / kTileElems;
    for (uint32_t i = 0U; i < tileNum; ++i) {
        const uint32_t tileOffset = i * kTileElems;
        uint32_t curLen = length - tileOffset;
        if (curLen > kTileElems) {
            curLen = kTileElems;
        }

        LocalTensor<T> xLocal = inQueX.AllocTensor<T>();
        LocalTensor<T> yLocal = inQueY.AllocTensor<T>();
        LocalTensor<T> zLocal = outQueZ.AllocTensor<T>();

        DataCopy(xLocal, xGm[tileOffset], curLen);
        DataCopy(yLocal, yGm[tileOffset], curLen);
        inQueX.EnQue(xLocal);
        inQueY.EnQue(yLocal);

        xLocal = inQueX.DeQue<T>();
        yLocal = inQueY.DeQue<T>();
        Sub(zLocal, xLocal, yLocal, static_cast<int32_t>(curLen));

        inQueX.FreeTensor(xLocal);
        inQueY.FreeTensor(yLocal);

        outQueZ.EnQue(zLocal);
        zLocal = outQueZ.DeQue<T>();
        DataCopy(zGm[tileOffset], zLocal, curLen);
        outQueZ.FreeTensor(zLocal);
    }
}

}  // namespace

__global__ __vector__ void sub_custom(GM_ADDR x, GM_ADDR y, GM_ADDR z,
                                      uint64_t perBlockLen, uint64_t totalLength, int32_t dtype)
{
    using namespace AscendC;

    const uint64_t offset = static_cast<uint64_t>(GetBlockIdx()) * perBlockLen;
    if (offset >= totalLength) {
        return;
    }

    uint64_t length = totalLength - offset;
    if (length > perBlockLen) {
        length = perBlockLen;
    }

    if (dtype == kDtypeFp16) {
        SubTile<half>(x, y, z, offset, static_cast<uint32_t>(length));
    } else {
        SubTile<float>(x, y, z, offset, static_cast<uint32_t>(length));
    }
}

extern "C" void run_kernel(GM_ADDR x, const TensorGroupInfo& info_x, GM_ADDR y, const TensorGroupInfo& info_y, GM_ADDR z, const TensorGroupInfo& info_z, int64_t availableCoreNum, aclrtStream stream)
{
    const TensorInfo& xInfo = info_x.tensors[0];

    // 元素总数 = 各维度乘积
    uint64_t totalLength = 1;
    for (int64_t i = 0; i < xInfo.numDims; ++i) {
        totalLength *= static_cast<uint64_t>(xInfo.shape[i]);
    }
    if (totalLength == 0) {
        return;
    }

    // 核数：不超过可用核数，也不超过 "每个核至少 kAlignElems 个元素" 的上限
    int64_t blockNum = (availableCoreNum > 0) ? availableCoreNum : 1;
    const uint64_t MaxBlockNum = (totalLength + kAlignElems - 1) / kAlignElems;
    if (static_cast<uint64_t>(blockNum) > MaxBlockNum) {
        blockNum = static_cast<int64_t>(MaxBlockNum);
    }

    // 每个核处理元素数，向上取整到 kAlignElems，保证搬运地址 32B 对齐
    uint64_t perBlockLen = (totalLength + static_cast<uint64_t>(blockNum) - 1) / static_cast<uint64_t>(blockNum);
    perBlockLen = (perBlockLen + kAlignElems - 1) / kAlignElems * kAlignElems;
    blockNum = static_cast<int64_t>((totalLength + perBlockLen - 1) / perBlockLen);

    sub_custom<<<blockNum, nullptr, stream>>>(x, y, z, perBlockLen, totalLength, xInfo.dtype);
}