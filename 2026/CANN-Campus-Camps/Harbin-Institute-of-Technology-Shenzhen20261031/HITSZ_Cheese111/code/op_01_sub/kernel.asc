#include "kernel_operator.h"

struct SubCustomTilingData {
    uint32_t totalLength;
    uint32_t tileNum;
};

template <typename T>
class KernelSub {
public:
    __aicore__ inline KernelSub() {}

    __aicore__ inline void Init(GM_ADDR x, GM_ADDR y, GM_ADDR z,
                               const SubCustomTilingData& tiling)
    {
        const uint32_t blockLength = tiling.totalLength / AscendC::GetBlockNum();
        loops = tiling.tileNum * 2;
        tileLength = blockLength / loops;
        const uint32_t offset = AscendC::GetBlockIdx() * blockLength;

        xGm.SetGlobalBuffer((__gm__ T*)x + offset, blockLength);
        yGm.SetGlobalBuffer((__gm__ T*)y + offset, blockLength);
        zGm.SetGlobalBuffer((__gm__ T*)z + offset, blockLength);
        pipe.InitBuffer(xQueue, 2, tileLength * sizeof(T));
        pipe.InitBuffer(yQueue, 2, tileLength * sizeof(T));
        pipe.InitBuffer(zQueue, 2, tileLength * sizeof(T));
    }

    __aicore__ inline void Process()
    {
        for (uint32_t i = 0; i < loops; ++i) {
            const uint32_t offset = i * tileLength;

            // Global memory -> local memory.
            AscendC::LocalTensor<T> x = xQueue.AllocTensor<T>();
            AscendC::LocalTensor<T> y = yQueue.AllocTensor<T>();
            AscendC::DataCopy(x, xGm[offset], tileLength);
            AscendC::DataCopy(y, yGm[offset], tileLength);
            xQueue.EnQue(x);
            yQueue.EnQue(y);

            // Elementwise subtraction: z = x - y.
            x = xQueue.DeQue<T>();
            y = yQueue.DeQue<T>();
            AscendC::LocalTensor<T> z = zQueue.AllocTensor<T>();
            AscendC::Sub(z, x, y, tileLength);
            zQueue.EnQue(z);
            xQueue.FreeTensor(x);
            yQueue.FreeTensor(y);

            // Local memory -> global memory.
            z = zQueue.DeQue<T>();
            AscendC::DataCopy(zGm[offset], z, tileLength);
            zQueue.FreeTensor(z);
        }
    }

private:
    AscendC::TPipe pipe;
    AscendC::TQue<AscendC::QuePosition::VECIN, 1> xQueue, yQueue;
    AscendC::TQue<AscendC::QuePosition::VECOUT, 1> zQueue;
    AscendC::GlobalTensor<T> xGm, yGm, zGm;
    uint32_t loops;
    uint32_t tileLength;
};

template <typename T>
__global__ __vector__ void sub_custom(GM_ADDR x, GM_ADDR y, GM_ADDR z,
                                    SubCustomTilingData tiling)
{
    KernelSub<T> kernel;
    kernel.Init(x, y, z, tiling);
    kernel.Process();
}

extern "C" void run_kernel(
    GM_ADDR x, const TensorGroupInfo& info_x,
    GM_ADDR y, const TensorGroupInfo& info_y,
    GM_ADDR z, const TensorGroupInfo& info_z,
    int64_t availableCoreNum, aclrtStream stream)
{
    const TensorInfo& input = info_x.tensors[0];
    int64_t totalLength = 1;
    for (int64_t i = 0; i < input.numDims; ++i) {
        totalLength *= input.shape[i];
    }

    constexpr uint32_t blockDim = 8;
    SubCustomTilingData tiling = {static_cast<uint32_t>(totalLength), 8};
    if (input.dtype == 1) {
        sub_custom<half><<<blockDim, nullptr, stream>>>(x, y, z, tiling);
    } else {
        sub_custom<float><<<blockDim, nullptr, stream>>>(x, y, z, tiling);
    }
}
