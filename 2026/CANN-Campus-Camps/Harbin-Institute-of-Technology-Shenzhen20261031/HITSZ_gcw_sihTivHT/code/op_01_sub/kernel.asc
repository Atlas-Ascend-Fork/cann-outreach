#include "kernel_operator.h"

// Fixed task shape: (8, 2048), contiguous ND.
template <typename T>
class KernelSub {
public:
    __aicore__ inline void Init(GM_ADDR x, GM_ADDR y, GM_ADDR z,
                                uint32_t blockLength)
    {
        blockLength_ = blockLength;
        uint32_t offset = AscendC::GetBlockIdx() * blockLength_;
        xGm_.SetGlobalBuffer((__gm__ T*)x + offset, blockLength_);
        yGm_.SetGlobalBuffer((__gm__ T*)y + offset, blockLength_);
        zGm_.SetGlobalBuffer((__gm__ T*)z + offset, blockLength_);
        pipe_.InitBuffer(xQueue_, 2, TILE_LENGTH * sizeof(T));
        pipe_.InitBuffer(yQueue_, 2, TILE_LENGTH * sizeof(T));
        pipe_.InitBuffer(zQueue_, 2, TILE_LENGTH * sizeof(T));
    }

    __aicore__ inline void Process()
    {
        for (uint32_t i = 0; i < blockLength_ / TILE_LENGTH; ++i) {
            CopyIn(i);
            Compute();
            CopyOut(i);
        }
    }

private:
    __aicore__ inline void CopyIn(uint32_t i)
    {
        AscendC::LocalTensor<T> xLocal = xQueue_.AllocTensor<T>();
        AscendC::LocalTensor<T> yLocal = yQueue_.AllocTensor<T>();
        AscendC::DataCopy(xLocal, xGm_[i * TILE_LENGTH], TILE_LENGTH);
        AscendC::DataCopy(yLocal, yGm_[i * TILE_LENGTH], TILE_LENGTH);
        xQueue_.EnQue(xLocal);
        yQueue_.EnQue(yLocal);
    }

    __aicore__ inline void Compute()
    {
        AscendC::LocalTensor<T> xLocal = xQueue_.DeQue<T>();
        AscendC::LocalTensor<T> yLocal = yQueue_.DeQue<T>();
        AscendC::LocalTensor<T> zLocal = zQueue_.AllocTensor<T>();
        AscendC::Sub(zLocal, xLocal, yLocal, TILE_LENGTH);
        zQueue_.EnQue(zLocal);
        xQueue_.FreeTensor(xLocal);
        yQueue_.FreeTensor(yLocal);
    }

    __aicore__ inline void CopyOut(uint32_t i)
    {
        AscendC::LocalTensor<T> zLocal = zQueue_.DeQue<T>();
        AscendC::DataCopy(zGm_[i * TILE_LENGTH], zLocal, TILE_LENGTH);
        zQueue_.FreeTensor(zLocal);
    }

    static constexpr uint32_t TILE_LENGTH = 256;
    uint32_t blockLength_;
    AscendC::TPipe pipe_;
    AscendC::TQue<AscendC::QuePosition::VECIN, 2> xQueue_, yQueue_;
    AscendC::TQue<AscendC::QuePosition::VECOUT, 2> zQueue_;
    AscendC::GlobalTensor<T> xGm_, yGm_, zGm_;
};

__global__ __vector__ void sub_custom_fp32(GM_ADDR x, GM_ADDR y, GM_ADDR z,
                                          uint32_t blockLength)
{
    KernelSub<float> op;
    op.Init(x, y, z, blockLength);
    op.Process();
}

__global__ __vector__ void sub_custom_fp16(GM_ADDR x, GM_ADDR y, GM_ADDR z,
                                          uint32_t blockLength)
{
    KernelSub<half> op;
    op.Init(x, y, z, blockLength);
    op.Process();
}

extern "C" void run_kernel(GM_ADDR x, const TensorGroupInfo& info_x,
                           GM_ADDR y, const TensorGroupInfo& info_y,
                           GM_ADDR z, const TensorGroupInfo& info_z,
                           int64_t availableCoreNum, aclrtStream stream)
{
    // Use 1, 2, 4 or 8 cores so each core owns complete aligned tiles.
    uint32_t blockNum = 1;
    while (blockNum < 8 &&
           static_cast<int64_t>(blockNum * 2) <= availableCoreNum) {
        blockNum *= 2;
    }
    uint32_t blockLength = (8 * 2048) / blockNum;
    if (info_x.tensors[0].dtype == 0) {
        sub_custom_fp32<<<blockNum, nullptr, stream>>>(x, y, z, blockLength);
    } else if (info_x.tensors[0].dtype == 1) {
        sub_custom_fp16<<<blockNum, nullptr, stream>>>(x, y, z, blockLength);
    }
}
