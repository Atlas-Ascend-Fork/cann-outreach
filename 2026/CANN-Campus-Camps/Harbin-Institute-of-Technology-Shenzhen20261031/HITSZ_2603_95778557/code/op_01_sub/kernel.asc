#include <cmath>
#include "kernel_operator.h"
/*
 * Sub Kernel — Ascend C Direct Invocation
 * 本文件被 main.asc #include，不要添加 main()、#pragma once 或 include guard。
 *
 * 功能：z = x - y（逐元素相减）
 * 支持：float32(dtype=0)、float16(dtype=1)；输入输出 shape 一致（题目给定 (8, 2048)）
 *
 * 实现要点：
 *   1) 多核切分：host 侧按 32B 对齐把元素均分给各向量核，第 blockIdx 个核处理
 *      [blockIdx * perCoreLength, ... + coreLength) 这一段连续数据；段首地址 32B 对齐，
 *      因此块内主搬运可以走带宽更高的 DataCopy；
 *   2) 核内分块 + 双缓冲：每核再切成若干 tile，用 TQue(深度 2) 流水处理，
 *      CopyIn(MTE2) -> Compute(V) -> CopyOut(MTE3) 三段重叠；
 *   3) 尾部兜底：最后一块的长度可能不是 32B 整倍数（元素总数不是对齐粒度整倍数时），
 *      此时改用 DataCopyPad 按字节精确搬运，保证不越界读也不越界写；
 *   4) 空核退出：元素数少于核数时，超出的核直接返回，不会越界。
 *
 * TensorGroupInfo / TensorInfo (predefined):
 *   struct TensorInfo { const int64_t* shape; int64_t numDims; int32_t dtype; };
 *   struct TensorGroupInfo { const TensorInfo* tensors; int64_t numTensors; };
 *   dtype: 0=fp32 1=fp16 2=bf16 3=int8 4=int16 5=int32 6=int64 7=uint8 8=uint16 9=uint32 10=uint64 11=bool
 *   Usage: info_x.tensors[0].shape[0]  // first dim of first tensor in input x
 *
 * __global__ __vector__ void sub_custom(...)
 * {
 *     // TODO: implement your kernel logic
 *     // Available APIs: AscendC::TPipe, AscendC::TQue, AscendC::DataCopy, AscendC::Add, ...
 * }
 */

// ---------------------------------------------------------------------------
// Tiling 参数：由 host 侧 run_kernel 计算后按值传给核函数
// ---------------------------------------------------------------------------
struct SubCustomTilingData {
    uint32_t totalLength;    // 待处理数据总长度（单位：元素个数），例如 8 * 2048 = 16384
    uint32_t perCoreLength;  // 每个核处理的元素个数（32B 对齐上取整，最后一个核可能更少）
    uint32_t tileLength;     // 每个核内单次处理的元素个数（32B 对齐）
};

constexpr uint32_t BUFFER_NUM = 2;   // 每个队列的 buffer 块数（双缓冲）
constexpr uint32_t QUEUE_DEPTH = 2;  // 队列深度，需与 BUFFER_NUM 一致才能形成双缓冲流水
constexpr uint32_t ALIGN_BYTE = 32;  // DataCopy 的对齐粒度（字节）

// ---------------------------------------------------------------------------
// KernelSub：z = x - y，每核分块循环计算（模板化，支持 float / half 等类型）
// ---------------------------------------------------------------------------
template <typename T>
class KernelSub {
public:
    __aicore__ inline KernelSub() {}

    __aicore__ inline void Init(GM_ADDR x, GM_ADDR y, GM_ADDR z, const SubCustomTilingData& tiling)
    {
        this->totalLength = tiling.totalLength;
        this->perCoreLength = (tiling.perCoreLength == 0u) ? 1u : tiling.perCoreLength;
        this->tileLength = (tiling.tileLength == 0u) ? 1u : tiling.tileLength;

        // 多核切分：第 blockIdx 个核处理 [start, start + coreLength) 这一段连续数据
        uint32_t start = static_cast<uint32_t>(AscendC::GetBlockIdx()) * this->perCoreLength;
        uint32_t coreLength = 0u;
        if (start < this->totalLength) {
            uint32_t remain = this->totalLength - start;
            coreLength = (remain > this->perCoreLength) ? this->perCoreLength : remain;
        }
        this->coreLength = coreLength;

        // 以本核起点重定位 GM 视图，后续下标都相对本核起点
        xGm.SetGlobalBuffer((__gm__ T *)x + start, coreLength);
        yGm.SetGlobalBuffer((__gm__ T *)y + start, coreLength);
        zGm.SetGlobalBuffer((__gm__ T *)z + start, coreLength);

        // 本核的块数（最后一块可能不满）
        this->tileNum = (coreLength + this->tileLength - 1u) / this->tileLength;
        if (coreLength == 0u) {
            return;  // 空核（元素数少于核数时出现），不申请 UB
        }

        // 为三个队列分配 UB 内存：每个队列 BUFFER_NUM 份，每份 tileLength 个元素
        uint32_t tileByte = this->tileLength * static_cast<uint32_t>(sizeof(T));
        pipe.InitBuffer(inQueueX, BUFFER_NUM, tileByte);
        pipe.InitBuffer(inQueueY, BUFFER_NUM, tileByte);
        pipe.InitBuffer(outQueueZ, BUFFER_NUM, tileByte);
    }

    __aicore__ inline void Process()
    {
        // 依次处理本核负责的每个数据块（tileNum = ceil(coreLength / tileLength)）
        for (uint32_t i = 0u; i < this->tileNum; ++i) {
            CopyIn(i);   // 搬入第 i 块数据
            Compute(i);  // 计算第 i 块数据
            CopyOut(i);  // 搬出第 i 块结果
        }
    }

private:
    // 第 tileIdx 块的元素个数（最后一块可能不满）
    __aicore__ inline uint32_t CountOf(uint32_t tileIdx) const
    {
        uint32_t offset = tileIdx * this->tileLength;
        uint32_t remain = this->coreLength - offset;
        return (remain > this->tileLength) ? this->tileLength : remain;
    }

    // 该 (offset, count) 是否满足 DataCopy 的 32B 对齐要求
    __aicore__ inline bool AlignedForDataCopy(uint32_t offset, uint32_t count) const
    {
        uint32_t byteOffset = offset * static_cast<uint32_t>(sizeof(T));
        uint32_t byteCount = count * static_cast<uint32_t>(sizeof(T));
        return ((byteOffset % ALIGN_BYTE) == 0u) && ((byteCount % ALIGN_BYTE) == 0u);
    }

    // GM -> UB：对齐时走 DataCopy，否则用 DataCopyPad 精确搬运（尾块兜底）
    __aicore__ inline void CopyGmToUb(AscendC::LocalTensor<T> dstLocal, AscendC::GlobalTensor<T> srcGlobal,
                                      uint32_t offset, uint32_t count)
    {
        if (AlignedForDataCopy(offset, count)) {
            AscendC::DataCopy(dstLocal, srcGlobal[offset], count);
        } else {
            AscendC::DataCopyExtParams copyParams;
            copyParams.blockCount = 1;
            copyParams.blockLen = count * static_cast<uint32_t>(sizeof(T));
            copyParams.srcStride = 0;
            copyParams.dstStride = 0;
            AscendC::DataCopyPadExtParams<T> padParams{false, 0, 0, 0};
            AscendC::DataCopyPad(dstLocal, srcGlobal[offset], copyParams, padParams);
        }
    }

    // UB -> GM：对齐时走 DataCopy，否则用 DataCopyPad 精确搬运（尾块兜底）
    __aicore__ inline void CopyUbToGm(AscendC::GlobalTensor<T> dstGlobal, AscendC::LocalTensor<T> srcLocal,
                                      uint32_t offset, uint32_t count)
    {
        if (AlignedForDataCopy(offset, count)) {
            AscendC::DataCopy(dstGlobal[offset], srcLocal, count);
        } else {
            AscendC::DataCopyExtParams copyParams;
            copyParams.blockCount = 1;
            copyParams.blockLen = count * static_cast<uint32_t>(sizeof(T));
            copyParams.srcStride = 0;
            copyParams.dstStride = 0;
            AscendC::DataCopyPad(dstGlobal[offset], srcLocal, copyParams);
        }
    }

    __aicore__ inline void CopyIn(uint32_t progress)
    {
        // 为 LocalTensor 分配内存
        AscendC::LocalTensor<T> xLocal = inQueueX.AllocTensor<T>();
        AscendC::LocalTensor<T> yLocal = inQueueY.AllocTensor<T>();
        uint32_t offset = progress * this->tileLength;
        uint32_t count = CountOf(progress);
        // 从 Global Memory 搬入当前数据块
        CopyGmToUb(xLocal, xGm, offset, count);
        CopyGmToUb(yLocal, yGm, offset, count);
        // 将数据放入队列，通知 Compute 任务
        inQueueX.EnQue(xLocal);
        inQueueY.EnQue(yLocal);
    }

    __aicore__ inline void Compute(uint32_t progress)
    {
        uint32_t count = CountOf(progress);
        // 从输入队列获取数据
        AscendC::LocalTensor<T> xLocal = inQueueX.DeQue<T>();
        AscendC::LocalTensor<T> yLocal = inQueueY.DeQue<T>();
        // 为计算结果分配内存
        AscendC::LocalTensor<T> zLocal = outQueueZ.AllocTensor<T>();
        // 执行矢量减法计算 z = x - y
        AscendC::Sub(zLocal, xLocal, yLocal, static_cast<int32_t>(count));
        // 将计算结果放入输出队列，通知 CopyOut 任务
        outQueueZ.EnQue<T>(zLocal);
        // 释放输入数据内存（避免内存泄漏/队列占满）
        inQueueX.FreeTensor(xLocal);
        inQueueY.FreeTensor(yLocal);
    }

    __aicore__ inline void CopyOut(uint32_t progress)
    {
        // 从输出队列获取计算结果
        AscendC::LocalTensor<T> zLocal = outQueueZ.DeQue<T>();
        uint32_t offset = progress * this->tileLength;
        uint32_t count = CountOf(progress);
        // 将结果从 Local Memory 搬出到 Global Memory
        CopyUbToGm(zGm, zLocal, offset, count);
        // 释放输出数据内存
        outQueueZ.FreeTensor(zLocal);
    }

private:
    AscendC::TPipe pipe;  // TPipe 内存管理对象
    AscendC::TQue<AscendC::QuePosition::VECIN, QUEUE_DEPTH> inQueueX, inQueueY;  // 输入数据队列管理对象，VECIN 位置
    AscendC::TQue<AscendC::QuePosition::VECOUT, QUEUE_DEPTH> outQueueZ;  // 输出数据队列管理对象，VECOUT 位置
    AscendC::GlobalTensor<T> xGm, yGm, zGm;  // 管理输入输出 Global Memory 地址的对象

    uint32_t totalLength;    // 总元素数
    uint32_t perCoreLength;  // 每核处理的元素数
    uint32_t coreLength;     // 本核实际处理的元素数
    uint32_t tileNum;        // 本核的块数
    uint32_t tileLength;     // 每块元素数
};

// ---------------------------------------------------------------------------
// 核函数入口：实例化 KernelSub<T> 并执行（T 由 run_kernel 按输入 dtype 选择）
// ---------------------------------------------------------------------------
template <typename T>
__global__ __vector__ void sub_custom(GM_ADDR x, GM_ADDR y, GM_ADDR z, SubCustomTilingData tiling)
{
    KernelSub<T> op;
    op.Init(x, y, z, tiling);
    op.Process();
}

// ---------------------------------------------------------------------------
// host 侧启动函数：从 TensorGroupInfo 推导 tiling 并启动核函数
// ---------------------------------------------------------------------------
extern "C" void run_kernel(GM_ADDR x, const TensorGroupInfo& info_x, GM_ADDR y, const TensorGroupInfo& info_y, GM_ADDR z, const TensorGroupInfo& info_z, int64_t availableCoreNum, aclrtStream stream)
{
    // 1. 取总元素数（x/y/z 形状一致）
    const TensorInfo& t0 = info_x.tensors[0];
    int64_t totalLength = 1;
    for (int64_t i = 0; i < t0.numDims; i++) {
        totalLength *= t0.shape[i];
    }
    if (totalLength <= 0) {
        return;  // 空张量，无需启动
    }

    // 2. 按输入 dtype 选择核函数实例（dtype 定义见 TensorInfo：0=fp32 1=fp16 2=bf16 ...）
    const int32_t dtype = t0.dtype;
    const uint32_t elemSize = (dtype == 1) ? 2u : 4u;  // fp16 / fp32(及其他 32bit 类型按 float 处理)
    const uint32_t alignElems = ALIGN_BYTE / elemSize;  // 一个 32B 数据块包含的元素个数

    // 3. 选核数：不超过设备可用向量核数，也不超过"每核至少一个对齐块"所需要的核数
    uint64_t blockDim = (availableCoreNum > 0) ? static_cast<uint64_t>(availableCoreNum) : 1ull;
    const uint64_t usefulCores = (static_cast<uint64_t>(totalLength) + alignElems - 1ull) / alignElems;
    if (blockDim > usefulCores) {
        blockDim = usefulCores;
    }
    if (blockDim == 0ull) {
        blockDim = 1ull;
    }

    // 4. 计算每核元素数：先按核数均分，再向上对齐到 32B，最后回算真正用到的核数
    uint64_t perCore = (static_cast<uint64_t>(totalLength) + blockDim - 1ull) / blockDim;
    perCore = ((perCore + alignElems - 1ull) / alignElems) * alignElems;
    blockDim = (static_cast<uint64_t>(totalLength) + perCore - 1ull) / perCore;
    if (blockDim == 0ull) {
        blockDim = 1ull;
    }

    // 5. 计算核内块长：受 UB 预算约束（3 个队列 × BUFFER_NUM 份 × 块字节数），并 32B 对齐
    constexpr uint32_t UB_BUDGET_BYTE = 96 * 1024;  // 保守的 UB 使用预算（910B 单核 UB 为 192KB）
    uint32_t maxTileByUb = UB_BUDGET_BYTE / (3u * BUFFER_NUM * elemSize);
    maxTileByUb = (maxTileByUb / alignElems) * alignElems;
    if (maxTileByUb == 0u) {
        maxTileByUb = alignElems;
    }
    uint64_t tileLength = (perCore < static_cast<uint64_t>(maxTileByUb)) ? perCore : maxTileByUb;
    tileLength = (tileLength / alignElems) * alignElems;
    if (tileLength == 0ull) {
        tileLength = alignElems;
    }

    // 6. 下发 tiling 并按 dtype 启动核函数
    SubCustomTilingData tiling = {static_cast<uint32_t>(totalLength), static_cast<uint32_t>(perCore),
                                  static_cast<uint32_t>(tileLength)};
    const uint32_t blockNum = static_cast<uint32_t>(blockDim);
    if (dtype == 1) {
        // fp16：half 实例
        sub_custom<half><<<blockNum, nullptr, stream>>>(x, y, z, tiling);
    } else {
        // fp32 及其他类型默认走 float 实例
        sub_custom<float><<<blockNum, nullptr, stream>>>(x, y, z, tiling);
    }
}
