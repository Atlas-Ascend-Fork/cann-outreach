#include <cstdint>
#include "kernel_operator.h"

template <typename T>
class KernelSub {
public:
    __aicore__ inline void Init(GM_ADDR x, GM_ADDR y, GM_ADDR z, uint32_t totalLength)
    {
        constexpr uint32_t elementsPerBlock = 32 / sizeof(T);
        const uint32_t blockIdx = AscendC::GetBlockIdx();
        const uint32_t blockNum = AscendC::GetBlockNum();
        const uint32_t dataBlocks = totalLength / elementsPerBlock;
        const uint32_t blocksPerCore = dataBlocks / blockNum;
        const uint32_t extraBlocks = dataBlocks % blockNum;

        const uint32_t precedingExtraBlocks = blockIdx < extraBlocks ? blockIdx : extraBlocks;
        const uint32_t offset = (blockIdx * blocksPerCore + precedingExtraBlocks) * elementsPerBlock;
        blockLength_ = (blocksPerCore + (blockIdx < extraBlocks ? 1 : 0)) * elementsPerBlock;
        xGm_.SetGlobalBuffer((__gm__ T*)x + offset, blockLength_);
        yGm_.SetGlobalBuffer((__gm__ T*)y + offset, blockLength_);
        zGm_.SetGlobalBuffer((__gm__ T*)z + offset, blockLength_);

        pipe_.InitBuffer(inQueueX_, 1, TILE_LENGTH * sizeof(T));
        pipe_.InitBuffer(inQueueY_, 1, TILE_LENGTH * sizeof(T));
        pipe_.InitBuffer(outQueueZ_, 1, TILE_LENGTH * sizeof(T));
    }

    __aicore__ inline void Process()
    {
        for (uint32_t offset = 0; offset < blockLength_; offset += TILE_LENGTH) {
            const uint32_t remaining = blockLength_ - offset;
            const uint32_t count = remaining < TILE_LENGTH ? remaining : TILE_LENGTH;
            CopyIn(offset, count);
            Compute(count);
            CopyOut(offset, count);
        }
    }

private:
    __aicore__ inline void CopyIn(uint32_t offset, uint32_t count)
    {
        AscendC::LocalTensor<T> xLocal = inQueueX_.AllocTensor<T>();
        AscendC::LocalTensor<T> yLocal = inQueueY_.AllocTensor<T>();
        AscendC::DataCopy(xLocal, xGm_[offset], count);
        AscendC::DataCopy(yLocal, yGm_[offset], count);
        inQueueX_.EnQue(xLocal);
        inQueueY_.EnQue(yLocal);
    }

    __aicore__ inline void Compute(uint32_t count)
    {
        AscendC::LocalTensor<T> xLocal = inQueueX_.DeQue<T>();
        AscendC::LocalTensor<T> yLocal = inQueueY_.DeQue<T>();
        AscendC::LocalTensor<T> zLocal = outQueueZ_.AllocTensor<T>();
        AscendC::Sub(zLocal, xLocal, yLocal, count);
        outQueueZ_.EnQue(zLocal);
        inQueueX_.FreeTensor(xLocal);
        inQueueY_.FreeTensor(yLocal);
    }

    __aicore__ inline void CopyOut(uint32_t offset, uint32_t count)
    {
        AscendC::LocalTensor<T> zLocal = outQueueZ_.DeQue<T>();
        AscendC::DataCopy(zGm_[offset], zLocal, count);
        outQueueZ_.FreeTensor(zLocal);
    }

    static constexpr uint32_t TILE_LENGTH = 2048;
    AscendC::TPipe pipe_;
    AscendC::TQue<AscendC::TPosition::VECIN, 1> inQueueX_;
    AscendC::TQue<AscendC::TPosition::VECIN, 1> inQueueY_;
    AscendC::TQue<AscendC::TPosition::VECOUT, 1> outQueueZ_;
    AscendC::GlobalTensor<T> xGm_;
    AscendC::GlobalTensor<T> yGm_;
    AscendC::GlobalTensor<T> zGm_;
    uint32_t blockLength_ = 0;
};

template <typename T>
__global__ __vector__ void sub_custom(GM_ADDR x, GM_ADDR y, GM_ADDR z, uint32_t totalLength)
{
    KernelSub<T> op;
    op.Init(x, y, z, totalLength);
    op.Process();
}

extern "C" void run_kernel(GM_ADDR x, const TensorGroupInfo& info_x, GM_ADDR y, const TensorGroupInfo& info_y, GM_ADDR z, const TensorGroupInfo& info_z, int64_t availableCoreNum, aclrtStream stream)
{
    if (availableCoreNum <= 0) {
        return;
    }

    const TensorInfo& tensor = info_x.tensors[0];
    if (tensor.dtype != info_y.tensors[0].dtype || tensor.dtype != info_z.tensors[0].dtype) {
        return;
    }

    uint32_t totalLength = 1;
    for (int64_t dim = 0; dim < tensor.numDims; ++dim) {
        totalLength *= static_cast<uint32_t>(tensor.shape[dim]);
    }
    if (totalLength == 0 || (tensor.dtype != 0 && tensor.dtype != 1)) {
        return;
    }

    const uint32_t elementsPerBlock = tensor.dtype == 0 ? 8 : 16;
    const uint32_t dataBlocks = totalLength / elementsPerBlock;
    if (dataBlocks == 0) {
        return;
    }
    const uint32_t blockNum = availableCoreNum < static_cast<int64_t>(dataBlocks)
        ? static_cast<uint32_t>(availableCoreNum) : dataBlocks;

    if (tensor.dtype == 0) {
        sub_custom<float><<<blockNum, nullptr, stream>>>(x, y, z, totalLength);
    } else {
        sub_custom<half><<<blockNum, nullptr, stream>>>(x, y, z, totalLength);
    }
}
