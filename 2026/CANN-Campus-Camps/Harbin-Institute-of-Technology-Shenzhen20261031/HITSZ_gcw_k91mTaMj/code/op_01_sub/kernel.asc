
#include <cmath>
#include "kernel_operator.h"

// ---------------------------------------------------------------------------
// Tiling 参数：由 host 侧 run_kernel 计算后按值传给核函数
// ---------------------------------------------------------------------------
struct SubCustomTilingData {
    uint32_t totalLength;  // 输入张量总元素数
    uint32_t tileNum;      // 每个核需要处理的 Tile 数量
};

constexpr uint32_t BUFFER_NUM = 2;   // Double Buffer
constexpr uint32_t QUEUE_DEPTH = 1;

// ---------------------------------------------------------------------------
// KernelSub：z = x - y
// ---------------------------------------------------------------------------
template <typename T>
class KernelSub {
public:
    __aicore__ inline KernelSub() {}

    __aicore__ inline void Init(
        GM_ADDR x,
        GM_ADDR y,
        GM_ADDR z,
        const SubCustomTilingData& tiling)
    {
        // 获取当前核的编号
        uint32_t blockIdx = AscendC::GetBlockIdx();

        // 每个核负责的数据长度
        blockLength = tiling.totalLength / 8;

        // 每个核需要处理的 Tile 数量
        tileNum = tiling.tileNum;

        // 每个 Tile 的数据长度
        tileLength = blockLength / tileNum;

        // 计算当前核负责的数据起始偏移
        uint32_t offset = blockIdx * blockLength;

        // 设置 GlobalTensor
        xGm.SetGlobalBuffer((__gm__ T*)x + offset, blockLength);
        yGm.SetGlobalBuffer((__gm__ T*)y + offset, blockLength);
        zGm.SetGlobalBuffer((__gm__ T*)z + offset, blockLength);

        // 初始化输入和输出队列
        // 每个队列分配两个 Buffer，开启 Double Buffer
        pipe.InitBuffer(inQueueX, BUFFER_NUM, tileLength * sizeof(T));
        pipe.InitBuffer(inQueueY, BUFFER_NUM, tileLength * sizeof(T));
        pipe.InitBuffer(outQueueZ, BUFFER_NUM, tileLength * sizeof(T));
    }

    __aicore__ inline void Process()
    {
        // 实际处理 tileNum 个数据块
        // BUFFER_NUM 只控制缓冲区数量，不代表需要重复计算
        for (int32_t i = 0; i < tileNum; i++) {
            CopyIn(i);     // 搬入数据
            Compute(i);    // 执行减法
            CopyOut(i);    // 搬出结果
        }
    }

private:
    // -----------------------------------------------------------------------
    // CopyIn：从 Global Memory 搬运数据到 Local Memory
    // -----------------------------------------------------------------------
    __aicore__ inline void CopyIn(int32_t progress)
    {
        // 申请 X 输入缓冲区
        AscendC::LocalTensor<T> xLocal =
            inQueueX.AllocTensor<T>();

        // 申请 Y 输入缓冲区
        AscendC::LocalTensor<T> yLocal =
            inQueueY.AllocTensor<T>();

        // 计算当前 Tile 的起始偏移
        uint32_t offset = progress * tileLength;

        // 从 GM 搬运数据到 UB
        AscendC::DataCopy(xLocal, xGm[offset], tileLength);
        AscendC::DataCopy(yLocal, yGm[offset], tileLength);

        // 输入数据入队
        inQueueX.EnQue(xLocal);
        inQueueY.EnQue(yLocal);
    }

    // -----------------------------------------------------------------------
    // Compute：执行矢量减法 z = x - y
    // -----------------------------------------------------------------------
    __aicore__ inline void Compute(int32_t progress)
    {
        // 从输入队列取出数据
        AscendC::LocalTensor<T> xLocal =
            inQueueX.DeQue<T>();

        AscendC::LocalTensor<T> yLocal =
            inQueueY.DeQue<T>();

        // 申请输出缓冲区
        AscendC::LocalTensor<T> zLocal =
            outQueueZ.AllocTensor<T>();

        // 执行矢量减法
        AscendC::Sub(zLocal, xLocal, yLocal, tileLength);

        // 释放输入缓冲区
        inQueueX.FreeTensor(xLocal);
        inQueueY.FreeTensor(yLocal);

        // 输出数据入队
        outQueueZ.EnQue(zLocal);
    }

    // -----------------------------------------------------------------------
    // CopyOut：将计算结果从 Local Memory 搬运到 Global Memory
    // -----------------------------------------------------------------------
    __aicore__ inline void CopyOut(int32_t progress)
    {
        // 从输出队列取出计算结果
        AscendC::LocalTensor<T> zLocal =
            outQueueZ.DeQue<T>();

        // 计算当前 Tile 的起始偏移
        uint32_t offset = progress * tileLength;

        // 将结果搬运回 GM
        AscendC::DataCopy(zGm[offset], zLocal, tileLength);

        // 释放输出缓冲区
        outQueueZ.FreeTensor(zLocal);
    }

private:
    AscendC::TPipe pipe;

    // 输入数据队列
    AscendC::TQue<AscendC::QuePosition::VECIN, QUEUE_DEPTH> inQueueX;
    AscendC::TQue<AscendC::QuePosition::VECIN, QUEUE_DEPTH> inQueueY;

    // 输出数据队列
    AscendC::TQue<AscendC::QuePosition::VECOUT, QUEUE_DEPTH> outQueueZ;

    // Global Memory 数据管理对象
    AscendC::GlobalTensor<T> xGm, yGm, zGm;

    uint32_t blockLength;  // 每个核的计算数据长度
    uint32_t tileNum;      // 每个核需要计算的数据块个数
    uint32_t tileLength;   // 每个数据块的长度
};

// ---------------------------------------------------------------------------
// 核函数入口
// ---------------------------------------------------------------------------
template <typename T>
__global__ __vector__ void sub_custom(
    GM_ADDR x,
    GM_ADDR y,
    GM_ADDR z,
    SubCustomTilingData tiling)
{
    KernelSub<T> op;

    op.Init(x, y, z, tiling);
    op.Process();
}

// ---------------------------------------------------------------------------
// Host 侧启动函数
// ---------------------------------------------------------------------------
extern "C" void run_kernel(
    GM_ADDR x,
    const TensorGroupInfo& info_x,
    GM_ADDR y,
    const TensorGroupInfo& info_y,
    GM_ADDR z,
    const TensorGroupInfo& info_z,
    int64_t availableCoreNum,
    aclrtStream stream)
{
    // 使用 8 个 AI Core
    constexpr uint32_t blockDim = 8;

    // 获取输入张量信息
    const TensorInfo& t0 = info_x.tensors[0];

    // 计算总元素数
    int64_t totalLength = 1;

    for (int64_t i = 0; i < t0.numDims; i++) {
        totalLength *= t0.shape[i];
    }

    // 获取输入数据类型
    int32_t dtype = t0.dtype;

    // 每个核划分为 8 个 Tile
    uint32_t tileNum = 8;

    // 构造 Tiling 参数
    SubCustomTilingData tiling = {
        (uint32_t)totalLength,
        tileNum
    };

    // 根据数据类型选择对应的核函数
    if (dtype == 1) {
        // FP16
        sub_custom<half><<<blockDim, nullptr, stream>>>(
            x, y, z, tiling);
    } else {
        // FP32
        sub_custom<float><<<blockDim, nullptr, stream>>>(
            x, y, z, tiling);
    }
}
