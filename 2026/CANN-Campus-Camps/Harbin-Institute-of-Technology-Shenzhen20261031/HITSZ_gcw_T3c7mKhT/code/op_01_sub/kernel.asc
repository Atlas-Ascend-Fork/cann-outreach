#include "kernel_operator.h"

// The assignment uses 16384 elements. Every tile is 32-byte aligned for
// both float32 and float16, so ordinary DataCopy needs no tail padding.
constexpr uint32_t SUB_TILE_LENGTH = 256;

template <typename T>
class KernelSub {
public:
    __aicore__ inline void Init(GM_ADDR x, GM_ADDR y, GM_ADDR z, uint32_t totalLength)
    {
        blockLength_ = totalLength / AscendC::GetBlockNum();
        uint32_t offset = blockLength_ * AscendC::GetBlockIdx();
        xGm_.SetGlobalBuffer((__gm__ T*)x + offset, blockLength_);
        yGm_.SetGlobalBuffer((__gm__ T*)y + offset, blockLength_);
        zGm_.SetGlobalBuffer((__gm__ T*)z + offset, blockLength_);
        pipe_.InitBuffer(xQueue_, 1, SUB_TILE_LENGTH * sizeof(T));
        pipe_.InitBuffer(yQueue_, 1, SUB_TILE_LENGTH * sizeof(T));
        pipe_.InitBuffer(zQueue_, 1, SUB_TILE_LENGTH * sizeof(T));
    }

    __aicore__ inline void Process()
    {
        for (uint32_t offset = 0; offset < blockLength_; offset += SUB_TILE_LENGTH) {
            auto xLocal = xQueue_.AllocTensor<T>();
            auto yLocal = yQueue_.AllocTensor<T>();
            AscendC::DataCopy(xLocal, xGm_[offset], SUB_TILE_LENGTH);
            AscendC::DataCopy(yLocal, yGm_[offset], SUB_TILE_LENGTH);
            xQueue_.EnQue(xLocal);
            yQueue_.EnQue(yLocal);

            xLocal = xQueue_.DeQue<T>();
            yLocal = yQueue_.DeQue<T>();
            auto zLocal = zQueue_.AllocTensor<T>();
            AscendC::Sub(zLocal, xLocal, yLocal, SUB_TILE_LENGTH);
            zQueue_.EnQue(zLocal);
            xQueue_.FreeTensor(xLocal);
            yQueue_.FreeTensor(yLocal);

            zLocal = zQueue_.DeQue<T>();
            AscendC::DataCopy(zGm_[offset], zLocal, SUB_TILE_LENGTH);
            zQueue_.FreeTensor(zLocal);
        }
    }

private:
    AscendC::TPipe pipe_;
    AscendC::TQue<AscendC::QuePosition::VECIN, 1> xQueue_, yQueue_;
    AscendC::TQue<AscendC::QuePosition::VECOUT, 1> zQueue_;
    AscendC::GlobalTensor<T> xGm_, yGm_, zGm_;
    uint32_t blockLength_;
};

template <typename T>
__global__ __vector__ void sub_custom(GM_ADDR x, GM_ADDR y, GM_ADDR z, uint32_t totalLength)
{
    KernelSub<T> op;
    op.Init(x, y, z, totalLength);
    op.Process();
}

extern "C" void run_kernel(GM_ADDR x, const TensorGroupInfo& info_x, GM_ADDR y, const TensorGroupInfo& info_y, GM_ADDR z, const TensorGroupInfo& info_z, int64_t availableCoreNum, aclrtStream stream)
{
    const TensorInfo& input = info_x.tensors[0];
    uint32_t totalLength = 1;
    for (int64_t i = 0; i < input.numDims; ++i) {
        totalLength *= static_cast<uint32_t>(input.shape[i]);
    }

    // A power-of-two core count keeps the fixed 16384-element shape evenly
    // partitioned, including when fewer than eight vector cores are available.
    uint32_t blockNum = 1;
    while (blockNum < 8 && static_cast<int64_t>(blockNum * 2) <= availableCoreNum) {
        blockNum *= 2;
    }

    if (input.dtype == 1) {
        sub_custom<half><<<blockNum, nullptr, stream>>>(x, y, z, totalLength);
    } else {
        sub_custom<float><<<blockNum, nullptr, stream>>>(x, y, z, totalLength);
    }
}
