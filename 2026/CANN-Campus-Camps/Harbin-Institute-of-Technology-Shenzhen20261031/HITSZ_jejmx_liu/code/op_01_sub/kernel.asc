#include <cmath>
#include "kernel_operator.h"

/*
 * Sub Kernel — Ascend C Direct Invocation
 * z = x - y
 *
 * Supported dtype:
 *   0: float32
 *   1: float16
 *
 * Shape:
 *   (8, 2048)
 */

constexpr uint32_t MAX_BLOCK_NUM = 8;

template <typename T>
class KernelSub {
public:
    __aicore__ inline KernelSub() {}

    __aicore__ inline void Init(
        GM_ADDR x,
        GM_ADDR y,
        GM_ADDR z,
        uint32_t elementsPerCore)
    {
        this->elementsPerCore = elementsPerCore;

        uint32_t offset = AscendC::GetBlockIdx() * elementsPerCore;

        xGm.SetGlobalBuffer(
            reinterpret_cast<__gm__ T *>(x) + offset,
            elementsPerCore);
        yGm.SetGlobalBuffer(
            reinterpret_cast<__gm__ T *>(y) + offset,
            elementsPerCore);
        zGm.SetGlobalBuffer(
            reinterpret_cast<__gm__ T *>(z) + offset,
            elementsPerCore);

        pipe.InitBuffer(xQueue, 1, elementsPerCore * sizeof(T));
        pipe.InitBuffer(yQueue, 1, elementsPerCore * sizeof(T));
        pipe.InitBuffer(zQueue, 1, elementsPerCore * sizeof(T));
    }

    __aicore__ inline void Process()
    {
        CopyIn();
        Compute();
        CopyOut();
    }

private:
    __aicore__ inline void CopyIn()
    {
        AscendC::LocalTensor<T> xLocal = xQueue.AllocTensor<T>();
        AscendC::LocalTensor<T> yLocal = yQueue.AllocTensor<T>();

        AscendC::DataCopy(xLocal, xGm, elementsPerCore);
        AscendC::DataCopy(yLocal, yGm, elementsPerCore);

        xQueue.EnQue(xLocal);
        yQueue.EnQue(yLocal);
    }

    __aicore__ inline void Compute()
    {
        AscendC::LocalTensor<T> xLocal = xQueue.DeQue<T>();
        AscendC::LocalTensor<T> yLocal = yQueue.DeQue<T>();
        AscendC::LocalTensor<T> zLocal = zQueue.AllocTensor<T>();

        AscendC::Sub(zLocal, xLocal, yLocal, elementsPerCore);

        zQueue.EnQue(zLocal);
        xQueue.FreeTensor(xLocal);
        yQueue.FreeTensor(yLocal);
    }

    __aicore__ inline void CopyOut()
    {
        AscendC::LocalTensor<T> zLocal = zQueue.DeQue<T>();

        AscendC::DataCopy(zGm, zLocal, elementsPerCore);

        zQueue.FreeTensor(zLocal);
    }

private:
    AscendC::TPipe pipe;

    AscendC::TQue<AscendC::QuePosition::VECIN, 1> xQueue;
    AscendC::TQue<AscendC::QuePosition::VECIN, 1> yQueue;
    AscendC::TQue<AscendC::QuePosition::VECOUT, 1> zQueue;

    AscendC::GlobalTensor<T> xGm;
    AscendC::GlobalTensor<T> yGm;
    AscendC::GlobalTensor<T> zGm;

    uint32_t elementsPerCore;
};

template <typename T>
__global__ __vector__ void sub_custom(
    GM_ADDR x,
    GM_ADDR y,
    GM_ADDR z,
    uint32_t elementsPerCore)
{
    KernelSub<T> kernel;
    kernel.Init(x, y, z, elementsPerCore);
    kernel.Process();
}

extern "C" void run_kernel(
    GM_ADDR x,
    const TensorGroupInfo& info_x,
    GM_ADDR y,
    const TensorGroupInfo& info_y,
    GM_ADDR z,
    const TensorGroupInfo& info_z,
    int64_t availableCoreNum,
    aclrtStream stream)
{
    if (info_x.numTensors <= 0 ||
        info_y.numTensors <= 0 ||
        info_z.numTensors <= 0 ||
        info_x.tensors[0].numDims <= 0) {
        return;
    }

    uint64_t totalElements = 1;
    for (int64_t i = 0; i < info_x.tensors[0].numDims; ++i) {
        totalElements *=
            static_cast<uint64_t>(info_x.tensors[0].shape[i]);
    }

    /*
     * For the required shape (8, 2048), use eight vector cores.
     * 16384 / 8 = 2048 elements per core.
     *
     * If fewer than eight vector cores are available, use one core so
     * that the workload remains evenly divisible and 32-byte aligned.
     */
    uint32_t blockNum =
        availableCoreNum >= static_cast<int64_t>(MAX_BLOCK_NUM)
            ? MAX_BLOCK_NUM
            : 1;

    uint32_t elementsPerCore =
        static_cast<uint32_t>(totalElements / blockNum);

    int32_t dtype = info_x.tensors[0].dtype;

    if (dtype == 0) {
        sub_custom<float><<<blockNum, nullptr, stream>>>(
            x, y, z, elementsPerCore);
    } else if (dtype == 1) {
        sub_custom<half><<<blockNum, nullptr, stream>>>(
            x, y, z, elementsPerCore);
    }
}