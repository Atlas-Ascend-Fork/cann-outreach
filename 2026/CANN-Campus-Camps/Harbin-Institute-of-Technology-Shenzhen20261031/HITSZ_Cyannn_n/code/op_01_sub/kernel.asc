#include <cstdint>
#include "kernel_operator.h"

namespace {
constexpr uint32_t kTileElements = 1024;
constexpr uint32_t kAlignBytes = 32;

template <typename T>
class SubKernel {
public:
    __aicore__ inline void Init(GM_ADDR x, GM_ADDR y, GM_ADDR z,
                                uint64_t total, uint64_t blocksPerCore)
    {
        const uint64_t start = AscendC::GetBlockIdx() * blocksPerCore * (kAlignBytes / sizeof(T));
        const uint64_t endCandidate = start + blocksPerCore * (kAlignBytes / sizeof(T));
        const uint64_t end = endCandidate < total ? endCandidate : total;
        length_ = start < total ? end - start : 0;
        x_.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(x) + start, length_);
        y_.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(y) + start, length_);
        z_.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(z) + start, length_);
        pipe_.InitBuffer(xQueue_, 1, kTileElements * sizeof(T));
        pipe_.InitBuffer(yQueue_, 1, kTileElements * sizeof(T));
        pipe_.InitBuffer(zQueue_, 1, kTileElements * sizeof(T));
    }

    __aicore__ inline void Process()
    {
        const uint64_t alignedLength = length_ / (kAlignBytes / sizeof(T)) * (kAlignBytes / sizeof(T));
        for (uint64_t offset = 0; offset < alignedLength; offset += kTileElements) {
            const uint32_t count = static_cast<uint32_t>(
                alignedLength - offset < kTileElements ? alignedLength - offset : kTileElements);
            auto xLocal = xQueue_.AllocTensor<T>();
            auto yLocal = yQueue_.AllocTensor<T>();
            AscendC::DataCopy(xLocal, x_[offset], count);
            AscendC::DataCopy(yLocal, y_[offset], count);
            xQueue_.EnQue(xLocal);
            yQueue_.EnQue(yLocal);
            xLocal = xQueue_.DeQue<T>();
            yLocal = yQueue_.DeQue<T>();
            auto zLocal = zQueue_.AllocTensor<T>();
            AscendC::Sub(zLocal, xLocal, yLocal, count);
            zQueue_.EnQue(zLocal);
            xQueue_.FreeTensor(xLocal);
            yQueue_.FreeTensor(yLocal);
            zLocal = zQueue_.DeQue<T>();
            AscendC::DataCopy(z_[offset], zLocal, count);
            zQueue_.FreeTensor(zLocal);
        }
    }

private:
    AscendC::TPipe pipe_;
    AscendC::TQue<AscendC::QuePosition::VECIN, 1> xQueue_, yQueue_;
    AscendC::TQue<AscendC::QuePosition::VECOUT, 1> zQueue_;
    AscendC::GlobalTensor<T> x_, y_, z_;
    uint64_t length_;
};
}

template <typename T>
__global__ __vector__ void sub_custom(GM_ADDR x, GM_ADDR y, GM_ADDR z,
                                      uint64_t total, uint64_t blocksPerCore)
{
    if (static_cast<uint64_t>(AscendC::GetBlockIdx()) * blocksPerCore * (kAlignBytes / sizeof(T)) >= total) return;
    SubKernel<T> kernel;
    kernel.Init(x, y, z, total, blocksPerCore);
    kernel.Process();
}

extern "C" void run_kernel(GM_ADDR x, const TensorGroupInfo& info_x,
                            GM_ADDR y, const TensorGroupInfo& info_y,
                            GM_ADDR z, const TensorGroupInfo& info_z,
                            int64_t availableCoreNum, aclrtStream stream)
{
    (void)info_y;
    (void)info_z;
    if (availableCoreNum <= 0 || info_x.numTensors <= 0) return;
    const TensorInfo& tensor = info_x.tensors[0];
    uint64_t total = 1;
    for (int64_t i = 0; i < tensor.numDims; ++i) {
        if (tensor.shape[i] <= 0) return;
        total *= static_cast<uint64_t>(tensor.shape[i]);
    }
    if (tensor.dtype != 0 && tensor.dtype != 1) return;
    const uint32_t alignElements = kAlignBytes / (tensor.dtype == 0 ? sizeof(float) : sizeof(half));
    const uint64_t alignedBlocks = (total + alignElements - 1) / alignElements;
    const uint32_t coreCount = static_cast<uint32_t>(
        alignedBlocks < static_cast<uint64_t>(availableCoreNum) ? alignedBlocks : availableCoreNum);
    const uint64_t blocksPerCore = (alignedBlocks + coreCount - 1) / coreCount;
    const uint32_t activeCoreCount = static_cast<uint32_t>(
        (alignedBlocks + blocksPerCore - 1) / blocksPerCore);
    if (tensor.dtype == 0) {
        sub_custom<float><<<activeCoreCount, nullptr, stream>>>(x, y, z, total, blocksPerCore);
    } else {
        sub_custom<half><<<activeCoreCount, nullptr, stream>>>(x, y, z, total, blocksPerCore);
    }
}