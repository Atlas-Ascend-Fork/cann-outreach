#include "kernel_operator.h"

// Each row is a complete, 32-byte-aligned DMA tile for both supported dtypes.
constexpr uint32_t SUB_ROWS = 8;
constexpr uint32_t SUB_COLUMNS = 2048;
constexpr uint32_t SUB_ELEMENTS = SUB_ROWS * SUB_COLUMNS;

template <typename T>
class KernelSub {
public:
    __aicore__ inline void Init(GM_ADDR x, GM_ADDR y, GM_ADDR z)
    {
        xGm.SetGlobalBuffer((__gm__ T*)x, SUB_ELEMENTS);
        yGm.SetGlobalBuffer((__gm__ T*)y, SUB_ELEMENTS);
        zGm.SetGlobalBuffer((__gm__ T*)z, SUB_ELEMENTS);
        pipe.InitBuffer(inQueueX, 1, SUB_COLUMNS * sizeof(T));
        pipe.InitBuffer(inQueueY, 1, SUB_COLUMNS * sizeof(T));
        pipe.InitBuffer(outQueueZ, 1, SUB_COLUMNS * sizeof(T));
    }

    __aicore__ inline void Process()
    {
        // Striding rows also covers devices exposing fewer than eight cores.
        for (uint32_t row = AscendC::GetBlockIdx(); row < SUB_ROWS;
             row += AscendC::GetBlockNum()) {
            const uint32_t offset = row * SUB_COLUMNS;
            CopyIn(offset);
            Compute();
            CopyOut(offset);
        }
    }

private:
    __aicore__ inline void CopyIn(uint32_t offset)
    {
        AscendC::LocalTensor<T> xLocal = inQueueX.AllocTensor<T>();
        AscendC::LocalTensor<T> yLocal = inQueueY.AllocTensor<T>();
        AscendC::DataCopy(xLocal, xGm[offset], SUB_COLUMNS);
        AscendC::DataCopy(yLocal, yGm[offset], SUB_COLUMNS);
        inQueueX.EnQue(xLocal);
        inQueueY.EnQue(yLocal);
    }

    __aicore__ inline void Compute()
    {
        AscendC::LocalTensor<T> xLocal = inQueueX.DeQue<T>();
        AscendC::LocalTensor<T> yLocal = inQueueY.DeQue<T>();
        AscendC::LocalTensor<T> zLocal = outQueueZ.AllocTensor<T>();
        AscendC::Sub(zLocal, xLocal, yLocal, SUB_COLUMNS);
        outQueueZ.EnQue(zLocal);
        inQueueX.FreeTensor(xLocal);
        inQueueY.FreeTensor(yLocal);
    }

    __aicore__ inline void CopyOut(uint32_t offset)
    {
        AscendC::LocalTensor<T> zLocal = outQueueZ.DeQue<T>();
        AscendC::DataCopy(zGm[offset], zLocal, SUB_COLUMNS);
        outQueueZ.FreeTensor(zLocal);
    }

    AscendC::TPipe pipe;
    AscendC::TQue<AscendC::QuePosition::VECIN, 1> inQueueX, inQueueY;
    AscendC::TQue<AscendC::QuePosition::VECOUT, 1> outQueueZ;
    AscendC::GlobalTensor<T> xGm, yGm, zGm;
};

template <typename T>
__global__ __vector__ void sub_custom(GM_ADDR x, GM_ADDR y, GM_ADDR z)
{
    KernelSub<T> op;
    op.Init(x, y, z);
    op.Process();
}

static bool IsSubTensorValid(const TensorGroupInfo& group)
{
    if (group.numTensors != 1 || group.tensors == nullptr) {
        return false;
    }
    const TensorInfo& tensor = group.tensors[0];
    return tensor.numDims == 2 && tensor.shape != nullptr &&
           tensor.shape[0] == SUB_ROWS && tensor.shape[1] == SUB_COLUMNS &&
           (tensor.dtype == 0 || tensor.dtype == 1);
}

extern "C" void run_kernel(GM_ADDR x, const TensorGroupInfo& info_x,
                           GM_ADDR y, const TensorGroupInfo& info_y,
                           GM_ADDR z, const TensorGroupInfo& info_z,
                           int64_t availableCoreNum, aclrtStream stream)
{
    if (availableCoreNum <= 0 || !IsSubTensorValid(info_x) ||
        !IsSubTensorValid(info_y) || !IsSubTensorValid(info_z)) {
        return;
    }
    const int32_t dtype = info_x.tensors[0].dtype;
    if (info_y.tensors[0].dtype != dtype || info_z.tensors[0].dtype != dtype) {
        return;
    }
    const uint32_t blockNum = static_cast<uint32_t>(
        availableCoreNum < SUB_ROWS ? availableCoreNum : SUB_ROWS);
    if (dtype == 0) {
        sub_custom<float><<<blockNum, nullptr, stream>>>(x, y, z);
    } else {
        sub_custom<half><<<blockNum, nullptr, stream>>>(x, y, z);
    }
}
