#include <cmath>
#include "kernel_operator.h"

using namespace AscendC;

// 固定输入形状：(8, 2048)，总元素数为 16384。
// 每个 Block 处理一段连续数据，按 256 个元素分块完成搬入、减法和搬出。
template <typename T>
class KernelSub {
public:
    __aicore__ inline KernelSub() {}

    __aicore__ inline void Init(
        GM_ADDR x,
        GM_ADDR y,
        GM_ADDR z,
        uint32_t blockLength,
        uint32_t tileLength)
    {
        this->blockLength = blockLength;
        this->tileLength = tileLength;
        this->tileNum = blockLength / tileLength;

        const uint32_t offset = blockLength * GetBlockIdx();
        xGm.SetGlobalBuffer((__gm__ T*)x + offset, blockLength);
        yGm.SetGlobalBuffer((__gm__ T*)y + offset, blockLength);
        zGm.SetGlobalBuffer((__gm__ T*)z + offset, blockLength);

        pipe.InitBuffer(inQueueX, 1, tileLength * sizeof(T));
        pipe.InitBuffer(inQueueY, 1, tileLength * sizeof(T));
        pipe.InitBuffer(outQueueZ, 1, tileLength * sizeof(T));
    }

    __aicore__ inline void Process()
    {
        for (uint32_t i = 0; i < tileNum; ++i) {
            CopyIn(i);
            Compute();
            CopyOut(i);
        }
    }

private:
    __aicore__ inline void CopyIn(uint32_t progress)
    {
        LocalTensor<T> xLocal = inQueueX.AllocTensor<T>();
        LocalTensor<T> yLocal = inQueueY.AllocTensor<T>();

        DataCopy(xLocal, xGm[progress * tileLength], tileLength);
        DataCopy(yLocal, yGm[progress * tileLength], tileLength);

        inQueueX.EnQue(xLocal);
        inQueueY.EnQue(yLocal);
    }

    __aicore__ inline void Compute()
    {
        LocalTensor<T> xLocal = inQueueX.DeQue<T>();
        LocalTensor<T> yLocal = inQueueY.DeQue<T>();
        LocalTensor<T> zLocal = outQueueZ.AllocTensor<T>();

        Sub(zLocal, xLocal, yLocal, tileLength);

        outQueueZ.EnQue<T>(zLocal);
        inQueueX.FreeTensor(xLocal);
        inQueueY.FreeTensor(yLocal);
    }

    __aicore__ inline void CopyOut(uint32_t progress)
    {
        LocalTensor<T> zLocal = outQueueZ.DeQue<T>();
        DataCopy(zGm[progress * tileLength], zLocal, tileLength);
        outQueueZ.FreeTensor(zLocal);
    }

private:
    TPipe pipe;
    TQue<QuePosition::VECIN, 1> inQueueX;
    TQue<QuePosition::VECIN, 1> inQueueY;
    TQue<QuePosition::VECOUT, 1> outQueueZ;

    GlobalTensor<T> xGm;
    GlobalTensor<T> yGm;
    GlobalTensor<T> zGm;

    uint32_t blockLength;
    uint32_t tileLength;
    uint32_t tileNum;
};

// 同一份 Kernel 通过模板分别支持 float32 和 float16。
template <typename T>
__global__ __vector__ void sub_custom(
    GM_ADDR x,
    GM_ADDR y,
    GM_ADDR z,
    uint32_t blockLength,
    uint32_t tileLength)
{
    KernelSub<T> op;
    op.Init(x, y, z, blockLength, tileLength);
    op.Process();
}

extern "C" void run_kernel(
    GM_ADDR x,
    const TensorGroupInfo& info_x,
    GM_ADDR y,
    const TensorGroupInfo& info_y,
    GM_ADDR z,
    const TensorGroupInfo& info_z,
    int64_t availableCoreNum,
    aclrtStream stream)
{
    constexpr uint32_t totalLength = 8 * 2048;
    constexpr uint32_t tileLength = 256;

    // 最多启动 64 个 Block；选择不超过可用核数的最大 2 次幂。
    // 这样每个 Block 的数据量均为 256 的整数倍，满足本题数据搬运对齐要求。
    uint32_t maxBlockNum = 1;
    if (availableCoreNum > 0) {
        maxBlockNum = (availableCoreNum >= 64)
            ? 64
            : static_cast<uint32_t>(availableCoreNum);
    }

    uint32_t blockNum = 1;
    while ((blockNum << 1) <= maxBlockNum) {
        blockNum <<= 1;
    }

    const uint32_t blockLength = totalLength / blockNum;

    // dtype: 0 = float32，1 = float16；输入和输出类型应保持一致。
    const int32_t dtypeX = info_x.tensors[0].dtype;
    const int32_t dtypeY = info_y.tensors[0].dtype;
    const int32_t dtypeZ = info_z.tensors[0].dtype;

    if (dtypeX == 0 && dtypeY == 0 && dtypeZ == 0) {
        sub_custom<float><<<blockNum, nullptr, stream>>>(
            x, y, z, blockLength, tileLength);
    } else if (dtypeX == 1 && dtypeY == 1 && dtypeZ == 1) {
        sub_custom<half><<<blockNum, nullptr, stream>>>(
            x, y, z, blockLength, tileLength);
    }
}
