#include <cmath>
#include "kernel_operator.h"
/*
 * Sub Kernel — Ascend C Direct Invocation
 * This file is #included — do NOT add main(), #pragma once, or include guards.
 *
 * TensorGroupInfo / TensorInfo (predefined):
 *   struct TensorInfo { const int64_t* shape; int64_t numDims; int32_t dtype; };
 *   struct TensorGroupInfo { const TensorInfo* tensors; int64_t numTensors; };
 *   dtype: 0=fp32 1=fp16 2=bf16 3=int8 4=int16 5=int32 6=int64 7=uint8 8=uint16 9=uint32 10=uint64 11=bool
 *   Usage: info_x.tensors[0].shape[0]  // first dim of first tensor in input x
 */

constexpr uint32_t SUB_TILE_LENGTH = 1024;

template <typename T>
class KernelSub {
public:
    __aicore__ inline KernelSub(AscendC::TPipe* pipe) : pipe_(pipe) {}

    __aicore__ inline void Init(GM_ADDR x, GM_ADDR y, GM_ADDR z,
                                uint32_t total, uint32_t numPerCore)
    {
        uint32_t blockIdx = AscendC::GetBlockIdx();
        uint32_t start = blockIdx * numPerCore;
        if (start >= total) {
            length_ = 0;
            return;
        }
        length_ = total - start;
        if (length_ > numPerCore) {
            length_ = numPerCore;
        }
        tileNum_ = (length_ + SUB_TILE_LENGTH - 1) / SUB_TILE_LENGTH;

        xGm_.SetGlobalBuffer((__gm__ T*)x + start, length_);
        yGm_.SetGlobalBuffer((__gm__ T*)y + start, length_);
        zGm_.SetGlobalBuffer((__gm__ T*)z + start, length_);

        pipe_->InitBuffer(inQueueX_, 1, SUB_TILE_LENGTH * sizeof(T));
        pipe_->InitBuffer(inQueueY_, 1, SUB_TILE_LENGTH * sizeof(T));
        pipe_->InitBuffer(outQueueZ_, 1, SUB_TILE_LENGTH * sizeof(T));
    }

    __aicore__ inline void Process()
    {
        for (uint32_t i = 0; i < tileNum_; i++) {
            uint32_t offset = i * SUB_TILE_LENGTH;
            uint32_t count = length_ - offset;
            if (count > SUB_TILE_LENGTH) {
                count = SUB_TILE_LENGTH;
            }
            CopyIn(offset, count);
            Compute(count);
            CopyOut(offset, count);
        }
    }

    __aicore__ inline void CopyIn(uint32_t offset, uint32_t count)
    {
        AscendC::LocalTensor<T> xLocal = inQueueX_.AllocTensor<T>();
        AscendC::LocalTensor<T> yLocal = inQueueY_.AllocTensor<T>();

        AscendC::DataCopyExtParams params(1, static_cast<uint32_t>(count * sizeof(T)), 0, 0, 0);
        AscendC::DataCopyPadExtParams<T> padParams;
        AscendC::DataCopyPad(xLocal, xGm_[offset], params, padParams);
        AscendC::DataCopyPad(yLocal, yGm_[offset], params, padParams);

        inQueueX_.EnQue(xLocal);
        inQueueY_.EnQue(yLocal);
    }

    __aicore__ inline void Compute(uint32_t count)
    {
        AscendC::LocalTensor<T> xLocal = inQueueX_.DeQue<T>();
        AscendC::LocalTensor<T> yLocal = inQueueY_.DeQue<T>();
        AscendC::LocalTensor<T> zLocal = outQueueZ_.AllocTensor<T>();

        AscendC::Sub(zLocal, xLocal, yLocal, static_cast<int32_t>(count));

        outQueueZ_.EnQue(zLocal);
        inQueueX_.FreeTensor(xLocal);
        inQueueY_.FreeTensor(yLocal);
    }

    __aicore__ inline void CopyOut(uint32_t offset, uint32_t count)
    {
        AscendC::LocalTensor<T> zLocal = outQueueZ_.DeQue<T>();
        AscendC::DataCopyExtParams params(1, static_cast<uint32_t>(count * sizeof(T)), 0, 0, 0);
        AscendC::DataCopyPad(zGm_[offset], zLocal, params);
        outQueueZ_.FreeTensor(zLocal);
    }

private:
    AscendC::TPipe* pipe_;
    AscendC::GlobalTensor<T> xGm_;
    AscendC::GlobalTensor<T> yGm_;
    AscendC::GlobalTensor<T> zGm_;
    AscendC::TQue<AscendC::TPosition::VECIN, 1> inQueueX_;
    AscendC::TQue<AscendC::TPosition::VECIN, 1> inQueueY_;
    AscendC::TQue<AscendC::TPosition::VECOUT, 1> outQueueZ_;
    uint32_t length_ = 0;
    uint32_t tileNum_ = 0;
};

template <typename T>
__aicore__ inline void SubKernelBody(GM_ADDR x, GM_ADDR y, GM_ADDR z,
                                     uint32_t total, uint32_t numPerCore)
{
    AscendC::TPipe pipe;
    KernelSub<T> op(&pipe);
    op.Init(x, y, z, total, numPerCore);
    op.Process();
}

extern "C" __global__ __vector__ void sub_kernel_fp32(GM_ADDR x, GM_ADDR y, GM_ADDR z,
                                                      uint32_t total, uint32_t numPerCore)
{
    SubKernelBody<float>(x, y, z, total, numPerCore);
}

extern "C" __global__ __vector__ void sub_kernel_fp16(GM_ADDR x, GM_ADDR y, GM_ADDR z,
                                                      uint32_t total, uint32_t numPerCore)
{
    SubKernelBody<half>(x, y, z, total, numPerCore);
}

extern "C" void run_kernel(GM_ADDR x, const TensorGroupInfo& info_x, GM_ADDR y, const TensorGroupInfo& info_y, GM_ADDR z, const TensorGroupInfo& info_z, int64_t availableCoreNum, aclrtStream stream)
{
    uint32_t total = 1;
    const TensorInfo& xInfo = info_x.tensors[0];
    for (int64_t i = 0; i < xInfo.numDims; i++) {
        total *= static_cast<uint32_t>(xInfo.shape[i]);
    }
    if (total == 0) {
        return;
    }

    uint32_t maxCores = availableCoreNum > 0 ? static_cast<uint32_t>(availableCoreNum) : 1;
    uint32_t blockNum = (total + SUB_TILE_LENGTH - 1) / SUB_TILE_LENGTH;
    if (blockNum > maxCores) {
        blockNum = maxCores;
    }
    if (blockNum == 0) {
        blockNum = 1;
    }
    uint32_t numPerCore = (total + blockNum - 1) / blockNum;
    blockNum = (total + numPerCore - 1) / numPerCore;

    int32_t dtype = xInfo.dtype;
    if (dtype == 1) {
        sub_kernel_fp16<<<blockNum, nullptr, stream>>>(x, y, z, total, numPerCore);
    } else {
        sub_kernel_fp32<<<blockNum, nullptr, stream>>>(x, y, z, total, numPerCore);
    }
}