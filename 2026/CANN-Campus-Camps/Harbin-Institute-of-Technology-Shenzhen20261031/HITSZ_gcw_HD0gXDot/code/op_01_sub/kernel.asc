
#include "kernel_operator.h"
#include <cstdint>

using namespace AscendC;

// 张量形状：(8, 2048)
constexpr uint32_t ROWS = 8;
constexpr uint32_t COLS = 2048;
constexpr uint32_t TOTAL = ROWS * COLS;

// T 可以是 float 或 half
template <typename T>
class KernelSub {
public:
    __aicore__ inline void Init(
        GM_ADDR x,
        GM_ADDR y,
        GM_ADDR z,
        uint32_t coreNum)
    {
        coreNum_ = coreNum;

        // 绑定全局内存
        xGm.SetGlobalBuffer((__gm__ T*)x, TOTAL);
        yGm.SetGlobalBuffer((__gm__ T*)y, TOTAL);
        zGm.SetGlobalBuffer((__gm__ T*)z, TOTAL);

        // 初始化片上缓冲区
        pipe.InitBuffer(
            inQueueX, 1, COLS * sizeof(T));
        pipe.InitBuffer(
            inQueueY, 1, COLS * sizeof(T));
        pipe.InitBuffer(
            outQueueZ, 1, COLS * sizeof(T));
    }

    __aicore__ inline void Process()
    {
        // 每个 Block 处理自己负责的行
        for (uint32_t row = GetBlockIdx();
             row < ROWS;
             row += coreNum_) {

            uint32_t offset = row * COLS;

            CopyIn(offset);
            Compute();
            CopyOut(offset);
        }
    }

private:
    __aicore__ inline void CopyIn(uint32_t offset)
    {
        LocalTensor<T> xLocal =
            inQueueX.AllocTensor<T>();

        LocalTensor<T> yLocal =
            inQueueY.AllocTensor<T>();

        DataCopy(xLocal, xGm[offset], COLS);
        DataCopy(yLocal, yGm[offset], COLS);

        inQueueX.EnQue(xLocal);
        inQueueY.EnQue(yLocal);
    }

    __aicore__ inline void Compute()
    {
        LocalTensor<T> xLocal =
            inQueueX.DeQue<T>();

        LocalTensor<T> yLocal =
            inQueueY.DeQue<T>();

        LocalTensor<T> zLocal =
            outQueueZ.AllocTensor<T>();

        // 核心：z = x - y
        Sub(zLocal, xLocal, yLocal, COLS);

        outQueueZ.EnQue(zLocal);

        inQueueX.FreeTensor(xLocal);
        inQueueY.FreeTensor(yLocal);
    }

    __aicore__ inline void CopyOut(uint32_t offset)
    {
        LocalTensor<T> zLocal =
            outQueueZ.DeQue<T>();

        DataCopy(zGm[offset], zLocal, COLS);

        outQueueZ.FreeTensor(zLocal);
    }

private:
    uint32_t coreNum_;

    TPipe pipe;

    TQue<QuePosition::VECIN, 1> inQueueX;
    TQue<QuePosition::VECIN, 1> inQueueY;
    TQue<QuePosition::VECOUT, 1> outQueueZ;

    GlobalTensor<T> xGm;
    GlobalTensor<T> yGm;
    GlobalTensor<T> zGm;
};

// float32 Kernel
extern "C" __global__ __aicore__
void sub_fp32(
    GM_ADDR x, GM_ADDR y, GM_ADDR z,
    uint32_t coreNum)
{
    KernelSub<float> op;
    op.Init(x, y, z, coreNum);
    op.Process();
}

// float16 Kernel
extern "C" __global__ __aicore__
void sub_fp16(
    GM_ADDR x, GM_ADDR y, GM_ADDR z,
    uint32_t coreNum)
{
    KernelSub<half> op;
    op.Init(x, y, z, coreNum);
    op.Process();
}

// CANNJudge 调用入口
extern "C" void run_kernel(
    GM_ADDR x, const TensorGroupInfo& info_x,
    GM_ADDR y, const TensorGroupInfo& info_y,
    GM_ADDR z, const TensorGroupInfo& info_z,
    int64_t availableCoreNum,
    aclrtStream stream)
{
    (void)info_y;
    (void)info_z;

    if (availableCoreNum <= 0 ||
        info_x.numTensors < 1 ||
        info_x.tensors == nullptr) {
        return;
    }

    uint32_t coreNum =
        availableCoreNum >= 8
            ? 8
            : static_cast<uint32_t>(availableCoreNum);

    // CANNJudge TensorInfo dtype 编码
    int32_t dtype = info_x.tensors[0].dtype;

    if (dtype == 0) {
        // float32
        sub_fp32<<<coreNum, nullptr, stream>>>(
            x, y, z, coreNum);
    }
    else if (dtype == 1) {
        // float16
        sub_fp16<<<coreNum, nullptr, stream>>>(
            x, y, z, coreNum);
    }
}
