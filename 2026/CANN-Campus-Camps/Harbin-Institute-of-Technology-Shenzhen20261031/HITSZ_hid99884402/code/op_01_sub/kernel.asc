#include "kernel_operator.h"

namespace {

constexpr uint32_t SUB_FAST_TOTAL = 8u * 2048u;
constexpr uint32_t SUB_FAST_TARGET_CORES = 8u;
constexpr uint32_t SUB_ALIGN_BYTES = 32u;

template <typename T, uint32_t BLOCK_LENGTH>
__global__ __vector__ void sub_fast(GM_ADDR x, GM_ADDR y, GM_ADDR z)
{
    static_assert(BLOCK_LENGTH * sizeof(T) % SUB_ALIGN_BYTES == 0, "block must be 32B aligned");

    AscendC::InitSocState();

    constexpr uint32_t BLOCK_BYTES = BLOCK_LENGTH * static_cast<uint32_t>(sizeof(T));
    const uint32_t offset = static_cast<uint32_t>(AscendC::GetBlockIdx()) * BLOCK_LENGTH;

    AscendC::GlobalTensor<T> xGm;
    AscendC::GlobalTensor<T> yGm;
    AscendC::GlobalTensor<T> zGm;
    xGm.SetGlobalBuffer((__gm__ T *)x + offset, BLOCK_LENGTH);
    yGm.SetGlobalBuffer((__gm__ T *)y + offset, BLOCK_LENGTH);
    zGm.SetGlobalBuffer((__gm__ T *)z + offset, BLOCK_LENGTH);

    AscendC::LocalTensor<T> xLocal(AscendC::TPosition::VECIN, 0, BLOCK_LENGTH);
    AscendC::LocalTensor<T> yLocal(AscendC::TPosition::VECIN, BLOCK_BYTES, BLOCK_LENGTH);
    AscendC::LocalTensor<T> zLocal(AscendC::TPosition::VECOUT, 2u * BLOCK_BYTES, BLOCK_LENGTH);

    AscendC::DataCopy(xLocal, xGm, BLOCK_LENGTH);
    AscendC::DataCopy(yLocal, yGm, BLOCK_LENGTH);
    AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(0);
    AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(0);

    AscendC::Sub(zLocal, xLocal, yLocal, BLOCK_LENGTH);
    AscendC::SetFlag<AscendC::HardEvent::V_MTE3>(0);
    AscendC::WaitFlag<AscendC::HardEvent::V_MTE3>(0);

    AscendC::DataCopy(zGm, zLocal, BLOCK_LENGTH);
    AscendC::PipeBarrier<PIPE_ALL>();
}

template <typename T>
inline void LaunchFast(GM_ADDR x, GM_ADDR y, GM_ADDR z, uint32_t blockNum, aclrtStream stream)
{
    switch (blockNum) {
        case 1:
            sub_fast<T, SUB_FAST_TOTAL><<<1, nullptr, stream>>>(x, y, z);
            break;
        case 2:
            sub_fast<T, SUB_FAST_TOTAL / 2><<<2, nullptr, stream>>>(x, y, z);
            break;
        case 4:
            sub_fast<T, SUB_FAST_TOTAL / 4><<<4, nullptr, stream>>>(x, y, z);
            break;
        case 8:
            sub_fast<T, SUB_FAST_TOTAL / 8><<<8, nullptr, stream>>>(x, y, z);
            break;
        case 16:
            sub_fast<T, SUB_FAST_TOTAL / 16><<<16, nullptr, stream>>>(x, y, z);
            break;
        case 32:
            sub_fast<T, SUB_FAST_TOTAL / 32><<<32, nullptr, stream>>>(x, y, z);
            break;
        default:
            break;
    }
}

}  // namespace

extern "C" void run_kernel(GM_ADDR x, const TensorGroupInfo& info_x, GM_ADDR y,
                           const TensorGroupInfo& info_y, GM_ADDR z,
                           const TensorGroupInfo& info_z, int64_t availableCoreNum,
                           aclrtStream stream)
{
    (void)info_y;
    (void)info_z;

    const uint32_t limit = (availableCoreNum > 0)
                               ? static_cast<uint32_t>(availableCoreNum)
                               : SUB_FAST_TARGET_CORES;

    uint32_t blockNum = 1;
    while (blockNum < SUB_FAST_TARGET_CORES && blockNum * 2u <= limit) {
        blockNum *= 2u;
    }

    if (info_x.tensors[0].dtype == 1) {
        LaunchFast<half>(x, y, z, blockNum, stream);
    } else {
        LaunchFast<float>(x, y, z, blockNum, stream);
    }
}
