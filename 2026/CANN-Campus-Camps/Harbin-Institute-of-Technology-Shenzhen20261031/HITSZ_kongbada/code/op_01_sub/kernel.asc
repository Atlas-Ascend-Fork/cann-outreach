#include <cstdint>
#include "kernel_operator.h"

// Included by the harness, which defines TensorInfo and TensorGroupInfo.
// Inputs and output must have the same shape and dtype (0: float32, 1: float16).
namespace sub_detail {
constexpr uint32_t TILE_ELEMENTS = 2048;
constexpr int32_t BUFFER_COUNT = 2;

template <typename T>
class KernelSub {
public:
    __aicore__ inline void Init(GM_ADDR x, GM_ADDR y, GM_ADDR z, uint64_t totalLength)
    {
        // Split in 32-byte units so adjacent cores never share a DMA block.
        const uint64_t alignElements = 32 / sizeof(T);
        const uint64_t groups = (totalLength + alignElements - 1) / alignElements;
        const uint64_t coreCount = AscendC::GetBlockNum();
        const uint64_t core = AscendC::GetBlockIdx();
        const uint64_t baseGroups = groups / coreCount;
        const uint64_t extraGroups = groups % coreCount;
        const uint64_t startGroup = core * baseGroups + (core < extraGroups ? core : extraGroups);
        const uint64_t localGroups = baseGroups + (core < extraGroups ? 1 : 0);
        const uint64_t offset = startGroup * alignElements;
        const uint64_t capacity = localGroups * alignElements;
        length_ = offset < totalLength ? totalLength - offset : 0;
        length_ = length_ < capacity ? length_ : capacity;

        xGm_.SetGlobalBuffer((__gm__ T*)x + offset, length_);
        yGm_.SetGlobalBuffer((__gm__ T*)y + offset, length_);
        zGm_.SetGlobalBuffer((__gm__ T*)z + offset, length_);
        pipe_.InitBuffer(inX_, BUFFER_COUNT, TILE_ELEMENTS * sizeof(T));
        pipe_.InitBuffer(inY_, BUFFER_COUNT, TILE_ELEMENTS * sizeof(T));
        pipe_.InitBuffer(outZ_, BUFFER_COUNT, TILE_ELEMENTS * sizeof(T));
    }

    __aicore__ inline void Process()
    {
        for (uint64_t offset = 0; offset < length_; offset += TILE_ELEMENTS) {
            const uint64_t remaining = length_ - offset;
            const uint32_t count = remaining < TILE_ELEMENTS ? static_cast<uint32_t>(remaining) : TILE_ELEMENTS;
            CopyIn(offset, count);
            Compute(count);
            CopyOut(offset, count);
        }
    }

private:
    __aicore__ inline void CopyIn(uint64_t offset, uint32_t count)
    {
        AscendC::LocalTensor<T> xLocal = inX_.template AllocTensor<T>();
        AscendC::LocalTensor<T> yLocal = inY_.template AllocTensor<T>();
        if (count % (32 / sizeof(T)) == 0) {
            AscendC::DataCopy(xLocal, xGm_[offset], count);
            AscendC::DataCopy(yLocal, yGm_[offset], count);
        } else {
            // Copy only valid bytes; padding stays inside the local buffer.
            AscendC::DataCopyExtParams params{1, static_cast<uint32_t>(count * sizeof(T)), 0, 0, 0};
            AscendC::DataCopyPadExtParams<T> padding{false, 0, 0, 0};
            AscendC::DataCopyPad(xLocal, xGm_[offset], params, padding);
            AscendC::DataCopyPad(yLocal, yGm_[offset], params, padding);
        }
        inX_.EnQue(xLocal);
        inY_.EnQue(yLocal);
    }

    __aicore__ inline void Compute(uint32_t count)
    {
        AscendC::LocalTensor<T> xLocal = inX_.template DeQue<T>();
        AscendC::LocalTensor<T> yLocal = inY_.template DeQue<T>();
        AscendC::LocalTensor<T> zLocal = outZ_.template AllocTensor<T>();
        AscendC::Sub(zLocal, xLocal, yLocal, count);
        outZ_.EnQue(zLocal);
        inX_.FreeTensor(xLocal);
        inY_.FreeTensor(yLocal);
    }

    __aicore__ inline void CopyOut(uint64_t offset, uint32_t count)
    {
        AscendC::LocalTensor<T> zLocal = outZ_.template DeQue<T>();
        if (count % (32 / sizeof(T)) == 0) {
            AscendC::DataCopy(zGm_[offset], zLocal, count);
        } else {
            AscendC::DataCopyExtParams params{1, static_cast<uint32_t>(count * sizeof(T)), 0, 0, 0};
            AscendC::DataCopyPad(zGm_[offset], zLocal, params);
        }
        outZ_.FreeTensor(zLocal);
    }

    AscendC::TPipe pipe_;
    AscendC::TQue<AscendC::TPosition::VECIN, BUFFER_COUNT> inX_, inY_;
    AscendC::TQue<AscendC::TPosition::VECOUT, BUFFER_COUNT> outZ_;
    AscendC::GlobalTensor<T> xGm_, yGm_, zGm_;
    uint64_t length_ = 0;
};
} // namespace sub_detail

template <typename T>
__global__ __vector__ void sub_custom(GM_ADDR x, GM_ADDR y, GM_ADDR z, uint64_t totalLength)
{
    sub_detail::KernelSub<T> op;
    op.Init(x, y, z, totalLength);
    op.Process();
}

// Fixed 8-core path: static UB storage, independent of the TPipe fallback.
template <typename T>
__global__ __vector__ void sub_fixed_8core(GM_ADDR x, GM_ADDR y, GM_ADDR z)
{
    AscendC::InitSocState();
    constexpr uint32_t count = 2048;
    constexpr uint32_t bytes = count * sizeof(T);
    const uint32_t offset = AscendC::GetBlockIdx() * count;
    // Byte offsets are 32-byte aligned and the three regions do not overlap.
    AscendC::LocalTensor<T> xLocal(AscendC::TPosition::VECCALC, 0, count);
    AscendC::LocalTensor<T> yLocal(AscendC::TPosition::VECCALC, bytes, count);
    AscendC::LocalTensor<T> zLocal(AscendC::TPosition::VECCALC, 2 * bytes, count);
    AscendC::GlobalTensor<T> xGm, yGm, zGm;
    xGm.SetGlobalBuffer((__gm__ T*)x + offset, count);
    yGm.SetGlobalBuffer((__gm__ T*)y + offset, count);
    zGm.SetGlobalBuffer((__gm__ T*)z + offset, count);

    // No TPipe in this kernel: static-tensor event IDs are managed explicitly.
    constexpr int32_t eventId = 0;
    AscendC::DataCopy(xLocal, xGm, count);
    AscendC::DataCopy(yLocal, yGm, count);
    AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(eventId);
    AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(eventId);
    AscendC::Sub(zLocal, xLocal, yLocal, count);
    AscendC::SetFlag<AscendC::HardEvent::V_MTE3>(eventId);
    AscendC::WaitFlag<AscendC::HardEvent::V_MTE3>(eventId);
    AscendC::DataCopy(zGm, zLocal, count);
    // Static storage has no TPipe destructor; explicitly finish the writeback.
    AscendC::PipeBarrier<PIPE_ALL>();
}

extern "C" void run_kernel(GM_ADDR x, const TensorGroupInfo& info_x,
                          GM_ADDR y, const TensorGroupInfo& info_y,
                          GM_ADDR z, const TensorGroupInfo& info_z,
                          int64_t availableCoreNum, aclrtStream stream)
{
    if (info_x.numTensors != 1 || info_y.numTensors != 1 || info_z.numTensors != 1 ||
        info_x.tensors == nullptr || info_y.tensors == nullptr || info_z.tensors == nullptr) {
        return;
    }
    const TensorInfo& tx = info_x.tensors[0];
    const TensorInfo& ty = info_y.tensors[0];
    const TensorInfo& tz = info_z.tensors[0];
    if ((tx.dtype != 0 && tx.dtype != 1) || tx.dtype != ty.dtype || tx.dtype != tz.dtype ||
        tx.numDims < 0 || tx.numDims != ty.numDims || tx.numDims != tz.numDims ||
        (tx.numDims > 0 && (tx.shape == nullptr || ty.shape == nullptr || tz.shape == nullptr))) {
        return;
    }
    int64_t totalLength = 1;
    for (int64_t dim = 0; dim < tx.numDims; ++dim) {
        const int64_t size = tx.shape[dim];
        if (size < 0 || size != ty.shape[dim] || size != tz.shape[dim] ||
            (size > 0 && totalLength > INT64_MAX / size)) {
            return;
        }
        totalLength *= size;
    }
    if (totalLength == 0) {
        return;
    }
    if (x == nullptr || y == nullptr || z == nullptr || availableCoreNum <= 0) {
        return;
    }

    if (tx.numDims == 2 && tx.shape[0] == 8 && tx.shape[1] == 2048 && availableCoreNum >= 8) {
        if (tx.dtype == 0) {
            sub_fixed_8core<float><<<8, nullptr, stream>>>(x, y, z);
        } else {
            sub_fixed_8core<half><<<8, nullptr, stream>>>(x, y, z);
        }
        return;
    }

    // Avoid launching more cores than useful tiles for this small operator.
    const int64_t usefulCores = (totalLength - 1) / sub_detail::TILE_ELEMENTS + 1;
    const uint32_t blockNum = static_cast<uint32_t>(
        availableCoreNum < usefulCores ? availableCoreNum : usefulCores);
    if (tx.dtype == 0) {
        sub_custom<float><<<blockNum, nullptr, stream>>>(x, y, z, static_cast<uint64_t>(totalLength));
    } else {
        sub_custom<half><<<blockNum, nullptr, stream>>>(x, y, z, static_cast<uint64_t>(totalLength));
    }
}
