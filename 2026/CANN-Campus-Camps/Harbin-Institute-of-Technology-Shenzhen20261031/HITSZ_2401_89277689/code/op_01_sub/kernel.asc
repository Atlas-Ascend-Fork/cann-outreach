#include <cstdint>
#include "kernel_operator.h"

// 本题固定输入形状：(8, 2048)
constexpr uint32_t SUB_FAST_TOTAL = 8 * 2048;

// 首先测试 8 核，之后可分别改成 16、32 对比。
// 8 是候选配置，并非已实测的最优核数。
constexpr uint32_t SUB_FAST_TARGET_CORES = 8;

static_assert(
    SUB_FAST_TARGET_CORES == 1 ||
    SUB_FAST_TARGET_CORES == 2 ||
    SUB_FAST_TARGET_CORES == 4 ||
    SUB_FAST_TARGET_CORES == 8 ||
    SUB_FAST_TARGET_CORES == 16 ||
    SUB_FAST_TARGET_CORES == 32,
    "Supported core counts: 1, 2, 4, 8, 16, 32"
);

// T：元素类型，float 或 half。
// BLOCK_LENGTH：每个计算核负责的元素数量。
template <typename T, uint32_t BLOCK_LENGTH>
__global__ __vector__ void sub_fast(
    GM_ADDR x, GM_ADDR y, GM_ADDR z)
{
    // 不使用 TPipe 时，需要手动初始化相关全局状态寄存器。
    AscendC::InitSocState();

    // 当前计算核在整个张量中的起始元素位置。
    const uint32_t offset =
        AscendC::GetBlockIdx() * BLOCK_LENGTH;

    AscendC::GlobalTensor<T> xGm;
    AscendC::GlobalTensor<T> yGm;
    AscendC::GlobalTensor<T> zGm;

    xGm.SetGlobalBuffer(
        (__gm__ T*)x + offset, BLOCK_LENGTH);
    yGm.SetGlobalBuffer(
        (__gm__ T*)y + offset, BLOCK_LENGTH);
    zGm.SetGlobalBuffer(
        (__gm__ T*)z + offset, BLOCK_LENGTH);

    // 每个局部缓冲区的字节数。
    constexpr uint32_t BUFFER_BYTES =
        BLOCK_LENGTH * sizeof(T);

    // 手动划分当前计算核的 UB 空间。
    // 第二个参数是 UB 内的字节偏移，第三个参数是元素数量。
    AscendC::LocalTensor<T> xLocal(
        AscendC::TPosition::VECIN,
        0,
        BLOCK_LENGTH);

    AscendC::LocalTensor<T> yLocal(
        AscendC::TPosition::VECIN,
        BUFFER_BYTES,
        BLOCK_LENGTH);

    AscendC::LocalTensor<T> zLocal(
        AscendC::TPosition::VECOUT,
        2 * BUFFER_BYTES,
        BLOCK_LENGTH);

    // 1. 将两个输入从 GM 搬入 UB。
    AscendC::DataCopy(xLocal, xGm, BLOCK_LENGTH);
    AscendC::DataCopy(yLocal, yGm, BLOCK_LENGTH);

    // 2. 等待输入搬运完成，再执行向量计算。
    AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(0);
    AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(0);

    // 3. 按元素计算 z = x - y。
    AscendC::Sub(
        zLocal, xLocal, yLocal, BLOCK_LENGTH);

    // 4. 等待计算完成，再搬出结果。
    AscendC::SetFlag<AscendC::HardEvent::V_MTE3>(0);
    AscendC::WaitFlag<AscendC::HardEvent::V_MTE3>(0);

    // 5. 将结果从 UB 写回 GM。
    AscendC::DataCopy(zGm, zLocal, BLOCK_LENGTH);

    // 在核函数结束前完成流水收尾同步。
    AscendC::PipeBarrier<PIPE_ALL>();
}

// Host 端选择不同的编译期分块长度。
template <typename T>
inline void LaunchSubFast(
    GM_ADDR x, GM_ADDR y, GM_ADDR z,
    uint32_t blockNum, aclrtStream stream)
{
    switch (blockNum) {
        case 32:
            sub_fast<T, SUB_FAST_TOTAL / 32>
                <<<32, nullptr, stream>>>(x, y, z);
            break;

        case 16:
            sub_fast<T, SUB_FAST_TOTAL / 16>
                <<<16, nullptr, stream>>>(x, y, z);
            break;

        case 8:
            sub_fast<T, SUB_FAST_TOTAL / 8>
                <<<8, nullptr, stream>>>(x, y, z);
            break;

        case 4:
            sub_fast<T, SUB_FAST_TOTAL / 4>
                <<<4, nullptr, stream>>>(x, y, z);
            break;

        case 2:
            sub_fast<T, SUB_FAST_TOTAL / 2>
                <<<2, nullptr, stream>>>(x, y, z);
            break;

        default:
            sub_fast<T, SUB_FAST_TOTAL>
                <<<1, nullptr, stream>>>(x, y, z);
            break;
    }
}

// 保留平台要求的函数接口。
extern "C" void run_kernel(
    GM_ADDR x, const TensorGroupInfo& info_x,
    GM_ADDR y, const TensorGroupInfo& info_y,
    GM_ADDR z, const TensorGroupInfo& info_z,
    int64_t availableCoreNum, aclrtStream stream)
{
    // 本题保证输入输出形状、类型一致。
    (void)info_y;
    (void)info_z;

    // 选取不超过目标核数、也不超过可用核数的 2 的幂。
    uint32_t blockNum = 1;

    while (
        blockNum < SUB_FAST_TARGET_CORES &&
        static_cast<int64_t>(blockNum * 2)
            <= availableCoreNum
    ) {
        blockNum *= 2;
    }

    // dtype 0：float32；dtype 1：float16。
    if (info_x.tensors[0].dtype == 0) {
        LaunchSubFast<float>(
            x, y, z, blockNum, stream);
    } else if (info_x.tensors[0].dtype == 1) {
        LaunchSubFast<half>(
            x, y, z, blockNum, stream);
    }
}