#include "kernel_operator.h"
using namespace AscendC;
template<typename T, uint32_t N>
__global__ __vector__ void sub_custom(GM_ADDR x, GM_ADDR y, GM_ADDR z) {
    LocalTensor<T> lx(TPosition::VECCALC, 0, N);
    LocalTensor<T> ly(TPosition::VECCALC, N * sizeof(T) + 256, N);
    LocalTensor<T> lz(TPosition::VECCALC, 65536, N);
    GlobalTensor<T> gx, gy, gz;
    uint32_t offset = GetBlockIdx() * N;
    gx.SetGlobalBuffer((__gm__ T*)x + offset, N);
    gy.SetGlobalBuffer((__gm__ T*)y + offset, N);
    gz.SetGlobalBuffer((__gm__ T*)z + offset, N);
    DataCopy(lx, gx, N);
    DataCopy(ly, gy, N);
    SetFlag<HardEvent::MTE2_V>(EVENT_ID0);
    WaitFlag<HardEvent::MTE2_V>(EVENT_ID0);
    Sub(lz, lx, ly, N);
    SetFlag<HardEvent::V_MTE3>(EVENT_ID0);
    WaitFlag<HardEvent::V_MTE3>(EVENT_ID0);
    DataCopy(gz, lz, N);
}
extern "C" void run_kernel(GM_ADDR x, const TensorGroupInfo& info_x,
    GM_ADDR y, const TensorGroupInfo& info_y,
    GM_ADDR z, const TensorGroupInfo& info_z,
    int64_t availableCoreNum, aclrtStream stream) {
    if (info_x.tensors[0].dtype == 0)
        sub_custom<float, 2048><<<8, nullptr, stream>>>(x, y, z);
    else
        sub_custom<half, 2048><<<8, nullptr, stream>>>(x, y, z);
}
