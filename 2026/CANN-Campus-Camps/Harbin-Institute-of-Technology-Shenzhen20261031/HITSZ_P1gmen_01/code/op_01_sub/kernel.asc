#include <cmath>
#include "kernel_operator.h"
/*
 * Sub Kernel — Ascend C Direct Invocation
 * This file is #included — do NOT add main(), #pragma once, or include guards.
 *
 * TensorGroupInfo / TensorInfo (predefined):
 *   struct TensorInfo { const int64_t* shape; int64_t numDims; int32_t dtype; };
 *   struct TensorGroupInfo { const TensorInfo* tensors; int64_t numTensors; };
 *   dtype: 0=fp32 1=fp16 2=bf16 3=int8 4=int16 5=int32 6=int64 7=uint8 8=uint16 9=uint32 10=uint64 11=bool
 *   Usage: info_x.tensors[0].shape[0]  // first dim of first tensor in input x
 */

// ---------------------------------------------------------------------------
// Tiling 参数：由 host 侧 run_kernel 计算后按值传给核函数
// ---------------------------------------------------------------------------
struct SubCustomTilingData {
    uint32_t totalLength;   // 待处理数据总长度（元素个数），例如 8 * 2048 = 16384
    uint32_t blockLength;   // 单个核处理的数据长度（元素个数），最后一个核可能不足
    uint32_t tileLength;    // 核内单次搬运/计算的块长度（元素个数），按 32Byte 对齐
};

constexpr uint32_t BUFFER_NUM = 2;    // 每队列 buffer 块数（Double Buffer）
constexpr uint32_t QUEUE_DEPTH = 1;   // 队列深度
constexpr uint32_t BLOCK_BYTES = 32;  // GM/UB 搬运的最小对齐粒度（32Byte）

// ---------------------------------------------------------------------------
// KernelSub：z = x - y，每核分块循环计算（模板化，支持 float / half 等类型）
// ---------------------------------------------------------------------------
template <typename T>
class KernelSub {
public:
    __aicore__ inline KernelSub() {}

    __aicore__ inline void Init(GM_ADDR x, GM_ADDR y, GM_ADDR z, const SubCustomTilingData& tiling)
    {
        this->totalLength = tiling.totalLength;
        this->blockLength = tiling.blockLength;
        this->tileLength = tiling.tileLength;

        // 多核切分：当前核处理 [startOffset, startOffset + length) 区间
        uint32_t blockIdx = (uint32_t)AscendC::GetBlockIdx();
        uint64_t start = (uint64_t)blockIdx * (uint64_t)this->blockLength;
        this->startOffset = (uint32_t)start;
        if (start < (uint64_t)this->totalLength) {
            uint32_t remain = this->totalLength - (uint32_t)start;
            this->length = (remain < this->blockLength) ? remain : this->blockLength;
        } else {
            this->length = 0;
        }

        // 设置每个核的 Global Memory 起始地址（关键的多核切分逻辑）
        xGm.SetGlobalBuffer((__gm__ T *)x + this->startOffset, this->length);
        yGm.SetGlobalBuffer((__gm__ T *)y + this->startOffset, this->length);
        zGm.SetGlobalBuffer((__gm__ T *)z + this->startOffset, this->length);

        // 为队列分配 UB 内存；长度按 32Byte 对齐（DataCopyPad 会按对齐粒度补零）
        uint32_t tileBytes = this->tileLength * (uint32_t)sizeof(T);
        if (tileBytes < BLOCK_BYTES) {
            tileBytes = BLOCK_BYTES;
        }
        pipe.InitBuffer(inQueueX, BUFFER_NUM, tileBytes);
        pipe.InitBuffer(inQueueY, BUFFER_NUM, tileBytes);
        pipe.InitBuffer(outQueueZ, BUFFER_NUM, tileBytes);
    }

    __aicore__ inline void Process()
    {
        // 按 tileLength 循环处理当前核负责的全部数据，最后一块可能不足 tileLength
        uint32_t offset = 0;
        while (offset < this->length) {
            uint32_t curLen = this->length - offset;
            if (curLen > this->tileLength) {
                curLen = this->tileLength;
            }
            CopyIn(offset, curLen);    // 搬入第 i 块数据
            Compute(curLen);           // 计算第 i 块数据
            CopyOut(offset, curLen);   // 搬出第 i 块结果
            offset += curLen;
        }
    }

private:
    __aicore__ inline void CopyIn(uint32_t offset, uint32_t curLen)
    {
        // 为 LocalTensor 分配内存
        AscendC::LocalTensor<T> xLocal = inQueueX.AllocTensor<T>();
        AscendC::LocalTensor<T> yLocal = inQueueY.AllocTensor<T>();
        if ((curLen * sizeof(T)) % BLOCK_BYTES == 0) {
            // 32Byte 对齐：走高效的 DataCopy
            AscendC::DataCopy(xLocal, xGm[offset], curLen);
            AscendC::DataCopy(yLocal, yGm[offset], curLen);
        } else {
            // 尾部不足 32Byte：DataCopyPad 支持任意字节长度，UB 侧自动补零
            AscendC::DataCopyExtParams copyParams;
            copyParams.blockCount = 1;
            copyParams.blockLen = (uint32_t)(curLen * sizeof(T));
            copyParams.srcStride = 0;
            copyParams.dstStride = 0;
            AscendC::DataCopyPadExtParams<T> padParams;
            padParams.isPad = false;
            padParams.leftPadding = 0;
            padParams.rightPadding = 0;
            padParams.paddingValue = 0;
            AscendC::DataCopyPad(xLocal, xGm[offset], copyParams, padParams);
            AscendC::DataCopyPad(yLocal, yGm[offset], copyParams, padParams);
        }
        // 将数据放入队列，通知 Compute 任务
        inQueueX.EnQue(xLocal);
        inQueueY.EnQue(yLocal);
    }

    __aicore__ inline void Compute(uint32_t curLen)
    {
        // 从输入队列获取数据
        AscendC::LocalTensor<T> xLocal = inQueueX.DeQue<T>();
        AscendC::LocalTensor<T> yLocal = inQueueY.DeQue<T>();
        // 为计算结果分配内存
        AscendC::LocalTensor<T> zLocal = outQueueZ.AllocTensor<T>();
        // 执行矢量减法计算：z = x - y
        AscendC::Sub(zLocal, xLocal, yLocal, (int32_t)curLen);
        // 将计算结果放入输出队列，通知 CopyOut 任务
        outQueueZ.EnQue<T>(zLocal);
        // 释放输入数据内存（重要：避免内存泄漏）
        inQueueX.FreeTensor(xLocal);
        inQueueY.FreeTensor(yLocal);
    }

    __aicore__ inline void CopyOut(uint32_t offset, uint32_t curLen)
    {
        // 从输出队列获取计算结果
        AscendC::LocalTensor<T> zLocal = outQueueZ.DeQue<T>();
        // 将结果从 Local Memory 搬出到 Global Memory（只写 curLen 个元素对应的字节）
        if ((curLen * sizeof(T)) % BLOCK_BYTES == 0) {
            AscendC::DataCopy(zGm[offset], zLocal, curLen);
        } else {
            AscendC::DataCopyExtParams copyParams;
            copyParams.blockCount = 1;
            copyParams.blockLen = (uint32_t)(curLen * sizeof(T));
            copyParams.srcStride = 0;
            copyParams.dstStride = 0;
            AscendC::DataCopyPad(zGm[offset], zLocal, copyParams);
        }
        // 释放输出数据内存
        outQueueZ.FreeTensor(zLocal);
    }

private:
    AscendC::TPipe pipe;  // TPipe 内存管理对象
    AscendC::TQue<AscendC::QuePosition::VECIN, QUEUE_DEPTH> inQueueX, inQueueY;  // 输入数据队列管理对象，VECIN 位置
    AscendC::TQue<AscendC::QuePosition::VECOUT, QUEUE_DEPTH> outQueueZ;  // 输出数据队列管理对象，VECOUT 位置
    AscendC::GlobalTensor<T> xGm, yGm, zGm; // 管理输入输出 Global Memory 地址的对象，其中 xGm、yGm 为输入，zGm 为输出

    uint32_t totalLength;  // 数据总长度（元素个数）
    uint32_t blockLength;  // 每核处理的元素数
    uint32_t tileLength;   // 单核内每块元素数
    uint32_t startOffset;  // 当前核在整块数据中的起始偏移（元素个数）
    uint32_t length;       // 当前核实际处理的元素数
};

// ---------------------------------------------------------------------------
// 核函数入口：实例化 KernelSub<T> 并执行（T 由 run_kernel 按输入 dtype 选择）
// ---------------------------------------------------------------------------
template <typename T>
__global__ __vector__ void sub_custom(GM_ADDR x, GM_ADDR y, GM_ADDR z, SubCustomTilingData tiling)
{
    KernelSub<T> op;
    op.Init(x, y, z, tiling);
    op.Process();
}

// ---------------------------------------------------------------------------
// host 侧启动函数：从 TensorGroupInfo 推导 tiling 并启动核函数
// ---------------------------------------------------------------------------
extern "C" void run_kernel(GM_ADDR x, const TensorGroupInfo& info_x, GM_ADDR y, const TensorGroupInfo& info_y, GM_ADDR z, const TensorGroupInfo& info_z, int64_t availableCoreNum, aclrtStream stream)
{
    // 1. 取总元素数（x/y/z 形状一致，按连续内存处理）
    const TensorInfo& t0 = info_x.tensors[0];
    int64_t totalLength64 = 1;
    for (int64_t i = 0; i < t0.numDims; i++) {
        totalLength64 *= t0.shape[i];
    }
    if (totalLength64 <= 0) {
        return;
    }
    uint32_t totalLength = (uint32_t)totalLength64;

    // 2. 按输入 dtype 选择核函数实例（dtype 定义见 TensorInfo：0=fp32 1=fp16 2=bf16 ...）
    int32_t dtype = t0.dtype;
    // 32Byte 对齐对应的元素个数：fp32 -> 8，fp16 -> 16
    uint32_t alignElems = (dtype == 1) ? 16u : 8u;

    // 3. 确定 block 数：优先 8 核，且不超过硬件可用核数 / 数据长度
    uint32_t blockDim = 8u;
    if (availableCoreNum > 0 && (uint64_t)availableCoreNum < (uint64_t)blockDim) {
        blockDim = (uint32_t)availableCoreNum;
    }
    if (blockDim > totalLength) {
        blockDim = totalLength;
    }
    if (blockDim == 0) {
        blockDim = 1u;
    }

    // 4. 多核切分：每核处理 blockLength 个元素（向上取整，最后一个核处理剩余部分）
    //    blockLength 按 32Byte 对齐，保证每个核的起始地址都是对齐的
    uint32_t blockLength = (uint32_t)(((uint64_t)totalLength + blockDim - 1) / blockDim);
    blockLength = (blockLength + alignElems - 1) / alignElems * alignElems;

    // 5. 核内分块：tileLength 按 32Byte 对齐，单块上限 4096 元素（控制 UB 占用）
    constexpr uint32_t MAX_TILE_LENGTH = 4096;
    uint32_t tileLength = (blockLength < MAX_TILE_LENGTH) ? blockLength : MAX_TILE_LENGTH;
    tileLength = (tileLength + alignElems - 1) / alignElems * alignElems;
    if (tileLength == 0) {
        tileLength = alignElems;
    }

    SubCustomTilingData tiling = {totalLength, blockLength, tileLength};

    if (dtype == 1) {
        // fp16：half 实例
        sub_custom<half><<<blockDim, nullptr, stream>>>(x, y, z, tiling);
    } else {
        // fp32 及其他类型默认走 float 实例
        sub_custom<float><<<blockDim, nullptr, stream>>>(x, y, z, tiling);
    }
}
