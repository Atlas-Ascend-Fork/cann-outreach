
#include <cmath>
#include <cstdint>
#include "kernel_operator.h"

// ---------------------------------------------------------------------------
// Tiling 参数
// ---------------------------------------------------------------------------
struct SubCustomTilingData {
    uint32_t blockLength;  // 每个核处理的数据总长度
    uint32_t tileNum;      // 每个核划分的数据块数量
    uint32_t tileLength;   // 每个数据块的最大长度
};

constexpr uint32_t BUFFER_NUM = 2;
constexpr uint32_t QUEUE_DEPTH = 1;

// ---------------------------------------------------------------------------
// KernelSub: z = x - y
// ---------------------------------------------------------------------------
template <typename T>
class KernelSub {
public:
    __aicore__ inline KernelSub() {}

    __aicore__ inline void Init(
        GM_ADDR x,
        GM_ADDR y,
        GM_ADDR z,
        const SubCustomTilingData& tiling)
    {
        // 获取当前核的编号
        uint32_t blockIdx = AscendC::GetBlockIdx();

        // 获取 tiling 参数
        this->blockLength = tiling.blockLength;
        this->tileNum = tiling.tileNum;
        this->tileLength = tiling.tileLength;

        // 设置当前核对应的 Global Memory 地址
        xGm.SetGlobalBuffer(
            (__gm__ T*)x + blockIdx * blockLength,
            blockLength);

        yGm.SetGlobalBuffer(
            (__gm__ T*)y + blockIdx * blockLength,
            blockLength);

        zGm.SetGlobalBuffer(
            (__gm__ T*)z + blockIdx * blockLength,
            blockLength);

        // 初始化输入输出队列，开启 Double Buffer
        pipe.InitBuffer(
            inQueueX, BUFFER_NUM,
            tileLength * sizeof(T));

        pipe.InitBuffer(
            inQueueY, BUFFER_NUM,
            tileLength * sizeof(T));

        pipe.InitBuffer(
            outQueueZ, BUFFER_NUM,
            tileLength * sizeof(T));
    }

    // -----------------------------------------------------------------------
    // 主处理函数
    // -----------------------------------------------------------------------
    __aicore__ inline void Process()
    {
        // tileNum 表示实际数据块数量，不需要再乘 BUFFER_NUM
        for (int32_t i = 0; i < (int32_t)tileNum; i++) {
            CopyIn(i);
            Compute(i);
            CopyOut(i);
        }
    }

private:

    // 获取当前数据块的实际长度
    __aicore__ inline uint32_t GetCurrentTileLength(
        int32_t progress)
    {
        uint32_t offset = progress * tileLength;
        uint32_t remain = blockLength - offset;

        return (remain < tileLength) ? remain : tileLength;
    }

    // -----------------------------------------------------------------------
    // CopyIn: Global Memory -> Local Memory
    // -----------------------------------------------------------------------
    __aicore__ inline void CopyIn(int32_t progress)
    {
        uint32_t curLength = GetCurrentTileLength(progress);
        uint32_t offset = progress * tileLength;

        // 申请输入张量的 Local Memory
        AscendC::LocalTensor<T> xLocal =
            inQueueX.AllocTensor<T>();

        AscendC::LocalTensor<T> yLocal =
            inQueueY.AllocTensor<T>();

        // 将数据从 GM 搬运到 Local Memory
        AscendC::DataCopy(
            xLocal,
            xGm[offset],
            curLength);

        AscendC::DataCopy(
            yLocal,
            yGm[offset],
            curLength);

        // 输入队列入队
        inQueueX.EnQue(xLocal);
        inQueueY.EnQue(yLocal);
    }

    // -----------------------------------------------------------------------
    // Compute: z = x - y
    // -----------------------------------------------------------------------
    __aicore__ inline void Compute(int32_t progress)
    {
        uint32_t curLength = GetCurrentTileLength(progress);

        // 从输入队列取出数据
        AscendC::LocalTensor<T> xLocal =
            inQueueX.DeQue<T>();

        AscendC::LocalTensor<T> yLocal =
            inQueueY.DeQue<T>();

        // 申请输出张量
        AscendC::LocalTensor<T> zLocal =
            outQueueZ.AllocTensor<T>();

        // 执行逐元素减法
        AscendC::Sub(
            zLocal,
            xLocal,
            yLocal,
            curLength);

        // 输出队列入队
        outQueueZ.EnQue<T>(zLocal);

        // 释放输入张量
        inQueueX.FreeTensor(xLocal);
        inQueueY.FreeTensor(yLocal);
    }

    // -----------------------------------------------------------------------
    // CopyOut: Local Memory -> Global Memory
    // -----------------------------------------------------------------------
    __aicore__ inline void CopyOut(int32_t progress)
    {
        uint32_t curLength = GetCurrentTileLength(progress);
        uint32_t offset = progress * tileLength;

        // 从输出队列取出计算结果
        AscendC::LocalTensor<T> zLocal =
            outQueueZ.DeQue<T>();

        // 将计算结果写回 Global Memory
        AscendC::DataCopy(
            zGm[offset],
            zLocal,
            curLength);

        // 释放输出张量
        outQueueZ.FreeTensor(zLocal);
    }

private:
    AscendC::TPipe pipe;

    AscendC::TQue<AscendC::QuePosition::VECIN, QUEUE_DEPTH>
        inQueueX, inQueueY;

    AscendC::TQue<AscendC::QuePosition::VECOUT, QUEUE_DEPTH>
        outQueueZ;

    AscendC::GlobalTensor<T> xGm;
    AscendC::GlobalTensor<T> yGm;
    AscendC::GlobalTensor<T> zGm;

    uint32_t blockLength;
    uint32_t tileNum;
    uint32_t tileLength;
};

// ---------------------------------------------------------------------------
// Kernel Entry
// ---------------------------------------------------------------------------
template <typename T>
__global__ __vector__ void sub_custom(
    GM_ADDR x,
    GM_ADDR y,
    GM_ADDR z,
    SubCustomTilingData tiling)
{
    KernelSub<T> op;

    op.Init(x, y, z, tiling);
    op.Process();
}

// ---------------------------------------------------------------------------
// Host 侧启动函数
// ---------------------------------------------------------------------------
extern "C" void run_kernel(
    GM_ADDR x,
    const TensorGroupInfo& info_x,
    GM_ADDR y,
    const TensorGroupInfo& info_y,
    GM_ADDR z,
    const TensorGroupInfo& info_z,
    int64_t availableCoreNum,
    aclrtStream stream)
{
    // 本题输入形状固定为 (8, 2048)
    constexpr uint32_t blockDim = 8;

    // 1. 获取输入张量总元素数量
    const TensorInfo& t0 = info_x.tensors[0];

    int64_t totalLength = 1;

    for (int64_t i = 0; i < t0.numDims; i++) {
        totalLength *= t0.shape[i];
    }

    // 2. 检查核数量
    if (availableCoreNum < blockDim) {
        return;
    }

    // 3. 计算每个核的数据长度
    uint32_t blockLength =
        (uint32_t)(totalLength / blockDim);

    // 4. 每个核划分为 8 个数据块
    uint32_t tileNum = 8;

    uint32_t tileLength =
        (blockLength + tileNum - 1) / tileNum;

    // 5. 构建 Tiling 参数
    SubCustomTilingData tiling = {
        blockLength,
        tileNum,
        tileLength
    };

    // 6. 根据输入数据类型选择对应的 Kernel
    int32_t dtype = t0.dtype;

    if (dtype == 0) {
        // FP32
        sub_custom<float>
            <<<blockDim, nullptr, stream>>>(
                x, y, z, tiling);
    }
    else if (dtype == 1) {
        // FP16
        sub_custom<half>
            <<<blockDim, nullptr, stream>>>(
                x, y, z, tiling);
    }
}
