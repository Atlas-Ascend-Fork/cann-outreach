#include <cmath>
#include "kernel_operator.h"
/*
 * Sub Kernel — Ascend C Direct Invocation
 * This file is #included — do NOT add main(), #pragma once, or include guards.
 *
 * TensorGroupInfo / TensorInfo (predefined):
 *   struct TensorInfo { const int64_t* shape; int64_t numDims; int32_t dtype; };
 *   struct TensorGroupInfo { const TensorInfo* tensors; int64_t numTensors; };
 *   dtype: 0=fp32 1=fp16 2=bf16 3=int8 4=int16 5=int32 6=int64 7=uint8 8=uint16 9=uint32 10=uint64 11=bool
 *   Usage: info_x.tensors[0].shape[0]  // first dim of first tensor in input x
 *
 * __global__ __vector__ void sub_custom(...)
 * {
 *     // TODO: implement your kernel logic
 *     // Available APIs: AscendC::TPipe, AscendC::TQue, AscendC::DataCopy, AscendC::Add, ...
 * }
 */
template <typename T>
__global__ __vector__ void sub_custom(
    GM_ADDR x, GM_ADDR y, GM_ADDR z)
{
    // 一行 2048 个元素，一共 8 行。
    constexpr uint32_t ROW_LENGTH = 2048;
    constexpr uint32_t ROW_COUNT = 8;

    AscendC::TPipe pipe;
    AscendC::TQue<AscendC::QuePosition::VECIN, 1> queueX;
    AscendC::TQue<AscendC::QuePosition::VECIN, 1> queueY;
    AscendC::TQue<AscendC::QuePosition::VECOUT, 1> queueZ;

    pipe.InitBuffer(queueX, 1, ROW_LENGTH * sizeof(T));
    pipe.InitBuffer(queueY, 1, ROW_LENGTH * sizeof(T));
    pipe.InitBuffer(queueZ, 1, ROW_LENGTH * sizeof(T));

    AscendC::GlobalTensor<T> xGm;
    AscendC::GlobalTensor<T> yGm;
    AscendC::GlobalTensor<T> zGm;

    xGm.SetGlobalBuffer((__gm__ T*)x, ROW_COUNT * ROW_LENGTH);
    yGm.SetGlobalBuffer((__gm__ T*)y, ROW_COUNT * ROW_LENGTH);
    zGm.SetGlobalBuffer((__gm__ T*)z, ROW_COUNT * ROW_LENGTH);

    // 各核处理不同的行；核数不足 8 时循环处理。
    for (uint32_t row = AscendC::GetBlockIdx();
         row < ROW_COUNT;
         row += AscendC::GetBlockNum()) {
        const uint32_t offset = row * ROW_LENGTH;

        // 1. 从全局内存搬入输入。
        AscendC::LocalTensor<T> xLocal = queueX.AllocTensor<T>();
        AscendC::LocalTensor<T> yLocal = queueY.AllocTensor<T>();

        AscendC::DataCopy(xLocal, xGm[offset], ROW_LENGTH);
        AscendC::DataCopy(yLocal, yGm[offset], ROW_LENGTH);

        queueX.EnQue<T>(xLocal);
        queueY.EnQue<T>(yLocal);

        // 2. 执行矢量减法：z = x - y。
        xLocal = queueX.DeQue<T>();
        yLocal = queueY.DeQue<T>();
        AscendC::LocalTensor<T> zLocal = queueZ.AllocTensor<T>();

        AscendC::Sub(zLocal, xLocal, yLocal, ROW_LENGTH);

        queueZ.EnQue<T>(zLocal);
        queueX.FreeTensor(xLocal);
        queueY.FreeTensor(yLocal);

        // 3. 将结果搬回全局内存。
        zLocal = queueZ.DeQue<T>();
        AscendC::DataCopy(zGm[offset], zLocal, ROW_LENGTH);
        queueZ.FreeTensor(zLocal);
    }
}


extern "C" void run_kernel(GM_ADDR x, const TensorGroupInfo& info_x, GM_ADDR y, const TensorGroupInfo& info_y, GM_ADDR z, const TensorGroupInfo& info_z, int64_t availableCoreNum, aclrtStream stream)
{
    // TODO: define your launch kernel.
    //   sub_custom<<<blockNum, nullptr, stream>>>(...);
    if (availableCoreNum <= 0) {
        return;
    }

    const uint32_t blockNum =
        static_cast<uint32_t>(availableCoreNum < 8 ? availableCoreNum : 8);

    // 模板规定：0 = float32，1 = float16。
    if (info_x.tensors[0].dtype == 0) {
        sub_custom<float><<<blockNum, nullptr, stream>>>(x, y, z);
    } else if (info_x.tensors[0].dtype == 1) {
        sub_custom<half><<<blockNum, nullptr, stream>>>(x, y, z);
    }
}
