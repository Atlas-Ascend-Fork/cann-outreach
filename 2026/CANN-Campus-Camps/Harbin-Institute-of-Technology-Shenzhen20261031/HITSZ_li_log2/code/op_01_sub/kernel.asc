#include "kernel_operator.h"

namespace {
constexpr uint32_t SUB_TOTAL_LENGTH = 8 * 2048;

inline bool IsSupportedSubTensor(const TensorGroupInfo& info, int32_t dtype)
{
    if (info.numTensors != 1 || info.tensors == nullptr) {
        return false;
    }
    const TensorInfo& tensor = info.tensors[0];
    return tensor.dtype == dtype && tensor.numDims == 2 &&
        tensor.shape != nullptr && tensor.shape[0] == 8 && tensor.shape[1] == 2048;
}
} // namespace

template <typename T, uint32_t BLOCK_LENGTH>
__global__ __vector__ void sub_custom(GM_ADDR x, GM_ADDR y, GM_ADDR z)
{
    // Static tensors avoid TPipe construction and runtime buffer/event allocation.
    // The largest specialization uses 128 KiB of UB (one-core float32).
    AscendC::InitSocState();
    AscendC::LocalTensor<T> xLocal(AscendC::TPosition::VECCALC, 0, BLOCK_LENGTH);
    AscendC::LocalTensor<T> yLocal(AscendC::TPosition::VECCALC,
        BLOCK_LENGTH * sizeof(T), BLOCK_LENGTH);

    const uint32_t offset = AscendC::GetBlockIdx() * BLOCK_LENGTH;
    AscendC::GlobalTensor<T> xGm, yGm, zGm;
    xGm.SetGlobalBuffer((__gm__ T*)x + offset, BLOCK_LENGTH);
    yGm.SetGlobalBuffer((__gm__ T*)y + offset, BLOCK_LENGTH);
    zGm.SetGlobalBuffer((__gm__ T*)z + offset, BLOCK_LENGTH);

    const AscendC::DataCopyExtParams copyParams{
        1, static_cast<uint32_t>(BLOCK_LENGTH * sizeof(T)), 0, 0, 0};
    const AscendC::DataCopyPadExtParams<T> padParams{false, 0, 0, 0};
    AscendC::DataCopyPad(xLocal, xGm, copyParams, padParams);
    AscendC::DataCopyPad(yLocal, yGm, copyParams, padParams);

    // Both input copies use MTE2, so a single event covers both operands.
    // Event IDs are managed locally because this kernel uses no Pipe framework.
    constexpr int32_t inputReady = 0;
    AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(inputReady);
    AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(inputReady);

    // Exact source/destination overlap is safe; reuse x's UB allocation.
    AscendC::Sub(xLocal, xLocal, yLocal, BLOCK_LENGTH);

    constexpr int32_t outputReady = 0;
    AscendC::SetFlag<AscendC::HardEvent::V_MTE3>(outputReady);
    AscendC::WaitFlag<AscendC::HardEvent::V_MTE3>(outputReady);
    AscendC::DataCopyPad(zGm, xLocal, copyParams);
    // Static tensor kernels must drain all pipelines before returning.
    AscendC::PipeBarrier<PIPE_ALL>();
}

template <typename T>
inline void LaunchSub(GM_ADDR x, GM_ADDR y, GM_ADDR z,
    int64_t availableCoreNum, aclrtStream stream)
{
    // For this small fixed shape, use at least 2048 elements per core.
    // Power-of-two partitions make lengths and offsets compile-time constants.
    if (availableCoreNum >= 8) {
        sub_custom<T, SUB_TOTAL_LENGTH / 8><<<8, nullptr, stream>>>(x, y, z);
    } else if (availableCoreNum >= 4) {
        sub_custom<T, SUB_TOTAL_LENGTH / 4><<<4, nullptr, stream>>>(x, y, z);
    } else if (availableCoreNum >= 2) {
        sub_custom<T, SUB_TOTAL_LENGTH / 2><<<2, nullptr, stream>>>(x, y, z);
    } else {
        sub_custom<T, SUB_TOTAL_LENGTH><<<1, nullptr, stream>>>(x, y, z);
    }
}

extern "C" void run_kernel(GM_ADDR x, const TensorGroupInfo& info_x,
    GM_ADDR y, const TensorGroupInfo& info_y, GM_ADDR z,
    const TensorGroupInfo& info_z, int64_t availableCoreNum, aclrtStream stream)
{
    if (x == nullptr || y == nullptr || z == nullptr || availableCoreNum <= 0 ||
        info_x.numTensors != 1 || info_x.tensors == nullptr) {
        return;
    }
    const int32_t dtype = info_x.tensors[0].dtype;
    if ((dtype != 0 && dtype != 1) || !IsSupportedSubTensor(info_x, dtype) ||
        !IsSupportedSubTensor(info_y, dtype) || !IsSupportedSubTensor(info_z, dtype)) {
        return;
    }

    if (dtype == 0) {
        LaunchSub<float>(x, y, z, availableCoreNum, stream);
    } else {
        LaunchSub<half>(x, y, z, availableCoreNum, stream);
    }
}
