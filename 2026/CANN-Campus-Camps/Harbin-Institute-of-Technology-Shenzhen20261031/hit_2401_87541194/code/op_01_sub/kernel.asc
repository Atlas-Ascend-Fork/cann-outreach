#include <cmath>
#include "kernel_operator.h"

struct SubCustomTilingData { uint32_t totalLength; };
constexpr uint32_t QUEUE_DEPTH = 1;

template <typename T>
class KernelSub {
public:
    __aicore__ inline KernelSub() {}

    __aicore__ inline void Init(GM_ADDR x, GM_ADDR y, GM_ADDR z, const SubCustomTilingData& tiling)
    {
        blockLength = tiling.totalLength / AscendC::GetBlockNum();
        const uint32_t offset = blockLength * AscendC::GetBlockIdx();
        xGm.SetGlobalBuffer((__gm__ T *)x + offset, blockLength);
        yGm.SetGlobalBuffer((__gm__ T *)y + offset, blockLength);
        zGm.SetGlobalBuffer((__gm__ T *)z + offset, blockLength);

        pipe.InitBuffer(inQueueX, QUEUE_DEPTH, blockLength * sizeof(T));
        pipe.InitBuffer(yReuseQueue, QUEUE_DEPTH, blockLength * sizeof(T));
    }

    __aicore__ inline void Process()
    {
        CopyIn();
        Compute();
        CopyOut();
    }

private:
    __aicore__ inline void CopyIn()
    {
        AscendC::LocalTensor<T> xLocal = inQueueX.AllocTensor<T>();
        AscendC::LocalTensor<T> yLocal = yReuseQueue.AllocTensor<T>();
        AscendC::DataCopy(xLocal, xGm, blockLength);
        AscendC::DataCopy(yLocal, yGm, blockLength);
        inQueueX.EnQue(xLocal);
        yReuseQueue.EnQue<AscendC::QuePosition::GM, AscendC::QuePosition::VECIN, T>(yLocal);
    }

    __aicore__ inline void Compute()
    {
        AscendC::LocalTensor<T> xLocal = inQueueX.DeQue<T>();
        AscendC::LocalTensor<T> yLocal = yReuseQueue.DeQue<AscendC::QuePosition::GM, AscendC::QuePosition::VECIN, T>();
        // Sub permits dst to overlap src1. Reuse y's UB block as z, then
        // retag the same storage from VECIN to VECOUT for CopyOut.
        AscendC::Sub(yLocal, xLocal, yLocal, blockLength);
        yReuseQueue.EnQue<AscendC::QuePosition::VECIN, AscendC::QuePosition::VECOUT, T>(yLocal);
        inQueueX.FreeTensor(xLocal);
    }

    __aicore__ inline void CopyOut()
    {
        AscendC::LocalTensor<T> zLocal = yReuseQueue.DeQue<AscendC::QuePosition::VECIN, AscendC::QuePosition::VECOUT, T>();
        AscendC::DataCopy(zGm, zLocal, blockLength);
        yReuseQueue.FreeTensor(zLocal);
    }

private:
    AscendC::TPipe pipe;
    AscendC::TQue<AscendC::QuePosition::VECIN, QUEUE_DEPTH> inQueueX;
    AscendC::TQueBind<AscendC::QuePosition::VECIN, AscendC::QuePosition::VECOUT, QUEUE_DEPTH> yReuseQueue;
    AscendC::GlobalTensor<T> xGm, yGm, zGm;
    uint32_t blockLength;
};

template <typename T>
__global__ __vector__ void sub_custom(GM_ADDR x, GM_ADDR y, GM_ADDR z, SubCustomTilingData tiling)
{
    KernelSub<T> op;
    op.Init(x, y, z, tiling);
    op.Process();
}

extern "C" void run_kernel(GM_ADDR x, const TensorGroupInfo& info_x,
                           GM_ADDR y, const TensorGroupInfo& info_y,
                           GM_ADDR z, const TensorGroupInfo& info_z,
                           int64_t availableCoreNum, aclrtStream stream)
{
    const TensorInfo& input = info_x.tensors[0];
    int64_t totalLength = 1;
    for (int64_t i = 0; i < input.numDims; ++i) totalLength *= input.shape[i];
    SubCustomTilingData tiling = {(uint32_t)totalLength};
    const int32_t dtype = input.dtype;

    if (dtype == 1) {
        sub_custom<half><<<8, nullptr, stream>>>(x, y, z, tiling);
    } else {
        sub_custom<float><<<8, nullptr, stream>>>(x, y, z, tiling);
    }
}
