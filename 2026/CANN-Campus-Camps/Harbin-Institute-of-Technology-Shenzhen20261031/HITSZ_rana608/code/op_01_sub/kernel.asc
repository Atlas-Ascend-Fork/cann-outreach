#include "kernel_operator.h"

// The problem contract is two contiguous (8, 2048) tensors of equal dtype.
template <typename T>
class SubKernel {
public:
    __aicore__ inline void Init(GM_ADDR x, GM_ADDR y, GM_ADDR z)
    {
        xGm.SetGlobalBuffer((__gm__ T *)x, TOTAL_LENGTH);
        yGm.SetGlobalBuffer((__gm__ T *)y, TOTAL_LENGTH);
        zGm.SetGlobalBuffer((__gm__ T *)z, TOTAL_LENGTH);
        pipe.InitBuffer(inX, 1, TILE_LENGTH * sizeof(T));
        pipe.InitBuffer(inY, 1, TILE_LENGTH * sizeof(T));
        pipe.InitBuffer(outZ, 1, TILE_LENGTH * sizeof(T));
    }

    __aicore__ inline void Process()
    {
        // Strided assignment covers all eight tiles, including 3/5/6/7 cores.
        for (uint32_t tile = AscendC::GetBlockIdx(); tile < TILE_COUNT;
             tile += AscendC::GetBlockNum()) {
            const uint32_t offset = tile * TILE_LENGTH;
            CopyIn(offset);
            Compute();
            CopyOut(offset);
        }
    }

private:
    __aicore__ inline void CopyIn(uint32_t offset)
    {
        AscendC::LocalTensor<T> xLocal = inX.AllocTensor<T>();
        AscendC::LocalTensor<T> yLocal = inY.AllocTensor<T>();
        AscendC::DataCopy(xLocal, xGm[offset], TILE_LENGTH);
        AscendC::DataCopy(yLocal, yGm[offset], TILE_LENGTH);
        inX.EnQue(xLocal);
        inY.EnQue(yLocal);
    }

    __aicore__ inline void Compute()
    {
        AscendC::LocalTensor<T> xLocal = inX.DeQue<T>();
        AscendC::LocalTensor<T> yLocal = inY.DeQue<T>();
        AscendC::LocalTensor<T> zLocal = outZ.AllocTensor<T>();
        AscendC::Sub(zLocal, xLocal, yLocal, TILE_LENGTH);
        outZ.EnQue(zLocal);
        inX.FreeTensor(xLocal);
        inY.FreeTensor(yLocal);
    }

    __aicore__ inline void CopyOut(uint32_t offset)
    {
        AscendC::LocalTensor<T> zLocal = outZ.DeQue<T>();
        AscendC::DataCopy(zGm[offset], zLocal, TILE_LENGTH);
        outZ.FreeTensor(zLocal);
    }

    static constexpr uint32_t TILE_LENGTH = 2048;
    static constexpr uint32_t TILE_COUNT = 8;
    static constexpr uint32_t TOTAL_LENGTH = TILE_LENGTH * TILE_COUNT;
    AscendC::TPipe pipe;
    AscendC::TQue<AscendC::QuePosition::VECIN, 1> inX, inY;
    AscendC::TQue<AscendC::QuePosition::VECOUT, 1> outZ;
    AscendC::GlobalTensor<T> xGm, yGm, zGm;
};

template <typename T>
__global__ __vector__ void sub_custom(GM_ADDR x, GM_ADDR y, GM_ADDR z)
{
    SubKernel<T> op;
    op.Init(x, y, z);
    op.Process();
}

extern "C" void run_kernel(GM_ADDR x, const TensorGroupInfo& info_x,
                           GM_ADDR y, const TensorGroupInfo& info_y,
                           GM_ADDR z, const TensorGroupInfo& info_z,
                           int64_t availableCoreNum, aclrtStream stream)
{
    if (availableCoreNum <= 0) {
        return;
    }
    const uint32_t blockNum =
        static_cast<uint32_t>(availableCoreNum < 8 ? availableCoreNum : 8);
    if (info_x.tensors[0].dtype == 0) {
        sub_custom<float><<<blockNum, nullptr, stream>>>(x, y, z);
    } else if (info_x.tensors[0].dtype == 1) {
        sub_custom<half><<<blockNum, nullptr, stream>>>(x, y, z);
    }
}
