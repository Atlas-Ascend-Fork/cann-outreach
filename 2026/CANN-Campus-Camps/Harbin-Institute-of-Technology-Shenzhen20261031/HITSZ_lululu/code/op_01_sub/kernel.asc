#include "kernel_operator.h"

template <typename T>
__global__ __vector__ void sub_generic(GM_ADDR x, GM_ADDR y, GM_ADDR z, uint32_t length)
{
    using namespace AscendC;
    constexpr uint32_t N = 1024;
    LocalTensor<T> xl(TPosition::VECCALC, 0, N);
    LocalTensor<T> yl(TPosition::VECCALC, N * sizeof(T) + 256, N);
    LocalTensor<T> zl(TPosition::VECCALC, 65536, N);
    GlobalTensor<T> xg, yg, zg;
    xg.SetGlobalBuffer((__gm__ T*)x, length);
    yg.SetGlobalBuffer((__gm__ T*)y, length);
    zg.SetGlobalBuffer((__gm__ T*)z, length);
    for (uint32_t offset = GetBlockIdx() * N; offset < length; offset += GetBlockNum() * N) {
        uint32_t count = length - offset;
        if (count > N) count = N;
        DataCopyExtParams cp{1, static_cast<uint32_t>(count * sizeof(T)), 0, 0, 0};
        DataCopyPadExtParams<T> pad{false, 0, 0, 0};
        DataCopyPad(xl, xg[offset], cp, pad);
        DataCopyPad(yl, yg[offset], cp, pad);
        SetFlag<HardEvent::MTE2_V>(EVENT_ID0);
        WaitFlag<HardEvent::MTE2_V>(EVENT_ID0);
        Sub(zl, xl, yl, count);
        SetFlag<HardEvent::V_MTE3>(EVENT_ID0);
        WaitFlag<HardEvent::V_MTE3>(EVENT_ID0);
        DataCopyPad(zg[offset], zl, cp);
        SetFlag<HardEvent::MTE3_S>(EVENT_ID0);
        WaitFlag<HardEvent::MTE3_S>(EVENT_ID0);
    }
}

extern "C" void run_kernel_fallback(GM_ADDR x, const TensorGroupInfo& info_x,
                                    GM_ADDR y, const TensorGroupInfo& info_y,
                                    GM_ADDR z, const TensorGroupInfo& info_z,
                                    int64_t availableCoreNum, aclrtStream stream)
{
    uint32_t length = 1;
    const auto& input = info_x.tensors[0];
    for (int64_t i = 0; i < input.numDims; ++i) length *= static_cast<uint32_t>(input.shape[i]);
    if (length == 0 || availableCoreNum <= 0) return;
    uint32_t blocks = (length + 1023) / 1024;
    if (blocks > 8) blocks = 8;
    if (static_cast<int64_t>(blocks) > availableCoreNum) blocks = static_cast<uint32_t>(availableCoreNum);
    if (input.dtype == 0) {
        sub_generic<float><<<blocks, nullptr, stream>>>(x, y, z, length);
    } else if (input.dtype == 1) {
        sub_generic<half><<<blocks, nullptr, stream>>>(x, y, z, length);
    }
}

template <typename T, uint32_t N>
struct FastSubCompute {
    __aicore__ static inline void Run(AscendC::LocalTensor<T> z,
                                     AscendC::LocalTensor<T> x,
                                     AscendC::LocalTensor<T> y) {
        constexpr uint32_t lanes = 256 / sizeof(T);
        AscendC::Sub(z, x, y, static_cast<uint64_t>(lanes),
                     static_cast<uint8_t>(N / lanes), {1, 1, 1, 8, 8, 8});
    }
};


template <typename T>
__global__ __vector__ void sub_stream2(GM_ADDR x, GM_ADDR y, GM_ADDR z)
{
    using namespace AscendC;
    constexpr uint32_t N = 2048;
    constexpr uint32_t K = N / 2;
    constexpr uint32_t yBase = N * sizeof(T) + 256;
    LocalTensor<T> x0(TPosition::VECCALC, 0, K);
    LocalTensor<T> x1(TPosition::VECCALC, K * sizeof(T), K);
    LocalTensor<T> y0(TPosition::VECCALC, yBase, K);
    LocalTensor<T> y1(TPosition::VECCALC, yBase + K * sizeof(T), K);
    LocalTensor<T> z0(TPosition::VECCALC, 65536, K);
    LocalTensor<T> z1(TPosition::VECCALC, 65536 + K * sizeof(T), K);
    const uint32_t offset = static_cast<uint32_t>(block_idx) * N;
    GlobalTensor<T> xg, yg, zg;
    xg.SetGlobalBuffer((__gm__ T*)x + offset, N);
    yg.SetGlobalBuffer((__gm__ T*)y + offset, N);
    zg.SetGlobalBuffer((__gm__ T*)z + offset, N);
    DataCopy(x0, xg, K);
    DataCopy(y0, yg, K);
    SetFlag<HardEvent::MTE2_V>(EVENT_ID0);
    DataCopy(x1, xg[K], K);
    DataCopy(y1, yg[K], K);
    SetFlag<HardEvent::MTE2_V>(EVENT_ID1);
    WaitFlag<HardEvent::MTE2_V>(EVENT_ID0);
    FastSubCompute<T, K>::Run(z0, x0, y0);
    SetFlag<HardEvent::V_MTE3>(EVENT_ID0);
    WaitFlag<HardEvent::V_MTE3>(EVENT_ID0);
    DataCopy(zg, z0, K);
    WaitFlag<HardEvent::MTE2_V>(EVENT_ID1);
    FastSubCompute<T, K>::Run(z1, x1, y1);
    SetFlag<HardEvent::V_MTE3>(EVENT_ID1);
    WaitFlag<HardEvent::V_MTE3>(EVENT_ID1);
    DataCopy(zg[K], z1, K);
    SetFlag<HardEvent::MTE3_S>(EVENT_ID0);
    WaitFlag<HardEvent::MTE3_S>(EVENT_ID0);
}
template <typename T, bool Reverse>
__global__ __vector__ void sub_dual_load(GM_ADDR low, GM_ADDR z, uint16_t sourceStride)
{
    using namespace AscendC;
    constexpr uint32_t N = 2048;
    constexpr uint32_t K = N / 2;
    constexpr uint32_t yBase = N * sizeof(T) + 256;
    LocalTensor<T> x0(TPosition::VECCALC, 0, K);
    LocalTensor<T> x1(TPosition::VECCALC, K * sizeof(T), K);
    LocalTensor<T> y0(TPosition::VECCALC, yBase, K);
    LocalTensor<T> y1(TPosition::VECCALC, yBase + K * sizeof(T), K);
    LocalTensor<T> z0(TPosition::VECCALC, 65536, K);
    LocalTensor<T> z1(TPosition::VECCALC, 65536 + K * sizeof(T), K);
    const uint32_t offset = static_cast<uint32_t>(block_idx) * N;
    GlobalTensor<T> xg, zg;
    const uint32_t deltaElements = (sourceStride * 32u + K * sizeof(T)) / sizeof(T);
    xg.SetGlobalBuffer((__gm__ T*)low + offset, N + deltaElements);
    zg.SetGlobalBuffer((__gm__ T*)z + offset, N);
    LocalTensor<T> xy0(TPosition::VECCALC, 0, yBase / sizeof(T) + K);
    LocalTensor<T> xy1(TPosition::VECCALC, K * sizeof(T), yBase / sizeof(T) + K);
    const DataCopyParams cp{2, static_cast<uint16_t>(K * sizeof(T) / 32), sourceStride,
                            static_cast<uint16_t>((yBase - K * sizeof(T)) / 32)};
    DataCopy(xy0, xg, cp);
    SetFlag<HardEvent::MTE2_V>(EVENT_ID0);
    DataCopy(xy1, xg[K], cp);
    SetFlag<HardEvent::MTE2_V>(EVENT_ID1);
    WaitFlag<HardEvent::MTE2_V>(EVENT_ID0);
    if (Reverse) FastSubCompute<T, K>::Run(z0, y0, x0);
    else FastSubCompute<T, K>::Run(z0, x0, y0);
    SetFlag<HardEvent::V_MTE3>(EVENT_ID0);
    WaitFlag<HardEvent::V_MTE3>(EVENT_ID0);
    DataCopy(zg, z0, K);
    WaitFlag<HardEvent::MTE2_V>(EVENT_ID1);
    if (Reverse) FastSubCompute<T, K>::Run(z1, y1, x1);
    else FastSubCompute<T, K>::Run(z1, x1, y1);
    SetFlag<HardEvent::V_MTE3>(EVENT_ID1);
    WaitFlag<HardEvent::V_MTE3>(EVENT_ID1);
    DataCopy(zg[K], z1, K);
    SetFlag<HardEvent::MTE3_S>(EVENT_ID0);
    WaitFlag<HardEvent::MTE3_S>(EVENT_ID0);
}
template <typename T>
bool try_dual_load(GM_ADDR x, GM_ADDR y, GM_ADDR z, aclrtStream stream)
{
    const uint64_t xa = reinterpret_cast<uint64_t>(x);
    const uint64_t ya = reinterpret_cast<uint64_t>(y);
    const uint64_t delta = xa < ya ? ya - xa : xa - ya;
    constexpr uint64_t chunkBytes = 1024 * sizeof(T);
    if (delta < chunkBytes || (delta - chunkBytes) % 32 != 0 ||
        (delta - chunkBytes) / 32 > 65535) return false;
    const uint16_t stride = static_cast<uint16_t>((delta - chunkBytes) / 32);
    if (xa < ya) sub_dual_load<T, false><<<8, nullptr, stream>>>(x, z, stride);
    else sub_dual_load<T, true><<<8, nullptr, stream>>>(y, z, stride);
    return true;
}
// Compiler intrinsics mirror dav_c220's public DataCopy/Sub implementation.
// Host validates tensor length, source gap, stride range and core availability.
template <typename T, bool Reverse>
__global__ __vector__ void sub_raw_packed_all(GM_ADDR low, GM_ADDR z, uint64_t dmaConfig, uint64_t vectorConfig, uint64_t storeConfig)
{
#if defined(__NPU_DEVICE__) || defined(__CCE_AICORE__)
    using namespace AscendC;
    if (sizeof(T)==2) ICachePreLoad(1);
    constexpr uint32_t N = 2048;
    constexpr uint32_t K = 1024;
    constexpr uint32_t bytes = K * sizeof(T);
    constexpr uint32_t yBase = N * sizeof(T) + 256;
    constexpr uint32_t repeats = bytes / 256;
    const uint32_t offset = static_cast<uint32_t>(block_idx) * N;
    __gm__ T* input = (__gm__ T*)low + offset;
    __gm__ T* output = (__gm__ T*)z + offset;
    __ubuf__ T* x0 = (__ubuf__ T*)(uint64_t)0;
    __ubuf__ T* x1 = (__ubuf__ T*)(uint64_t)bytes;
    __ubuf__ T* y0 = (__ubuf__ T*)(uint64_t)yBase;
    __ubuf__ T* y1 = (__ubuf__ T*)(uint64_t)(yBase + bytes);
    __ubuf__ T* z0 = sizeof(T) == 2 ? x0 : (__ubuf__ T*)(uint64_t)65536;
    __ubuf__ T* z1 = sizeof(T) == 2 ? x1 : (__ubuf__ T*)(uint64_t)(65536 + bytes);
    copy_gm_to_ubuf((__ubuf__ void*)x0, (__gm__ void*)input,
                   dmaConfig);
    SetFlag<HardEvent::MTE2_V>(EVENT_ID0);
    copy_gm_to_ubuf((__ubuf__ void*)x1, (__gm__ void*)(input + K),
                   dmaConfig);
    SetFlag<HardEvent::MTE2_V>(EVENT_ID1);
    // Repeat-mode Sub uses normal mode; leave a full mask for this dtype.
    set_vector_mask(sizeof(T) == 2 ? (uint64_t)-1 : (uint64_t)0, (uint64_t)-1);
    WaitFlag<HardEvent::MTE2_V>(EVENT_ID0);
    if (Reverse) vsub(z0, y0, x0, vectorConfig);
    else vsub(z0, x0, y0, vectorConfig);
    SetFlag<HardEvent::V_MTE3>(EVENT_ID0);
    WaitFlag<HardEvent::V_MTE3>(EVENT_ID0);
    copy_ubuf_to_gm((__gm__ void*)output, (__ubuf__ void*)z0,
                   storeConfig);
    WaitFlag<HardEvent::MTE2_V>(EVENT_ID1);
    if (Reverse) vsub(z1, y1, x1, vectorConfig);
    else vsub(z1, x1, y1, vectorConfig);
    SetFlag<HardEvent::V_MTE3>(EVENT_ID1);
    WaitFlag<HardEvent::V_MTE3>(EVENT_ID1);
    copy_ubuf_to_gm((__gm__ void*)(output + K), (__ubuf__ void*)z1,
                   storeConfig);
    SetFlag<HardEvent::MTE3_S>(EVENT_ID0);
    WaitFlag<HardEvent::MTE3_S>(EVENT_ID0);
#endif
}
template <typename T>
bool try_raw_packed_all(GM_ADDR x, GM_ADDR y, GM_ADDR z, aclrtStream stream)
{
    const uint64_t xa = reinterpret_cast<uint64_t>(x);
    const uint64_t ya = reinterpret_cast<uint64_t>(y);
    const uint64_t delta = xa < ya ? ya - xa : xa - ya;
    constexpr uint64_t chunkBytes = 1024 * sizeof(T);
    if (delta < chunkBytes || (delta - chunkBytes) % 32 != 0 ||
        (delta - chunkBytes) / 32 > 65535) return false;
    const uint64_t stride = (delta - chunkBytes) / 32;
    constexpr uint64_t yBase = 2048 * sizeof(T) + 256;
    // Pack the documented DMA fields using the validated runtime input gap.
    const uint64_t dmaConfig = (2ull << 4) | ((chunkBytes / 32) << 16) |
                               (stride << 32) | (((yBase - chunkBytes) / 32) << 48);
    constexpr uint64_t vectorConfig = 1ull | (1ull << 8) | (1ull << 16) |
        (8ull << 24) | (8ull << 32) | (8ull << 40) | ((chunkBytes / 256) << 56);
    constexpr uint64_t storeConfig = (1ull << 4) | ((chunkBytes / 32) << 16);
    if (xa < ya) sub_raw_packed_all<T, false><<<8, nullptr, stream>>>(x, z, dmaConfig, vectorConfig, storeConfig);
    else sub_raw_packed_all<T, true><<<8, nullptr, stream>>>(y, z, dmaConfig, vectorConfig, storeConfig);
    return true;
}
extern "C" void run_kernel(GM_ADDR x, const TensorGroupInfo& info_x,
                           GM_ADDR y, const TensorGroupInfo& info_y,
                           GM_ADDR z, const TensorGroupInfo& info_z,
                           int64_t availableCoreNum, aclrtStream stream)
{
    const auto& input = info_x.tensors[0];
    int64_t length = 1;
    for (int64_t dim = 0; dim < input.numDims; ++dim) length *= input.shape[dim];
    if (length == 16384 && availableCoreNum >= 8 && input.dtype == 0) {
        if (!try_raw_packed_all<float>(x, y, z, stream)) sub_stream2<float><<<8, nullptr, stream>>>(x, y, z);
    } else if (length == 16384 && availableCoreNum >= 8 && input.dtype == 1) {
        if (!try_raw_packed_all<half>(x, y, z, stream)) sub_stream2<half><<<8, nullptr, stream>>>(x, y, z);
    } else {
        run_kernel_fallback(x, info_x, y, info_y, z, info_z, availableCoreNum, stream);
    }
}
