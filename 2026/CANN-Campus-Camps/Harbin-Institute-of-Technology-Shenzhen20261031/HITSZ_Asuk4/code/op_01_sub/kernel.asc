#include <cmath>
#include "kernel_operator.h"
/*
 * Sub Kernel — Ascend C Direct Invocation
 * This file is #included — do NOT add main(), #pragma once, or include guards.
 *
 * TensorGroupInfo / TensorInfo (predefined):
 *   struct TensorInfo { const int64_t* shape; int64_t numDims; int32_t dtype; };
 *   struct TensorGroupInfo { const TensorInfo* tensors; int64_t numTensors; };
 *   dtype: 0=fp32 1=fp16 2=bf16 3=int8 4=int16 5=int32 6=int64 7=uint8 8=uint16 9=uint32 10=uint64 11=bool
 *   Usage: info_x.tensors[0].shape[0]  // first dim of first tensor in input x
 *
 * __global__ __vector__ void sub_custom(...)
 * {
 *     // TODO: implement your kernel logic
 *     // Available APIs: AscendC::TPipe, AscendC::TQue, AscendC::DataCopy, AscendC::Add, ...
 * }
 */
constexpr uint32_t TILE_LENGTH = 1024;

template <typename T>
__global__ __vector__ void sub_custom(GM_ADDR x, GM_ADDR y, GM_ADDR z,
                                      uint32_t elementsPerCore)
{
    const uint32_t coreOffset = AscendC::GetBlockIdx() * elementsPerCore;
    AscendC::GlobalTensor<T> xGm, yGm, zGm;
    xGm.SetGlobalBuffer(reinterpret_cast<__gm__ T *>(x) + coreOffset, elementsPerCore);
    yGm.SetGlobalBuffer(reinterpret_cast<__gm__ T *>(y) + coreOffset, elementsPerCore);
    zGm.SetGlobalBuffer(reinterpret_cast<__gm__ T *>(z) + coreOffset, elementsPerCore);

    AscendC::TPipe pipe;
    AscendC::TQue<AscendC::QuePosition::VECIN, 1> xQueue, yQueue;
    AscendC::TQue<AscendC::QuePosition::VECOUT, 1> zQueue;
    pipe.InitBuffer(xQueue, 1, TILE_LENGTH * sizeof(T));
    pipe.InitBuffer(yQueue, 1, TILE_LENGTH * sizeof(T));
    pipe.InitBuffer(zQueue, 1, TILE_LENGTH * sizeof(T));

    for (uint32_t offset = 0; offset < elementsPerCore; offset += TILE_LENGTH) {
        const uint32_t count = (elementsPerCore - offset < TILE_LENGTH)
                                   ? elementsPerCore - offset : TILE_LENGTH;
        auto xLocal = xQueue.AllocTensor<T>();
        auto yLocal = yQueue.AllocTensor<T>();
        AscendC::DataCopy(xLocal, xGm[offset], count);
        AscendC::DataCopy(yLocal, yGm[offset], count);
        xQueue.EnQue(xLocal);
        yQueue.EnQue(yLocal);

        xLocal = xQueue.DeQue<T>();
        yLocal = yQueue.DeQue<T>();
        auto zLocal = zQueue.AllocTensor<T>();
        AscendC::Sub(zLocal, xLocal, yLocal, count);
        zQueue.EnQue(zLocal);
        xQueue.FreeTensor(xLocal);
        yQueue.FreeTensor(yLocal);

        zLocal = zQueue.DeQue<T>();
        AscendC::DataCopy(zGm[offset], zLocal, count);
        zQueue.FreeTensor(zLocal);
    }
}

extern "C" void run_kernel(GM_ADDR x, const TensorGroupInfo& info_x, GM_ADDR y, const TensorGroupInfo& info_y, GM_ADDR z, const TensorGroupInfo& info_z, int64_t availableCoreNum, aclrtStream stream)
{
     const uint32_t totalElements = static_cast<uint32_t>(
        info_x.tensors[0].shape[0] * info_x.tensors[0].shape[1]);
    const uint32_t blockNum = availableCoreNum >= 8 ? 8 : 1;
    const uint32_t elementsPerCore = totalElements / blockNum;
    if (info_x.tensors[0].dtype == 1) {
        sub_custom<half><<<blockNum, nullptr, stream>>>(x, y, z, elementsPerCore);
    } else {
        sub_custom<float><<<blockNum, nullptr, stream>>>(x, y, z, elementsPerCore);
    }
}
