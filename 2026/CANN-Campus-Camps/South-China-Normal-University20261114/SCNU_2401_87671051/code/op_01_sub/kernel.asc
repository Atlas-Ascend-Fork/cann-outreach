#include <cmath>
#include "kernel_operator.h"

struct SubCustomTilingData {
    uint32_t totalLength;
    uint32_t tileNum;
};

template <typename T>
__global__ __vector__ void sub_custom(GM_ADDR x, GM_ADDR y, GM_ADDR z, SubCustomTilingData tiling)
{
    // 扁平化极简流水线
    uint32_t blockLength = tiling.totalLength / AscendC::GetBlockNum();
    uint32_t offset = blockLength * AscendC::GetBlockIdx();

    AscendC::GlobalTensor<T> xGm;
    AscendC::GlobalTensor<T> yGm;
    AscendC::GlobalTensor<T> zGm;
    xGm.SetGlobalBuffer((__gm__ T*)x + offset, blockLength);
    yGm.SetGlobalBuffer((__gm__ T*)y + offset, blockLength);
    zGm.SetGlobalBuffer((__gm__ T*)z + offset, blockLength);

    AscendC::TPipe pipe;
    AscendC::TQue<AscendC::QuePosition::VECIN, 1> inQueXY;
    AscendC::TQue<AscendC::QuePosition::VECOUT, 1> outQueZ;

    pipe.InitBuffer(inQueXY, 1, blockLength * 2 * sizeof(T));
    pipe.InitBuffer(outQueZ, 1, blockLength * sizeof(T));

    // 1. 合并搬入：单次分配，连续 DataCopy，并行搬运 X 和 Y
    AscendC::LocalTensor<T> xyLocal = inQueXY.AllocTensor<T>();
    AscendC::DataCopy(xyLocal, xGm, blockLength);
    AscendC::DataCopy(xyLocal[blockLength], yGm, blockLength);
    inQueXY.EnQue(xyLocal);

    // 2. 矢量计算：标准 API，利用编译器自动插入同步 Event
    AscendC::LocalTensor<T> xyDe = inQueXY.DeQue<T>();
    AscendC::LocalTensor<T> zLocal = outQueZ.AllocTensor<T>();
    AscendC::Sub(zLocal, xyDe, xyDe[blockLength], blockLength);
    outQueZ.EnQue(zLocal);
    inQueXY.FreeTensor(xyDe);

    // 3. 结果搬出
    AscendC::LocalTensor<T> zDe = outQueZ.DeQue<T>();
    AscendC::DataCopy(zGm, zDe, blockLength);
    outQueZ.FreeTensor(zDe);
}

extern "C" void run_kernel(GM_ADDR x, const TensorGroupInfo& info_x, GM_ADDR y, const TensorGroupInfo& info_y, GM_ADDR z, const TensorGroupInfo& info_z, int64_t availableCoreNum, aclrtStream stream)
{
    const TensorInfo& t0 = info_x.tensors[0];
    int64_t totalLength = 1;
    for (int64_t i = 0; i < t0.numDims; i++) {
        totalLength *= t0.shape[i];
    }
    if (totalLength <= 0) return;

    uint32_t elemSize = (t0.dtype == 1) ? 2u : 4u;
    uint32_t alignElems = 32u / elemSize;
    
    uint32_t maxCores = (availableCoreNum > 0) ? (uint32_t)availableCoreNum : 8u;
    if (maxCores > 64u) maxCores = 64u;

    // 【核心提速策略】：控制单核最小数据量，规避多核调度开销反超 MTE 搬运的时间。
    // 在数据规模仅数 KB 时，1~2 个核瞬间处理完毕，比启动几十个核要快数微秒。
    uint32_t targetCores = totalLength / 2048; 
    if (targetCores > 0 && targetCores < maxCores) {
        maxCores = targetCores;
    }
    if (maxCores < 1) maxCores = 1;
    
    uint32_t blockDim = 1u;
    for (uint32_t c = maxCores; c >= 1; c--) {
        if (totalLength % c == 0 && ((totalLength / c) % alignElems == 0)) {
            blockDim = c;
            break;
        }
    }

    SubCustomTilingData tiling = {(uint32_t)totalLength, 1u};
    if (t0.dtype == 1) {
        sub_custom<half><<<blockDim, nullptr, stream>>>(x, y, z, tiling);
    } else {
        sub_custom<float><<<blockDim, nullptr, stream>>>(x, y, z, tiling);
    }
}