#include <cmath>
#include "kernel_operator.h"

// 性能优化版 z = x - y
// 相比基准（8 核 × 16 次小循环）的改进：
//   1. 每核只做 1 次大块搬入 + 1 次 Sub + 1 次搬出，把每核指令数从 48 降到 4
//   2. 按 32B 对齐块均匀分配，保证核数不整除总数时也不漏算、不越界
//   3. 保留 8 核（与官方参考一致，避免 blockDim 语义与 GetBlockNum 不一致导致兼容性问题）

struct SubCustomTilingData {
    uint32_t totalLength;
    uint32_t blockDim;
};

constexpr uint32_t BUFFER_NUM = 1;
constexpr uint32_t QUEUE_DEPTH = 1;

template <typename T>
class KernelSub {
public:
    __aicore__ inline KernelSub() {}

    __aicore__ inline void Init(GM_ADDR x, GM_ADDR y, GM_ADDR z, const SubCustomTilingData& tiling)
    {
        // float32: 8 元素 = 32B；half: 16 元素 = 32B
        constexpr uint32_t alignElements = 32 / sizeof(T);
        uint32_t totalBlocks = tiling.totalLength / alignElements;
        uint32_t blockDim = tiling.blockDim;
        uint32_t blockIdx = AscendC::GetBlockIdx();
        uint32_t blocksPerCore = totalBlocks / blockDim;
        uint32_t extra = totalBlocks % blockDim;
        uint32_t myBlocks = blocksPerCore + (blockIdx < extra ? 1 : 0);
        if (myBlocks == 0) {
            this->length = 0;
            return;
        }
        uint32_t myBlockStart = blocksPerCore * blockIdx + (blockIdx < extra ? blockIdx : extra);
        this->offset = myBlockStart * alignElements;
        this->length = myBlocks * alignElements;
        xGm.SetGlobalBuffer((__gm__ T *)x + this->offset, this->length);
        yGm.SetGlobalBuffer((__gm__ T *)y + this->offset, this->length);
        zGm.SetGlobalBuffer((__gm__ T *)z + this->offset, this->length);
        uint32_t bytes = this->length * sizeof(T);
        pipe.InitBuffer(inQueueX, BUFFER_NUM, bytes);
        pipe.InitBuffer(inQueueY, BUFFER_NUM, bytes);
        pipe.InitBuffer(outQueueZ, BUFFER_NUM, bytes);
    }

    __aicore__ inline void Process()
    {
        if (this->length == 0) return;
        CopyIn();
        Compute();
        CopyOut();
    }

private:
    __aicore__ inline void CopyIn()
    {
        AscendC::LocalTensor<T> xLocal = inQueueX.AllocTensor<T>();
        AscendC::LocalTensor<T> yLocal = inQueueY.AllocTensor<T>();
        AscendC::DataCopy(xLocal, xGm, this->length);
        AscendC::DataCopy(yLocal, yGm, this->length);
        inQueueX.EnQue(xLocal);
        inQueueY.EnQue(yLocal);
    }

    __aicore__ inline void Compute()
    {
        AscendC::LocalTensor<T> xLocal = inQueueX.DeQue<T>();
        AscendC::LocalTensor<T> yLocal = inQueueY.DeQue<T>();
        AscendC::LocalTensor<T> zLocal = outQueueZ.AllocTensor<T>();
        AscendC::Sub(zLocal, xLocal, yLocal, this->length);
        outQueueZ.EnQue<T>(zLocal);
        inQueueX.FreeTensor(xLocal);
        inQueueY.FreeTensor(yLocal);
    }

    __aicore__ inline void CopyOut()
    {
        AscendC::LocalTensor<T> zLocal = outQueueZ.DeQue<T>();
        AscendC::DataCopy(zGm, zLocal, this->length);
        outQueueZ.FreeTensor(zLocal);
    }

private:
    AscendC::TPipe pipe;
    AscendC::TQue<AscendC::QuePosition::VECIN, QUEUE_DEPTH> inQueueX, inQueueY;
    AscendC::TQue<AscendC::QuePosition::VECOUT, QUEUE_DEPTH> outQueueZ;
    AscendC::GlobalTensor<T> xGm, yGm, zGm;
    uint32_t offset;
    uint32_t length;
};

template <typename T>
__global__ __vector__ void sub_custom(GM_ADDR x, GM_ADDR y, GM_ADDR z, SubCustomTilingData tiling)
{
    KernelSub<T> op;
    op.Init(x, y, z, tiling);
    op.Process();
}

extern "C" void run_kernel(GM_ADDR x, const TensorGroupInfo& info_x, GM_ADDR y, const TensorGroupInfo& info_y, GM_ADDR z, const TensorGroupInfo& info_z, int64_t availableCoreNum, aclrtStream stream)
{
    const TensorInfo& t0 = info_x.tensors[0];
    int64_t totalLength = 1;
    for (int64_t i = 0; i < t0.numDims; i++) {
        totalLength *= t0.shape[i];
    }
    int32_t dtype = t0.dtype;
    uint32_t alignElements = (dtype == 1) ? 16 : 8;
    uint32_t totalBlocks = (uint32_t)totalLength / alignElements;

    // 固定 8 核：与官方参考实现一致，GetBlockNum() 与启动核数严格对应
    uint32_t blockDim = 8;
    if (blockDim > totalBlocks) blockDim = totalBlocks;
    if (blockDim == 0) blockDim = 1;

    SubCustomTilingData tiling = {(uint32_t)totalLength, blockDim};
    if (dtype == 1) {
        sub_custom<half><<<blockDim, nullptr, stream>>>(x, y, z, tiling);
    } else {
        sub_custom<float><<<blockDim, nullptr, stream>>>(x, y, z, tiling);
    }
}