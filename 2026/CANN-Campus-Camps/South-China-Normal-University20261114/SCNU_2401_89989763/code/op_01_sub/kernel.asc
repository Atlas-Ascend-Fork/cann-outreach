#include <cmath>
#include "kernel_operator.h"
/*
 * Sub Kernel — Ascend C Direct Invocation   z = x - y
 * 该文件被 #include，不要加 main() / #pragma once / include guard
 *
 * dtype: 0=fp32 1=fp16 2=bf16 (本题只要求 fp32/fp16)
 */

using namespace AscendC;

namespace {
constexpr int32_t  kBufferNum  = 1;      // 队列深度（单缓冲即可，数据量很小）
constexpr uint32_t kTileBytes  = 8192;   // 单次搬运字节数，32B 的整数倍
}

// ---------------------------------------------------------------------------
// 通用 Sub 实现：T = float / half
// ---------------------------------------------------------------------------
template <typename T>
class KernelSub {
public:
    __aicore__ inline KernelSub() {}

    __aicore__ inline void Init(GM_ADDR x, GM_ADDR y, GM_ADDR z, uint32_t totalLen)
    {
        constexpr uint32_t kAlignElems = 32 / sizeof(T);   // 32B 对齐的元素个数

        uint32_t blockNum = static_cast<uint32_t>(GetBlockNum());
        uint32_t blockIdx = static_cast<uint32_t>(GetBlockIdx());
        if (blockNum == 0u) { blockNum = 1u; }

        // 1) 多核均分，长度向上对齐到 32B（DataCopy 要求 32B 对齐）
        uint32_t perBlock = (totalLen + blockNum - 1u) / blockNum;
        perBlock = (perBlock + kAlignElems - 1u) / kAlignElems * kAlignElems;

        uint32_t start = blockIdx * perBlock;
        if (start >= totalLen) {          // 尾核无数据
            blockLen_ = 0u;
            tileLen_  = 0u;
            return;
        }
        uint32_t remain = totalLen - start;
        blockLen_ = (remain < perBlock) ? remain : perBlock;

        // 2) 绑定 GM（起点偏移到本核负责的段）
        xGm_.SetGlobalBuffer((__gm__ T *)x + start, blockLen_);
        yGm_.SetGlobalBuffer((__gm__ T *)y + start, blockLen_);
        zGm_.SetGlobalBuffer((__gm__ T *)z + start, blockLen_);

        // 3) UB 分块：blockLen_ 可能大于一次能装下的量
        tileLen_ = kTileBytes / sizeof(T);
        if (tileLen_ > blockLen_) { tileLen_ = blockLen_; }

        pipe_.InitBuffer(inQueueX_,  kBufferNum, tileLen_ * sizeof(T));
        pipe_.InitBuffer(inQueueY_,  kBufferNum, tileLen_ * sizeof(T));
        pipe_.InitBuffer(outQueueZ_, kBufferNum, tileLen_ * sizeof(T));
    }

    __aicore__ inline void Process()
    {
        if (blockLen_ == 0u || tileLen_ == 0u) { return; }
        uint32_t offset = 0u;
        while (offset < blockLen_) {
            uint32_t len = blockLen_ - offset;
            if (len > tileLen_) { len = tileLen_; }
            CopyIn(offset, len);
            Compute(len);
            CopyOut(offset, len);
            offset += len;
        }
    }

private:
    __aicore__ inline void CopyIn(uint32_t offset, uint32_t len)
    {
        LocalTensor<T> xLocal = inQueueX_.AllocTensor<T>();
        LocalTensor<T> yLocal = inQueueY_.AllocTensor<T>();
        DataCopy(xLocal, xGm_[offset], len);   // GM -> UB
        DataCopy(yLocal, yGm_[offset], len);
        inQueueX_.EnQue(xLocal);
        inQueueY_.EnQue(yLocal);
    }

    __aicore__ inline void Compute(uint32_t len)
    {
        LocalTensor<T> xLocal = inQueueX_.DeQue<T>();
        LocalTensor<T> yLocal = inQueueY_.DeQue<T>();
        LocalTensor<T> zLocal = outQueueZ_.AllocTensor<T>();
        Sub(zLocal, xLocal, yLocal, (int32_t)len);   // 矢量减法
        outQueueZ_.EnQue(zLocal);
        inQueueX_.FreeTensor(xLocal);
        inQueueY_.FreeTensor(yLocal);
    }

    __aicore__ inline void CopyOut(uint32_t offset, uint32_t len)
    {
        LocalTensor<T> zLocal = outQueueZ_.DeQue<T>();
        DataCopy(zGm_[offset], zLocal, len);         // UB -> GM
        outQueueZ_.FreeTensor(zLocal);
    }

    TPipe  pipe_;
    TQue<QuePosition::VECIN,  kBufferNum> inQueueX_;
    TQue<QuePosition::VECIN,  kBufferNum> inQueueY_;
    TQue<QuePosition::VECOUT, kBufferNum> outQueueZ_;
    GlobalTensor<T> xGm_;
    GlobalTensor<T> yGm_;
    GlobalTensor<T> zGm_;
    uint32_t blockLen_ = 0u;
    uint32_t tileLen_  = 0u;
};

// ---------------------------------------------------------------------------
// 核函数（保持模板里给的名字 sub_custom 作为 fp32 主入口）
// ---------------------------------------------------------------------------
__global__ __vector__ void sub_custom(GM_ADDR x, GM_ADDR y, GM_ADDR z, uint32_t totalLen)
{
    KernelSub<float> op;
    op.Init(x, y, z, totalLen);
    op.Process();
}

__global__ __vector__ void sub_custom_fp16(GM_ADDR x, GM_ADDR y, GM_ADDR z, uint32_t totalLen)
{
    KernelSub<half> op;
    op.Init(x, y, z, totalLen);
    op.Process();
}

// ---------------------------------------------------------------------------
// 启动入口：根据 TensorInfo 算出元素个数 + dtype，决定 block 数和用哪个核
// ---------------------------------------------------------------------------
static inline uint64_t GetElemCount(const TensorGroupInfo &info)
{
    if (info.numTensors <= 0 || info.tensors == nullptr) { return 0; }
    const TensorInfo &t = info.tensors[0];
    uint64_t total = 1;
    for (int64_t d = 0; d < t.numDims; ++d) {
        total *= static_cast<uint64_t>(t.shape[d]);
    }
    return total;
}

extern "C" void run_kernel(GM_ADDR x, const TensorGroupInfo& info_x,
                           GM_ADDR y, const TensorGroupInfo& info_y,
                           GM_ADDR z, const TensorGroupInfo& info_z,
                           int64_t availableCoreNum, aclrtStream stream)
{
    (void)info_y;
    (void)info_z;

    uint64_t totalLen = GetElemCount(info_x);
    if (totalLen == 0) { return; }
    int32_t dtype = info_x.tensors[0].dtype;          // 0=fp32, 1=fp16

    // 每核至少拿到一个 32B 对齐块，避免核数多于数据块数
    uint64_t alignElems = (dtype == 1) ? 16ull : 8ull; // 32B / sizeof(T)
    uint64_t maxBlocks  = totalLen / alignElems;
    if (maxBlocks == 0) { maxBlocks = 1; }

    uint64_t blockNum = (availableCoreNum > 0) ? static_cast<uint64_t>(availableCoreNum) : 1ull;
    if (blockNum > maxBlocks) { blockNum = maxBlocks; }
    if (blockNum > 65535ull)  { blockNum = 65535ull; }

    if (dtype == 1) {   // fp16
        sub_custom_fp16<<<(uint32_t)blockNum, nullptr, stream>>>(x, y, z, (uint32_t)totalLen);
    } else {            // fp32（默认，也是本题验证集用例）
        sub_custom<<<(uint32_t)blockNum, nullptr, stream>>>(x, y, z, (uint32_t)totalLen);
    }
}