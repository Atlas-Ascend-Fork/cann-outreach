#include <cmath>
#include "kernel_operator.h"

struct SubCustomTilingData {
    uint32_t totalLength;
    uint32_t tileNum;
};

constexpr uint32_t BUFFER_NUM = 2;
constexpr uint32_t QUEUE_DEPTH = 1;

template <typename T>
class KernelSub {
public:
    __aicore__ inline KernelSub() {}

    __aicore__ inline void Init(GM_ADDR x, GM_ADDR y, GM_ADDR z, const SubCustomTilingData& tiling)
    {
        this->totalLength = tiling.totalLength;
        this->tileNum = tiling.tileNum;
        this->blockNum = AscendC::GetBlockNum();
        this->blockIdx = AscendC::GetBlockIdx();

        uint32_t base = this->totalLength / this->blockNum;
        uint32_t rem = this->totalLength % this->blockNum;
        this->ubLength = base + (this->blockIdx < rem ? 1u : 0u);
        this->startOffset = this->blockIdx * base + (this->blockIdx < rem ? this->blockIdx : rem);

        constexpr uint32_t ALIGN_ELEMS = 32 / sizeof(T);
        uint32_t want = this->ubLength / (this->tileNum * BUFFER_NUM);
        this->tileLength = want / ALIGN_ELEMS * ALIGN_ELEMS;
        if (this->tileLength == 0) {
            this->tileLength = this->ubLength < ALIGN_ELEMS ? this->ubLength : ALIGN_ELEMS;
        }
        if (this->tileLength == 0) {
            this->tileLength = 1;
        }

        xGm.SetGlobalBuffer((__gm__ T *)x + this->startOffset, this->ubLength);
        yGm.SetGlobalBuffer((__gm__ T *)y + this->startOffset, this->ubLength);
        zGm.SetGlobalBuffer((__gm__ T *)z + this->startOffset, this->ubLength);

        pipe.InitBuffer(inQueueX, BUFFER_NUM, this->tileLength * sizeof(T));
        pipe.InitBuffer(inQueueY, BUFFER_NUM, this->tileLength * sizeof(T));
        pipe.InitBuffer(outQueueZ, BUFFER_NUM, this->tileLength * sizeof(T));
    }

    __aicore__ inline void Process()
    {
        for (uint32_t progress = 0; progress < this->ubLength; progress += this->tileLength) {
            uint32_t lastTileLength = this->ubLength - progress;
            if (lastTileLength > this->tileLength) {
                lastTileLength = this->tileLength;
            }
            lastTileLength = this->AlignUp(progress, lastTileLength);
            CopyIn(progress, lastTileLength);
            Compute(lastTileLength);
            CopyOut(progress, lastTileLength);
        }
    }

private:
    __aicore__ inline uint32_t AlignUp(uint32_t progress, uint32_t count)
    {
        constexpr uint32_t ALIGN_ELEMS = 32 / sizeof(T);
        uint32_t aligned = (count + ALIGN_ELEMS - 1) / ALIGN_ELEMS * ALIGN_ELEMS;
        if (aligned > this->tileLength) {
            aligned = this->tileLength;
        }
        uint32_t distanceToEnd = this->totalLength - this->startOffset - progress;
        if (aligned > distanceToEnd) {
            aligned = distanceToEnd;
        }
        return aligned;
    }

    __aicore__ inline void CopyIn(uint32_t progress, uint32_t count)
    {
        AscendC::LocalTensor<T> xLocal = inQueueX.AllocTensor<T>();
        AscendC::LocalTensor<T> yLocal = inQueueY.AllocTensor<T>();
        AscendC::DataCopy(xLocal, xGm[progress], count);
        AscendC::DataCopy(yLocal, yGm[progress], count);
        inQueueX.EnQue(xLocal);
        inQueueY.EnQue(yLocal);
    }

    __aicore__ inline void Compute(uint32_t count)
    {
        AscendC::LocalTensor<T> xLocal = inQueueX.DeQue<T>();
        AscendC::LocalTensor<T> yLocal = inQueueY.DeQue<T>();
        AscendC::LocalTensor<T> zLocal = outQueueZ.AllocTensor<T>();
        AscendC::Sub(zLocal, xLocal, yLocal, count);
        outQueueZ.EnQue<T>(zLocal);
        inQueueX.FreeTensor(xLocal);
        inQueueY.FreeTensor(yLocal);
    }

    __aicore__ inline void CopyOut(uint32_t progress, uint32_t count)
    {
        AscendC::LocalTensor<T> zLocal = outQueueZ.DeQue<T>();
        AscendC::DataCopy(zGm[progress], zLocal, count);
        outQueueZ.FreeTensor(zLocal);
    }

private:
    AscendC::TPipe pipe;
    AscendC::TQue<AscendC::QuePosition::VECIN, QUEUE_DEPTH> inQueueX, inQueueY;
    AscendC::TQue<AscendC::QuePosition::VECOUT, QUEUE_DEPTH> outQueueZ;
    AscendC::GlobalTensor<T> xGm, yGm, zGm;

    uint32_t totalLength;
    uint32_t blockNum;
    uint32_t blockIdx;
    uint32_t ubLength;
    uint32_t startOffset;
    uint32_t tileNum;
    uint32_t tileLength;
};

__global__ __vector__ void sub_custom_fp32(GM_ADDR x, GM_ADDR y, GM_ADDR z, SubCustomTilingData tiling)
{
    KernelSub<float> op;
    op.Init(x, y, z, tiling);
    op.Process();
}

__global__ __vector__ void sub_custom_fp16(GM_ADDR x, GM_ADDR y, GM_ADDR z, SubCustomTilingData tiling)
{
    KernelSub<half> op;
    op.Init(x, y, z, tiling);
    op.Process();
}

extern "C" void run_kernel(GM_ADDR x, const TensorGroupInfo& info_x, GM_ADDR y, const TensorGroupInfo& info_y, GM_ADDR z, const TensorGroupInfo& info_z, int64_t availableCoreNum, aclrtStream stream)
{
    constexpr uint32_t blockDim = 8;
    const TensorInfo& t0 = info_x.tensors[0];
    int64_t totalLength = 1;
    for (int64_t i = 0; i < t0.numDims; i++) {
        totalLength *= t0.shape[i];
    }
    int32_t dtype = t0.dtype;
    uint32_t tileNum = 8;

    SubCustomTilingData tiling = {(uint32_t)totalLength, tileNum};
    if (dtype == 1) {
        sub_custom_fp16<<<blockDim, nullptr, stream>>>(x, y, z, tiling);
    } else {
        sub_custom_fp32<<<blockDim, nullptr, stream>>>(x, y, z, tiling);
    }
}

