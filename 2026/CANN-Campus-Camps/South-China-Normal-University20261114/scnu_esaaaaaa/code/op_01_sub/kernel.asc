
#include <cmath>
#include "kernel_operator.h"
/*
 * Sub Kernel — Ascend C Direct Invocation
 * This file is #included — do NOT add main(), #pragma once, or include guards.
 *
 * TensorGroupInfo / TensorInfo (predefined):
 *   struct TensorInfo { const int64_t* shape; int64_t numDims; int32_t dtype; };
 *   struct TensorGroupInfo { const TensorInfo* tensors; int64_t numTensors; };
 *   dtype: 0=fp32 1=fp16 2=bf16 3=int8 4=int16 5=int32 6=int64 7=uint8 8=uint16 9=uint32 10=uint64 11=bool
 *   Usage: info_x.tensors[0].shape[0]  // first dim of first tensor in input x
 */

using namespace AscendC;

constexpr uint32_t TILE_LENGTH = 256;

template <typename T>
class KernelSub {
public:
    __aicore__ inline void Init(GM_ADDR x, GM_ADDR y, GM_ADDR z,
                                uint32_t blockLength)
    {
        this->blockLength = blockLength;

        xGm.SetGlobalBuffer((__gm__ T *)x + GetBlockIdx() * blockLength,
                            blockLength);
        yGm.SetGlobalBuffer((__gm__ T *)y + GetBlockIdx() * blockLength,
                            blockLength);
        zGm.SetGlobalBuffer((__gm__ T *)z + GetBlockIdx() * blockLength,
                            blockLength);

        pipe.InitBuffer(inQueueX, 1, TILE_LENGTH * sizeof(T));
        pipe.InitBuffer(inQueueY, 1, TILE_LENGTH * sizeof(T));
        pipe.InitBuffer(outQueueZ, 1, TILE_LENGTH * sizeof(T));
    }

    __aicore__ inline void Process()
    {
        for (uint32_t offset = 0; offset < blockLength; offset += TILE_LENGTH) {
            uint32_t length = blockLength - offset;
            if (length > TILE_LENGTH) {
                length = TILE_LENGTH;
            }

            CopyIn(offset, length);
            Compute(length);
            CopyOut(offset, length);
        }
    }

private:
    __aicore__ inline void CopyIn(uint32_t offset, uint32_t length)
    {
        LocalTensor<T> xLocal = inQueueX.AllocTensor<T>();
        LocalTensor<T> yLocal = inQueueY.AllocTensor<T>();

        DataCopy(xLocal, xGm[offset], length);
        DataCopy(yLocal, yGm[offset], length);

        inQueueX.EnQue(xLocal);
        inQueueY.EnQue(yLocal);
    }

    __aicore__ inline void Compute(uint32_t length)
    {
        LocalTensor<T> xLocal = inQueueX.DeQue<T>();
        LocalTensor<T> yLocal = inQueueY.DeQue<T>();
        LocalTensor<T> zLocal = outQueueZ.AllocTensor<T>();

        Sub(zLocal, xLocal, yLocal, length);

        outQueueZ.EnQue<T>(zLocal);
        inQueueX.FreeTensor(xLocal);
        inQueueY.FreeTensor(yLocal);
    }

    __aicore__ inline void CopyOut(uint32_t offset, uint32_t length)
    {
        LocalTensor<T> zLocal = outQueueZ.DeQue<T>();

        DataCopy(zGm[offset], zLocal, length);

        outQueueZ.FreeTensor(zLocal);
    }

    TPipe pipe;
    TQue<QuePosition::VECIN, 1> inQueueX;
    TQue<QuePosition::VECIN, 1> inQueueY;
    TQue<QuePosition::VECOUT, 1> outQueueZ;

    GlobalTensor<T> xGm;
    GlobalTensor<T> yGm;
    GlobalTensor<T> zGm;

    uint32_t blockLength;
};

template <typename T>
__global__ __vector__ void sub_custom(GM_ADDR x, GM_ADDR y, GM_ADDR z,
                                      uint32_t blockLength)
{
    KernelSub<T> op;
    op.Init(x, y, z, blockLength);
    op.Process();
}

extern "C" void run_kernel(GM_ADDR x, const TensorGroupInfo& info_x,
                           GM_ADDR y, const TensorGroupInfo& info_y,
                           GM_ADDR z, const TensorGroupInfo& info_z,
                           int64_t availableCoreNum, aclrtStream stream)
{
    (void)info_y;
    (void)info_z;

    const TensorInfo& xInfo = info_x.tensors[0];

    int64_t elementCount64 = 1;
    for (int64_t dim = 0; dim < xInfo.numDims; ++dim) {
        elementCount64 *= xInfo.shape[dim];
    }

    if (elementCount64 <= 0 || elementCount64 > 0xffffffffLL) {
        return;
    }

    const uint32_t elementCount = static_cast<uint32_t>(elementCount64);

    // 为每个 core 分配等长且对齐的连续数据块。
    uint32_t blockNum = 1;
    const uint32_t coreLimit = availableCoreNum > 0
        ? static_cast<uint32_t>(availableCoreNum)
        : 1;

    while (blockNum <= coreLimit / 2 &&
           blockNum <= elementCount / 32 &&
           elementCount % (blockNum * 2) == 0) {
        blockNum *= 2;
    }

    const uint32_t blockLength = elementCount / blockNum;

    if (xInfo.dtype == 0) {
        sub_custom<float><<<blockNum, nullptr, stream>>>(
            x, y, z, blockLength);
    } else if (xInfo.dtype == 1) {
        sub_custom<half><<<blockNum, nullptr, stream>>>(
            x, y, z, blockLength);
    }
}
