#include <cmath>
#include "kernel_operator.h"
/*
 * Sub Kernel — Ascend C Direct Invocation
 * This file is #included — do NOT add main(), #pragma once, or include guards.
 *
 * TensorGroupInfo / TensorInfo (predefined):
 *   struct TensorInfo { const int64_t* shape; int64_t numDims; int32_t dtype; };
 *   struct TensorGroupInfo { const TensorInfo* tensors; int64_t numTensors; };
 *   dtype: 0=fp32 1=fp16 2=bf16 3=int8 4=int16 5=int32 6=int64 7=uint8 8=uint16 9=uint32 10=uint64 11=bool
 *   Usage: info_x.tensors[0].shape[0]  // first dim of first tensor in input x
 *
 * 算子功能：z = x - y（逐元素矢量减法）
 * 实现要点：多核切分 + 核内双 buffer 分块流水（CopyIn → Compute → CopyOut）
 */

// ---------------------------------------------------------------------------
// Tiling 参数：由 host 侧 run_kernel 计算后按值传给核函数
// ---------------------------------------------------------------------------
struct SubCustomTilingData {
    uint32_t totalLength;   // 待处理数据总长度（元素个数），例如 8 * 2048 = 16384
    uint32_t blockLength;   // 每个核处理的元素数（多核切分后）
    uint32_t tileNum;       // 单核内将数据进一步切分为多少块（Tile）
    uint32_t tileLength;    // 单块元素数 = blockLength / (tileNum * BUFFER_NUM)
};

constexpr uint32_t BUFFER_NUM = 2;    // 每个队列的 buffer 块数（双 buffer）
constexpr uint32_t QUEUE_DEPTH = 1;   // 队列深度

// ---------------------------------------------------------------------------
// KernelSub：z = x - y
// 每核负责 blockLength 个元素，核内再按 tileNum * BUFFER_NUM 分块迭代处理。
// 模板化，支持 float32（float）与 float16（half）。
// ---------------------------------------------------------------------------
template <typename T>
class KernelSub {
public:
    __aicore__ inline KernelSub() {}

    __aicore__ inline void Init(GM_ADDR x, GM_ADDR y, GM_ADDR z, const SubCustomTilingData& tiling)
    {
        this->blockLength = tiling.blockLength;
        this->tileNum = tiling.tileNum;
        this->tileLength = tiling.tileLength;
        this->loopCount = static_cast<int32_t>(tiling.tileNum) * static_cast<int32_t>(BUFFER_NUM);

        // 多核切分：第 blockIdx 个核只处理 [blockIdx * blockLength, +blockLength) 这一段
        // host 侧已保证 totalLength 能被 blockDim 整除，故不存在跨核剩余
        int64_t startOffset = static_cast<int64_t>(AscendC::GetBlockIdx()) * static_cast<int64_t>(this->blockLength);
        if (startOffset >= static_cast<int64_t>(tiling.totalLength)) {
            // 该核没有分配到数据，直接空跑
            this->loopCount = 0;
            startOffset = 0;
        }

        // 设置每个核在 Global Memory 中的起始地址（关键的多核切分逻辑）
        xGm.SetGlobalBuffer((__gm__ T *)x + startOffset, this->blockLength);
        yGm.SetGlobalBuffer((__gm__ T *)y + startOffset, this->blockLength);
        zGm.SetGlobalBuffer((__gm__ T *)z + startOffset, this->blockLength);

        // 为各队列分配 UB 内存（双 buffer 共 BUFFER_NUM 块，每块 tileLength 个元素）
        pipe.InitBuffer(inQueueX, BUFFER_NUM, this->tileLength * sizeof(T));
        pipe.InitBuffer(inQueueY, BUFFER_NUM, this->tileLength * sizeof(T));
        pipe.InitBuffer(outQueueZ, BUFFER_NUM, this->tileLength * sizeof(T));
    }

    __aicore__ inline void Process()
    {
        // 循环次数 = tileNum × BUFFER_NUM（tileLength 已按 BUFFER_NUM 折半）
        for (int32_t i = 0; i < this->loopCount; i++) {
            CopyIn(i);    // 搬入第 i 块数据
            Compute(i);   // 计算第 i 块数据（z = x - y）
            CopyOut(i);   // 搬出第 i 块结果
        }
    }

private:
    __aicore__ inline void CopyIn(int32_t progress)
    {
        AscendC::LocalTensor<T> xLocal = inQueueX.AllocTensor<T>();
        AscendC::LocalTensor<T> yLocal = inQueueY.AllocTensor<T>();
        // 从 Global Memory 搬入当前数据块到 Local Memory
        AscendC::DataCopy(xLocal, xGm[progress * this->tileLength], this->tileLength);
        AscendC::DataCopy(yLocal, yGm[progress * this->tileLength], this->tileLength);
        inQueueX.EnQue(xLocal);
        inQueueY.EnQue(yLocal);
    }

    __aicore__ inline void Compute(int32_t progress)
    {
        AscendC::LocalTensor<T> xLocal = inQueueX.DeQue<T>();
        AscendC::LocalTensor<T> yLocal = inQueueY.DeQue<T>();
        AscendC::LocalTensor<T> zLocal = outQueueZ.AllocTensor<T>();
        // 矢量减法：z = x - y
        AscendC::Sub(zLocal, xLocal, yLocal, this->tileLength);
        outQueueZ.EnQue<T>(zLocal);
        // 释放输入内存，避免 UB 泄漏
        inQueueX.FreeTensor(xLocal);
        inQueueY.FreeTensor(yLocal);
    }

    __aicore__ inline void CopyOut(int32_t progress)
    {
        AscendC::LocalTensor<T> zLocal = outQueueZ.DeQue<T>();
        // 将结果从 Local Memory 搬出到 Global Memory
        AscendC::DataCopy(zGm[progress * this->tileLength], zLocal, this->tileLength);
        outQueueZ.FreeTensor(zLocal);
    }

private:
    AscendC::TPipe pipe;                                                      // 内存管理对象
    AscendC::TQue<AscendC::QuePosition::VECIN, QUEUE_DEPTH> inQueueX, inQueueY; // 输入队列（VECIN）
    AscendC::TQue<AscendC::QuePosition::VECOUT, QUEUE_DEPTH> outQueueZ;        // 输出队列（VECOUT）
    AscendC::GlobalTensor<T> xGm, yGm, zGm;                                   // 输入/输出 Global Memory
    uint32_t blockLength;  // 每核处理的元素数
    uint32_t tileNum;      // 单核内分块数
    uint32_t tileLength;   // 单块元素数
    int32_t loopCount;     // 单核循环次数
};

// ---------------------------------------------------------------------------
// 核函数入口：实例化 KernelSub<T> 并执行（T 由 run_kernel 按输入 dtype 选择）
// ---------------------------------------------------------------------------
template <typename T>
__global__ __vector__ void sub_custom(GM_ADDR x, GM_ADDR y, GM_ADDR z, SubCustomTilingData tiling)
{
    KernelSub<T> op;
    op.Init(x, y, z, tiling);
    op.Process();
}

// ---------------------------------------------------------------------------
// host 侧启动函数：从 TensorGroupInfo 推导 tiling 并启动核函数
// ---------------------------------------------------------------------------
extern "C" void run_kernel(GM_ADDR x, const TensorGroupInfo& info_x, GM_ADDR y, const TensorGroupInfo& info_y, GM_ADDR z, const TensorGroupInfo& info_z, int64_t availableCoreNum, aclrtStream stream)
{
    // 1. 取总元素数（x / y / z 形状一致，z 结果形状由 x 决定）
    const TensorInfo& t0 = info_x.tensors[0];
    int64_t totalLength = 1;
    for (int64_t i = 0; i < t0.numDims; i++) {
        totalLength *= t0.shape[i];
    }
    if (totalLength <= 0) {
        return;
    }

    // 2. 按 dtype 选择数据类型（0=fp32 1=fp16）
    int32_t dtype = t0.dtype;
    // DataCopy 要求长度按 32 字节对齐：fp32 为 8 个元素、fp16 为 16 个元素
    uint32_t alignElem = (dtype == 1) ? 16u : 8u;

    // 3. 选择 blockDim：不超过可用核数、且不超过 8（本题数据量固定，8 核即可让每核 2048 个元素）
    int64_t coreLimit = availableCoreNum > 0 ? availableCoreNum : 1;
    if (coreLimit > 8) {
        coreLimit = 8;
    }

    uint32_t blockDim = 0;
    uint32_t blockLength = 0;
    uint32_t tileNum = 0;
    uint32_t tileLength = 0;

    // 从大到小挑一个能整除总长度、且每核数据量仍满足 32B 对齐的核数
    for (uint32_t cand = static_cast<uint32_t>(coreLimit); cand > 0; cand--) {
        if (totalLength % static_cast<int64_t>(cand) != 0) {
            continue;
        }
        uint32_t per = static_cast<uint32_t>(totalLength / static_cast<int64_t>(cand));
        if (per % alignElem != 0) {
            continue;
        }
        blockDim = cand;
        blockLength = per;
        break;
    }
    if (blockDim == 0) {
        // 兜底：单核处理全部数据
        blockDim = 1;
        blockLength = static_cast<uint32_t>(totalLength);
    }

    // 4. 选择核内分块数：保证 blockLength / (tileNum * BUFFER_NUM) 仍为 32B 对齐且大于 0
    for (uint32_t cand = 8; cand > 0; cand /= 2) {
        uint32_t unit = blockLength / (cand * BUFFER_NUM);
        if (blockLength % (cand * BUFFER_NUM) != 0 || unit == 0 || unit % alignElem != 0) {
            continue;
        }
        tileNum = cand;
        tileLength = unit;
        break;
    }
    if (tileNum == 0) {
        tileNum = 1;
        tileLength = blockLength;
    }

    SubCustomTilingData tiling = {static_cast<uint32_t>(totalLength), blockLength, tileNum, tileLength};

    // 5. 启动核函数：fp16 走 half 实例，fp32 及其他类型默认走 float 实例
    if (dtype == 1) {
        sub_custom<half><<<blockDim, nullptr, stream>>>(x, y, z, tiling);
    } else {
        sub_custom<float><<<blockDim, nullptr, stream>>>(x, y, z, tiling);
    }
}
