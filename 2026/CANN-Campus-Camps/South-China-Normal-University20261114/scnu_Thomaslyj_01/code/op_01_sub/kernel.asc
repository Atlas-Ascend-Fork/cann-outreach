#include <cstdint>
#include "kernel_operator.h"

// Fixed shape: (8, 2048). Static tensors follow the Ascend C guide.
// Tensor sizes are compile-time constants; the host selects the core count.
template <typename T, uint32_t COUNT>
__global__ __vector__ void lesson1_sub_static(GM_ADDR x, GM_ADDR y, GM_ADDR z)
{
    const uint32_t offset = AscendC::GetBlockIdx() * COUNT;
    AscendC::GlobalTensor<T> xGm, yGm, zGm;
    xGm.SetGlobalBuffer((__gm__ T*)x + offset, COUNT);
    yGm.SetGlobalBuffer((__gm__ T*)y + offset, COUNT);
    zGm.SetGlobalBuffer((__gm__ T*)z + offset, COUNT);

    constexpr uint32_t STRIDE = COUNT * sizeof(T) + (COUNT < 16384 ? 32 : 0);
    AscendC::LocalTensor<T> xLocal(AscendC::TPosition::VECCALC, 0, COUNT);
    AscendC::LocalTensor<T> yLocal(AscendC::TPosition::VECCALC, STRIDE, COUNT);
    AscendC::LocalTensor<T> zLocal(AscendC::TPosition::VECCALC, 2 * STRIDE, COUNT);
    AscendC::DataCopy(xLocal, xGm, COUNT);
    AscendC::DataCopy(yLocal, yGm, COUNT);
    AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(0);
    AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(0);
    // All chunks are multiples of the 256-byte vector repeat width.
    constexpr uint32_t PAR = 256 / sizeof(T);
    constexpr uint32_t REPEATS = COUNT / PAR;
    if (REPEATS <= 255) {
        AscendC::Sub(zLocal, xLocal, yLocal, static_cast<uint64_t>(PAR),
                     static_cast<uint8_t>(REPEATS), {1, 1, 1, 8, 8, 8});
    } else {
        // The one-core fp32 fallback needs 256 repeats: split 255 + 1.
        AscendC::Sub(zLocal, xLocal, yLocal, static_cast<uint64_t>(PAR),
                     static_cast<uint8_t>(255), {1, 1, 1, 8, 8, 8});
        AscendC::Sub(zLocal[255 * PAR], xLocal[255 * PAR], yLocal[255 * PAR],
                     static_cast<uint64_t>(PAR), static_cast<uint8_t>(REPEATS - 255),
                     {1, 1, 1, 8, 8, 8});
    }
    AscendC::SetFlag<AscendC::HardEvent::V_MTE3>(0);
    AscendC::WaitFlag<AscendC::HardEvent::V_MTE3>(0);
    AscendC::DataCopy(zGm, zLocal, COUNT);
}

template <typename T>
inline void LaunchLesson1Sub(GM_ADDR x, GM_ADDR y, GM_ADDR z,
                             uint32_t cores, aclrtStream stream)
{
    if (cores == 8) {
        lesson1_sub_static<T, 2048><<<8, nullptr, stream>>>(x, y, z);
    } else if (cores == 4) {
        lesson1_sub_static<T, 4096><<<4, nullptr, stream>>>(x, y, z);
    } else if (cores == 2) {
        lesson1_sub_static<T, 8192><<<2, nullptr, stream>>>(x, y, z);
    } else {
        lesson1_sub_static<T, 16384><<<1, nullptr, stream>>>(x, y, z);
    }
}

extern "C" void run_kernel(GM_ADDR x, const TensorGroupInfo& info_x,
                           GM_ADDR y, const TensorGroupInfo& info_y,
                           GM_ADDR z, const TensorGroupInfo& info_z,
                           int64_t availableCoreNum, aclrtStream stream)
{
    (void)info_y;
    (void)info_z;
    if (availableCoreNum <= 0) {
        return;
    }
    uint32_t blockNum = 8;
    while (static_cast<int64_t>(blockNum) > availableCoreNum) {
        blockNum /= 2;
    }
    if (info_x.tensors[0].dtype == 0) {
        LaunchLesson1Sub<float>(x, y, z, blockNum, stream);
    } else if (info_x.tensors[0].dtype == 1) {
        LaunchLesson1Sub<half>(x, y, z, blockNum, stream);
    }
}
