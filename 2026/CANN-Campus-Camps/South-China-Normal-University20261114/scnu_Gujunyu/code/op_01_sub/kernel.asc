#include <cmath>
#include "kernel_operator.h"

constexpr uint32_t BUFFER_NUM  = 2;
constexpr uint32_t QUEUE_DEPTH = 1;
constexpr uint32_t TILE_NUM    = 8;

template <typename T>
class KernelSub {
public:
    __aicore__ inline KernelSub() {}

    __aicore__ inline void Init(GM_ADDR x, GM_ADDR y, GM_ADDR z,
                                uint32_t blockLength, uint32_t tileLength)
    {
        blockLength_ = blockLength;
        tileLength_  = tileLength;
        uint32_t gmOffset = blockLength * AscendC::GetBlockIdx();
        xGm.SetGlobalBuffer((__gm__ T *)x + gmOffset, blockLength);
        yGm.SetGlobalBuffer((__gm__ T *)y + gmOffset, blockLength);
        zGm.SetGlobalBuffer((__gm__ T *)z + gmOffset, blockLength);
        pipe.InitBuffer(inQueueX, BUFFER_NUM, tileLength * sizeof(T));
        pipe.InitBuffer(inQueueY, BUFFER_NUM, tileLength * sizeof(T));
        pipe.InitBuffer(outQueueZ, BUFFER_NUM, tileLength * sizeof(T));
    }

    __aicore__ inline void Process()
    {
        uint32_t loopCount = blockLength_ / tileLength_;
        for (uint32_t i = 0; i < loopCount; ++i) {
            CopyIn(i);
            Compute(i);
            CopyOut(i);
        }
    }

private:
    __aicore__ inline void CopyIn(uint32_t progress)
    {
        AscendC::LocalTensor<T> xLocal = inQueueX.AllocTensor<T>();
        AscendC::LocalTensor<T> yLocal = inQueueY.AllocTensor<T>();
        AscendC::DataCopy(xLocal, xGm[progress * tileLength_], tileLength_);
        AscendC::DataCopy(yLocal, yGm[progress * tileLength_], tileLength_);
        inQueueX.EnQue(xLocal);
        inQueueY.EnQue(yLocal);
    }

    __aicore__ inline void Compute(uint32_t progress)
    {
        AscendC::LocalTensor<T> xLocal = inQueueX.DeQue<T>();
        AscendC::LocalTensor<T> yLocal = inQueueY.DeQue<T>();
        AscendC::LocalTensor<T> zLocal = outQueueZ.AllocTensor<T>();
        AscendC::Sub(zLocal, xLocal, yLocal, tileLength_);
        outQueueZ.EnQue<T>(zLocal);
        inQueueX.FreeTensor(xLocal);
        inQueueY.FreeTensor(yLocal);
    }

    __aicore__ inline void CopyOut(uint32_t progress)
    {
        AscendC::LocalTensor<T> zLocal = outQueueZ.DeQue<T>();
        AscendC::DataCopy(zGm[progress * tileLength_], zLocal, tileLength_);
        outQueueZ.FreeTensor(zLocal);
    }

private:
    AscendC::TPipe pipe;
    AscendC::TQue<AscendC::QuePosition::VECIN,  QUEUE_DEPTH> inQueueX, inQueueY;
    AscendC::TQue<AscendC::QuePosition::VECOUT, QUEUE_DEPTH> outQueueZ;
    AscendC::GlobalTensor<T> xGm, yGm, zGm;
    uint32_t blockLength_;
    uint32_t tileLength_;
};

__global__ __vector__ void sub_custom(GM_ADDR x, GM_ADDR y, GM_ADDR z,
                                      uint32_t blockLength, uint32_t tileLength)
{
    KernelSub<float> op;
    op.Init(x, y, z, blockLength, tileLength);
    op.Process();
}

__global__ __vector__ void sub_custom_half(GM_ADDR x, GM_ADDR y, GM_ADDR z,
                                           uint32_t blockLength, uint32_t tileLength)
{
    KernelSub<half> op;
    op.Init(x, y, z, blockLength, tileLength);
    op.Process();
}

extern "C" void run_kernel(GM_ADDR x, const TensorGroupInfo& info_x,
                           GM_ADDR y, const TensorGroupInfo& info_y,
                           GM_ADDR z, const TensorGroupInfo& info_z,
                           int64_t availableCoreNum, aclrtStream stream)
{
    (void)availableCoreNum;
    (void)info_y;
    (void)info_z;

    const TensorInfo& t0 = info_x.tensors[0];
    int64_t totalLength = 1;
    for (int64_t i = 0; i < t0.numDims; ++i) {
        totalLength *= t0.shape[i];
    }
    if (totalLength <= 0) {
        return;
    }

    uint32_t blockDim = 8;
    while (blockDim > 1 && (totalLength % blockDim) != 0) {
        blockDim >>= 1;
    }
    uint32_t blockLength = (uint32_t)(totalLength / (int64_t)blockDim);

    uint32_t tileLength = blockLength / (TILE_NUM * BUFFER_NUM);
    tileLength = (tileLength / 8) * 8;
    if (tileLength == 0) {
        tileLength = 8;
    }
    while (tileLength > 8 && (blockLength % tileLength) != 0) {
        tileLength -= 8;
    }

    if (t0.dtype == 1) {
        sub_custom_half<<<blockDim, nullptr, stream>>>(x, y, z, blockLength, tileLength);
    } else {
        sub_custom<<<blockDim, nullptr, stream>>>(x, y, z, blockLength, tileLength);
    }
}
