
#include <cmath>
#include "kernel_operator.h"

template <typename T, uint32_t BLOCK_LENGTH>
__global__ __vector__ void sub_custom(
    GM_ADDR x,
    GM_ADDR y,
    GM_ADDR z)
{
    AscendC::InitSocState();

    constexpr uint32_t BUFFER_BYTES =
        BLOCK_LENGTH * sizeof(T);

    const uint32_t offset =
        AscendC::GetBlockIdx() * BLOCK_LENGTH;

    AscendC::GlobalTensor<T> xGm;
    AscendC::GlobalTensor<T> yGm;
    AscendC::GlobalTensor<T> zGm;

    xGm.SetGlobalBuffer(
        (__gm__ T*)x + offset,
        BLOCK_LENGTH);

    yGm.SetGlobalBuffer(
        (__gm__ T*)y + offset,
        BLOCK_LENGTH);

    zGm.SetGlobalBuffer(
        (__gm__ T*)z + offset,
        BLOCK_LENGTH);

    AscendC::LocalTensor<T> xLocal(
        AscendC::TPosition::VECCALC,
        0,
        BLOCK_LENGTH);

    AscendC::LocalTensor<T> yLocal(
        AscendC::TPosition::VECCALC,
        BUFFER_BYTES,
        BLOCK_LENGTH);

    AscendC::LocalTensor<T> zLocal(
        AscendC::TPosition::VECCALC,
        2 * BUFFER_BYTES,
        BLOCK_LENGTH);

    // CopyIn
    AscendC::DataCopy(
        xLocal, xGm, BLOCK_LENGTH);

    AscendC::DataCopy(
        yLocal, yGm, BLOCK_LENGTH);

    AscendC::SetFlag<
        AscendC::HardEvent::MTE2_V>(0);

    AscendC::WaitFlag<
        AscendC::HardEvent::MTE2_V>(0);

    // Compute
    AscendC::Sub(
        zLocal,
        xLocal,
        yLocal,
        BLOCK_LENGTH);

    AscendC::SetFlag<
        AscendC::HardEvent::V_MTE3>(0);

    AscendC::WaitFlag<
        AscendC::HardEvent::V_MTE3>(0);

    // CopyOut
    AscendC::DataCopy(
        zGm, zLocal, BLOCK_LENGTH);

    AscendC::PipeBarrier<PIPE_ALL>();
}

extern "C" void run_kernel(
    GM_ADDR x,
    const TensorGroupInfo& info_x,
    GM_ADDR y,
    const TensorGroupInfo& info_y,
    GM_ADDR z,
    const TensorGroupInfo& info_z,
    int64_t availableCoreNum,
    aclrtStream stream)
{
    // 实验：固定使用8个核
    constexpr uint32_t BLOCK_DIM = 8;

    // 16384 / 8 = 2048
    constexpr uint32_t BLOCK_LENGTH = 2048;

    const int32_t dtype =
        info_x.tensors[0].dtype;

    if (dtype == 1) {
        // float16
        sub_custom<half, BLOCK_LENGTH>
            <<<BLOCK_DIM, nullptr, stream>>>(
                x, y, z);
    } else {
        // float32
        sub_custom<float, BLOCK_LENGTH>
            <<<BLOCK_DIM, nullptr, stream>>>(
                x, y, z);
    }
}
