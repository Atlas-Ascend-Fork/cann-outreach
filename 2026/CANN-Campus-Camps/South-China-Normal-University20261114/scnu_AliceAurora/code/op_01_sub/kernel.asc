#include <cmath>
#include <cstdint>
#include "kernel_operator.h"
/*
 * Sub Kernel — Ascend C Direct Invocation
 * This file is #included — do NOT add main(), #pragma once, or include guards.
 *
 * TensorGroupInfo / TensorInfo (predefined):
 *   struct TensorInfo { const int64_t* shape; int64_t numDims; int32_t dtype; };
 *   struct TensorGroupInfo { const TensorInfo* tensors; int64_t numTensors; };
 *   dtype: 0=fp32 1=fp16 2=bf16 3=int8 4=int16 5=int32 6=int64 7=uint8 8=uint16 9=uint32 10=uint64 11=bool
 *   Usage: info_x.tensors[0].shape[0]  // first dim of first tensor in input x
 *
 * The supplied case is contiguous float32 [8, 2048]. The reference also
 * demonstrates float16. Handle equal-shaped tensors of either type, without
 * assuming a fixed rank, element count, or divisibility by the core count.
 */

namespace CannJudgeSub {
constexpr uint32_t TILE_ELEMENTS = 2048;
constexpr int32_t BUFFER_NUM = 2;

template <typename T>
class KernelSub {
public:
    __aicore__ inline KernelSub() {}

    __aicore__ inline void Init(GM_ADDR x, GM_ADDR y, GM_ADDR z,
                               uint64_t totalElements, AscendC::TPipe* pipe)
    {
        totalElements_ = totalElements;
        xGm_.SetGlobalBuffer((__gm__ T*)x, totalElements);
        yGm_.SetGlobalBuffer((__gm__ T*)y, totalElements);
        zGm_.SetGlobalBuffer((__gm__ T*)z, totalElements);
        pipe->InitBuffer(inQueueX_, BUFFER_NUM, TILE_ELEMENTS * sizeof(T));
        pipe->InitBuffer(inQueueY_, BUFFER_NUM, TILE_ELEMENTS * sizeof(T));
        pipe->InitBuffer(outQueueZ_, BUFFER_NUM, TILE_ELEMENTS * sizeof(T));
    }

    __aicore__ inline void Process()
    {
        // Tile starts are 32-byte aligned. Each tile belongs to exactly one
        // core, including when there are fewer tiles than available cores.
        const uint64_t step = static_cast<uint64_t>(AscendC::GetBlockNum()) * TILE_ELEMENTS;
        for (uint64_t offset = static_cast<uint64_t>(AscendC::GetBlockIdx()) * TILE_ELEMENTS;
             offset < totalElements_; offset += step) {
            const uint64_t remaining = totalElements_ - offset;
            const uint32_t count = remaining < TILE_ELEMENTS
                ? static_cast<uint32_t>(remaining) : TILE_ELEMENTS;
            CopyIn(offset, count);
            Compute(count);
            CopyOut(offset, count);
        }
    }

private:
    __aicore__ inline void CopyIn(uint64_t offset, uint32_t count)
    {
        AscendC::LocalTensor<T> xLocal = inQueueX_.AllocTensor<T>();
        AscendC::LocalTensor<T> yLocal = inQueueY_.AllocTensor<T>();
        if (count % (32 / sizeof(T)) == 0) {
            AscendC::DataCopy(xLocal, xGm_[offset], count);
            AscendC::DataCopy(yLocal, yGm_[offset], count);
        } else {
            // DataCopy's element-count overload rounds down to 32 bytes.
            // Copy only valid GM bytes; padding stays inside the UB tile.
            const AscendC::DataCopyExtParams copyParams{
                1, static_cast<uint32_t>(count * sizeof(T)), 0, 0, 0};
            const AscendC::DataCopyPadExtParams<T> padParams{false, 0, 0, 0};
            AscendC::DataCopyPad(xLocal, xGm_[offset], copyParams, padParams);
            AscendC::DataCopyPad(yLocal, yGm_[offset], copyParams, padParams);
        }
        inQueueX_.EnQue(xLocal);
        inQueueY_.EnQue(yLocal);
    }

    __aicore__ inline void Compute(uint32_t count)
    {
        AscendC::LocalTensor<T> xLocal = inQueueX_.DeQue<T>();
        AscendC::LocalTensor<T> yLocal = inQueueY_.DeQue<T>();
        AscendC::LocalTensor<T> zLocal = outQueueZ_.AllocTensor<T>();
        AscendC::Sub(zLocal, xLocal, yLocal, count);
        outQueueZ_.EnQue(zLocal);
        inQueueX_.FreeTensor(xLocal);
        inQueueY_.FreeTensor(yLocal);
    }

    __aicore__ inline void CopyOut(uint64_t offset, uint32_t count)
    {
        AscendC::LocalTensor<T> zLocal = outQueueZ_.DeQue<T>();
        if (count % (32 / sizeof(T)) == 0) {
            AscendC::DataCopy(zGm_[offset], zLocal, count);
        } else {
            const AscendC::DataCopyExtParams copyParams{
                1, static_cast<uint32_t>(count * sizeof(T)), 0, 0, 0};
            // Do not write the UB padding beyond the allocated output.
            AscendC::DataCopyPad(zGm_[offset], zLocal, copyParams);
        }
        outQueueZ_.FreeTensor(zLocal);
    }

    AscendC::GlobalTensor<T> xGm_, yGm_, zGm_;
    AscendC::TQue<AscendC::TPosition::VECIN, BUFFER_NUM> inQueueX_, inQueueY_;
    AscendC::TQue<AscendC::TPosition::VECOUT, BUFFER_NUM> outQueueZ_;
    uint64_t totalElements_ = 0;
};

// Tensor metadata is host memory. Pass only the flattened element count to
// the device, never the shape pointer or TensorGroupInfo references.
inline bool GetElementCount(const TensorInfo& tensor, uint64_t& count)
{
    if (tensor.numDims < 0 || (tensor.numDims > 0 && tensor.shape == nullptr)) {
        return false;
    }
    bool empty = false;
    for (int64_t dim = 0; dim < tensor.numDims; ++dim) {
        if (tensor.shape[dim] < 0) {
            return false;
        }
        empty = empty || tensor.shape[dim] == 0;
    }
    // A rank-zero tensor is one scalar; any zero dimension makes it empty.
    count = empty ? 0 : 1;
    if (empty) {
        return true;
    }
    for (int64_t dim = 0; dim < tensor.numDims; ++dim) {
        const uint64_t extent = static_cast<uint64_t>(tensor.shape[dim]);
        if (count > static_cast<uint64_t>(INT64_MAX) / extent) {
            return false;
        }
        count *= extent;
    }
    return true;
}

inline bool SameShape(const TensorInfo& lhs, const TensorInfo& rhs)
{
    if (lhs.numDims != rhs.numDims) {
        return false;
    }
    for (int64_t dim = 0; dim < lhs.numDims; ++dim) {
        if (lhs.shape[dim] != rhs.shape[dim]) {
            return false;
        }
    }
    return true;
}
} // namespace CannJudgeSub

template <typename T>
__global__ __vector__ void sub_custom(GM_ADDR x, GM_ADDR y, GM_ADDR z,
                                     uint64_t totalElements)
{
    AscendC::TPipe pipe;
    CannJudgeSub::KernelSub<T> op;
    op.Init(x, y, z, totalElements, &pipe);
    op.Process();
}

extern "C" void run_kernel(GM_ADDR x, const TensorGroupInfo& info_x, GM_ADDR y, const TensorGroupInfo& info_y, GM_ADDR z, const TensorGroupInfo& info_z, int64_t availableCoreNum, aclrtStream stream)
{
    if (info_x.numTensors != 1 || info_y.numTensors != 1 || info_z.numTensors != 1 ||
        info_x.tensors == nullptr || info_y.tensors == nullptr || info_z.tensors == nullptr) {
        return;
    }
    const TensorInfo& tx = info_x.tensors[0];
    const TensorInfo& ty = info_y.tensors[0];
    const TensorInfo& tz = info_z.tensors[0];
    uint64_t nx = 0, ny = 0, nz = 0;
    if (!CannJudgeSub::GetElementCount(tx, nx) ||
        !CannJudgeSub::GetElementCount(ty, ny) ||
        !CannJudgeSub::GetElementCount(tz, nz) ||
        !CannJudgeSub::SameShape(tx, ty) || !CannJudgeSub::SameShape(tx, tz) ||
        tx.dtype != ty.dtype || tx.dtype != tz.dtype) {
        return;
    }
    if (tx.dtype != 0 && tx.dtype != 1) {
        return;
    }
    if (nx == 0) {
        return;
    }
    const uint64_t elementBytes = tx.dtype == 0 ? sizeof(float) : sizeof(half);
    if (x == nullptr || y == nullptr || z == nullptr || availableCoreNum <= 0 ||
        nx > static_cast<uint64_t>(INT64_MAX) / elementBytes) {
        return;
    }
    const uint64_t tiles = (nx - 1) / CannJudgeSub::TILE_ELEMENTS + 1;
    uint64_t cores = static_cast<uint64_t>(availableCoreNum);
    cores = cores < tiles ? cores : tiles;
    // The runtime's block dimension is a bounded integer, not an int64 shape.
    const uint32_t blockNum = static_cast<uint32_t>(cores < 65535 ? cores : 65535);
    if (tx.dtype == 0) {
        sub_custom<float><<<blockNum, nullptr, stream>>>(x, y, z, nx);
    } else {
        sub_custom<half><<<blockNum, nullptr, stream>>>(x, y, z, nx);
    }
}
