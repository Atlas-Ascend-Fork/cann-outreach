#include <cmath>
#include "kernel_operator.h"

using namespace AscendC;

template <class T>
class KernelSub {
public:
    __aicore__ inline KernelSub() {}

    __aicore__ inline void Init(GM_ADDR x, GM_ADDR y, GM_ADDR z, uint32_t totalLength, uint32_t tileNum) {
        this->blockNum = GetBlockNum();
        this->blockIdx = GetBlockIdx();
        
        this->blockLength = totalLength / this->blockNum;
        if (this->blockIdx == this->blockNum - 1) {
            this->blockLength = totalLength - this->blockIdx * (totalLength / this->blockNum);
        }

        this->tileNum = tileNum;
        this->tileLength = this->blockLength / this->tileNum;
        
        const int32_t alignBytes = 32;
        uint32_t alignElements = alignBytes / sizeof(T);
        this->alignedTileLength = (this->tileLength + alignElements - 1) / alignElements * alignElements;

        uint32_t blockOffset = this->blockIdx * (totalLength / this->blockNum);
        xGm.SetGlobalBuffer((__gm__ T *)x + blockOffset, this->blockLength);
        yGm.SetGlobalBuffer((__gm__ T *)y + blockOffset, this->blockLength);
        zGm.SetGlobalBuffer((__gm__ T *)z + blockOffset, this->blockLength);

        pipe.InitBuffer(inQueueX, 2, this->alignedTileLength * sizeof(T));
        pipe.InitBuffer(inQueueY, 2, this->alignedTileLength * sizeof(T));
        pipe.InitBuffer(outQueueZ, 2, this->alignedTileLength * sizeof(T));

        // 【关键修复1】为 FP16 显式分配临时的 FP32 缓冲区，防止 ReinterpretCast 导致的内存越界
        if (sizeof(T) == 2) {
            pipe.InitBuffer(tmpBufferX, this->alignedTileLength * sizeof(float));
            pipe.InitBuffer(tmpBufferY, this->alignedTileLength * sizeof(float));
        }
    }

    __aicore__ inline void Process() {
        for (int32_t i = 0; i < this->tileNum; i++) {
            uint32_t offset = i * this->tileLength;
            uint32_t curLength = (i == this->tileNum - 1) ? (this->blockLength - offset) : this->tileLength;
            
            CopyIn(offset, curLength);
            Compute(curLength);
            CopyOut(offset, curLength);
        }
    }

private:
    __aicore__ inline void CopyIn(uint32_t offset, uint32_t curLength) {
        LocalTensor<T> xLocal = inQueueX.AllocTensor<T>();
        LocalTensor<T> yLocal = inQueueY.AllocTensor<T>();

        DataCopy(xLocal, xGm[offset], curLength);
        DataCopy(yLocal, yGm[offset], curLength);

        inQueueX.EnQue(xLocal);
        inQueueY.EnQue(yLocal);
    }

    __aicore__ inline void Compute(uint32_t curLength) {
        LocalTensor<T> xLocal = inQueueX.DeQue<T>();
        LocalTensor<T> yLocal = inQueueY.DeQue<T>();
        LocalTensor<T> zLocal = outQueueZ.AllocTensor<T>();

        if (sizeof(T) == 2) {  // FP16 类型
            // 使用独立分配的 TBuf，确保内存大小绝对安全
            LocalTensor<float> xFp32 = tmpBufferX.Get<float>();
            LocalTensor<float> yFp32 = tmpBufferY.Get<float>();
            
            Cast(xFp32, xLocal, RoundMode::CAST_NONE, curLength);
            Cast(yFp32, yLocal, RoundMode::CAST_NONE, curLength);
            Sub(xFp32, xFp32, yFp32, curLength);
            Cast(zLocal, xFp32, RoundMode::CAST_RINT, curLength);
        } else {  // FP32 类型
            Sub(zLocal, xLocal, yLocal, curLength);
        }

        inQueueX.FreeTensor(xLocal);
        inQueueY.FreeTensor(yLocal);
        outQueueZ.EnQue(zLocal);
    }

    __aicore__ inline void CopyOut(uint32_t offset, uint32_t curLength) {
        LocalTensor<T> zLocal = outQueueZ.DeQue<T>();
        DataCopy(zGm[offset], zLocal, curLength);
        outQueueZ.FreeTensor(zLocal);
    }

private:
    TPipe pipe;
    TQue<QuePosition::VECIN, 2> inQueueX;
    TQue<QuePosition::VECIN, 2> inQueueY;
    TQue<QuePosition::VECOUT, 2> outQueueZ;
    
    // 【关键修复1】新增 TBuf 成员
    TBuf<TPosition::VECCALC> tmpBufferX;
    TBuf<TPosition::VECCALC> tmpBufferY;

    GlobalTensor<T> xGm, yGm, zGm;
    uint32_t blockNum = 0, blockIdx = 0, blockLength = 0, tileNum = 0, tileLength = 0, alignedTileLength = 0;
};

extern "C" __global__ __aicore__ void sub_custom(
    GM_ADDR x, GM_ADDR y, GM_ADDR z, uint32_t totalLength, int32_t dtype)
{
    uint32_t tileNum = 2;
    if (dtype == 0) {
        KernelSub<float> op;
        op.Init(x, y, z, totalLength, tileNum);
        op.Process();
    } else if (dtype == 1) {
        KernelSub<half> op;
        op.Init(x, y, z, totalLength, tileNum);
        op.Process();
    }
}

extern "C" void run_kernel(
    GM_ADDR x, const TensorGroupInfo& info_x,
    GM_ADDR y, const TensorGroupInfo& info_y,
    GM_ADDR z, const TensorGroupInfo& info_z,
    int64_t availableCoreNum, aclrtStream stream)
{
    if (info_x.numTensors < 1 || info_y.numTensors < 1 || info_z.numTensors < 1) return;
    if (x == nullptr || y == nullptr || z == nullptr) return;

    const TensorInfo& tx = info_x.tensors[0];
    const TensorInfo& ty = info_y.tensors[0];
    const TensorInfo& tz = info_z.tensors[0];

    if (tx.dtype != ty.dtype || tx.dtype != tz.dtype) return;
    if (tx.dtype != 0 && tx.dtype != 1) return;

    if (tx.numDims != ty.numDims || tx.numDims != tz.numDims) return;
    
    int64_t totalLength = 1;
    for (int64_t i = 0; i < tx.numDims; ++i) {
        if (tx.shape[i] != ty.shape[i] || tx.shape[i] != tz.shape[i]) return;
        totalLength *= tx.shape[i];
    }

    if (totalLength <= 0) return;

    int32_t blockDim = static_cast<int32_t>(availableCoreNum);
    if (blockDim <= 0) blockDim = 1;
    
    // 【关键修复2】确保分配给硬件的核数能够被总长度整除，避免出现非 32 字节对齐的尾块
    while (totalLength % blockDim != 0 && blockDim > 1) {
        --blockDim;
    }
    if (totalLength < blockDim) {
        blockDim = static_cast<int32_t>(totalLength);
    }

    sub_custom<<<blockDim, nullptr, stream>>>(
        x, y, z, static_cast<uint32_t>(totalLength), tx.dtype
    );
}