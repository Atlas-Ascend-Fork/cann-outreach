#include "kernel_operator.h"


constexpr uint32_t SUB_FAST_CORE_LIMIT = 8U;

template <typename T, uint32_t BLOCK_LENGTH>
__global__ __vector__ void sub_custom_fast(
    GM_ADDR x, GM_ADDR y, GM_ADDR z)
{
    AscendC::TPipe pipe;
    AscendC::TBuf<AscendC::TPosition::VECCALC> xBuf;
    AscendC::TBuf<AscendC::TPosition::VECCALC> yBuf;
    pipe.InitBuffer(xBuf, BLOCK_LENGTH * sizeof(T));
    pipe.InitBuffer(yBuf, BLOCK_LENGTH * sizeof(T));

    const uint32_t offset = AscendC::GetBlockIdx() * BLOCK_LENGTH;

    AscendC::GlobalTensor<T> xGm;
    AscendC::GlobalTensor<T> yGm;
    AscendC::GlobalTensor<T> zGm;
    xGm.SetGlobalBuffer((__gm__ T*)x + offset, BLOCK_LENGTH);
    yGm.SetGlobalBuffer((__gm__ T*)y + offset, BLOCK_LENGTH);
    zGm.SetGlobalBuffer((__gm__ T*)z + offset, BLOCK_LENGTH);

    AscendC::LocalTensor<T> xLocal = xBuf.Get<T>();
    AscendC::LocalTensor<T> yLocal = yBuf.Get<T>();

    // 每核仅一轮搬入，两次搬运共用一对完成事件。
    AscendC::DataCopy(xLocal, xGm, BLOCK_LENGTH);
    AscendC::DataCopy(yLocal, yGm, BLOCK_LENGTH);
    const int32_t inEvent = static_cast<int32_t>(
        pipe.FetchEventID(AscendC::HardEvent::MTE2_V));
    AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(inEvent);
    AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(inEvent);

    // 在片上 xLocal 中保存结果；不改写 GM 中的输入 x。
    AscendC::Sub(xLocal, xLocal, yLocal, BLOCK_LENGTH);
    const int32_t outEvent = static_cast<int32_t>(
        pipe.FetchEventID(AscendC::HardEvent::V_MTE3));
    AscendC::SetFlag<AscendC::HardEvent::V_MTE3>(outEvent);
    AscendC::WaitFlag<AscendC::HardEvent::V_MTE3>(outEvent);

    AscendC::DataCopy(zGm, xLocal, BLOCK_LENGTH);
    // 普通核函数直调场景下，TPipe 的正常析构负责末尾流水同步。
}

template <typename T>
inline void launch_sub_fast(
    GM_ADDR x, GM_ADDR y, GM_ADDR z,
    uint32_t blockNum, aclrtStream stream)
{
    // 各实例的搬运长度、缓冲区大小与计算长度均为编译期常量。
    switch (blockNum) {
        case 64:
            sub_custom_fast<T, 256><<<64, nullptr, stream>>>(x, y, z);
            break;
        case 32:
            sub_custom_fast<T, 512><<<32, nullptr, stream>>>(x, y, z);
            break;
        case 16:
            sub_custom_fast<T, 1024><<<16, nullptr, stream>>>(x, y, z);
            break;
        case 8:
            sub_custom_fast<T, 2048><<<8, nullptr, stream>>>(x, y, z);
            break;
        case 4:
            sub_custom_fast<T, 4096><<<4, nullptr, stream>>>(x, y, z);
            break;
        case 2:
            sub_custom_fast<T, 8192><<<2, nullptr, stream>>>(x, y, z);
            break;
        default:
            sub_custom_fast<T, 16384><<<1, nullptr, stream>>>(x, y, z);
            break;
    }
}

extern "C" void run_kernel(
    GM_ADDR x, const TensorGroupInfo& info_x,
    GM_ADDR y, const TensorGroupInfo& info_y,
    GM_ADDR z, const TensorGroupInfo& info_z,
    int64_t availableCoreNum, aclrtStream stream)
{
    (void)info_y;
    (void)info_z;

    uint32_t coreCap = SUB_FAST_CORE_LIMIT;
    if (coreCap > 64U) coreCap = 64U;
    if (coreCap < 1U) coreCap = 1U;
    if (availableCoreNum > 0 &&
        availableCoreNum < static_cast<int64_t>(coreCap)) {
        coreCap = static_cast<uint32_t>(availableCoreNum);
    } else if (availableCoreNum <= 0) {
        coreCap = 1U;
    }

    // 取不超过可用核心数和配置上限的最大 2 的幂，确保均匀整除。
    uint32_t blockNum = 1U;
    while ((blockNum << 1U) <= coreCap) {
        blockNum <<= 1U;
    }

    const int32_t dtype = info_x.tensors[0].dtype;
    if (dtype == 0) {
        launch_sub_fast<float>(x, y, z, blockNum, stream);
    } else if (dtype == 1) {
        launch_sub_fast<half>(x, y, z, blockNum, stream);
    }
}

