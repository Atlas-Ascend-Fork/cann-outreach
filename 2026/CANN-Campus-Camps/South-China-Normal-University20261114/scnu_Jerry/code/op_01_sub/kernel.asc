#include "kernel_operator.h"

namespace {
constexpr uint32_t kRowCount = 8;
constexpr uint32_t kRowLength = 2048;

template <typename T>
__aicore__ inline void ComputeSub(GM_ADDR x, GM_ADDR y, GM_ADDR z, uint32_t blockNum)
{
    AscendC::GlobalTensor<T> xGm;
    AscendC::GlobalTensor<T> yGm;
    AscendC::GlobalTensor<T> zGm;
    xGm.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(x), kRowCount * kRowLength);
    yGm.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(y), kRowCount * kRowLength);
    zGm.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(z), kRowCount * kRowLength);

    AscendC::TPipe pipe;
    AscendC::TQue<AscendC::QuePosition::VECIN, 1> xQueue;
    AscendC::TQue<AscendC::QuePosition::VECIN, 1> yQueue;
    AscendC::TQue<AscendC::QuePosition::VECOUT, 1> zQueue;
    pipe.InitBuffer(xQueue, 1, kRowLength * sizeof(T));
    pipe.InitBuffer(yQueue, 1, kRowLength * sizeof(T));
    pipe.InitBuffer(zQueue, 1, kRowLength * sizeof(T));

    for (uint32_t row = AscendC::GetBlockIdx(); row < kRowCount; row += blockNum) {
        const uint32_t offset = row * kRowLength;
        auto xLocal = xQueue.AllocTensor<T>();
        auto yLocal = yQueue.AllocTensor<T>();
        AscendC::DataCopy(xLocal, xGm[offset], kRowLength);
        AscendC::DataCopy(yLocal, yGm[offset], kRowLength);
        xQueue.EnQue(xLocal);
        yQueue.EnQue(yLocal);

        xLocal = xQueue.DeQue<T>();
        yLocal = yQueue.DeQue<T>();
        auto zLocal = zQueue.AllocTensor<T>();
        AscendC::Sub(zLocal, xLocal, yLocal, kRowLength);
        zQueue.EnQue(zLocal);
        xQueue.FreeTensor(xLocal);
        yQueue.FreeTensor(yLocal);

        zLocal = zQueue.DeQue<T>();
        AscendC::DataCopy(zGm[offset], zLocal, kRowLength);
        zQueue.FreeTensor(zLocal);
    }
}
}  // namespace

__global__ __vector__ void sub_custom_fp32(GM_ADDR x, GM_ADDR y, GM_ADDR z, uint32_t blockNum)
{
    ComputeSub<float>(x, y, z, blockNum);
}

__global__ __vector__ void sub_custom_fp16(GM_ADDR x, GM_ADDR y, GM_ADDR z, uint32_t blockNum)
{
    ComputeSub<half>(x, y, z, blockNum);
}

extern "C" void run_kernel(GM_ADDR x, const TensorGroupInfo& info_x,
                           GM_ADDR y, const TensorGroupInfo&,
                           GM_ADDR z, const TensorGroupInfo&,
                           int64_t availableCoreNum, aclrtStream stream)
{
    if (availableCoreNum <= 0) {
        return;
    }
    const uint32_t blockNum = availableCoreNum < kRowCount
        ? static_cast<uint32_t>(availableCoreNum) : kRowCount;

    switch (info_x.tensors[0].dtype) {
        case 0:
            sub_custom_fp32<<<blockNum, nullptr, stream>>>(x, y, z, blockNum);
            break;
        case 1:
            sub_custom_fp16<<<blockNum, nullptr, stream>>>(x, y, z, blockNum);
            break;
    }
}
