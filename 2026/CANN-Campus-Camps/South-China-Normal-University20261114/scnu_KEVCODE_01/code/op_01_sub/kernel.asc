#include <cstdint>
#include "kernel_operator.h"

template <typename T>
__global__ __vector__ void lesson1_sub_fast(GM_ADDR x, GM_ADDR y, GM_ADDR z,
                                           uint32_t count)
{
    const uint32_t offset = AscendC::GetBlockIdx() * count;
    AscendC::GlobalTensor<T> xGm, yGm, zGm;
    xGm.SetGlobalBuffer((__gm__ T*)x + offset, count);
    yGm.SetGlobalBuffer((__gm__ T*)y + offset, count);
    zGm.SetGlobalBuffer((__gm__ T*)z + offset, count);

    AscendC::TPipe pipe;
    AscendC::TBuf<AscendC::TPosition::VECCALC> storage;
    pipe.InitBuffer(storage, 3 * count * sizeof(T));
    AscendC::LocalTensor<T> xLocal = storage.Get<T>();
    AscendC::LocalTensor<T> yLocal = xLocal[count];
    AscendC::LocalTensor<T> zLocal = xLocal[2 * count];

    AscendC::DataCopy(xLocal, xGm, count);
    AscendC::DataCopy(yLocal, yGm, count);
    const int32_t loadEvent = static_cast<int32_t>(
        pipe.FetchEventID(AscendC::HardEvent::MTE2_V));
    AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(loadEvent);
    AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(loadEvent);

    AscendC::Sub(zLocal, xLocal, yLocal, count);
    const int32_t storeEvent = static_cast<int32_t>(
        pipe.FetchEventID(AscendC::HardEvent::V_MTE3));
    AscendC::SetFlag<AscendC::HardEvent::V_MTE3>(storeEvent);
    AscendC::WaitFlag<AscendC::HardEvent::V_MTE3>(storeEvent);
    AscendC::DataCopy(zGm, zLocal, count);
}

extern "C" void run_kernel(GM_ADDR x, const TensorGroupInfo& info_x,
                           GM_ADDR y, const TensorGroupInfo& info_y,
                           GM_ADDR z, const TensorGroupInfo& info_z,
                           int64_t availableCoreNum, aclrtStream stream)
{
    (void)info_y;
    (void)info_z;
    if (availableCoreNum <= 0) {
        return;
    }
    uint32_t blockNum = 8;
    while (static_cast<int64_t>(blockNum) > availableCoreNum) {
        blockNum /= 2;
    }
    const uint32_t count = 16384 / blockNum;
    if (info_x.tensors[0].dtype == 0) {
        lesson1_sub_fast<float><<<blockNum, nullptr, stream>>>(x, y, z, count);
    } else if (info_x.tensors[0].dtype == 1) {
        lesson1_sub_fast<half><<<blockNum, nullptr, stream>>>(x, y, z, count);
    }
}