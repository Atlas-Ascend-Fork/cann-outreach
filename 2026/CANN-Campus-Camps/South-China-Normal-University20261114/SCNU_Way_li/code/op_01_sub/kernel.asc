#include <cmath>
#include "kernel_operator.h"

// 固定输入形状：(8, 2048)
constexpr uint32_t SUB_TOTAL_LENGTH = 8 * 2048;
constexpr uint32_t SUB_TILE_LENGTH = 2048;
constexpr uint32_t SUB_TILE_COUNT =
    SUB_TOTAL_LENGTH / SUB_TILE_LENGTH;

template <typename T>
class KernelSub {
public:
    __aicore__ inline KernelSub() {}

    __aicore__ inline void Init(
        GM_ADDR x,
        GM_ADDR y,
        GM_ADDR z,
        AscendC::TPipe* pipe)
    {
        xGm.SetGlobalBuffer(
            (__gm__ T*)x, SUB_TOTAL_LENGTH);
        yGm.SetGlobalBuffer(
            (__gm__ T*)y, SUB_TOTAL_LENGTH);
        zGm.SetGlobalBuffer(
            (__gm__ T*)z, SUB_TOTAL_LENGTH);

        // 每个队列分配一块 UB 缓冲区。
        pipe->InitBuffer(
            inQueueX, 1, SUB_TILE_LENGTH * sizeof(T));
        pipe->InitBuffer(
            inQueueY, 1, SUB_TILE_LENGTH * sizeof(T));
        pipe->InitBuffer(
            outQueueZ, 1, SUB_TILE_LENGTH * sizeof(T));
    }

    __aicore__ inline void Process()
    {
        const uint32_t blockIdx = AscendC::GetBlockIdx();
        const uint32_t blockNum = AscendC::GetBlockNum();

        // 各核心轮流处理不同的数据块。
        // 可用核心少于 8 时，一个核心可以处理多个块。
        for (uint32_t tile = blockIdx;
             tile < SUB_TILE_COUNT;
             tile += blockNum) {
            const uint32_t offset = tile * SUB_TILE_LENGTH;

            CopyIn(offset);
            Compute();
            CopyOut(offset);
        }
    }

private:
    __aicore__ inline void CopyIn(uint32_t offset)
    {
        AscendC::LocalTensor<T> xLocal =
            inQueueX.template AllocTensor<T>();
        AscendC::LocalTensor<T> yLocal =
            inQueueY.template AllocTensor<T>();

        AscendC::DataCopy(
            xLocal, xGm[offset], SUB_TILE_LENGTH);
        AscendC::DataCopy(
            yLocal, yGm[offset], SUB_TILE_LENGTH);

        inQueueX.template EnQue<T>(xLocal);
        inQueueY.template EnQue<T>(yLocal);
    }

    __aicore__ inline void Compute()
    {
        AscendC::LocalTensor<T> xLocal =
            inQueueX.template DeQue<T>();
        AscendC::LocalTensor<T> yLocal =
            inQueueY.template DeQue<T>();
        AscendC::LocalTensor<T> zLocal =
            outQueueZ.template AllocTensor<T>();

        // 核心计算：z = x - y
        AscendC::Sub(
            zLocal, xLocal, yLocal, SUB_TILE_LENGTH);

        outQueueZ.template EnQue<T>(zLocal);

        inQueueX.FreeTensor(xLocal);
        inQueueY.FreeTensor(yLocal);
    }

    __aicore__ inline void CopyOut(uint32_t offset)
    {
        AscendC::LocalTensor<T> zLocal =
            outQueueZ.template DeQue<T>();

        AscendC::DataCopy(
            zGm[offset], zLocal, SUB_TILE_LENGTH);

        outQueueZ.FreeTensor(zLocal);
    }

private:
    AscendC::GlobalTensor<T> xGm;
    AscendC::GlobalTensor<T> yGm;
    AscendC::GlobalTensor<T> zGm;

    AscendC::TQue<AscendC::QuePosition::VECIN, 1> inQueueX;
    AscendC::TQue<AscendC::QuePosition::VECIN, 1> inQueueY;
    AscendC::TQue<AscendC::QuePosition::VECOUT, 1> outQueueZ;
};

template <typename T>
__global__ __vector__ void sub_custom(
    GM_ADDR x,
    GM_ADDR y,
    GM_ADDR z)
{
    AscendC::TPipe pipe;
    KernelSub<T> op;

    op.Init(x, y, z, &pipe);
    op.Process();
}

extern "C" void run_kernel(
    GM_ADDR x,
    const TensorGroupInfo& info_x,
    GM_ADDR y,
    const TensorGroupInfo& info_y,
    GM_ADDR z,
    const TensorGroupInfo& info_z,
    int64_t availableCoreNum,
    aclrtStream stream)
{
    // 最多使用 8 个核心，且不超过平台提供的可用核心数。
    uint32_t blockNum = 1;
    if (availableCoreNum > 0) {
        blockNum = availableCoreNum < 8
            ? static_cast<uint32_t>(availableCoreNum)
            : 8U;
    }

    // 平台保证 x、y、z 的形状及数据类型满足题目约束。
    // dtype：0 = float32，1 = float16。
    if (info_x.tensors[0].dtype == 0) {
        sub_custom<float><<<blockNum, nullptr, stream>>>(
            x, y, z);
    } else if (info_x.tensors[0].dtype == 1) {
        sub_custom<half><<<blockNum, nullptr, stream>>>(
            x, y, z);
    }
}