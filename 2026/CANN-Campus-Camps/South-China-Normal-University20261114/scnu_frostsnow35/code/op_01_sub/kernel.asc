#include <cmath>
#include "kernel_operator.h"

struct SubCustomTilingData {
    uint32_t totalLength; // 总元素数
    uint32_t tileLength;  // 单块元素数，已按 UB 预算与 32B 对齐取整
};

// 三个队列各一份 buffer。本题单块即可搬完，多缓冲只会增加管理开销
constexpr uint32_t BUFFER_NUM = 1;
constexpr uint32_t QUEUE_DEPTH = 1;
// 3 份 buffer 共用 96KB 预算，其余 UB 留给系统
constexpr uint32_t UB_BUDGET_BYTES = 96 * 1024;
constexpr uint32_t DEFAULT_BLOCK_DIM = 8;

template <typename T>
class KernelSub {
public:
    __aicore__ inline KernelSub() {}

    __aicore__ inline void Init(GM_ADDR x, GM_ADDR y, GM_ADDR z, const SubCustomTilingData& tiling)
    {
        // host 侧已保证 totalLength 能被核数整除，且每核长度 32B 对齐
        this->blockLength = tiling.totalLength / AscendC::GetBlockNum();
        this->blockOffset = this->blockLength * AscendC::GetBlockIdx();
        this->tileLength = tiling.tileLength;
        if (this->tileLength > this->blockLength || this->tileLength == 0) {
            this->tileLength = this->blockLength;
        }

        xGm.SetGlobalBuffer((__gm__ T *)x + this->blockOffset, this->blockLength);
        yGm.SetGlobalBuffer((__gm__ T *)y + this->blockOffset, this->blockLength);
        zGm.SetGlobalBuffer((__gm__ T *)z + this->blockOffset, this->blockLength);

        pipe.InitBuffer(inQueueX, BUFFER_NUM, this->tileLength * sizeof(T));
        pipe.InitBuffer(inQueueY, BUFFER_NUM, this->tileLength * sizeof(T));
        pipe.InitBuffer(outQueueZ, BUFFER_NUM, this->tileLength * sizeof(T));
    }

    __aicore__ inline void Process()
    {
        // 按 tileLength 分块，末块用实际剩余长度；本题 shape 下循环只跑 1 次
        uint32_t offset = 0;
        uint32_t remain = this->blockLength;
        while (remain > 0) {
            uint32_t cur = (remain > this->tileLength) ? this->tileLength : remain;
            CopyIn(offset, cur);
            Compute(cur);
            CopyOut(offset, cur);
            offset += cur;
            remain -= cur;
        }
    }

private:
    __aicore__ inline void CopyIn(uint32_t offset, uint32_t count)
    {
        AscendC::LocalTensor<T> xLocal = inQueueX.AllocTensor<T>();
        AscendC::LocalTensor<T> yLocal = inQueueY.AllocTensor<T>();
        AscendC::DataCopy(xLocal, xGm[offset], count);
        AscendC::DataCopy(yLocal, yGm[offset], count);
        inQueueX.EnQue(xLocal);
        inQueueY.EnQue(yLocal);
    }

    __aicore__ inline void Compute(uint32_t count)
    {
        AscendC::LocalTensor<T> xLocal = inQueueX.DeQue<T>();
        AscendC::LocalTensor<T> yLocal = inQueueY.DeQue<T>();
        AscendC::LocalTensor<T> zLocal = outQueueZ.AllocTensor<T>();
        AscendC::Sub(zLocal, xLocal, yLocal, count);
        outQueueZ.EnQue<T>(zLocal);
        inQueueX.FreeTensor(xLocal);
        inQueueY.FreeTensor(yLocal);
    }

    __aicore__ inline void CopyOut(uint32_t offset, uint32_t count)
    {
        AscendC::LocalTensor<T> zLocal = outQueueZ.DeQue<T>();
        AscendC::DataCopy(zGm[offset], zLocal, count);
        outQueueZ.FreeTensor(zLocal);
    }

private:
    AscendC::TPipe pipe;
    AscendC::TQue<AscendC::QuePosition::VECIN, QUEUE_DEPTH> inQueueX, inQueueY;
    AscendC::TQue<AscendC::QuePosition::VECOUT, QUEUE_DEPTH> outQueueZ;
    AscendC::GlobalTensor<T> xGm, yGm, zGm;

    uint32_t blockLength;
    uint32_t blockOffset;
    uint32_t tileLength;
};

template <typename T>
__global__ __vector__ void sub_custom(GM_ADDR x, GM_ADDR y, GM_ADDR z, SubCustomTilingData tiling)
{
    KernelSub<T> op;
    op.Init(x, y, z, tiling);
    op.Process();
}

extern "C" void run_kernel(GM_ADDR x, const TensorGroupInfo& info_x, GM_ADDR y, const TensorGroupInfo& info_y, GM_ADDR z, const TensorGroupInfo& info_z, int64_t availableCoreNum, aclrtStream stream)
{
    const TensorInfo& t0 = info_x.tensors[0];
    int64_t totalLength = 1;
    for (int64_t i = 0; i < t0.numDims; i++) {
        totalLength *= t0.shape[i];
    }
    int32_t dtype = t0.dtype;

    // fp16 = 2B, fp32 = 4B；DataCopy 要求 32B 对齐
    uint32_t elemSize = (dtype == 1) ? 2u : 4u;
    uint32_t alignElems = 32u / elemSize;
    // 单块上限：3 份 buffer 不超 UB 预算，再向下对齐到 32B
    uint32_t maxTile = UB_BUDGET_BYTES / (3u * elemSize);
    maxTile = (maxTile / alignElems) * alignElems;

    // 优先 8 核；不能整除或每核长度未对齐时降核数，保证每个 GM 起始地址 32B 对齐
    uint32_t blockDim = DEFAULT_BLOCK_DIM;
    while (blockDim > 1 &&
           (totalLength % blockDim != 0 || (totalLength / blockDim) % alignElems != 0)) {
        blockDim--;
    }

    uint32_t perCore = (uint32_t)(totalLength / blockDim);
    uint32_t tileLength = (perCore < maxTile) ? perCore : maxTile;

    SubCustomTilingData tiling = {(uint32_t)totalLength, tileLength};
    if (dtype == 1) {
        sub_custom<half><<<blockDim, nullptr, stream>>>(x, y, z, tiling);
    } else {
        sub_custom<float><<<blockDim, nullptr, stream>>>(x, y, z, tiling);
    }
}
