// #include <cmath>
#include <cstdint>
#include "kernel_operator.h"

// ---------------------------------------------------------------------------
// Tiling 参数：由 host 侧 run_kernel 计算后按值传给核函数
// ---------------------------------------------------------------------------
struct SubCustomTilingData {
    uint32_t totalLength;   // 待处理数据总长度（单位：元素个数）
    uint32_t tileNum;       // 期望单核内分块数，例如 8
    uint32_t blockLength;   // 每个核的基础数据长度：totalLength / blockDim
    uint32_t tailLength;    // 余数：totalLength % blockDim，前 tailLength 个核各多处理 1 个元素
};

constexpr uint32_t BUFFER_NUM = 2;       // double buffer
constexpr uint32_t QUEUE_DEPTH = 1;
constexpr uint32_t ALIGN_BYTES = 32;     // DataCopy 对齐要求：32 字节

// ---------------------------------------------------------------------------
// KernelSub：z = x - y，每核分块循环计算（模板化，支持 float / half 等类型）
// ---------------------------------------------------------------------------
template <typename T>
class KernelSub {
public:
    __aicore__ inline KernelSub() {}

    __aicore__ inline void Init(AscendC::TPipe* pipePtr,
                                GM_ADDR x, GM_ADDR y, GM_ADDR z,
                                const SubCustomTilingData& tiling)
    {
        this->pipe = pipePtr;

        // 多核余数分摊：前 tailLength 个核各多处理 1 个元素
        uint32_t blockIdx = AscendC::GetBlockIdx();
        uint32_t extra = (blockIdx < tiling.tailLength) ? 1u : 0u;
        uint32_t offset = blockIdx * tiling.blockLength +
                          ((blockIdx < tiling.tailLength) ? blockIdx : tiling.tailLength);

        this->currentLength = tiling.blockLength + extra;

        // 设置每个核的 Global Memory 起始地址和长度
        xGm.SetGlobalBuffer((__gm__ T *)x + offset, this->currentLength);
        yGm.SetGlobalBuffer((__gm__ T *)y + offset, this->currentLength);
        zGm.SetGlobalBuffer((__gm__ T *)z + offset, this->currentLength);

        // 计算 32B 对齐的元素个数
        uint32_t alignElems = ALIGN_BYTES / sizeof(T);
        if (alignElems == 0) {
            alignElems = 1;
        }

        // 动态计算每个 tile 的长度，并向下对齐到 32B
        uint32_t desiredTileNum = (tiling.tileNum == 0) ? 1u : tiling.tileNum;
        uint32_t rawTileLength = this->currentLength / desiredTileNum;
        this->tileLength = (rawTileLength / alignElems) * alignElems;

        // currentLength 很小时，tileLength 可能为 0；此时分配一个最小对齐块，
        // Process 中 mainLoop 为 0，全部走标量尾块处理。
        if (this->tileLength == 0) {
            this->tileLength = alignElems;
        }

        // 为队列分配 UB 内存
        this->pipe->InitBuffer(inQueueX, BUFFER_NUM, this->tileLength * sizeof(T));
        this->pipe->InitBuffer(inQueueY, BUFFER_NUM, this->tileLength * sizeof(T));
        this->pipe->InitBuffer(outQueueZ, BUFFER_NUM, this->tileLength * sizeof(T));
    }

    __aicore__ inline void Process()
    {
        // Vector 主循环次数：不再乘以 BUFFER_NUM，Double Buffer 由 TQue 深度自动生效
        uint32_t mainLoop = this->currentLength / this->tileLength;

        for (uint32_t i = 0; i < mainLoop; i++) {
            CopyIn(i);
            Compute(i);
            CopyOut(i);
        }

        // 非 32B 对齐尾块：用标量方式兜底，避免 DataCopy 非对齐访问
        uint32_t processed = mainLoop * this->tileLength;
        for (uint32_t i = processed; i < this->currentLength; i++) {
            T xv = xGm.GetValue(i);
            T yv = yGm.GetValue(i);
            zGm.SetValue(i, static_cast<T>(static_cast<float>(xv) - static_cast<float>(yv)));
        }
    }

private:
    __aicore__ inline void CopyIn(uint32_t progress)
    {
        AscendC::LocalTensor<T> xLocal = inQueueX.AllocTensor<T>();
        AscendC::LocalTensor<T> yLocal = inQueueY.AllocTensor<T>();

        AscendC::DataCopy(xLocal, xGm[progress * this->tileLength], this->tileLength);
        AscendC::DataCopy(yLocal, yGm[progress * this->tileLength], this->tileLength);

        inQueueX.EnQue(xLocal);
        inQueueY.EnQue(yLocal);
    }

    __aicore__ inline void Compute(uint32_t progress)
    {
        (void)progress;

        AscendC::LocalTensor<T> xLocal = inQueueX.DeQue<T>();
        AscendC::LocalTensor<T> yLocal = inQueueY.DeQue<T>();
        AscendC::LocalTensor<T> zLocal = outQueueZ.AllocTensor<T>();

        AscendC::Sub(zLocal, xLocal, yLocal, this->tileLength);

        outQueueZ.EnQue<T>(zLocal);

        inQueueX.FreeTensor(xLocal);
        inQueueY.FreeTensor(yLocal);
    }

    __aicore__ inline void CopyOut(uint32_t progress)
    {
        AscendC::LocalTensor<T> zLocal = outQueueZ.DeQue<T>();

        AscendC::DataCopy(zGm[progress * this->tileLength], zLocal, this->tileLength);

        outQueueZ.FreeTensor(zLocal);
    }

private:
    AscendC::TPipe* pipe = nullptr;  // TPipe 由核函数入口创建并传入

    AscendC::TQue<AscendC::QuePosition::VECIN, QUEUE_DEPTH> inQueueX;
    AscendC::TQue<AscendC::QuePosition::VECIN, QUEUE_DEPTH> inQueueY;
    AscendC::TQue<AscendC::QuePosition::VECOUT, QUEUE_DEPTH> outQueueZ;

    AscendC::GlobalTensor<T> xGm;
    AscendC::GlobalTensor<T> yGm;
    AscendC::GlobalTensor<T> zGm;

    uint32_t currentLength = 0;  // 当前核实际处理的数据长度
    uint32_t tileLength = 0;     // 每个 tile 的长度，保证 32B 对齐
};

// ---------------------------------------------------------------------------
// 核函数入口：实例化 KernelSub<T> 并执行（T 由 run_kernel 按输入 dtype 选择）
// ---------------------------------------------------------------------------
template <typename T>
__global__ __vector__ void sub_custom(GM_ADDR x, GM_ADDR y, GM_ADDR z,
                                      SubCustomTilingData tiling)
{
    AscendC::TPipe pipe;
    KernelSub<T> op;
    op.Init(&pipe, x, y, z, tiling);
    op.Process();
}

// ---------------------------------------------------------------------------
// host 侧启动函数：从 TensorGroupInfo 推导 tiling 并启动核函数
// ---------------------------------------------------------------------------
extern "C" void run_kernel(GM_ADDR x, const TensorGroupInfo& info_x,
                           GM_ADDR y, const TensorGroupInfo& info_y,
                           GM_ADDR z, const TensorGroupInfo& info_z,
                           int64_t availableCoreNum, aclrtStream stream)
{
    constexpr uint32_t MAX_BLOCK_DIM = 8;

    // 1. 取总元素数（x/y/z 形状一致）
    const TensorInfo& t0 = info_x.tensors[0];
    int64_t totalLength = 1;
    for (int64_t i = 0; i < t0.numDims; i++) {
        totalLength *= t0.shape[i];
    }

    // 2. 根据可用核数确定 blockDim
    uint32_t blockDim = MAX_BLOCK_DIM;
    if (availableCoreNum > 0 &&
        availableCoreNum < static_cast<int64_t>(MAX_BLOCK_DIM)) {
        blockDim = static_cast<uint32_t>(availableCoreNum);
    }
    if (blockDim == 0) {
        blockDim = 1;
    }

    // 3. 多核切分：基础长度 + 余数分摊
    uint32_t total = static_cast<uint32_t>(totalLength);
    uint32_t blockLength = total / blockDim;
    uint32_t tailLength = total % blockDim;

    // 4. 期望单核内分块数，保留原设计值 8
    uint32_t tileNum = 8;

    SubCustomTilingData tiling = {
        total,
        tileNum,
        blockLength,
        tailLength
    };

    // 5. 按输入 dtype 选择核函数实例
    int32_t dtype = t0.dtype;
    if (dtype == 1) {
        // fp16：half 实例
        sub_custom<half><<<blockDim, nullptr, stream>>>(x, y, z, tiling);
    } else {
        // fp32 及其他类型默认走 float 实例
        sub_custom<float><<<blockDim, nullptr, stream>>>(x, y, z, tiling);
    }
}