#include "kernel_operator.h"

template <typename T>
__global__ __vector__ void sub_custom(
    GM_ADDR x, GM_ADDR y, GM_ADDR z, uint32_t length)
{
    const uint32_t offset = AscendC::GetBlockIdx() * length;

    AscendC::GlobalTensor<T> gx, gy, gz;
    gx.SetGlobalBuffer((__gm__ T*)x + offset, length);
    gy.SetGlobalBuffer((__gm__ T*)y + offset, length);
    gz.SetGlobalBuffer((__gm__ T*)z + offset, length);

    AscendC::TPipe pipe;
    AscendC::TBuf<AscendC::TPosition::VECCALC> buffer;
    pipe.InitBuffer(buffer, 2 * length * sizeof(T));

    AscendC::LocalTensor<T> lx = buffer.Get<T>();
    AscendC::LocalTensor<T> ly = lx[length];

    AscendC::DataCopy(lx, gx, length);
    AscendC::DataCopy(ly, gy, length);

    AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);
    AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);

    AscendC::Sub(lx, lx, ly, length);

    AscendC::SetFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
    AscendC::WaitFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);

    AscendC::DataCopy(gz, lx, length);

    AscendC::SetFlag<AscendC::HardEvent::MTE3_S>(EVENT_ID0);
    AscendC::WaitFlag<AscendC::HardEvent::MTE3_S>(EVENT_ID0);
}

extern "C" void run_kernel(
    GM_ADDR x, const TensorGroupInfo& info_x,
    GM_ADDR y, const TensorGroupInfo& info_y,
    GM_ADDR z, const TensorGroupInfo& info_z,
    int64_t availableCoreNum, aclrtStream stream)
{
    if (availableCoreNum <= 0) return;

    uint32_t cores = 1;
    while (cores < 8 && cores * 2 <= availableCoreNum)
        cores *= 2;

    const uint32_t length = 16384 / cores;

    if (info_x.tensors[0].dtype == 0) {
        sub_custom<float><<<cores, nullptr, stream>>>(
            x, y, z, length);
    } else if (info_x.tensors[0].dtype == 1) {
        sub_custom<half><<<cores, nullptr, stream>>>(
            x, y, z, length);
    }
}