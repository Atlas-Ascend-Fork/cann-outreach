#include <cmath>
#include "kernel_operator.h"
/*
 * Sub Kernel — Ascend C Direct Invocation（优化版：满配多核 + 单次搬运）
 * This file is #included — do NOT add main(), #pragma once, or include guards.
 *
 * TensorGroupInfo / TensorInfo (predefined):
 *   struct TensorInfo { const int64_t* shape; int64_t numDims; int32_t dtype; };
 *   struct TensorGroupInfo { const TensorInfo* tensors; int64_t numTensors; };
 *   dtype: 0=fp32 1=fp16 2=bf16 3=int8 4=int16 5=int32 6=int64 7=uint8 8=uint16 9=uint32 10=uint64 11=bool
 *   Usage: info_x.tensors[0].shape[0]  // first dim of first tensor in input x
 *
 * 优化点（相对首版）：
 *   1) blockDim 用满 availableCoreNum（首版固定 8 核，几十个 vector core 多数闲置）
 *   2) 按 256B（= 一个 vector repeat：fp32 64 元素 / fp16 128 元素）为单位均分，
 *      每核起址/length 天然满足 DataCopy 的 32B 对齐，且 calCount 恒为 repeat 整数倍，
 *      Sub 不会走 mask 尾块
 *   3) 每核只搬一次（tileLength = 核内全部数据），循环次数从 16 次降到 1 次，
 *      消除小粒度 DMA 与队列同步开销
 */

// ---------------------------------------------------------------------------
// Tiling 参数：由 host 侧 run_kernel 计算后按值传给核函数
// ---------------------------------------------------------------------------
struct SubCustomTilingData {
    uint32_t totalLength; // 待处理数据总长度（元素个数），例如 8 * 2048 = 16384
};

constexpr uint32_t BUFFER_NUM = 2;             // 每队列 buffer 块数（QUEUE_DEPTH 为 1）
constexpr uint32_t QUEUE_DEPTH = 1;
constexpr uint32_t ALIGN_BYTES = 256;          // 切分粒度 = 一个 vector repeat（fp32 64 / fp16 128 元素）
constexpr uint32_t MAX_TILE_BYTES = 8192;      // 单次搬运上限（防止大 shape 时 UB 溢出）
constexpr uint32_t kBlockDimOverride = 0;      // 0 = 用满 availableCoreNum；填 8 可回退 8 核做对比

// ---------------------------------------------------------------------------
// KernelSub：z = x - y
// ---------------------------------------------------------------------------
template <typename T>
class KernelSub {
public:
    __aicore__ inline KernelSub() {}

    __aicore__ inline void Init(GM_ADDR x, GM_ADDR y, GM_ADDR z, const SubCustomTilingData& tiling)
    {
        // 一个 ALIGN_BYTES 块包含的元素数：fp32 = 64，fp16 = 128（正好一次 repeat）
        constexpr uint32_t ELEM_PER_ALIGN = ALIGN_BYTES / sizeof(T);

        uint32_t blockNum = (uint32_t)AscendC::GetBlockNum();
        uint32_t blockIdx = (uint32_t)AscendC::GetBlockIdx();

        // 总块数按 ALIGN_BYTES 折算，再把块均分到各核（余数分给前 extraUnits 个核）
        uint32_t totalUnits = tiling.totalLength * sizeof(T) / ALIGN_BYTES;
        uint32_t baseUnits  = totalUnits / blockNum;
        uint32_t extraUnits = totalUnits % blockNum;

        uint32_t startUnit = blockIdx * baseUnits + (blockIdx < extraUnits ? blockIdx : extraUnits);
        uint32_t units     = baseUnits + (blockIdx < extraUnits ? 1 : 0);

        this->startElem   = startUnit * ELEM_PER_ALIGN;
        this->blockLength = units * ELEM_PER_ALIGN;

        // 本核无数据时给一个最小长度，避免 SetGlobalBuffer(ptr, 0)
        uint32_t bufLength = (this->blockLength > 0) ? this->blockLength : ELEM_PER_ALIGN;
        xGm.SetGlobalBuffer((__gm__ T *)x + this->startElem, bufLength);
        yGm.SetGlobalBuffer((__gm__ T *)y + this->startElem, bufLength);
        zGm.SetGlobalBuffer((__gm__ T *)z + this->startElem, bufLength);

        // 每核尽量一次搬完；仅当单核数据超过 MAX_TILE_BYTES 时才分块循环
        uint32_t maxChunkElem = (baseUnits + 1) * ELEM_PER_ALIGN;
        uint32_t capElem = MAX_TILE_BYTES / sizeof(T);
        this->tileLength = (maxChunkElem < capElem) ? maxChunkElem : capElem;
        if (this->tileLength < ELEM_PER_ALIGN) {
            this->tileLength = ELEM_PER_ALIGN;
        }

        pipe.InitBuffer(inQueueX, BUFFER_NUM, this->tileLength * sizeof(T));
        pipe.InitBuffer(inQueueY, BUFFER_NUM, this->tileLength * sizeof(T));
        pipe.InitBuffer(outQueueZ, BUFFER_NUM, this->tileLength * sizeof(T));
    }

    __aicore__ inline void Process()
    {
        if (this->blockLength == 0) {
            return; // 核数多于数据块，本核无活
        }
        uint32_t loopCount = (this->blockLength + this->tileLength - 1) / this->tileLength;
        for (uint32_t i = 0; i < loopCount; i++) {
            uint32_t curLen = this->blockLength - i * this->tileLength;
            if (curLen > this->tileLength) {
                curLen = this->tileLength;
            }
            CopyIn(i, curLen);
            Compute(curLen);
            CopyOut(i, curLen);
        }
    }

private:
    __aicore__ inline void CopyIn(uint32_t progress, uint32_t calCount)
    {
        AscendC::LocalTensor<T> xLocal = inQueueX.AllocTensor<T>();
        AscendC::LocalTensor<T> yLocal = inQueueY.AllocTensor<T>();

        AscendC::DataCopy(xLocal, xGm[progress * this->tileLength], calCount);
        AscendC::DataCopy(yLocal, yGm[progress * this->tileLength], calCount);

        inQueueX.EnQue(xLocal);
        inQueueY.EnQue(yLocal);
    }

    __aicore__ inline void Compute(uint32_t calCount)
    {
        AscendC::LocalTensor<T> xLocal = inQueueX.DeQue<T>();
        AscendC::LocalTensor<T> yLocal = inQueueY.DeQue<T>();
        AscendC::LocalTensor<T> zLocal = outQueueZ.AllocTensor<T>();

        // 矢量减法：z = x - y（dst = src0 - src1，顺序不可颠倒）
        AscendC::Sub(zLocal, xLocal, yLocal, calCount);

        outQueueZ.EnQue<T>(zLocal);

        inQueueX.FreeTensor(xLocal);
        inQueueY.FreeTensor(yLocal);
    }

    __aicore__ inline void CopyOut(uint32_t progress, uint32_t calCount)
    {
        AscendC::LocalTensor<T> zLocal = outQueueZ.DeQue<T>();
        AscendC::DataCopy(zGm[progress * this->tileLength], zLocal, calCount);
        outQueueZ.FreeTensor(zLocal);
    }

private:
    AscendC::TPipe pipe;
    AscendC::TQue<AscendC::QuePosition::VECIN, QUEUE_DEPTH> inQueueX, inQueueY;
    AscendC::TQue<AscendC::QuePosition::VECOUT, QUEUE_DEPTH> outQueueZ;
    AscendC::GlobalTensor<T> xGm, yGm, zGm;
    uint32_t startElem;   // 本核在整块数据中的起始元素偏移
    uint32_t blockLength; // 本核处理的元素数（ALIGN_BYTES 整数倍）
    uint32_t tileLength;  // 单次搬运元素数
};

// ---------------------------------------------------------------------------
// 核函数入口
// ---------------------------------------------------------------------------
template <typename T>
__global__ __vector__ void sub_custom(GM_ADDR x, GM_ADDR y, GM_ADDR z, SubCustomTilingData tiling)
{
    KernelSub<T> op;
    op.Init(x, y, z, tiling);
    op.Process();
}

// ---------------------------------------------------------------------------
// host 侧启动函数
// ---------------------------------------------------------------------------
extern "C" void run_kernel(GM_ADDR x, const TensorGroupInfo& info_x, GM_ADDR y, const TensorGroupInfo& info_y, GM_ADDR z, const TensorGroupInfo& info_z, int64_t availableCoreNum, aclrtStream stream)
{
    // 1. 总元素数（x/y/z 形状一致）
    const TensorInfo& t0 = info_x.tensors[0];
    int64_t totalLength = 1;
    for (int64_t i = 0; i < t0.numDims; i++) {
        totalLength *= t0.shape[i];
    }

    // 2. 启动核数：默认用满可用 vector core（可用 kBlockDimOverride 回退对比）
    uint32_t blockDim = (kBlockDimOverride > 0)
                            ? kBlockDimOverride
                            : (uint32_t)((availableCoreNum > 0) ? availableCoreNum : 1);

    SubCustomTilingData tiling = {(uint32_t)totalLength};

    // 3. 按 dtype 选择实例
    int32_t dtype = t0.dtype;
    if (dtype == 1) {
        sub_custom<half><<<blockDim, nullptr, stream>>>(x, y, z, tiling);
    } else {
        sub_custom<float><<<blockDim, nullptr, stream>>>(x, y, z, tiling);
    }
}