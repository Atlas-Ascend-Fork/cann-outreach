#include <cmath>
#include "kernel_operator.h"

// ============================================================
// Tiling 参数
// ============================================================
struct SubCustomTilingData {
    uint32_t totalLength;
    uint32_t tileNum;
};

// ============================================================
// 性能优化参数
// ============================================================
constexpr uint32_t BUFFER_NUM = 1;
constexpr uint32_t QUEUE_DEPTH = 1;

// ============================================================
// KernelSub: z = x - y
// ============================================================
template <typename T>
class KernelSub {
public:
    __aicore__ inline KernelSub() {}

    // --------------------------------------------------------
    // 初始化
    // --------------------------------------------------------
    __aicore__ inline void Init(
        GM_ADDR x,
        GM_ADDR y,
        GM_ADDR z,
        const SubCustomTilingData& tiling)
    {
        // 每个核负责的数据长度
        this->blockLength =
            tiling.totalLength / AscendC::GetBlockNum();

        this->tileNum = tiling.tileNum;

        // 每个 Tile 的元素数量
        this->tileLength =
            this->blockLength / this->tileNum / BUFFER_NUM;

        // 获取当前核的全局内存起始地址
        uint32_t offset =
            this->blockLength * AscendC::GetBlockIdx();

        xGm.SetGlobalBuffer(
            (__gm__ T*)x + offset,
            this->blockLength
        );

        yGm.SetGlobalBuffer(
            (__gm__ T*)y + offset,
            this->blockLength
        );

        zGm.SetGlobalBuffer(
            (__gm__ T*)z + offset,
            this->blockLength
        );

        // 初始化输入队列
        pipe.InitBuffer(
            inQueueX,
            BUFFER_NUM,
            this->tileLength * sizeof(T)
        );

        pipe.InitBuffer(
            inQueueY,
            BUFFER_NUM,
            this->tileLength * sizeof(T)
        );

        // 初始化输出队列
        pipe.InitBuffer(
            outQueueZ,
            BUFFER_NUM,
            this->tileLength * sizeof(T)
        );
    }

    // --------------------------------------------------------
    // 执行计算
    // --------------------------------------------------------
    __aicore__ inline void Process()
    {
        // 当前配置下 tileNum = 1, BUFFER_NUM = 1
        // 每个核只需要处理一次
        int32_t loopCount = this->tileNum * BUFFER_NUM;

        for (int32_t i = 0; i < loopCount; i++) {
            CopyIn(i);
            Compute(i);
            CopyOut(i);
        }
    }

private:

    // --------------------------------------------------------
    // CopyIn: GM -> Local Memory
    // --------------------------------------------------------
    __aicore__ inline void CopyIn(int32_t progress)
    {
        AscendC::LocalTensor<T> xLocal =
            inQueueX.AllocTensor<T>();

        AscendC::LocalTensor<T> yLocal =
            inQueueY.AllocTensor<T>();

        AscendC::DataCopy(
            xLocal,
            xGm[progress * this->tileLength],
            this->tileLength
        );

        AscendC::DataCopy(
            yLocal,
            yGm[progress * this->tileLength],
            this->tileLength
        );

        inQueueX.EnQue(xLocal);
        inQueueY.EnQue(yLocal);
    }

    // --------------------------------------------------------
    // Compute: z = x - y
    // --------------------------------------------------------
    __aicore__ inline void Compute(int32_t progress)
    {
        AscendC::LocalTensor<T> xLocal =
            inQueueX.DeQue<T>();

        AscendC::LocalTensor<T> yLocal =
            inQueueY.DeQue<T>();

        AscendC::LocalTensor<T> zLocal =
            outQueueZ.AllocTensor<T>();

        // 核心向量减法
        AscendC::Sub(
            zLocal,
            xLocal,
            yLocal,
            this->tileLength
        );

        outQueueZ.EnQue<T>(zLocal);

        // 释放输入 Tensor
        inQueueX.FreeTensor(xLocal);
        inQueueY.FreeTensor(yLocal);
    }

    // --------------------------------------------------------
    // CopyOut: Local Memory -> GM
    // --------------------------------------------------------
    __aicore__ inline void CopyOut(int32_t progress)
    {
        AscendC::LocalTensor<T> zLocal =
            outQueueZ.DeQue<T>();

        AscendC::DataCopy(
            zGm[progress * this->tileLength],
            zLocal,
            this->tileLength
        );

        outQueueZ.FreeTensor(zLocal);
    }

private:

    // 内存管理
    AscendC::TPipe pipe;

    // 输入队列
    AscendC::TQue<
        AscendC::QuePosition::VECIN,
        QUEUE_DEPTH
    > inQueueX, inQueueY;

    // 输出队列
    AscendC::TQue<
        AscendC::QuePosition::VECOUT,
        QUEUE_DEPTH
    > outQueueZ;

    // 全局内存
    AscendC::GlobalTensor<T> xGm;
    AscendC::GlobalTensor<T> yGm;
    AscendC::GlobalTensor<T> zGm;

    // 数据划分参数
    uint32_t blockLength;
    uint32_t tileNum;
    uint32_t tileLength;
};

// ============================================================
// Kernel 入口
// ============================================================
template <typename T>
__global__ __vector__ void sub_custom(
    GM_ADDR x,
    GM_ADDR y,
    GM_ADDR z,
    SubCustomTilingData tiling)
{
    KernelSub<T> op;

    op.Init(x, y, z, tiling);
    op.Process();
}

// ============================================================
// Host 侧入口
// ============================================================
extern "C" void run_kernel(
    GM_ADDR x,
    const TensorGroupInfo& info_x,
    GM_ADDR y,
    const TensorGroupInfo& info_y,
    GM_ADDR z,
    const TensorGroupInfo& info_z,
    int64_t availableCoreNum,
    aclrtStream stream)
{
    // --------------------------------------------------------
    // 1. 配置计算核数量
    // --------------------------------------------------------
    constexpr uint32_t blockDim = 8;

    // --------------------------------------------------------
    // 2. 获取输入 Tensor 的总元素数量
    // --------------------------------------------------------
    const TensorInfo& t0 = info_x.tensors[0];

    int64_t totalLength = 1;

    for (int64_t i = 0; i < t0.numDims; i++) {
        totalLength *= t0.shape[i];
    }

    // --------------------------------------------------------
    // 3. 获取数据类型
    // dtype: 0 = float32, 1 = float16
    // --------------------------------------------------------
    int32_t dtype = t0.dtype;

    // --------------------------------------------------------
    // 4. 设置分块参数
    // 每个核一次处理完整的数据块
    // --------------------------------------------------------
    constexpr uint32_t tileNum = 1;

    SubCustomTilingData tiling = {
        (uint32_t)totalLength,
        tileNum
    };

    // --------------------------------------------------------
    // 5. 根据数据类型启动对应 Kernel
    // --------------------------------------------------------
    if (dtype == 1) {
        // FP16
        sub_custom<half><<<blockDim, nullptr, stream>>>(
            x, y, z, tiling
        );
    }
    else if (dtype == 0) {
        // FP32
        sub_custom<float><<<blockDim, nullptr, stream>>>(
            x, y, z, tiling
        );
    }
}