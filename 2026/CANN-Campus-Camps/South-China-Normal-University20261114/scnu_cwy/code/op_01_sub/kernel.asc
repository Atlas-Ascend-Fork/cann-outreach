#include "kernel_operator.h"

// Fixed workload: ND, (8, 2048), float16 / float32.
// Tune these independently on the target NPU: 4, 8, 16, 32.
// Repeat-interface experiment, target cores: 8.
#ifndef SUB_FP16_CORES
#define SUB_FP16_CORES 8
#endif
#ifndef SUB_FP32_CORES
#define SUB_FP32_CORES 8
#endif

template <typename T, uint32_t CORES>
__global__ __vector__ void sub_custom_repeat(GM_ADDR x, GM_ADDR y, GM_ADDR z)
{
    constexpr uint32_t LENGTH = 8 * 2048 / CORES;
    constexpr uint32_t BYTES = LENGTH * sizeof(T);
    static_assert((8 * 2048) % CORES == 0, "Uneven partition");
    static_assert(BYTES % 32 == 0, "DataCopy requires aligned lengths");

    // Static tensor mode: no TPipe / InitBuffer runtime initialization.
    AscendC::InitSocState();
    AscendC::LocalTensor<T> xLocal(AscendC::TPosition::VECCALC, 0, LENGTH);
    AscendC::LocalTensor<T> yLocal(AscendC::TPosition::VECCALC, BYTES, LENGTH);
    AscendC::LocalTensor<T> zLocal(AscendC::TPosition::VECCALC, 2 * BYTES, LENGTH);

    const uint32_t offset = AscendC::GetBlockIdx() * LENGTH;
    AscendC::GlobalTensor<T> xGm, yGm, zGm;
    xGm.SetGlobalBuffer((__gm__ T*)x + offset, LENGTH);
    yGm.SetGlobalBuffer((__gm__ T*)y + offset, LENGTH);
    zGm.SetGlobalBuffer((__gm__ T*)z + offset, LENGTH);

    AscendC::DataCopy(xLocal, xGm, LENGTH);
    AscendC::DataCopy(yLocal, yGm, LENGTH);
    AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(0);
    AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(0);

    // A vector repeat processes 256 bytes: 128 half or 64 float elements.
    constexpr uint32_t LANES = 256 / sizeof(T);
    constexpr uint32_t REPEATS = LENGTH / LANES;
    static_assert(LENGTH % LANES == 0, "Full vector repeats required");
    if (REPEATS <= 255) {
        // Normal-mask interface, with explicit compile-time repeat count.
        AscendC::Sub<T>(zLocal, xLocal, yLocal,
                       static_cast<uint64_t>(LANES),
                       static_cast<uint8_t>(REPEATS),
                       AscendC::BinaryRepeatParams{1, 1, 1, 8, 8, 8});
    } else {
        // The one-core float fallback needs 256 repeats.
        AscendC::Sub(zLocal, xLocal, yLocal, LENGTH);
    }
    AscendC::SetFlag<AscendC::HardEvent::V_MTE3>(0);
    AscendC::WaitFlag<AscendC::HardEvent::V_MTE3>(0);
    AscendC::DataCopy(zGm, zLocal, LENGTH);
    AscendC::PipeBarrier<PIPE_ALL>();
}

template <typename T, uint32_t TARGET_CORES>
inline void LaunchSub(GM_ADDR x, GM_ADDR y, GM_ADDR z,
                      int64_t availableCoreNum, aclrtStream stream)
{
    static_assert(TARGET_CORES == 4 || TARGET_CORES == 8 ||
                  TARGET_CORES == 16 || TARGET_CORES == 32,
                  "Select 4, 8, 16, or 32 cores");
    // Pick a power of two so every block remains evenly partitioned/aligned.
    const int64_t limit = availableCoreNum < TARGET_CORES
                            ? availableCoreNum : TARGET_CORES;
    if (limit >= 32) {
        sub_custom_repeat<T, 32><<<32, nullptr, stream>>>(x, y, z);
    } else if (limit >= 16) {
        sub_custom_repeat<T, 16><<<16, nullptr, stream>>>(x, y, z);
    } else if (limit >= 8) {
        sub_custom_repeat<T, 8><<<8, nullptr, stream>>>(x, y, z);
    } else if (limit >= 4) {
        sub_custom_repeat<T, 4><<<4, nullptr, stream>>>(x, y, z);
    } else if (limit >= 2) {
        sub_custom_repeat<T, 2><<<2, nullptr, stream>>>(x, y, z);
    } else if (limit >= 1) {
        sub_custom_repeat<T, 1><<<1, nullptr, stream>>>(x, y, z);
    }
}

extern "C" void run_kernel(
    GM_ADDR x, const TensorGroupInfo& info_x,
    GM_ADDR y, const TensorGroupInfo& info_y,
    GM_ADDR z, const TensorGroupInfo& info_z,
    int64_t availableCoreNum, aclrtStream stream)
{
    // Same dtype convention as the supplied judge wrapper: 1 = float16.
    if (info_x.tensors[0].dtype == 1) {
        LaunchSub<half, SUB_FP16_CORES>(x, y, z, availableCoreNum, stream);
    } else {
        LaunchSub<float, SUB_FP32_CORES>(x, y, z, availableCoreNum, stream);
    }
}



