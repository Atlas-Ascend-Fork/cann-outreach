#include <cmath>
#include "kernel_operator.h"
/*
 * Sub Kernel — Ascend C Direct Invocation
 * This file is #included — do NOT add main(), #pragma once, or include guards.
 *
 * TensorGroupInfo / TensorInfo (predefined):
 *   struct TensorInfo { const int64_t* shape; int64_t numDims; int32_t dtype; };
 *   struct TensorGroupInfo { const TensorInfo* tensors; int64_t numTensors; };
 *   dtype: 0=fp32 1=fp16 2=bf16 3=int8 4=int16 5=int32 6=int64 7=uint8 8=uint16 9=uint32 10=uint64 11=bool
 *   Usage: info_x.tensors[0].shape[0]  // first dim of first tensor in input x
 *
 * __global__ __vector__ void sub_custom(...)
 * {
 *     // TODO: implement your kernel logic
 *     // Available APIs: AscendC::TPipe, AscendC::TQue, AscendC::DataCopy, AscendC::Add, ...
 * }
 */

 constexpr int32_t SUB_ROWS = 8;
constexpr int32_t SUB_COLS = 2048;
constexpr int32_t SUB_ELEMENTS = SUB_ROWS * SUB_COLS;

template <typename T>
__aicore__ inline void ProcessSub(GM_ADDR x, GM_ADDR y, GM_ADDR z, AscendC::TPipe& pipe)
{
    AscendC::GlobalTensor<T> xGm, yGm, zGm;
    xGm.SetGlobalBuffer((__gm__ T*)x, SUB_ELEMENTS);
    yGm.SetGlobalBuffer((__gm__ T*)y, SUB_ELEMENTS);
    zGm.SetGlobalBuffer((__gm__ T*)z, SUB_ELEMENTS);

    AscendC::TQue<AscendC::TPosition::VECIN, 1> xQueue, yQueue;
    AscendC::TQue<AscendC::TPosition::VECOUT, 1> zQueue;
    constexpr uint32_t rowBytes = SUB_COLS * sizeof(T);
    pipe.InitBuffer(xQueue, 1, rowBytes);
    pipe.InitBuffer(yQueue, 1, rowBytes);
    pipe.InitBuffer(zQueue, 1, rowBytes);

    const int32_t blockNum = AscendC::GetBlockNum();
    for (int32_t row = AscendC::GetBlockIdx(); row < SUB_ROWS; row += blockNum) {
        const int32_t offset = row * SUB_COLS;

        auto xLocal = xQueue.AllocTensor<T>();
        auto yLocal = yQueue.AllocTensor<T>();
        AscendC::DataCopy(xLocal, xGm[offset], SUB_COLS);
        AscendC::DataCopy(yLocal, yGm[offset], SUB_COLS);
        xQueue.EnQue<T>(xLocal);
        yQueue.EnQue<T>(yLocal);

        auto xReady = xQueue.DeQue<T>();
        auto yReady = yQueue.DeQue<T>();
        auto zLocal = zQueue.AllocTensor<T>();
        AscendC::Sub(zLocal, xReady, yReady, SUB_COLS);
        zQueue.EnQue<T>(zLocal);
        xQueue.FreeTensor(xReady);
        yQueue.FreeTensor(yReady);

        auto zReady = zQueue.DeQue<T>();
        AscendC::DataCopy(zGm[offset], zReady, SUB_COLS);
        zQueue.FreeTensor(zReady);
    }
}

__global__ __vector__ void sub_fp32(GM_ADDR x, GM_ADDR y, GM_ADDR z)
{
    AscendC::TPipe pipe;
    ProcessSub<float>(x, y, z, pipe);
}

__global__ __vector__ void sub_fp16(GM_ADDR x, GM_ADDR y, GM_ADDR z)
{
    AscendC::TPipe pipe;
    ProcessSub<half>(x, y, z, pipe);
}

extern "C" void run_kernel(GM_ADDR x, const TensorGroupInfo& info_x, GM_ADDR y, const TensorGroupInfo& info_y, GM_ADDR z, const TensorGroupInfo& info_z, int64_t availableCoreNum, aclrtStream stream)
{
    // TODO: define your launch kernel.
    //   sub_custom<<<blockNum, nullptr, stream>>>(...);
    if (availableCoreNum <= 0) {return;}

    const uint32_t blockNum = static_cast<uint32_t>(availableCoreNum < SUB_ROWS ? availableCoreNum : SUB_ROWS);
    const int32_t dtype = info_x.tensors[0].dtype;

    if (dtype == 0) 
    {
        sub_fp32<<<blockNum, nullptr, stream>>>(x, y, z);
    } 
    else if (dtype == 1) 
    {
        sub_fp16<<<blockNum, nullptr, stream>>>(x, y, z);
    }
}
