#include <cmath>
#include "kernel_operator.h"

struct Tiling {
    uint32_t totalLen;
    uint32_t tNum;
};

constexpr uint32_t BUF_NUM = 2;

template <typename T>
class SubOp {
public:
    __aicore__ inline SubOp() {}

    __aicore__ inline void Init(GM_ADDR x, GM_ADDR y, GM_ADDR z, Tiling t) {
        blkLen = t.totalLen / AscendC::GetBlockNum();
        tNum = t.tNum;
        tLen = blkLen / tNum / BUF_NUM;

        gX.SetGlobalBuffer((__gm__ T*)x + blkLen * AscendC::GetBlockIdx(), blkLen);
        gY.SetGlobalBuffer((__gm__ T*)y + blkLen * AscendC::GetBlockIdx(), blkLen);
        gZ.SetGlobalBuffer((__gm__ T*)z + blkLen * AscendC::GetBlockIdx(), blkLen);

        tp.InitBuffer(qX, BUF_NUM, tLen * sizeof(T));
        tp.InitBuffer(qY, BUF_NUM, tLen * sizeof(T));
        tp.InitBuffer(qZ, BUF_NUM, tLen * sizeof(T));
    }

    __aicore__ inline void Process() {
        int32_t loop = tNum * BUF_NUM;
        for (int32_t i = 0; i < loop; i++) {
            CopyIn(i);
            Compute(i);
            CopyOut(i);
        }
    }

private:
    __aicore__ inline void CopyIn(int32_t p) {
        AscendC::LocalTensor<T> lx = qX.AllocTensor<T>();
        AscendC::LocalTensor<T> ly = qY.AllocTensor<T>();
        AscendC::DataCopy(lx, gX[p * tLen], tLen);
        AscendC::DataCopy(ly, gY[p * tLen], tLen);
        qX.EnQue(lx);
        qY.EnQue(ly);
    }

    __aicore__ inline void Compute(int32_t p) {
        AscendC::LocalTensor<T> lx = qX.DeQue<T>();
        AscendC::LocalTensor<T> ly = qY.DeQue<T>();
        AscendC::LocalTensor<T> lz = qZ.AllocTensor<T>();
        
        // 核心减法计算 z = x - y
        AscendC::Sub(lz, lx, ly, tLen);
        
        qZ.EnQue<T>(lz);
        qX.FreeTensor(lx);
        qY.FreeTensor(ly);
    }

    __aicore__ inline void CopyOut(int32_t p) {
        AscendC::LocalTensor<T> lz = qZ.DeQue<T>();
        AscendC::DataCopy(gZ[p * tLen], lz, tLen);
        qZ.FreeTensor(lz);
    }

private:
    AscendC::TPipe tp;
    AscendC::TQue<AscendC::QuePosition::VECIN, BUF_NUM> qX, qY;
    AscendC::TQue<AscendC::QuePosition::VECOUT, BUF_NUM> qZ;
    AscendC::GlobalTensor<T> gX, gY, gZ;
    
    uint32_t blkLen;
    uint32_t tNum;
    uint32_t tLen;
};


template <typename T>
__global__ __vector__ void sub_custom(GM_ADDR x, GM_ADDR y, GM_ADDR z, Tiling t) {
    SubOp<T> op;
    op.Init(x, y, z, t);
    op.Process();
}

extern "C" void run_kernel(GM_ADDR x, const TensorGroupInfo& info_x, GM_ADDR y, const TensorGroupInfo& info_y, GM_ADDR z, const TensorGroupInfo& info_z, int64_t availableCoreNum, aclrtStream stream) {
    constexpr uint32_t blockDim = 8;
    auto& t = info_x.tensors[0];
    
    int64_t totalLen = 1;
    for (int64_t i = 0; i < t.numDims; i++) {
        totalLen *= t.shape[i];
    }
    
    Tiling ti = {(uint32_t)totalLen, 8};
    
    if (t.dtype == 1) {
        sub_custom<half><<<blockDim, nullptr, stream>>>(x, y, z, ti);
    } else {
        sub_custom<float><<<blockDim, nullptr, stream>>>(x, y, z, ti);
    }
}