#include <cmath>
#include "kernel_operator.h"

constexpr uint32_t TOTAL_NUM = 16384;
constexpr uint32_t BLOCK_DIM = 16;
constexpr uint32_t BLOCK_LENGTH = TOTAL_NUM / BLOCK_DIM;

template <typename T>
class KernelSub {
public:
    __aicore__ inline KernelSub() {}

    __aicore__ inline void Init(GM_ADDR x, GM_ADDR y, GM_ADDR z)
    {
        uint32_t blockIdx = AscendC::GetBlockIdx();
        uint32_t offset = blockIdx * BLOCK_LENGTH;
        xGm.SetGlobalBuffer((__gm__ T *)x + offset, BLOCK_LENGTH);
        yGm.SetGlobalBuffer((__gm__ T *)y + offset, BLOCK_LENGTH);
        zGm.SetGlobalBuffer((__gm__ T *)z + offset, BLOCK_LENGTH);
    }

    __aicore__ inline void Process()
    {
        uint32_t xAddr = 0;
        uint32_t yAddr = BLOCK_LENGTH * sizeof(T);
        uint32_t zAddr = BLOCK_LENGTH * sizeof(T) * 2;
        AscendC::LocalTensor<T> xLocal(AscendC::TPosition::VECIN, xAddr, BLOCK_LENGTH);
        AscendC::LocalTensor<T> yLocal(AscendC::TPosition::VECIN, yAddr, BLOCK_LENGTH);
        AscendC::LocalTensor<T> zLocal(AscendC::TPosition::VECOUT, zAddr, BLOCK_LENGTH);

        AscendC::DataCopy(xLocal, xGm, BLOCK_LENGTH);
        AscendC::DataCopy(yLocal, yGm, BLOCK_LENGTH);
        AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(0);
        AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(0);

        AscendC::Sub(zLocal, xLocal, yLocal, BLOCK_LENGTH);

        AscendC::SetFlag<AscendC::HardEvent::V_MTE3>(0);
        AscendC::WaitFlag<AscendC::HardEvent::V_MTE3>(0);
        AscendC::DataCopy(zGm, zLocal, BLOCK_LENGTH);
    }

private:
    AscendC::GlobalTensor<T> xGm;
    AscendC::GlobalTensor<T> yGm;
    AscendC::GlobalTensor<T> zGm;
};

template <typename T>
__global__ __vector__ void sub_custom(GM_ADDR x, GM_ADDR y, GM_ADDR z)
{
    AscendC::InitSocState();
    KernelSub<T> op;
    op.Init(x, y, z);
    op.Process();
}

extern "C" void run_kernel(GM_ADDR x, const TensorGroupInfo& info_x, GM_ADDR y, const TensorGroupInfo& info_y, GM_ADDR z, const TensorGroupInfo& info_z, int64_t availableCoreNum, aclrtStream stream)
{
    int32_t dtype = info_x.tensors[0].dtype;
    if (dtype == 1) {
        sub_custom<half><<<BLOCK_DIM, nullptr, stream>>>(x, y, z);
    } else {
        sub_custom<float><<<BLOCK_DIM, nullptr, stream>>>(x, y, z);
    }
}