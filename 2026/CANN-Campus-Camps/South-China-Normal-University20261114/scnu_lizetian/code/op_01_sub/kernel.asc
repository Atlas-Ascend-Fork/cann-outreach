#include <cmath>
#include "kernel_operator.h"

// ============================================================
// 可调参数
// 实测：16 核比 8 核更慢（fp32 2.46 vs 2.36），核数固定为 8；
//       合并输入队列有效（fp16 2.26 -> 2.04）。
// 本算子每核只有几 KB，端到端耗时由“启动 + 首尾 DMA 延迟”决定，
// 拆 tile 做双缓冲无法掩盖这段串行延迟，反而多一组同步事件。
// ============================================================

constexpr uint32_t MAX_CORES       = 8;    // 与 shape 行数一致，实测优于 16 核
constexpr uint32_t TILE_NUM        = 1;    // 每核 tile 数（大 shape 可试 2）
constexpr uint32_t BUFFER_NUM      = 1;    // 与 TILE_NUM 配套
constexpr uint32_t QUEUE_DEPTH     = 1;
constexpr uint32_t MIN_ALIGN_BYTES = 32;   // DataCopy 需要 32B 对齐

// ============================================================
// Tiling 参数（由 Host 侧算好，Kernel 内不再做除法）
// ============================================================

struct SubCustomTilingData {
    uint32_t blockLength;  // 每核元素数
    uint32_t tileNum;      // 每核 tile 数
    uint32_t tileLength;   // 每个 tile 元素数
};

// ============================================================
// KernelSub: z = x - y
// ============================================================

template <typename T>
class KernelSub {
public:
    __aicore__ inline KernelSub() {}

    __aicore__ inline void Init(
        GM_ADDR x,
        GM_ADDR y,
        GM_ADDR z,
        const SubCustomTilingData& tiling)
    {
        this->blockLength = tiling.blockLength;
        this->tileNum     = tiling.tileNum;
        this->tileLength  = tiling.tileLength;

        // 当前核的全局内存偏移
        uint32_t offset = this->blockLength * AscendC::GetBlockIdx();

        xGm.SetGlobalBuffer((__gm__ T*)x + offset, this->blockLength);
        yGm.SetGlobalBuffer((__gm__ T*)y + offset, this->blockLength);
        zGm.SetGlobalBuffer((__gm__ T*)z + offset, this->blockLength);

        // x、y 合并到一个输入队列：一次 EnQue/DeQue，少一组同步事件
        pipe.InitBuffer(
            inQueueXY,
            BUFFER_NUM,
            2 * this->tileLength * sizeof(T)
        );

        pipe.InitBuffer(
            outQueueZ,
            BUFFER_NUM,
            this->tileLength * sizeof(T)
        );
    }

    // ========================================================
    // 执行计算
    // ========================================================

    __aicore__ inline void Process()
    {
        for (uint32_t i = 0; i < this->tileNum; i++) {
            CopyIn(i);
            Compute(i);
            CopyOut(i);
        }
    }

private:

    __aicore__ inline void CopyIn(uint32_t progress)
    {
        AscendC::LocalTensor<T> xyLocal =
            inQueueXY.AllocTensor<T>();

        uint32_t offset = progress * this->tileLength;

        // 前半段放 x，后半段放 y
        AscendC::DataCopy(
            xyLocal,
            xGm[offset],
            this->tileLength
        );

        AscendC::DataCopy(
            xyLocal[this->tileLength],
            yGm[offset],
            this->tileLength
        );

        inQueueXY.EnQue(xyLocal);
    }

    __aicore__ inline void Compute(uint32_t progress)
    {
        AscendC::LocalTensor<T> xyLocal =
            inQueueXY.DeQue<T>();

        AscendC::LocalTensor<T> zLocal =
            outQueueZ.AllocTensor<T>();

        AscendC::Sub(
            zLocal,
            xyLocal,
            xyLocal[this->tileLength],
            this->tileLength
        );

        outQueueZ.EnQue<T>(zLocal);
        inQueueXY.FreeTensor(xyLocal);
    }

    __aicore__ inline void CopyOut(uint32_t progress)
    {
        AscendC::LocalTensor<T> zLocal =
            outQueueZ.DeQue<T>();

        uint32_t offset = progress * this->tileLength;

        AscendC::DataCopy(
            zGm[offset],
            zLocal,
            this->tileLength
        );

        outQueueZ.FreeTensor(zLocal);
    }

private:

    AscendC::TPipe pipe;

    AscendC::TQue<AscendC::QuePosition::VECIN, QUEUE_DEPTH>
        inQueueXY;

    AscendC::TQue<AscendC::QuePosition::VECOUT, QUEUE_DEPTH>
        outQueueZ;

    AscendC::GlobalTensor<T> xGm;
    AscendC::GlobalTensor<T> yGm;
    AscendC::GlobalTensor<T> zGm;

    uint32_t blockLength;
    uint32_t tileNum;
    uint32_t tileLength;
};

// ============================================================
// Kernel Entry
// ============================================================

template <typename T>
__global__ __vector__ void sub_custom(
    GM_ADDR x,
    GM_ADDR y,
    GM_ADDR z,
    SubCustomTilingData tiling)
{
    KernelSub<T> op;

    op.Init(x, y, z, tiling);
    op.Process();
}

// ============================================================
// Host Entry
// ============================================================

extern "C" void run_kernel(
    GM_ADDR x,
    const TensorGroupInfo& info_x,
    GM_ADDR y,
    const TensorGroupInfo& info_y,
    GM_ADDR z,
    const TensorGroupInfo& info_z,
    int64_t availableCoreNum,
    aclrtStream stream)
{
    // 获取总元素数量
    const TensorInfo& t0 = info_x.tensors[0];

    int64_t totalLength = 1;

    for (int64_t i = 0; i < t0.numDims; i++) {
        totalLength *= t0.shape[i];
    }

    // dtype: 0 = FP32, 1 = FP16
    int32_t dtype = t0.dtype;

    uint32_t elemSize = (dtype == 1) ? 2u : 4u;

    // ---- 选核：最多 MAX_CORES，且必须能整除 totalLength（无尾块） ----
    uint32_t maxCores = MAX_CORES;

    if ((int64_t)maxCores > availableCoreNum) {
        maxCores = (uint32_t)availableCoreNum;
    }

    if (maxCores < 1) {
        maxCores = 1;
    }

    uint32_t blockDim = 1;

    for (uint32_t c = maxCores; c >= 2; c--) {
        if (totalLength % c == 0) {
            blockDim = c;
            break;
        }
    }

    uint32_t blockLength = (uint32_t)(totalLength / (int64_t)blockDim);

    // ---- 选 tile：保证 32B 对齐，否则退回单 tile ----
    uint32_t tileNum = TILE_NUM;

    if (tileNum > 1) {
        bool ok = (blockLength % tileNum == 0)
               && ((blockLength / tileNum) * elemSize % MIN_ALIGN_BYTES == 0)
               && ((blockLength / tileNum) >= 64);

        if (!ok) {
            tileNum = 1;
        }
    }

    uint32_t tileLength = blockLength / tileNum;

    SubCustomTilingData tiling = {
        blockLength,
        tileNum,
        tileLength
    };

    if (dtype == 1) {
        sub_custom<half><<<blockDim, nullptr, stream>>>(
            x, y, z, tiling
        );
    }
    else if (dtype == 0) {
        sub_custom<float><<<blockDim, nullptr, stream>>>(
            x, y, z, tiling
        );
    }
}
