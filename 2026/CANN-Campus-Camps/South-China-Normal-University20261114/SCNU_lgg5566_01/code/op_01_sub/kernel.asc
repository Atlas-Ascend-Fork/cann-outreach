#include <cmath>
#include "kernel_operator.h"

// ---------------------------------------------------------------------------
// Tiling 参数（字段顺序必须与 host 侧聚合初始化 {totalLength, tileNum} 一致）
// ---------------------------------------------------------------------------
struct SubCustomTilingData {
    uint32_t totalLength;   // 全局元素总数
    uint32_t tileNum;       // 单核内目标分块数
};

constexpr uint32_t BUFFER_NUM = 2;   // 双缓冲
constexpr uint32_t QUEUE_DEPTH = 1;
// ---------------------------------------------------------------------------
// KernelSub：z = x - y
//   - 核间切分：前 rem 个核各多处理 1 个元素，严格覆盖 [0, totalLength)
//   - 核内切分：tileLength 向上对齐到 32B 元素数；尾块用 DataCopyPad
// ---------------------------------------------------------------------------
template <typename T>
class KernelSub {
public:
    __aicore__ inline KernelSub() {}

    __aicore__ inline void Init(GM_ADDR x, GM_ADDR y, GM_ADDR z,
                                const SubCustomTilingData& tiling)
    {
        constexpr uint32_t alignElem = 32 / sizeof(T);   // 32B 对齐元素数

        const uint32_t totalLength = tiling.totalLength;
        const uint32_t blockNum    = AscendC::GetBlockNum();
        const uint32_t coreIdx     = AscendC::GetBlockIdx();

        // ---- 1. 核间切分（无遗漏，无重复）----
        const uint32_t base = totalLength / blockNum;
        const uint32_t rem  = totalLength % blockNum;
        this->myStart  = coreIdx * base + (coreIdx < rem ? coreIdx : rem);
        this->myLength = base + (coreIdx < rem ? 1u : 0u);

        // ---- 2. 核内切分：tileLength 向上对齐到 32B，正常路径走 DataCopy ----
        const uint32_t tn = (tiling.tileNum == 0) ? 1u : tiling.tileNum;
        uint32_t rawTile = (this->myLength + tn - 1) / tn;
        if (rawTile == 0) rawTile = alignElem;
        this->tileLength = ((rawTile + alignElem - 1) / alignElem) * alignElem;
        this->tileNum    = tn;
        this->alignElem  = alignElem;

        // ---- 3. 绑定 GM（按本核起点偏移）----
        xGm.SetGlobalBuffer((__gm__ T *)x + this->myStart, this->myLength);
        yGm.SetGlobalBuffer((__gm__ T *)y + this->myStart, this->myLength);
        zGm.SetGlobalBuffer((__gm__ T *)z + this->myStart, this->myLength);

        // ---- 4. UB 分配：tileLength * sizeof(T) 天然是 32B 倍数 ----
        const uint32_t bufBytes = this->tileLength * sizeof(T);
        pipe.InitBuffer(inQueueX,  BUFFER_NUM, bufBytes);
        pipe.InitBuffer(inQueueY,  BUFFER_NUM, bufBytes);
        pipe.InitBuffer(outQueueZ, BUFFER_NUM, bufBytes);
    }

    __aicore__ inline void Process()
    {
        if (this->myLength == 0) return;

        for (uint32_t i = 0; i < this->tileNum; i++) {
            const uint32_t off = i * this->tileLength;
            if (off >= this->myLength) break;               // 后面全是空块
            uint32_t len = this->myLength - off;
            if (len > this->tileLength) len = this->tileLength;

            CopyIn(off, len);
            Compute(len);
            CopyOut(off, len);
        }
    }

private:
    __aicore__ inline void CopyIn(uint32_t off, uint32_t len)
    {
        AscendC::LocalTensor<T> xLocal = inQueueX.AllocTensor<T>();
        AscendC::LocalTensor<T> yLocal = inQueueY.AllocTensor<T>();

        if (len % alignElem == 0) {
            AscendC::DataCopy(xLocal, xGm[off], len);
            AscendC::DataCopy(yLocal, yGm[off], len);
        } else {
            AscendC::DataCopyExtParams cp{1, (uint32_t)(len * sizeof(T)), 0, 0, 0};
            AscendC::DataCopyPadExtParams<T> pp{false, 0, 0, static_cast<T>(0)};
            AscendC::DataCopyPad(xLocal, xGm[off], cp, pp);
            AscendC::DataCopyPad(yLocal, yGm[off], cp, pp);
        }

        inQueueX.EnQue(xLocal);
        inQueueY.EnQue(yLocal);
    }

    __aicore__ inline void Compute(uint32_t len)
    {
        AscendC::LocalTensor<T> xLocal = inQueueX.DeQue<T>();
        AscendC::LocalTensor<T> yLocal = inQueueY.DeQue<T>();
        AscendC::LocalTensor<T> zLocal = outQueueZ.AllocTensor<T>();

        AscendC::Sub(zLocal, xLocal, yLocal, len);          // ★ 核心：z = x - y

        outQueueZ.EnQue<T>(zLocal);
        inQueueX.FreeTensor(xLocal);
        inQueueY.FreeTensor(yLocal);
    }

    __aicore__ inline void CopyOut(uint32_t off, uint32_t len)
    {
        AscendC::LocalTensor<T> zLocal = outQueueZ.DeQue<T>();

        if (len % alignElem == 0) {
            AscendC::DataCopy(zGm[off], zLocal, len);
        } else {
            AscendC::DataCopyExtParams cp{1, (uint32_t)(len * sizeof(T)), 0, 0, 0};
            AscendC::DataCopyPad(zGm[off], zLocal, cp);
        }

        outQueueZ.FreeTensor(zLocal);
    }

private:
    AscendC::TPipe pipe;
    AscendC::TQue<AscendC::QuePosition::VECIN,  BUFFER_NUM> inQueueX, inQueueY;
    AscendC::TQue<AscendC::QuePosition::VECOUT, BUFFER_NUM> outQueueZ;
    AscendC::GlobalTensor<T> xGm, yGm, zGm;

    uint32_t myStart{0};      // 本核在全局的起始偏移（元素）
    uint32_t myLength{0};     // 本核负责的元素数
    uint32_t tileNum{1};      // 单核内循环块数
    uint32_t tileLength{1};   // 每块元素数（32B 对齐）
    uint32_t alignElem{1};    // 32B 对应的元素数
};

// ---------------------------------------------------------------------------
// 核函数入口
// ---------------------------------------------------------------------------
template <typename T>
__global__ __vector__ void sub_custom(GM_ADDR x, GM_ADDR y, GM_ADDR z,
                                      SubCustomTilingData tiling)
{
    KernelSub<T> op;
    op.Init(x, y, z, tiling);
    op.Process();
}

// ---------------------------------------------------------------------------
// Host 侧启动
// ---------------------------------------------------------------------------
extern "C" void run_kernel(GM_ADDR x, const TensorGroupInfo& info_x,
                           GM_ADDR y, const TensorGroupInfo& info_y,
                           GM_ADDR z, const TensorGroupInfo& info_z,
                           int64_t availableCoreNum, aclrtStream stream)
{
    // 1) 元素总数
    const TensorInfo& t0 = info_x.tensors[0];
    int64_t totalLength = 1;
    for (int64_t i = 0; i < t0.numDims; i++) totalLength *= t0.shape[i];
    if (totalLength <= 0) return;

    // 2) blockDim：min(availableCoreNum, 8)，至少 1
    uint32_t blockDim = 8;
    if (availableCoreNum > 0 && (uint64_t)availableCoreNum < blockDim) {
        blockDim = (uint32_t)availableCoreNum;
    }
    if (blockDim == 0) blockDim = 1;

    // 3) tiling
    const uint32_t tileNum = 8;
    SubCustomTilingData tiling = {(uint32_t)totalLength, tileNum};

    // 4) 按 dtype 分派
    if (t0.dtype == 1) {
        sub_custom<half><<<blockDim, nullptr, stream>>>(x, y, z, tiling);   // fp16
    } else {
        sub_custom<float><<<blockDim, nullptr, stream>>>(x, y, z, tiling);  // fp32
    }
}