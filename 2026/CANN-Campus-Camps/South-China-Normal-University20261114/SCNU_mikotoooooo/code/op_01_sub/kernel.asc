
#include <cmath>
#include "kernel_operator.h"

// 减法算子的 Tiling 数据
struct SubCustomTilingData {
    uint32_t totalLength;
    uint32_t tileNum;
};

// 双缓冲配置
constexpr uint32_t BUFFER_NUM = 2;
constexpr uint32_t QUEUE_DEPTH = 1;

// KernelSub：负责 NPU 上的减法计算
template <typename T>
class KernelSub {
public:
    __aicore__ inline KernelSub() {}

    // 第一步：初始化输入输出地址和计算参数
    __aicore__ inline void Init(
        GM_ADDR x,
        GM_ADDR y,
        GM_ADDR z,
        const SubCustomTilingData& tiling
    )
    {
        uint32_t totalLength = tiling.totalLength;
        uint32_t tileNum = tiling.tileNum;

        // 每个 Block 负责处理的数据量
        this->blockLength = totalLength / AscendC::GetBlockNum();

        // 每个 Block 内部划分的计算块数量
        this->tileNum = tileNum;

        // 每次处理的数据量
        this->tileLength = this->blockLength / tileNum / BUFFER_NUM;

        // 设置当前 Block 对应的 GM 数据区域
        xGm.SetGlobalBuffer(
            (__gm__ T *)x + this->blockLength * AscendC::GetBlockIdx(),
            this->blockLength
        );

        yGm.SetGlobalBuffer(
            (__gm__ T *)y + this->blockLength * AscendC::GetBlockIdx(),
            this->blockLength
        );

        zGm.SetGlobalBuffer(
            (__gm__ T *)z + this->blockLength * AscendC::GetBlockIdx(),
            this->blockLength
        );

        // 初始化输入和输出队列
        pipe.InitBuffer(inQueueX, BUFFER_NUM, this->tileLength * sizeof(T));
        pipe.InitBuffer(inQueueY, BUFFER_NUM, this->tileLength * sizeof(T));
        pipe.InitBuffer(outQueueZ, BUFFER_NUM, this->tileLength * sizeof(T));
    }

    // 第二步：执行完整计算流程
    __aicore__ inline void Process()
    {
        int32_t loopCount = this->tileNum * BUFFER_NUM;

        for (int32_t i = 0; i < loopCount; i++) {
            CopyIn(i);
            Compute(i);
            CopyOut(i);
        }
    }

private:
    // 将数据从 GM 搬运到 UB
    __aicore__ inline void CopyIn(int32_t progress)
    {
        AscendC::LocalTensor<T> xLocal = inQueueX.AllocTensor<T>();
        AscendC::LocalTensor<T> yLocal = inQueueY.AllocTensor<T>();

        AscendC::DataCopy(
            xLocal,
            xGm[progress * this->tileLength],
            this->tileLength
        );

        AscendC::DataCopy(
            yLocal,
            yGm[progress * this->tileLength],
            this->tileLength
        );

        inQueueX.EnQue(xLocal);
        inQueueY.EnQue(yLocal);
    }

    // 在 UB 中执行减法
    __aicore__ inline void Compute(int32_t progress)
    {
        AscendC::LocalTensor<T> xLocal = inQueueX.DeQue<T>();
        AscendC::LocalTensor<T> yLocal = inQueueY.DeQue<T>();
        AscendC::LocalTensor<T> zLocal = outQueueZ.AllocTensor<T>();

        // 核心计算：z = x - y
        AscendC::Sub(zLocal, xLocal, yLocal, this->tileLength);

        outQueueZ.EnQue<T>(zLocal);

        inQueueX.FreeTensor(xLocal);
        inQueueY.FreeTensor(yLocal);
    }

    // 将计算结果从 UB 搬运回 GM
    __aicore__ inline void CopyOut(int32_t progress)
    {
        AscendC::LocalTensor<T> zLocal = outQueueZ.DeQue<T>();

        AscendC::DataCopy(
            zGm[progress * this->tileLength],
            zLocal,
            this->tileLength
        );

        outQueueZ.FreeTensor(zLocal);
    }

private:
    AscendC::TPipe pipe;

    AscendC::TQue<AscendC::QuePosition::VECIN, QUEUE_DEPTH> inQueueX, inQueueY;
    AscendC::TQue<AscendC::QuePosition::VECOUT, QUEUE_DEPTH> outQueueZ;

    AscendC::GlobalTensor<T> xGm, yGm, zGm;

    uint32_t blockLength;
    uint32_t tileNum;
    uint32_t tileLength;
};

// NPU 端 Kernel 入口
template <typename T>
__global__ __vector__ void sub_custom(
    GM_ADDR x,
    GM_ADDR y,
    GM_ADDR z,
    SubCustomTilingData tiling
)
{
    KernelSub<T> op;
    op.Init(x, y, z, tiling);
    op.Process();
}

// Host 端入口：负责配置并启动 Kernel
extern "C" void run_kernel(
    GM_ADDR x,
    const TensorGroupInfo& info_x,
    GM_ADDR y,
    const TensorGroupInfo& info_y,
    GM_ADDR z,
    const TensorGroupInfo& info_z,
    int64_t availableCoreNum,
    aclrtStream stream
)
{
    // 使用 8 个 Block 执行计算
    constexpr uint32_t blockDim = 8;

    // 获取输入张量的信息
    const TensorInfo& t0 = info_x.tensors[0];

    // 计算输入张量的总元素数量
    int64_t totalLength = 1;
    for (int64_t i = 0; i < t0.numDims; i++) {
        totalLength *= t0.shape[i];
    }

    // 获取输入数据类型
    int32_t dtype = t0.dtype;

    // 每个 Block 内划分 8 个计算块
    uint32_t tileNum = 8;

    SubCustomTilingData tiling = {
        (uint32_t)totalLength,
        tileNum
    };

    // 根据数据类型选择对应的 Kernel
    if (dtype == 1) {
        // float16
        sub_custom<half><<<blockDim, nullptr, stream>>>(x, y, z, tiling);
    }
    else if (dtype == 0) {
        // float32
        sub_custom<float><<<blockDim, nullptr, stream>>>(x, y, z, tiling);
    }

    // 其他数据类型不在本题支持范围内
}
