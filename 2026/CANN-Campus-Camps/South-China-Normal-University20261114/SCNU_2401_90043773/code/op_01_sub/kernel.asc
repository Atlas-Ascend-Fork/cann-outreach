#include <cmath>
#include <cstdint>
#include "kernel_operator.h"

using namespace AscendC;

constexpr int32_t BUFFER_NUM = 2;

// 设备侧执行函数
template <typename T>
__global__ __aicore__ void sub_custom(
    GM_ADDR x, GM_ADDR y, GM_ADDR z,
    uint32_t totalLength, uint32_t coreNum)
{
    // 计算 32 字节对齐的元素个数 (fp32: 8 个元素，fp16: 16 个元素)
    uint32_t alignElem = 32 / sizeof(T);
    uint32_t totalBlocks = totalLength / alignElem; 
    
    uint32_t blockIdx = GetBlockIdx();
    if (blockIdx >= coreNum || blockIdx >= totalBlocks) {
        return; 
    }
    
    // 将总块数均匀分配给各个核
    uint32_t blocksPerCore = totalBlocks / coreNum;
    uint32_t remBlocks = totalBlocks % coreNum;
    
    uint32_t myBlocks = blocksPerCore + (blockIdx < remBlocks ? 1 : 0);
    uint32_t myOffsetBlocks = blockIdx * blocksPerCore + (blockIdx < remBlocks ? blockIdx : remBlocks);
    
    // 得到当前核实际处理的总元素个数及偏移（32字节对齐）
    uint32_t length = myBlocks * alignElem;
    uint32_t offset = myOffsetBlocks * alignElem;
    
    if (length == 0) return;

    GlobalTensor<T> xGm, yGm, zGm;
    xGm.SetGlobalBuffer((__gm__ T*)x + offset, length);
    yGm.SetGlobalBuffer((__gm__ T*)y + offset, length);
    zGm.SetGlobalBuffer((__gm__ T*)z + offset, length);

    TPipe pipe;
    TQue<QuePosition::VECIN, BUFFER_NUM> inQueueX;
    TQue<QuePosition::VECIN, BUFFER_NUM> inQueueY;
    TQue<QuePosition::VECOUT, BUFFER_NUM> outQueueZ;

    // 计算单次搬运的 tileLength，同样需要保证 32 字节对齐
    uint32_t tileLength = length / BUFFER_NUM;
    tileLength = tileLength / alignElem * alignElem; 
    if (tileLength == 0) tileLength = alignElem;

    pipe.InitBuffer(inQueueX, BUFFER_NUM, tileLength * sizeof(T));
    pipe.InitBuffer(inQueueY, BUFFER_NUM, tileLength * sizeof(T));
    pipe.InitBuffer(outQueueZ, BUFFER_NUM, tileLength * sizeof(T));

    for (uint32_t i = 0; i < length; i += tileLength) {
        uint32_t curLen = (length - i < tileLength) ? (length - i) : tileLength;
        
        LocalTensor<T> xLocal = inQueueX.AllocTensor<T>();
        LocalTensor<T> yLocal = inQueueY.AllocTensor<T>();
        LocalTensor<T> zLocal = outQueueZ.AllocTensor<T>();
        
        DataCopy(xLocal, xGm[i], curLen);
        DataCopy(yLocal, yGm[i], curLen);
        
        inQueueX.EnQue(xLocal);
        inQueueY.EnQue(yLocal);
        
        LocalTensor<T> xIn = inQueueX.DeQue<T>();
        LocalTensor<T> yIn = inQueueY.DeQue<T>();
        Sub(zLocal, xIn, yIn, curLen);
        
        outQueueZ.EnQue<T>(zLocal);
        inQueueX.FreeTensor(xIn);
        inQueueY.FreeTensor(yIn);
        
        LocalTensor<T> zOut = outQueueZ.DeQue<T>();
        DataCopy(zGm[i], zOut, curLen);
        outQueueZ.FreeTensor(zOut);
    }
}

// Host 侧统一入口
extern "C" void run_kernel(
    GM_ADDR x, const TensorGroupInfo& info_x,
    GM_ADDR y, const TensorGroupInfo& info_y,
    GM_ADDR z, const TensorGroupInfo& info_z,
    int64_t availableCoreNum, aclrtStream stream)
{
    if (info_x.numTensors == 0 || info_x.tensors[0].numDims == 0) return;

    int64_t totalLength = 1;
    for (int64_t i = 0; i < info_x.tensors[0].numDims; ++i) {
        totalLength *= info_x.tensors[0].shape[i];
    }

    int64_t coreNum = availableCoreNum > 0 ? availableCoreNum : 1;
    if (coreNum > totalLength) {
        coreNum = totalLength;
    }

    if (info_x.tensors[0].dtype == 1) { // fp16
        sub_custom<half><<<coreNum, nullptr, stream>>>(x, y, z, (uint32_t)totalLength, (uint32_t)coreNum);
    } else { // fp32
        sub_custom<float><<<coreNum, nullptr, stream>>>(x, y, z, (uint32_t)totalLength, (uint32_t)coreNum);
    }
}