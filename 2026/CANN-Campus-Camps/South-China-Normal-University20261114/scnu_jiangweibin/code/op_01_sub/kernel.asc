#include "kernel_operator.h"

namespace {
constexpr uint32_t kTileElements = 256;
constexpr uint32_t kMaxBlocks = 8;
constexpr uint32_t kQueueDepth = 1;

template <typename T>
class KernelSub {
public:
    __aicore__ inline void Init(GM_ADDR x, GM_ADDR y, GM_ADDR z, uint32_t tilesPerBlock)
    {
        tilesPerBlock_ = tilesPerBlock;
        const uint32_t blockElements = tilesPerBlock * kTileElements;
        const uint32_t offset = AscendC::GetBlockIdx() * blockElements;
        xGm_.SetGlobalBuffer(reinterpret_cast<__gm__ T *>(x) + offset, blockElements);
        yGm_.SetGlobalBuffer(reinterpret_cast<__gm__ T *>(y) + offset, blockElements);
        zGm_.SetGlobalBuffer(reinterpret_cast<__gm__ T *>(z) + offset, blockElements);
        pipe_.InitBuffer(xQueue_, kQueueDepth, kTileElements * sizeof(T));
        pipe_.InitBuffer(yQueue_, kQueueDepth, kTileElements * sizeof(T));
        pipe_.InitBuffer(zQueue_, kQueueDepth, kTileElements * sizeof(T));
    }

    __aicore__ inline void Process()
    {
        for (uint32_t tile = 0; tile < tilesPerBlock_; ++tile) {
            const uint32_t offset = tile * kTileElements;
            CopyIn(offset);
            Compute();
            CopyOut(offset);
        }
    }

private:
    __aicore__ inline void CopyIn(uint32_t offset)
    {
        auto xLocal = xQueue_.AllocTensor<T>();
        auto yLocal = yQueue_.AllocTensor<T>();
        AscendC::DataCopy(xLocal, xGm_[offset], kTileElements);
        AscendC::DataCopy(yLocal, yGm_[offset], kTileElements);
        xQueue_.EnQue(xLocal);
        yQueue_.EnQue(yLocal);
    }

    __aicore__ inline void Compute()
    {
        auto xLocal = xQueue_.DeQue<T>();
        auto yLocal = yQueue_.DeQue<T>();
        auto zLocal = zQueue_.AllocTensor<T>();
        AscendC::Sub(zLocal, xLocal, yLocal, kTileElements);
        zQueue_.EnQue(zLocal);
        xQueue_.FreeTensor(xLocal);
        yQueue_.FreeTensor(yLocal);
    }

    __aicore__ inline void CopyOut(uint32_t offset)
    {
        auto zLocal = zQueue_.DeQue<T>();
        AscendC::DataCopy(zGm_[offset], zLocal, kTileElements);
        zQueue_.FreeTensor(zLocal);
    }

    AscendC::TPipe pipe_;
    AscendC::TQue<AscendC::QuePosition::VECIN, kQueueDepth> xQueue_, yQueue_;
    AscendC::TQue<AscendC::QuePosition::VECOUT, kQueueDepth> zQueue_;
    AscendC::GlobalTensor<T> xGm_, yGm_, zGm_;
    uint32_t tilesPerBlock_;
};
} // namespace

template <typename T>
__global__ __vector__ void sub_custom(GM_ADDR x, GM_ADDR y, GM_ADDR z, uint32_t tilesPerBlock)
{
    KernelSub<T> op;
    op.Init(x, y, z, tilesPerBlock);
    op.Process();
}

extern "C" void run_kernel(GM_ADDR x, const TensorGroupInfo& info_x, GM_ADDR y, const TensorGroupInfo& info_y, GM_ADDR z, const TensorGroupInfo& info_z, int64_t availableCoreNum, aclrtStream stream)
{
    const TensorInfo& input = info_x.tensors[0];
    int64_t totalElements = 1;
    for (int64_t dim = 0; dim < input.numDims; ++dim) {
        totalElements *= input.shape[dim];
    }
    if (availableCoreNum <= 0 || totalElements <= 0 || totalElements % kTileElements != 0) {
        return;
    }

    const uint32_t tileCount = totalElements / kTileElements;
    uint32_t blockDim = availableCoreNum < kMaxBlocks ? availableCoreNum : kMaxBlocks;
    // Choose an even distribution of whole tiles among available vector cores.
    while (tileCount % blockDim != 0) {
        --blockDim;
    }
    const uint32_t tilesPerBlock = tileCount / blockDim;
    if (input.dtype == 0) {
        sub_custom<float><<<blockDim, nullptr, stream>>>(x, y, z, tilesPerBlock);
    } else if (input.dtype == 1) {
        sub_custom<half><<<blockDim, nullptr, stream>>>(x, y, z, tilesPerBlock);
    }
}
