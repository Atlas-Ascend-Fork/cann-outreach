#include "kernel_operator.h"

// ---------------------------------------------------------------------------
// Tiling 参数：所有偏移与分块均在 Host 预计算，消除设备端除法
// ---------------------------------------------------------------------------
struct SubCustomTilingData {
    uint32_t totalLength;  // 有效元素总数
    uint32_t formerNum;    // 大核数量
    uint32_t formerLength; // 大核元素数（32B 对齐）
    uint32_t tailLength;   // 小核元素数（32B 对齐）
    uint32_t formerOffset; // formerNum * formerLength
    uint32_t tileLength;   // 单块最大元素数（32B 对齐）
};

constexpr uint32_t BLOCK_BYTES = 32;
constexpr uint32_t MAX_TILE_BYTES = 44 * 1024; // 44KB × 2输入 × 2缓冲 = 176KB < 192KB UB上限

// ---------------------------------------------------------------------------
// KernelSub：z = x - y（TBuf 零队列开销 + 原位计算 + 单块直通/双缓冲自适应）
// ---------------------------------------------------------------------------
template <typename T>
class KernelSub {
public:
    __aicore__ inline KernelSub() {}

    __aicore__ inline void Init(GM_ADDR x, GM_ADDR y, GM_ADDR z, const SubCustomTilingData& tiling)
    {
        uint32_t blockIdx = AscendC::GetBlockIdx();
        uint32_t coreOffset = 0;

        if (blockIdx < tiling.formerNum) {
            this->coreLength = tiling.formerLength;
            coreOffset = blockIdx * tiling.formerLength;
        } else {
            this->coreLength = tiling.tailLength;
            coreOffset = tiling.formerOffset + (blockIdx - tiling.formerNum) * tiling.tailLength;
        }

        if (coreOffset >= tiling.totalLength) {
            this->validCoreLength = 0;
        } else if (coreOffset + this->coreLength > tiling.totalLength) {
            this->validCoreLength = tiling.totalLength - coreOffset;
        } else {
            this->validCoreLength = this->coreLength;
        }

        this->tileLength = tiling.tileLength;

        xGm.SetGlobalBuffer((__gm__ T*)x + coreOffset, this->coreLength);
        yGm.SetGlobalBuffer((__gm__ T*)y + coreOffset, this->coreLength);
        zGm.SetGlobalBuffer((__gm__ T*)z + coreOffset, this->coreLength);

        uint32_t bufBytes = this->tileLength * sizeof(T);
        pipe.InitBuffer(xBuf0, bufBytes);
        pipe.InitBuffer(yBuf0, bufBytes);
        if (this->coreLength > this->tileLength) {
            pipe.InitBuffer(xBuf1, bufBytes);
            pipe.InitBuffer(yBuf1, bufBytes);
        }
    }

    __aicore__ inline void Process()
    {
        if (this->validCoreLength == 0) {
            return;
        }

        // Fast Path：单块直通（无循环、无 Ping-Pong 分支、原位计算省去 Z 缓冲）
        if (this->coreLength <= this->tileLength) {
            AscendC::LocalTensor<T> xLocal = xBuf0.Get<T>();
            AscendC::LocalTensor<T> yLocal = yBuf0.Get<T>();

            AscendC::DataCopy(xLocal, xGm, this->coreLength);
            AscendC::DataCopy(yLocal, yGm, this->coreLength);

            AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);
            AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);

            AscendC::Sub(xLocal, xLocal, yLocal, this->validCoreLength);

            AscendC::SetFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
            AscendC::WaitFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);

            AscendC::DataCopy(zGm, xLocal, this->coreLength);
            return;
        }

        // 大数据量通用路径：Ping-Pong 双缓冲流水线
        uint32_t offset = 0;
        uint32_t tileIdx = 0;
        while (offset < this->coreLength) {
            uint32_t rem = this->coreLength - offset;
            uint32_t copyLen = (rem < this->tileLength) ? rem : this->tileLength;
            uint32_t validLen = (offset >= this->validCoreLength)
                                    ? 0
                                    : ((this->validCoreLength - offset < copyLen) ? (this->validCoreLength - offset) : copyLen);

            if ((tileIdx & 1) == 0) {
                if (tileIdx >= 2) {
                    AscendC::WaitFlag<AscendC::HardEvent::MTE3_MTE2>(EVENT_ID0);
                }
                AscendC::LocalTensor<T> xLocal = xBuf0.Get<T>();
                AscendC::LocalTensor<T> yLocal = yBuf0.Get<T>();

                AscendC::DataCopy(xLocal, xGm[offset], copyLen);
                AscendC::DataCopy(yLocal, yGm[offset], copyLen);
                AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);

                AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);
                if (validLen > 0) {
                    AscendC::Sub(xLocal, xLocal, yLocal, validLen);
                }
                AscendC::SetFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);

                AscendC::WaitFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
                AscendC::DataCopy(zGm[offset], xLocal, copyLen);
                AscendC::SetFlag<AscendC::HardEvent::MTE3_MTE2>(EVENT_ID0);
            } else {
                if (tileIdx >= 2) {
                    AscendC::WaitFlag<AscendC::HardEvent::MTE3_MTE2>(EVENT_ID1);
                }
                AscendC::LocalTensor<T> xLocal = xBuf1.Get<T>();
                AscendC::LocalTensor<T> yLocal = yBuf1.Get<T>();

                AscendC::DataCopy(xLocal, xGm[offset], copyLen);
                AscendC::DataCopy(yLocal, yGm[offset], copyLen);
                AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID1);

                AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID1);
                if (validLen > 0) {
                    AscendC::Sub(xLocal, xLocal, yLocal, validLen);
                }
                AscendC::SetFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID1);

                AscendC::WaitFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID1);
                AscendC::DataCopy(zGm[offset], xLocal, copyLen);
                AscendC::SetFlag<AscendC::HardEvent::MTE3_MTE2>(EVENT_ID1);
            }

            offset += this->tileLength;
            tileIdx++;
        }

        if (tileIdx >= 1) {
            AscendC::WaitFlag<AscendC::HardEvent::MTE3_MTE2>(EVENT_ID0);
        }
        if (tileIdx >= 2) {
            AscendC::WaitFlag<AscendC::HardEvent::MTE3_MTE2>(EVENT_ID1);
        }
    }

private:
    AscendC::TPipe pipe;
    AscendC::TBuf<AscendC::TPosition::VECCALC> xBuf0, yBuf0, xBuf1, yBuf1;
    AscendC::GlobalTensor<T> xGm, yGm, zGm;

    uint32_t coreLength;
    uint32_t validCoreLength;
    uint32_t tileLength;
};

// ---------------------------------------------------------------------------
// 核函数入口
// ---------------------------------------------------------------------------
template <typename T>
__global__ __vector__ void sub_custom(GM_ADDR x, GM_ADDR y, GM_ADDR z, SubCustomTilingData tiling)
{
    KernelSub<T> op;
    op.Init(x, y, z, tiling);
    op.Process();
}

// ---------------------------------------------------------------------------
// Host 侧 Tiling 计算与核函数启动
// ---------------------------------------------------------------------------
template <typename T>
static inline void LaunchSubKernel(GM_ADDR x, GM_ADDR y, GM_ADDR z, uint32_t totalLength, int64_t availableCoreNum, aclrtStream stream)
{
    constexpr uint32_t alignNum = BLOCK_BYTES / sizeof(T);
    constexpr uint32_t maxTileElements = MAX_TILE_BYTES / sizeof(T);
    constexpr uint32_t minElementsPerCore = 2048; // 保证单核至少 4KB~8KB 突发搬运，避免小数据多核过度拆分
    constexpr uint32_t minBlocksPerCore = minElementsPerCore / alignNum;

    uint32_t totalBlocks = (totalLength + alignNum - 1) / alignNum;
    uint32_t maxUsefulCores = (totalBlocks + minBlocksPerCore - 1) / minBlocksPerCore;
    if (maxUsefulCores == 0) {
        maxUsefulCores = 1;
    }

    uint32_t blockDim = (availableCoreNum > 0) ? static_cast<uint32_t>(availableCoreNum) : 1;
    if (blockDim > maxUsefulCores) {
        blockDim = maxUsefulCores;
    }

    uint32_t formerNum = totalBlocks % blockDim;
    uint32_t tailBlocks = totalBlocks / blockDim;
    uint32_t formerBlocks = (formerNum > 0) ? (tailBlocks + 1) : tailBlocks;

    uint32_t formerLength = formerBlocks * alignNum;
    uint32_t tailLength = tailBlocks * alignNum;
    uint32_t formerOffset = formerNum * formerLength;

    uint32_t maxCoreLength = (formerNum > 0) ? formerLength : tailLength;
    uint32_t tileLength = (maxCoreLength < maxTileElements) ? maxCoreLength : maxTileElements;

    SubCustomTilingData tiling = {totalLength, formerNum, formerLength, tailLength, formerOffset, tileLength};
    sub_custom<T><<<blockDim, nullptr, stream>>>(x, y, z, tiling);
}

extern "C" void run_kernel(GM_ADDR x, const TensorGroupInfo& info_x, GM_ADDR y, const TensorGroupInfo& info_y, GM_ADDR z, const TensorGroupInfo& info_z, int64_t availableCoreNum, aclrtStream stream)
{
    const TensorInfo& t0 = info_x.tensors[0];
    int64_t totalLength = 1;
    for (int64_t i = 0; i < t0.numDims; i++) {
        totalLength *= t0.shape[i];
    }
    if (totalLength <= 0) {
        return;
    }

    if (t0.dtype == 1) {
        LaunchSubKernel<half>(x, y, z, static_cast<uint32_t>(totalLength), availableCoreNum, stream);
    } else {
        LaunchSubKernel<float>(x, y, z, static_cast<uint32_t>(totalLength), availableCoreNum, stream);
    }
}