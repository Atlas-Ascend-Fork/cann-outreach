#include "kernel_operator.h"

namespace {
// Set to 2 for float16 or 4 for float32.
constexpr uint32_t PADDED_TYPE_BYTES = 2;
constexpr uint32_t BLOCK_COUNT = 8;
constexpr uint32_t ELEMENTS_PER_BLOCK = 2048;
}

template <typename T>
__global__ __vector__ void sub_custom(GM_ADDR x, GM_ADDR y, GM_ADDR z)
{
    AscendC::InitSocState();

    const uint32_t offset = AscendC::GetBlockIdx() * ELEMENTS_PER_BLOCK;
    AscendC::GlobalTensor<T> xGm, yGm, zGm;
    xGm.SetGlobalBuffer(reinterpret_cast<__gm__ T *>(x) + offset, ELEMENTS_PER_BLOCK);
    yGm.SetGlobalBuffer(reinterpret_cast<__gm__ T *>(y) + offset, ELEMENTS_PER_BLOCK);
    zGm.SetGlobalBuffer(reinterpret_cast<__gm__ T *>(z) + offset, ELEMENTS_PER_BLOCK);

    constexpr uint32_t bufferBytes = ELEMENTS_PER_BLOCK * sizeof(T);
    constexpr uint32_t eventId = 0;
    static_assert(bufferBytes % 32 == 0, "UB buffers must be 32-byte aligned");
    AscendC::LocalTensor<T> xLocal(AscendC::TPosition::VECCALC, 0, ELEMENTS_PER_BLOCK);
    // Stagger the input addresses by one UB data block.
    constexpr uint32_t yOffset = bufferBytes + (sizeof(T) == PADDED_TYPE_BYTES ? 32 : 0);
    AscendC::LocalTensor<T> yLocal(AscendC::TPosition::VECCALC, yOffset, ELEMENTS_PER_BLOCK);
    AscendC::LocalTensor<T> zLocal(AscendC::TPosition::VECCALC, yOffset + bufferBytes, ELEMENTS_PER_BLOCK);

    AscendC::DataCopy(xLocal, xGm, ELEMENTS_PER_BLOCK);
    AscendC::DataCopy(yLocal, yGm, ELEMENTS_PER_BLOCK);
    AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(eventId);
    AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(eventId);

    constexpr uint64_t elementsPerRepeat = 256 / sizeof(T);
    constexpr uint8_t repeatCount = ELEMENTS_PER_BLOCK / elementsPerRepeat;
    const AscendC::BinaryRepeatParams strides = {1, 1, 1, 8, 8, 8};
    static_assert(ELEMENTS_PER_BLOCK % elementsPerRepeat == 0, "Full repeats required");
    AscendC::Sub(zLocal, xLocal, yLocal, elementsPerRepeat, repeatCount, strides);
    AscendC::SetFlag<AscendC::HardEvent::V_MTE3>(eventId);
    AscendC::WaitFlag<AscendC::HardEvent::V_MTE3>(eventId);
    AscendC::DataCopy(zGm, zLocal, ELEMENTS_PER_BLOCK);
}

extern "C" void run_kernel(GM_ADDR x, const TensorGroupInfo& info_x,
                           GM_ADDR y, const TensorGroupInfo& info_y,
                           GM_ADDR z, const TensorGroupInfo& info_z,
                           int64_t availableCoreNum, aclrtStream stream)
{
    if (info_x.tensors[0].dtype == 1) {
        sub_custom<half><<<BLOCK_COUNT, nullptr, stream>>>(x, y, z);
    } else {
        sub_custom<float><<<BLOCK_COUNT, nullptr, stream>>>(x, y, z);
    }
}
