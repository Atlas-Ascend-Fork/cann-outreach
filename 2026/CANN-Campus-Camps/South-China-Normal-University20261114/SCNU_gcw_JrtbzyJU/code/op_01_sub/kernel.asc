#include <cmath>
#include "kernel_operator.h"

struct SubCustomTilingData {
    uint32_t totalLength;  // 整个张量的元素个数
    uint32_t tileNum;      // 每核循环处理 tileNum * kSubBufferNum 次
};

constexpr uint32_t kSubBufferNum = 2;

template <typename T>
class KernelSub {
public:
    __aicore__ inline void Init(GM_ADDR x, GM_ADDR y, GM_ADDR z,
                               const SubCustomTilingData& tiling)
    {
        const uint32_t blockLength = tiling.totalLength / AscendC::GetBlockNum();
        const uint32_t offset = AscendC::GetBlockIdx() * blockLength;
        tileCount = tiling.tileNum * kSubBufferNum;
        tileLength = blockLength / tileCount;

        xGm.SetGlobalBuffer((__gm__ T*)x + offset, blockLength);
        yGm.SetGlobalBuffer((__gm__ T*)y + offset, blockLength);
        zGm.SetGlobalBuffer((__gm__ T*)z + offset, blockLength);

        pipe.InitBuffer(inQueueX, kSubBufferNum, tileLength * sizeof(T));
        pipe.InitBuffer(inQueueY, kSubBufferNum, tileLength * sizeof(T));
        pipe.InitBuffer(outQueueZ, kSubBufferNum, tileLength * sizeof(T));
    }

    __aicore__ inline void Process()
    {
        for (uint32_t tile = 0; tile < tileCount; ++tile) {
            const uint32_t offset = tile * tileLength;
            CopyIn(offset);
            Compute();
            CopyOut(offset);
        }
    }

private:
    __aicore__ inline void CopyIn(uint32_t offset)
    {
        AscendC::LocalTensor<T> xLocal = inQueueX.AllocTensor<T>();
        AscendC::LocalTensor<T> yLocal = inQueueY.AllocTensor<T>();
        AscendC::DataCopy(xLocal, xGm[offset], tileLength);
        AscendC::DataCopy(yLocal, yGm[offset], tileLength);
        inQueueX.EnQue(xLocal);
        inQueueY.EnQue(yLocal);
    }

    __aicore__ inline void Compute()
    {
        AscendC::LocalTensor<T> xLocal = inQueueX.DeQue<T>();
        AscendC::LocalTensor<T> yLocal = inQueueY.DeQue<T>();
        AscendC::LocalTensor<T> zLocal = outQueueZ.AllocTensor<T>();

        AscendC::Sub(zLocal, xLocal, yLocal, tileLength);

        outQueueZ.EnQue(zLocal);
        inQueueX.FreeTensor(xLocal);
        inQueueY.FreeTensor(yLocal);
    }

    __aicore__ inline void CopyOut(uint32_t offset)
    {
        AscendC::LocalTensor<T> zLocal = outQueueZ.DeQue<T>();
        AscendC::DataCopy(zGm[offset], zLocal, tileLength);
        outQueueZ.FreeTensor(zLocal);
    }

    AscendC::TPipe pipe;
    AscendC::TQue<AscendC::QuePosition::VECIN, 1> inQueueX, inQueueY;
    AscendC::TQue<AscendC::QuePosition::VECOUT, 1> outQueueZ;
    AscendC::GlobalTensor<T> xGm, yGm, zGm;
    uint32_t tileCount;
    uint32_t tileLength;
};

template <typename T>
__global__ __vector__ void sub_custom(GM_ADDR x, GM_ADDR y, GM_ADDR z,
                                      SubCustomTilingData tiling)
{
    KernelSub<T> op;
    op.Init(x, y, z, tiling);
    op.Process();
}

extern "C" void run_kernel(GM_ADDR x, const TensorGroupInfo& info_x,
                           GM_ADDR y, const TensorGroupInfo& info_y,
                           GM_ADDR z, const TensorGroupInfo& info_z,
                           int64_t availableCoreNum, aclrtStream stream)
{
    if (availableCoreNum < 1) {
        return;
    }

    // 取不超过可用核数的最大选项（1、2、4 或 8）。
    // 对题目固定形状 (8, 2048)，每种选项都能整除。
    uint32_t blockNum = 1;
    while (blockNum < 8 && blockNum * 2 <= availableCoreNum) {
        blockNum *= 2;
    }

    const TensorInfo& tensor = info_x.tensors[0];
    int64_t totalLength = 1;
    for (int64_t i = 0; i < tensor.numDims; ++i) {
        totalLength *= tensor.shape[i];
    }
    const SubCustomTilingData tiling{static_cast<uint32_t>(totalLength), 8};

    if (tensor.dtype == 0) {
        sub_custom<float><<<blockNum, nullptr, stream>>>(x, y, z, tiling);
    } else if (tensor.dtype == 1) {
        sub_custom<half><<<blockNum, nullptr, stream>>>(x, y, z, tiling);
    }
}
