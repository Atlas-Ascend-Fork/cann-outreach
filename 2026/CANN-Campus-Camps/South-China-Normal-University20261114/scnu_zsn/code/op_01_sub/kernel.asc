#include <cmath>
#include "kernel_operator.h"

using namespace AscendC;

constexpr int32_t BUFFER_NUM = 2;
constexpr int32_t ALIGN_BYTES = 32; // NPU 搬运数据需要 32 字节对齐

// 模板函数：处理具体的减法逻辑
template <typename T>
__aicore__ inline void ProcessSub(GM_ADDR x, GM_ADDR y, GM_ADDR z, uint32_t totalLength, uint32_t blockNum, TPipe* pipe)
{
    // 1. 计算每个核处理的数据量 (32字节对齐)
    uint32_t alignElements = ALIGN_BYTES / sizeof(T);
    uint32_t lengthPerBlock = totalLength / blockNum;
    lengthPerBlock = (lengthPerBlock / alignElements) * alignElements; // 向下取整对齐
    if (lengthPerBlock == 0) lengthPerBlock = alignElements;

    // 2. 计算尾部剩余数据（放在最后一个核处理，防止漏算）
    uint32_t blockIdx = GetBlockIdx();
    uint32_t startOffset = blockIdx * lengthPerBlock;
    uint32_t currentLength = lengthPerBlock;
    
    if (blockIdx == blockNum - 1) {
        currentLength = totalLength - startOffset;
    } else if (startOffset + currentLength > totalLength) {
        currentLength = 0; // 越界保护
    }

    if (currentLength == 0) return;

    // 3. 初始化 GlobalTensor (带偏移)
    GlobalTensor<T> xGm, yGm, zGm;
    xGm.SetGlobalBuffer((__gm__ T*)x + startOffset, currentLength);
    yGm.SetGlobalBuffer((__gm__ T*)y + startOffset, currentLength);
    zGm.SetGlobalBuffer((__gm__ T*)z + startOffset, currentLength);

    // 4. 设置 Tile 大小 (满足32字节对齐)
    uint32_t tileLength = currentLength;
    if (tileLength > 8192) {
        tileLength = 8192 / sizeof(T); // 限制单次搬运最大 8KB
    }
    tileLength = (tileLength / alignElements) * alignElements;
    if (tileLength == 0) tileLength = alignElements;

    uint32_t tileNum = currentLength / tileLength;
    uint32_t lastTileLength = currentLength % tileLength;

    // 5. 初始化队列
    TQue<QuePosition::VECIN, 1> inQueueX, inQueueY;
    TQue<QuePosition::VECOUT, 1> outQueueZ;
    
    pipe->InitBuffer(inQueueX, BUFFER_NUM, tileLength * sizeof(T));
    pipe->InitBuffer(inQueueY, BUFFER_NUM, tileLength * sizeof(T));
    pipe->InitBuffer(outQueueZ, BUFFER_NUM, tileLength * sizeof(T));

    // 6. 循环搬运与计算
    for (uint32_t i = 0; i < tileNum; i++) {
        LocalTensor<T> xLocal = inQueueX.AllocTensor<T>();
        LocalTensor<T> yLocal = inQueueY.AllocTensor<T>();
        LocalTensor<T> zLocal = outQueueZ.AllocTensor<T>();

        DataCopy(xLocal, xGm[i * tileLength], tileLength);
        DataCopy(yLocal, yGm[i * tileLength], tileLength);
        inQueueX.EnQue(xLocal);
        inQueueY.EnQue(yLocal);

        xLocal = inQueueX.DeQue<T>();
        yLocal = inQueueY.DeQue<T>();
        
        Sub(zLocal, xLocal, yLocal, tileLength);
        
        outQueueZ.EnQue<T>(zLocal);
        inQueueX.FreeTensor(xLocal);
        inQueueY.FreeTensor(yLocal);

        zLocal = outQueueZ.DeQue<T>();
        DataCopy(zGm[i * tileLength], zLocal, tileLength);
        outQueueZ.FreeTensor(zLocal);
    }

    // 7. 处理最后一块除不尽的尾巴数据
    if (lastTileLength > 0) {
        LocalTensor<T> xLocal = inQueueX.AllocTensor<T>();
        LocalTensor<T> yLocal = inQueueY.AllocTensor<T>();
        LocalTensor<T> zLocal = outQueueZ.AllocTensor<T>();

        // 尾块由于可能不对齐，使用 DataCopyPad
        DataCopyPadExtParams<T> padParams{false, 0, 0, 0};
        DataCopyExtParams copyParamsX{1, static_cast<uint32_t>(lastTileLength * sizeof(T)), 0, 0, 0};
        DataCopyExtParams copyParamsY{1, static_cast<uint32_t>(lastTileLength * sizeof(T)), 0, 0, 0};
        DataCopyExtParams copyParamsZ{1, static_cast<uint32_t>(lastTileLength * sizeof(T)), 0, 0, 0};

        DataCopyPad(xLocal, xGm[tileNum * tileLength], copyParamsX, padParams);
        DataCopyPad(yLocal, yGm[tileNum * tileLength], copyParamsY, padParams);
        inQueueX.EnQue(xLocal);
        inQueueY.EnQue(yLocal);

        xLocal = inQueueX.DeQue<T>();
        yLocal = inQueueY.DeQue<T>();
        
        Sub(zLocal, xLocal, yLocal, lastTileLength);
        
        outQueueZ.EnQue<T>(zLocal);
        inQueueX.FreeTensor(xLocal);
        inQueueY.FreeTensor(yLocal);

        zLocal = outQueueZ.DeQue<T>();
        DataCopyPad(zGm[tileNum * tileLength], zLocal, copyParamsZ);
        outQueueZ.FreeTensor(zLocal);
    }
}

// 核函数入口
extern "C" __global__ __aicore__ void sub_custom(GM_ADDR x, GM_ADDR y, GM_ADDR z, uint32_t totalLength, uint32_t blockNum, uint32_t dtype)
{
    TPipe pipe;
    if (dtype == 0) { // float32
        ProcessSub<float>(x, y, z, totalLength, blockNum, &pipe);
    } else if (dtype == 1) { // float16
        ProcessSub<half>(x, y, z, totalLength, blockNum, &pipe);
    }
}

// Host 侧启动接口 (完全匹配平台 8 参数)
extern "C" void run_kernel(
    GM_ADDR x, const TensorGroupInfo& info_x,
    GM_ADDR y, const TensorGroupInfo& info_y,
    GM_ADDR z, const TensorGroupInfo& info_z,
    uint32_t availableCoreNum, void* stream)
{
    uint32_t totalLength = 1;
    for (int i = 0; i < info_x.tensors[0].numDims; ++i) {
        totalLength *= info_x.tensors[0].shape[i];
    }

    // 动态获取数据类型
    uint32_t dtype = info_x.tensors[0].dtype;
    
    // 限制启动的核数，如果数据量太小，减少核数防浪费
    uint32_t blockNum = availableCoreNum;
    if (totalLength < blockNum * 32) {
        blockNum = (totalLength / 32) > 0 ? (totalLength / 32) : 1;
    }

    // 启动核函数，传入 6 个参数
    sub_custom<<<blockNum, nullptr, stream>>>(x, y, z, totalLength, blockNum, dtype);
}