#include <cstdint>
#include "kernel_operator.h"
/*
 * Sub Kernel — Ascend C Direct Invocation
 * This file is #included — do NOT add main(), #pragma once, or include guards.
 *
 * TensorGroupInfo / TensorInfo (predefined):
 *   struct TensorInfo { const int64_t* shape; int64_t numDims; int32_t dtype; };
 *   struct TensorGroupInfo { const TensorInfo* tensors; int64_t numTensors; };
 *   dtype: 0=fp32 1=fp16 2=bf16 3=int8 4=int16 5=int32 6=int64 7=uint8 8=uint16 9=uint32 10=uint64 11=bool
 *   Usage: info_x.tensors[0].shape[0]  // first dim of first tensor in input x
 */

constexpr uint32_t SUB_TILE_LENGTH = 2048;
constexpr uint32_t SUB_TILE_COUNT = 8;
constexpr uint32_t SUB_TOTAL_LENGTH = SUB_TILE_LENGTH * SUB_TILE_COUNT;

template <typename T>
class SubKernel {
public:
    __aicore__ inline void Init(GM_ADDR x, GM_ADDR y, GM_ADDR z)
    {
        xGm_.SetGlobalBuffer((__gm__ T*)x, SUB_TOTAL_LENGTH);
        yGm_.SetGlobalBuffer((__gm__ T*)y, SUB_TOTAL_LENGTH);
        zGm_.SetGlobalBuffer((__gm__ T*)z, SUB_TOTAL_LENGTH);

        pipe_.InitBuffer(xQueue_, 1, SUB_TILE_LENGTH * sizeof(T));
        pipe_.InitBuffer(yQueue_, 1, SUB_TILE_LENGTH * sizeof(T));
        pipe_.InitBuffer(zQueue_, 1, SUB_TILE_LENGTH * sizeof(T));
    }

    __aicore__ inline void Process()
    {
        for (uint32_t tile = AscendC::GetBlockIdx(); tile < SUB_TILE_COUNT;
             tile += AscendC::GetBlockNum()) {
            const uint32_t offset = tile * SUB_TILE_LENGTH;
            CopyIn(offset);
            Compute();
            CopyOut(offset);
        }
    }

private:
    __aicore__ inline void CopyIn(uint32_t offset)
    {
        AscendC::LocalTensor<T> xLocal = xQueue_.AllocTensor<T>();
        AscendC::LocalTensor<T> yLocal = yQueue_.AllocTensor<T>();
        AscendC::DataCopy(xLocal, xGm_[offset], SUB_TILE_LENGTH);
        AscendC::DataCopy(yLocal, yGm_[offset], SUB_TILE_LENGTH);
        xQueue_.EnQue(xLocal);
        yQueue_.EnQue(yLocal);
    }

    __aicore__ inline void Compute()
    {
        AscendC::LocalTensor<T> xLocal = xQueue_.DeQue<T>();
        AscendC::LocalTensor<T> yLocal = yQueue_.DeQue<T>();
        AscendC::LocalTensor<T> zLocal = zQueue_.AllocTensor<T>();
        AscendC::Sub(zLocal, xLocal, yLocal, SUB_TILE_LENGTH);
        zQueue_.EnQue(zLocal);
        xQueue_.FreeTensor(xLocal);
        yQueue_.FreeTensor(yLocal);
    }

    __aicore__ inline void CopyOut(uint32_t offset)
    {
        AscendC::LocalTensor<T> zLocal = zQueue_.DeQue<T>();
        AscendC::DataCopy(zGm_[offset], zLocal, SUB_TILE_LENGTH);
        zQueue_.FreeTensor(zLocal);
    }

    AscendC::TPipe pipe_;
    AscendC::TQue<AscendC::QuePosition::VECIN, 1> xQueue_;
    AscendC::TQue<AscendC::QuePosition::VECIN, 1> yQueue_;
    AscendC::TQue<AscendC::QuePosition::VECOUT, 1> zQueue_;
    AscendC::GlobalTensor<T> xGm_;
    AscendC::GlobalTensor<T> yGm_;
    AscendC::GlobalTensor<T> zGm_;
};

template <typename T>
__global__ __vector__ void sub_custom(GM_ADDR x, GM_ADDR y, GM_ADDR z)
{
    SubKernel<T> op;
    op.Init(x, y, z);
    op.Process();
}

extern "C" void run_kernel(GM_ADDR x, const TensorGroupInfo& info_x, GM_ADDR y, const TensorGroupInfo& info_y, GM_ADDR z, const TensorGroupInfo& info_z, int64_t availableCoreNum, aclrtStream stream)
{
    if (availableCoreNum <= 0 || info_x.numTensors != 1 ||
        info_y.numTensors != 1 || info_z.numTensors != 1) {
        return;
    }

    const int32_t dtype = info_x.tensors[0].dtype;
    if (info_y.tensors[0].dtype != dtype || info_z.tensors[0].dtype != dtype) {
        return;
    }

    const uint32_t blockNum = availableCoreNum < SUB_TILE_COUNT
        ? static_cast<uint32_t>(availableCoreNum) : SUB_TILE_COUNT;
    if (dtype == 0) {
        sub_custom<float><<<blockNum, nullptr, stream>>>(x, y, z);
    } else if (dtype == 1) {
        sub_custom<half><<<blockNum, nullptr, stream>>>(x, y, z);
    }
}