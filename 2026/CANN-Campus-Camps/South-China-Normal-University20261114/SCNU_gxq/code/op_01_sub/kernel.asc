#include <cmath>
#include "kernel_operator.h"

// ============================================================
// 1. Tiling 参数结构体
// ============================================================

struct SubCustomTilingData {
    uint32_t totalLength;
    uint32_t tileNum;
};

// 恢复 V1 原始参数
constexpr uint32_t BUFFER_NUM = 2;
constexpr uint32_t QUEUE_DEPTH = 1;


// ============================================================
// 2. KernelSub：矢量减法算子
// ============================================================

template <typename T>
class KernelSub {
public:

    __aicore__ inline KernelSub() {}

    // --------------------------------------------------------
    // 初始化函数
    // --------------------------------------------------------

    __aicore__ inline void Init(
        GM_ADDR x,
        GM_ADDR y,
        GM_ADDR z,
        const SubCustomTilingData& tiling,
        AscendC::TPipe* pipeIn
    )
    {
        // 使用外部传入的 TPipe
        pipe = pipeIn;

        uint32_t totalLength = tiling.totalLength;
        uint32_t tileNum = tiling.tileNum;

        // 计算每个计算核负责的数据长度
        this->blockLength =
            totalLength / AscendC::GetBlockNum();

        // 每个计算核内部的分块数量
        this->tileNum = tileNum;

        // 计算每个数据块的元素数量
        this->tileLength =
            this->blockLength / tileNum / BUFFER_NUM;

        // 设置 Global Memory 地址
        xGm.SetGlobalBuffer(
            (__gm__ T*)x +
            this->blockLength * AscendC::GetBlockIdx(),
            this->blockLength
        );

        yGm.SetGlobalBuffer(
            (__gm__ T*)y +
            this->blockLength * AscendC::GetBlockIdx(),
            this->blockLength
        );

        zGm.SetGlobalBuffer(
            (__gm__ T*)z +
            this->blockLength * AscendC::GetBlockIdx(),
            this->blockLength
        );

        // 初始化输入输出队列
        pipe->InitBuffer(
            inQueueX,
            BUFFER_NUM,
            this->tileLength * sizeof(T)
        );

        pipe->InitBuffer(
            inQueueY,
            BUFFER_NUM,
            this->tileLength * sizeof(T)
        );

        pipe->InitBuffer(
            outQueueZ,
            BUFFER_NUM,
            this->tileLength * sizeof(T)
        );
    }


    // --------------------------------------------------------
    // 数据处理流程
    // --------------------------------------------------------

    __aicore__ inline void Process()
    {
        // 每个核处理的总分块数量
        int32_t loopCount = this->tileNum * BUFFER_NUM;

        for (int32_t i = 0; i < loopCount; i++) {

            CopyIn(i);

            Compute();

            CopyOut(i);
        }
    }


private:

    // ========================================================
    // 3. CopyIn：数据搬入
    // ========================================================

    __aicore__ inline void CopyIn(int32_t progress)
    {
        // 申请输入张量的 LocalTensor
        AscendC::LocalTensor<T> xLocal =
            inQueueX.AllocTensor<T>();

        AscendC::LocalTensor<T> yLocal =
            inQueueY.AllocTensor<T>();

        // 从 Global Memory 搬运数据
        AscendC::DataCopy(
            xLocal,
            xGm[progress * this->tileLength],
            this->tileLength
        );

        AscendC::DataCopy(
            yLocal,
            yGm[progress * this->tileLength],
            this->tileLength
        );

        // 输入队列入队
        inQueueX.EnQue(xLocal);
        inQueueY.EnQue(yLocal);
    }


    // ========================================================
    // 4. Compute：执行矢量减法
    // ========================================================

    __aicore__ inline void Compute()
    {
        // 从输入队列取出数据
        AscendC::LocalTensor<T> xLocal =
            inQueueX.DeQue<T>();

        AscendC::LocalTensor<T> yLocal =
            inQueueY.DeQue<T>();

        // 申请输出张量
        AscendC::LocalTensor<T> zLocal =
            outQueueZ.AllocTensor<T>();

        // 核心计算：z = x - y
        AscendC::Sub(
            zLocal,
            xLocal,
            yLocal,
            this->tileLength
        );

        // 输出队列入队
        outQueueZ.EnQue<T>(zLocal);

        // 释放输入内存
        inQueueX.FreeTensor(xLocal);
        inQueueY.FreeTensor(yLocal);
    }


    // ========================================================
    // 5. CopyOut：数据搬出
    // ========================================================

    __aicore__ inline void CopyOut(int32_t progress)
    {
        // 从输出队列获取计算结果
        AscendC::LocalTensor<T> zLocal =
            outQueueZ.DeQue<T>();

        // 写回 Global Memory
        AscendC::DataCopy(
            zGm[progress * this->tileLength],
            zLocal,
            this->tileLength
        );

        // 释放输出内存
        outQueueZ.FreeTensor(zLocal);
    }


private:

    // TPipe 改为指针，不再作为类内对象创建
    AscendC::TPipe* pipe;

    // 输入输出队列
    AscendC::TQue<AscendC::QuePosition::VECIN, QUEUE_DEPTH>
        inQueueX, inQueueY;

    AscendC::TQue<AscendC::QuePosition::VECOUT, QUEUE_DEPTH>
        outQueueZ;

    // 全局内存张量
    AscendC::GlobalTensor<T> xGm;
    AscendC::GlobalTensor<T> yGm;
    AscendC::GlobalTensor<T> zGm;

    // 分块参数
    uint32_t blockLength;
    uint32_t tileNum;
    uint32_t tileLength;
};


// ============================================================
// 6. Kernel 核函数入口
// ============================================================

template <typename T>
__global__ __vector__ void sub_custom(
    GM_ADDR x,
    GM_ADDR y,
    GM_ADDR z,
    SubCustomTilingData tiling
)
{
    // 在算子类外部创建 TPipe
    AscendC::TPipe pipe;

    // 创建算子对象
    KernelSub<T> op;

    // 将 TPipe 指针传入算子
    op.Init(
        x,
        y,
        z,
        tiling,
        &pipe
    );

    // 执行算子
    op.Process();
}


// ============================================================
// 7. Host 侧启动函数
// ============================================================

extern "C" void run_kernel(
    GM_ADDR x,
    const TensorGroupInfo& info_x,
    GM_ADDR y,
    const TensorGroupInfo& info_y,
    GM_ADDR z,
    const TensorGroupInfo& info_z,
    int64_t availableCoreNum,
    aclrtStream stream
)
{
    // 使用 8 个计算核
    constexpr uint32_t blockDim = 8;

    // 获取输入张量信息
    const TensorInfo& t0 = info_x.tensors[0];

    // 计算输入张量总元素数量
    int64_t totalLength = 1;

    for (int64_t i = 0; i < t0.numDims; i++) {
        totalLength *= t0.shape[i];
    }

    // 获取输入数据类型
    int32_t dtype = t0.dtype;

    // 恢复 V1 原始分块参数
    uint32_t tileNum = 8;

    // 构造 Tiling 参数
    SubCustomTilingData tiling = {
        (uint32_t)totalLength,
        tileNum
    };

    // 根据数据类型启动对应的 Kernel
    if (dtype == 1) {

        // float16
        sub_custom<half><<<blockDim, nullptr, stream>>>(
            x,
            y,
            z,
            tiling
        );

    } else {

        // float32
        sub_custom<float><<<blockDim, nullptr, stream>>>(
            x,
            y,
            z,
            tiling
        );
    }
}