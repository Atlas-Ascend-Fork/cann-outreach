#include <cmath>
#include "kernel_operator.h"

// ---------------------------------------------------------------------------
// Tiling 参数：由 host 侧 run_kernel 计算后按值传给核函数
// ---------------------------------------------------------------------------
struct SubCustomTilingData {
    uint32_t totalLength; // 待处理数据总长度，单位：元素个数
    uint32_t tileNum;     // 单核内的分块参数
};

constexpr uint32_t BUFFER_NUM = 2;   // 每个队列分配的 buffer 数量
constexpr uint32_t QUEUE_DEPTH = 1;

// ---------------------------------------------------------------------------
// KernelSub：z = x - y，每核分块循环计算，支持 float / half
// ---------------------------------------------------------------------------
template <typename T>
class KernelSub {
public:
    __aicore__ inline KernelSub() {}

    __aicore__ inline void Init(
        GM_ADDR x,
        GM_ADDR y,
        GM_ADDR z,
        const SubCustomTilingData& tiling)
    {
        // 计算每个核处理的数据长度
        this->blockLength = tiling.totalLength / AscendC::GetBlockNum();
        this->tileNum = tiling.tileNum;

        // 每次循环处理的元素数
        this->tileLength =
            this->blockLength / this->tileNum / BUFFER_NUM;

        // 设置当前核对应的 Global Memory 区间
        xGm.SetGlobalBuffer(
            (__gm__ T*)x + this->blockLength * AscendC::GetBlockIdx(),
            this->blockLength);

        yGm.SetGlobalBuffer(
            (__gm__ T*)y + this->blockLength * AscendC::GetBlockIdx(),
            this->blockLength);

        zGm.SetGlobalBuffer(
            (__gm__ T*)z + this->blockLength * AscendC::GetBlockIdx(),
            this->blockLength);

        // 为输入、输出队列分配 UB 内存
        pipe.InitBuffer(
            inQueueX, BUFFER_NUM, this->tileLength * sizeof(T));
        pipe.InitBuffer(
            inQueueY, BUFFER_NUM, this->tileLength * sizeof(T));
        pipe.InitBuffer(
            outQueueZ, BUFFER_NUM, this->tileLength * sizeof(T));
    }

    __aicore__ inline void Process()
    {
        // tileLength 已按 BUFFER_NUM 折半
        int32_t loopCount = this->tileNum * BUFFER_NUM;

        for (int32_t i = 0; i < loopCount; i++) {
            CopyIn(i);
            Compute(i);
            CopyOut(i);
        }
    }

private:
    __aicore__ inline void CopyIn(int32_t progress)
    {
        // 分配输入 LocalTensor
        AscendC::LocalTensor<T> xLocal = inQueueX.AllocTensor<T>();
        AscendC::LocalTensor<T> yLocal = inQueueY.AllocTensor<T>();

        // 将当前数据块从 GM 搬入 UB
        AscendC::DataCopy(
            xLocal, xGm[progress * this->tileLength], this->tileLength);
        AscendC::DataCopy(
            yLocal, yGm[progress * this->tileLength], this->tileLength);

        // 输入数据入队，供 Compute 使用
        inQueueX.EnQue(xLocal);
        inQueueY.EnQue(yLocal);
    }

    __aicore__ inline void Compute(int32_t progress)
    {
        // 获取输入数据
        AscendC::LocalTensor<T> xLocal = inQueueX.DeQue<T>();
        AscendC::LocalTensor<T> yLocal = inQueueY.DeQue<T>();

        // 分配输出 LocalTensor
        AscendC::LocalTensor<T> zLocal = outQueueZ.AllocTensor<T>();

        // 执行逐元素减法：z = x - y
        AscendC::Sub(zLocal, xLocal, yLocal, this->tileLength);

        // 计算结果入队，供 CopyOut 使用
        outQueueZ.EnQue<T>(zLocal);

        // 释放输入 LocalTensor
        inQueueX.FreeTensor(xLocal);
        inQueueY.FreeTensor(yLocal);
    }

    __aicore__ inline void CopyOut(int32_t progress)
    {
        // 获取计算结果
        AscendC::LocalTensor<T> zLocal = outQueueZ.DeQue<T>();

        // 将结果从 UB 搬出到 GM
        AscendC::DataCopy(
            zGm[progress * this->tileLength], zLocal, this->tileLength);

        // 释放输出 LocalTensor
        outQueueZ.FreeTensor(zLocal);
    }

private:
    AscendC::TPipe pipe;

    AscendC::TQue<AscendC::QuePosition::VECIN, QUEUE_DEPTH>
        inQueueX, inQueueY;

    AscendC::TQue<AscendC::QuePosition::VECOUT, QUEUE_DEPTH>
        outQueueZ;

    AscendC::GlobalTensor<T> xGm, yGm, zGm;

    uint32_t blockLength; // 每个核处理的元素数
    uint32_t tileNum;     // 单核内的分块参数
    uint32_t tileLength;  // 每次循环处理的元素数
};

// ---------------------------------------------------------------------------
// 核函数入口
// ---------------------------------------------------------------------------
template <typename T>
__global__ __vector__ void sub_custom(
    GM_ADDR x,
    GM_ADDR y,
    GM_ADDR z,
    SubCustomTilingData tiling)
{
    KernelSub<T> op;
    op.Init(x, y, z, tiling);
    op.Process();
}

// ---------------------------------------------------------------------------
// host 侧启动函数：推导 tiling，并按输入 dtype 启动核函数
// ---------------------------------------------------------------------------
extern "C" void run_kernel(
    GM_ADDR x,
    const TensorGroupInfo& info_x,
    GM_ADDR y,
    const TensorGroupInfo& info_y,
    GM_ADDR z,
    const TensorGroupInfo& info_z,
    int64_t availableCoreNum,
    aclrtStream stream)
{
    constexpr uint32_t blockDim = 8;

    // 1. 计算总元素数，假定 x/y/z 形状一致
    const TensorInfo& t0 = info_x.tensors[0];

    int64_t totalLength = 1;
    for (int64_t i = 0; i < t0.numDims; i++) {
        totalLength *= t0.shape[i];
    }

    // 2. 获取输入数据类型：0=fp32，1=fp16
    int32_t dtype = t0.dtype;

    // 3. 与加法示例保持一致，固定 tileNum 为 8
    uint32_t tileNum = 8;
    SubCustomTilingData tiling = {
        static_cast<uint32_t>(totalLength),
        tileNum
    };

    // 4. 按数据类型启动减法核函数
    if (dtype == 1) {
        sub_custom<half><<<blockDim, nullptr, stream>>>(
            x, y, z, tiling);
    } else {
        sub_custom<float><<<blockDim, nullptr, stream>>>(
            x, y, z, tiling);
    }
}