#include <cmath>
#include "kernel_operator.h"
/*
 * Sub Kernel — Ascend C Direct Invocation
 * This file is #included — do NOT add main(), #pragma once, or include guards.
 *
 * TensorGroupInfo / TensorInfo (predefined):
 *   struct TensorInfo { const int64_t* shape; int64_t numDims; int32_t dtype; };
 *   struct TensorGroupInfo { const TensorInfo* tensors; int64_t numTensors; };
 *   dtype: 0=fp32 1=fp16 2=bf16 3=int8 4=int16 5=int32 6=int64 7=uint8 8=uint16 9=uint32 10=uint64 11=bool
 *   Usage: info_x.tensors[0].shape[0]  // first dim of first tensor in input x
 *
 *
 *__global__ __vector__ void sub_custom(...)
 * {
 *     // TODO: implement your kernel logic
 *     // Available APIs: AscendC::TPipe, AscendC::TQue, AscendC::DataCopy, AscendC::Add, ...
 * }
 */
 
using namespace AscendC;

constexpr int32_t BUFFER_NUM = 1;
constexpr int32_t TILE_NUM   = 8;

template <typename T>
class KernelSub {
public:
    __aicore__ inline KernelSub() {}

    __aicore__ inline void Init(GM_ADDR x, GM_ADDR y, GM_ADDR z,
                               uint32_t totalLength, uint32_t tileNum)
    {
        uint32_t blockNum = (uint32_t)GetBlockNum();   // 实际启动的核数
        uint32_t blockIdx = (uint32_t)GetBlockIdx();   // 当前核编号
        uint32_t alignNum = 32 / sizeof(T);     // 32B对齐对应的元素个数（fp32:8, fp16:16）

        //每核元素数：向上取整后按32B对齐，最后一个核可能不满
        uint32_t coreLen = AlignUpElems((totalLength + blockNum - 1) / blockNum, alignNum);

        uint32_t start = blockIdx * coreLen;
        if (start >= totalLength) {             // 数据分完，这个核空转
            this->length  = 0;
            this->tileLen = alignNum;
            this->tileNum = 1;
            return;
        }
        uint32_t remain = totalLength - start;
        this->length = (remain < coreLen) ? remain : coreLen;

        //块长：coreLen均分后再对齐，保证DataCopy的32B要求
        this->tileNum = tileNum;
        this->tileLen = AlignUpElems(coreLen / tileNum, alignNum);

        // 3) 绑定本核负责的GM切片
        xGm.SetGlobalBuffer((__gm__ T*)x + start, this->length);
        yGm.SetGlobalBuffer((__gm__ T*)y + start, this->length);
        zGm.SetGlobalBuffer((__gm__ T*)z + start, this->length);

        // 4) 在UB上为三条队列申请空间
        pipe.InitBuffer(inQueueX,  BUFFER_NUM, this->tileLen * sizeof(T));
        pipe.InitBuffer(inQueueY,  BUFFER_NUM, this->tileLen * sizeof(T));
        pipe.InitBuffer(outQueueZ, BUFFER_NUM, this->tileLen * sizeof(T));
    }

    __aicore__ inline void Process()
    {
        if (this->length == 0) {
            return;
        }
        uint32_t loopCount = (this->length + this->tileLen - 1) / this->tileLen;
        for (uint32_t i = 0; i < loopCount; ++i) {
            //尾块可能短于tileLen
            uint32_t cur = (i + 1 == loopCount)
                         ? (this->length - i * this->tileLen)
                         : this->tileLen;
            CopyIn(i, cur);
            Compute(cur);
            CopyOut(i, cur);
        }
    }

private:
    __aicore__ inline uint32_t AlignUpElems(uint32_t value, uint32_t align)
    {
        return (value + align - 1) / align * align;
    }

    __aicore__ inline void CopyIn(uint32_t idx, uint32_t cur)
    {
        LocalTensor<T> xLocal = inQueueX.AllocTensor<T>();
        LocalTensor<T> yLocal = inQueueY.AllocTensor<T>();

        if (cur == this->tileLen) {
            DataCopy(xLocal, xGm[idx * this->tileLen], cur);
            DataCopy(yLocal, yGm[idx * this->tileLen], cur);
        } else {
            //尾块长度不是32B整数倍，用DataCopyPad避免越界读写
            DataCopyExtParams copyParams{1, static_cast<uint32_t>(cur * sizeof(T)), 0, 0, 0};
            DataCopyPadExtParams<T> padParams{false, 0, 0, static_cast<T>(0)};
            DataCopyPad(xLocal, xGm[idx * this->tileLen], copyParams, padParams);
            DataCopyPad(yLocal, yGm[idx * this->tileLen], copyParams, padParams);
        }

        inQueueX.EnQue(xLocal);
        inQueueY.EnQue(yLocal);
    }

    //Vector单元计算：z = x - y
    __aicore__ inline void Compute(uint32_t cur)
    {
        LocalTensor<T> xLocal = inQueueX.DeQue<T>();
        LocalTensor<T> yLocal = inQueueY.DeQue<T>();
        LocalTensor<T> zLocal = outQueueZ.AllocTensor<T>();

        //第4个参数是“元素个数”，不是字节数
        Sub(zLocal, xLocal, yLocal, cur);

        outQueueZ.EnQue<T>(zLocal);
        inQueueX.FreeTensor(xLocal);
        inQueueY.FreeTensor(yLocal);
    }

    __aicore__ inline void CopyOut(uint32_t idx, uint32_t cur)
    {
        LocalTensor<T> zLocal = outQueueZ.DeQue<T>();

        if (cur == this->tileLen) {
            DataCopy(zGm[idx * this->tileLen], zLocal, cur);
        } else {
            DataCopyExtParams copyParams{1, static_cast<uint32_t>(cur * sizeof(T)), 0, 0, 0};
            DataCopyPad(zGm[idx * this->tileLen], zLocal, copyParams);
        }

        outQueueZ.FreeTensor(zLocal);
    }

    TPipe pipe;
    TQue<QuePosition::VECIN, BUFFER_NUM>  inQueueX, inQueueY;
    TQue<QuePosition::VECOUT, BUFFER_NUM> outQueueZ;
    GlobalTensor<T> xGm, yGm, zGm;
    uint32_t length  = 0;   //本核负责的元素数
    uint32_t tileLen = 0;   //每块元素数（32B对齐）
    uint32_t tileNum = 0;
};

// 核函数入口：fp32与fp16各一个，run_kernel按dtype派发
__global__ __vector__ void sub_custom_fp32(GM_ADDR x, GM_ADDR y, GM_ADDR z,
                                           uint32_t totalLength, uint32_t tileNum)
{
    KernelSub<float> op;
    op.Init(x, y, z, totalLength, tileNum);
    op.Process();
}

__global__ __vector__ void sub_custom_fp16(GM_ADDR x, GM_ADDR y, GM_ADDR z,
                                           uint32_t totalLength, uint32_t tileNum)
{
    KernelSub<half> op;
    op.Init(x, y, z, totalLength, tileNum);
    op.Process();
}

extern "C" void run_kernel(GM_ADDR x, const TensorGroupInfo& info_x, GM_ADDR y, const TensorGroupInfo& info_y, GM_ADDR z, const TensorGroupInfo& info_z, int64_t availableCoreNum, aclrtStream stream)
{
    // TODO: define your launch kernel.
    //   sub_custom<<<blockNum, nullptr, stream>>>(...);
    const TensorInfo& xInfo = info_x.tensors[0];

    //由shape算出总元素数
    int64_t totalLength = 1;
    for (int64_t i = 0; i < xInfo.numDims; ++i) {
        totalLength *= xInfo.shape[i];
    }
    uint32_t total = static_cast<uint32_t>(totalLength);
    uint32_t blockNum = static_cast<uint32_t>(availableCoreNum);
    if (blockNum == 0)  blockNum = 1;
    if (blockNum > total) blockNum = total;

    if (xInfo.dtype == 1) {
        sub_custom_fp16<<<blockNum, nullptr, stream>>>(x, y, z, total, TILE_NUM);
    } else {
        sub_custom_fp32<<<blockNum, nullptr, stream>>>(x, y, z, total, TILE_NUM);
    }
}
