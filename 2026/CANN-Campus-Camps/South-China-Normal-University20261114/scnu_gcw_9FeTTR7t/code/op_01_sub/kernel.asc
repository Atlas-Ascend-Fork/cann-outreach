#include <cmath>
#include "kernel_operator.h"
/*
 * Sub Kernel — Ascend C Direct Invocation      z = x - y
 * This file is #included — do NOT add main(), #pragma once, or include guards.
 *
 * TensorGroupInfo / TensorInfo (predefined):
 *   struct TensorInfo { const int64_t* shape; int64_t numDims; int32_t dtype; };
 *   struct TensorGroupInfo { const TensorInfo* tensors; int64_t numTensors; };
 *   dtype: 0=fp32 1=fp16 2=bf16 3=int8 4=int16 5=int32 6=int64 7=uint8 8=uint16 9=uint32 10=uint64 11=bool
 *   Usage: info_x.tensors[0].shape[0]  // first dim of first tensor in input x
 *
 * 实现思路（与 Lesson1 的 Add 例子同一套写法）：
 *   1) host 侧 run_kernel 由 TensorGroupInfo 算出元素总数 totalLength，并按输入 dtype
 *      选择核函数模板实例（float / half），同时算好“单核内每个 tile 的元素数”；
 *   2) 多核切分：totalLength 被均分到 blockNum 个核上，每核处理 blockLength 个元素，
 *      核内再切成若干 tile，用 TQue 完成 GM -> UB -> GM 的搬运与计算；
 *   3) DataCopy 的搬运长度始终是 32 字节的整数倍，保证 UB/ GM 访问对齐。
 */

// ---------------------------------------------------------------------------
// UB 队列与分块配置
// ---------------------------------------------------------------------------
constexpr uint32_t BUFFER_NUM = 2;          // 每个队列的 buffer 块数（QUEUE_DEPTH=1，无流水重叠）
constexpr uint32_t QUEUE_DEPTH = 1;         // 队列深度
constexpr uint32_t MAX_TILE_BYTES = 4096;   // 单个 tile buffer 的上限（字节），控制 UB 占用

// ---------------------------------------------------------------------------
// Tiling 参数：host 侧计算好后按值传给核函数
// ---------------------------------------------------------------------------
struct SubCustomTilingData {
    uint32_t totalLength;   // 待处理元素总个数，例如 8 * 2048
    uint32_t tileLength;    // 单核内每个 tile 的元素个数（32B 对齐）
};

// ---------------------------------------------------------------------------
// KernelSub：z = x - y，模板化，支持 float / half 等类型
// ---------------------------------------------------------------------------
template <typename T>
class KernelSub {
public:
    __aicore__ inline KernelSub() {}

    __aicore__ inline void Init(GM_ADDR x, GM_ADDR y, GM_ADDR z, const SubCustomTilingData& tiling)
    {
        // 多核均分：每个核处理 totalLength / blockNum 个元素
        this->blockLength = tiling.totalLength / (uint32_t)AscendC::GetBlockNum();
        // 单核内每个 tile 的元素数，不能超过单核的数据量
        this->tileLength = tiling.tileLength;
        if (this->tileLength == 0 || this->tileLength > this->blockLength) {
            this->tileLength = this->blockLength;
        }
        // 每个核在 Global Memory 中的起始地址（关键的多核切分逻辑）
        xGm.SetGlobalBuffer((__gm__ T *)x + this->blockLength * (uint32_t)AscendC::GetBlockIdx(),
                            this->blockLength);
        yGm.SetGlobalBuffer((__gm__ T *)y + this->blockLength * (uint32_t)AscendC::GetBlockIdx(),
                            this->blockLength);
        zGm.SetGlobalBuffer((__gm__ T *)z + this->blockLength * (uint32_t)AscendC::GetBlockIdx(),
                            this->blockLength);
        // 为队列分配 UB 内存：BUFFER_NUM 块，每块 tileLength 个元素
        pipe.InitBuffer(inQueueX, BUFFER_NUM, this->tileLength * sizeof(T));
        pipe.InitBuffer(inQueueY, BUFFER_NUM, this->tileLength * sizeof(T));
        pipe.InitBuffer(outQueueZ, BUFFER_NUM, this->tileLength * sizeof(T));
    }

    __aicore__ inline void Process()
    {
        if (this->blockLength == 0) {
            return;
        }
        // DataCopy 一次搬运的长度需按 32B 对齐，这里按元素个数换算
        constexpr uint32_t alignElems = 32u / sizeof(T);
        uint32_t alignedLength = (this->blockLength / alignElems) * alignElems;

        // 单核内按 tile 依次处理（最后一个 tile 处理剩余长度）
        for (uint32_t offset = 0; offset < alignedLength; offset += this->tileLength) {
            uint32_t len = alignedLength - offset;
            if (len > this->tileLength) {
                len = this->tileLength;
            }
            CopyIn(offset, len);
            Compute(len);
            CopyOut(offset, len);
        }

        // 兜底：处理不足 32B 的尾部元素（题目 shape 为 8x2048，正常不会走到这里）
        for (uint32_t i = alignedLength; i < this->blockLength; ++i) {
            float v = (float)xGm.GetValue(i) - (float)yGm.GetValue(i);
            zGm.SetValue(i, (T)v);
        }
    }

private:
    __aicore__ inline void CopyIn(uint32_t offset, uint32_t len)
    {
        AscendC::LocalTensor<T> xLocal = inQueueX.AllocTensor<T>();
        AscendC::LocalTensor<T> yLocal = inQueueY.AllocTensor<T>();
        // GM -> UB
        AscendC::DataCopy(xLocal, xGm[offset], len);
        AscendC::DataCopy(yLocal, yGm[offset], len);
        inQueueX.EnQue(xLocal);
        inQueueY.EnQue(yLocal);
    }

    __aicore__ inline void Compute(uint32_t len)
    {
        AscendC::LocalTensor<T> xLocal = inQueueX.DeQue<T>();
        AscendC::LocalTensor<T> yLocal = inQueueY.DeQue<T>();
        AscendC::LocalTensor<T> zLocal = outQueueZ.AllocTensor<T>();
        // 向量减法：z = x - y
        AscendC::Sub(zLocal, xLocal, yLocal, len);
        outQueueZ.EnQue<T>(zLocal);
        // 释放输入 buffer，避免内存泄漏
        inQueueX.FreeTensor(xLocal);
        inQueueY.FreeTensor(yLocal);
    }

    __aicore__ inline void CopyOut(uint32_t offset, uint32_t len)
    {
        AscendC::LocalTensor<T> zLocal = outQueueZ.DeQue<T>();
        // UB -> GM
        AscendC::DataCopy(zGm[offset], zLocal, len);
        outQueueZ.FreeTensor(zLocal);
    }

private:
    AscendC::TPipe pipe;   // UB 内存管理对象
    AscendC::TQue<AscendC::QuePosition::VECIN, QUEUE_DEPTH> inQueueX, inQueueY;
    AscendC::TQue<AscendC::QuePosition::VECOUT, QUEUE_DEPTH> outQueueZ;
    AscendC::GlobalTensor<T> xGm, yGm, zGm;

    uint32_t blockLength;   // 每个核处理的元素数
    uint32_t tileLength;    // 单核内每块元素数
};

// ---------------------------------------------------------------------------
// 核函数入口：实例化 KernelSub<T> 并执行（T 由 run_kernel 按输入 dtype 选择）
// ---------------------------------------------------------------------------
template <typename T>
__global__ __vector__ void sub_custom(GM_ADDR x, GM_ADDR y, GM_ADDR z, SubCustomTilingData tiling)
{
    KernelSub<T> op;
    op.Init(x, y, z, tiling);
    op.Process();
}

// ---------------------------------------------------------------------------
// host 侧启动函数：由 TensorGroupInfo 推导 tiling，并启动核函数
// ---------------------------------------------------------------------------
extern "C" void run_kernel(GM_ADDR x, const TensorGroupInfo& info_x, GM_ADDR y, const TensorGroupInfo& info_y, GM_ADDR z, const TensorGroupInfo& info_z, int64_t availableCoreNum, aclrtStream stream)
{
    if (info_x.numTensors <= 0) {
        return;
    }
    // 1. 元素总数 = shape 各维乘积（x / y / z 形状一致，以 x 为准）
    const TensorInfo& t0 = info_x.tensors[0];
    int64_t totalLength = 1;
    for (int64_t i = 0; i < t0.numDims; ++i) {
        totalLength *= t0.shape[i];
    }
    if (totalLength <= 0) {
        return;
    }

    // 2. 元素字节数 & 32B 对齐的元素个数
    int32_t dtype = t0.dtype;
    uint32_t elemBytes = (dtype == 1 || dtype == 2) ? 2u : 4u;   // 1=fp16, 2=bf16, 其他按 4 字节处理
    uint32_t alignElems = 32u / elemBytes;

    // 3. 选 blockNum：在可用核数以内，取能整除（blockNum * 对齐元素数）的最大值，
    //    保证每核数据量 32B 对齐且三核之间数据正好均分，不产生越界
    uint32_t maxBlockNum = (availableCoreNum > 0) ? (uint32_t)availableCoreNum : 1u;
    if (maxBlockNum > 64u) {
        maxBlockNum = 64u;
    }
    uint32_t blockNum = 1u;
    for (uint32_t b = maxBlockNum; b > 1u; --b) {
        if (totalLength % ((int64_t)b * (int64_t)alignElems) == 0) {
            blockNum = b;
            break;
        }
    }

    // 4. 单核内 tile 元素数：不超过 MAX_TILE_BYTES，且 32B 对齐
    uint32_t tileLength = MAX_TILE_BYTES / elemBytes;
    tileLength = (tileLength / alignElems) * alignElems;
    if (tileLength == 0) {
        tileLength = alignElems;
    }

    SubCustomTilingData tiling = {(uint32_t)totalLength, tileLength};

    // 5. 按 dtype 选择核函数实例（fp16 走 half，其余走 float）
    if (dtype == 1) {
        sub_custom<half><<<blockNum, nullptr, stream>>>(x, y, z, tiling);
    } else {
        sub_custom<float><<<blockNum, nullptr, stream>>>(x, y, z, tiling);
    }
}