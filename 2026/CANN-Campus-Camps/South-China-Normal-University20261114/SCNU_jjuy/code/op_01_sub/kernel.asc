#include <cstdint>
#include "kernel_operator.h"

// Sub operator: shape=(8, 2048), dtype=0(float32) or 1(float16).
// 256 elements per tile: 1024 bytes for float and 512 bytes for half.
constexpr uint32_t SUB_TILE_LENGTH = 256;
constexpr uint32_t SUB_BUFFER_NUM = 1;

template <typename T>
class KernelSub {
public:
    __aicore__ inline KernelSub() {}

    __aicore__ inline void Init(GM_ADDR x, GM_ADDR y, GM_ADDR z,
                               uint32_t totalLength, uint32_t blockNum)
    {
        length = totalLength;
        coreCount = blockNum;
        xGm.SetGlobalBuffer((__gm__ T*)x, length);
        yGm.SetGlobalBuffer((__gm__ T*)y, length);
        zGm.SetGlobalBuffer((__gm__ T*)z, length);

        pipe.InitBuffer(inQueueX, SUB_BUFFER_NUM, SUB_TILE_LENGTH * sizeof(T));
        pipe.InitBuffer(inQueueY, SUB_BUFFER_NUM, SUB_TILE_LENGTH * sizeof(T));
        pipe.InitBuffer(outQueueZ, SUB_BUFFER_NUM, SUB_TILE_LENGTH * sizeof(T));
    }

    __aicore__ inline void Process()
    {
        const uint32_t blockIdx = static_cast<uint32_t>(AscendC::GetBlockIdx());
        const uint32_t step = coreCount * SUB_TILE_LENGTH;
        for (uint32_t offset = blockIdx * SUB_TILE_LENGTH;
             offset < length; offset += step) {
            CopyIn(offset);
            Compute();
            CopyOut(offset);
        }
    }

private:
    __aicore__ inline void CopyIn(uint32_t offset)
    {
        AscendC::LocalTensor<T> xLocal = inQueueX.AllocTensor<T>();
        AscendC::LocalTensor<T> yLocal = inQueueY.AllocTensor<T>();
        AscendC::DataCopy(xLocal, xGm[offset], SUB_TILE_LENGTH);
        AscendC::DataCopy(yLocal, yGm[offset], SUB_TILE_LENGTH);
        inQueueX.EnQue(xLocal);
        inQueueY.EnQue(yLocal);
    }

    __aicore__ inline void Compute()
    {
        AscendC::LocalTensor<T> xLocal = inQueueX.DeQue<T>();
        AscendC::LocalTensor<T> yLocal = inQueueY.DeQue<T>();
        AscendC::LocalTensor<T> zLocal = outQueueZ.AllocTensor<T>();
        AscendC::Sub(zLocal, xLocal, yLocal, SUB_TILE_LENGTH);
        outQueueZ.EnQue(zLocal);
        inQueueX.FreeTensor(xLocal);
        inQueueY.FreeTensor(yLocal);
    }

    __aicore__ inline void CopyOut(uint32_t offset)
    {
        AscendC::LocalTensor<T> zLocal = outQueueZ.DeQue<T>();
        AscendC::DataCopy(zGm[offset], zLocal, SUB_TILE_LENGTH);
        outQueueZ.FreeTensor(zLocal);
    }

private:
    AscendC::TPipe pipe;
    AscendC::TQue<AscendC::TPosition::VECIN, SUB_BUFFER_NUM> inQueueX;
    AscendC::TQue<AscendC::TPosition::VECIN, SUB_BUFFER_NUM> inQueueY;
    AscendC::TQue<AscendC::TPosition::VECOUT, SUB_BUFFER_NUM> outQueueZ;
    AscendC::GlobalTensor<T> xGm, yGm, zGm;
    uint32_t length;
    uint32_t coreCount;
};

// Two concrete device kernels avoid interpreting float16 data as float32.
extern "C" __global__ __vector__ void sub_custom_fp32(
    GM_ADDR x, GM_ADDR y, GM_ADDR z, uint32_t totalLength, uint32_t blockNum)
{
    KernelSub<float> op;
    op.Init(x, y, z, totalLength, blockNum);
    op.Process();
}

extern "C" __global__ __vector__ void sub_custom_fp16(
    GM_ADDR x, GM_ADDR y, GM_ADDR z, uint32_t totalLength, uint32_t blockNum)
{
    KernelSub<half> op;
    op.Init(x, y, z, totalLength, blockNum);
    op.Process();
}

// Keep the host entry signature unchanged; main.asc includes this file.
extern "C" void run_kernel(
    GM_ADDR x, const TensorGroupInfo& info_x,
    GM_ADDR y, const TensorGroupInfo& info_y,
    GM_ADDR z, const TensorGroupInfo& info_z,
    int64_t availableCoreNum, aclrtStream stream)
{
    if (availableCoreNum <= 0 || info_x.numTensors < 1 || info_x.tensors == nullptr) {
        return;
    }

    const TensorInfo& input = info_x.tensors[0];
    int64_t totalElements = 1;
    for (int64_t i = 0; i < input.numDims; ++i) {
        totalElements *= input.shape[i];
    }
    if (totalElements <= 0 || totalElements % SUB_TILE_LENGTH != 0) {
        return;
    }

    const int64_t tileCount = totalElements / SUB_TILE_LENGTH;
    const uint32_t blockNum = static_cast<uint32_t>(
        availableCoreNum < tileCount ? availableCoreNum : tileCount);
    const uint32_t length = static_cast<uint32_t>(totalElements);

    if (input.dtype == 0) {             // float32
        sub_custom_fp32<<<blockNum, nullptr, stream>>>(x, y, z, length, blockNum);
    } else if (input.dtype == 1) {      // float16
        sub_custom_fp16<<<blockNum, nullptr, stream>>>(x, y, z, length, blockNum);
    }
}
