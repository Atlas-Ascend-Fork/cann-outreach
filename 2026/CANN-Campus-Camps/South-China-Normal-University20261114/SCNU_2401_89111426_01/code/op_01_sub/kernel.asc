#include <cmath>
#include "kernel_operator.h"
/*
 * Sub Kernel — Ascend C Direct Invocation
 * This file is #included — do NOT add main(), #pragma once, or include guards.
 *
 * TensorGroupInfo / TensorInfo (predefined):
 *   struct TensorInfo { const int64_t* shape; int64_t numDims; int32_t dtype; };
 *   struct TensorGroupInfo { const TensorInfo* tensors; int64_t numTensors; };
 *   dtype: 0=fp32 1=fp16 2=bf16 3=int8 4=int16 5=int32 6=int64 7=uint8 8=uint16 9=uint32 10=uint64 11=bool
 *   Usage: info_x.tensors[0].shape[0]  // first dim of first tensor in input x
 *
 */

constexpr uint32_t PARTITION_LENGTH = 128; // 核间划分粒度，兼顾 fp16 和 fp32 的 32 字节对齐
constexpr uint32_t MAX_BATCH_LENGTH = 4096;
constexpr uint32_t MAX_BLOCKS = 8;

template <typename T>
class KernelSub {
public:
    __aicore__ inline KernelSub() {}

    __aicore__ inline void Init(GM_ADDR x, GM_ADDR y, GM_ADDR z,
                               uint32_t groupsPerCore, uint32_t extraGroups)
    {
        const uint32_t blockIdx = AscendC::GetBlockIdx();
        // 多出来的组依次分给前 extraGroups 个核，核内只需算连续区间的起点。
        const uint32_t groupsBefore = blockIdx * groupsPerCore
            + (blockIdx < extraGroups ? blockIdx : extraGroups);
        const uint32_t blockOffset = groupsBefore * PARTITION_LENGTH;
        blockLength = (groupsPerCore + (blockIdx < extraGroups ? 1 : 0)) * PARTITION_LENGTH;
        xGm.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(x) + blockOffset, blockLength);
        yGm.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(y) + blockOffset, blockLength);
        zGm.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(z) + blockOffset, blockLength);

        // 常见的 8 核配置下每核一次处理 2048 个元素。限制少核时的 UB 占用。
        batchLength = blockLength < MAX_BATCH_LENGTH ? blockLength : MAX_BATCH_LENGTH;
        const uint32_t batchBytes = batchLength * sizeof(T);
        // 同一输入缓冲区的前后两段分别存放 x 和 y，共用一次队列同步。
        pipe.InitBuffer(inQueueXY, 1, 2 * batchBytes);
        pipe.InitBuffer(outQueueZ, 1, batchBytes);
    }

    __aicore__ inline void Process()
    {
        for (uint32_t offset = 0; offset < blockLength; offset += batchLength) {
            const uint32_t remaining = blockLength - offset;
            const uint32_t count = remaining < batchLength ? remaining : batchLength;
            CopyIn(offset, count);
            Compute(count);
            CopyOut(offset, count);
        }
    }

private:
    __aicore__ inline void CopyIn(uint32_t offset, uint32_t count)
    {
        AscendC::LocalTensor<T> xyLocal = inQueueXY.AllocTensor<T>();
        AscendC::LocalTensor<T> yLocal = xyLocal[batchLength];
        AscendC::DataCopy(xyLocal, xGm[offset], count);
        AscendC::DataCopy(yLocal, yGm[offset], count);
        inQueueXY.EnQue(xyLocal);
    }

    __aicore__ inline void Compute(uint32_t count)
    {
        AscendC::LocalTensor<T> xyLocal = inQueueXY.DeQue<T>();
        AscendC::LocalTensor<T> yLocal = xyLocal[batchLength];
        AscendC::LocalTensor<T> zLocal = outQueueZ.AllocTensor<T>();
        AscendC::Sub(zLocal, xyLocal, yLocal, count);
        outQueueZ.EnQue(zLocal);
        inQueueXY.FreeTensor(xyLocal);
    }

    __aicore__ inline void CopyOut(uint32_t offset, uint32_t count)
    {
        AscendC::LocalTensor<T> zLocal = outQueueZ.DeQue<T>();
        AscendC::DataCopy(zGm[offset], zLocal, count);
        outQueueZ.FreeTensor(zLocal);
    }

    AscendC::TPipe pipe;
    AscendC::TQue<AscendC::TPosition::VECIN, 1> inQueueXY;
    AscendC::TQue<AscendC::TPosition::VECOUT, 1> outQueueZ;
    AscendC::GlobalTensor<T> xGm, yGm, zGm;
    uint32_t blockLength;
    uint32_t batchLength;
};

template <typename T>
__global__ __vector__ void sub_custom(GM_ADDR x, GM_ADDR y, GM_ADDR z,
                                      uint32_t groupsPerCore, uint32_t extraGroups)
{
    KernelSub<T> op;
    op.Init(x, y, z, groupsPerCore, extraGroups);
    op.Process();
}

extern "C" void run_kernel(GM_ADDR x, const TensorGroupInfo& info_x, GM_ADDR y, const TensorGroupInfo& info_y, GM_ADDR z, const TensorGroupInfo& info_z, int64_t availableCoreNum, aclrtStream stream)
{
    if (availableCoreNum <= 0) {
        return;
    }

    const TensorInfo& input = info_x.tensors[0];
    int64_t totalLength = 1;
    for (int64_t dim = 0; dim < input.numDims; ++dim) {
        totalLength *= input.shape[dim];
    }
    // 题目固定形状为 (8, 2048)，总元素数是核间划分粒度的整数倍。
    const uint32_t totalGroups = static_cast<uint32_t>(totalLength / PARTITION_LENGTH);
    const uint32_t blockDim = availableCoreNum < MAX_BLOCKS
        ? static_cast<uint32_t>(availableCoreNum)
        : MAX_BLOCKS;
    const uint32_t groupsPerCore = totalGroups / blockDim;
    const uint32_t extraGroups = totalGroups % blockDim;

    if (input.dtype == 0) {
        sub_custom<float><<<blockDim, nullptr, stream>>>(x, y, z, groupsPerCore, extraGroups);
    } else if (input.dtype == 1) {
        sub_custom<half><<<blockDim, nullptr, stream>>>(x, y, z, groupsPerCore, extraGroups);
    }
}
