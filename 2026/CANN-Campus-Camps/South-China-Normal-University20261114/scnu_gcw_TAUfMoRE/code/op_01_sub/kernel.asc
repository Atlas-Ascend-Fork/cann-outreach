#include <cmath>
#include "kernel_operator.h"

/*
 * Sub Kernel - Ascend C Direct Invocation
 * This file is #included - do NOT add main(), #pragma once, or include guards.
 */

using namespace AscendC;

constexpr int32_t BUFFER_NUM = 2; // 双缓冲流水线
constexpr int32_t TILE_NUM = 8;   // 单核内切块数

// Tiling 结构体
struct SubCustomTilingData {
    uint32_t totalLength;
    uint32_t tileNum;
};

// =========================================================================
// 1. Kernel 侧实现模板
// =========================================================================
template <typename T>
class KernelSub {
public:
    __aicore__ inline KernelSub() {}

    __aicore__ inline void Init(GM_ADDR x, GM_ADDR y, GM_ADDR z, const SubCustomTilingData& tiling) {
        uint32_t blockNum = GetBlockNum();
        uint32_t blockIdx = GetBlockIdx();

        // 多核切分：按核数分配数据
        uint32_t blockLength = tiling.totalLength / blockNum;
        uint32_t offset = blockIdx * blockLength;
        
        // 最后一个核处理余数，保证全覆盖
        if (blockIdx == blockNum - 1) {
            blockLength = tiling.totalLength - offset;
        }

        xGm.SetGlobalBuffer((__gm__ T*)x + offset, blockLength);
        yGm.SetGlobalBuffer((__gm__ T*)y + offset, blockLength);
        zGm.SetGlobalBuffer((__gm__ T*)z + offset, blockLength);

        // 按 32B 对齐计算单次搬运长度
        uint32_t alignElem = 32 / sizeof(T);
        uint32_t tileLength = blockLength / (tiling.tileNum * BUFFER_NUM);
        tileLength = tileLength / alignElem * alignElem;
        if (tileLength == 0) tileLength = alignElem;

        // 初始化 UB 队列
        pipe.InitBuffer(inQueueX, BUFFER_NUM, tileLength * sizeof(T));
        pipe.InitBuffer(inQueueY, BUFFER_NUM, tileLength * sizeof(T));
        pipe.InitBuffer(outQueueZ, BUFFER_NUM, tileLength * sizeof(T));

        this->tileLength = tileLength;
        this->loopCount = blockLength / tileLength;
        this->blockLength = blockLength;
        this->alignElem = alignElem;
    }

    __aicore__ inline void Process() {
        for (uint32_t i = 0; i < loopCount; i++) {
            CopyIn(i);
            Compute(i);
            CopyOut(i);
        }
    }

private:
    __aicore__ inline void CopyIn(uint32_t progress) {
        LocalTensor<T> xLocal = inQueueX.AllocTensor<T>();
        LocalTensor<T> yLocal = inQueueY.AllocTensor<T>();
        uint32_t offset = progress * tileLength;
        uint32_t currentLength = (progress == loopCount - 1) ? (blockLength - offset) : tileLength;

        if (currentLength % alignElem == 0) {
            DataCopy(xLocal, xGm[offset], currentLength);
            DataCopy(yLocal, yGm[offset], currentLength);
        } else {
            DataCopyExtParams copyParams{1, (uint32_t)(currentLength * sizeof(T)), 0, 0, 0};
            DataCopyPadExtParams<T> padParams{false, 0, 0, 0};
            DataCopyPad(xLocal, xGm[offset], copyParams, padParams);
            DataCopyPad(yLocal, yGm[offset], copyParams, padParams);
        }
        inQueueX.EnQue(xLocal);
        inQueueY.EnQue(yLocal);
    }

    __aicore__ inline void Compute(uint32_t progress) {
        LocalTensor<T> xLocal = inQueueX.DeQue<T>();
        LocalTensor<T> yLocal = inQueueY.DeQue<T>();
        LocalTensor<T> zLocal = outQueueZ.AllocTensor<T>();
        
        uint32_t offset = progress * tileLength;
        uint32_t currentLength = (progress == loopCount - 1) ? (blockLength - offset) : tileLength;
        
        Sub(zLocal, xLocal, yLocal, currentLength);
        
        outQueueZ.EnQue(zLocal);
        inQueueX.FreeTensor(xLocal);
        inQueueY.FreeTensor(yLocal);
    }

    __aicore__ inline void CopyOut(uint32_t progress) {
        LocalTensor<T> zLocal = outQueueZ.DeQue<T>();
        uint32_t offset = progress * tileLength;
        uint32_t currentLength = (progress == loopCount - 1) ? (blockLength - offset) : tileLength;

        if (currentLength % alignElem == 0) {
            DataCopy(zGm[offset], zLocal, currentLength);
        } else {
            DataCopyExtParams copyParams{1, (uint32_t)(currentLength * sizeof(T)), 0, 0, 0};
            DataCopyPad(zGm[offset], zLocal, copyParams);
        }
        outQueueZ.FreeTensor(zLocal);
    }

private:
    TPipe pipe;
    TQue<QuePosition::VECIN, BUFFER_NUM> inQueueX;
    TQue<QuePosition::VECIN, BUFFER_NUM> inQueueY;
    TQue<QuePosition::VECOUT, BUFFER_NUM> outQueueZ;
    GlobalTensor<T> xGm, yGm, zGm;
    uint32_t tileLength;
    uint32_t loopCount;
    uint32_t blockLength;
    uint32_t alignElem;
};

// =========================================================================
// 2. TODO 补全：设备侧核函数入口
// =========================================================================
__global__ __aicore__ void sub_custom(GM_ADDR x, GM_ADDR y, GM_ADDR z, SubCustomTilingData tiling, uint32_t dtype) {
    if (dtype == 1) {
        KernelSub<half> op;
        op.Init(x, y, z, tiling);
        op.Process();
    } else {
        KernelSub<float> op;
        op.Init(x, y, z, tiling);
        op.Process();
    }
}

// =========================================================================
// 3. TODO 补全：Host 侧启动函数（完全适配模板签名）
// =========================================================================
extern "C" void run_kernel(GM_ADDR x, const TensorGroupInfo& info_x, GM_ADDR y, const TensorGroupInfo& info_y, GM_ADDR z, TensorGroupInfo& info_z, uint32_t availableCoreNum, aclrtStream stream) {
    // 1. 计算总元素数
    uint64_t totalLength = 1;
    for (int32_t i = 0; i < info_x.tensors[0].numDims; ++i) {
        totalLength *= info_x.tensors[0].shape[i];
    }

    // 2. 读取数据类型并填充 Tiling
    uint32_t dtype = info_x.tensors[0].dtype; 
    SubCustomTilingData tiling;
    tiling.totalLength = (uint32_t)totalLength;
    tiling.tileNum = TILE_NUM;

    // 3. 确定启动核数
    uint32_t blockDim = 8;
    if (totalLength < blockDim * 32) {
        blockDim = (uint32_t)(totalLength / 32);
        if (blockDim == 0) blockDim = 1;
    }
    if (availableCoreNum > 0 && availableCoreNum < blockDim) {
        blockDim = availableCoreNum;
    }

    // 4. 调用核函数
    sub_custom<<<blockDim, nullptr, stream>>>(x, y, z, tiling, dtype);
}