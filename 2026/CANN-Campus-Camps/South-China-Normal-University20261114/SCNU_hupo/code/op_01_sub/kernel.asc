#include <cmath>
#include "kernel_operator.h"

// ============================ 调优要点 ============================
// 1. 放开核数：原实现 kMaxBlockDim = 8 且强制整除，A2 的 40 个 vector core
//    只用上 8 个，搬运串行链被拉长成 8KB/段。这里改为用满 availableCoreNum，
//    并用 32B 对齐的 perCoreLength + 尾块 DataCopyPad 支持任意核数。
// 2. 单核数据切成 tile + 双缓冲（kBufferNum = 2），让 MTE2/V/MTE3 三级流水重叠，
//    大 shape 时收益明显；小 shape 时 tileNum = 1，退化回单次搬运，无额外开销。
// 3. 全对齐走 DataCopy 快路径，只有尾部残差走 DataCopyPad，避免 pad 逻辑的
//    固定开销被逐 tile 放大。
// ==================================================================

constexpr uint32_t kAlignBytes = 32;            // DataCopy 要求的 32 字节对齐
constexpr uint32_t kBufferNum = 2;              // 双缓冲深度
constexpr uint32_t kUbBufferBytes = 16 * 1024;  // 单 buffer 预算（3 队列 × 2 份 = 96KB）
constexpr uint32_t kMaxBlockDim = 64;           // 核数上限，避免过度切分

struct SubCustomTilingData {
    uint32_t totalLength;    // 元素总数
    uint32_t perCoreLength;  // 每核元素数（32B 对齐）
    uint32_t tileLength;     // 每 tile 元素数（32B 对齐）
    uint32_t tileNum;        // 每核 tile 数
    uint32_t alignElems;     // 32B 对应的元素个数
};

template <typename T>
class KernelSub {
public:
    __aicore__ inline KernelSub() {}

    __aicore__ inline void Init(GM_ADDR x, GM_ADDR y, GM_ADDR z, const SubCustomTilingData& tiling)
    {
        this->tileLength = tiling.tileLength;
        this->tileNum = tiling.tileNum;
        this->alignElems = tiling.alignElems;

        const uint32_t start = tiling.perCoreLength * static_cast<uint32_t>(AscendC::GetBlockIdx());
        const uint32_t total = tiling.totalLength;
        if (start >= total) {
            this->localLength = 0;
            return;
        }
        const uint32_t remain = total - start;
        this->localLength = (remain < tiling.perCoreLength) ? remain : tiling.perCoreLength;

        xGm.SetGlobalBuffer((__gm__ T *)x + start, this->localLength);
        yGm.SetGlobalBuffer((__gm__ T *)y + start, this->localLength);
        zGm.SetGlobalBuffer((__gm__ T *)z + start, this->localLength);
        pipe.InitBuffer(inQueueX, kBufferNum, this->tileLength * sizeof(T));
        pipe.InitBuffer(inQueueY, kBufferNum, this->tileLength * sizeof(T));
        pipe.InitBuffer(outQueueZ, kBufferNum, this->tileLength * sizeof(T));
    }

    __aicore__ inline void Process()
    {
        if (this->localLength == 0) {
            return;
        }
        const uint32_t loopCount = this->tileNum;
        if (loopCount == 0) {
            return;
        }
        CopyIn(0);
        for (uint32_t i = 0; i < loopCount; i++) {
            if (i + 1 < loopCount) {
                CopyIn(i + 1);
            }
            Compute(i);
            CopyOut(i);
        }
    }

private:
    __aicore__ inline uint32_t TileLen(uint32_t i) const
    {
        const uint32_t remain = this->localLength - i * this->tileLength;
        return (remain < this->tileLength) ? remain : this->tileLength;
    }

    __aicore__ inline void CopyIn(uint32_t i)
    {
        const uint32_t len = TileLen(i);
        const uint32_t offset = i * this->tileLength;
        AscendC::LocalTensor<T> xLocal = inQueueX.AllocTensor<T>();
        AscendC::LocalTensor<T> yLocal = inQueueY.AllocTensor<T>();
        if (len % this->alignElems == 0) {
            AscendC::DataCopy(xLocal, xGm[offset], len);
            AscendC::DataCopy(yLocal, yGm[offset], len);
        } else {
            AscendC::DataCopyExtParams copyParams{};
            copyParams.blockCount = 1;
            copyParams.blockLen = static_cast<uint32_t>(len * sizeof(T));
            AscendC::DataCopyPadExtParams<T> padParams{};
            padParams.isPad = false;
            AscendC::DataCopyPad(xLocal, xGm[offset], copyParams, padParams);
            AscendC::DataCopyPad(yLocal, yGm[offset], copyParams, padParams);
        }
        inQueueX.EnQue(xLocal);
        inQueueY.EnQue(yLocal);
    }

    __aicore__ inline void Compute(uint32_t i)
    {
        AscendC::LocalTensor<T> xLocal = inQueueX.DeQue<T>();
        AscendC::LocalTensor<T> yLocal = inQueueY.DeQue<T>();
        AscendC::LocalTensor<T> zLocal = outQueueZ.AllocTensor<T>();
        AscendC::Sub(zLocal, xLocal, yLocal, TileLen(i));
        outQueueZ.EnQue<T>(zLocal);
        inQueueX.FreeTensor(xLocal);
        inQueueY.FreeTensor(yLocal);
    }

    __aicore__ inline void CopyOut(uint32_t i)
    {
        const uint32_t len = TileLen(i);
        const uint32_t offset = i * this->tileLength;
        AscendC::LocalTensor<T> zLocal = outQueueZ.DeQue<T>();
        if (len % this->alignElems == 0) {
            AscendC::DataCopy(zGm[offset], zLocal, len);
        } else {
            AscendC::DataCopyExtParams copyParams{};
            copyParams.blockCount = 1;
            copyParams.blockLen = static_cast<uint32_t>(len * sizeof(T));
            AscendC::DataCopyPad(zGm[offset], zLocal, copyParams);
        }
        outQueueZ.FreeTensor(zLocal);
    }

private:
    AscendC::TPipe pipe;
    AscendC::TQue<AscendC::QuePosition::VECIN, kBufferNum> inQueueX, inQueueY;
    AscendC::TQue<AscendC::QuePosition::VECOUT, kBufferNum> outQueueZ;
    AscendC::GlobalTensor<T> xGm, yGm, zGm;

    uint32_t localLength = 0;
    uint32_t tileLength = 0;
    uint32_t tileNum = 0;
    uint32_t alignElems = 1;
};

template <typename T>
__global__ __vector__ void sub_custom(GM_ADDR x, GM_ADDR y, GM_ADDR z, SubCustomTilingData tiling)
{
    KernelSub<T> op;
    op.Init(x, y, z, tiling);
    op.Process();
}

static inline uint32_t CeilDivU32(uint32_t a, uint32_t b)
{
    return (a + b - 1) / b;
}

static inline uint32_t AlignUpU32(uint32_t v, uint32_t a)
{
    return CeilDivU32(v, a) * a;
}

extern "C" void run_kernel(GM_ADDR x, const TensorGroupInfo& info_x, GM_ADDR y, const TensorGroupInfo& info_y, GM_ADDR z, const TensorGroupInfo& info_z, int64_t availableCoreNum, aclrtStream stream)
{
    const TensorInfo& t0 = info_x.tensors[0];
    int64_t totalLength = 1;
    for (int64_t i = 0; i < t0.numDims; i++) {
        totalLength *= t0.shape[i];
    }
    if (totalLength <= 0 || totalLength > 0x7FFFFFFFLL) {
        return;
    }

    const uint32_t elemBytes = (t0.dtype == 1) ? 2u : 4u;
    const uint32_t alignElems = kAlignBytes / elemBytes;
    const uint32_t total = static_cast<uint32_t>(totalLength);

    // 每个核至少能分到一个 32B 对齐块，否则减少核数
    uint32_t maxUsefulCores = total / alignElems;
    if (maxUsefulCores == 0) {
        maxUsefulCores = 1;
    }
    uint32_t blockDim = (availableCoreNum > 0) ? static_cast<uint32_t>(availableCoreNum) : 1u;
    if (blockDim > kMaxBlockDim) {
        blockDim = kMaxBlockDim;
    }
    if (blockDim > maxUsefulCores) {
        blockDim = maxUsefulCores;
    }

    // 每核处理量按 32B 向上取整，从而支持任意核数（不再要求整除）
    uint32_t perCoreLength = AlignUpU32(CeilDivU32(total, blockDim), alignElems);
    blockDim = CeilDivU32(total, perCoreLength);
    if (blockDim == 0) {
        blockDim = 1;
    }

    // 单核数据超过 UB 预算时切 tile，配合双缓冲流水
    const uint32_t maxTileElems = (kUbBufferBytes / elemBytes) / alignElems * alignElems;
    uint32_t tileLength = perCoreLength;
    uint32_t tileNum = 1;
    if (perCoreLength > maxTileElems) {
        tileLength = maxTileElems;
        tileNum = CeilDivU32(perCoreLength, tileLength);
    }

    SubCustomTilingData tiling = {total, perCoreLength, tileLength, tileNum, alignElems};
    if (t0.dtype == 1) {
        sub_custom<half><<<blockDim, nullptr, stream>>>(x, y, z, tiling);
    } else {
        sub_custom<float><<<blockDim, nullptr, stream>>>(x, y, z, tiling);
    }
}
