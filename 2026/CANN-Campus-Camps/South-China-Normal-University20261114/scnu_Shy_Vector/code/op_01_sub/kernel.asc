#include <cmath>
#include "kernel_operator.h"

using namespace AscendC;

// Tiling 参数：由 host 侧 run_kernel 预先计算后按值传入核函数，
// 避免每个核在 Device 侧重复做耗时的高位宽除法。
struct SubTilingData {
    uint32_t totalLength;  // 待处理数据总长度（元素个数），x/y/z 一致
    uint32_t perBlock;     // 每个核负责的数据长度（已按 32B 对齐的整元素个数）
};

constexpr int32_t TILE_LENGTH = 4096;  // 单次处理元素上限，须 >= 任一 dtype 的每核元素数（保证单 tile）

template <typename T>
class KernelSub {
public:
    __aicore__ inline KernelSub() {}

    __aicore__ inline void Init(GM_ADDR x, GM_ADDR y, GM_ADDR z, const SubTilingData& tiling)
    {
        uint32_t blockIdx = static_cast<uint32_t>(GetBlockIdx());
        uint32_t start = blockIdx * tiling.perBlock;
        if (start >= tiling.totalLength) {
            this->len_ = 0;
            return;
        }
        this->len_ = (start + tiling.perBlock <= tiling.totalLength)
                         ? tiling.perBlock
                         : (tiling.totalLength - start);

        xGm_.SetGlobalBuffer((__gm__ T *)x + start, this->len_);
        yGm_.SetGlobalBuffer((__gm__ T *)y + start, this->len_);
        zGm_.SetGlobalBuffer((__gm__ T *)z + start, this->len_);

        pipe_.InitBuffer(xBuf_, TILE_LENGTH * sizeof(T));
        pipe_.InitBuffer(yBuf_, TILE_LENGTH * sizeof(T));
        pipe_.InitBuffer(zBuf_, TILE_LENGTH * sizeof(T));
    }

    __aicore__ inline void Process()
    {
        if (this->len_ == 0) {
            return;
        }
        LocalTensor<T> xLocal = xBuf_.Get<T>();
        LocalTensor<T> yLocal = yBuf_.Get<T>();
        LocalTensor<T> zLocal = zBuf_.Get<T>();

        DataCopy(xLocal, xGm_[0], this->len_);
        DataCopy(yLocal, yGm_[0], this->len_);
        PipeBarrier<PIPE_ALL>();

        Sub(zLocal, xLocal, yLocal, static_cast<int32_t>(this->len_));
        PipeBarrier<PIPE_V>();

        DataCopy(zGm_[0], zLocal, this->len_);
    }

private:
    TPipe pipe_;
    TBuf<QuePosition::VECIN> xBuf_;
    TBuf<QuePosition::VECIN> yBuf_;
    TBuf<QuePosition::VECOUT> zBuf_;
    GlobalTensor<T> xGm_, yGm_, zGm_;
    uint32_t len_;
};

/*
 * Sub Kernel — Ascend C Direct Invocation
 * This file is #included — do NOT add main(), #pragma once, or include guards.
 */
template <typename T>
__global__ __vector__ void sub_custom(GM_ADDR x, GM_ADDR y, GM_ADDR z, SubTilingData tiling)
{
    KernelSub<T> op;
    op.Init(x, y, z, tiling);
    op.Process();
}

extern "C" void run_kernel(GM_ADDR x, const TensorGroupInfo& info_x, GM_ADDR y, const TensorGroupInfo& info_y, GM_ADDR z, const TensorGroupInfo& info_z, int64_t availableCoreNum, aclrtStream stream)
{
    const TensorInfo& tx = info_x.tensors[0];
    uint32_t totalLength = 1;
    for (int64_t i = 0; i < tx.numDims; i++) {
        totalLength *= static_cast<uint32_t>(tx.shape[i]);
    }
    int32_t dtype = tx.dtype;

    // 每核 4096 元素（fp32 16KB / fp16 8KB），本 shape 实测 4 核最优：
    // 核数过多时核间调度/同步开销增大，核数过少时单核串行时长增大。
    // blockNum 随之自适应，且由 elemPerCore <= TILE_LENGTH 保证
    // perBlock <= TILE_LENGTH（单核单 tile，无循环）。
    uint32_t elemPerCore = 4096;
    uint32_t blockNum = (totalLength + elemPerCore - 1) / elemPerCore;
    if (blockNum == 0) {
        blockNum = 1;
    }

    // perBlock：向上取整到 32 字节对齐对应的整元素个数（按实际 dtype 对齐粒度）
    uint32_t perBlock = (totalLength + blockNum - 1) / blockNum;
    uint32_t alignElems = (dtype == 1) ? (32 / 2) : (32 / 4);  // fp16:16, fp32:8
    perBlock = (perBlock + alignElems - 1) / alignElems * alignElems;
    if (perBlock == 0) {
        perBlock = alignElems;
    }

    SubTilingData tiling = {totalLength, perBlock};

    if (dtype == 1) {
        sub_custom<half><<<blockNum, nullptr, stream>>>(x, y, z, tiling);
    } else {
        sub_custom<float><<<blockNum, nullptr, stream>>>(x, y, z, tiling);
    }
}
