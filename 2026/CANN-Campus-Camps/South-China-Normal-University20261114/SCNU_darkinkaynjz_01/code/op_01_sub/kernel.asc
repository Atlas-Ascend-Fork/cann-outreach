#include "kernel_operator.h"

namespace {
constexpr uint32_t Total = 8 * 2048;
constexpr uint32_t Tile = 128;

template <class T>
class SubKernel {
public:
    __aicore__ inline void Execute(GM_ADDR x, GM_ADDR y, GM_ADDR z, uint32_t cores) {
        const uint32_t block = AscendC::GetBlockIdx();
        const uint32_t begin = (Total / Tile) * block / cores;
        const uint32_t end = (Total / Tile) * (block + 1) / cores;
        AscendC::GlobalTensor<T> gx, gy, gz;
        gx.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(x) + begin * Tile, (end - begin) * Tile);
        gy.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(y) + begin * Tile, (end - begin) * Tile);
        gz.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(z) + begin * Tile, (end - begin) * Tile);
        pipe.InitBuffer(qx, 2, Tile * sizeof(T));
        pipe.InitBuffer(qy, 2, Tile * sizeof(T));
        pipe.InitBuffer(qz, 2, Tile * sizeof(T));
        for (uint32_t i = 0; i < end - begin; ++i) {
            auto a = qx.AllocTensor<T>();
            auto b = qy.AllocTensor<T>();
            AscendC::DataCopy(a, gx[i * Tile], Tile);
            AscendC::DataCopy(b, gy[i * Tile], Tile);
            qx.EnQue(a);
            qy.EnQue(b);
            a = qx.DeQue<T>();
            b = qy.DeQue<T>();
            auto c = qz.AllocTensor<T>();
            AscendC::Sub(c, a, b, Tile);
            qz.EnQue(c);
            qx.FreeTensor(a);
            qy.FreeTensor(b);
            c = qz.DeQue<T>();
            AscendC::DataCopy(gz[i * Tile], c, Tile);
            qz.FreeTensor(c);
        }
    }
private:
    AscendC::TPipe pipe;
    AscendC::TQue<AscendC::QuePosition::VECIN, 2> qx, qy;
    AscendC::TQue<AscendC::QuePosition::VECOUT, 2> qz;
};
}

__global__ __vector__ void sub_custom(GM_ADDR x, GM_ADDR y, GM_ADDR z, uint32_t cores, int32_t dtype) {
    if (dtype == 0) {
        SubKernel<float> kernel;
        kernel.Execute(x, y, z, cores);
    } else {
        SubKernel<half> kernel;
        kernel.Execute(x, y, z, cores);
    }
}

extern "C" void run_kernel(GM_ADDR x, const TensorGroupInfo& info_x, GM_ADDR y, const TensorGroupInfo& info_y,
                           GM_ADDR z, const TensorGroupInfo& info_z, int64_t availableCoreNum, aclrtStream stream) {
    if (availableCoreNum <= 0 || info_x.numTensors == 0) return;
    const uint32_t cores = availableCoreNum < 8 ? static_cast<uint32_t>(availableCoreNum) : 8;
    const int32_t dtype = info_x.tensors[0].dtype;
    if (dtype == 0 || dtype == 1) sub_custom<<<cores, nullptr, stream>>>(x, y, z, cores, dtype);
}
