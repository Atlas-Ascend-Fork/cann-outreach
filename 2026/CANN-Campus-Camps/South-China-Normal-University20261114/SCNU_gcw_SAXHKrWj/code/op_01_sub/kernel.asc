#include <cmath>
#include "kernel_operator.h"
/*
 * Sub Kernel — Ascend C Direct Invocation
 * This file is #included — do NOT add main(), #pragma once, or include guards.
 *
 * TensorGroupInfo / TensorInfo (predefined):
 *   struct TensorInfo { const int64_t* shape; int64_t numDims; int32_t dtype; };
 *   struct TensorGroupInfo { const TensorInfo* tensors; int64_t numTensors; };
 *   dtype: 0=fp32 1=fp16 2=bf16 3=int8 4=int16 5=int32 6=int64 7=uint8 8=uint16 9=uint32 10=uint64 11=bool
 *   Usage: info_x.tensors[0].shape[0]  // first dim of first tensor in input x
 *
 * __global__ __vector__ void sub_custom(...)
 * {
 *     // TODO: implement your kernel logic
 *     // Available APIs: AscendC::TPipe, AscendC::TQue, AscendC::DataCopy, AscendC::Add, ...
 * }
 */

// ---------------------------------------------------------------------------
// Tiling 参数：由 host 侧 run_kernel 计算后按值传给核函数
// ---------------------------------------------------------------------------
struct SubCustomTilingData {
    uint32_t totalLength; // 待处理数据总长度（单位：元素个数），例如 8 * 2048
    uint32_t tileNum;     // 单核内将数据进一步切分为多少块（Tile），例如 8
};

constexpr uint32_t BUFFER_NUM = 2;   // 每队列 buffer 块数（注意：QUEUE_DEPTH 为 1，无流水重叠）
constexpr uint32_t QUEUE_DEPTH = 1;
constexpr uint32_t MAX_TILE_LENGTH = 2048; // 单块元素数上限，保证 UB 占用不超过限制

// ---------------------------------------------------------------------------
// KernelSub：z = x - y，每核按 tileNum × BUFFER_NUM 分块循环计算（模板化，支持 float / half 等类型）
// ---------------------------------------------------------------------------
template <typename T>
class KernelSub {
public:
    __aicore__ inline KernelSub() {}

    __aicore__ inline void Init(GM_ADDR x, GM_ADDR y, GM_ADDR z, const SubCustomTilingData& tiling)
    {
        uint32_t totalLength = tiling.totalLength;
        uint32_t tileNum = tiling.tileNum;
        uint32_t blockNum = (uint32_t)AscendC::GetBlockNum();
        uint32_t blockIdx = (uint32_t)AscendC::GetBlockIdx();
        // 计算每个核处理的数据长度（多核并行），除不尽的余数分给前几个核
        uint32_t baseLength = totalLength / blockNum;
        uint32_t tailNum = totalLength - baseLength * blockNum;
        this->blockLength = baseLength + (blockIdx < tailNum ? 1u : 0u);
        // 本核在整块张量中的起始偏移
        this->blockOffset = blockIdx * baseLength + (blockIdx < tailNum ? blockIdx : tailNum);

        // 单次处理的元素数（每块长度）：按 32 字节对齐，保证 DataCopy 搬运长度合法
        uint32_t alignElem = 32 / sizeof(T);
        uint32_t tileLength = (tileNum == 0) ? 1 : this->blockLength / tileNum / BUFFER_NUM;
        tileLength = (tileLength / alignElem) * alignElem;
        if (tileLength < alignElem) {
            tileLength = alignElem;
        }
        if (tileLength > MAX_TILE_LENGTH) {
            tileLength = MAX_TILE_LENGTH;
        }
        this->tileLength = tileLength;

        // 设置每个核的 Global Memory 起始地址（关键的多核切分逻辑）
        xGm.SetGlobalBuffer((__gm__ T *)x + this->blockOffset, this->blockLength);
        yGm.SetGlobalBuffer((__gm__ T *)y + this->blockOffset, this->blockLength);
        zGm.SetGlobalBuffer((__gm__ T *)z + this->blockOffset, this->blockLength);
        // 为队列分配 UB 内存（单核内分块处理的基础）
        pipe.InitBuffer(inQueueX, BUFFER_NUM, this->tileLength * sizeof(T));
        pipe.InitBuffer(inQueueY, BUFFER_NUM, this->tileLength * sizeof(T));
        pipe.InitBuffer(outQueueZ, BUFFER_NUM, this->tileLength * sizeof(T));
    }

    __aicore__ inline void Process()
    {
        // 依次处理每个数据块，最后一块可能不足 tileLength
        for (uint32_t offset = 0; offset < this->blockLength; offset += this->tileLength) {
            uint32_t curLength = this->blockLength - offset;
            if (curLength > this->tileLength) {
                curLength = this->tileLength;
            }
            CopyIn(offset, curLength);  // 搬入当前块数据
            Compute(curLength);         // 计算当前块数据
            CopyOut(offset, curLength); // 搬出当前块结果
        }
    }

private:
    __aicore__ inline void CopyIn(uint32_t offset, uint32_t curLength)
    {
        // 为 LocalTensor 分配内存
        AscendC::LocalTensor<T> xLocal = inQueueX.AllocTensor<T>();
        AscendC::LocalTensor<T> yLocal = inQueueY.AllocTensor<T>();
        // 从 Global Memory 搬入数据到 Local Memory
        AscendC::DataCopy(xLocal, xGm[offset], curLength);
        AscendC::DataCopy(yLocal, yGm[offset], curLength);
        // 将数据放入队列，通知 Compute 任务
        inQueueX.EnQue(xLocal);
        inQueueY.EnQue(yLocal);
    }

    __aicore__ inline void Compute(uint32_t curLength)
    {
        // 从输入队列获取数据
        AscendC::LocalTensor<T> xLocal = inQueueX.DeQue<T>();
        AscendC::LocalTensor<T> yLocal = inQueueY.DeQue<T>();
        // 为计算结果分配内存
        AscendC::LocalTensor<T> zLocal = outQueueZ.AllocTensor<T>();
        // 执行矢量减法计算：z = x - y
        AscendC::Sub(zLocal, xLocal, yLocal, curLength);
        // 将计算结果放入输出队列，通知 CopyOut 任务
        outQueueZ.EnQue<T>(zLocal);
        // 释放输入数据内存（重要：避免内存泄漏）
        inQueueX.FreeTensor(xLocal);
        inQueueY.FreeTensor(yLocal);
    }

    __aicore__ inline void CopyOut(uint32_t offset, uint32_t curLength)
    {
        // 从输出队列获取计算结果
        AscendC::LocalTensor<T> zLocal = outQueueZ.DeQue<T>();
        // 将结果从 Local Memory 搬出到 Global Memory
        AscendC::DataCopy(zGm[offset], zLocal, curLength);
        // 释放输出数据内存
        outQueueZ.FreeTensor(zLocal);
    }

private:
    AscendC::TPipe pipe;  // TPipe 内存管理对象
    AscendC::TQue<AscendC::QuePosition::VECIN, QUEUE_DEPTH> inQueueX, inQueueY;  // 输入数据队列管理对象，VECIN 位置
    AscendC::TQue<AscendC::QuePosition::VECOUT, QUEUE_DEPTH> outQueueZ;  // 输出数据队列管理对象，VECOUT 位置
    AscendC::GlobalTensor<T> xGm, yGm, zGm; // 管理输入输出 Global Memory 地址的对象，其中 xGm、yGm 为输入，zGm 为输出

    uint32_t blockOffset; // 本核在整块张量中的起始元素偏移
    uint32_t blockLength; // 每核处理的元素数
    uint32_t tileLength;  // 单核内每块元素数，类似 batch size
};

// ---------------------------------------------------------------------------
// 核函数入口：实例化 KernelSub<T> 并执行（T 由 run_kernel 按输入 dtype 选择）
// ---------------------------------------------------------------------------
template <typename T>
__global__ __vector__ void sub_custom(GM_ADDR x, GM_ADDR y, GM_ADDR z, SubCustomTilingData tiling)
{
    KernelSub<T> op;
    op.Init(x, y, z, tiling);
    op.Process();
}

// ---------------------------------------------------------------------------
// host 侧启动函数：从 TensorGroupInfo 推导 tiling 并启动核函数
// ---------------------------------------------------------------------------
extern "C" void run_kernel(GM_ADDR x, const TensorGroupInfo& info_x, GM_ADDR y, const TensorGroupInfo& info_y, GM_ADDR z, const TensorGroupInfo& info_z, int64_t availableCoreNum, aclrtStream stream)
{
    constexpr uint32_t MAX_BLOCK_DIM = 8;
    // 1. 取总元素数（x/y/z 形状一致）
    const TensorInfo& t0 = info_x.tensors[0];
    int64_t totalLength = 1;
    for (int64_t i = 0; i < t0.numDims; i++) {
        totalLength *= t0.shape[i];
    }
    if (totalLength <= 0) {
        return;
    }
    // 2. 按输入 dtype 选择核函数实例（dtype 定义见 TensorInfo：0=fp32 1=fp16 2=bf16 ...）
    int32_t dtype = t0.dtype;
    // 为了简化计算，tileNum 设置为 8
    uint32_t tileNum = 8;

    // 3. 确定多核并行度：不超过可用的 Vector 核数，且取 2 的幂以便按核均分
    uint32_t blockDim = MAX_BLOCK_DIM;
    if (availableCoreNum > 0 && (uint32_t)availableCoreNum < blockDim) {
        blockDim = (uint32_t)availableCoreNum;
    }
    while (blockDim > 1 && (blockDim & (blockDim - 1)) != 0) {
        blockDim >>= 1;
    }

    SubCustomTilingData tiling = {(uint32_t)totalLength, tileNum};
    if (dtype == 1) {
        // fp16：half 实例
        sub_custom<half><<<blockDim, nullptr, stream>>>(x, y, z, tiling);
    } else {
        // fp32 及其他类型默认走 float 实例
        sub_custom<float><<<blockDim, nullptr, stream>>>(x, y, z, tiling);
    }
}
