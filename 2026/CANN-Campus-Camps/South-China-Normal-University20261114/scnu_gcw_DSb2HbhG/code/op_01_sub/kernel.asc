#include <cmath>
#include "kernel_operator.h"

/*
 * Sub Kernel - Ascend C direct invocation
 *   z = x - y, x/y/z are (8, 2048), dtype float32 or float16.
 *
 * Work decomposition:
 *   - 8 AI cores, each core owns blockLength = totalLength / 8 elements.
 *   - Inside one core the data is split into tileNum(8) * BUFFER_NUM(2)
 *     tiles, so tileLength = 2048 / 8 / 2 = 128 elements.
 *   - Pipeline per tile: CopyIn (GM -> UB) -> Sub (Vector) -> CopyOut (UB -> GM).
 *
 * Note: this file is #included by main.asc, so it must NOT define main(),
 *       #pragma once or include guards.
 */

struct SubCustomTilingData {
    uint32_t totalLength;  // total element count, e.g. 8 * 2048 = 16384
    uint32_t tileNum;      // number of tiles per core (before double buffering)
};

constexpr uint32_t BUFFER_NUM = 2;   // double buffer
constexpr uint32_t QUEUE_DEPTH = 1;  // one tensor in flight per queue

template <typename T>
class KernelSub {
public:
    __aicore__ inline KernelSub() {}

    __aicore__ inline void Init(GM_ADDR x, GM_ADDR y, GM_ADDR z, const SubCustomTilingData& tiling)
    {
        uint32_t totalLength = tiling.totalLength;
        this->tileNum = tiling.tileNum;

        // 1. Multi-core split: 16384 / 8 = 2048 elements per core.
        this->blockLength = totalLength / AscendC::GetBlockNum();

        // 2. Tile split inside one core: 2048 / 8 / 2 = 128 elements per tile.
        this->tileLength = this->blockLength / this->tileNum / BUFFER_NUM;

        // 3. Each core binds its own slice of GM (element offset, not byte offset).
        uint32_t gmOffset = this->blockLength * AscendC::GetBlockIdx();
        xGm.SetGlobalBuffer((__gm__ T *)x + gmOffset, this->blockLength);
        yGm.SetGlobalBuffer((__gm__ T *)y + gmOffset, this->blockLength);
        zGm.SetGlobalBuffer((__gm__ T *)z + gmOffset, this->blockLength);

        // 4. UB buffers: BUFFER_NUM blocks per queue, tileLength elements each.
        pipe.InitBuffer(inQueueX, BUFFER_NUM, this->tileLength * sizeof(T));
        pipe.InitBuffer(inQueueY, BUFFER_NUM, this->tileLength * sizeof(T));
        pipe.InitBuffer(outQueueZ, BUFFER_NUM, this->tileLength * sizeof(T));
    }

    __aicore__ inline void Process()
    {
        // tileNum tiles * BUFFER_NUM (double buffer) = 16 iterations.
        uint32_t loopCount = this->tileNum * BUFFER_NUM;
        for (uint32_t i = 0; i < loopCount; ++i) {
            CopyIn(i);
            Compute(i);
            CopyOut(i);
        }
    }

private:
    __aicore__ inline void CopyIn(uint32_t progress)
    {
        AscendC::LocalTensor<T> xLocal = inQueueX.AllocTensor<T>();
        AscendC::LocalTensor<T> yLocal = inQueueY.AllocTensor<T>();

        // Offset of tile `progress` inside this core.
        AscendC::DataCopy(xLocal, xGm[progress * this->tileLength], this->tileLength);
        AscendC::DataCopy(yLocal, yGm[progress * this->tileLength], this->tileLength);

        inQueueX.EnQue(xLocal);
        inQueueY.EnQue(yLocal);
    }

    __aicore__ inline void Compute(uint32_t progress)
    {
        AscendC::LocalTensor<T> xLocal = inQueueX.DeQue<T>();
        AscendC::LocalTensor<T> yLocal = inQueueY.DeQue<T>();
        AscendC::LocalTensor<T> zLocal = outQueueZ.AllocTensor<T>();

        // z = x - y, element-wise on tileLength elements.
        AscendC::Sub(zLocal, xLocal, yLocal, this->tileLength);

        outQueueZ.EnQue<T>(zLocal);
        // Release input tensors, otherwise UB is exhausted after a few tiles.
        inQueueX.FreeTensor(xLocal);
        inQueueY.FreeTensor(yLocal);
    }

    __aicore__ inline void CopyOut(uint32_t progress)
    {
        AscendC::LocalTensor<T> zLocal = outQueueZ.DeQue<T>();
        AscendC::DataCopy(zGm[progress * this->tileLength], zLocal, this->tileLength);
        outQueueZ.FreeTensor(zLocal);
    }

private:
    AscendC::TPipe pipe;
    AscendC::TQue<AscendC::QuePosition::VECIN, QUEUE_DEPTH> inQueueX, inQueueY;
    AscendC::TQue<AscendC::QuePosition::VECOUT, QUEUE_DEPTH> outQueueZ;
    AscendC::GlobalTensor<T> xGm, yGm, zGm;

    uint32_t blockLength;  // elements handled by one core
    uint32_t tileNum;      // tiles per core
    uint32_t tileLength;   // elements per tile
};

template <typename T>
__global__ __vector__ void sub_custom(GM_ADDR x, GM_ADDR y, GM_ADDR z, SubCustomTilingData tiling)
{
    KernelSub<T> op;
    op.Init(x, y, z, tiling);
    op.Process();
}

extern "C" void run_kernel(GM_ADDR x, const TensorGroupInfo& info_x, GM_ADDR y, const TensorGroupInfo& info_y,
                           GM_ADDR z, const TensorGroupInfo& info_z, int64_t availableCoreNum, aclrtStream stream)
{
    (void)availableCoreNum;
    (void)info_y;
    (void)info_z;

    constexpr uint32_t blockDim = 8;  // 16384 is divisible by 8, so every core gets 2048 elements

    // 1. Total element count from the input shape (x/y/z share the same shape).
    const TensorInfo& t0 = info_x.tensors[0];
    int64_t totalLength = 1;
    for (int64_t i = 0; i < t0.numDims; ++i) {
        totalLength *= t0.shape[i];
    }

    // 2. Dispatch by dtype: 0 = fp32, 1 = fp16 (bf16/others are out of scope here).
    SubCustomTilingData tiling = {(uint32_t)totalLength, 8};
    if (t0.dtype == 1) {
        sub_custom<half><<<blockDim, nullptr, stream>>>(x, y, z, tiling);
    } else {
        sub_custom<float><<<blockDim, nullptr, stream>>>(x, y, z, tiling);
    }
}