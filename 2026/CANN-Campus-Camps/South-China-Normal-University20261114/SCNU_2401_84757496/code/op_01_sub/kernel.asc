#include <cmath>
#include "kernel_operator.h"

// Tiling 参数：由 host 侧 run_kernel 计算后按值传给核函数
struct SubCustomTilingData {
    uint32_t totalLength; // 待处理数据总长度（单位：元素个数），例如 8 * 2048
    uint32_t tileNum;     // 单核内将数据进一步切分为多少块（Tile），例如 8
};
constexpr uint32_t BUFFER_NUM = 2;   // 每队列 buffer 块数（注意：QUEUE_DEPTH 为 1，无流水重叠）
constexpr uint32_t QUEUE_DEPTH = 2;
constexpr uint32_t UB_BUDGET = 64 * 1024;


// KernelSub：z = x - y，每核按 tileNum × BUFFER_NUM 分块循环计算（模板化，支持 float / half 等类型）
template <typename T>
class KernelSub {
public:
    __aicore__ inline KernelSub() {}

    __aicore__ inline void Init(GM_ADDR x, GM_ADDR y, GM_ADDR z, const SubCustomTilingData& tiling)
    {
        uint32_t totalLength = tiling.totalLength;
        uint32_t blockNum = AscendC::GetBlockNum();
        uint32_t blockIdx = AscendC::GetBlockIdx();
        uint32_t alignElem = 32 / sizeof(T);

        // 计算每个核处理的数据长度（多核并行）
        uint32_t blockLength = (totalLength / blockNum / alignElem) * alignElem;
        if (blockLength == 0) {
            if (blockIdx != 0) {
                this->curLength = 0;
                return;
            }
            blockLength = totalLength;
        }

        uint32_t start = blockIdx * blockLength;
        if (start >= totalLength) {
            this->curLength = 0;
            return;
        }

        uint32_t end = start + blockLength;
        if (blockIdx == blockNum - 1 || end > totalLength) {
            end = totalLength;
        }
        this->curLength = end - start;

        uint32_t maxTile = (UB_BUDGET / (3 * BUFFER_NUM * sizeof(T))) / alignElem * alignElem;
        if (maxTile < alignElem) {
            maxTile = alignElem;
        }

        this->tileLength = maxTile < this->curLength ? maxTile : this->curLength;
        this->tileLength = (this->tileLength / alignElem) * alignElem;
        if (this->tileLength < alignElem) {
            this->tileLength = alignElem;
        }

        // 设置每个核的 Global Memory 起始地址（关键的多核切分逻辑）
        xGm.SetGlobalBuffer((__gm__ T*)x + start, this->curLength);
        yGm.SetGlobalBuffer((__gm__ T*)y + start, this->curLength);
        zGm.SetGlobalBuffer((__gm__ T*)z + start, this->curLength);
        // 为队列分配 UB 内存（单核内分块处理的基础）
        pipe.InitBuffer(inQueueX, BUFFER_NUM, this->tileLength * sizeof(T));
        pipe.InitBuffer(inQueueY, BUFFER_NUM, this->tileLength * sizeof(T));
        pipe.InitBuffer(outQueueZ, BUFFER_NUM, this->tileLength * sizeof(T));
    }

    __aicore__ inline void Process()
    {
        if (this->curLength == 0) {
           return;
        }
        // 循环次数
         uint32_t loopCount = (this->curLength + this->tileLength - 1) / this->tileLength;
        uint32_t pre = BUFFER_NUM < loopCount ? BUFFER_NUM : loopCount;

        // 依次处理每个数据块
        for (uint32_t i = 0; i < pre; ++i) {
            CopyIn(i);
        }

        for (uint32_t i = 0; i < loopCount; ++i) {
            Compute(i);
            CopyOut(i);

            uint32_t next = i + BUFFER_NUM;
            if (next < loopCount) {
                CopyIn(next);
            }
        }
    }

private:
    __aicore__ inline uint32_t GetCopyLen(uint32_t progress)
    {
        uint32_t offset = progress * this->tileLength;
        uint32_t remain = this->curLength - offset;
        return this->tileLength < remain ? this->tileLength : remain;
    }
    __aicore__ inline void CopyIn(int32_t progress)
    {
        uint32_t copyLen = GetCopyLen(progress);
        // 为 LocalTensor 分配内存
        AscendC::LocalTensor<T> xLocal = inQueueX.AllocTensor<T>();
        AscendC::LocalTensor<T> yLocal = inQueueY.AllocTensor<T>();
        // 计算当前数据块的起始位置，从 Global Memory 搬入数据到 Local Memory
        AscendC::DataCopy(xLocal, xGm[progress * this->tileLength], copyLen );
        AscendC::DataCopy(yLocal, yGm[progress * this->tileLength], copyLen);
        // 将数据放入队列，通知 Compute 任务
        inQueueX.EnQue(xLocal);
        inQueueY.EnQue(yLocal);
    }

    __aicore__ inline void Compute(int32_t progress)
    {
        uint32_t copyLen = GetCopyLen(progress);
        // 从输入队列获取数据
        AscendC::LocalTensor<T> xLocal = inQueueX.DeQue<T>();
        AscendC::LocalTensor<T> yLocal = inQueueY.DeQue<T>();
        // 为计算结果分配内存
        AscendC::LocalTensor<T> zLocal = outQueueZ.AllocTensor<T>();
        // 执行矢量减法计算
        AscendC::Sub(zLocal, xLocal, yLocal,copyLen);
        // 将计算结果放入输出队列，通知 CopyOut 任务
        outQueueZ.EnQue<T>(zLocal);
        // 释放输入数据内存（重要：避免内存泄漏）
        inQueueX.FreeTensor(xLocal);
        inQueueY.FreeTensor(yLocal);
    }

    __aicore__ inline void CopyOut(int32_t progress)
    {
        uint32_t copyLen = GetCopyLen(progress);
        // 从输出队列获取计算结果
        AscendC::LocalTensor<T> zLocal = outQueueZ.DeQue<T>();
        // 计算当前数据块的输出位置，将结果从 Local Memory 搬出到 Global Memory
        AscendC::DataCopy(zGm[progress * this->tileLength], zLocal, copyLen);
        // 释放输出数据内存
        outQueueZ.FreeTensor(zLocal);
    }

private:
    AscendC::TPipe pipe;  // TPipe 内存管理对象
    AscendC::TQue<AscendC::QuePosition::VECIN, QUEUE_DEPTH> inQueueX, inQueueY;  // 输入数据队列管理对象，VECIN 位置
    AscendC::TQue<AscendC::QuePosition::VECOUT, QUEUE_DEPTH> outQueueZ;  // 输出数据队列管理对象，VECOUT 位置
    AscendC::GlobalTensor<T> xGm, yGm, zGm; // 管理输入输出 Global Memory 地址的对象，其中 xGm、yGm 为输入，zGm 为输出

    uint32_t curLength;
    uint32_t tileLength;
};

// ---------------------------------------------------------------------------
// 核函数入口：实例化 KernelAdd<T> 并执行（T 由 run_kernel 按输入 dtype 选择）
// ---------------------------------------------------------------------------
template <typename T>
__global__ __vector__ void sub_custom(GM_ADDR x, GM_ADDR y, GM_ADDR z, SubCustomTilingData tiling)
{
    KernelSub<T> op;
    op.Init(x, y, z, tiling);
    op.Process();
}
extern "C" void run_kernel(GM_ADDR x, const TensorGroupInfo& info_x, GM_ADDR y, const TensorGroupInfo& info_y, GM_ADDR z, const TensorGroupInfo& info_z, int64_t availableCoreNum, aclrtStream stream)
{
    constexpr uint32_t blockDim = 8;
    // 1. 取总元素数（x/y/z 形状一致）
    const TensorInfo& t0 = info_x.tensors[0];
    int64_t totalLength = 1;
    for (int64_t i = 0; i < t0.numDims; i++) {
        totalLength *= t0.shape[i];
    }
    // 2. 按输入 dtype 选择核函数实例（dtype 定义见 TensorInfo：0=fp32 1=fp16 2=bf16 ...）
    int32_t dtype = t0.dtype;
    // 为了简化计算，tileNum 设置为 8
    uint32_t tileNum = 8;

    SubCustomTilingData tiling = {(uint32_t)totalLength, tileNum};
    if (dtype == 1) {
        // fp16：half 实例
        sub_custom<half><<<blockDim, nullptr, stream>>>(x, y, z, tiling);
    } else {
        // fp32 及其他类型默认走 float 实例
        sub_custom<float><<<blockDim, nullptr, stream>>>(x, y, z, tiling);
    }
}