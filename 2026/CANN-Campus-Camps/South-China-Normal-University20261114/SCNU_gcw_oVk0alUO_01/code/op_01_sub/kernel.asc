#include <cmath>
#include "kernel_operator.h"
/*
 * Sub Kernel — Ascend C Direct Invocation
 * This file is #included — do NOT add main(), #pragma once, or include guards.
 *
 * TensorGroupInfo / TensorInfo (predefined):
 *   struct TensorInfo { const int64_t* shape; int64_t numDims; int32_t dtype; };
 *   struct TensorGroupInfo { const TensorInfo* tensors; int64_t numTensors; };
 *   dtype: 0=fp32 1=fp16 2=bf16 3=int8 4=int16 5=int32 6=int64 7=uint8 8=uint16 9=uint32 10=uint64 11=bool
 *   Usage: info_x.tensors[0].shape[0]  // first dim of first tensor in input x
 */

// ---------------------------------------------------------------------------
// Tiling 参数：由 host 侧 run_kernel 计算后按值传给核函数
// ---------------------------------------------------------------------------
struct SubCustomTilingData {
    uint32_t totalLength; // 待处理数据总长度（单位：元素个数），例如 8 * 2048
    uint32_t tileNum;     // 兼容字段：TBuf 单块模式下不使用，保留以兼容调用框架
};

// ---------------------------------------------------------------------------
// KernelSub：z = x - y，TBuf 无队列单块处理（性能优化版 v2）
//
// 关键点：LocalTensor 在 Process 函数内部获取并使用（不跨函数、不存成员），
// 使 DataCopy -> Sub -> DataCopy 的完整依赖链在同一个函数内呈现，
// 编译器可插入精确的 MTE2->V / V->MTE3 事件同步（而非保守的全流水同步），
// 同时免除 TQue 队列的 EnQue/DeQue/AllocTensor/FreeTensor 全部管理开销。
// ---------------------------------------------------------------------------
template <typename T>
class KernelSub {
public:
    __aicore__ inline KernelSub() {}

    __aicore__ inline void Init(GM_ADDR x, GM_ADDR y, GM_ADDR z, const SubCustomTilingData& tiling)
    {
        uint32_t totalLength = tiling.totalLength;
        // 每个核处理的数据长度（多核并行）
        this->blockLength = totalLength / AscendC::GetBlockNum();
        uint32_t offset = this->blockLength * AscendC::GetBlockIdx();
        // 设置每个核的 Global Memory 起始地址（关键的多核切分逻辑）
        xGm.SetGlobalBuffer((__gm__ T *)x + offset, this->blockLength);
        yGm.SetGlobalBuffer((__gm__ T *)y + offset, this->blockLength);
        zGm.SetGlobalBuffer((__gm__ T *)z + offset, this->blockLength);
        // UB 缓冲：TBuf 无队列同步开销，数据量小时整块一次处理
        pipe.InitBuffer(xBuf, this->blockLength * sizeof(T));
        pipe.InitBuffer(yBuf, this->blockLength * sizeof(T));
        pipe.InitBuffer(zBuf, this->blockLength * sizeof(T));
    }

    __aicore__ inline void Process()
    {
        // 函数内局部获取 LocalTensor，保证编译器可分析完整依赖链
        AscendC::LocalTensor<T> xLocal = xBuf.Get<T>();
        AscendC::LocalTensor<T> yLocal = yBuf.Get<T>();
        AscendC::LocalTensor<T> zLocal = zBuf.Get<T>();

        // 搬入 -> 计算 -> 搬出（依赖同步由编译器按同函数内依赖链精确插入）
        AscendC::DataCopy(xLocal, xGm, this->blockLength);
        AscendC::DataCopy(yLocal, yGm, this->blockLength);
        AscendC::Sub(zLocal, xLocal, yLocal, this->blockLength);
        AscendC::DataCopy(zGm, zLocal, this->blockLength);
    }

private:
    AscendC::TPipe pipe;                                    // TPipe 内存管理对象
    AscendC::TBuf<AscendC::TPosition::VECIN> xBuf, yBuf;    // 输入缓冲（无队列）
    AscendC::TBuf<AscendC::TPosition::VECOUT> zBuf;         // 输出缓冲（无队列）
    AscendC::GlobalTensor<T> xGm, yGm, zGm;                 // Global Memory 视图
    uint32_t blockLength;                                   // 每个核的计算数据长度
};

// ---------------------------------------------------------------------------
// 核函数入口：实例化 KernelSub<T> 并执行（T 由 run_kernel 按输入 dtype 选择）
// ---------------------------------------------------------------------------
template <typename T>
__global__ __vector__ void sub_custom(GM_ADDR x, GM_ADDR y, GM_ADDR z, SubCustomTilingData tiling)
{
    KernelSub<T> op;
    op.Init(x, y, z, tiling);
    op.Process();
}

// ---------------------------------------------------------------------------
// host 侧启动函数：从 TensorGroupInfo 推导 tiling 并启动核函数
// ---------------------------------------------------------------------------
extern "C" void run_kernel(GM_ADDR x, const TensorGroupInfo& info_x, GM_ADDR y, const TensorGroupInfo& info_y, GM_ADDR z, const TensorGroupInfo& info_z, int64_t availableCoreNum, aclrtStream stream)
{
    constexpr uint32_t blockDim = 8;
    // 1. 取总元素数（x/y/z 形状一致）
    const TensorInfo& t0 = info_x.tensors[0];
    int64_t totalLength = 1;
    for (int64_t i = 0; i < t0.numDims; i++) {
        totalLength *= t0.shape[i];
    }
    // 2. 按输入 dtype 选择核函数实例（dtype 定义见 TensorInfo：0=fp32 1=fp16 2=bf16 ...）
    int32_t dtype = t0.dtype;
    // tileNum 为兼容字段（TBuf 单块模式不使用），保留 1
    uint32_t tileNum = 1;

    SubCustomTilingData tiling = {(uint32_t)totalLength, tileNum};
    if (dtype == 1) {
        // fp16：half 实例
        sub_custom<half><<<blockDim, nullptr, stream>>>(x, y, z, tiling);
    } else {
        // fp32 及其他类型默认走 float 实例
        sub_custom<float><<<blockDim, nullptr, stream>>>(x, y, z, tiling);
    }
}
