#include <cmath>
#include "kernel_operator.h"

// ---------------------------------------------------------------------------
// Tiling 参数：由 host 侧 run_kernel 计算后按值传给核函数
// ---------------------------------------------------------------------------
struct SubCustomTilingData {
    uint32_t totalLength; // 待处理数据总长度（单位：元素个数），例如 8 * 2048
    uint32_t tileNum;     // 单核内将数据进一步切分为多少块（Tile）
};

// 单缓冲：本题数据量很小（每核仅几 KB），一次“搬入-计算-搬出”即可完成，
// 单趟处理的搬运指令数与队列同步事件数最少；若输入更大，host 侧会自动多分几块（见 run_kernel）
constexpr uint32_t BUFFER_NUM = 1;
constexpr uint32_t QUEUE_DEPTH = 1;

// ---------------------------------------------------------------------------
// KernelSub：z = x - y（模板化，支持 float / half 等类型）
// 优化点：
//   1. x / y 两路输入合并到一个输入队列、一块连续 UB 缓冲，
//      Alloc/EnQue/DeQue/Free 及事件同步指令减半；
//   2. 每核单趟处理（tileNum=1、单缓冲），循环与队列操作次数降到最少；
//   3. host 侧尽量多用核、尽量放大 tile（见 run_kernel）。
// ---------------------------------------------------------------------------
template <typename T>
class KernelSub {
public:
    __aicore__ inline KernelSub() {}

    __aicore__ inline void Init(GM_ADDR x, GM_ADDR y, GM_ADDR z, const SubCustomTilingData& tiling)
    {
        // 每核只执行一次，仍缓存成局部变量，减少标量指令
        const uint32_t coreNum = AscendC::GetBlockNum();
        const uint32_t coreIdx = AscendC::GetBlockIdx();
        // 每核处理的数据长度（总数据均分给各核）
        this->blockLength = tiling.totalLength / coreNum;
        // 单核内分块数
        this->tileNum = tiling.tileNum;
        // 每块元素数
        this->tileLength = this->blockLength / this->tileNum / BUFFER_NUM;
        // 每个核按核编号偏移，只访问自己负责的 GM 数据段（多核切分）
        const uint64_t offset = (uint64_t)this->blockLength * coreIdx;
        xGm.SetGlobalBuffer((__gm__ T *)x + offset, this->blockLength);
        yGm.SetGlobalBuffer((__gm__ T *)y + offset, this->blockLength);
        zGm.SetGlobalBuffer((__gm__ T *)z + offset, this->blockLength);
        // 输入队列：一块缓冲前半放 x、后半放 y（两路输入一次队列操作统一管理）
        pipe.InitBuffer(inQueueXY, BUFFER_NUM, 2 * this->tileLength * sizeof(T));
        // 输出队列
        pipe.InitBuffer(outQueueZ, BUFFER_NUM, this->tileLength * sizeof(T));
    }

    __aicore__ inline void Process()
    {
        // 循环次数 = tileNum × BUFFER_NUM（规格输入下为 1，单趟完成）
        int32_t loopCount = this->tileNum * BUFFER_NUM;
        for (int32_t i = 0; i < loopCount; i++) {
            CopyIn(i);    // 搬入第 i 块数据
            Compute(i);   // 计算第 i 块数据
            CopyOut(i);   // 搬出第 i 块结果
        }
    }

private:
    __aicore__ inline void CopyIn(int32_t progress)
    {
        // 一次 Alloc 同时得到 x、y 两路输入内存（前 tileLength 个元素为 x，其后为 y）
        AscendC::LocalTensor<T> xyLocal = inQueueXY.AllocTensor<T>();
        AscendC::LocalTensor<T> xLocal = xyLocal;
        AscendC::LocalTensor<T> yLocal = xyLocal[this->tileLength];
        // 从 Global Memory 异步搬入当前块的两路输入
        AscendC::DataCopy(xLocal, xGm[progress * this->tileLength], this->tileLength);
        AscendC::DataCopy(yLocal, yGm[progress * this->tileLength], this->tileLength);
        // 一次 EnQue 的同步事件同时覆盖 x、y 两路搬运完成
        inQueueXY.EnQue(xyLocal);
    }

    __aicore__ inline void Compute(int32_t progress)
    {
        // 一次 DeQue 同时取出 x、y 两路数据
        AscendC::LocalTensor<T> xyLocal = inQueueXY.DeQue<T>();
        AscendC::LocalTensor<T> xLocal = xyLocal;
        AscendC::LocalTensor<T> yLocal = xyLocal[this->tileLength];
        // 为计算结果分配内存
        AscendC::LocalTensor<T> zLocal = outQueueZ.AllocTensor<T>();
        // 矢量减法：z = x - y
        AscendC::Sub(zLocal, xLocal, yLocal, this->tileLength);
        // 结果入输出队列，通知 CopyOut
        outQueueZ.EnQue<T>(zLocal);
        // 一次 FreeTensor 同时释放 x、y 的输入内存
        inQueueXY.FreeTensor(xyLocal);
    }

    __aicore__ inline void CopyOut(int32_t progress)
    {
        // 取出计算结果，搬出到 Global Memory 对应位置
        AscendC::LocalTensor<T> zLocal = outQueueZ.DeQue<T>();
        AscendC::DataCopy(zGm[progress * this->tileLength], zLocal, this->tileLength);
        // 释放输出内存
        outQueueZ.FreeTensor(zLocal);
    }

private:
    AscendC::TPipe pipe;  // TPipe 内存管理对象
    AscendC::TQue<AscendC::QuePosition::VECIN, QUEUE_DEPTH> inQueueXY;   // 合并后的输入队列（x、y 共用）
    AscendC::TQue<AscendC::QuePosition::VECOUT, QUEUE_DEPTH> outQueueZ;  // 输出队列
    AscendC::GlobalTensor<T> xGm, yGm, zGm; // 输入输出 Global Memory 管理对象

    uint32_t blockLength; // 每核处理的元素数
    uint32_t tileNum;     // 单核内分块数
    uint32_t tileLength;  // 单核内每块元素数
};

// ---------------------------------------------------------------------------
// 核函数入口：实例化 KernelSub<T> 并执行（T 由 run_kernel 按输入 dtype 选择）
// ---------------------------------------------------------------------------
template <typename T>
__global__ __vector__ void sub_custom(GM_ADDR x, GM_ADDR y, GM_ADDR z, SubCustomTilingData tiling)
{
    KernelSub<T> op;
    op.Init(x, y, z, tiling);
    op.Process();
}

// ---------------------------------------------------------------------------
// host 侧启动函数：从 TensorGroupInfo 推导 tiling 并启动核函数
// ---------------------------------------------------------------------------
extern "C" void run_kernel(GM_ADDR x, const TensorGroupInfo& info_x, GM_ADDR y, const TensorGroupInfo& info_y, GM_ADDR z, const TensorGroupInfo& info_z, int64_t availableCoreNum, aclrtStream stream)
{
    // 1. 取总元素数（x/y/z 形状一致）
    const TensorInfo& t0 = info_x.tensors[0];
    int64_t totalLength = 1;
    for (int64_t i = 0; i < t0.numDims; i++) {
        totalLength *= t0.shape[i];
    }
    // 2. 按输入 dtype 选择核函数实例（dtype 定义见 TensorInfo：0=fp32 1=fp16 2=bf16 ...）
    int32_t dtype = t0.dtype;

    // 3. 优化点一：尽量多用核。只有当核数能整除总元素数（不产生尾块）时才启用，
    //    否则回退 8 核，正确性不受影响
    uint32_t blockDim = 8;
    if (availableCoreNum > 8) {
        uint32_t limit = (uint32_t)availableCoreNum;
        if (limit > 64) {
            limit = 64;
        }
        for (uint32_t cand = limit; cand > 8; cand--) {
            if (totalLength % cand == 0) {
                blockDim = cand;
                break;
            }
        }
    }

    // 4. 优化点二：tile 尽量大（理想情况每核单趟算完），同时限制单块不超过 32KB，
    //    保证三个队列的 UB 总占用不超过 96KB，遇到更大输入会自动多分几块而不会越界。
    //    约束：整除每核元素数（全覆盖）、单块字节数 32B 对齐（MTE 搬运要求）
    const uint32_t elemSize = (dtype == 1) ? 2u : 4u;
    const uint32_t elemPerCore = (uint32_t)(totalLength / blockDim);
    uint32_t tileNum = 8; // 兜底值（与原始模板一致）
    for (uint32_t n = 1; n <= elemPerCore; n++) {
        uint32_t tl = elemPerCore / n / BUFFER_NUM;
        if (tl == 0) {
            break; // 块已切到最小，停止
        }
        if (tl * n * BUFFER_NUM != elemPerCore) {
            continue; // 不能整除，换下一档
        }
        if ((tl * elemSize) % 32u != 0u) {
            continue; // 不满足 32B 对齐
        }
        if (tl * elemSize > 32768u) {
            continue; // 单块超 32KB，需继续切小
        }
        tileNum = n;
        break;
    }

    SubCustomTilingData tiling = {(uint32_t)totalLength, tileNum};
    if (dtype == 1) {
        // fp16：half 实例
        sub_custom<half><<<blockDim, nullptr, stream>>>(x, y, z, tiling);
    } else {
        // fp32 及其他类型默认走 float 实例
        sub_custom<float><<<blockDim, nullptr, stream>>>(x, y, z, tiling);
    }
}