#include <cmath>
#include "kernel_operator.h"

// 固定形状 (8, 2048)，支持 float32 / float16。
// 恢复 8 核，移除 TPipe、TBuf 和队列管理。
// 本版尚未实测，耗时以评测结果为准。
constexpr uint32_t SUB_CORE_NUM = 8;
constexpr uint32_t SUB_TOTAL_LENGTH = 8 * 2048;
constexpr uint32_t SUB_BLOCK_LENGTH =
    SUB_TOTAL_LENGTH / SUB_CORE_NUM;

template <typename T>
__global__ __vector__ void sub_custom(
    GM_ADDR x,
    GM_ADDR y,
    GM_ADDR z)
{
    constexpr uint32_t LENGTH = SUB_BLOCK_LENGTH;
    constexpr uint32_t BYTES = LENGTH * sizeof(T);

    const uint32_t offset = AscendC::GetBlockIdx() * LENGTH;

    AscendC::GlobalTensor<T> xGm;
    AscendC::GlobalTensor<T> yGm;
    AscendC::GlobalTensor<T> zGm;

    xGm.SetGlobalBuffer((__gm__ T*)x + offset, LENGTH);
    yGm.SetGlobalBuffer((__gm__ T*)y + offset, LENGTH);
    zGm.SetGlobalBuffer((__gm__ T*)z + offset, LENGTH);

    // 直接指定 UB 地址；地址单位为字节，长度单位为元素。
    AscendC::LocalTensor<T> xLocal(
        AscendC::TPosition::VECCALC, 0, LENGTH);

    AscendC::LocalTensor<T> yLocal(
        AscendC::TPosition::VECCALC, BYTES, LENGTH);

    AscendC::DataCopy(xLocal, xGm, LENGTH);
    AscendC::DataCopy(yLocal, yGm, LENGTH);

    AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);
    AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);

    // 原地计算，复用 xLocal 保存结果。
    AscendC::Sub(xLocal, xLocal, yLocal, LENGTH);

    AscendC::SetFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
    AscendC::WaitFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);

    AscendC::DataCopy(zGm, xLocal, LENGTH);

    // 不使用 TPipe，显式等待输出搬运完成。
    AscendC::SetFlag<AscendC::HardEvent::MTE3_S>(EVENT_ID0);
    AscendC::WaitFlag<AscendC::HardEvent::MTE3_S>(EVENT_ID0);
}

extern "C" void run_kernel(
    GM_ADDR x, const TensorGroupInfo& info_x,
    GM_ADDR y, const TensorGroupInfo& info_y,
    GM_ADDR z, const TensorGroupInfo& info_z,
    int64_t availableCoreNum,
    aclrtStream stream)
{
    if (info_x.tensors[0].dtype == 1) {
        sub_custom<half><<<SUB_CORE_NUM, nullptr, stream>>>(
            x, y, z);
    } else {
        sub_custom<float><<<SUB_CORE_NUM, nullptr, stream>>>(
            x, y, z);
    }
}