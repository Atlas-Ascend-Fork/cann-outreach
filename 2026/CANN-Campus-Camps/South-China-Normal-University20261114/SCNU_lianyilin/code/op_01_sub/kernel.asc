#include <cmath>
#include "kernel_operator.h"

struct SubCustomTilingData {
    uint64_t totalLength;
};

constexpr uint32_t ALIGN_BYTES = 32;
constexpr uint32_t TILE_BYTES = 8 * 1024;
constexpr uint32_t BUFFER_NUM = 2;
constexpr uint32_t QUEUE_DEPTH = 1;

template <typename T>
class KernelSub {
public:
    __aicore__ inline void Init(GM_ADDR x, GM_ADDR y, GM_ADDR z,
                                const SubCustomTilingData& tiling)
    {
        // 按 32 字节分配工作，只有最后一个核可能以不完整的块结束。
        constexpr uint32_t alignElems = ALIGN_BYTES / sizeof(T);
        const uint64_t length = tiling.totalLength;
        const uint64_t units = (length - 1) / alignElems + 1;
        const uint32_t cores = AscendC::GetBlockNum();
        const uint32_t core = AscendC::GetBlockIdx();
        const uint64_t base = units / cores;
        const uint32_t extra = units % cores;
        const uint64_t start = (core * base + (core < extra ? core : extra)) * alignElems;
        const uint64_t capacity = (base + (core < extra ? 1 : 0)) * alignElems;
        const uint64_t remaining = length - start;
        blockLength = remaining < capacity ? remaining : capacity;

        xGm.SetGlobalBuffer((__gm__ T*)x + start, blockLength);
        yGm.SetGlobalBuffer((__gm__ T*)y + start, blockLength);
        zGm.SetGlobalBuffer((__gm__ T*)z + start, blockLength);
        pipe.InitBuffer(inQueueX, BUFFER_NUM, TILE_BYTES);
        pipe.InitBuffer(inQueueY, BUFFER_NUM, TILE_BYTES);
        pipe.InitBuffer(outQueueZ, BUFFER_NUM, TILE_BYTES);
    }

    __aicore__ inline void Process()
    {
        constexpr uint32_t tileElems = TILE_BYTES / sizeof(T);
        for (uint64_t offset = 0; offset < blockLength; offset += tileElems) {
            const uint64_t remaining = blockLength - offset;
            const uint32_t count = remaining < tileElems ? remaining : tileElems;
            CopyIn(offset, count);
            Compute(count);
            CopyOut(offset, count);
        }
    }

private:
    __aicore__ inline void CopyIn(uint64_t offset, uint32_t count)
    {
        AscendC::LocalTensor<T> xLocal = inQueueX.AllocTensor<T>();
        AscendC::LocalTensor<T> yLocal = inQueueY.AllocTensor<T>();
        const uint32_t bytes = count * sizeof(T);
        if (bytes % ALIGN_BYTES == 0) {
            AscendC::DataCopy(xLocal, xGm[offset], count);
            AscendC::DataCopy(yLocal, yGm[offset], count);
        } else {
            // blockLen 的单位为字节。末块只读取实际输入范围。
            AscendC::DataCopyExtParams copyParams{1, bytes, 0, 0, 0};
            AscendC::DataCopyPadExtParams<T> padParams{};
            AscendC::DataCopyPad(xLocal, xGm[offset], copyParams, padParams);
            AscendC::DataCopyPad(yLocal, yGm[offset], copyParams, padParams);
        }
         inQueueX.EnQue(xLocal);
        inQueueY.EnQue(yLocal);
    }

    __aicore__ inline void Compute(uint32_t count)
    {
        AscendC::LocalTensor<T> xLocal = inQueueX.DeQue<T>();
        AscendC::LocalTensor<T> yLocal = inQueueY.DeQue<T>();
        AscendC::LocalTensor<T> zLocal = outQueueZ.AllocTensor<T>();
        AscendC::Sub(zLocal, xLocal, yLocal, count);
        outQueueZ.EnQue(zLocal);
        inQueueX.FreeTensor(xLocal);
        inQueueY.FreeTensor(yLocal);
    }

    __aicore__ inline void CopyOut(uint64_t offset, uint32_t count)
    {
        AscendC::LocalTensor<T> zLocal = outQueueZ.DeQue<T>();
        const uint32_t bytes = count * sizeof(T);
        if (bytes % ALIGN_BYTES == 0) {
            AscendC::DataCopy(zGm[offset], zLocal, count);
        } else {
            AscendC::DataCopyExtParams copyParams{1, bytes, 0, 0, 0};
            AscendC::DataCopyPad(zGm[offset], zLocal, copyParams);
        }
        outQueueZ.FreeTensor(zLocal);
    }

    AscendC::TPipe pipe;
    AscendC::TQue<AscendC::QuePosition::VECIN, QUEUE_DEPTH> inQueueX, inQueueY;
    AscendC::TQue<AscendC::QuePosition::VECOUT, QUEUE_DEPTH> outQueueZ;
    AscendC::GlobalTensor<T> xGm, yGm, zGm;
    uint64_t blockLength;
};

template <typename T>
__global__ __vector__ void sub_custom(GM_ADDR x, GM_ADDR y, GM_ADDR z, SubCustomTilingData tiling)
{
    KernelSub<T> op;
    op.Init(x, y, z, tiling);
    op.Process();
}

extern "C" void run_kernel(GM_ADDR x, const TensorGroupInfo& info_x,
                           GM_ADDR y, const TensorGroupInfo& info_y,
                           GM_ADDR z, const TensorGroupInfo& info_z,
                           int64_t availableCoreNum, aclrtStream stream)
{
    const TensorInfo& input = info_x.tensors[0];
    // 本题参考实现使用 FP32 (0) 和 FP16 (1)。
    if (input.dtype != 0 && input.dtype != 1) {
        return;
    }
    uint64_t totalLength = 1;
    for (int64_t i = 0; i < input.numDims; ++i) {
        totalLength *= input.shape[i];
    }
    if (totalLength == 0) {
        return;
    }

    // 沿用模板的 8 核上限，同时避免启动无数据可处理的核。
    const uint32_t alignElems = ALIGN_BYTES / (input.dtype == 1 ? sizeof(half) : sizeof(float));
    const uint64_t units = (totalLength - 1) / alignElems + 1;
    uint32_t blockDim = availableCoreNum > 0 && availableCoreNum < 8 ? availableCoreNum : 8;
    if (units < blockDim) {
        blockDim = static_cast<uint32_t>(units);
    }
    SubCustomTilingData tiling{totalLength};
    if (input.dtype == 1) {
        sub_custom<half><<<blockDim, nullptr, stream>>>(x, y, z, tiling);
    } else {
        sub_custom<float><<<blockDim, nullptr, stream>>>(x, y, z, tiling);
    }
}