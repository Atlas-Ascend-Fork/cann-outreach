#include "kernel_operator.h"

template <typename T>
__global__ __vector__ void sub_custom(GM_ADDR x, GM_ADDR y, GM_ADDR z,
                                      uint32_t rows)
{
    constexpr uint32_t cols = 2048;
    AscendC::GlobalTensor<T> xGm, yGm, zGm;
    xGm.SetGlobalBuffer((__gm__ T*)x, rows * cols);
    yGm.SetGlobalBuffer((__gm__ T*)y, rows * cols);
    zGm.SetGlobalBuffer((__gm__ T*)z, rows * cols);

    AscendC::TPipe pipe;
    AscendC::TQue<AscendC::TPosition::VECIN, 1> xQueue, yQueue;
    AscendC::TQue<AscendC::TPosition::VECOUT, 1> zQueue;
    pipe.InitBuffer(xQueue, 1, cols * sizeof(T));
    pipe.InitBuffer(yQueue, 1, cols * sizeof(T));
    pipe.InitBuffer(zQueue, 1, cols * sizeof(T));

    for (uint32_t row = AscendC::GetBlockIdx(); row < rows;
         row += AscendC::GetBlockNum()) {
        const uint32_t offset = row * cols;
        auto xLocal = xQueue.AllocTensor<T>();
        auto yLocal = yQueue.AllocTensor<T>();
        AscendC::DataCopy(xLocal, xGm[offset], cols);
        AscendC::DataCopy(yLocal, yGm[offset], cols);
        xQueue.EnQue(xLocal);
        yQueue.EnQue(yLocal);

        xLocal = xQueue.DeQue<T>();
        yLocal = yQueue.DeQue<T>();
        auto zLocal = zQueue.AllocTensor<T>();
        AscendC::Sub(zLocal, xLocal, yLocal, cols);
        zQueue.EnQue(zLocal);
        xQueue.FreeTensor(xLocal);
        yQueue.FreeTensor(yLocal);

        zLocal = zQueue.DeQue<T>();
        AscendC::DataCopy(zGm[offset], zLocal, cols);
        zQueue.FreeTensor(zLocal);
    }
}

extern "C" void run_kernel(GM_ADDR x, const TensorGroupInfo& info_x,
                           GM_ADDR y, const TensorGroupInfo& info_y,
                           GM_ADDR z, const TensorGroupInfo& info_z,
                           int64_t availableCoreNum, aclrtStream stream)
{
    const uint32_t rows = static_cast<uint32_t>(info_x.tensors[0].shape[0]);
    const uint32_t blocks = availableCoreNum < rows
                                ? static_cast<uint32_t>(availableCoreNum)
                                : rows;
    if (info_x.tensors[0].dtype == 0) {
        sub_custom<float><<<blocks, nullptr, stream>>>(x, y, z, rows);
    } else if (info_x.tensors[0].dtype == 1) {
        sub_custom<half><<<blocks, nullptr, stream>>>(x, y, z, rows);
    }
}