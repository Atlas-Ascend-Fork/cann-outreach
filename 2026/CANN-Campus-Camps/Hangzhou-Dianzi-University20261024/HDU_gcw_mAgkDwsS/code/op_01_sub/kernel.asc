#include <cmath>
#include "kernel_operator.h"
/*
 * Sub Kernel — Ascend C Direct Invocation
 * This file is #included — do NOT add main(), #pragma once, or include guards.
 *
 * TensorGroupInfo / TensorInfo (predefined):
 *   struct TensorInfo { const int64_t* shape; int64_t numDims; int32_t dtype; };
 *   struct TensorGroupInfo { const TensorInfo* tensors; int64_t numTensors; };
 *   dtype: 0=fp32 1=fp16 2=bf16 3=int8 4=int16 5=int32 6=int64 7=uint8 8=uint16 9=uint32 10=uint64 11=bool
 *   Usage: info_x.tensors[0].shape[0]  // first dim of first tensor in input x
 *
 * ---------------------------------------------------------------------------
 * 设计说明（为什么这么写）
 * ---------------------------------------------------------------------------
 * 1) 逐元素 z = x - y，x / y / z 同 shape、同 dtype、ND 连续排布，没有广播也没有
 *    步长走位，所以整块数据可以当成一维 totalLength 处理（与题面 3.1 一致）。
 * 2) 多核切分：每核 blockLength = totalLength / blockDim 个元素，各核基址 =
 *    全局基址 + blockLength * GetBlockIdx()，核与核之间不重叠、不遗漏。
 * 3) 核内分块：再把 blockLength 平分成 tileNum × BUFFER_NUM 个 tile
 *    （tileLength 已按 BUFFER_NUM 折半），配合 VECIN / VECOUT 队列完成
 *    「搬入 → 计算 → 搬出」。
 * 4) 对齐前提：DataCopy 要求「搬运字节数」和 UB 起始地址都是 32B 对齐。
 *    题面 shape 8*2048：fp32 下 tileLength*4 = 512B，fp16 下 256B，均对齐；
 *    各核基址偏移 blockLength*sizeof(T) = 8192B / 4096B，同样对齐。
 * 5) 精度：float 直接用矢量减法；half 也直接用矢量减法（与官方参考实现
 *    kernel_add.asc 用 AscendC::Add 处理 half 的做法一致，判分容差按半精度给）。
 *
 * 前置条件（由 host 侧 run_kernel 负责保证，见文件末尾）：
 *   totalLength 能被 blockDim × tileNum × BUFFER_NUM 整除。
 * ---------------------------------------------------------------------------
 */

// ---------------------------------------------------------------------------
// Tiling 参数：由 host 侧 run_kernel 计算后按值传给核函数
// ---------------------------------------------------------------------------
struct SubCustomTilingData {
    uint32_t totalLength; // 待处理数据总长度（单位：元素个数），例如 8 * 2048
    uint32_t tileNum;     // 单核内将数据进一步切分为多少块（Tile），例如 8
};

constexpr uint32_t BUFFER_NUM = 2;   // double buffer
constexpr uint32_t QUEUE_DEPTH = 1;

// ---------------------------------------------------------------------------
// KernelSub：z = x - y，每核分块循环计算（模板化，支持 float / half 等类型）
// ---------------------------------------------------------------------------
template <typename T>
class KernelSub {
public:
    __aicore__ inline KernelSub() {}

    __aicore__ inline void Init(GM_ADDR x, GM_ADDR y, GM_ADDR z, const SubCustomTilingData& tiling)
    {
        const uint32_t totalLength = tiling.totalLength;
        this->tileNum = tiling.tileNum;
        // 实际启动的核数（= host 侧 <<<blockDim, ...>>> 传入的 blockDim）
        const auto blockNum = AscendC::GetBlockNum();
        // 每个核处理的数据长度（多核并行）
        this->blockLength = (blockNum != 0) ? (uint32_t)(totalLength / blockNum) : 0u;
        // 单核内每个 tile 的元素数：blockLength 平分成 tileNum × BUFFER_NUM 份
        this->tileLength = (this->tileNum == 0) ? 0u
                                               : (this->blockLength / this->tileNum / BUFFER_NUM);
        if (this->tileLength == 0) {
            return;  // 兜底：tiling 退化（host 侧已保证正常输入不会走到这里）
        }
        // 设置每个核的 Global Memory 起始地址（关键的多核切分逻辑）
        xGm.SetGlobalBuffer((__gm__ T *)x + this->blockLength * AscendC::GetBlockIdx(), this->blockLength);
        yGm.SetGlobalBuffer((__gm__ T *)y + this->blockLength * AscendC::GetBlockIdx(), this->blockLength);
        zGm.SetGlobalBuffer((__gm__ T *)z + this->blockLength * AscendC::GetBlockIdx(), this->blockLength);
        // 为队列分配 UB 内存：每队列 BUFFER_NUM 个 tile，每个 tile 占 tileLength 个元素
        const uint32_t tileBytes = this->tileLength * (uint32_t)sizeof(T);
        pipe.InitBuffer(inQueueX, BUFFER_NUM, tileBytes);
        pipe.InitBuffer(inQueueY, BUFFER_NUM, tileBytes);
        pipe.InitBuffer(outQueueZ, BUFFER_NUM, tileBytes);
    }

    __aicore__ inline void Process()
    {
        if (this->tileLength == 0) {
            return;  // 兜底，同上
        }
        // 循环次数 = tileNum × BUFFER_NUM（tileLength 已按 BUFFER_NUM 折半）
        int32_t loopCount = this->tileNum * BUFFER_NUM;
        // 依次处理每个数据块
        for (int32_t i = 0; i < loopCount; i++) {
            CopyIn(i);    // 搬入第 i 块数据
            Compute(i);   // 计算第 i 块数据
            CopyOut(i);   // 搬出第 i 块结果
        }
    }

private:
    __aicore__ inline void CopyIn(int32_t progress)
    {
        // 为 LocalTensor 分配 UB 内存
        AscendC::LocalTensor<T> xLocal = inQueueX.AllocTensor<T>();
        AscendC::LocalTensor<T> yLocal = inQueueY.AllocTensor<T>();
        // 从 Global Memory 搬入当前分块：起始偏移 = progress * tileLength
        AscendC::DataCopy(xLocal, xGm[progress * this->tileLength], this->tileLength);
        AscendC::DataCopy(yLocal, yGm[progress * this->tileLength], this->tileLength);
        // 将数据放入队列，通知 Compute 任务
        inQueueX.EnQue(xLocal);
        inQueueY.EnQue(yLocal);
    }

    __aicore__ inline void Compute(int32_t progress)
    {
        (void)progress;
        // 从输入队列获取数据
        AscendC::LocalTensor<T> xLocal = inQueueX.DeQue<T>();
        AscendC::LocalTensor<T> yLocal = inQueueY.DeQue<T>();
        // 为计算结果分配 UB 内存
        AscendC::LocalTensor<T> zLocal = outQueueZ.AllocTensor<T>();
        // 执行矢量减法：z = x - y（逐元素）
        AscendC::Sub(zLocal, xLocal, yLocal, (int32_t)this->tileLength);
        // 将计算结果放入输出队列，通知 CopyOut 任务
        outQueueZ.EnQue<T>(zLocal);
        // 释放输入数据内存（重要：避免 UB 泄漏）
        inQueueX.FreeTensor(xLocal);
        inQueueY.FreeTensor(yLocal);
    }

    __aicore__ inline void CopyOut(int32_t progress)
    {
        // 从输出队列获取计算结果
        AscendC::LocalTensor<T> zLocal = outQueueZ.DeQue<T>();
        // 将结果从 Local Memory 搬出到 Global Memory 的对应位置
        AscendC::DataCopy(zGm[progress * this->tileLength], zLocal, this->tileLength);
        // 释放输出数据内存
        outQueueZ.FreeTensor(zLocal);
    }

private:
    AscendC::TPipe pipe;  // TPipe 内存管理对象
    AscendC::TQue<AscendC::QuePosition::VECIN, QUEUE_DEPTH> inQueueX, inQueueY;  // 输入数据队列管理对象，VECIN 位置
    AscendC::TQue<AscendC::QuePosition::VECOUT, QUEUE_DEPTH> outQueueZ;  // 输出数据队列管理对象，VECOUT 位置
    AscendC::GlobalTensor<T> xGm, yGm, zGm; // 管理输入输出 Global Memory 地址的对象，其中 xGm、yGm 为输入，zGm 为输出

    uint32_t blockLength; // 每个核的计算数据长度
    uint32_t tileNum; // 每个核需要计算的数据块个数，类似 batch 数量
    uint32_t tileLength; // 每个核内每个数据块的长度，类似 batch size
};

// ---------------------------------------------------------------------------
// 核函数入口：实例化 KernelSub<T> 并执行（T 由 run_kernel 按输入 dtype 选择）
// ---------------------------------------------------------------------------
template <typename T>
__global__ __vector__ void sub_custom(GM_ADDR x, GM_ADDR y, GM_ADDR z, SubCustomTilingData tiling)
{
    KernelSub<T> op;
    op.Init(x, y, z, tiling);
    op.Process();
}

// ---------------------------------------------------------------------------
// host 侧启动函数：从 TensorGroupInfo 推导 tiling 并启动核函数
// ---------------------------------------------------------------------------
extern "C" void run_kernel(GM_ADDR x, const TensorGroupInfo& info_x, GM_ADDR y, const TensorGroupInfo& info_y, GM_ADDR z, const TensorGroupInfo& info_z, int64_t availableCoreNum, aclrtStream stream)
{
    // 1. 取总元素数（x/y/z 形状一致；ND 连续，可当一维处理）
    const TensorInfo& t0 = info_x.tensors[0];
    int64_t totalLength = 1;
    for (int64_t i = 0; i < t0.numDims; i++) {
        totalLength *= t0.shape[i];
    }
    if (totalLength <= 0) {
        return;  // 空张量，不启动核函数
    }

    // 2. 选核数：默认 8；设备核数更少时取不超过它的 2 的幂（保证按 2 的幂整除切分）
    constexpr uint32_t kMaxBlockDim = 8;
    constexpr uint32_t kTileNum = 8;
    uint32_t blockDim = kMaxBlockDim;
    if (availableCoreNum > 0 && availableCoreNum < (int64_t)kMaxBlockDim) {
        blockDim = 1;
        while (blockDim * 2 <= (uint32_t)availableCoreNum) {
            blockDim *= 2;
        }
    }
    // 3. 选 tileNum：要求 totalLength 能被 blockDim × tileNum × BUFFER_NUM 整除，
    //    否则最后一个 tile 会越界或丢尾块。题面 shape 8*2048 下 16384 % (8*8*2) == 0，
    //    直接命中 tileNum = 8，与参考实现 kernel_add.asc 的参数完全一致。
    uint32_t tileNum = kTileNum;
    while (tileNum > 1 && (totalLength % (int64_t)(blockDim * tileNum * BUFFER_NUM)) != 0) {
        tileNum >>= 1;
    }

    // 4. 按输入 dtype 选择核函数实例（dtype 定义见 TensorInfo：0=fp32 1=fp16 2=bf16 ...）
    int32_t dtype = t0.dtype;
    SubCustomTilingData tiling = {(uint32_t)totalLength, tileNum};
    if (dtype == 1) {
        // fp16：half 实例
        sub_custom<half><<<blockDim, nullptr, stream>>>(x, y, z, tiling);
    } else {
        // fp32 及其他类型默认走 float 实例
        sub_custom<float><<<blockDim, nullptr, stream>>>(x, y, z, tiling);
    }
}