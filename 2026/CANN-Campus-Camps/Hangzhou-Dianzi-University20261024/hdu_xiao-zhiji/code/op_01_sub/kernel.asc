#include <cmath>
#include "kernel_operator.h"
/*
 * Sub Kernel — Ascend C Direct Invocation
 * This file is #included — do NOT add main(), #pragma once, or include guards.
 *
 * TensorGroupInfo / TensorInfo (predefined):
 *   struct TensorInfo { const int64_t* shape; int64_t numDims; int32_t dtype; };
 *   struct TensorGroupInfo { const TensorInfo* tensors; int64_t numTensors; };
 *   dtype: 0=fp32 1=fp16 2=bf16 3=int8 4=int16 5=int32 6=int64 7=uint8 8=uint16 9=uint32 10=uint64 11=bool
 *   Usage: info_x.tensors[0].shape[0]  // first dim of first tensor in input x
 *
 * 赛题 2254：矢量减法 z = x - y
 *   INPUT  x : (8, 2048)  float32 / float16  ND
 *   INPUT  y : (8, 2048)  float32 / float16  ND
 *   OUTPUT z : (8, 2048)  float32 / float16  ND
 *
 * 实现说明：
 *   - dtype 由 TensorInfo.dtype 分派：0 -> float（fp32），1 -> half（fp16）；
 *     其余 dtype 直接不启动（2/4 字节元素按错的宽度搬运会读穿缓冲区）。
 *     同一算子的 x / y / z 要求 dtype 一致，不一致时也不启动。
 *   - 输出元素数 N 取自 z（**不是** x）。形状一致（赛题给定的 (8,2048)）时走快路径；
 *     万一下发的是可广播形状，则走广播路径（按 Infershape4Broadcast 规则，被广播维 stride 记 0），
 *     避免按 x 的长度去读 y 而越过 y 的分配范围（AIV MTE 越界 -> 507035）。
 *   - 减法不满足交换律：dst = src0(x) - src1(y)，顺序不能反。
 *
 *   快路径：以 32B 为粒度切核（fp32 = 8 个元素，fp16 = 16 个元素），核内按 TILE_LEN
 *          分块流水 DataCopy/Sub/DataCopy，末段不足 32B 的部分用标量补齐；每核基址保持 32B 对齐。
 *   广播路径：逐元素由输出下标反推各输入的 stride 偏移，标量读写；同形状用例不会走到这里，
 *          因此不影响主路径性能。广播路径维数上限 MAX_RANK(4)，更高维直接返回（不越界、不崩溃）。
 *
 *   正确性：硬件 fp32/fp16 减法本身即“正确舍入”，而 fp16/fp32 两数之差在 float64 中可精确表示，
 *          所以与验算脚本 (x.astype(f64) - y.astype(f64)).astype(dtype) 的结果逐位一致。
 */

namespace sub_op {

constexpr uint32_t ALIGN_BYTES = 32U;   // 矢量搬运最小对齐字节数
constexpr uint32_t TILE_LEN    = 1024U; // 单次搬运元素数（fp32 4KB / fp16 2KB）
constexpr int32_t  BUF_NUM     = 1;     // 队列深度：单缓冲即可
constexpr int32_t  MAX_RANK    = 4;     // 广播路径支持的维数上限
constexpr int32_t  DTYPE_FP32  = 0;     // TensorInfo.dtype: 0=fp32
constexpr int32_t  DTYPE_FP16  = 1;     // TensorInfo.dtype: 1=fp16

// 取第 0 个张量的元素总数；shape 非法时返回 false
inline bool ElementCount(const TensorGroupInfo &info, uint64_t &count)
{
    if (info.numTensors <= 0 || info.tensors == nullptr) {
        return false;
    }
    const TensorInfo &tensor = info.tensors[0];
    if (tensor.numDims <= 0 || tensor.shape == nullptr) {
        return false;
    }
    uint64_t n = 1ULL;
    for (int64_t d = 0; d < tensor.numDims; ++d) {
        if (tensor.shape[d] <= 0) {
            return false;
        }
        n *= static_cast<uint64_t>(tensor.shape[d]);
    }
    count = n;
    return true;
}

// 取第 0 个张量的 dtype：info 非法时返回 -1
inline int32_t DtypeOf(const TensorGroupInfo &info)
{
    if (info.numTensors <= 0 || info.tensors == nullptr) {
        return -1;
    }
    return info.tensors[0].dtype;
}

// 按右对齐把 shape 填进 MAX_RANK 长度的数组（高位补 1）
inline bool PadShape(const TensorGroupInfo &info, int64_t *dims)
{
    if (info.numTensors <= 0 || info.tensors == nullptr) {
        return false;
    }
    const TensorInfo &tensor = info.tensors[0];
    if (tensor.numDims <= 0 || tensor.shape == nullptr || tensor.numDims > MAX_RANK) {
        return false;
    }
    const int64_t shift = MAX_RANK - tensor.numDims;
    for (int64_t d = 0; d < MAX_RANK; ++d) {
        dims[d] = 1;
    }
    for (int64_t d = 0; d < tensor.numDims; ++d) {
        if (tensor.shape[d] <= 0) {
            return false;
        }
        dims[shift + d] = tensor.shape[d];
    }
    return true;
}

// 计算某输入相对输出形状的 stride：该维被广播时为 0
inline bool BuildStrides(const TensorGroupInfo &info, const int64_t *outDims, uint32_t *strides)
{
    if (info.numTensors <= 0 || info.tensors == nullptr) {
        return false;
    }
    const TensorInfo &tensor = info.tensors[0];
    if (tensor.numDims <= 0 || tensor.shape == nullptr || tensor.numDims > MAX_RANK) {
        return false;
    }
    const int64_t shift = MAX_RANK - tensor.numDims;
    for (int64_t d = 0; d < MAX_RANK; ++d) {
        const int64_t src = d - shift;
        if (src < 0 || tensor.shape[src] == 1) {
            strides[d] = 0U;  // 该维被广播（或输入没有这一维）
            continue;
        }
        if (tensor.shape[src] != outDims[d]) {
            return false;     // 不满足广播规则
        }
        uint64_t stride = 1ULL;
        for (int64_t k = src + 1; k < tensor.numDims; ++k) {
            stride *= static_cast<uint64_t>(tensor.shape[k]);
        }
        strides[d] = static_cast<uint32_t>(stride);
    }
    return true;
}

// 快路径切核数：至少 1 个核，且不超过 32B 块数
inline uint32_t FastBlockNum(uint32_t totalLength, uint32_t alignNum, uint32_t cores)
{
    const uint32_t needBlocks = (totalLength + alignNum - 1U) / alignNum;
    uint32_t blockNum = (cores < needBlocks) ? cores : needBlocks;
    return (blockNum == 0U) ? 1U : blockNum;
}

// 广播路径切核数：每核至少 1 个元素
inline uint32_t BcastBlockNum(uint32_t totalLength, uint32_t cores)
{
    uint32_t blockNum = (cores < totalLength) ? cores : totalLength;
    return (blockNum == 0U) ? 1U : blockNum;
}

}  // namespace sub_op

/* ---------------- 快路径内核体：x、y、z 同形状 ---------------- */

namespace sub_op {

template <typename T>
__aicore__ inline void SubVectorBody(GM_ADDR x, GM_ADDR y, GM_ADDR z, uint32_t totalLength)
{
    if (totalLength == 0U) {
        return;
    }

    constexpr uint32_t ALIGN_NUM = sub_op::ALIGN_BYTES / sizeof(T);  // 32B 对应的元素数

    const uint32_t blockNum = static_cast<uint32_t>(AscendC::GetBlockNum());
    const uint32_t blockIdx = static_cast<uint32_t>(AscendC::GetBlockIdx());
    if (blockNum == 0U) {
        return;
    }

    // 每核负责的元素数：按 32B 向上对齐（基址对齐 + 保证 blockNum*perCore 覆盖全部元素）。
    // 注意必须向上取整——若向下取整，核数少于 32B 块数时会漏算尾部。
    const uint32_t perCoreRaw = (totalLength + blockNum - 1U) / blockNum;
    uint32_t perCore = (perCoreRaw + ALIGN_NUM - 1U) / ALIGN_NUM * ALIGN_NUM;
    if (perCore < ALIGN_NUM) {
        perCore = ALIGN_NUM;
    }

    const uint32_t start = blockIdx * perCore;
    if (start >= totalLength) {
        return;  // 核数多于数据块时，多余的核直接退出
    }
    uint32_t len = totalLength - start;
    if (len > perCore) {
        len = perCore;
    }

    AscendC::GlobalTensor<T> xGm;
    AscendC::GlobalTensor<T> yGm;
    AscendC::GlobalTensor<T> zGm;
    xGm.SetGlobalBuffer(reinterpret_cast<__gm__ T *>(x), totalLength);
    yGm.SetGlobalBuffer(reinterpret_cast<__gm__ T *>(y), totalLength);
    zGm.SetGlobalBuffer(reinterpret_cast<__gm__ T *>(z), totalLength);

    AscendC::TPipe pipe;
    AscendC::TQue<AscendC::QuePosition::VECIN, sub_op::BUF_NUM> inQueueX;
    AscendC::TQue<AscendC::QuePosition::VECIN, sub_op::BUF_NUM> inQueueY;
    AscendC::TQue<AscendC::QuePosition::VECOUT, sub_op::BUF_NUM> outQueueZ;
    constexpr uint32_t TILE_BYTES = static_cast<uint32_t>(sub_op::TILE_LEN * sizeof(T));
    pipe.InitBuffer(inQueueX, sub_op::BUF_NUM, TILE_BYTES);
    pipe.InitBuffer(inQueueY, sub_op::BUF_NUM, TILE_BYTES);
    pipe.InitBuffer(outQueueZ, sub_op::BUF_NUM, TILE_BYTES);

    const uint32_t alignedLen = len / ALIGN_NUM * ALIGN_NUM;

    for (uint32_t offset = 0U; offset < alignedLen;) {
        uint32_t cur = alignedLen - offset;
        if (cur > sub_op::TILE_LEN) {
            cur = sub_op::TILE_LEN;
        }
        cur = cur / ALIGN_NUM * ALIGN_NUM;  // 保持 32B 对齐

        AscendC::LocalTensor<T> xLocal = inQueueX.AllocTensor<T>();
        AscendC::DataCopy(xLocal, xGm[start + offset], cur);
        inQueueX.EnQue(xLocal);

        AscendC::LocalTensor<T> yLocal = inQueueY.AllocTensor<T>();
        AscendC::DataCopy(yLocal, yGm[start + offset], cur);
        inQueueY.EnQue(yLocal);

        xLocal = inQueueX.DeQue<T>();
        yLocal = inQueueY.DeQue<T>();

        AscendC::LocalTensor<T> zLocal = outQueueZ.AllocTensor<T>();
        AscendC::Sub(zLocal, xLocal, yLocal, cur);   // dst = x - y（顺序不可反）
        outQueueZ.EnQue(zLocal);

        inQueueX.FreeTensor(xLocal);
        inQueueY.FreeTensor(yLocal);

        zLocal = outQueueZ.DeQue<T>();
        AscendC::DataCopy(zGm[start + offset], zLocal, cur);
        outQueueZ.FreeTensor(zLocal);

        offset += cur;
    }

    // 不足 32B 的尾部元素：标量读写补齐（不做越界搬运）
    for (uint32_t i = start + alignedLen; i < start + len; ++i) {
        const float xv = static_cast<float>(xGm.GetValue(i));
        const float yv = static_cast<float>(yGm.GetValue(i));
        zGm.SetValue(i, static_cast<T>(xv - yv));
    }
}

/* ---------------- 广播路径内核体：x/y 与 z 形状不同 ---------------- */

template <typename T>
__aicore__ inline void SubBroadcastBody(
    GM_ADDR x, GM_ADDR y, GM_ADDR z, uint32_t totalLength,
    uint32_t d0, uint32_t d1, uint32_t d2, uint32_t d3,
    uint32_t a0, uint32_t a1, uint32_t a2, uint32_t a3,
    uint32_t b0, uint32_t b1, uint32_t b2, uint32_t b3)
{
    if (totalLength == 0U) {
        return;
    }

    const uint32_t dims[sub_op::MAX_RANK] = {d0, d1, d2, d3};   // 输出形状（高位补 1）
    const uint32_t strA[sub_op::MAX_RANK] = {a0, a1, a2, a3};   // x 各维 stride（0 = 被广播）
    const uint32_t strB[sub_op::MAX_RANK] = {b0, b1, b2, b3};   // y 各维 stride（0 = 被广播）

    AscendC::GlobalTensor<T> xGm;
    AscendC::GlobalTensor<T> yGm;
    AscendC::GlobalTensor<T> zGm;
    xGm.SetGlobalBuffer(reinterpret_cast<__gm__ T *>(x), totalLength);
    yGm.SetGlobalBuffer(reinterpret_cast<__gm__ T *>(y), totalLength);
    zGm.SetGlobalBuffer(reinterpret_cast<__gm__ T *>(z), totalLength);

    const uint32_t blockNum = static_cast<uint32_t>(AscendC::GetBlockNum());
    const uint32_t blockIdx = static_cast<uint32_t>(AscendC::GetBlockIdx());
    if (blockNum == 0U) {
        return;
    }

    // 按块号跨步遍历，各核处理的元素集合互不相交
    for (uint32_t i = blockIdx; i < totalLength; i += blockNum) {
        uint32_t rem = i;
        uint32_t offX = 0U;
        uint32_t offY = 0U;
        for (int32_t d = sub_op::MAX_RANK - 1; d >= 0; --d) {
            const uint32_t dim = dims[d];
            if (dim == 0U) {
                continue;
            }
            const uint32_t coord = rem % dim;
            rem /= dim;
            offX += coord * strA[d];
            offY += coord * strB[d];
        }
        const float xv = static_cast<float>(xGm.GetValue(offX));
        const float yv = static_cast<float>(yGm.GetValue(offY));
        zGm.SetValue(i, static_cast<T>(xv - yv));
    }
}

}  // namespace sub_op

/* ---------------- 设备入口：按 dtype 各生成一个 __global__ 内核 ---------------- */

__global__ __vector__ void sub_custom_f32(GM_ADDR x, GM_ADDR y, GM_ADDR z, uint32_t totalLength)
{
    sub_op::SubVectorBody<float>(x, y, z, totalLength);
}

__global__ __vector__ void sub_custom_f16(GM_ADDR x, GM_ADDR y, GM_ADDR z, uint32_t totalLength)
{
    sub_op::SubVectorBody<half>(x, y, z, totalLength);
}

__global__ __vector__ void sub_custom_bcast_f32(
    GM_ADDR x, GM_ADDR y, GM_ADDR z, uint32_t totalLength,
    uint32_t d0, uint32_t d1, uint32_t d2, uint32_t d3,
    uint32_t a0, uint32_t a1, uint32_t a2, uint32_t a3,
    uint32_t b0, uint32_t b1, uint32_t b2, uint32_t b3)
{
    sub_op::SubBroadcastBody<float>(x, y, z, totalLength,
                                    d0, d1, d2, d3, a0, a1, a2, a3, b0, b1, b2, b3);
}

__global__ __vector__ void sub_custom_bcast_f16(
    GM_ADDR x, GM_ADDR y, GM_ADDR z, uint32_t totalLength,
    uint32_t d0, uint32_t d1, uint32_t d2, uint32_t d3,
    uint32_t a0, uint32_t a1, uint32_t a2, uint32_t a3,
    uint32_t b0, uint32_t b1, uint32_t b2, uint32_t b3)
{
    sub_op::SubBroadcastBody<half>(x, y, z, totalLength,
                                   d0, d1, d2, d3, a0, a1, a2, a3, b0, b1, b2, b3);
}

/*
 * 宿主侧入口，由 main.asc 调用。
 *   availableCoreNum 来自 aclrtGetDeviceInfo(ACL_DEV_ATTR_VECTOR_CORE_NUM)。
 */
extern "C" void run_kernel(GM_ADDR x, const TensorGroupInfo& info_x, GM_ADDR y, const TensorGroupInfo& info_y, GM_ADDR z, const TensorGroupInfo& info_z, int64_t availableCoreNum, aclrtStream stream)
{
    const int32_t dtype = sub_op::DtypeOf(info_x);
    // x / y / z 必须同 dtype：宽度不同时按错的元素宽度搬运会读穿缓冲区
    if (dtype != sub_op::DTYPE_FP32 && dtype != sub_op::DTYPE_FP16) {
        return;
    }
    if (sub_op::DtypeOf(info_y) != dtype) {
        return;
    }
    if (info_z.numTensors > 0 && info_z.tensors != nullptr && sub_op::DtypeOf(info_z) != dtype) {
        return;
    }

    uint64_t countX = 0ULL;
    uint64_t countY = 0ULL;
    uint64_t countZ = 0ULL;
    if (!sub_op::ElementCount(info_x, countX) || !sub_op::ElementCount(info_y, countY)) {
        return;
    }
    // 输出元素数才是驱动量：广播时 x/y 都可能比 z 小
    if (!sub_op::ElementCount(info_z, countZ)) {
        countZ = countX;
    }
    if (countZ == 0ULL || countZ > 0xFFFFFFFFULL) {
        return;
    }
    const uint32_t totalLength = static_cast<uint32_t>(countZ);

    const uint32_t cores = (availableCoreNum > 0)
        ? static_cast<uint32_t>(availableCoreNum) : 1U;

    const bool sameShape = (countX == countZ && countY == countZ);

    // 广播参数（与 dtype 无关，只算一次）
    int64_t outDims[sub_op::MAX_RANK] = {1, 1, 1, 1};
    uint32_t strA[sub_op::MAX_RANK] = {0U, 0U, 0U, 0U};
    uint32_t strB[sub_op::MAX_RANK] = {0U, 0U, 0U, 0U};
    if (!sameShape) {
        if (!sub_op::PadShape(info_z, outDims) && !sub_op::PadShape(info_x, outDims)) {
            return;  // 维数超过 MAX_RANK 或 shape 非法：不启动，避免越界
        }
        if (!sub_op::BuildStrides(info_x, outDims, strA) ||
            !sub_op::BuildStrides(info_y, outDims, strB)) {
            return;  // 形状不满足广播规则（正常不会发生）
        }
    }

    if (dtype == sub_op::DTYPE_FP32) {
        if (sameShape) {
            const uint32_t alignF32 = static_cast<uint32_t>(sub_op::ALIGN_BYTES / sizeof(float));
            const uint32_t blockNum = sub_op::FastBlockNum(totalLength, alignF32, cores);
            sub_custom_f32<<<blockNum, nullptr, stream>>>(x, y, z, totalLength);
        } else {
            const uint32_t blockNum = sub_op::BcastBlockNum(totalLength, cores);
            sub_custom_bcast_f32<<<blockNum, nullptr, stream>>>(
                x, y, z, totalLength,
                static_cast<uint32_t>(outDims[0]), static_cast<uint32_t>(outDims[1]),
                static_cast<uint32_t>(outDims[2]), static_cast<uint32_t>(outDims[3]),
                strA[0], strA[1], strA[2], strA[3],
                strB[0], strB[1], strB[2], strB[3]);
        }
        return;
    }

    /* ---- fp16 ---- */
    if (sameShape) {
        const uint32_t alignF16 = static_cast<uint32_t>(sub_op::ALIGN_BYTES / sizeof(half));
        const uint32_t blockNum = sub_op::FastBlockNum(totalLength, alignF16, cores);
        sub_custom_f16<<<blockNum, nullptr, stream>>>(x, y, z, totalLength);
    } else {
        const uint32_t blockNum = sub_op::BcastBlockNum(totalLength, cores);
        sub_custom_bcast_f16<<<blockNum, nullptr, stream>>>(
            x, y, z, totalLength,
            static_cast<uint32_t>(outDims[0]), static_cast<uint32_t>(outDims[1]),
            static_cast<uint32_t>(outDims[2]), static_cast<uint32_t>(outDims[3]),
            strA[0], strA[1], strA[2], strA[3],
            strB[0], strB[1], strB[2], strB[3]);
    }
}
