#include <cstdint>
#include "kernel_operator.h"

struct AddCustomTilingData {
    uint32_t blockLength;
    uint32_t tileLength;
};

constexpr uint32_t QUEUE_DEPTH = 1;

template <typename T>
class KernelAdd {
public:
    __aicore__ inline KernelAdd() {}

    __aicore__ inline void Init(
        GM_ADDR x, GM_ADDR y, GM_ADDR z,
        const AddCustomTilingData& tiling)
    {
        blockLength = tiling.blockLength;
        tileLength = tiling.tileLength;
        const uint32_t offset = blockLength * AscendC::GetBlockIdx();

        xGm.SetGlobalBuffer((__gm__ T*)x + offset, blockLength);
        yGm.SetGlobalBuffer((__gm__ T*)y + offset, blockLength);
        zGm.SetGlobalBuffer((__gm__ T*)z + offset, blockLength);

        pipe.InitBuffer(inQueueX, 1, tileLength * sizeof(T));
        pipe.InitBuffer(inQueueY, 1, tileLength * sizeof(T));
        pipe.InitBuffer(outQueueZ, 1, tileLength * sizeof(T));
    }

    __aicore__ inline void Process()
    {
        for (uint32_t offset = 0; offset < blockLength;) {
            const uint32_t remaining = blockLength - offset;
            const uint32_t count = remaining < tileLength ? remaining : tileLength;

            AscendC::LocalTensor<T> xLocal = inQueueX.AllocTensor<T>();
            AscendC::LocalTensor<T> yLocal = inQueueY.AllocTensor<T>();
            AscendC::DataCopy(xLocal, xGm[offset], count);
            AscendC::DataCopy(yLocal, yGm[offset], count);
            inQueueX.EnQue(xLocal);
            inQueueY.EnQue(yLocal);

            xLocal = inQueueX.DeQue<T>();
            yLocal = inQueueY.DeQue<T>();
            AscendC::LocalTensor<T> zLocal = outQueueZ.AllocTensor<T>();
            AscendC::Sub(zLocal, xLocal, yLocal, count);
            outQueueZ.EnQue(zLocal);
            inQueueX.FreeTensor(xLocal);
            inQueueY.FreeTensor(yLocal);

            zLocal = outQueueZ.DeQue<T>();
            AscendC::DataCopy(zGm[offset], zLocal, count);
            outQueueZ.FreeTensor(zLocal);
            offset += count;
        }
    }

private:
    AscendC::TPipe pipe;
    AscendC::TQue<AscendC::QuePosition::VECIN, QUEUE_DEPTH> inQueueX;
    AscendC::TQue<AscendC::QuePosition::VECIN, QUEUE_DEPTH> inQueueY;
    AscendC::TQue<AscendC::QuePosition::VECOUT, QUEUE_DEPTH> outQueueZ;
    AscendC::GlobalTensor<T> xGm, yGm, zGm;
    uint32_t blockLength;
    uint32_t tileLength;
};

template <typename T>
__global__ __vector__ void add_custom(
    GM_ADDR x, GM_ADDR y, GM_ADDR z, AddCustomTilingData tiling)
{
    KernelAdd<T> op;
    op.Init(x, y, z, tiling);
    op.Process();
}

extern "C" void run_kernel(
    GM_ADDR x, const TensorGroupInfo& info_x,
    GM_ADDR y, const TensorGroupInfo& info_y,
    GM_ADDR z, const TensorGroupInfo& info_z,
    int64_t availableCoreNum, aclrtStream stream)
{
    const TensorInfo& t0 = info_x.tensors[0];
    const int32_t dtype = t0.dtype;
    if (availableCoreNum <= 0 || t0.numDims < 0 ||
        (dtype != 0 && dtype != 1)) {
        return;
    }

    uint64_t total = 1;
    constexpr uint64_t MAX_ELEMENTS = 0xFFFFFFFFULL;
    for (int64_t i = 0; i < t0.numDims; ++i) {
        const int64_t dim = t0.shape[i];
        if (dim <= 0 || static_cast<uint64_t>(dim) > MAX_ELEMENTS / total) {
            return;
        }
        total *= static_cast<uint64_t>(dim);
    }

    const uint32_t totalLength = static_cast<uint32_t>(total);
    const uint32_t elementBytes = dtype == 1 ? 2U : 4U;
    const uint32_t alignElements = 32U / elementBytes;
    if (totalLength % alignElements != 0) {
        return;
    }

    uint32_t blockDim = availableCoreNum < 8
        ? static_cast<uint32_t>(availableCoreNum) : 8U;
    while (totalLength % (blockDim * alignElements) != 0) {
        --blockDim;
    }
    const uint32_t blockLength = totalLength / blockDim;
    const uint32_t tileLength = blockLength < 2048U ? blockLength : 2048U;
    AddCustomTilingData tiling = {blockLength, tileLength};

    if (dtype == 1) {
        add_custom<half><<<blockDim, nullptr, stream>>>(x, y, z, tiling);
    } else {
        add_custom<float><<<blockDim, nullptr, stream>>>(x, y, z, tiling);
    }
}
