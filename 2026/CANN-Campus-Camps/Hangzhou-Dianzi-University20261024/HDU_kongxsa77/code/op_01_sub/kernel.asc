#include "kernel_operator.h"

/*
 * Sub kernel — Ascend C Direct Invocation（z = x - y，逐元素）
 * 目标环境：CANN 9.0.0 / Ascend 910B（Atlas A2，dav-2201）
 *
 * 本文件由 main.asc 直接 #include，不得引入 main()、#pragma once 或 include guard。
 *
 * 工程约定：
 *   1. Host 侧 run_kernel 从 TensorGroupInfo 的 shape 计算元素总数，按 dtype 分派，
 *      不使用额外 Tiling GM 内存，与官方 add_tpipe_tque 样例的直调方式一致。
 *   2. Device 侧使用 TPipe + TQue（深度 1）：GM→UB 用 DataCopy，UB 内用 AscendC::Sub，
 *      结果再 DataCopy 回 GM。TILE = 4096 元素（fp32 下 16KB），三个队列合计 48KB UB，
 *      远低于 910B 单核 192KB 的 UB 容量。
 *   3. DataCopy 要求源/目的地址和长度均 32B 对齐；仅当最后一块长度不足 32B 整数倍时，
 *      该块单独走 DataCopyPad。shape {8, 2048} 共 16384 个 fp32，全部落在 DataCopy 路径。
 *   4. 本算子数据量仅 64KB，单核即可在 main.asc 的同步超时内完成，故 <<<>>> 固定
 *      blockDim = 1。若要扩展为多核，只需在 run_kernel 中按 32B 对齐切分，把实际
 *      blockNum 传给 <<<>>>，并在 Init 中按 GetBlockIdx() 偏移 GM 地址即可。
 */

namespace {
constexpr uint32_t TILE = 4096;       // 单次搬运/计算的元素数；fp32 下 16KB，满足 32B 对齐
constexpr uint32_t ALIGN_BYTES = 32;  // DataCopy 的地址/长度对齐要求
}  // namespace

template <typename T>
class SubKernel {
public:
    __aicore__ inline explicit SubKernel(AscendC::TPipe* pipe) : pipe_(pipe) {}

    __aicore__ inline void Init(GM_ADDR x, GM_ADDR y, GM_ADDR z, uint32_t total)
    {
        total_ = total;
        xGm_.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(x), total_);
        yGm_.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(y), total_);
        zGm_.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(z), total_);

        pipe_->InitBuffer(qx_, 1, static_cast<uint32_t>(TILE * sizeof(T)));
        pipe_->InitBuffer(qy_, 1, static_cast<uint32_t>(TILE * sizeof(T)));
        pipe_->InitBuffer(qz_, 1, static_cast<uint32_t>(TILE * sizeof(T)));
    }

    __aicore__ inline void Process()
    {
        constexpr uint32_t alignElems = ALIGN_BYTES / sizeof(T);

        for (uint32_t off = 0; off < total_;) {
            const uint32_t n = ((total_ - off) < TILE) ? (total_ - off) : TILE;
            // 主体（含本题全部数据）走 32B 对齐的 DataCopy 快路径；
            // 只有长度不是 32B 整数倍的尾块才走 DataCopyPad。
            ProcessChunk(off, n, (n % alignElems) == 0);
            off += n;
        }
    }

private:
    __aicore__ inline void ProcessChunk(uint32_t off, uint32_t n, bool aligned)
    {
        AscendC::LocalTensor<T> xl = qx_.AllocTensor<T>();
        AscendC::LocalTensor<T> yl = qy_.AllocTensor<T>();

        if (aligned) {
            AscendC::DataCopy(xl, xGm_[off], n);
            AscendC::DataCopy(yl, yGm_[off], n);
        } else {
            AscendC::DataCopyExtParams copyParams{1, static_cast<uint32_t>(n * sizeof(T)), 0, 0, 0};
            AscendC::DataCopyPadExtParams<T> padParams{false, 0, 0, static_cast<T>(0)};
            AscendC::DataCopyPad(xl, xGm_[off], copyParams, padParams);
            AscendC::DataCopyPad(yl, yGm_[off], copyParams, padParams);
        }
        qx_.EnQue(xl);
        qy_.EnQue(yl);

        AscendC::LocalTensor<T> x2 = qx_.DeQue<T>();
        AscendC::LocalTensor<T> y2 = qy_.DeQue<T>();
        AscendC::LocalTensor<T> zl = qz_.AllocTensor<T>();
        AscendC::Sub(zl, x2, y2, static_cast<int32_t>(n));
        qz_.EnQue<T>(zl);
        qx_.FreeTensor(x2);
        qy_.FreeTensor(y2);

        AscendC::LocalTensor<T> z2 = qz_.DeQue<T>();
        if (aligned) {
            AscendC::DataCopy(zGm_[off], z2, n);
        } else {
            AscendC::DataCopyExtParams copyParams{1, static_cast<uint32_t>(n * sizeof(T)), 0, 0, 0};
            AscendC::DataCopyPad(zGm_[off], z2, copyParams);
        }
        qz_.FreeTensor(z2);
    }

    AscendC::TPipe* pipe_;
    AscendC::GlobalTensor<T> xGm_;
    AscendC::GlobalTensor<T> yGm_;
    AscendC::GlobalTensor<T> zGm_;
    AscendC::TQue<AscendC::TPosition::VECIN, 1> qx_;
    AscendC::TQue<AscendC::TPosition::VECIN, 1> qy_;
    AscendC::TQue<AscendC::TPosition::VECOUT, 1> qz_;
    uint32_t total_ = 0;
};

__global__ __vector__ void sub_fp32(GM_ADDR x, GM_ADDR y, GM_ADDR z, uint32_t total)
{
    AscendC::TPipe pipe;
    SubKernel<float> op(&pipe);
    op.Init(x, y, z, total);
    op.Process();
}

// dtype = float16 时使用；本题 {8, 2048} fp32 不会进入该分支。
__global__ __vector__ void sub_fp16(GM_ADDR x, GM_ADDR y, GM_ADDR z, uint32_t total)
{
    AscendC::TPipe pipe;
    SubKernel<half> op(&pipe);
    op.Init(x, y, z, total);
    op.Process();
}

extern "C" void run_kernel(GM_ADDR x, const TensorGroupInfo& info_x, GM_ADDR y, const TensorGroupInfo& info_y,
                           GM_ADDR z, const TensorGroupInfo& info_z, int64_t availableCoreNum, aclrtStream stream)
{
    (void)info_y;
    (void)info_z;
    (void)availableCoreNum;  // 单核实现，见文件头说明

    if (info_x.numTensors <= 0 || info_x.tensors == nullptr) {
        return;
    }
    const TensorInfo& xInfo = info_x.tensors[0];
    if (xInfo.numDims <= 0 || xInfo.shape == nullptr) {
        return;
    }

    uint64_t total = 1;
    for (int64_t i = 0; i < xInfo.numDims; ++i) {
        if (xInfo.shape[i] <= 0) {
            return;
        }
        total *= static_cast<uint64_t>(xInfo.shape[i]);
        if (total > 0xFFFFFFFFULL) {  // 标量参数为 uint32_t，超限时不启动
            return;
        }
    }

    if (xInfo.dtype == 0) {
        sub_fp32<<<1, nullptr, stream>>>(x, y, z, static_cast<uint32_t>(total));
    } else if (xInfo.dtype == 1) {
        sub_fp16<<<1, nullptr, stream>>>(x, y, z, static_cast<uint32_t>(total));
    }
}
