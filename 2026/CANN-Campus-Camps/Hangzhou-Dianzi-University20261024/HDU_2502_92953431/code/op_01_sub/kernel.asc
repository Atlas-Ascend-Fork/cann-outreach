#include <cmath>
#include "kernel_operator.h"
/*
 * Sub Kernel — Ascend C Direct Invocation
 * This file is #included — do NOT add main(), #pragma once, or include guards.
 *
 * TensorGroupInfo / TensorInfo (predefined):
 *   struct TensorInfo { const int64_t* shape; int64_t numDims; int32_t dtype; };
 *   struct TensorGroupInfo { const TensorInfo* tensors; int64_t numTensors; };
 *   dtype: 0=fp32 1=fp16 2=bf16 3=int8 4=int16 5=int32 6=int64 7=uint8 8=uint16 9=uint32 10=uint64 11=bool
 *   Usage: info_x.tensors[0].shape[0]  // first dim of first tensor in input x
 *
 */

// ---------------------------------------------------------------------------
// Tiling 参数：由 host 侧 run_kernel 计算后按值传给核函数
// ---------------------------------------------------------------------------
struct SubCustomTilingData {
    uint32_t totalLength;    // x / y / z 的总元素个数
    uint32_t blockNum;       // 实际启动的核数
    uint32_t perCoreLength;  // 每个核的数据长度（32B 对齐）
    uint32_t tileLength;     // 每个核内每个数据块的长度（32B 对齐）
    uint32_t tileNum;        // 每个核的数据块个数（绝大多数场景为 1）
};

constexpr uint32_t ALIGN_NUM = 8;    // 32B 对齐兜底（host 侧会按 dtype 换算成实际对齐元素数）
constexpr uint32_t QUEUE_DEPTH = 1;  // 每核只处理整块数据，单缓冲即可，省掉一次同步

// ---------------------------------------------------------------------------
// KernelSub：z = x - y，每核分块循环计算（模板化，支持 float / half 等类型）
// ---------------------------------------------------------------------------
template <typename T>
class KernelSub {
public:
    __aicore__ inline KernelSub() {}

    __aicore__ inline void Init(GM_ADDR x, GM_ADDR y, GM_ADDR z, const SubCustomTilingData& tiling)
    {
        // 按核均分数据段：每核长度已在 host 侧按 32B 对齐，最后一个核可能只剩余数据
        uint32_t blockIdx = (uint32_t)AscendC::GetBlockIdx();
        uint64_t blockOffset = (uint64_t)tiling.perCoreLength * blockIdx;
        uint32_t remain = (blockOffset < tiling.totalLength) ? (tiling.totalLength - (uint32_t)blockOffset) : 0;
        this->blockLength = (remain < tiling.perCoreLength) ? remain : tiling.perCoreLength;

        this->tileLength = tiling.tileLength;
        this->tileNum = (this->tileLength == 0) ? 0 : (this->blockLength + this->tileLength - 1) / this->tileLength;

        // 按核偏移切分 Global Memory，每个核只处理自己的数据段
        xGm.SetGlobalBuffer((__gm__ T*)x + blockOffset, this->blockLength);
        yGm.SetGlobalBuffer((__gm__ T*)y + blockOffset, this->blockLength);
        zGm.SetGlobalBuffer((__gm__ T*)z + blockOffset, this->blockLength);

        // 每个 buffer 的长度按 32B 对齐，避免出现 0 长度的 buffer
        uint32_t bufLength = (this->tileLength == 0) ? (32u / sizeof(T)) : this->tileLength;
        pipe.InitBuffer(inQueueX, QUEUE_DEPTH, bufLength * sizeof(T));
        pipe.InitBuffer(inQueueY, QUEUE_DEPTH, bufLength * sizeof(T));
        pipe.InitBuffer(outQueueZ, QUEUE_DEPTH, bufLength * sizeof(T));
    }

    __aicore__ inline void Process()
    {
        // 每个核通常只有 1 个数据块（tileNum 由 host 按核数与 UB 容量决定），
        // 循环开销最小化，避免小数据块反复 EnQue/DeQue 带来的同步开销
        for (int32_t i = 0; i < (int32_t)this->tileNum; i++) {
            CopyIn(i);    // 搬入第 i 块数据
            Compute(i);   // 计算第 i 块数据
            CopyOut(i);   // 搬出第 i 块结果
        }
    }

private:
    // 第 progress 块的实际长度（尾块可能不足 tileLength）
    __aicore__ inline uint32_t GetTileLength(int32_t progress) const
    {
        uint32_t offset = (uint32_t)progress * this->tileLength;
        uint32_t remain = this->blockLength - offset;
        return (remain < this->tileLength) ? remain : this->tileLength;
    }

    __aicore__ inline void CopyIn(int32_t progress)
    {
        uint32_t len = GetTileLength(progress);
        uint64_t offset = (uint64_t)progress * this->tileLength;
        // 从队列申请 LocalTensor（UB 内存）
        AscendC::LocalTensor<T> xLocal = inQueueX.AllocTensor<T>();
        AscendC::LocalTensor<T> yLocal = inQueueY.AllocTensor<T>();
        // 把第 progress 块输入数据从 Global Memory 搬到 UB
        AscendC::DataCopy(xLocal, xGm[offset], (int32_t)len);
        AscendC::DataCopy(yLocal, yGm[offset], (int32_t)len);
        // 通知计算阶段：数据已搬入
        inQueueX.EnQue(xLocal);
        inQueueY.EnQue(yLocal);
    }

    __aicore__ inline void Compute(int32_t progress)
    {
        uint32_t len = GetTileLength(progress);
        // 取出搬入的输入 LocalTensor 与存放结果的 LocalTensor
        AscendC::LocalTensor<T> xLocal = inQueueX.DeQue<T>();
        AscendC::LocalTensor<T> yLocal = inQueueY.DeQue<T>();
        AscendC::LocalTensor<T> zLocal = outQueueZ.AllocTensor<T>();
        // z = x - y，按块完成矢量减法
        AscendC::Sub(zLocal, xLocal, yLocal, (int32_t)len);
        // 通知搬出阶段：结果已计算完成
        outQueueZ.EnQue<T>(zLocal);
        // 释放输入 buffer，供后续数据块复用
        inQueueX.FreeTensor(xLocal);
        inQueueY.FreeTensor(yLocal);
    }

    __aicore__ inline void CopyOut(int32_t progress)
    {
        uint32_t len = GetTileLength(progress);
        uint64_t offset = (uint64_t)progress * this->tileLength;
        AscendC::LocalTensor<T> zLocal = outQueueZ.DeQue<T>();
        // 把第 progress 块结果从 UB 搬出到 Global Memory
        AscendC::DataCopy(zGm[offset], zLocal, (int32_t)len);
        outQueueZ.FreeTensor(zLocal);
    }

private:
    AscendC::TPipe pipe;  // TPipe 内存管理对象
    AscendC::TQue<AscendC::QuePosition::VECIN, QUEUE_DEPTH> inQueueX, inQueueY;  // 输入数据队列管理对象，VECIN 位置
    AscendC::TQue<AscendC::QuePosition::VECOUT, QUEUE_DEPTH> outQueueZ;  // 输出数据队列管理对象，VECOUT 位置
    AscendC::GlobalTensor<T> xGm, yGm, zGm; // 管理输入输出 Global Memory 地址的对象，其中 xGm、yGm 为输入，zGm 为输出

    uint32_t blockLength; // 每个核的计算数据长度
    uint32_t tileNum; // 每个核需要计算的数据块个数，类似 batch 数量
    uint32_t tileLength; // 每个核内每个数据块的长度，类似 batch size
};

// ---------------------------------------------------------------------------
// 核函数入口：实例化 KernelSub<T> 并执行（T 由 run_kernel 按输入 dtype 选择）
// ---------------------------------------------------------------------------
template <typename T>
__global__ __vector__ void sub_custom(GM_ADDR x, GM_ADDR y, GM_ADDR z, SubCustomTilingData tiling)
{
    KernelSub<T> op;
    op.Init(x, y, z, tiling);
    op.Process();
}

// ---------------------------------------------------------------------------
// host 侧启动函数：从 TensorGroupInfo 推导 tiling 并启动核函数
// ---------------------------------------------------------------------------
extern "C" void run_kernel(GM_ADDR x, const TensorGroupInfo& info_x, GM_ADDR y, const TensorGroupInfo& info_y, GM_ADDR z, const TensorGroupInfo& info_z, int64_t availableCoreNum, aclrtStream stream)
{
    // 1. 取总元素数（x/y/z 形状一致）
    const TensorInfo& t0 = info_x.tensors[0];
    int64_t totalLength = 1;
    for (int64_t i = 0; i < t0.numDims; i++) {
        totalLength *= t0.shape[i];
    }
    if (totalLength <= 0) {
        return;
    }
    uint32_t total = (uint32_t)totalLength;

    // 2. 32B 对齐换算出元素个数：fp16 为 16 个元素，fp32 为 8 个元素
    uint32_t elemSize = (t0.dtype == 1) ? 2u : 4u;
    uint32_t alignNum = 32u / elemSize;
    uint32_t maxTileLen = 32768u / elemSize;  // 单个 buffer 上限 32KB

    // 3. 核数：用满可用的 vector core（小数据靠核间并行降低单核时延），
    //    同时保证每核至少分到一个 32B 对齐块
    uint32_t blockDim = (availableCoreNum > 0) ? (uint32_t)availableCoreNum : 1;
    uint32_t maxBlockDim = total / alignNum;
    if (maxBlockDim == 0) {
        maxBlockDim = 1;
    }
    if (blockDim > maxBlockDim) {
        blockDim = maxBlockDim;
    }

    // 4. 每核数据长度按 32B 对齐，保证 DataCopy 搬移合法（元素总数本身为 32B 对齐时无尾块）
    uint32_t perCoreLength = (total + blockDim - 1) / blockDim;
    perCoreLength = (perCoreLength + alignNum - 1) / alignNum * alignNum;

    // 5. 每核尽量只用 1 个数据块：块越大，搬运/计算指令条数与同步次数越少
    uint32_t tileLength = (perCoreLength < maxTileLen) ? perCoreLength : maxTileLen;
    uint32_t tileNum = (perCoreLength + tileLength - 1) / tileLength;

    // 6. 按输入 dtype 选择核函数实例（dtype 定义见 TensorInfo：0=fp32 1=fp16 2=bf16 ...）
    SubCustomTilingData tiling = {total, blockDim, perCoreLength, tileLength, tileNum};
    if (t0.dtype == 1) {
        // fp16：half 实例
        sub_custom<half><<<blockDim, nullptr, stream>>>(x, y, z, tiling);
    } else {
        // fp32 及其他类型默认走 float 实例
        sub_custom<float><<<blockDim, nullptr, stream>>>(x, y, z, tiling);
    }
}
