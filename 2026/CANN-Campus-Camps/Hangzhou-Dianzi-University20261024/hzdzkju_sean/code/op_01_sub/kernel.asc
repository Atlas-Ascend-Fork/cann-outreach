#include <cmath>
#include <cstdint>
#include <limits>
#include <vector>

#include "kernel_operator.h"

using namespace AscendC;

namespace sub_detail {

constexpr uint32_t MAX_DIMS = 32;
constexpr uint32_t TILE_ELEMENTS = 4096;
constexpr uint32_t ALIGN_BYTES = 32;
constexpr uint32_t QUEUE_DEPTH = 2;
constexpr uint64_t MIN_BYTES_PER_BLOCK = 16384;

struct SubTiling {
    uint32_t rank;
    uint32_t totalLength;
    uint32_t innerAxis;
    uint32_t innerLength;
    uint32_t outerCount;
    uint32_t shape[MAX_DIMS];
    uint32_t x1Stride[MAX_DIMS];
    uint32_t x2Stride[MAX_DIMS];
};

inline uint32_t MaxU32(uint32_t a, uint32_t b)
{
    return a > b ? a : b;
}

inline int64_t TensorElementCount(const TensorGroupInfo& info)
{
    if (info.tensors == nullptr || info.numTensors != 1) {
        return -1;
    }

    const TensorInfo& tensor = info.tensors[0];
    if (tensor.numDims < 0 ||
        (tensor.numDims > 0 && tensor.shape == nullptr)) {
        return -1;
    }

    int64_t count = 1;
    for (int64_t i = 0; i < tensor.numDims; ++i) {
        int64_t dim = tensor.shape[i];
        if (dim <= 0) {
            return -1;
        }
        if (count > (std::numeric_limits<int64_t>::max)() / dim) {
            return -1;
        }
        count *= dim;
    }
    return count;
}

inline bool SameShape(const TensorGroupInfo& lhs,
                      const TensorGroupInfo& rhs)
{
    if (lhs.tensors == nullptr || rhs.tensors == nullptr ||
        lhs.numTensors != 1 || rhs.numTensors != 1) {
        return false;
    }

    const TensorInfo& l = lhs.tensors[0];
    const TensorInfo& r = rhs.tensors[0];
    if (l.numDims != r.numDims) {
        return false;
    }

    for (int64_t i = 0; i < l.numDims; ++i) {
        if (l.shape[i] != r.shape[i]) {
            return false;
        }
    }
    return true;
}

inline bool CanUseBroadcastVector(const SubTiling& tiling,
                                  uint32_t dtypeSize)
{
    if (tiling.rank == 0 || tiling.innerLength <= 1) {
        return false;
    }
    uint32_t alignElements = ALIGN_BYTES / dtypeSize;
    if (alignElements == 0 ||
        tiling.innerLength % alignElements != 0) {
        return false;
    }
    uint32_t stride1 = tiling.x1Stride[tiling.innerAxis];
    uint32_t stride2 = tiling.x2Stride[tiling.innerAxis];
    return stride1 <= 1 && stride2 <= 1;
}

inline bool ShapeValid(const TensorGroupInfo& info)
{
    if (info.tensors == nullptr || info.numTensors != 1) {
        return false;
    }
    const TensorInfo& tensor = info.tensors[0];
    if (tensor.numDims < 0 ||
        (tensor.numDims > 0 && tensor.shape == nullptr)) {
        return false;
    }
    for (int64_t i = 0; i < tensor.numDims; ++i) {
        if (tensor.shape[i] <= 0) {
            return false;
        }
    }
    return true;
}

inline int64_t DtypeSize(int32_t dtype)
{
    if (dtype == 0) {
        return 4;
    }
    if (dtype == 1) {
        return 2;
    }
    if (dtype == 5) {
        return 4;
    }
    return -1;
}

inline uint32_t CalcBlockNum(uint32_t totalLength,
                             uint32_t dtypeSize,
                             int64_t availableCoreNum)
{
    uint64_t totalBytes =
        static_cast<uint64_t>(totalLength) * dtypeSize;
    uint64_t blockNum =
        (totalBytes + MIN_BYTES_PER_BLOCK - 1) / MIN_BYTES_PER_BLOCK;

    uint64_t coreLimit = static_cast<uint64_t>(availableCoreNum);
    uint64_t u32Max =
        static_cast<uint64_t>((std::numeric_limits<uint32_t>::max)());
    if (coreLimit > u32Max) {
        coreLimit = u32Max;
    }

    if (blockNum > coreLimit) {
        blockNum = coreLimit;
    }
    if (blockNum == 0) {
        blockNum = 1;
    }
    return static_cast<uint32_t>(blockNum);
}

inline bool CanMergeAxis(uint32_t prevShape,
                         uint32_t curShape,
                         uint32_t prevS1,
                         uint32_t curS1,
                         uint32_t prevS2,
                         uint32_t curS2)
{
    bool prevBroadcast1 = (prevS1 == 0);
    bool curBroadcast1 = (curS1 == 0);
    bool prevBroadcast2 = (prevS2 == 0);
    bool curBroadcast2 = (curS2 == 0);

    if (prevBroadcast1 != curBroadcast1 ||
        prevBroadcast2 != curBroadcast2) {
        return false;
    }

    if (!prevBroadcast1 &&
        static_cast<uint64_t>(prevS1) !=
            static_cast<uint64_t>(curS1) * curShape) {
        return false;
    }
    if (!prevBroadcast2 &&
        static_cast<uint64_t>(prevS2) !=
            static_cast<uint64_t>(curS2) * curShape) {
        return false;
    }

    (void)prevShape;
    return true;
}

inline bool BuildBroadcastTiling(const TensorGroupInfo& infoX1,
                                 const TensorGroupInfo& infoX2,
                                 const TensorGroupInfo& infoY,
                                 SubTiling& tiling)
{
    if (!ShapeValid(infoX1) || !ShapeValid(infoX2) ||
        !ShapeValid(infoY)) {
        return false;
    }

    const TensorInfo& x1 = infoX1.tensors[0];
    const TensorInfo& x2 = infoX2.tensors[0];
    const TensorInfo& y = infoY.tensors[0];

    uint32_t rank = static_cast<uint32_t>(
        MaxU32(static_cast<uint32_t>(x1.numDims),
               static_cast<uint32_t>(x2.numDims)));
    if (y.numDims != static_cast<int64_t>(rank)) {
        return false;
    }

    std::vector<uint32_t> outShape(rank);
    std::vector<uint32_t> x1Stride(rank);
    std::vector<uint32_t> x2Stride(rank);

    uint64_t outputCount = 1;
    for (uint32_t i = 0; i < rank; ++i) {
        uint32_t x1Dim = 1;
        uint32_t x2Dim = 1;

        uint32_t x1Offset = rank - static_cast<uint32_t>(x1.numDims);
        uint32_t x2Offset = rank - static_cast<uint32_t>(x2.numDims);
        if (i >= x1Offset) {
            x1Dim = static_cast<uint32_t>(x1.shape[i - x1Offset]);
        }
        if (i >= x2Offset) {
            x2Dim = static_cast<uint32_t>(x2.shape[i - x2Offset]);
        }

        if (x1Dim != x2Dim && x1Dim != 1 && x2Dim != 1) {
            return false;
        }

        uint32_t outDim = MaxU32(x1Dim, x2Dim);
        if (y.shape[i] != static_cast<int64_t>(outDim)) {
            return false;
        }
        outShape[i] = outDim;

        if (outputCount >
            (std::numeric_limits<uint32_t>::max)() / outDim) {
            return false;
        }
        outputCount *= outDim;
    }

    uint64_t stride = 1;
    for (uint32_t r = rank; r > 0; --r) {
        uint32_t i = r - 1;
        uint32_t x1Dim = 1;
        uint32_t x2Dim = 1;
        uint32_t x1Offset = rank - static_cast<uint32_t>(x1.numDims);
        uint32_t x2Offset = rank - static_cast<uint32_t>(x2.numDims);

        if (i >= x1Offset) {
            x1Dim = static_cast<uint32_t>(x1.shape[i - x1Offset]);
        }
        if (i >= x2Offset) {
            x2Dim = static_cast<uint32_t>(x2.shape[i - x2Offset]);
        }

        x1Stride[i] = (x1Dim == 1) ? 0 : static_cast<uint32_t>(stride);
        x2Stride[i] = (x2Dim == 1) ? 0 : static_cast<uint32_t>(stride);
        stride *= outShape[i];
    }

    std::vector<uint32_t> compactShape;
    std::vector<uint32_t> compactX1Stride;
    std::vector<uint32_t> compactX2Stride;
    compactShape.reserve(rank);
    compactX1Stride.reserve(rank);
    compactX2Stride.reserve(rank);

    for (uint32_t i = 0; i < rank; ++i) {
        if (!compactShape.empty() &&
            CanMergeAxis(compactShape.back(), outShape[i],
                         compactX1Stride.back(), x1Stride[i],
                         compactX2Stride.back(), x2Stride[i])) {
            compactShape.back() *= outShape[i];
        } else {
            compactShape.push_back(outShape[i]);
            compactX1Stride.push_back(x1Stride[i]);
            compactX2Stride.push_back(x2Stride[i]);
        }
    }

    if (compactShape.size() > MAX_DIMS) {
        return false;
    }

    tiling.rank = static_cast<uint32_t>(compactShape.size());
    tiling.totalLength = static_cast<uint32_t>(outputCount);
    tiling.innerAxis = 0;
    tiling.innerLength = 1;
    for (uint32_t r = tiling.rank; r > 0; --r) {
        if (compactShape[r - 1] > 1) {
            tiling.innerAxis = r - 1;
            tiling.innerLength = compactShape[r - 1];
            break;
        }
    }
    tiling.outerCount =
        tiling.innerLength == 0 ? 0 :
        tiling.totalLength / tiling.innerLength;
    for (uint32_t i = 0; i < tiling.rank; ++i) {
        tiling.shape[i] = compactShape[i];
        tiling.x1Stride[i] = compactX1Stride[i];
        tiling.x2Stride[i] = compactX2Stride[i];
    }
    return true;
}

__aicore__ inline void GetAlignedRange(uint32_t totalLength,
                            uint32_t alignElements,
                            uint32_t& begin,
                            uint32_t& end)
{
    uint32_t blockNum = GetBlockNum();
    uint32_t blockIdx = GetBlockIdx();
    if (blockNum == 0) {
        blockNum = 1;
    }
    if (alignElements == 0) {
        alignElements = 1;
    }

    uint64_t rawPerBlock =
        (static_cast<uint64_t>(totalLength) + blockNum - 1) / blockNum;
    uint64_t alignedPerBlock =
        ((rawPerBlock + alignElements - 1) / alignElements) *
        alignElements;

    uint64_t begin64 = static_cast<uint64_t>(blockIdx) * alignedPerBlock;
    uint64_t end64 = begin64 + alignedPerBlock;
    if (begin64 > totalLength) {
        begin64 = totalLength;
    }
    if (end64 > totalLength) {
        end64 = totalLength;
    }

    begin = static_cast<uint32_t>(begin64);
    end = static_cast<uint32_t>(end64);
}

template <typename T>
class SameShapeVectorSub {
public:
    __aicore__ inline void Init(GM_ADDR x1,
                                GM_ADDR x2,
                                GM_ADDR y,
                                uint32_t totalLength)
    {
        x1Gm_.SetGlobalBuffer((__gm__ T*)x1, totalLength);
        x2Gm_.SetGlobalBuffer((__gm__ T*)x2, totalLength);
        yGm_.SetGlobalBuffer((__gm__ T*)y, totalLength);

        uint32_t alignElements = ALIGN_BYTES / sizeof(T);
        GetAlignedRange(totalLength, alignElements, begin_, end_);

        pipe_.InitBuffer(inQueueX1_, QUEUE_DEPTH,
                         TILE_ELEMENTS * sizeof(T));
        pipe_.InitBuffer(inQueueX2_, QUEUE_DEPTH,
                         TILE_ELEMENTS * sizeof(T));
        pipe_.InitBuffer(outQueueY_, QUEUE_DEPTH,
                         TILE_ELEMENTS * sizeof(T));
    }

    __aicore__ inline void Process()
    {
        uint32_t alignElements = ALIGN_BYTES / sizeof(T);
        uint32_t offset = begin_;

        while (offset < end_) {
            uint32_t remaining = end_ - offset;
            uint32_t length =
                remaining < TILE_ELEMENTS ? remaining : TILE_ELEMENTS;
            uint32_t alignedLength =
                (length / alignElements) * alignElements;

            if (alignedLength > 0) {
                CopyIn(offset, alignedLength);
                Compute(alignedLength);
                CopyOut(offset, alignedLength);
            }

            uint32_t tailBegin = offset + alignedLength;
            uint32_t tailEnd = offset + length;
            for (uint32_t i = tailBegin; i < tailEnd; ++i) {
                yGm_.SetValue(
                    i, x1Gm_.GetValue(i) - x2Gm_.GetValue(i));
            }
            offset += length;
        }
    }

private:
    __aicore__ inline void CopyIn(uint32_t offset, uint32_t length)
    {
        LocalTensor<T> x1Local = inQueueX1_.AllocTensor<T>();
        LocalTensor<T> x2Local = inQueueX2_.AllocTensor<T>();
        DataCopy(x1Local, x1Gm_[offset], length);
        DataCopy(x2Local, x2Gm_[offset], length);
        inQueueX1_.EnQue(x1Local);
        inQueueX2_.EnQue(x2Local);
    }

    __aicore__ inline void Compute(uint32_t length)
    {
        LocalTensor<T> x1Local = inQueueX1_.DeQue<T>();
        LocalTensor<T> x2Local = inQueueX2_.DeQue<T>();
        LocalTensor<T> yLocal = outQueueY_.AllocTensor<T>();

        Sub(yLocal, x1Local, x2Local, length);

        outQueueY_.EnQue(yLocal);
        inQueueX1_.FreeTensor(x1Local);
        inQueueX2_.FreeTensor(x2Local);
    }

    __aicore__ inline void CopyOut(uint32_t offset, uint32_t length)
    {
        LocalTensor<T> yLocal = outQueueY_.DeQue<T>();
        DataCopy(yGm_[offset], yLocal, length);
        outQueueY_.FreeTensor(yLocal);
    }

private:
    TPipe pipe_;
    TQue<TPosition::VECIN, QUEUE_DEPTH> inQueueX1_;
    TQue<TPosition::VECIN, QUEUE_DEPTH> inQueueX2_;
    TQue<TPosition::VECOUT, QUEUE_DEPTH> outQueueY_;
    GlobalTensor<T> x1Gm_;
    GlobalTensor<T> x2Gm_;
    GlobalTensor<T> yGm_;
    uint32_t begin_ = 0;
    uint32_t end_ = 0;
};

class SameShapeHalfSub {
public:
    __aicore__ inline void Init(GM_ADDR x1,
                                GM_ADDR x2,
                                GM_ADDR y,
                                uint32_t totalLength)
    {
        x1Gm_.SetGlobalBuffer((__gm__ half*)x1, totalLength);
        x2Gm_.SetGlobalBuffer((__gm__ half*)x2, totalLength);
        yGm_.SetGlobalBuffer((__gm__ half*)y, totalLength);

        uint32_t alignElements = ALIGN_BYTES / sizeof(half);
        GetAlignedRange(totalLength, alignElements, begin_, end_);

        pipe_.InitBuffer(inQueueX1_, QUEUE_DEPTH,
                         TILE_ELEMENTS * sizeof(half));
        pipe_.InitBuffer(inQueueX2_, QUEUE_DEPTH,
                         TILE_ELEMENTS * sizeof(half));
        pipe_.InitBuffer(outQueueY_, QUEUE_DEPTH,
                         TILE_ELEMENTS * sizeof(half));

        pipe_.InitBuffer(calcX1_, TILE_ELEMENTS * sizeof(float));
        pipe_.InitBuffer(calcX2_, TILE_ELEMENTS * sizeof(float));
        pipe_.InitBuffer(calcY_, TILE_ELEMENTS * sizeof(float));
    }

    __aicore__ inline void Process()
    {
        uint32_t alignElements = ALIGN_BYTES / sizeof(half);
        uint32_t offset = begin_;

        while (offset < end_) {
            uint32_t remaining = end_ - offset;
            uint32_t length =
                remaining < TILE_ELEMENTS ? remaining : TILE_ELEMENTS;
            uint32_t alignedLength =
                (length / alignElements) * alignElements;

            if (alignedLength > 0) {
                CopyIn(offset, alignedLength);
                Compute(alignedLength);
                CopyOut(offset, alignedLength);
            }

            uint32_t tailBegin = offset + alignedLength;
            uint32_t tailEnd = offset + length;
            for (uint32_t i = tailBegin; i < tailEnd; ++i) {
                float value =
                    static_cast<float>(x1Gm_.GetValue(i)) -
                    static_cast<float>(x2Gm_.GetValue(i));
                yGm_.SetValue(i, static_cast<half>(value));
            }
            offset += length;
        }
    }

private:
    __aicore__ inline void CopyIn(uint32_t offset, uint32_t length)
    {
        LocalTensor<half> x1Local = inQueueX1_.AllocTensor<half>();
        LocalTensor<half> x2Local = inQueueX2_.AllocTensor<half>();
        DataCopy(x1Local, x1Gm_[offset], length);
        DataCopy(x2Local, x2Gm_[offset], length);
        inQueueX1_.EnQue(x1Local);
        inQueueX2_.EnQue(x2Local);
    }

    __aicore__ inline void Compute(uint32_t length)
    {
        LocalTensor<half> x1Local = inQueueX1_.DeQue<half>();
        LocalTensor<half> x2Local = inQueueX2_.DeQue<half>();
        LocalTensor<half> yLocal = outQueueY_.AllocTensor<half>();
        LocalTensor<float> x1Float = calcX1_.Get<float>();
        LocalTensor<float> x2Float = calcX2_.Get<float>();
        LocalTensor<float> yFloat = calcY_.Get<float>();

        Cast(x1Float, x1Local, RoundMode::CAST_NONE, length);
        Cast(x2Float, x2Local, RoundMode::CAST_NONE, length);
        Sub(yFloat, x1Float, x2Float, length);
        Cast(yLocal, yFloat, RoundMode::CAST_RINT, length);

        outQueueY_.EnQue(yLocal);
        inQueueX1_.FreeTensor(x1Local);
        inQueueX2_.FreeTensor(x2Local);
    }

    __aicore__ inline void CopyOut(uint32_t offset, uint32_t length)
    {
        LocalTensor<half> yLocal = outQueueY_.DeQue<half>();
        DataCopy(yGm_[offset], yLocal, length);
        outQueueY_.FreeTensor(yLocal);
    }

private:
    TPipe pipe_;
    TQue<TPosition::VECIN, QUEUE_DEPTH> inQueueX1_;
    TQue<TPosition::VECIN, QUEUE_DEPTH> inQueueX2_;
    TQue<TPosition::VECOUT, QUEUE_DEPTH> outQueueY_;
    TBuf<TPosition::VECCALC> calcX1_;
    TBuf<TPosition::VECCALC> calcX2_;
    TBuf<TPosition::VECCALC> calcY_;
    GlobalTensor<half> x1Gm_;
    GlobalTensor<half> x2Gm_;
    GlobalTensor<half> yGm_;
    uint32_t begin_ = 0;
    uint32_t end_ = 0;
};

__aicore__ inline void GetBothInputOffsets(const SubTiling& tiling,
                                           uint32_t index,
                                           uint32_t& offset1,
                                           uint32_t& offset2)
{
    uint32_t remainder = index;
    offset1 = 0;
    offset2 = 0;
    for (uint32_t r = tiling.rank; r > 0; --r) {
        uint32_t dimIndex = r - 1;
        uint32_t dim = tiling.shape[dimIndex];
        uint32_t coord = remainder % dim;
        remainder /= dim;
        offset1 += coord * tiling.x1Stride[dimIndex];
        offset2 += coord * tiling.x2Stride[dimIndex];
    }
}

__aicore__ inline uint32_t GetRunBase(const SubTiling& tiling,
                                      uint32_t runIndex,
                                      const uint32_t* strides)
{
    uint32_t remainder = runIndex;
    uint32_t offset = 0;
    for (uint32_t r = tiling.innerAxis; r > 0; --r) {
        uint32_t dimIndex = r - 1;
        uint32_t dim = tiling.shape[dimIndex];
        uint32_t coord = remainder % dim;
        remainder /= dim;
        offset += coord * strides[dimIndex];
    }
    return offset;
}

template <typename T>
class BroadcastRunSub {
public:
    __aicore__ inline void Init(GM_ADDR x1,
                                GM_ADDR x2,
                                GM_ADDR y,
                                const SubTiling& tiling)
    {
        tiling_ = tiling;
        x1Gm_.SetGlobalBuffer((__gm__ T*)x1, tiling.totalLength);
        x2Gm_.SetGlobalBuffer((__gm__ T*)x2, tiling.totalLength);
        yGm_.SetGlobalBuffer((__gm__ T*)y, tiling.totalLength);
        innerLength_ = tiling.shape[tiling.innerAxis];
        stride1_ = tiling.x1Stride[tiling.innerAxis];
        stride2_ = tiling.x2Stride[tiling.innerAxis];

        uint32_t blockNum = GetBlockNum();
        uint32_t blockIdx = GetBlockIdx();
        if (blockNum == 0) {
            blockNum = 1;
        }
        uint64_t rawPerBlock =
            (static_cast<uint64_t>(tiling.outerCount) + blockNum - 1) /
            blockNum;
        uint64_t begin64 = static_cast<uint64_t>(blockIdx) * rawPerBlock;
        uint64_t end64 = begin64 + rawPerBlock;
        if (begin64 > tiling.outerCount) {
            begin64 = tiling.outerCount;
        }
        if (end64 > tiling.outerCount) {
            end64 = tiling.outerCount;
        }
        beginRun_ = static_cast<uint32_t>(begin64);
        endRun_ = static_cast<uint32_t>(end64);

        pipe_.InitBuffer(inQueueX1_, QUEUE_DEPTH,
                         TILE_ELEMENTS * sizeof(T));
        pipe_.InitBuffer(inQueueX2_, QUEUE_DEPTH,
                         TILE_ELEMENTS * sizeof(T));
        pipe_.InitBuffer(outQueueY_, QUEUE_DEPTH,
                         TILE_ELEMENTS * sizeof(T));
    }

    __aicore__ inline void Process()
    {
        for (uint32_t run = beginRun_; run < endRun_; ++run) {
            uint32_t base1 = GetRunBase(tiling_, run, tiling_.x1Stride);
            uint32_t base2 = GetRunBase(tiling_, run, tiling_.x2Stride);
            for (uint32_t inner = 0; inner < innerLength_;
                 inner += TILE_ELEMENTS) {
                uint32_t remaining = innerLength_ - inner;
                uint32_t length =
                    remaining < TILE_ELEMENTS ? remaining : TILE_ELEMENTS;

                uint32_t offset1 = base1 + (stride1_ == 0 ? 0 : inner);
                uint32_t offset2 = base2 + (stride2_ == 0 ? 0 : inner);
                CopyIn(offset1, offset2, length);
                Compute(length);
                CopyOut(run * innerLength_ + inner, length);
            }
        }
    }

private:
    __aicore__ inline void CopyIn(uint32_t offset1,
                                  uint32_t offset2,
                                  uint32_t length)
    {
        LocalTensor<T> x1Local = inQueueX1_.AllocTensor<T>();
        LocalTensor<T> x2Local = inQueueX2_.AllocTensor<T>();
        if (stride1_ == 0) {
            Duplicate(x1Local, x1Gm_.GetValue(offset1), length);
        } else {
            DataCopy(x1Local, x1Gm_[offset1], length);
        }
        if (stride2_ == 0) {
            Duplicate(x2Local, x2Gm_.GetValue(offset2), length);
        } else {
            DataCopy(x2Local, x2Gm_[offset2], length);
        }
        inQueueX1_.EnQue(x1Local);
        inQueueX2_.EnQue(x2Local);
    }

    __aicore__ inline void Compute(uint32_t length)
    {
        LocalTensor<T> x1Local = inQueueX1_.DeQue<T>();
        LocalTensor<T> x2Local = inQueueX2_.DeQue<T>();
        LocalTensor<T> yLocal = outQueueY_.AllocTensor<T>();
        Sub(yLocal, x1Local, x2Local, length);
        outQueueY_.EnQue(yLocal);
        inQueueX1_.FreeTensor(x1Local);
        inQueueX2_.FreeTensor(x2Local);
    }

    __aicore__ inline void CopyOut(uint32_t offset, uint32_t length)
    {
        LocalTensor<T> yLocal = outQueueY_.DeQue<T>();
        DataCopy(yGm_[offset], yLocal, length);
        outQueueY_.FreeTensor(yLocal);
    }

private:
    TPipe pipe_;
    TQue<TPosition::VECIN, QUEUE_DEPTH> inQueueX1_;
    TQue<TPosition::VECIN, QUEUE_DEPTH> inQueueX2_;
    TQue<TPosition::VECOUT, QUEUE_DEPTH> outQueueY_;
    GlobalTensor<T> x1Gm_;
    GlobalTensor<T> x2Gm_;
    GlobalTensor<T> yGm_;
    SubTiling tiling_;
    uint32_t innerLength_ = 0;
    uint32_t stride1_ = 0;
    uint32_t stride2_ = 0;
    uint32_t beginRun_ = 0;
    uint32_t endRun_ = 0;
};

__aicore__ inline void BroadcastPartition(uint32_t totalLength,
                                          uint32_t& begin,
                                          uint32_t& end)
{
    uint32_t blockNum = GetBlockNum();
    uint32_t blockIdx = GetBlockIdx();
    if (blockNum == 0) {
        blockNum = 1;
    }

    uint64_t rawPerBlock =
        (static_cast<uint64_t>(totalLength) + blockNum - 1) / blockNum;
    uint64_t begin64 = static_cast<uint64_t>(blockIdx) * rawPerBlock;
    uint64_t end64 = begin64 + rawPerBlock;

    if (begin64 > totalLength) {
        begin64 = totalLength;
    }
    if (end64 > totalLength) {
        end64 = totalLength;
    }
    begin = static_cast<uint32_t>(begin64);
    end = static_cast<uint32_t>(end64);
}

__aicore__ inline void BroadcastSubFloat(GM_ADDR x1,
                                         GM_ADDR x2,
                                         GM_ADDR y,
                                         const SubTiling& tiling)
{
    GlobalTensor<float> x1Gm;
    GlobalTensor<float> x2Gm;
    GlobalTensor<float> yGm;
    x1Gm.SetGlobalBuffer((__gm__ float*)x1, tiling.totalLength);
    x2Gm.SetGlobalBuffer((__gm__ float*)x2, tiling.totalLength);
    yGm.SetGlobalBuffer((__gm__ float*)y, tiling.totalLength);

    uint32_t begin = 0;
    uint32_t end = 0;
    BroadcastPartition(tiling.totalLength, begin, end);

    for (uint32_t i = begin; i < end; ++i) {
        uint32_t offset1 = 0;
        uint32_t offset2 = 0;
        GetBothInputOffsets(tiling, i, offset1, offset2);
        yGm.SetValue(i, x1Gm.GetValue(offset1) - x2Gm.GetValue(offset2));
    }
}

__aicore__ inline void BroadcastSubInt32(GM_ADDR x1,
                                         GM_ADDR x2,
                                         GM_ADDR y,
                                         const SubTiling& tiling)
{
    GlobalTensor<int32_t> x1Gm;
    GlobalTensor<int32_t> x2Gm;
    GlobalTensor<int32_t> yGm;
    x1Gm.SetGlobalBuffer((__gm__ int32_t*)x1, tiling.totalLength);
    x2Gm.SetGlobalBuffer((__gm__ int32_t*)x2, tiling.totalLength);
    yGm.SetGlobalBuffer((__gm__ int32_t*)y, tiling.totalLength);

    uint32_t begin = 0;
    uint32_t end = 0;
    BroadcastPartition(tiling.totalLength, begin, end);

    for (uint32_t i = begin; i < end; ++i) {
        uint32_t offset1 = 0;
        uint32_t offset2 = 0;
        GetBothInputOffsets(tiling, i, offset1, offset2);
        int64_t wide =
            static_cast<int64_t>(x1Gm.GetValue(offset1)) -
            static_cast<int64_t>(x2Gm.GetValue(offset2));
        yGm.SetValue(i, static_cast<int32_t>(static_cast<uint32_t>(wide)));
    }
}

__aicore__ inline void BroadcastSubHalf(GM_ADDR x1,
                                        GM_ADDR x2,
                                        GM_ADDR y,
                                        const SubTiling& tiling)
{
    GlobalTensor<half> x1Gm;
    GlobalTensor<half> x2Gm;
    GlobalTensor<half> yGm;
    x1Gm.SetGlobalBuffer((__gm__ half*)x1, tiling.totalLength);
    x2Gm.SetGlobalBuffer((__gm__ half*)x2, tiling.totalLength);
    yGm.SetGlobalBuffer((__gm__ half*)y, tiling.totalLength);

    uint32_t begin = 0;
    uint32_t end = 0;
    BroadcastPartition(tiling.totalLength, begin, end);

    for (uint32_t i = begin; i < end; ++i) {
        uint32_t offset1 = 0;
        uint32_t offset2 = 0;
        GetBothInputOffsets(tiling, i, offset1, offset2);
        float value =
            static_cast<float>(x1Gm.GetValue(offset1)) -
            static_cast<float>(x2Gm.GetValue(offset2));
        yGm.SetValue(i, static_cast<half>(value));
    }
}

}  // namespace sub_detail


__global__ __vector__ void sub_same_fp32(GM_ADDR x1,
                                         GM_ADDR x2,
                                         GM_ADDR y,
                                         uint32_t totalLength)
{
    sub_detail::SameShapeVectorSub<float> kernel;
    kernel.Init(x1, x2, y, totalLength);
    kernel.Process();
}

__global__ __vector__ void sub_same_int32(GM_ADDR x1,
                                          GM_ADDR x2,
                                          GM_ADDR y,
                                          uint32_t totalLength)
{
    sub_detail::SameShapeVectorSub<int32_t> kernel;
    kernel.Init(x1, x2, y, totalLength);
    kernel.Process();
}

__global__ __vector__ void sub_same_fp16(GM_ADDR x1,
                                         GM_ADDR x2,
                                         GM_ADDR y,
                                         uint32_t totalLength)
{
    sub_detail::SameShapeHalfSub kernel;
    kernel.Init(x1, x2, y, totalLength);
    kernel.Process();
}

__global__ __vector__ void sub_broadcast_fp32(GM_ADDR x1,
                                              GM_ADDR x2,
                                              GM_ADDR y,
                                              sub_detail::SubTiling tiling)
{
    sub_detail::BroadcastSubFloat(x1, x2, y, tiling);
}

__global__ __vector__ void sub_broadcast_fp32_vec(GM_ADDR x1,
                                                  GM_ADDR x2,
                                                  GM_ADDR y,
                                                  sub_detail::SubTiling tiling)
{
    sub_detail::BroadcastRunSub<float> kernel;
    kernel.Init(x1, x2, y, tiling);
    kernel.Process();
}

__global__ __vector__ void sub_broadcast_int32_vec(GM_ADDR x1,
                                                    GM_ADDR x2,
                                                    GM_ADDR y,
                                                    sub_detail::SubTiling tiling)
{
    sub_detail::BroadcastRunSub<int32_t> kernel;
    kernel.Init(x1, x2, y, tiling);
    kernel.Process();
}

__global__ __vector__ void sub_broadcast_int32(GM_ADDR x1,
                                               GM_ADDR x2,
                                               GM_ADDR y,
                                               sub_detail::SubTiling tiling)
{
    sub_detail::BroadcastSubInt32(x1, x2, y, tiling);
}

__global__ __vector__ void sub_broadcast_fp16(GM_ADDR x1,
                                              GM_ADDR x2,
                                              GM_ADDR y,
                                              sub_detail::SubTiling tiling)
{
    sub_detail::BroadcastSubHalf(x1, x2, y, tiling);
}


extern "C" void run_kernel(GM_ADDR x1,
                           const TensorGroupInfo& info_x1,
                           GM_ADDR x2,
                           const TensorGroupInfo& info_x2,
                           GM_ADDR y,
                           const TensorGroupInfo& info_y,
                           int64_t availableCoreNum,
                           aclrtStream stream)
{
    if (x1 == nullptr || x2 == nullptr || y == nullptr ||
        availableCoreNum <= 0) {
        return;
    }

    if (!sub_detail::ShapeValid(info_x1) ||
        !sub_detail::ShapeValid(info_x2) ||
        !sub_detail::ShapeValid(info_y)) {
        return;
    }

    int32_t dtype = info_x1.tensors[0].dtype;
    if (info_x2.tensors[0].dtype != dtype ||
        info_y.tensors[0].dtype != dtype) {
        return;
    }

    int64_t dtypeSize = sub_detail::DtypeSize(dtype);
    if (dtypeSize <= 0) {
        return;
    }

    if (sub_detail::SameShape(info_x1, info_x2) &&
        sub_detail::SameShape(info_x1, info_y)) {
        int64_t count = sub_detail::TensorElementCount(info_x1);
        if (count <= 0 ||
            count > (std::numeric_limits<uint32_t>::max)()) {
            return;
        }

        uint32_t totalLength = static_cast<uint32_t>(count);
        uint32_t blockNum = sub_detail::CalcBlockNum(
            totalLength, static_cast<uint32_t>(dtypeSize),
            availableCoreNum);

        if (dtype == 0) {
            sub_same_fp32<<<blockNum, nullptr, stream>>>(
                x1, x2, y, totalLength);
        } else if (dtype == 1) {
            sub_same_fp16<<<blockNum, nullptr, stream>>>(
                x1, x2, y, totalLength);
        } else {
            sub_same_int32<<<blockNum, nullptr, stream>>>(
                x1, x2, y, totalLength);
        }
        return;
    }

    sub_detail::SubTiling tiling = {};
    if (!sub_detail::BuildBroadcastTiling(
            info_x1, info_x2, info_y, tiling)) {
        return;
    }

    uint32_t blockNum = sub_detail::CalcBlockNum(
        tiling.totalLength, static_cast<uint32_t>(dtypeSize),
        availableCoreNum);

    bool useVector = sub_detail::CanUseBroadcastVector(
        tiling, static_cast<uint32_t>(dtypeSize));

    if (dtype == 0) {
        if (useVector) {
            sub_broadcast_fp32_vec<<<blockNum, nullptr, stream>>>(
                x1, x2, y, tiling);
        } else {
            sub_broadcast_fp32<<<blockNum, nullptr, stream>>>(
                x1, x2, y, tiling);
        }
    } else if (dtype == 1) {
        sub_broadcast_fp16<<<blockNum, nullptr, stream>>>(
            x1, x2, y, tiling);
    } else {
        if (useVector) {
            sub_broadcast_int32_vec<<<blockNum, nullptr, stream>>>(
                x1, x2, y, tiling);
        } else {
            sub_broadcast_int32<<<blockNum, nullptr, stream>>>(
                x1, x2, y, tiling);
        }
    }
}

