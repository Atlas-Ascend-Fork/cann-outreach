#include <cmath>
#include "kernel_operator.h"

/*
 * Sub Kernel - Ascend C Direct Invocation
 *
 * z = x - y
 * 输入形状固定为 (8, 2048)，支持 float32 / float16。
 * 使用 8 个核，每核处理 2048 个元素；核内按 128 个元素分块，
 * 配合 SUB_BUFFER_NUM = 2 的 double buffer 循环计算。
 */

constexpr uint32_t SUB_BUFFER_NUM = 2;
constexpr uint32_t SUB_QUEUE_DEPTH = 1;
constexpr uint32_t SUB_TILE_LENGTH = 128;  // 每块元素数
constexpr uint32_t SUB_BLOCK_DIM = 8;

template <typename T>
class KernelSub {
public:
    __aicore__ inline KernelSub() {}

    __aicore__ inline void Init(GM_ADDR x, GM_ADDR y, GM_ADDR z, uint32_t totalLength)
    {
        // 多核切分：每个核处理连续的一段数据
        this->blockLength = totalLength / AscendC::GetBlockNum();
        this->tileLength = SUB_TILE_LENGTH;
        this->loopCount = this->blockLength / this->tileLength;

        uint32_t offset = this->blockLength * AscendC::GetBlockIdx();
        xGm.SetGlobalBuffer((__gm__ T *)x + offset, this->blockLength);
        yGm.SetGlobalBuffer((__gm__ T *)y + offset, this->blockLength);
        zGm.SetGlobalBuffer((__gm__ T *)z + offset, this->blockLength);

        // 每个队列分配 SUB_BUFFER_NUM 块 UB 内存
        pipe.InitBuffer(inQueueX, SUB_BUFFER_NUM, this->tileLength * sizeof(T));
        pipe.InitBuffer(inQueueY, SUB_BUFFER_NUM, this->tileLength * sizeof(T));
        pipe.InitBuffer(outQueueZ, SUB_BUFFER_NUM, this->tileLength * sizeof(T));
    }

    __aicore__ inline void Process()
    {
        for (uint32_t i = 0; i < this->loopCount; ++i) {
            CopyIn(i);
            Compute(i);
            CopyOut(i);
        }
    }

private:
    __aicore__ inline void CopyIn(uint32_t progress)
    {
        AscendC::LocalTensor<T> xLocal = inQueueX.AllocTensor<T>();
        AscendC::LocalTensor<T> yLocal = inQueueY.AllocTensor<T>();
        AscendC::DataCopy(xLocal, xGm[progress * this->tileLength], this->tileLength);
        AscendC::DataCopy(yLocal, yGm[progress * this->tileLength], this->tileLength);
        inQueueX.EnQue(xLocal);
        inQueueY.EnQue(yLocal);
    }

    __aicore__ inline void Compute(uint32_t progress)
    {
        (void)progress;
        AscendC::LocalTensor<T> xLocal = inQueueX.DeQue<T>();
        AscendC::LocalTensor<T> yLocal = inQueueY.DeQue<T>();
        AscendC::LocalTensor<T> zLocal = outQueueZ.AllocTensor<T>();

        // z = x - y
        AscendC::Sub(zLocal, xLocal, yLocal, this->tileLength);

        outQueueZ.EnQue<T>(zLocal);
        inQueueX.FreeTensor(xLocal);
        inQueueY.FreeTensor(yLocal);
    }

    __aicore__ inline void CopyOut(uint32_t progress)
    {
        AscendC::LocalTensor<T> zLocal = outQueueZ.DeQue<T>();
        AscendC::DataCopy(zGm[progress * this->tileLength], zLocal, this->tileLength);
        outQueueZ.FreeTensor(zLocal);
    }

private:
    AscendC::TPipe pipe;
    AscendC::TQue<AscendC::QuePosition::VECIN, SUB_QUEUE_DEPTH> inQueueX, inQueueY;
    AscendC::TQue<AscendC::QuePosition::VECOUT, SUB_QUEUE_DEPTH> outQueueZ;
    AscendC::GlobalTensor<T> xGm, yGm, zGm;

    uint32_t blockLength;
    uint32_t tileLength;
    uint32_t loopCount;
};

template <typename T>
__global__ __vector__ void sub_custom(GM_ADDR x, GM_ADDR y, GM_ADDR z, uint32_t totalLength)
{
    KernelSub<T> op;
    op.Init(x, y, z, totalLength);
    op.Process();
}

extern "C" void run_kernel(GM_ADDR x, const TensorGroupInfo& info_x, GM_ADDR y, const TensorGroupInfo& info_y, GM_ADDR z, const TensorGroupInfo& info_z, int64_t availableCoreNum, aclrtStream stream)
{
    (void)availableCoreNum;
    (void)info_y;
    (void)info_z;

    // 1. 计算 x 的总元素数
    const TensorInfo& t0 = info_x.tensors[0];
    int64_t totalLength = 1;
    for (int64_t i = 0; i < t0.numDims; ++i) {
        totalLength *= t0.shape[i];
    }

    // 2. 按 dtype 选择模板实例：1 = fp16，其余按 fp32 处理
    uint32_t length = static_cast<uint32_t>(totalLength);
    if (t0.dtype == 1) {
        sub_custom<half><<<SUB_BLOCK_DIM, nullptr, stream>>>(x, y, z, length);
    } else {
        sub_custom<float><<<SUB_BLOCK_DIM, nullptr, stream>>>(x, y, z, length);
    }
}