#include <cmath>
#include "kernel_operator.h"

constexpr int32_t TILE_LENGTH = 2048;

template <typename T>
class SubKernel {
public:
    __aicore__ inline void Init(
        GM_ADDR x,
        GM_ADDR y,
        GM_ADDR z,
        int64_t totalLength,
        int32_t blockNum,
        AscendC::TPipe* pipe)
    {
        xGm.SetGlobalBuffer((__gm__ T*)x, totalLength);
        yGm.SetGlobalBuffer((__gm__ T*)y, totalLength);
        zGm.SetGlobalBuffer((__gm__ T*)z, totalLength);

        total = totalLength;
        blocks = blockNum;

        pipe->InitBuffer(queueX, 1, TILE_LENGTH * sizeof(T));
        pipe->InitBuffer(queueY, 1, TILE_LENGTH * sizeof(T));
        pipe->InitBuffer(queueZ, 1, TILE_LENGTH * sizeof(T));
    }

    __aicore__ inline void Process()
    {
        int64_t blockOffset =
            (int64_t)AscendC::GetBlockIdx() * TILE_LENGTH;

        int64_t stride =
            (int64_t)blocks * TILE_LENGTH;

        for (int64_t offset = blockOffset;
             offset < total;
             offset += stride)
        {
            int64_t remaining = total - offset;
            uint32_t length = (remaining < TILE_LENGTH)
                                  ? (uint32_t)remaining
                                  : TILE_LENGTH;

            AscendC::LocalTensor<T> xLocal =
                queueX.AllocTensor<T>();
            AscendC::LocalTensor<T> yLocal =
                queueY.AllocTensor<T>();

            AscendC::DataCopy(xLocal, xGm[offset], length);
            AscendC::DataCopy(yLocal, yGm[offset], length);

            queueX.EnQue(xLocal);
            queueY.EnQue(yLocal);

            xLocal = queueX.DeQue<T>();
            yLocal = queueY.DeQue<T>();

            AscendC::LocalTensor<T> zLocal =
                queueZ.AllocTensor<T>();

            AscendC::Sub(zLocal, xLocal, yLocal, length);

            queueZ.EnQue(zLocal);

            zLocal = queueZ.DeQue<T>();

            AscendC::DataCopy(zGm[offset], zLocal, length);

            queueX.FreeTensor(xLocal);
            queueY.FreeTensor(yLocal);
            queueZ.FreeTensor(zLocal);
        }
    }

private:
    AscendC::GlobalTensor<T> xGm;
    AscendC::GlobalTensor<T> yGm;
    AscendC::GlobalTensor<T> zGm;

    AscendC::TQue<AscendC::QuePosition::VECIN, 1> queueX;
    AscendC::TQue<AscendC::QuePosition::VECIN, 1> queueY;
    AscendC::TQue<AscendC::QuePosition::VECOUT, 1> queueZ;

    int64_t total;
    int32_t blocks;
};

template <typename T>
__global__ __aicore__ void sub_custom(
    GM_ADDR x,
    GM_ADDR y,
    GM_ADDR z,
    int64_t totalLength,
    int32_t blockNum)
{
    AscendC::TPipe pipe;
    SubKernel<T> op;

    op.Init(x, y, z, totalLength, blockNum, &pipe);
    op.Process();
}

extern "C" void run_kernel(
    GM_ADDR x,
    const TensorGroupInfo& info_x,
    GM_ADDR y,
    const TensorGroupInfo& info_y,
    GM_ADDR z,
    const TensorGroupInfo& info_z,
    int64_t availableCoreNum,
    aclrtStream stream)
{
    int64_t dim0 = info_x.tensors[0].shape[0];
    int64_t dim1 = info_x.tensors[0].shape[1];

    int64_t totalLength = dim0 * dim1;

    int32_t blockNum = (availableCoreNum < 8)
                           ? (int32_t)availableCoreNum
                           : 8;

    if (blockNum < 1) {
        blockNum = 1;
    }

    if (info_x.tensors[0].dtype == 0) {
        sub_custom<float><<<blockNum, nullptr, stream>>>(
            x, y, z, totalLength, blockNum);
    } else if (info_x.tensors[0].dtype == 1) {
        sub_custom<half><<<blockNum, nullptr, stream>>>(
            x, y, z, totalLength, blockNum);
    }
}