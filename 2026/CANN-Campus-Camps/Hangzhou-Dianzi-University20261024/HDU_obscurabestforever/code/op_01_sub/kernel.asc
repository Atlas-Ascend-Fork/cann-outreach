#include <cmath>
#include "kernel_operator.h"
// ---------------------------------------------------------------------------
// 优化版：z = x - y
//   1) 用满 availableCoreNum（不再写死 8 核）
//   2) 每核只搬一大块（不再 16 次 512B 小搬运）
//   3) 每核长度按 32B 对齐，尾部用 DataCopyPad 兜底（任意 shape 都不越界/不漏算）
// ---------------------------------------------------------------------------
struct SubCustomTilingData {
    uint32_t totalLength;   // 元素总数，例如 8 * 2048 = 16384
    uint32_t perCoreLen;    // 每核负责的元素数（32B 对齐）
};
constexpr uint32_t TILE_ELEMS = 4096;   // 单次搬运元素上限（4096*4B = 16KB）
constexpr uint32_t BUFFER_NUM = 1;
template <typename T>
class KernelSub {
public:
    __aicore__ inline KernelSub() {}
    __aicore__ inline void Init(GM_ADDR x, GM_ADDR y, GM_ADDR z, const SubCustomTilingData& tiling)
    {
        constexpr uint32_t align = 32U / sizeof(T);          // 32B 对齐的元素数：fp32=8，fp16=16
        uint32_t blockIdx = static_cast<uint32_t>(AscendC::GetBlockIdx());
        uint32_t offset = blockIdx * tiling.perCoreLen;
        if (offset >= tiling.totalLength) {
            len = 0U;
            fullLen = 0U;
            tailLen = 0U;
            return;
        }
        uint32_t remain = tiling.totalLength - offset;
        len = (remain < tiling.perCoreLen) ? remain : tiling.perCoreLen;
        xGm.SetGlobalBuffer(reinterpret_cast<__gm__ T *>(x) + offset, len);
        yGm.SetGlobalBuffer(reinterpret_cast<__gm__ T *>(y) + offset, len);
        zGm.SetGlobalBuffer(reinterpret_cast<__gm__ T *>(z) + offset, len);
        fullLen = (len / align) * align;                      // 32B 对齐的部分
        tailLen = len - fullLen;                              // 0 ~ align-1 个元素
        uint32_t bufElems = (fullLen < TILE_ELEMS) ? fullLen : TILE_ELEMS;
        if (bufElems < align) {
            bufElems = align;                                 // UB 至少 32B
        }
        tileElems = bufElems;
        pipe.InitBuffer(inQueueX, BUFFER_NUM, bufElems * sizeof(T));
        pipe.InitBuffer(inQueueY, BUFFER_NUM, bufElems * sizeof(T));
        pipe.InitBuffer(outQueueZ, BUFFER_NUM, bufElems * sizeof(T));
    }
    __aicore__ inline void Process()
    {
        uint32_t done = 0U;
        while (done < fullLen) {                              // 对齐部分：DataCopy 整块搬
            uint32_t cur = fullLen - done;
            if (cur > tileElems) {
                cur = tileElems;
            }
            CopyIn(done, cur);
            Compute(cur);
            CopyOut(done, cur);
            done += cur;
        }
        if (tailLen > 0U) {                                   // 尾部不足 32B：DataCopyPad
            CopyTail();
        }
    }
private:
    __aicore__ inline void CopyIn(uint32_t offset, uint32_t count)
    {
        AscendC::LocalTensor<T> xLocal = inQueueX.AllocTensor<T>();
        AscendC::LocalTensor<T> yLocal = inQueueY.AllocTensor<T>();
        AscendC::DataCopy(xLocal, xGm[offset], count);
        AscendC::DataCopy(yLocal, yGm[offset], count);
        inQueueX.EnQue(xLocal);
        inQueueY.EnQue(yLocal);
    }
    __aicore__ inline void Compute(uint32_t count)
    {
        AscendC::LocalTensor<T> xLocal = inQueueX.DeQue<T>();
        AscendC::LocalTensor<T> yLocal = inQueueY.DeQue<T>();
        AscendC::LocalTensor<T> zLocal = outQueueZ.AllocTensor<T>();
        AscendC::Sub(zLocal, xLocal, yLocal, count);
        outQueueZ.EnQue<T>(zLocal);
        inQueueX.FreeTensor(xLocal);
        inQueueY.FreeTensor(yLocal);
    }
    __aicore__ inline void CopyOut(uint32_t offset, uint32_t count)
    {
        AscendC::LocalTensor<T> zLocal = outQueueZ.DeQue<T>();
        AscendC::DataCopy(zGm[offset], zLocal, count);
        outQueueZ.FreeTensor(zLocal);
    }
    __aicore__ inline void CopyTail()
    {
        constexpr uint32_t align = 32U / sizeof(T);
        AscendC::DataCopyExtParams ext(1U, static_cast<uint32_t>(tailLen * sizeof(T)), 0U, 0U, 0U);
        AscendC::DataCopyPadExtParams<T> pad;
        AscendC::LocalTensor<T> xLocal = inQueueX.AllocTensor<T>();
        AscendC::LocalTensor<T> yLocal = inQueueY.AllocTensor<T>();
        AscendC::DataCopyPad(xLocal, xGm[fullLen], ext, pad);
        AscendC::DataCopyPad(yLocal, yGm[fullLen], ext, pad);
        inQueueX.EnQue(xLocal);
        inQueueY.EnQue(yLocal);
        xLocal = inQueueX.DeQue<T>();
        yLocal = inQueueY.DeQue<T>();
        AscendC::LocalTensor<T> zLocal = outQueueZ.AllocTensor<T>();
        AscendC::Sub(zLocal, xLocal, yLocal, align);           // 按一整个 32B 块算，多出的元素丢弃
        outQueueZ.EnQue<T>(zLocal);
        inQueueX.FreeTensor(xLocal);
        inQueueY.FreeTensor(yLocal);
        zLocal = outQueueZ.DeQue<T>();
        AscendC::DataCopyPad(zGm[fullLen], zLocal, ext);       // 只写回 tailLen 个元素
        outQueueZ.FreeTensor(zLocal);
    }
private:
    AscendC::TPipe pipe;
    AscendC::TQue<AscendC::QuePosition::VECIN, BUFFER_NUM> inQueueX;
    AscendC::TQue<AscendC::QuePosition::VECIN, BUFFER_NUM> inQueueY;
    AscendC::TQue<AscendC::QuePosition::VECOUT, BUFFER_NUM> outQueueZ;
    AscendC::GlobalTensor<T> xGm, yGm, zGm;
    uint32_t len = 0U;
    uint32_t fullLen = 0U;
    uint32_t tailLen = 0U;
    uint32_t tileElems = 0U;
};
template <typename T>
__global__ __vector__ void sub_custom(GM_ADDR x, GM_ADDR y, GM_ADDR z, SubCustomTilingData tiling)
{
    KernelSub<T> op;
    op.Init(x, y, z, tiling);
    op.Process();
}
template <typename T>
static void LaunchSub(GM_ADDR x, GM_ADDR y, GM_ADDR z, uint32_t totalLength, uint32_t coreNum,
                      aclrtStream stream)
{
    constexpr uint32_t align = 32U / sizeof(T);
    if (totalLength == 0U) {
        return;
    }
    uint32_t perCore = (totalLength + coreNum - 1U) / coreNum;       // 向上取整
    perCore = ((perCore + align - 1U) / align) * align;               // 32B 对齐
    uint32_t blockNum = (totalLength + perCore - 1U) / perCore;
    SubCustomTilingData tiling{totalLength, perCore};
    sub_custom<T><<<blockNum, nullptr, stream>>>(x, y, z, tiling);
}
extern "C" void run_kernel(GM_ADDR x, const TensorGroupInfo& info_x, GM_ADDR y, const TensorGroupInfo& info_y,
                           GM_ADDR z, const TensorGroupInfo& info_z, int64_t availableCoreNum,
                           aclrtStream stream)
{
    const TensorInfo& t0 = info_x.tensors[0];
    uint32_t totalLength = 1U;
    for (int64_t i = 0; i < t0.numDims; ++i) {
        totalLength *= static_cast<uint32_t>(t0.shape[i]);
    }
    uint32_t coreNum = (availableCoreNum > 0) ? static_cast<uint32_t>(availableCoreNum) : 1U;
    if (coreNum > totalLength) {
        coreNum = (totalLength > 0U) ? totalLength : 1U;
    }
    if (t0.dtype == 1) {                 // fp16
        LaunchSub<half>(x, y, z, totalLength, coreNum, stream);
    } else {                             // fp32（及其他类型按 fp32 处理）
        LaunchSub<float>(x, y, z, totalLength, coreNum, stream);
    }
}