#include <cstdint>
#include "kernel_operator.h"

// 本算子的输入约定：x/y/z 均为连续 ND，shape=(8, 2048)，dtype 为 fp32/fp16。
// 固定小 shape 每核一次处理完，避免通用多 Tile 队列的管理和同步开销。
constexpr uint32_t SUB_ELEMENT_NUM = 8 * 2048;
constexpr uint32_t SUB_ALIGN_BYTES = 256;
// 无硬件实测时的初始分核粒度；可在目标 NPU 上比较 2048/4096/8192。
constexpr uint32_t SUB_BYTES_PER_CORE = 4096;

struct SubCustomTilingData {
    uint32_t unitsPerCore;
    uint32_t extraCoreNum;
};

// 余下的 256B 单元分给前 extraCoreNum 个核，不要求核数整除张量长度。
template <typename T>
inline SubCustomTilingData MakeSubTiling(int64_t availableCoreNum, uint32_t& blockDim)
{
    constexpr uint32_t totalBytes = SUB_ELEMENT_NUM * sizeof(T);
    constexpr uint32_t totalUnits = totalBytes / SUB_ALIGN_BYTES;
    constexpr uint32_t targetCores = totalBytes / SUB_BYTES_PER_CORE;
    const uint32_t coreLimit = availableCoreNum > 0
        ? static_cast<uint32_t>(availableCoreNum < targetCores ? availableCoreNum : targetCores)
        : 1;
    blockDim = coreLimit;
    return {totalUnits / blockDim, totalUnits % blockDim};
}

template <typename T>
__global__ __vector__ void sub_custom(GM_ADDR x, GM_ADDR y, GM_ADDR z,
                                    SubCustomTilingData tiling)
{
    constexpr uint32_t elementsPerUnit = SUB_ALIGN_BYTES / sizeof(T);
    const uint32_t blockIdx = AscendC::GetBlockIdx();
    const uint32_t extraBefore = blockIdx < tiling.extraCoreNum ? blockIdx : tiling.extraCoreNum;
    const uint32_t offset = (blockIdx * tiling.unitsPerCore + extraBefore) * elementsPerUnit;
    const uint32_t length = (tiling.unitsPerCore + (blockIdx < tiling.extraCoreNum ? 1 : 0))
        * elementsPerUnit;

    AscendC::GlobalTensor<T> xGm, yGm, zGm;
    xGm.SetGlobalBuffer((__gm__ T*)x + offset, length);
    yGm.SetGlobalBuffer((__gm__ T*)y + offset, length);
    zGm.SetGlobalBuffer((__gm__ T*)z + offset, length);

    AscendC::TPipe pipe;
    AscendC::TBuf<AscendC::TPosition::VECCALC> inputBuffer;
    // x/y 共用一块 UB，结果原位覆盖 x；不再申请单独的输出缓冲。
    // 最坏为单核 FP32：2 * 16384 * 4 = 128 KiB。
    pipe.InitBuffer(inputBuffer, 2 * length * sizeof(T));
    AscendC::LocalTensor<T> xLocal = inputBuffer.Get<T>();
    AscendC::LocalTensor<T> yLocal = xLocal[length];

    AscendC::DataCopy(xLocal, xGm, length);
    AscendC::DataCopy(yLocal, yGm, length);
    // 两路输入均搬入后才能计算；事件由 TPipe 分配，避免硬编码 ID 冲突。
    const int32_t inputReady = static_cast<int32_t>(pipe.FetchEventID(AscendC::HardEvent::MTE2_V));
    AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(inputReady);
    AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(inputReady);

    AscendC::Sub(xLocal, xLocal, yLocal, length);

    const int32_t outputReady = static_cast<int32_t>(pipe.FetchEventID(AscendC::HardEvent::V_MTE3));
    AscendC::SetFlag<AscendC::HardEvent::V_MTE3>(outputReady);
    AscendC::WaitFlag<AscendC::HardEvent::V_MTE3>(outputReady);
    AscendC::DataCopy(zGm, xLocal, length);
}

template <typename T>
inline void LaunchSub(GM_ADDR x, GM_ADDR y, GM_ADDR z, int64_t availableCoreNum,
                      aclrtStream stream)
{
    uint32_t blockDim;
    const SubCustomTilingData tiling = MakeSubTiling<T>(availableCoreNum, blockDim);
    sub_custom<T><<<blockDim, nullptr, stream>>>(x, y, z, tiling);
}

extern "C" void run_kernel(GM_ADDR x, const TensorGroupInfo& info_x,
                           GM_ADDR y, const TensorGroupInfo&,
                           GM_ADDR z, const TensorGroupInfo&,
                           int64_t availableCoreNum, aclrtStream stream)
{
    // 沿用评测接口的 dtype 编码：0=fp32，1=fp16。
    if (info_x.tensors[0].dtype == 1) {
        LaunchSub<half>(x, y, z, availableCoreNum, stream);
    } else {
        LaunchSub<float>(x, y, z, availableCoreNum, stream);
    }
}
