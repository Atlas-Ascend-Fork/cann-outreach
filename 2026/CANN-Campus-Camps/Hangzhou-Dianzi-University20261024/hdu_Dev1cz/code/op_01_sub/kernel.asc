#include "kernel_operator.h"

constexpr uint32_t TILE_LENGTH = 256;
constexpr uint32_t QUEUE_DEPTH = 1;

template <typename T>
class KernelSub {
public:
    __aicore__ inline KernelSub() {}

    __aicore__ inline void Init(
        GM_ADDR x,
        GM_ADDR y,
        GM_ADDR z,
        uint32_t rowCount,
        uint32_t rowLength,
        uint32_t blockNum)
    {
        this->rowCount = rowCount;
        this->rowLength = rowLength;
        this->blockNum = blockNum;
        this->tileNum = rowLength / TILE_LENGTH;

        xGm.SetGlobalBuffer((__gm__ T*)x);
        yGm.SetGlobalBuffer((__gm__ T*)y);
        zGm.SetGlobalBuffer((__gm__ T*)z);

        pipe.InitBuffer(inQueueX, QUEUE_DEPTH, TILE_LENGTH * sizeof(T));
        pipe.InitBuffer(inQueueY, QUEUE_DEPTH, TILE_LENGTH * sizeof(T));
        pipe.InitBuffer(outQueueZ, QUEUE_DEPTH, TILE_LENGTH * sizeof(T));
    }

    __aicore__ inline void Process()
    {
        const uint32_t blockIdx = AscendC::GetBlockIdx();

        for (uint32_t row = blockIdx; row < rowCount; row += blockNum) {
            const uint32_t rowOffset = row * rowLength;

            for (uint32_t tile = 0; tile < tileNum; ++tile) {
                CopyIn(rowOffset, tile);
                Compute();
                CopyOut(rowOffset, tile);
            }
        }
    }

private:
    __aicore__ inline void CopyIn(uint32_t rowOffset, uint32_t tile)
    {
        const uint32_t offset = rowOffset + tile * TILE_LENGTH;

        AscendC::LocalTensor<T> xLocal = inQueueX.AllocTensor<T>();
        AscendC::LocalTensor<T> yLocal = inQueueY.AllocTensor<T>();

        AscendC::DataCopy(xLocal, xGm[offset], TILE_LENGTH);
        AscendC::DataCopy(yLocal, yGm[offset], TILE_LENGTH);

        inQueueX.EnQue(xLocal);
        inQueueY.EnQue(yLocal);
    }

    __aicore__ inline void Compute()
    {
        AscendC::LocalTensor<T> xLocal = inQueueX.DeQue<T>();
        AscendC::LocalTensor<T> yLocal = inQueueY.DeQue<T>();
        AscendC::LocalTensor<T> zLocal = outQueueZ.AllocTensor<T>();

        AscendC::Sub(zLocal, xLocal, yLocal, TILE_LENGTH);

        outQueueZ.EnQue(zLocal);
        inQueueX.FreeTensor(xLocal);
        inQueueY.FreeTensor(yLocal);
    }

    __aicore__ inline void CopyOut(uint32_t rowOffset, uint32_t tile)
    {
        const uint32_t offset = rowOffset + tile * TILE_LENGTH;

        AscendC::LocalTensor<T> zLocal = outQueueZ.DeQue<T>();
        AscendC::DataCopy(zGm[offset], zLocal, TILE_LENGTH);
        outQueueZ.FreeTensor(zLocal);
    }

private:
    AscendC::TPipe pipe;

    AscendC::TQue<AscendC::QuePosition::VECIN, QUEUE_DEPTH> inQueueX;
    AscendC::TQue<AscendC::QuePosition::VECIN, QUEUE_DEPTH> inQueueY;
    AscendC::TQue<AscendC::QuePosition::VECOUT, QUEUE_DEPTH> outQueueZ;

    AscendC::GlobalTensor<T> xGm;
    AscendC::GlobalTensor<T> yGm;
    AscendC::GlobalTensor<T> zGm;

    uint32_t rowCount = 0;
    uint32_t rowLength = 0;
    uint32_t tileNum = 0;
    uint32_t blockNum = 0;
};

template <typename T>
__global__ __vector__ void sub_custom(
    GM_ADDR x,
    GM_ADDR y,
    GM_ADDR z,
    uint32_t rowCount,
    uint32_t rowLength,
    uint32_t blockNum)
{
    KernelSub<T> op;
    op.Init(x, y, z, rowCount, rowLength, blockNum);
    op.Process();
}

extern "C" void run_kernel(
    GM_ADDR x,
    const TensorGroupInfo& info_x,
    GM_ADDR y,
    const TensorGroupInfo& info_y,
    GM_ADDR z,
    const TensorGroupInfo& info_z,
    int64_t availableCoreNum,
    aclrtStream stream)
{
    if (info_x.numTensors < 1 ||
        info_y.numTensors < 1 ||
        info_z.numTensors < 1) {
        return;
    }

    const TensorInfo& tx = info_x.tensors[0];
    const TensorInfo& ty = info_y.tensors[0];
    const TensorInfo& tz = info_z.tensors[0];

    if (tx.numDims != 2 || ty.numDims != 2 || tz.numDims != 2) {
        return;
    }
    if (tx.shape[0] != 8 || tx.shape[1] != 2048 ||
        ty.shape[0] != 8 || ty.shape[1] != 2048 ||
        tz.shape[0] != 8 || tz.shape[1] != 2048) {
        return;
    }
    if (tx.dtype != ty.dtype || tx.dtype != tz.dtype) {
        return;
    }

    const uint32_t rowCount = static_cast<uint32_t>(tx.shape[0]);
    const uint32_t rowLength = static_cast<uint32_t>(tx.shape[1]);

    uint32_t blockNum = rowCount;
    if (availableCoreNum > 0 &&
        availableCoreNum < static_cast<int64_t>(rowCount)) {
        blockNum = static_cast<uint32_t>(availableCoreNum);
    }

    if (tx.dtype == 0) {
        sub_custom<float><<<blockNum, nullptr, stream>>>(
            x, y, z, rowCount, rowLength, blockNum);
    } else if (tx.dtype == 1) {
        sub_custom<half><<<blockNum, nullptr, stream>>>(
            x, y, z, rowCount, rowLength, blockNum);
    }
}