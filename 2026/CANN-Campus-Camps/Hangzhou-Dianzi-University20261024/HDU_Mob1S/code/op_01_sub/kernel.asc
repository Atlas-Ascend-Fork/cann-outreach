
#include <cstdint>
#include "kernel_operator.h"

struct SubCustomTilingData {
    uint64_t totalLength;
};

constexpr uint32_t TILE_LENGTH = 1024;
constexpr uint32_t BUFFER_NUM = 2;

template <typename T>
class KernelSub {
public:
    __aicore__ inline KernelSub() {}

    __aicore__ inline void Init(
        GM_ADDR x,
        GM_ADDR y,
        GM_ADDR z,
        const SubCustomTilingData& tiling)
    {
        totalLength = tiling.totalLength;

        xGm.SetGlobalBuffer(
            (__gm__ T*)x, totalLength);
        yGm.SetGlobalBuffer(
            (__gm__ T*)y, totalLength);
        zGm.SetGlobalBuffer(
            (__gm__ T*)z, totalLength);

        pipe.InitBuffer(
            inQueueX, BUFFER_NUM,
            TILE_LENGTH * sizeof(T));
        pipe.InitBuffer(
            inQueueY, BUFFER_NUM,
            TILE_LENGTH * sizeof(T));
        pipe.InitBuffer(
            outQueueZ, BUFFER_NUM,
            TILE_LENGTH * sizeof(T));
    }

    __aicore__ inline void Process()
    {
        const uint64_t alignElems = 32 / sizeof(T);

        // 可以使用 DataCopy 处理的对齐元素总数
        const uint64_t alignedLength =
            (totalLength / alignElems) * alignElems;

        // 完整 Tile 数量
        const uint64_t fullTiles =
            alignedLength / TILE_LENGTH;

        // 不足一个完整 Tile，但仍然满足 32 字节对齐的部分
        const uint32_t alignedTail =
            static_cast<uint32_t>(
                alignedLength % TILE_LENGTH);

        // 不足 32 字节的最后一小段
        const uint32_t scalarTail =
            static_cast<uint32_t>(
                totalLength - alignedLength);

        const uint32_t coreNum =
            AscendC::GetBlockNum();
        const uint32_t coreIdx =
            AscendC::GetBlockIdx();

        // 通过整数区间划分均衡分配完整 Tile。
        // 要求 host 启动的核数不超过 fullTiles；
        // fullTiles == 0 时只启动一个核。
        const uint64_t begin =
            fullTiles * coreIdx / coreNum;
        const uint64_t end =
            fullTiles * (coreIdx + 1) / coreNum;

        for (uint64_t tile = begin; tile < end; ++tile) {
            const uint64_t offset = tile * TILE_LENGTH;

            CopyIn(offset, TILE_LENGTH);
            Compute(TILE_LENGTH);
            CopyOut(offset, TILE_LENGTH);
        }

        // 剩余的对齐数据交给核 0 处理
        if (coreIdx == 0 && alignedTail > 0) {
            const uint64_t offset =
                fullTiles * TILE_LENGTH;

            CopyIn(offset, alignedTail);
            Compute(alignedTail);
            CopyOut(offset, alignedTail);
        }

        // 最后不足 32 字节的部分逐元素搬运
        if (coreIdx == 0 && scalarTail > 0) {
            const uint64_t offset = alignedLength;

            CopyInScalar(offset, scalarTail);
            Compute(scalarTail);
            CopyOutScalar(offset, scalarTail);
        }
    }

private:
    __aicore__ inline void CopyIn(
        uint64_t offset,
        uint32_t count)
    {
        auto xLocal = inQueueX.AllocTensor<T>();
        auto yLocal = inQueueY.AllocTensor<T>();

        AscendC::DataCopy(
            xLocal, xGm[offset], count);
        AscendC::DataCopy(
            yLocal, yGm[offset], count);

        inQueueX.EnQue(xLocal);
        inQueueY.EnQue(yLocal);
    }

    __aicore__ inline void Compute(uint32_t count)
    {
        auto xLocal = inQueueX.DeQue<T>();
        auto yLocal = inQueueY.DeQue<T>();
        auto zLocal = outQueueZ.AllocTensor<T>();

        AscendC::Sub(
            zLocal, xLocal, yLocal, count);

        outQueueZ.EnQue(zLocal);

        inQueueX.FreeTensor(xLocal);
        inQueueY.FreeTensor(yLocal);
    }

    __aicore__ inline void CopyOut(
        uint64_t offset,
        uint32_t count)
    {
        auto zLocal = outQueueZ.DeQue<T>();

        AscendC::DataCopy(
            zGm[offset], zLocal, count);

        outQueueZ.FreeTensor(zLocal);
    }

    __aicore__ inline void CopyInScalar(
        uint64_t offset,
        uint32_t count)
    {
        auto xLocal = inQueueX.AllocTensor<T>();
        auto yLocal = inQueueY.AllocTensor<T>();

        for (uint32_t i = 0; i < count; ++i) {
            xLocal.SetValue(i, xGm.GetValue(offset + i));
            yLocal.SetValue(i, yGm.GetValue(offset + i));
        }

        inQueueX.EnQue(xLocal);
        inQueueY.EnQue(yLocal);
    }

    __aicore__ inline void CopyOutScalar(
        uint64_t offset,
        uint32_t count)
    {
        auto zLocal = outQueueZ.DeQue<T>();

        for (uint32_t i = 0; i < count; ++i) {
            zGm.SetValue(offset + i, zLocal.GetValue(i));
        }

        outQueueZ.FreeTensor(zLocal);
    }

private:
    AscendC::TPipe pipe;

    AscendC::TQue<
        AscendC::QuePosition::VECIN, BUFFER_NUM>
        inQueueX, inQueueY;

    AscendC::TQue<
        AscendC::QuePosition::VECOUT, BUFFER_NUM>
        outQueueZ;

    AscendC::GlobalTensor<T> xGm, yGm, zGm;

    uint64_t totalLength;
};

template <typename T>
__global__ __vector__ void sub_custom(
    GM_ADDR x,
    GM_ADDR y,
    GM_ADDR z,
    SubCustomTilingData tiling)
{
    KernelSub<T> op;
    op.Init(x, y, z, tiling);
    op.Process();
}

extern "C" void run_kernel(
    GM_ADDR x,
    const TensorGroupInfo& info_x,
    GM_ADDR y,
    const TensorGroupInfo& info_y,
    GM_ADDR z,
    const TensorGroupInfo& info_z,
    int64_t availableCoreNum,
    aclrtStream stream)
{
    const TensorInfo& t0 = info_x.tensors[0];

    uint64_t totalLength = 1;
    for (int64_t i = 0; i < t0.numDims; ++i) {
        totalLength *= static_cast<uint64_t>(t0.shape[i]);
    }

    const int32_t dtype = t0.dtype;

    // 本版本支持 FP16、FP32 和 INT32
    uint64_t elementSize;
    if (dtype == 1) {
        elementSize = sizeof(half);
    } else if (dtype == 0 || dtype == 5) {
        elementSize = sizeof(uint32_t);
    } else {
        return;
    }

    const uint64_t alignElems = 32 / elementSize;
    const uint64_t alignedLength =
        totalLength / alignElems * alignElems;
    const uint64_t fullTiles =
        alignedLength / TILE_LENGTH;

    // 数据量较小时减少无效核启动。
    uint64_t requestedCores =
        availableCoreNum > 0
        ? static_cast<uint64_t>(availableCoreNum)
        : 8;

    const uint64_t usefulCores =
        fullTiles > 0 ? fullTiles : 1;

    uint32_t blockDim = static_cast<uint32_t>(
        requestedCores < usefulCores
        ? requestedCores : usefulCores);

    if (blockDim == 0) {
        blockDim = 1;
    }

    SubCustomTilingData tiling{totalLength};

    if (dtype == 1) {
        sub_custom<half>
            <<<blockDim, nullptr, stream>>>(x, y, z, tiling);
    } else if (dtype == 0) {
        sub_custom<float>
            <<<blockDim, nullptr, stream>>>(x, y, z, tiling);
    } else if (dtype == 5) {
        sub_custom<int32_t>
            <<<blockDim, nullptr, stream>>>(x, y, z, tiling);
    }
}
