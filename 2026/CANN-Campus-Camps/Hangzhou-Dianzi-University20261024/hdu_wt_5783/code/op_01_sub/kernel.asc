#include <cmath>
#include "kernel_operator.h"

struct SubCustomTilingData {
    uint32_t totalLength;
};

constexpr uint32_t QUEUE_DEPTH = 2;
constexpr uint32_t TILE_BYTES = 8192;

template <typename T>
class KernelSub {
public:
    __aicore__ inline KernelSub() {}

    __aicore__ inline void Init(GM_ADDR x, GM_ADDR y, GM_ADDR z, const SubCustomTilingData& tiling)
    {
        constexpr uint32_t alignElems = 32 / sizeof(T);
        constexpr uint32_t maxTileElems = TILE_BYTES / sizeof(T);

        uint32_t totalLength = tiling.totalLength;
        uint32_t blockNum = AscendC::GetBlockNum();
        uint32_t blockIdx = AscendC::GetBlockIdx();

        uint32_t blockLength = (totalLength + blockNum - 1) / blockNum;
        blockLength = (blockLength + alignElems - 1) / alignElems * alignElems;

        uint32_t blockStart = blockIdx * blockLength;
        uint32_t coreLength = 0;
        if (blockStart < totalLength) {
            coreLength = totalLength - blockStart;
            if (coreLength > blockLength) {
                coreLength = blockLength;
            }
        }

        uint32_t tileLength = coreLength < maxTileElems ? coreLength : maxTileElems;
        tileLength = tileLength / alignElems * alignElems;
        if (tileLength == 0) {
            tileLength = alignElems;
        }

        this->coreLength = coreLength;
        this->tileLength = tileLength;

        xGm.SetGlobalBuffer((__gm__ T *)x + blockStart, coreLength);
        yGm.SetGlobalBuffer((__gm__ T *)y + blockStart, coreLength);
        zGm.SetGlobalBuffer((__gm__ T *)z + blockStart, coreLength);

        pipe.InitBuffer(inQueueX, QUEUE_DEPTH, tileLength * sizeof(T));
        pipe.InitBuffer(inQueueY, QUEUE_DEPTH, tileLength * sizeof(T));
        pipe.InitBuffer(outQueueZ, QUEUE_DEPTH, tileLength * sizeof(T));
    }

    __aicore__ inline void Process()
    {
        uint32_t offset = 0;
        while (offset < coreLength) {
            uint32_t remain = coreLength - offset;
            uint32_t count = remain < tileLength ? remain : tileLength;
            CopyIn(offset, count);
            Compute(count);
            CopyOut(offset, count);
            offset += count;
        }
    }

private:
    __aicore__ inline void CopyIn(uint32_t offset, uint32_t count)
    {
        AscendC::LocalTensor<T> xLocal = inQueueX.AllocTensor<T>();
        AscendC::LocalTensor<T> yLocal = inQueueY.AllocTensor<T>();
        if (count * sizeof(T) % 32 == 0) {
            AscendC::DataCopy(xLocal, xGm[offset], count);
            AscendC::DataCopy(yLocal, yGm[offset], count);
        } else {
            AscendC::DataCopyExtParams copyParams{1, static_cast<uint32_t>(count * sizeof(T)), 0, 0, 0};
            AscendC::DataCopyPadExtParams<T> padParams{false, 0, 0, 0};
            AscendC::DataCopyPad(xLocal, xGm[offset], copyParams, padParams);
            AscendC::DataCopyPad(yLocal, yGm[offset], copyParams, padParams);
        }
        inQueueX.EnQue(xLocal);
        inQueueY.EnQue(yLocal);
    }

    __aicore__ inline void Compute(uint32_t count)
    {
        AscendC::LocalTensor<T> xLocal = inQueueX.DeQue<T>();
        AscendC::LocalTensor<T> yLocal = inQueueY.DeQue<T>();
        AscendC::LocalTensor<T> zLocal = outQueueZ.AllocTensor<T>();
        AscendC::Sub(zLocal, xLocal, yLocal, count);
        outQueueZ.EnQue<T>(zLocal);
        inQueueX.FreeTensor(xLocal);
        inQueueY.FreeTensor(yLocal);
    }

    __aicore__ inline void CopyOut(uint32_t offset, uint32_t count)
    {
        AscendC::LocalTensor<T> zLocal = outQueueZ.DeQue<T>();
        if (count * sizeof(T) % 32 == 0) {
            AscendC::DataCopy(zGm[offset], zLocal, count);
        } else {
            AscendC::DataCopyExtParams copyParams{1, static_cast<uint32_t>(count * sizeof(T)), 0, 0, 0};
            AscendC::DataCopyPad(zGm[offset], zLocal, copyParams);
        }
        outQueueZ.FreeTensor(zLocal);
    }

private:
    AscendC::TPipe pipe;
    AscendC::TQue<AscendC::QuePosition::VECIN, QUEUE_DEPTH> inQueueX, inQueueY;
    AscendC::TQue<AscendC::QuePosition::VECOUT, QUEUE_DEPTH> outQueueZ;
    AscendC::GlobalTensor<T> xGm, yGm, zGm;
    uint32_t coreLength = 0;
    uint32_t tileLength = 1;
};

template <typename T>
__global__ __vector__ void sub_custom(GM_ADDR x, GM_ADDR y, GM_ADDR z, SubCustomTilingData tiling)
{
    KernelSub<T> op;
    op.Init(x, y, z, tiling);
    op.Process();
}

extern "C" void run_kernel(GM_ADDR x, const TensorGroupInfo& info_x, GM_ADDR y, const TensorGroupInfo& info_y, GM_ADDR z, const TensorGroupInfo& info_z, int64_t availableCoreNum, aclrtStream stream)
{
    const TensorInfo& t0 = info_x.tensors[0];
    int64_t totalLength = 1;
    for (int64_t i = 0; i < t0.numDims; ++i) {
        totalLength *= t0.shape[i];
    }

    uint32_t blockDim = 8;
    if (availableCoreNum > 0 && availableCoreNum < static_cast<int64_t>(blockDim)) {
        blockDim = static_cast<uint32_t>(availableCoreNum);
    }
    if (totalLength > 0 && totalLength < static_cast<int64_t>(blockDim)) {
        blockDim = static_cast<uint32_t>(totalLength);
    }
    if (totalLength <= 0) {
        return;
    }

    SubCustomTilingData tiling = {static_cast<uint32_t>(totalLength)};
    if (t0.dtype == 1) {
        sub_custom<half><<<blockDim, nullptr, stream>>>(x, y, z, tiling);
    } else {
        sub_custom<float><<<blockDim, nullptr, stream>>>(x, y, z, tiling);
    }
}