#include <cmath>
#include "kernel_operator.h"
/*
 * Sub Kernel — Ascend C Direct Invocation
 * This file is #included — do NOT add main(), #pragma once, or include guards.
 *
 * TensorGroupInfo / TensorInfo (predefined):
 *   struct TensorInfo { const int64_t* shape; int64_t numDims; int32_t dtype; };
 *   struct TensorGroupInfo { const TensorInfo* tensors; int64_t numTensors; };
 *   dtype: 0=fp32 1=fp16 2=bf16 3=int8 4=int16 5=int32 6=int64 7=uint8 8=uint16 9=uint32 10=uint64 11=bool
 *   Usage: info_x.tensors[0].shape[0]  // first dim of first tensor in input x
 *
 * __global__ __vector__ void sub_custom(...)
 * {
 *     // TODO: implement your kernel logic
 *     // Available APIs: AscendC::TPipe, AscendC::TQue, AscendC::DataCopy, AscendC::Add, ...
 * }
 */

// ---------------- device kernel ----------------
template <typename T>
class KernelSub {
public:
    __aicore__ inline KernelSub() {}

    __aicore__ inline void Init(GM_ADDR x, GM_ADDR y, GM_ADDR z,
                                int64_t totalElems, int64_t coreElems)
    {
        int64_t start  = AscendC::GetBlockIdx() * coreElems;
        int64_t remain = totalElems - start;
        numElems_ = remain < coreElems ? (remain > 0 ? remain : 0) : coreElems;

        xGm_.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(x) + start, numElems_);
        yGm_.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(y) + start, numElems_);
        zGm_.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(z) + start, numElems_);

        pipe_.InitBuffer(inQueueX_,  1, TILE_ELEMS * sizeof(T));
        pipe_.InitBuffer(inQueueY_,  1, TILE_ELEMS * sizeof(T));
        pipe_.InitBuffer(outQueueZ_, 1, TILE_ELEMS * sizeof(T));
    }

    __aicore__ inline void Process()
    {
        // 每核数据量 <= TILE_ELEMS，单次搬运 + 一次 Sub 完成
        for (int64_t off = 0; off < numElems_; off += TILE_ELEMS) {
            int64_t len = numElems_ - off;
            if (len > TILE_ELEMS) len = TILE_ELEMS;

            auto xLocal = inQueueX_.AllocTensor<T>();
            auto yLocal = inQueueY_.AllocTensor<T>();
            // totalElems 与 coreElems 均 32B 对齐，len 必为 ALIGN 的倍数
            AscendC::DataCopy(xLocal, xGm_[off], len);
            AscendC::DataCopy(yLocal, yGm_[off], len);
            inQueueX_.EnQue(xLocal);
            inQueueY_.EnQue(yLocal);

            auto xCalc = inQueueX_.DeQue<T>();
            auto yCalc = inQueueY_.DeQue<T>();
            auto zLocal = outQueueZ_.AllocTensor<T>();
            AscendC::Sub(zLocal, xCalc, yCalc, static_cast<uint32_t>(len));
            outQueueZ_.EnQue(zLocal);
            inQueueX_.FreeTensor(xCalc);
            inQueueY_.FreeTensor(yCalc);

            auto zOut = outQueueZ_.DeQue<T>();
            AscendC::DataCopy(zGm_[off], zOut, len);
            outQueueZ_.FreeTensor(zOut);
        }
    }

private:
    static constexpr int64_t TILE_ELEMS = 2048;  // fp32: 8KB / fp16: 4KB, 单 buffer
    AscendC::TPipe pipe_;
    AscendC::TQue<AscendC::QuePosition::VECIN,  1> inQueueX_, inQueueY_;
    AscendC::TQue<AscendC::QuePosition::VECOUT, 1> outQueueZ_;
    AscendC::GlobalTensor<T> xGm_, yGm_, zGm_;
    int64_t numElems_ = 0;
};

template <typename T>
__global__ __vector__ void sub_custom(GM_ADDR x, GM_ADDR y, GM_ADDR z,
                                      int64_t totalElems, int64_t coreElems)
{
    KernelSub<T> op;
    op.Init(x, y, z, totalElems, coreElems);
    op.Process();
}

// ---------------- host launcher ----------------
template <typename T>
static inline void LaunchSub(GM_ADDR x, GM_ADDR y, GM_ADDR z,
                             int64_t totalElems, int64_t availableCoreNum,
                             aclrtStream stream)
{
    const int64_t alignElems = 32 / static_cast<int64_t>(sizeof(T)); // 32B 对齐
    int64_t coreElems = (totalElems + availableCoreNum - 1) / availableCoreNum;
    coreElems = (coreElems + alignElems - 1) / alignElems * alignElems;

    int64_t blockNum = (totalElems + coreElems - 1) / coreElems;
    if (blockNum < 1) blockNum = 1;
    if (blockNum > availableCoreNum) blockNum = availableCoreNum;

    sub_custom<T><<<static_cast<uint32_t>(blockNum), nullptr, stream>>>(
        x, y, z, totalElems, coreElems);
}

extern "C" void run_kernel(GM_ADDR x, const TensorGroupInfo& info_x,
                           GM_ADDR y, const TensorGroupInfo& info_y,
                           GM_ADDR z, const TensorGroupInfo& info_z,
                           int64_t availableCoreNum, aclrtStream stream)
{
    const TensorInfo& tx = info_x.tensors[0];
    int64_t totalElems = 1;
    for (int64_t i = 0; i < tx.numDims; i++) {
        totalElems *= tx.shape[i];
    }
    if (totalElems <= 0) return;

    if (tx.dtype == 1) {        // fp16
        LaunchSub<half>(x, y, z, totalElems, availableCoreNum, stream);
    } else {                    // fp32（规格只支持 fp32 / fp16）
        LaunchSub<float>(x, y, z, totalElems, availableCoreNum, stream);
    }
}