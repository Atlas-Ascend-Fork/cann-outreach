
#include <cstdint>
#include "kernel_operator.h"

// ========================================
// 1. Constants
// ========================================

constexpr uint32_t TOTAL_LENGTH = 8 * 2048;
constexpr uint32_t TILE_LENGTH = 2048;
constexpr uint32_t BUFFER_NUM = 1;

// ========================================
// 2. Ascend C Sub Operator
// ========================================

template <typename T>
class KernelSub {
public:
    __aicore__ inline KernelSub() {}

    // Initialize global memory and UB buffers
    __aicore__ inline void Init(
        GM_ADDR x,
        GM_ADDR y,
        GM_ADDR z,
        uint32_t coreNum)
    {
        blockLength = TOTAL_LENGTH / coreNum;

        uint32_t offset =
            AscendC::GetBlockIdx() * blockLength;

        xGm.SetGlobalBuffer(
            (__gm__ T*)x + offset, blockLength);

        yGm.SetGlobalBuffer(
            (__gm__ T*)y + offset, blockLength);

        zGm.SetGlobalBuffer(
            (__gm__ T*)z + offset, blockLength);

        pipe.InitBuffer(
            inQueueX,
            BUFFER_NUM,
            TILE_LENGTH * sizeof(T));

        pipe.InitBuffer(
            inQueueY,
            BUFFER_NUM,
            TILE_LENGTH * sizeof(T));

        pipe.InitBuffer(
            outQueueZ,
            BUFFER_NUM,
            TILE_LENGTH * sizeof(T));
    }

    // Execute tiled subtraction
    __aicore__ inline void Process()
    {
        uint32_t loopCount =
            blockLength / TILE_LENGTH;

        for (uint32_t i = 0; i < loopCount; i++) {
            CopyIn(i);
            Compute();
            CopyOut(i);
        }
    }

private:
    // ====================================
    // 3. CopyIn: GM -> UB
    // ====================================

    __aicore__ inline void CopyIn(uint32_t i)
    {
        AscendC::LocalTensor<T> xLocal =
            inQueueX.AllocTensor<T>();

        AscendC::LocalTensor<T> yLocal =
            inQueueY.AllocTensor<T>();

        uint32_t offset = i * TILE_LENGTH;

        AscendC::DataCopy(
            xLocal,
            xGm[offset],
            TILE_LENGTH);

        AscendC::DataCopy(
            yLocal,
            yGm[offset],
            TILE_LENGTH);

        inQueueX.EnQue(xLocal);
        inQueueY.EnQue(yLocal);
    }

    // ====================================
    // 4. Compute: z = x - y
    // ====================================

    __aicore__ inline void Compute()
    {
        AscendC::LocalTensor<T> xLocal =
            inQueueX.DeQue<T>();

        AscendC::LocalTensor<T> yLocal =
            inQueueY.DeQue<T>();

        AscendC::LocalTensor<T> zLocal =
            outQueueZ.AllocTensor<T>();

        AscendC::Sub(
            zLocal,
            xLocal,
            yLocal,
            TILE_LENGTH);

        outQueueZ.EnQue(zLocal);

        inQueueX.FreeTensor(xLocal);
        inQueueY.FreeTensor(yLocal);
    }

    // ====================================
    // 5. CopyOut: UB -> GM
    // ====================================

    __aicore__ inline void CopyOut(uint32_t i)
    {
        AscendC::LocalTensor<T> zLocal =
            outQueueZ.DeQue<T>();

        AscendC::DataCopy(
            zGm[i * TILE_LENGTH],
            zLocal,
            TILE_LENGTH);

        outQueueZ.FreeTensor(zLocal);
    }

private:
    AscendC::TPipe pipe;

    AscendC::TQue<
        AscendC::TPosition::VECIN,
        BUFFER_NUM> inQueueX, inQueueY;

    AscendC::TQue<
        AscendC::TPosition::VECOUT,
        BUFFER_NUM> outQueueZ;

    AscendC::GlobalTensor<T> xGm;
    AscendC::GlobalTensor<T> yGm;
    AscendC::GlobalTensor<T> zGm;

    uint32_t blockLength;
};

// ========================================
// 6. Device Kernel: FP32
// ========================================

extern "C" __global__ __vector__
void sub_custom_fp32(
    GM_ADDR x,
    GM_ADDR y,
    GM_ADDR z,
    uint32_t coreNum)
{
    KernelSub<float> op;
    op.Init(x, y, z, coreNum);
    op.Process();
}

// ========================================
// 7. Device Kernel: FP16
// ========================================

extern "C" __global__ __vector__
void sub_custom_fp16(
    GM_ADDR x,
    GM_ADDR y,
    GM_ADDR z,
    uint32_t coreNum)
{
    KernelSub<half> op;
    op.Init(x, y, z, coreNum);
    op.Process();
}

// ========================================
// 8. Host Entry: run_kernel
// ========================================

extern "C" void run_kernel(
    GM_ADDR x,
    const TensorGroupInfo& info_x,
    GM_ADDR y,
    const TensorGroupInfo& info_y,
    GM_ADDR z,
    const TensorGroupInfo& info_z,
    int64_t availableCoreNum,
    aclrtStream stream)
{
    // Check input validity
    if (x == nullptr ||
        y == nullptr ||
        z == nullptr ||
        availableCoreNum <= 0) {
        return;
    }

    if (info_x.numTensors < 1 ||
        info_y.numTensors < 1 ||
        info_z.numTensors < 1 ||
        info_x.tensors == nullptr ||
        info_y.tensors == nullptr ||
        info_z.tensors == nullptr) {
        return;
    }

    int32_t dtype = info_x.tensors[0].dtype;

    if (dtype != info_y.tensors[0].dtype ||
        dtype != info_z.tensors[0].dtype) {
        return;
    }

    // Choose a core count that divides 16384
    uint32_t coreNum = 1;

    if (availableCoreNum >= 8) {
        coreNum = 8;
    } else if (availableCoreNum >= 4) {
        coreNum = 4;
    } else if (availableCoreNum >= 2) {
        coreNum = 2;
    }

    // dtype 0: float32
    // dtype 1: float16

    if (dtype == 0) {
        sub_custom_fp32<<<coreNum, 0, stream>>>(
            x, y, z, coreNum);
    }
    else if (dtype == 1) {
        sub_custom_fp16<<<coreNum, 0, stream>>>(
            x, y, z, coreNum);
    }
}

