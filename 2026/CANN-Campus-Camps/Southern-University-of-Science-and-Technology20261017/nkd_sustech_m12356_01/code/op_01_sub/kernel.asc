#include "kernel_operator.h"

// ---------------------------------------------------------------------------
// 本版取它的核数(8)，同时保留我们已实测更优的部分：静态Tensor编程、零tiling入参、
//   单块直算。不采用它的DataCopyPad与尾部零头处理——16384/8=2048正好整除、不存在尾块，
//   普通DataCopy没有padding逻辑更省。另加官方样例Case6的UB bank错开(256B)。
// 反解模型：单核有效带宽约19.3GB/s（与官方add_high_performance样例在A2上实测的
//   1.2457TB/s读带宽/48核量级一致），固定开销F与dtype、核数、每核循环次数均无关：
//   F(TPipe版)=2.68us，F(最优)=1.84us，差距0.84us全部在F里。
//   其中"零tiling入参"只贡献了0.12us，搬运总耗时仅约0.155us(fp32)，
//   所以L2 Cache bypass、双缓冲、增大搬运块这些都碰不到这0.84us。
// F的来源：《静态Tensor编程》明确指出基于Pipe的开发方式"带来了一些运行时开销
//   （如TPipe创建、InitBuffer等）"，改用静态Tensor编程可"避免TPipe内存管理初始化
//   过程（约数百纳秒）"。本文件主路径即按该范式重写：不用TPipe/TQue，UB地址自主
//   管理，同步用SetFlag/WaitFlag手写，参考官方样例
//   asc-devkit/examples/01_simd_cpp_api/05_best_practices/00_vector_compute/add_high_performance
// ---------------------------------------------------------------------------
constexpr uint32_t TOTAL_LENGTH = 8 * 2048;     // 16384个元素
constexpr uint32_t MIN_ALIGN_ELEMS = 16;        // UB最小访问粒度32B：16个half=32B、16个float=64B
constexpr uint32_t GM_ALIGN_BYTES = 512;        // GM搬运按128B/256B/512B拆分，内轴512B对齐最优
constexpr uint32_t UB_BUDGET_BYTES = 128 * 1024; // UB预算：2201可用约183.75KB(192KB-256B-8KB)、3510为256KB，此处留足余量
constexpr uint32_t FALLBACK_CORES = 8;          // availableCoreNum未知(<=0)时的保守核数

// ===== 实机A/B只改下面三个常量 =====
// TARGET_CORES：启动核数。默认8 —— 取自排行榜最优解的公开配置（固定blockDim=8、
//   单核按8KB分块）。8核时每核2048元素=8KB(fp32)/4KB(fp16)，与其TILE_ELEMS一致。
//   注意：此前"用满可用核"是被污染数据点误导的结论——2核那版(7.70us)每核单块32KB、
//   UB占96KB且三块buffer都落在32KB整数倍地址上，很可能同时踩了UB bank冲突，
//   不能据此认为核数越多越好。备选A/B值：4、8、16、0(=用满)。
// BANK_STAGGER：y/z相对x的UB地址错开字节数。默认256B。
//   vec指令一拍读256B，若x与y起始地址相差4KB的整数倍会落在同一bank group，
//   Sub的两个源操作数读读冲突被串行化。官方add_high_performance样例Case6正是用
//   256B错开消解冲突，实测aiv_vec_time下降45.9%。设为0可关闭以单独归因。
// L2_BYPASS：x/y只读一次属流式访问，可设CACHE_MODE_DISABLE绕过L2。
//   默认false：总数据量仅192KB远小于L2容量，评测重复跑同一批buffer时L2命中更快；
//   且搬运仅占总耗时约0.16us，官方28.9%的收益是在384MB数据量下取得的。
constexpr uint32_t TARGET_CORES = 8;
constexpr uint32_t BANK_STAGGER = 256;
constexpr bool L2_BYPASS = false;
// ==================================

// 主路径固定单块直算：每核一个数据块。实测表明每核循环次数不影响固定开销，
// 而单块可让同步事件降到最少的2对（MTE2->V、V->MTE3），也不需要ping-pong两份UB。
constexpr uint32_t STATIC_LOOPS = 1;

// ---------------------------------------------------------------------------
// 主路径：静态Tensor编程（不使用TPipe/TQue/TBufPool，UB地址自主管理）
// 只能使用基础API：DataCopy、Sub、SetFlag/WaitFlag、PipeBarrier、GetBlockIdx、InitSocState
// ---------------------------------------------------------------------------
template <typename T, uint32_t TILE_ELEMS>
class KernelSubStatic {
public:
    __aicore__ inline KernelSubStatic() {}

    __aicore__ inline void Init(GM_ADDR x, GM_ADDR y, GM_ADDR z)
    {
        // 多核切分：每核处理TILE_ELEMS个元素，本核起始偏移 = blockIdx * TILE_ELEMS
        const uint64_t blockOffset = static_cast<uint64_t>(AscendC::GetBlockIdx()) * TILE_ELEMS;
        xGm.SetGlobalBuffer((__gm__ T*)x + blockOffset, TILE_ELEMS);
        yGm.SetGlobalBuffer((__gm__ T*)y + blockOffset, TILE_ELEMS);
        zGm.SetGlobalBuffer((__gm__ T*)z + blockOffset, TILE_ELEMS);
        if (L2_BYPASS) {
            // x/y只读一次、无复用，绕过L2可避免污染Cache并省掉替换时的回写
            xGm.SetL2CacheHint(AscendC::CacheMode::CACHE_MODE_DISABLE);
            yGm.SetL2CacheHint(AscendC::CacheMode::CACHE_MODE_DISABLE);
        }
    }

    __aicore__ inline void Process()
    {
        // UB地址自主管理：三块buffer线性排布，无申请/释放开销。VECCALC 在硬件上映射为 UB。
        // y/z 相对 x 各错开 BANK_STAGGER 字节：vec指令一拍读256B，若三块buffer起始地址
        // 都是4KB的整数倍，Sub同时读x与y会落在同一bank group造成读读冲突被串行化。
        // 错开量取32B的整数倍，保证每块起始地址仍满足UB的32B对齐要求。
        constexpr uint32_t tileBytes = static_cast<uint32_t>(TILE_ELEMS * sizeof(T));
        constexpr uint32_t xAddr = 0;
        constexpr uint32_t yAddr = tileBytes + BANK_STAGGER;
        constexpr uint32_t zAddr = 2 * tileBytes + 2 * BANK_STAGGER;
        AscendC::LocalTensor<T> xLocal(AscendC::TPosition::VECCALC, xAddr, TILE_ELEMS);
        AscendC::LocalTensor<T> yLocal(AscendC::TPosition::VECCALC, yAddr, TILE_ELEMS);
        AscendC::LocalTensor<T> zLocal(AscendC::TPosition::VECCALC, zAddr, TILE_ELEMS);

        // 正向同步：搬入完成后才计算，计算完成后才搬出。
        // 事件ID不能用6和7（可能被系统预留），EVENT_ID0由框架定义。
        AscendC::DataCopy(xLocal, xGm[0], TILE_ELEMS);
        AscendC::DataCopy(yLocal, yGm[0], TILE_ELEMS);
        AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);
        AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);

        AscendC::Sub(zLocal, xLocal, yLocal, TILE_ELEMS);

        AscendC::SetFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
        AscendC::WaitFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
        AscendC::DataCopy(zGm[0], zLocal, TILE_ELEMS);
    }

private:
    AscendC::GlobalTensor<T> xGm, yGm, zGm; // xGm、yGm为输入，zGm为输出
};

// 主路径核函数：零tiling入参，切分参数全为编译期常量
// __vector__显式声明纯Vector算子，避免混合启动时Cube核空跑白付头开销
// InitSocState/PipeBarrier<PIPE_ALL>是静态Tensor编程的强制要求：前者初始化全局状态
// 寄存器（否则未定义行为），后者保证核函数结束前所有流水完成
template <typename T, uint32_t TILE_ELEMS>
__global__ __vector__ void sub_custom(GM_ADDR x, GM_ADDR y, GM_ADDR z)
{
    // 硬件与接口约束放到编译期：新增分派档位时若违反约束直接编译失败，不会跑出错误结果。
    // 注：512B对齐只是GM搬运的性能偏好（由host侧对齐搜索尽力满足），
    //     32B才是正确性硬约束（UB最小访问粒度，DataCopy不足32B会向下取整丢数据）。
    static_assert(TILE_ELEMS % MIN_ALIGN_ELEMS == 0, "单块需满足UB的32B最小粒度");
    static_assert(BANK_STAGGER % 32 == 0, "bank错开量需为32B的整数倍，否则会破坏UB的32B对齐");
    static_assert(3u * TILE_ELEMS * 4u + 3u * BANK_STAGGER <= UB_BUDGET_BYTES,
                  "UB占用超预算：x/y/z三块加上bank错开量需放在可用UB内");
    static_assert((TILE_ELEMS * 4) / 256 <= 255, "Sub的repeatTimes超上限255");
    static_assert((TILE_ELEMS * 4) / 32 <= 65535, "DataCopy的blockCount超上限65535");

    AscendC::InitSocState();
    KernelSubStatic<T, TILE_ELEMS> op;
    op.Init(x, y, z);
    op.Process();
    AscendC::PipeBarrier<PIPE_ALL>();
}

// ---------------------------------------------------------------------------
// 兜底路径：非赛题规格shape、可用核数不足、或单块超出分派表时使用
// 仍走TPipe/TQue框架，运行时下发tiling（已在 backup/kernel_tpipe_2.81us.asc 中实测2.81/2.78us）
// ---------------------------------------------------------------------------
struct SubCustomTilingData {
    uint32_t tileLength; // 单次DataCopy/Sub处理的元素数（每块长度）
    uint32_t loopCount;  // 每核循环次数 = 本核数据量 / tileLength
};

constexpr uint32_t MAX_BUFFER_NUM = 2; // loopCount>1时分配2块UB开DoubleBuffer
constexpr uint32_t QUEUE_DEPTH = 1;    // 非原地操作官方推荐depth=1

template <typename T>
class KernelSub {
public:
    __aicore__ inline KernelSub() {}

    __aicore__ inline void Init(GM_ADDR x, GM_ADDR y, GM_ADDR z, AscendC::TPipe* pipeIn,
                                const SubCustomTilingData& tiling)
    {
        // TPipe对象由核函数入口创建、此处只使用传入的指针：TPipe构造会写全局TPipe指针，
        // 若把它作为本类成员，编译器会对本类内的Scalar变量放弃常量折叠与常量传播。
        this->tileLength = tiling.tileLength;
        this->loopCount = tiling.loopCount;

        const uint32_t blockLength = this->loopCount * this->tileLength;
        const uint64_t blockOffset = static_cast<uint64_t>(AscendC::GetBlockIdx()) * blockLength;
        xGm.SetGlobalBuffer((__gm__ T*)x + blockOffset, blockLength);
        yGm.SetGlobalBuffer((__gm__ T*)y + blockOffset, blockLength);
        zGm.SetGlobalBuffer((__gm__ T*)z + blockOffset, blockLength);

        const uint32_t bufferNum = (this->loopCount > 1) ? MAX_BUFFER_NUM : 1u;
        const uint32_t tileBytes = this->tileLength * sizeof(T);
        pipeIn->InitBuffer(inQueueX, bufferNum, tileBytes);
        pipeIn->InitBuffer(inQueueY, bufferNum, tileBytes);
        pipeIn->InitBuffer(outQueueZ, bufferNum, tileBytes);
    }

    __aicore__ inline void Process()
    {
        for (uint32_t i = 0; i < this->loopCount; i++) {
            CopyIn(i);
            Compute(i);
            CopyOut(i);
        }
    }

private:
    __aicore__ inline void CopyIn(uint32_t progress)
    {
        AscendC::LocalTensor<T> xLocal = inQueueX.AllocTensor<T>();
        AscendC::LocalTensor<T> yLocal = inQueueY.AllocTensor<T>();
        AscendC::DataCopy(xLocal, xGm[progress * this->tileLength], this->tileLength);
        AscendC::DataCopy(yLocal, yGm[progress * this->tileLength], this->tileLength);
        inQueueX.EnQue(xLocal);
        inQueueY.EnQue(yLocal);
    }

    __aicore__ inline void Compute(uint32_t progress)
    {
        AscendC::LocalTensor<T> xLocal = inQueueX.DeQue<T>();
        AscendC::LocalTensor<T> yLocal = inQueueY.DeQue<T>();
        AscendC::LocalTensor<T> zLocal = outQueueZ.AllocTensor<T>();
        AscendC::Sub(zLocal, xLocal, yLocal, this->tileLength);
        outQueueZ.EnQue<T>(zLocal);
        inQueueX.FreeTensor(xLocal);
        inQueueY.FreeTensor(yLocal);
    }

    __aicore__ inline void CopyOut(uint32_t progress)
    {
        AscendC::LocalTensor<T> zLocal = outQueueZ.DeQue<T>();
        AscendC::DataCopy(zGm[progress * this->tileLength], zLocal, this->tileLength);
        outQueueZ.FreeTensor(zLocal);
    }

private:
    AscendC::TQue<AscendC::QuePosition::VECIN, QUEUE_DEPTH> inQueueX, inQueueY;
    AscendC::TQue<AscendC::QuePosition::VECOUT, QUEUE_DEPTH> outQueueZ;
    AscendC::GlobalTensor<T> xGm, yGm, zGm;

    uint32_t tileLength;
    uint32_t loopCount;
};

template <typename T>
__global__ __vector__ void sub_custom_tiled(GM_ADDR x, GM_ADDR y, GM_ADDR z, SubCustomTilingData tiling)
{
    AscendC::TPipe pipe; // 声明在op之前，保证析构顺序为op先于pipe
    KernelSub<T> op;
    op.Init(x, y, z, &pipe, tiling);
    op.Process();
}

// 主路径分派表：TILE_ELEMS即每核数据量，blockDim = TOTAL_LENGTH / TILE_ELEMS
// 覆盖blockDim从128到2；blockDim=1（TILE=16384，fp32需192KB UB）超预算，自动落兜底路径
#define SUB_STATIC_CASES(T_) \
    case 128:   sub_custom<T_, 128><<<blockDim, nullptr, stream>>>(x, y, z);   launched = true; break; \
    case 256:   sub_custom<T_, 256><<<blockDim, nullptr, stream>>>(x, y, z);   launched = true; break; \
    case 512:   sub_custom<T_, 512><<<blockDim, nullptr, stream>>>(x, y, z);   launched = true; break; \
    case 1024:  sub_custom<T_, 1024><<<blockDim, nullptr, stream>>>(x, y, z);  launched = true; break; \
    case 2048:  sub_custom<T_, 2048><<<blockDim, nullptr, stream>>>(x, y, z);  launched = true; break; \
    case 4096:  sub_custom<T_, 4096><<<blockDim, nullptr, stream>>>(x, y, z);  launched = true; break; \
    case 8192:  sub_custom<T_, 8192><<<blockDim, nullptr, stream>>>(x, y, z);  launched = true; break;

// ---------------------------------------------------------------------------
// host侧启动函数
// ---------------------------------------------------------------------------
extern "C" void run_kernel(GM_ADDR x, const TensorGroupInfo& info_x, GM_ADDR y, const TensorGroupInfo& info_y, GM_ADDR z, const TensorGroupInfo& info_z, int64_t availableCoreNum, aclrtStream stream)
{
    // 1. 取总元素数（x/y/z形状一致）
    const TensorInfo& t0 = info_x.tensors[0];
    int64_t totalLength = 1;
    for (int64_t i = 0; i < t0.numDims; i++) {
        totalLength *= t0.shape[i];
    }
    // 2. 按输入dtype选择核函数实例（dtype定义见TensorInfo：0=fp32 1=fp16 2=bf16 ...）
    const bool isHalf = (t0.dtype == 1);
    const uint32_t elemSize = isHalf ? 2u : 4u;

    // 3. 期望核数：默认用满可用核数。实测每核搬运耗时随核数增加而下降，
    //    且固定开销与核数基本无关，所以核数取满（在满足整除与对齐的前提下取最大）。
    uint32_t wantCores = TARGET_CORES;
    if (wantCores == 0) {
        wantCores = (availableCoreNum > 0) ? static_cast<uint32_t>(availableCoreNum) : FALLBACK_CORES;
    } else if (availableCoreNum > 0 && wantCores > static_cast<uint32_t>(availableCoreNum)) {
        wantCores = static_cast<uint32_t>(availableCoreNum);
    }
    if (wantCores < 1) {
        wantCores = 1;
    }

    // 4. 从wantCores向下找满足切分约束的核数：
    //    a) totalLength能被核数整除 —— 核间负载均衡，无拖尾核；
    //    b) 每核数据量满足对齐要求 —— 优先512B（GM搬运最优），逐档放宽到32B（UB最小粒度）。
    uint32_t blockDim = 0;
    for (uint32_t align = GM_ALIGN_BYTES / elemSize; align >= MIN_ALIGN_ELEMS && blockDim == 0; align /= 2) {
        for (uint32_t n = wantCores; n >= 1; n--) {
            if (totalLength % n != 0) {
                continue;
            }
            if ((static_cast<uint32_t>(totalLength) / n) % align != 0) {
                continue;
            }
            blockDim = n;
            break;
        }
    }
    if (blockDim == 0) {
        blockDim = 1;
    }
    const uint32_t blockLength = static_cast<uint32_t>(totalLength) / blockDim;

    // 5. 主路径：赛题规格shape且单块在分派表内时，走静态Tensor编程的零tiling核函数
    if (totalLength == static_cast<int64_t>(TOTAL_LENGTH) && blockLength % STATIC_LOOPS == 0 &&
        3u * blockLength * elemSize + 3u * BANK_STAGGER <= UB_BUDGET_BYTES) {
        const uint32_t tileLength = blockLength / STATIC_LOOPS;
        bool launched = false;
        if (isHalf) {
            switch (tileLength) { SUB_STATIC_CASES(half) }
        } else {
            switch (tileLength) { SUB_STATIC_CASES(float) }
        }
        if (launched) {
            return;
        }
    }

    // 6. 兜底路径：运行时下发tiling，走TPipe/TQue框架
    uint32_t loopCount = STATIC_LOOPS;
    while (loopCount > 1 && blockLength % loopCount != 0) {
        loopCount--;
    }
    uint32_t tileLength = blockLength / loopCount;
    uint32_t bufferNum = (loopCount > 1) ? MAX_BUFFER_NUM : 1u;
    while (3u * bufferNum * tileLength * elemSize > UB_BUDGET_BYTES && tileLength % 2 == 0) {
        tileLength /= 2;
        loopCount *= 2;
        bufferNum = (loopCount > 1) ? MAX_BUFFER_NUM : 1u;
    }
    // 单块必须满足UB的32B最小粒度：否则DataCopy会把搬运量向下取整到32B，尾部数据被丢弃。
    // loopCount为偶数时对半折仍能整除blockLength，因此覆盖完整性不受影响。
    while (loopCount > 1 && (tileLength * elemSize) % 32u != 0) {
        loopCount /= 2;
        tileLength = blockLength / loopCount;
        bufferNum = (loopCount > 1) ? MAX_BUFFER_NUM : 1u;
    }

    SubCustomTilingData tiling = {tileLength, loopCount};
    if (isHalf) {
        sub_custom_tiled<half><<<blockDim, nullptr, stream>>>(x, y, z, tiling);
    } else {
        sub_custom_tiled<float><<<blockDim, nullptr, stream>>>(x, y, z, tiling);
    }
}

#undef SUB_STATIC_CASES
