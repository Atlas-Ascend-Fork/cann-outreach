#include <cmath>
#include "kernel_operator.h"

/*
 * Sub Kernel - Ascend C Direct Invocation
 * This file is #included - do NOT add main(), #pragma once, or include guards.
 *
 * dtype: 0=fp32 1=fp16 2=bf16 ...   Usage: info_x.tensors[0].shape[0]
 * Available APIs: AscendC::TPipe, AscendC::TQue, AscendC::DataCopyPad, AscendC::Sub
 */

struct SubTiling {
    uint32_t totalLength; // 总元素数，例如 8 * 2048
};

// ---------------------------------------------------------------------------
// z = x - y：一个循环搞定「多核切分 + 单核分块 + 尾部零头」
// ---------------------------------------------------------------------------
template <typename T>
__global__ __vector__ void sub_custom(GM_ADDR x, GM_ADDR y, GM_ADDR z, SubTiling t)
{
    constexpr uint32_t ALIGN_ELEMS = 32 / sizeof(T);   // 32B 对应的元素个数（float=8, half=16）
    constexpr uint32_t TILE_ELEMS = 8192 / sizeof(T);  // 每块元素个数（8KB）

    AscendC::TPipe pipe;
    AscendC::TQue<AscendC::QuePosition::VECIN, 1> qx, qy;
    AscendC::TQue<AscendC::QuePosition::VECOUT, 1> qz;
    pipe.InitBuffer(qx, 1, TILE_ELEMS * sizeof(T));
    pipe.InitBuffer(qy, 1, TILE_ELEMS * sizeof(T));
    pipe.InitBuffer(qz, 1, TILE_ELEMS * sizeof(T));

    AscendC::GlobalTensor<T> xG, yG, zG;
    xG.SetGlobalBuffer((__gm__ T *)x, t.totalLength);
    yG.SetGlobalBuffer((__gm__ T *)y, t.totalLength);
    zG.SetGlobalBuffer((__gm__ T *)z, t.totalLength);

    // 本核负责 [begin, end)：长度按核数向上取整，再向上对齐到 32B（保证 begin 对齐）
    uint32_t cores = AscendC::GetBlockNum();
    uint32_t per = (t.totalLength + cores - 1) / cores;
    per = (per + ALIGN_ELEMS - 1) / ALIGN_ELEMS * ALIGN_ELEMS;
    if (per == 0) {
        per = ALIGN_ELEMS;
    }
    uint32_t begin = AscendC::GetBlockIdx() * per;
    if (begin > t.totalLength) {
        begin = t.totalLength;
    }
    uint32_t end = begin + per;
    if (end > t.totalLength) {
        end = t.totalLength;
    }

    AscendC::DataCopyExtParams cp;
    cp.blockCount = 1;
    cp.srcStride = 0;
    cp.dstStride = 0;
    AscendC::DataCopyPadExtParams<T> pp;
    pp.isPad = false;
    pp.leftPadding = 0;
    pp.rightPadding = 0;
    pp.paddingValue = static_cast<T>(0);

    for (uint32_t off = begin; off < end; off += TILE_ELEMS) {
        uint32_t n = end - off;
        if (n > TILE_ELEMS) {
            n = TILE_ELEMS;
        }
        cp.blockLen = n * sizeof(T);                     // Byte，尾部不必 32B 对齐

        AscendC::LocalTensor<T> xl = qx.AllocTensor<T>();
        AscendC::LocalTensor<T> yl = qy.AllocTensor<T>();
        AscendC::DataCopyPad(xl, xG[off], cp, pp);        // GM -> UB
        AscendC::DataCopyPad(yl, yG[off], cp, pp);
        qx.EnQue(xl);
        qy.EnQue(yl);

        AscendC::LocalTensor<T> zl = qz.AllocTensor<T>();
        AscendC::Sub(zl, qx.DeQue<T>(), qy.DeQue<T>(), n); // z = x - y
        qz.EnQue<T>(zl);
        qx.FreeTensor(xl);
        qy.FreeTensor(yl);

        AscendC::LocalTensor<T> zo = qz.DeQue<T>();
        AscendC::DataCopyPad(zG[off], zo, cp);            // UB -> GM
        qz.FreeTensor(zo);
    }
}

// ---------------------------------------------------------------------------
// host 侧启动
// ---------------------------------------------------------------------------
extern "C" void run_kernel(GM_ADDR x, const TensorGroupInfo& info_x, GM_ADDR y, const TensorGroupInfo& info_y, GM_ADDR z, const TensorGroupInfo& info_z, int64_t availableCoreNum, aclrtStream stream)
{
    const TensorInfo& t0 = info_x.tensors[0];
    int64_t totalLength = 1;
    for (int64_t i = 0; i < t0.numDims; i++) {
        totalLength *= t0.shape[i];      // 总元素数（x/y/z 形状一致）
    }

    constexpr uint32_t blockDim = 8;
    SubTiling t = {static_cast<uint32_t>(totalLength)};

    if (t0.dtype == 1) {
        sub_custom<half><<<blockDim, nullptr, stream>>>(x, y, z, t);   // fp16
    } else {
        sub_custom<float><<<blockDim, nullptr, stream>>>(x, y, z, t);  // fp32
    }
}