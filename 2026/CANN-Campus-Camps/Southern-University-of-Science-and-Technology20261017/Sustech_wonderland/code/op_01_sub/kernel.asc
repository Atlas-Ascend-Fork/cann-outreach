
#include <cmath>
#include "kernel_operator.h"

struct SubCustomTilingData {
    uint32_t totalLength;
};

// 修改为 16、32 可以测试不同核数的性能
constexpr uint32_t PREFERRED_CORE_NUM = 8;

template <typename T>
class KernelSub {
public:
    __aicore__ inline KernelSub() {}

    __aicore__ inline void Init(
        GM_ADDR x,
        GM_ADDR y,
        GM_ADDR z,
        const SubCustomTilingData& tiling)
    {
        blockLength =
            tiling.totalLength / AscendC::GetBlockNum();

        uint32_t offset =
            blockLength * AscendC::GetBlockIdx();

        xGm.SetGlobalBuffer(
            (__gm__ T*)x + offset, blockLength);

        yGm.SetGlobalBuffer(
            (__gm__ T*)y + offset, blockLength);

        zGm.SetGlobalBuffer(
            (__gm__ T*)z + offset, blockLength);

        // 每核只分配一块缓冲区
        pipe.InitBuffer(
            inQueueX, 1, blockLength * sizeof(T));

        pipe.InitBuffer(
            inQueueY, 1, blockLength * sizeof(T));

        pipe.InitBuffer(
            outQueueZ, 1, blockLength * sizeof(T));
    }

    __aicore__ inline void Process()
    {
        // 1. GM -> UB
        AscendC::LocalTensor<T> xLocal =
            inQueueX.AllocTensor<T>();

        AscendC::LocalTensor<T> yLocal =
            inQueueY.AllocTensor<T>();

        AscendC::DataCopy(
            xLocal, xGm, blockLength);

        AscendC::DataCopy(
            yLocal, yGm, blockLength);

        inQueueX.EnQue(xLocal);
        inQueueY.EnQue(yLocal);

        // 2. UB 中执行减法
        xLocal = inQueueX.DeQue<T>();
        yLocal = inQueueY.DeQue<T>();

        AscendC::LocalTensor<T> zLocal =
            outQueueZ.AllocTensor<T>();

        AscendC::Sub(
            zLocal, xLocal, yLocal, blockLength);

        outQueueZ.EnQue(zLocal);

        inQueueX.FreeTensor(xLocal);
        inQueueY.FreeTensor(yLocal);

        // 3. UB -> GM
        zLocal = outQueueZ.DeQue<T>();

        AscendC::DataCopy(
            zGm, zLocal, blockLength);

        outQueueZ.FreeTensor(zLocal);
    }

private:
    AscendC::TPipe pipe;

    AscendC::TQue<
        AscendC::QuePosition::VECIN, 1> inQueueX;

    AscendC::TQue<
        AscendC::QuePosition::VECIN, 1> inQueueY;

    AscendC::TQue<
        AscendC::QuePosition::VECOUT, 1> outQueueZ;

    AscendC::GlobalTensor<T> xGm;
    AscendC::GlobalTensor<T> yGm;
    AscendC::GlobalTensor<T> zGm;

    uint32_t blockLength;
};

template <typename T>
__global__ __vector__ void sub_custom(
    GM_ADDR x,
    GM_ADDR y,
    GM_ADDR z,
    SubCustomTilingData tiling)
{
    KernelSub<T> op;
    op.Init(x, y, z, tiling);
    op.Process();
}

extern "C" void run_kernel(
    GM_ADDR x,
    const TensorGroupInfo& info_x,
    GM_ADDR y,
    const TensorGroupInfo& info_y,
    GM_ADDR z,
    const TensorGroupInfo& info_z,
    int64_t availableCoreNum,
    aclrtStream stream)
{
    const TensorInfo& t0 = info_x.tensors[0];

    int64_t totalLength = 1;

    for (int64_t i = 0; i < t0.numDims; i++) {
        totalLength *= t0.shape[i];
    }

    // 选择不超过可用核数的 2 的幂
    uint32_t blockDim = 1;

    for (uint32_t n = 2;
         n <= PREFERRED_CORE_NUM;
         n *= 2)
    {
        if (availableCoreNum >= n &&
            totalLength % n == 0)
        {
            blockDim = n;
        }
    }

    SubCustomTilingData tiling = {
        (uint32_t)totalLength
    };

    if (t0.dtype == 1) {
        sub_custom<half>
            <<<blockDim, nullptr, stream>>>(
                x, y, z, tiling);
    } else {
        sub_custom<float>
            <<<blockDim, nullptr, stream>>>(
                x, y, z, tiling);
    }
}
