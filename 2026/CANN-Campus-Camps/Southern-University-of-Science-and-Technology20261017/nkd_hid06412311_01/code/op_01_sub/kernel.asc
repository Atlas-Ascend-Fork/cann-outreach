#include <cmath>
#include "kernel_operator.h"

using namespace AscendC;

struct SubCustomTilingData {
    uint32_t coreLength;     // 每个核的固定长度（32字节对齐）
    uint32_t lastCoreLength; // 最后一个核的剩余长度
    uint32_t core_num;       // 实际使用的核数
};

template <typename T>
class KernelSub {
public:
    __aicore__ inline KernelSub() {}
    
    __aicore__ inline void Init(GM_ADDR x, GM_ADDR y, GM_ADDR z, SubCustomTilingData tiling)
    {
        uint32_t blockIdx = GetBlockIdx();
        // 使用对齐后的固定块长计算偏移，绝对不会发生覆盖或错位
        uint32_t startOffset = blockIdx * tiling.coreLength;
        // 如果是最后一个核，使用剩余长度
        this->blockLength = (blockIdx == tiling.core_num - 1) ? tiling.lastCoreLength : tiling.coreLength;
        
        xGm.SetGlobalBuffer((__gm__ T*)x + startOffset, this->blockLength);
        yGm.SetGlobalBuffer((__gm__ T*)y + startOffset, this->blockLength);
        zGm.SetGlobalBuffer((__gm__ T*)z + startOffset, this->blockLength);

        // 直接分配单 Buffer，避免除法导致的对齐问题，也降低 OOM 风险
        pipe.InitBuffer(inQueueX, 1, this->blockLength * sizeof(T));
        pipe.InitBuffer(inQueueY, 1, this->blockLength * sizeof(T));
        pipe.InitBuffer(outQueueZ, 1, this->blockLength * sizeof(T));
    }

    __aicore__ inline void Process()
    {
        CopyIn();
        Compute();
        CopyOut();
    }

private:
    __aicore__ inline void CopyIn()
    {
        LocalTensor<T> xLocal = inQueueX.AllocTensor<T>();
        LocalTensor<T> yLocal = inQueueY.AllocTensor<T>();
        
        // 此时 blockLength 保证是 8 或 16 的倍数，DataCopy 安全
        DataCopy(xLocal, xGm, this->blockLength);
        DataCopy(yLocal, yGm, this->blockLength);
        
        inQueueX.EnQue(xLocal);
        inQueueY.EnQue(yLocal);
    }

    __aicore__ inline void Compute()
    {
        LocalTensor<T> xLocal = inQueueX.DeQue<T>();
        LocalTensor<T> yLocal = inQueueY.DeQue<T>();
        LocalTensor<T> zLocal = outQueueZ.AllocTensor<T>();
        
        // 核心矢量减法
        Sub(zLocal, xLocal, yLocal, this->blockLength);
        
        outQueueZ.EnQue<T>(zLocal);
        inQueueX.FreeTensor(xLocal);
        inQueueY.FreeTensor(yLocal);
    }

    __aicore__ inline void CopyOut()
    {
        LocalTensor<T> zLocal = outQueueZ.DeQue<T>();
        DataCopy(zGm, zLocal, this->blockLength);
        outQueueZ.FreeTensor(zLocal);
    }

    TPipe pipe;
    TQue<QuePosition::VECIN, 1> inQueueX, inQueueY;
    TQue<QuePosition::VECOUT, 1> outQueueZ;
    GlobalTensor<T> xGm, yGm, zGm;
    uint32_t blockLength;
};

template <typename T>
__global__ __vector__ void sub_custom(GM_ADDR x, GM_ADDR y, GM_ADDR z, SubCustomTilingData tiling)
{
    KernelSub<T> op;
    op.Init(x, y, z, tiling);
    op.Process();
}

extern "C" void run_kernel(GM_ADDR x, const TensorGroupInfo& info_x,
                           GM_ADDR y, const TensorGroupInfo& info_y,
                           GM_ADDR z, const TensorGroupInfo& info_z,
                           int64_t availableCoreNum, aclrtStream stream)
{
    const TensorInfo& t0 = info_x.tensors[0];
    uint32_t length = 1;
    for (int64_t i = 0; i < t0.numDims; i++) {
        length *= static_cast<uint32_t>(t0.shape[i]);
    }

    int32_t dtype = t0.dtype;
    // NPU 要求 32 字节对齐：float32(4字节) 对齐数为 8，float16(2字节) 对齐数为 16
    uint32_t alignNum = (dtype == 0) ? 8 : 16;
    
    uint32_t available = static_cast<uint32_t>(availableCoreNum);
    if (available == 0) available = 1;
    
    // 1. 计算每个核的理论长度，并向上取整
    uint32_t coreLength = length / available;
    if (length % available != 0) {
        coreLength += 1;
    }
    
    // 2. 强制向上 32 字节对齐，保证拷贝绝对安全
    coreLength = ((coreLength + alignNum - 1) / alignNum) * alignNum;
    
    // 3. 根据对齐后的长度，反推实际需要多少核
    uint32_t core_num = (length + coreLength - 1) / coreLength;
    if (core_num == 0) core_num = 1;
    
    SubCustomTilingData tiling;
    tiling.coreLength = coreLength;
    tiling.lastCoreLength = length - (core_num - 1) * coreLength;
    tiling.core_num = core_num;

    if (dtype == 0) { // float32
        sub_custom<float><<<tiling.core_num, nullptr, stream>>>(x, y, z, tiling);
    } else if (dtype == 1) { // float16
        sub_custom<half><<<tiling.core_num, nullptr, stream>>>(x, y, z, tiling);
    }
}