#include <cmath>
#include "kernel_operator.h"
/*
 * Sub Kernel — Ascend C Direct Invocation
 * z = x - y，shape (8, 2048)，支持 float32 / float16
 *
 * 本文件是被 main.asc #include 的，不要加 main()、#pragma once 或 include guard。
 *
 * TensorGroupInfo / TensorInfo（平台预定义）：
 *   struct TensorInfo { const int64_t* shape; int64_t numDims; int32_t dtype; };
 *   struct TensorGroupInfo { const TensorInfo* tensors; int64_t numTensors; };
 *   dtype: 0=fp32 1=fp16 2=bf16 3=int8 4=int16 5=int32 6=int64 7=uint8 8=uint16 9=uint32 10=uint64 11=bool
 */

// ---------------------------------------------------------------------------
// 1. Tiling 参数结构体：host 侧 run_kernel 算好后按值传给核函数
// ---------------------------------------------------------------------------
struct SubCustomTilingData {
    uint32_t totalLength;  // 待处理元素总数，例如 8 * 2048 = 16384
    uint32_t tileNum;      // 单核内把数据再切成多少块（Tile），例如 8
};

constexpr uint32_t BUFFER_NUM = 2;   // 每个队列的 buffer 块数（double buffer，tileLength 会按它折半）
constexpr uint32_t QUEUE_DEPTH = 1;

// ---------------------------------------------------------------------------
// 2. KernelSub：核函数主体类，多核切分 + 核内分块搬入/计算/搬出
// ---------------------------------------------------------------------------
template <typename T>
class KernelSub {
public:
    __aicore__ inline KernelSub() {}

    __aicore__ inline void Init(GM_ADDR x, GM_ADDR y, GM_ADDR z, const SubCustomTilingData& tiling)
    {
        // 多核切分：每个核负责 totalLength / blockNum 个元素
        this->blockLength = tiling.totalLength / AscendC::GetBlockNum();
        this->tileNum = tiling.tileNum;
        // 核内每块元素数：blockLength 先按 tileNum 切，再按 BUFFER_NUM 折半（双 buffer）
        this->tileLength = this->blockLength / this->tileNum / BUFFER_NUM;

        // 每个核的 GM 起始地址 = 基址 + blockLength * blockIdx（关键的多核切分逻辑）
        uint64_t offset = static_cast<uint64_t>(this->blockLength) * AscendC::GetBlockIdx();
        xGm.SetGlobalBuffer((__gm__ T *)x + offset, this->blockLength);
        yGm.SetGlobalBuffer((__gm__ T *)y + offset, this->blockLength);
        zGm.SetGlobalBuffer((__gm__ T *)z + offset, this->blockLength);

        // 为队列分配 UB 内存，每块 tileLength 个元素
        pipe.InitBuffer(inQueueX, BUFFER_NUM, this->tileLength * sizeof(T));
        pipe.InitBuffer(inQueueY, BUFFER_NUM, this->tileLength * sizeof(T));
        pipe.InitBuffer(outQueueZ, BUFFER_NUM, this->tileLength * sizeof(T));
    }

    __aicore__ inline void Process()
    {
        // 循环次数 = tileNum × BUFFER_NUM（tileLength 已按 BUFFER_NUM 折半）
        int32_t loopCount = this->tileNum * BUFFER_NUM;
        for (int32_t i = 0; i < loopCount; i++) {
            CopyIn(i);    // 搬入第 i 块 x / y
            Compute(i);   // 计算第 i 块 z = x - y
            CopyOut(i);   // 搬出第 i 块 z
        }
    }

private:
    __aicore__ inline void CopyIn(int32_t progress)
    {
        // 从队列申请 LocalTensor（UB 上的内存）
        AscendC::LocalTensor<T> xLocal = inQueueX.AllocTensor<T>();
        AscendC::LocalTensor<T> yLocal = inQueueY.AllocTensor<T>();
        // GM -> UB，按块偏移搬入
        AscendC::DataCopy(xLocal, xGm[progress * this->tileLength], this->tileLength);
        AscendC::DataCopy(yLocal, yGm[progress * this->tileLength], this->tileLength);
        // 入队，通知 Compute
        inQueueX.EnQue(xLocal);
        inQueueY.EnQue(yLocal);
    }

    __aicore__ inline void Compute(int32_t progress)
    {
        // 从输入队列取数据
        AscendC::LocalTensor<T> xLocal = inQueueX.DeQue<T>();
        AscendC::LocalTensor<T> yLocal = inQueueY.DeQue<T>();
        // 申请输出内存
        AscendC::LocalTensor<T> zLocal = outQueueZ.AllocTensor<T>();
        // 矢量减法：z = x - y
        AscendC::Sub(zLocal, xLocal, yLocal, this->tileLength);
        // 入队，通知 CopyOut
        outQueueZ.EnQue<T>(zLocal);
        // 释放输入内存，避免 UB 泄漏
        inQueueX.FreeTensor(xLocal);
        inQueueY.FreeTensor(yLocal);
    }

    __aicore__ inline void CopyOut(int32_t progress)
    {
        // 从输出队列取结果
        AscendC::LocalTensor<T> zLocal = outQueueZ.DeQue<T>();
        // UB -> GM，按块偏移搬出
        AscendC::DataCopy(zGm[progress * this->tileLength], zLocal, this->tileLength);
        outQueueZ.FreeTensor(zLocal);
    }

private:
    AscendC::TPipe pipe;  // TPipe 内存管理对象
    AscendC::TQue<AscendC::QuePosition::VECIN, QUEUE_DEPTH> inQueueX, inQueueY;   // VECIN 输入队列
    AscendC::TQue<AscendC::QuePosition::VECOUT, QUEUE_DEPTH> outQueueZ;           // VECOUT 输出队列
    AscendC::GlobalTensor<T> xGm, yGm, zGm;  // GM 上的输入输出张量视图

    uint32_t blockLength;  // 每核处理的元素数
    uint32_t tileNum;      // 单核内分块数
    uint32_t tileLength;   // 单核内每块元素数
};

// ---------------------------------------------------------------------------
// 3. 核函数入口：实例化 KernelSub<T> 并执行
// ---------------------------------------------------------------------------
template <typename T>
__global__ __vector__ void sub_custom(GM_ADDR x, GM_ADDR y, GM_ADDR z, SubCustomTilingData tiling)
{
    KernelSub<T> op;
    op.Init(x, y, z, tiling);
    op.Process();
}

// ---------------------------------------------------------------------------
// 4. host 侧启动函数：算 tiling 并按 dtype 选择核函数实例
// ---------------------------------------------------------------------------
extern "C" void run_kernel(GM_ADDR x, const TensorGroupInfo& info_x, GM_ADDR y, const TensorGroupInfo& info_y, GM_ADDR z, const TensorGroupInfo& info_z, int64_t availableCoreNum, aclrtStream stream)
{
    // (1) 取总元素数（x / y / z 形状一致，(8,2048) -> 16384）
    const TensorInfo& t0 = info_x.tensors[0];
    int64_t totalLength = 1;
    for (int64_t i = 0; i < t0.numDims; i++) {
        totalLength *= t0.shape[i];
    }
    if (totalLength <= 0) {
        return;
    }

    // (2) blockDim：默认 8，且不能超过可用核数；不足时折半保证 totalLength 整除
    uint32_t blockDim = 8;
    if (availableCoreNum > 0 && static_cast<int64_t>(blockDim) > availableCoreNum) {
        blockDim = static_cast<uint32_t>(availableCoreNum);
    }
    while (blockDim > 1 && (totalLength % static_cast<int64_t>(blockDim)) != 0) {
        blockDim >>= 1;
    }

    // (3) tileNum：默认 8，保证 blockLength 能被 tileNum * BUFFER_NUM 整除（16384/8=2048，2048/16=128）
    uint64_t blockLength = static_cast<uint64_t>(totalLength) / blockDim;
    uint32_t tileNum = 8;
    while (tileNum > 1 && (blockLength % (static_cast<uint64_t>(tileNum) * BUFFER_NUM)) != 0) {
        tileNum >>= 1;
    }

    SubCustomTilingData tiling = {static_cast<uint32_t>(totalLength), tileNum};

    // (4) 按输入 dtype 选择模板实例：0=fp32，1=fp16
    int32_t dtype = t0.dtype;
    if (dtype == 1) {
        sub_custom<half><<<blockDim, nullptr, stream>>>(x, y, z, tiling);   // fp16
    } else {
        sub_custom<float><<<blockDim, nullptr, stream>>>(x, y, z, tiling);  // fp32（默认）
    }
}

