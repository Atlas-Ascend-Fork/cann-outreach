
#include <cmath>
#include "kernel_operator.h"

// Ascend C direct-invocation kernel.
// TensorInfo / TensorGroupInfo are defined by the framework.
// dtype: 0=float32, 1=float16

constexpr uint32_t SUB_ROWS = 8;
constexpr uint32_t SUB_COLS = 2048;
constexpr uint32_t SUB_SIZE = SUB_ROWS * SUB_COLS;

// ================================
// Device: Vector Subtraction
// ================================
template <typename T>
class KernelSub {
public:
    __aicore__ inline void Init(
        GM_ADDR x, GM_ADDR y, GM_ADDR z)
    {
        xGm_.SetGlobalBuffer(
            reinterpret_cast<__gm__ T *>(x),
            SUB_SIZE);

        yGm_.SetGlobalBuffer(
            reinterpret_cast<__gm__ T *>(y),
            SUB_SIZE);

        zGm_.SetGlobalBuffer(
            reinterpret_cast<__gm__ T *>(z),
            SUB_SIZE);

        // Allocate local buffers for 2048 elements
        pipe_.InitBuffer(
            xQueue_, 1, SUB_COLS * sizeof(T));

        pipe_.InitBuffer(
            yQueue_, 1, SUB_COLS * sizeof(T));

        pipe_.InitBuffer(
            zQueue_, 1, SUB_COLS * sizeof(T));
    }

    __aicore__ inline void Process()
    {
        const uint32_t coreId =
            static_cast<uint32_t>(
                AscendC::GetBlockIdx());

        const uint32_t coreCount =
            static_cast<uint32_t>(
                AscendC::GetBlockNum());

        // Distribute 8 rows across available cores
        for (uint32_t row = coreId;
             row < SUB_ROWS;
             row += coreCount) {

            const uint32_t offset =
                row * SUB_COLS;

            CopyIn(offset);
            Compute();
            CopyOut(offset);
        }
    }

private:
    // GM -> Local
    __aicore__ inline void CopyIn(
        uint32_t offset)
    {
        AscendC::LocalTensor<T> xLocal =
            xQueue_.AllocTensor<T>();

        AscendC::LocalTensor<T> yLocal =
            yQueue_.AllocTensor<T>();

        AscendC::DataCopy(
            xLocal, xGm_[offset], SUB_COLS);

        AscendC::DataCopy(
            yLocal, yGm_[offset], SUB_COLS);

        xQueue_.EnQue(xLocal);
        yQueue_.EnQue(yLocal);
    }

    // z = x - y
    __aicore__ inline void Compute()
    {
        AscendC::LocalTensor<T> xLocal =
            xQueue_.DeQue<T>();

        AscendC::LocalTensor<T> yLocal =
            yQueue_.DeQue<T>();

        AscendC::LocalTensor<T> zLocal =
            zQueue_.AllocTensor<T>();

        AscendC::Sub(
            zLocal, xLocal, yLocal, SUB_COLS);

        zQueue_.EnQue(zLocal);

        xQueue_.FreeTensor(xLocal);
        yQueue_.FreeTensor(yLocal);
    }

    // Local -> GM
    __aicore__ inline void CopyOut(
        uint32_t offset)
    {
        AscendC::LocalTensor<T> zLocal =
            zQueue_.DeQue<T>();

        AscendC::DataCopy(
            zGm_[offset], zLocal, SUB_COLS);

        zQueue_.FreeTensor(zLocal);
    }

    AscendC::TPipe pipe_;

    AscendC::TQue<
        AscendC::TPosition::VECIN, 1
    > xQueue_;

    AscendC::TQue<
        AscendC::TPosition::VECIN, 1
    > yQueue_;

    AscendC::TQue<
        AscendC::TPosition::VECOUT, 1
    > zQueue_;

    AscendC::GlobalTensor<T> xGm_;
    AscendC::GlobalTensor<T> yGm_;
    AscendC::GlobalTensor<T> zGm_;
};

// ================================
// Device Kernel Entry
// ================================
template <typename T>
__global__ __vector__ void sub_custom(
    GM_ADDR x, GM_ADDR y, GM_ADDR z)
{
    KernelSub<T> op;
    op.Init(x, y, z);
    op.Process();
}

// ================================
// Host: Required Entry
// ================================
extern "C" void run_kernel(
    GM_ADDR x,
    const TensorGroupInfo& info_x,
    GM_ADDR y,
    const TensorGroupInfo& info_y,
    GM_ADDR z,
    const TensorGroupInfo& info_z,
    int64_t availableCoreNum,
    aclrtStream stream)
{
    if (info_x.numTensors < 1 ||
        info_y.numTensors < 1 ||
        info_z.numTensors < 1 ||
        info_x.tensors == nullptr ||
        info_y.tensors == nullptr ||
        info_z.tensors == nullptr) {
        return;
    }

    const TensorInfo& xInfo = info_x.tensors[0];
    const TensorInfo& yInfo = info_y.tensors[0];
    const TensorInfo& zInfo = info_z.tensors[0];

    // Verify shapes and dtypes
    if (xInfo.numDims != 2 ||
        yInfo.numDims != 2 ||
        zInfo.numDims != 2 ||
        xInfo.shape[0] != SUB_ROWS ||
        xInfo.shape[1] != SUB_COLS ||
        yInfo.shape[0] != SUB_ROWS ||
        yInfo.shape[1] != SUB_COLS ||
        zInfo.shape[0] != SUB_ROWS ||
        zInfo.shape[1] != SUB_COLS ||
        xInfo.dtype != yInfo.dtype ||
        xInfo.dtype != zInfo.dtype) {
        return;
    }

    uint32_t blockNum = SUB_ROWS;

    if (availableCoreNum <
        static_cast<int64_t>(SUB_ROWS)) {
        blockNum = availableCoreNum > 0
            ? static_cast<uint32_t>(availableCoreNum)
            : 1;
    }

    // Launch based on the input data type
    if (xInfo.dtype == 0) {
        // FP32
        sub_custom<float>
            <<<blockNum, nullptr, stream>>>(
                x, y, z);
    }
    else if (xInfo.dtype == 1) {
        // FP16
        sub_custom<half>
            <<<blockNum, nullptr, stream>>>(
                x, y, z);
    }
}
