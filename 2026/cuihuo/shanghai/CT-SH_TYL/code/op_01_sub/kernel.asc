#include <cmath>
#include "kernel_operator.h"
#include "platform/platform_ascendc.h"

/*
 * Sub Kernel — Ascend C Direct Invocation
 * z[i] = x[i] - y[i], element-wise, float32 / float16, ND.
 */

namespace {
constexpr int64_t kMinBitsPerCore = 32768;
constexpr int64_t kElemAlign = 512;
constexpr int64_t kUbAlignBytes = 256;
constexpr int64_t kReservedUbBytes = 8192;
constexpr int64_t kPipelineDepth = 1;

struct SubTiling {
    int64_t totalLength;
    int64_t blockLength;
    int64_t tileLength;
};

inline int64_t CeilDiv(int64_t a, int64_t b)
{
    return (a + b - 1) / b;
}

template <typename T>
SubTiling CalcSubTiling(int64_t totalLength, int64_t coreLimit)
{
    uint64_t ubSize = 196608;
    int64_t hardwareCoreNum = 0;
    auto platform = platform_ascendc::PlatformAscendCManager::GetInstance();
    if (platform != nullptr) {
        uint64_t queriedUbSize = 0;
        platform->GetCoreMemSize(platform_ascendc::CoreMemType::UB, queriedUbSize);
        if (queriedUbSize > 0) {
            ubSize = queriedUbSize;
        }
        hardwareCoreNum = platform->GetCoreNumAiv();
    }
    if (coreLimit <= 0) {
        coreLimit = 1;
    }
    if (hardwareCoreNum > 0 && hardwareCoreNum < coreLimit) {
        coreLimit = hardwareCoreNum;
    }

    const int64_t bitsPerElem = static_cast<int64_t>(sizeof(T) * 8);
    int64_t wantedCoreNum = CeilDiv(totalLength * bitsPerElem, kMinBitsPerCore);
    if (wantedCoreNum < 1) {
        wantedCoreNum = 1;
    }
    int64_t coreNum = wantedCoreNum < coreLimit ? wantedCoreNum : coreLimit;
    if (coreNum < 1) {
        coreNum = 1;
    }

    int64_t blockLength = CeilDiv(CeilDiv(totalLength, coreNum), kElemAlign) * kElemAlign;
    if (blockLength < 1) {
        blockLength = kElemAlign;
    }

    int64_t elemsPerAlign = kUbAlignBytes / static_cast<int64_t>(sizeof(T));
    if (elemsPerAlign < 1) {
        elemsPerAlign = 1;
    }
    const int64_t bytesPerElem = (sizeof(T) == 4) ? 12 : 18;
    int64_t ubMax = (static_cast<int64_t>(ubSize) - kReservedUbBytes) / bytesPerElem;
    ubMax = (ubMax / elemsPerAlign) * elemsPerAlign;
    if (ubMax < 1) {
        ubMax = elemsPerAlign;
    }

    int64_t tileLength = ubMax < blockLength ? ubMax : blockLength;
    if (tileLength < 1) {
        tileLength = 1;
    }

    SubTiling tiling;
    tiling.totalLength = totalLength;
    tiling.blockLength = blockLength;
    tiling.tileLength = tileLength;
    return tiling;
}

template <typename T>
class KernelSub {
public:
    __aicore__ inline KernelSub() {}

    __aicore__ inline void Init(GM_ADDR x, GM_ADDR y, GM_ADDR z, const SubTiling &tiling)
    {
        const int64_t offset = tiling.blockLength * AscendC::GetBlockIdx();
        xGm_.SetGlobalBuffer((__gm__ T *)x + offset);
        yGm_.SetGlobalBuffer((__gm__ T *)y + offset);
        zGm_.SetGlobalBuffer((__gm__ T *)z + offset);

        pipe_.InitBuffer(inQueueX_, kPipelineDepth, tiling.tileLength * sizeof(T));
        pipe_.InitBuffer(inQueueY_, kPipelineDepth, tiling.tileLength * sizeof(T));
        pipe_.InitBuffer(outQueueZ_, kPipelineDepth, tiling.tileLength * sizeof(T));

        tileLength_ = tiling.tileLength;
        curLength_ = tiling.totalLength - offset;
        if (curLength_ > tiling.blockLength) {
            curLength_ = tiling.blockLength;
        }
        if (curLength_ < 0) {
            curLength_ = 0;
        }
    }

    __aicore__ inline void Process()
    {
        const int64_t tileNum = curLength_ / tileLength_;
        const int64_t tailLength = curLength_ - tileNum * tileLength_;
        for (int64_t i = 0; i < tileNum; ++i) {
            CopyIn(i * tileLength_, tileLength_);
            Compute(tileLength_);
            CopyOut(i * tileLength_, tileLength_);
        }
        if (tailLength > 0) {
            CopyIn(tileNum * tileLength_, tailLength);
            Compute(tailLength);
            CopyOut(tileNum * tileLength_, tailLength);
        }
    }

private:
    __aicore__ inline void CopyIn(int64_t offset, int64_t count)
    {
        AscendC::DataCopyExtParams copyParams{1, static_cast<uint32_t>(count * sizeof(T)), 0, 0, 0};
        AscendC::DataCopyPadExtParams<T> padParams{false, 0, 0, 0};
        auto xLocal = inQueueX_.AllocTensor<T>();
        auto yLocal = inQueueY_.AllocTensor<T>();
        AscendC::DataCopyPad(xLocal, xGm_[offset], copyParams, padParams);
        AscendC::DataCopyPad(yLocal, yGm_[offset], copyParams, padParams);
        inQueueX_.EnQue(xLocal);
        inQueueY_.EnQue(yLocal);
    }

    __aicore__ inline void Compute(int64_t count)
    {
        auto xLocal = inQueueX_.DeQue<T>();
        auto yLocal = inQueueY_.DeQue<T>();
        auto zLocal = outQueueZ_.AllocTensor<T>();
        AscendC::Sub(zLocal, xLocal, yLocal, static_cast<int32_t>(count));
        outQueueZ_.EnQue(zLocal);
        inQueueX_.FreeTensor(xLocal);
        inQueueY_.FreeTensor(yLocal);
    }

    __aicore__ inline void CopyOut(int64_t offset, int64_t count)
    {
        auto zLocal = outQueueZ_.DeQue<T>();
        AscendC::DataCopyExtParams copyParams{1, static_cast<uint32_t>(count * sizeof(T)), 0, 0, 0};
        AscendC::DataCopyPad(zGm_[offset], zLocal, copyParams);
        outQueueZ_.FreeTensor(zLocal);
    }

    AscendC::TPipe pipe_;
    AscendC::GlobalTensor<T> xGm_;
    AscendC::GlobalTensor<T> yGm_;
    AscendC::GlobalTensor<T> zGm_;
    AscendC::TQue<AscendC::TPosition::VECIN, kPipelineDepth> inQueueX_;
    AscendC::TQue<AscendC::TPosition::VECIN, kPipelineDepth> inQueueY_;
    AscendC::TQue<AscendC::TPosition::VECOUT, kPipelineDepth> outQueueZ_;
    int64_t tileLength_ = 0;
    int64_t curLength_ = 0;
};

template <>
class KernelSub<half> {
public:
    __aicore__ inline KernelSub() {}

    __aicore__ inline void Init(GM_ADDR x, GM_ADDR y, GM_ADDR z, const SubTiling &tiling)
    {
        const int64_t offset = tiling.blockLength * AscendC::GetBlockIdx();
        xGm_.SetGlobalBuffer((__gm__ half *)x + offset);
        yGm_.SetGlobalBuffer((__gm__ half *)y + offset);
        zGm_.SetGlobalBuffer((__gm__ half *)z + offset);

        pipe_.InitBuffer(inQueueX_, kPipelineDepth, tiling.tileLength * sizeof(half));
        pipe_.InitBuffer(inQueueY_, kPipelineDepth, tiling.tileLength * sizeof(half));
        pipe_.InitBuffer(outQueueZ_, kPipelineDepth, tiling.tileLength * sizeof(half));
        pipe_.InitBuffer(tBufXF32_, tiling.tileLength * sizeof(float));
        pipe_.InitBuffer(tBufYF32_, tiling.tileLength * sizeof(float));
        pipe_.InitBuffer(tBufZF32_, tiling.tileLength * sizeof(float));

        xF32_ = tBufXF32_.Get<float>();
        yF32_ = tBufYF32_.Get<float>();
        zF32_ = tBufZF32_.Get<float>();

        tileLength_ = tiling.tileLength;
        curLength_ = tiling.totalLength - offset;
        if (curLength_ > tiling.blockLength) {
            curLength_ = tiling.blockLength;
        }
        if (curLength_ < 0) {
            curLength_ = 0;
        }
    }

    __aicore__ inline void Process()
    {
        const int64_t tileNum = curLength_ / tileLength_;
        const int64_t tailLength = curLength_ - tileNum * tileLength_;
        for (int64_t i = 0; i < tileNum; ++i) {
            CopyIn(i * tileLength_, tileLength_);
            Compute(tileLength_);
            CopyOut(i * tileLength_, tileLength_);
        }
        if (tailLength > 0) {
            CopyIn(tileNum * tileLength_, tailLength);
            Compute(tailLength);
            CopyOut(tileNum * tileLength_, tailLength);
        }
    }

private:
    __aicore__ inline void CopyIn(int64_t offset, int64_t count)
    {
        AscendC::DataCopyExtParams copyParams{1, static_cast<uint32_t>(count * sizeof(half)), 0, 0, 0};
        AscendC::DataCopyPadExtParams<half> padParams{false, 0, 0, 0};
        auto xLocal = inQueueX_.AllocTensor<half>();
        auto yLocal = inQueueY_.AllocTensor<half>();
        AscendC::DataCopyPad(xLocal, xGm_[offset], copyParams, padParams);
        AscendC::DataCopyPad(yLocal, yGm_[offset], copyParams, padParams);
        inQueueX_.EnQue(xLocal);
        inQueueY_.EnQue(yLocal);
    }

    __aicore__ inline void Compute(int64_t count)
    {
        auto xLocal = inQueueX_.DeQue<half>();
        auto yLocal = inQueueY_.DeQue<half>();
        auto zLocal = outQueueZ_.AllocTensor<half>();
        const int32_t elementCount = static_cast<int32_t>(count);
        AscendC::Cast(xF32_, xLocal, AscendC::RoundMode::CAST_NONE, elementCount);
        AscendC::Cast(yF32_, yLocal, AscendC::RoundMode::CAST_NONE, elementCount);
        AscendC::Sub(zF32_, xF32_, yF32_, elementCount);
        AscendC::Cast(zLocal, zF32_, AscendC::RoundMode::CAST_RINT, elementCount);
        outQueueZ_.EnQue(zLocal);
        inQueueX_.FreeTensor(xLocal);
        inQueueY_.FreeTensor(yLocal);
    }

    __aicore__ inline void CopyOut(int64_t offset, int64_t count)
    {
        auto zLocal = outQueueZ_.DeQue<half>();
        AscendC::DataCopyExtParams copyParams{1, static_cast<uint32_t>(count * sizeof(half)), 0, 0, 0};
        AscendC::DataCopyPad(zGm_[offset], zLocal, copyParams);
        outQueueZ_.FreeTensor(zLocal);
    }

    AscendC::TPipe pipe_;
    AscendC::GlobalTensor<half> xGm_;
    AscendC::GlobalTensor<half> yGm_;
    AscendC::GlobalTensor<half> zGm_;
    AscendC::TQue<AscendC::TPosition::VECIN, kPipelineDepth> inQueueX_;
    AscendC::TQue<AscendC::TPosition::VECIN, kPipelineDepth> inQueueY_;
    AscendC::TQue<AscendC::TPosition::VECOUT, kPipelineDepth> outQueueZ_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> tBufXF32_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> tBufYF32_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> tBufZF32_;
    AscendC::LocalTensor<float> xF32_;
    AscendC::LocalTensor<float> yF32_;
    AscendC::LocalTensor<float> zF32_;
    int64_t tileLength_ = 0;
    int64_t curLength_ = 0;
};

template <typename T>
__global__ __vector__ void sub_custom(GM_ADDR x, GM_ADDR y, GM_ADDR z, SubTiling tiling)
{
    KernelSub<T> op;
    op.Init(x, y, z, tiling);
    op.Process();
}

inline bool CheckTensorGroups(const TensorGroupInfo &info_x, const TensorGroupInfo &info_y,
                              const TensorGroupInfo &info_z, int64_t &totalLength)
{
    if (info_x.numTensors < 1 || info_y.numTensors < 1 || info_z.numTensors < 1) {
        return false;
    }
    const TensorInfo &tx = info_x.tensors[0];
    const TensorInfo &ty = info_y.tensors[0];
    const TensorInfo &tz = info_z.tensors[0];
    if (tx.dtype != ty.dtype || tx.dtype != tz.dtype) {
        return false;
    }
    if (tx.numDims != ty.numDims || tx.numDims != tz.numDims || tx.numDims <= 0) {
        return false;
    }
    totalLength = 1;
    for (int64_t i = 0; i < tx.numDims; ++i) {
        if (tx.shape[i] != ty.shape[i] || tx.shape[i] != tz.shape[i] || tx.shape[i] < 0) {
            return false;
        }
        totalLength *= tx.shape[i];
    }
    return totalLength > 0;
}

} // namespace

extern "C" void run_kernel(GM_ADDR x, const TensorGroupInfo& info_x, GM_ADDR y, const TensorGroupInfo& info_y, GM_ADDR z, const TensorGroupInfo& info_z, int64_t availableCoreNum, aclrtStream stream)
{
    int64_t totalLength = 0;
    if (!CheckTensorGroups(info_x, info_y, info_z, totalLength)) {
        return;
    }
    const int32_t dtype = info_x.tensors[0].dtype;
    if (dtype == 0) {
        SubTiling tiling = CalcSubTiling<float>(totalLength, availableCoreNum);
        const int64_t blockNum = (totalLength + tiling.blockLength - 1) / tiling.blockLength;
        sub_custom<float><<<blockNum, nullptr, stream>>>(x, y, z, tiling);
    } else if (dtype == 1) {
        SubTiling tiling = CalcSubTiling<half>(totalLength, availableCoreNum);
        const int64_t blockNum = (totalLength + tiling.blockLength - 1) / tiling.blockLength;
        sub_custom<half><<<blockNum, nullptr, stream>>>(x, y, z, tiling);
    }
}
