#include "kernel_operator.h"

constexpr uint32_t SUB_TOTAL_LENGTH = 8U * 2048U;
constexpr uint32_t SUB_TILE_LENGTH = 2048U;

// Sub: z = x - y
// Each block processes the fixed-size tensor in aligned tiles.
template <typename T>
class KernelSub {
public:
    __aicore__ inline void Init(
        GM_ADDR x,
        GM_ADDR y,
        GM_ADDR z,
        AscendC::TPipe* pipe)
    {
        xAddr = x;
        yAddr = y;
        zAddr = z;

        pipe->InitBuffer(
            inQueueX, 1, SUB_TILE_LENGTH * sizeof(T));
        pipe->InitBuffer(
            inQueueY, 1, SUB_TILE_LENGTH * sizeof(T));
        pipe->InitBuffer(
            outQueueZ, 1, SUB_TILE_LENGTH * sizeof(T));
    }

    __aicore__ inline void Process()
    {
        AscendC::GlobalTensor<T> xGm;
        AscendC::GlobalTensor<T> yGm;
        AscendC::GlobalTensor<T> zGm;

        for (uint32_t offset = 0;
             offset < SUB_TOTAL_LENGTH;
             offset += SUB_TILE_LENGTH) {

            xGm.SetGlobalBuffer(
                (__gm__ T*)xAddr + offset, SUB_TILE_LENGTH);
            yGm.SetGlobalBuffer(
                (__gm__ T*)yAddr + offset, SUB_TILE_LENGTH);
            zGm.SetGlobalBuffer(
                (__gm__ T*)zAddr + offset, SUB_TILE_LENGTH);

            // CopyIn
            AscendC::LocalTensor<T> xLocal =
                inQueueX.AllocTensor<T>();
            AscendC::LocalTensor<T> yLocal =
                inQueueY.AllocTensor<T>();

            AscendC::DataCopy(xLocal, xGm, SUB_TILE_LENGTH);
            AscendC::DataCopy(yLocal, yGm, SUB_TILE_LENGTH);

            inQueueX.EnQue(xLocal);
            inQueueY.EnQue(yLocal);

            // Compute: z = x - y
            xLocal = inQueueX.DeQue<T>();
            yLocal = inQueueY.DeQue<T>();

            AscendC::LocalTensor<T> zLocal =
                outQueueZ.AllocTensor<T>();

            AscendC::Sub(
                zLocal, xLocal, yLocal, SUB_TILE_LENGTH);

            outQueueZ.EnQue(zLocal);

            inQueueX.FreeTensor(xLocal);
            inQueueY.FreeTensor(yLocal);

            // CopyOut
            zLocal = outQueueZ.DeQue<T>();
            AscendC::DataCopy(zGm, zLocal, SUB_TILE_LENGTH);
            outQueueZ.FreeTensor(zLocal);
        }
    }

private:
    GM_ADDR xAddr;
    GM_ADDR yAddr;
    GM_ADDR zAddr;

    AscendC::TQue<AscendC::TPosition::VECIN, 1> inQueueX;
    AscendC::TQue<AscendC::TPosition::VECIN, 1> inQueueY;
    AscendC::TQue<AscendC::TPosition::VECOUT, 1> outQueueZ;
};

// FP32 kernel
__global__ __vector__ void sub_custom_fp32(
    GM_ADDR x, GM_ADDR y, GM_ADDR z)
{
    AscendC::TPipe pipe;
    KernelSub<float> op;
    op.Init(x, y, z, &pipe);
    op.Process();
}

// FP16 kernel
__global__ __vector__ void sub_custom_fp16(
    GM_ADDR x, GM_ADDR y, GM_ADDR z)
{
    AscendC::TPipe pipe;
    KernelSub<half> op;
    op.Init(x, y, z, &pipe);
    op.Process();
}

// Host entry required by the supplied template.
extern "C" void run_kernel(
    GM_ADDR x,
    const TensorGroupInfo& info_x,
    GM_ADDR y,
    const TensorGroupInfo& info_y,
    GM_ADDR z,
    const TensorGroupInfo& info_z,
    int64_t availableCoreNum,
    aclrtStream stream)
{
    if (availableCoreNum < 1 ||
        info_x.numTensors < 1 ||
        info_y.numTensors < 1 ||
        info_z.numTensors < 1) {
        return;
    }

    const TensorInfo& tx = info_x.tensors[0];
    const TensorInfo& ty = info_y.tensors[0];
    const TensorInfo& tz = info_z.tensors[0];

    // Validate shape: (8, 2048)
    if (tx.numDims != 2 ||
        ty.numDims != 2 ||
        tz.numDims != 2) {
        return;
    }

    if (tx.shape[0] != 8 || tx.shape[1] != 2048 ||
        ty.shape[0] != 8 || ty.shape[1] != 2048 ||
        tz.shape[0] != 8 || tz.shape[1] != 2048) {
        return;
    }

    // Input and output dtypes must match.
    if (tx.dtype != ty.dtype || tx.dtype != tz.dtype) {
        return;
    }

    // dtype: 0 = float32, 1 = float16
    if (tx.dtype == 0) {
        sub_custom_fp32<<<1, nullptr, stream>>>(x, y, z);
    } else if (tx.dtype == 1) {
        sub_custom_fp16<<<1, nullptr, stream>>>(x, y, z);
    }
}