#include <cmath>
#include <cstdint>
#include <stdexcept>
#include "kernel_operator.h"

// TensorInfo / TensorGroupInfo 由外部预定义，无需重复定义。
// 输入输出要求：单个张量、形状相同、类型相同、连续存储。

// ---------------------------------------------------------------------------
// Tiling 参数：由 host 侧 run_kernel 计算后按值传给核函数
// ---------------------------------------------------------------------------
struct SubCustomTilingData {
    uint64_t totalLength;  // 总元素数
    uint32_t tileLength;   // 每个 Tile 的最大元素数
};

constexpr uint32_t BUFFER_NUM = 2;
constexpr uint32_t QUEUE_DEPTH = 1;

// ---------------------------------------------------------------------------
// KernelSub：z = x - y
// ---------------------------------------------------------------------------
template <typename T>
class KernelSub {
public:
    __aicore__ inline KernelSub() {}

    __aicore__ inline void Init(
        GM_ADDR x,
        GM_ADDR y,
        GM_ADDR z,
        const SubCustomTilingData& tiling)
    {
        this->tileLength = tiling.tileLength;

        const uint64_t totalLength = tiling.totalLength;
        const uint64_t totalTiles =
            totalLength / this->tileLength +
            (totalLength % this->tileLength != 0);

        const uint64_t coreNum = AscendC::GetBlockNum();
        const uint64_t coreIdx = AscendC::GetBlockIdx();

        // 按完整 Tile 分配任务，保证不同核的起始地址对齐。
        const uint64_t baseTiles = totalTiles / coreNum;
        const uint64_t extraTiles = totalTiles % coreNum;

        const uint64_t coreTiles =
            baseTiles + (coreIdx < extraTiles ? 1 : 0);

        const uint64_t firstTile =
            coreIdx * baseTiles +
            (coreIdx < extraTiles ? coreIdx : extraTiles);

        const uint64_t blockOffset = firstTile * this->tileLength;
        const uint64_t capacity = coreTiles * this->tileLength;
        const uint64_t remaining = totalLength - blockOffset;

        this->blockLength =
            remaining < capacity ? remaining : capacity;

        // 保留模板中 tileNum × BUFFER_NUM 的循环结构。
        // 当 Tile 数为奇数时，Process 会跳过最后一次空迭代。
        this->tileNum =
            (coreTiles + BUFFER_NUM - 1) / BUFFER_NUM;

        xGm.SetGlobalBuffer(
            (__gm__ T*)x + blockOffset, this->blockLength);
        yGm.SetGlobalBuffer(
            (__gm__ T*)y + blockOffset, this->blockLength);
        zGm.SetGlobalBuffer(
            (__gm__ T*)z + blockOffset, this->blockLength);

        pipe.InitBuffer(
            inQueueX, BUFFER_NUM, this->tileLength * sizeof(T));
        pipe.InitBuffer(
            inQueueY, BUFFER_NUM, this->tileLength * sizeof(T));
        pipe.InitBuffer(
            outQueueZ, BUFFER_NUM, this->tileLength * sizeof(T));
    }

    __aicore__ inline void Process()
    {
        const uint64_t loopCount = this->tileNum * BUFFER_NUM;

        for (uint64_t i = 0; i < loopCount; ++i) {
            const uint64_t offset = i * this->tileLength;
            if (offset >= this->blockLength) {
                break;
            }

            const uint64_t remaining = this->blockLength - offset;
            this->currentLength = static_cast<uint32_t>(
                remaining < this->tileLength
                    ? remaining
                    : this->tileLength);

            CopyIn(i);
            Compute(i);
            CopyOut(i);
        }
    }

private:
    __aicore__ inline void CopyIn(uint64_t progress)
    {
        AscendC::LocalTensor<T> xLocal =
            inQueueX.AllocTensor<T>();
        AscendC::LocalTensor<T> yLocal =
            inQueueY.AllocTensor<T>();

        const uint64_t offset = progress * this->tileLength;
        const uint32_t byteLength =
            this->currentLength * sizeof(T);

        if (byteLength % 32 == 0) {
            AscendC::DataCopy(
                xLocal, xGm[offset], this->currentLength);
            AscendC::DataCopy(
                yLocal, yGm[offset], this->currentLength);
        } else {
            // 非 32 字节对齐的尾块：仅搬入有效数据。
            AscendC::DataCopyExtParams copyParams{
                1, byteLength, 0, 0, 0
            };
            AscendC::DataCopyPadExtParams<T> padParams{
                false, 0, 0, static_cast<T>(0)
            };

            AscendC::DataCopyPad(
                xLocal, xGm[offset], copyParams, padParams);
            AscendC::DataCopyPad(
                yLocal, yGm[offset], copyParams, padParams);
        }

        inQueueX.EnQue<T>(xLocal);
        inQueueY.EnQue<T>(yLocal);
    }

    __aicore__ inline void Compute(uint64_t progress)
    {
        (void)progress;

        AscendC::LocalTensor<T> xLocal =
            inQueueX.DeQue<T>();
        AscendC::LocalTensor<T> yLocal =
            inQueueY.DeQue<T>();
        AscendC::LocalTensor<T> zLocal =
            outQueueZ.AllocTensor<T>();

        // 矢量减法：z = x - y。
        AscendC::Sub(
            zLocal, xLocal, yLocal, this->currentLength);

        outQueueZ.EnQue<T>(zLocal);
        inQueueX.FreeTensor(xLocal);
        inQueueY.FreeTensor(yLocal);
    }

    __aicore__ inline void CopyOut(uint64_t progress)
    {
        AscendC::LocalTensor<T> zLocal =
            outQueueZ.DeQue<T>();

        const uint64_t offset = progress * this->tileLength;
        const uint32_t byteLength =
            this->currentLength * sizeof(T);

        if (byteLength % 32 == 0) {
            AscendC::DataCopy(
                zGm[offset], zLocal, this->currentLength);
        } else {
            // 仅写出有效字节，避免尾块越界写入。
            AscendC::DataCopyExtParams copyParams{
                1, byteLength, 0, 0, 0
            };
            AscendC::DataCopyPad(
                zGm[offset], zLocal, copyParams);
        }

        outQueueZ.FreeTensor(zLocal);
    }

private:
    AscendC::TPipe pipe;

    AscendC::TQue<AscendC::QuePosition::VECIN, QUEUE_DEPTH>
        inQueueX, inQueueY;
    AscendC::TQue<AscendC::QuePosition::VECOUT, QUEUE_DEPTH>
        outQueueZ;

    AscendC::GlobalTensor<T> xGm, yGm, zGm;

    uint64_t blockLength;
    uint64_t tileNum;
    uint32_t tileLength;
    uint32_t currentLength;
};

// ---------------------------------------------------------------------------
// 核函数入口
// ---------------------------------------------------------------------------
template <typename T>
__global__ __vector__ void sub_custom(
    GM_ADDR x,
    GM_ADDR y,
    GM_ADDR z,
    SubCustomTilingData tiling)
{
    KernelSub<T> op;
    op.Init(x, y, z, tiling);
    op.Process();
}

// ---------------------------------------------------------------------------
// host 侧启动函数
// ---------------------------------------------------------------------------
extern "C" void run_kernel(
    GM_ADDR x,
    const TensorGroupInfo& info_x,
    GM_ADDR y,
    const TensorGroupInfo& info_y,
    GM_ADDR z,
    const TensorGroupInfo& info_z,
    int64_t availableCoreNum,
    aclrtStream stream)
{
    const TensorInfo& tx = info_x.tensors[0];
    const TensorInfo& ty = info_y.tensors[0];
    const TensorInfo& tz = info_z.tensors[0];

    if (tx.dtype != ty.dtype || tx.dtype != tz.dtype) {
        throw std::invalid_argument(
            "Sub requires identical input and output dtypes.");
    }
    if (tx.dtype != 0 && tx.dtype != 1) {
        throw std::invalid_argument(
            "This Sub kernel supports only FP32 and FP16.");
    }
    if (tx.numDims != ty.numDims || tx.numDims != tz.numDims) {
        throw std::invalid_argument(
            "Sub requires identical input and output shapes.");
    }

    uint64_t totalLength = 1;
    for (int64_t i = 0; i < tx.numDims; ++i) {
        if (tx.shape[i] < 0 ||
            tx.shape[i] != ty.shape[i] ||
            tx.shape[i] != tz.shape[i]) {
            throw std::invalid_argument(
                "Sub requires identical, nonnegative shapes.");
        }
        totalLength *= static_cast<uint64_t>(tx.shape[i]);
    }

    if (totalLength == 0) {
        return;
    }
    if (availableCoreNum <= 0) {
        throw std::invalid_argument(
            "availableCoreNum must be positive.");
    }

    // 每块最多处理 2048 个元素，控制 UB 占用。
    constexpr uint32_t tileLength = 2048;
    const uint64_t totalTiles =
        totalLength / tileLength +
        (totalLength % tileLength != 0);

    // 沿用模板最多 8 核的设置，并限制为实际可用核数。
    uint32_t blockDim = static_cast<uint32_t>(
        availableCoreNum < 8 ? availableCoreNum : 8);

    if (totalTiles < blockDim) {
        blockDim = static_cast<uint32_t>(totalTiles);
    }

    SubCustomTilingData tiling{
        totalLength, tileLength
    };

    if (tx.dtype == 1) {
        sub_custom<half><<<blockDim, nullptr, stream>>>(
            x, y, z, tiling);
    } else {
        sub_custom<float><<<blockDim, nullptr, stream>>>(
            x, y, z, tiling);
    }
}