#include <cmath>
#include "kernel_operator.h"

/*
 * Sub Kernel — Ascend C Direct Invocation
 * This file is #included by main.asc — do NOT add main() or include guards.
 *
 * z[i] = x[i] - y[i], element-wise, dtype: float32 / float16.
 * The launch entry run_kernel() dispatches on TensorInfo.dtype (0=fp32, 1=fp16).
 */

constexpr int32_t SUB_PIPE_DEPTH = 2;
constexpr int32_t SUB_TILE_SIZE = 2048;
constexpr int64_t SUB_MIN_ELEMS_PER_CORE = 1024;

template <typename T>
class KernelSub {
public:
    __aicore__ inline KernelSub() {}

    __aicore__ inline void Init(GM_ADDR x, GM_ADDR y, GM_ADDR z,
                                int64_t totalLength, int64_t blockLength)
    {
        int64_t offset = static_cast<int64_t>(AscendC::GetBlockIdx()) * blockLength;
        int64_t current = totalLength - offset;
        if (current > blockLength) {
            current = blockLength;
        }
        if (current < 0) {
            current = 0;
        }
        length_ = current;

        xGm_.SetGlobalBuffer((__gm__ T *)x + offset, current);
        yGm_.SetGlobalBuffer((__gm__ T *)y + offset, current);
        zGm_.SetGlobalBuffer((__gm__ T *)z + offset, current);

        pipe_.InitBuffer(inQueueX_, SUB_PIPE_DEPTH, SUB_TILE_SIZE * sizeof(T));
        pipe_.InitBuffer(inQueueY_, SUB_PIPE_DEPTH, SUB_TILE_SIZE * sizeof(T));
        pipe_.InitBuffer(outQueueZ_, SUB_PIPE_DEPTH, SUB_TILE_SIZE * sizeof(T));
    }

    __aicore__ inline void Process()
    {
        int64_t tileNum = length_ / SUB_TILE_SIZE;
        int64_t tail = length_ - tileNum * SUB_TILE_SIZE;
        for (int64_t i = 0; i < tileNum; ++i) {
            CopyIn(i * SUB_TILE_SIZE, SUB_TILE_SIZE);
            Compute(SUB_TILE_SIZE);
            CopyOut(i * SUB_TILE_SIZE, SUB_TILE_SIZE);
        }
        if (tail > 0) {
            CopyIn(tileNum * SUB_TILE_SIZE, tail);
            Compute(tail);
            CopyOut(tileNum * SUB_TILE_SIZE, tail);
        }
    }

private:
    __aicore__ inline void CopyIn(int64_t offset, int64_t count)
    {
        AscendC::LocalTensor<T> xLocal = inQueueX_.AllocTensor<T>();
        AscendC::LocalTensor<T> yLocal = inQueueY_.AllocTensor<T>();

        AscendC::DataCopyExtParams copyParams{1, static_cast<uint32_t>(count * sizeof(T)), 0, 0, 0};
        AscendC::DataCopyPadExtParams<T> padParams{false, 0, 0, 0};
        AscendC::DataCopyPad(xLocal, xGm_[offset], copyParams, padParams);
        AscendC::DataCopyPad(yLocal, yGm_[offset], copyParams, padParams);

        inQueueX_.EnQue(xLocal);
        inQueueY_.EnQue(yLocal);
    }

    __aicore__ inline void Compute(int64_t count)
    {
        AscendC::LocalTensor<T> xLocal = inQueueX_.DeQue<T>();
        AscendC::LocalTensor<T> yLocal = inQueueY_.DeQue<T>();
        AscendC::LocalTensor<T> zLocal = outQueueZ_.AllocTensor<T>();

        AscendC::Sub(zLocal, xLocal, yLocal, static_cast<int32_t>(count));

        outQueueZ_.EnQue(zLocal);
        inQueueX_.FreeTensor(xLocal);
        inQueueY_.FreeTensor(yLocal);
    }

    __aicore__ inline void CopyOut(int64_t offset, int64_t count)
    {
        AscendC::LocalTensor<T> zLocal = outQueueZ_.DeQue<T>();
        AscendC::DataCopyExtParams copyParams{1, static_cast<uint32_t>(count * sizeof(T)), 0, 0, 0};
        AscendC::DataCopyPad(zGm_[offset], zLocal, copyParams);
        outQueueZ_.FreeTensor(zLocal);
    }

    AscendC::TPipe pipe_;
    AscendC::GlobalTensor<T> xGm_;
    AscendC::GlobalTensor<T> yGm_;
    AscendC::GlobalTensor<T> zGm_;
    AscendC::TQue<AscendC::TPosition::VECIN, SUB_PIPE_DEPTH> inQueueX_;
    AscendC::TQue<AscendC::TPosition::VECIN, SUB_PIPE_DEPTH> inQueueY_;
    AscendC::TQue<AscendC::TPosition::VECOUT, SUB_PIPE_DEPTH> outQueueZ_;
    int64_t length_ = 0;
};

extern "C" __global__ __vector__ void sub_custom_fp32(GM_ADDR x, GM_ADDR y, GM_ADDR z,
                                                      int64_t totalLength, int64_t blockLength)
{
    KernelSub<float> op;
    op.Init(x, y, z, totalLength, blockLength);
    op.Process();
}

extern "C" __global__ __vector__ void sub_custom_fp16(GM_ADDR x, GM_ADDR y, GM_ADDR z,
                                                      int64_t totalLength, int64_t blockLength)
{
    KernelSub<half> op;
    op.Init(x, y, z, totalLength, blockLength);
    op.Process();
}

extern "C" void run_kernel(GM_ADDR x, const TensorGroupInfo& info_x, GM_ADDR y, const TensorGroupInfo& info_y, GM_ADDR z, const TensorGroupInfo& info_z, int64_t availableCoreNum, aclrtStream stream)
{
    const TensorInfo& xInfo = info_x.tensors[0];
    int64_t totalLength = 1;
    for (int64_t i = 0; i < xInfo.numDims; ++i) {
        totalLength *= xInfo.shape[i];
    }
    if (totalLength <= 0) {
        return;
    }

    int64_t maxBlocks = (totalLength + SUB_MIN_ELEMS_PER_CORE - 1) / SUB_MIN_ELEMS_PER_CORE;
    int64_t numBlocks = availableCoreNum > 0 ? availableCoreNum : 1;
    if (numBlocks > maxBlocks) {
        numBlocks = maxBlocks;
    }
    if (numBlocks < 1) {
        numBlocks = 1;
    }
    int64_t blockLength = (totalLength + numBlocks - 1) / numBlocks;
    uint32_t blockNum = static_cast<uint32_t>(numBlocks);

    if (xInfo.dtype == 0) {
        sub_custom_fp32<<<blockNum, nullptr, stream>>>(x, y, z, totalLength, blockLength);
    } else if (xInfo.dtype == 1) {
        sub_custom_fp16<<<blockNum, nullptr, stream>>>(x, y, z, totalLength, blockLength);
    }
}
