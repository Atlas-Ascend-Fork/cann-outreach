#include "kernel_operator.h"

constexpr int32_t SUB_LENGTH = 2048;
constexpr int32_t SUB_ROWS = 8;

template <typename T>
class SubKernel {
public:
    __aicore__ inline SubKernel() {}

    __aicore__ inline void Init(GM_ADDR x, GM_ADDR y, GM_ADDR z)
    {
        const uint32_t offset = AscendC::GetBlockIdx() * SUB_LENGTH;
        xGm.SetGlobalBuffer((__gm__ T *)x + offset, SUB_LENGTH);
        yGm.SetGlobalBuffer((__gm__ T *)y + offset, SUB_LENGTH);
        zGm.SetGlobalBuffer((__gm__ T *)z + offset, SUB_LENGTH);
        pipe.InitBuffer(inX, 1, SUB_LENGTH * sizeof(T));
        pipe.InitBuffer(inY, 1, SUB_LENGTH * sizeof(T));
        pipe.InitBuffer(outZ, 1, SUB_LENGTH * sizeof(T));
    }

    __aicore__ inline void Process()
    {
        auto xLocal = inX.AllocTensor<T>();
        auto yLocal = inY.AllocTensor<T>();
        DataCopy(xLocal, xGm, SUB_LENGTH);
        DataCopy(yLocal, yGm, SUB_LENGTH);
        inX.EnQue(xLocal);
        inY.EnQue(yLocal);

        xLocal = inX.DeQue<T>();
        yLocal = inY.DeQue<T>();
        auto zLocal = outZ.AllocTensor<T>();
        Sub(zLocal, xLocal, yLocal, SUB_LENGTH);
        outZ.EnQue(zLocal);
        inX.FreeTensor(xLocal);
        inY.FreeTensor(yLocal);

        zLocal = outZ.DeQue<T>();
        DataCopy(zGm, zLocal, SUB_LENGTH);
        outZ.FreeTensor(zLocal);
    }

private:
    AscendC::TPipe pipe;
    AscendC::TQue<AscendC::QuePosition::VECIN, 1> inX;
    AscendC::TQue<AscendC::QuePosition::VECIN, 1> inY;
    AscendC::TQue<AscendC::QuePosition::VECOUT, 1> outZ;
    AscendC::GlobalTensor<T> xGm, yGm, zGm;
};

template <typename T>
__global__ __aicore__ void sub_custom(GM_ADDR x, GM_ADDR y, GM_ADDR z)
{
    SubKernel<T> op;
    op.Init(x, y, z);
    op.Process();
}

extern "C" void run_kernel(GM_ADDR x, const TensorGroupInfo& info_x,
                           GM_ADDR y, const TensorGroupInfo& info_y,
                           GM_ADDR z, const TensorGroupInfo& info_z,
                           int64_t availableCoreNum, aclrtStream stream)
{
    if (availableCoreNum < 1 || info_x.numTensors != 1 || info_y.numTensors != 1 ||
        info_z.numTensors != 1 || info_x.tensors[0].numDims != 2 ||
        info_y.tensors[0].numDims != 2 || info_z.tensors[0].numDims != 2) return;
    const auto &a = info_x.tensors[0];
    const auto &b = info_y.tensors[0];
    const auto &c = info_z.tensors[0];
    if (a.shape[0] != SUB_ROWS || a.shape[1] != SUB_LENGTH ||
        b.shape[0] != SUB_ROWS || b.shape[1] != SUB_LENGTH ||
        c.shape[0] != SUB_ROWS || c.shape[1] != SUB_LENGTH ||
        a.dtype != b.dtype || a.dtype != c.dtype) return;
    if (a.dtype == 0) {
        sub_custom<float><<<SUB_ROWS, nullptr, stream>>>(x, y, z);
    } else if (a.dtype == 1) {
        sub_custom<half><<<SUB_ROWS, nullptr, stream>>>(x, y, z);
    }
}
