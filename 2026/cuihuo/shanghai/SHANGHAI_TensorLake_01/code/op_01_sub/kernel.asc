#include <cmath>
#include <cstdio>
#include "kernel_operator.h"

// ---------------------------------------------------------------------------
// Tiling 参数：由 host 侧 run_kernel 计算后按值传给核函数
// ---------------------------------------------------------------------------
struct SubCustomTilingData {
    uint32_t totalLength;   // 展平后的元素总数
    uint32_t tileNum;       // 每核的数据块个数（每核循环 tileNum * BUFFER_NUM 轮）
};

constexpr uint32_t BUFFER_NUM = 2;   // double buffer
constexpr uint32_t QUEUE_DEPTH = 1;

// ---------------------------------------------------------------------------
// SubCompute<T>：按 dtype 选择计算链（C++14，不使用 if constexpr）
//   float：直接 Sub<float>
//   half ：Cast -> Sub<float> -> Cast(CAST_RINT)，与 numpy round-half-even 对齐
// ---------------------------------------------------------------------------
template <typename T>
struct SubCompute {
    __aicore__ static void Run(const AscendC::LocalTensor<T>& zLocal, const AscendC::LocalTensor<T>& xLocal,
                               const AscendC::LocalTensor<T>& yLocal, const AscendC::LocalTensor<float>& f0,
                               const AscendC::LocalTensor<float>& f1, uint32_t n)
    {
        (void)f0;
        (void)f1;
        AscendC::Sub(zLocal, xLocal, yLocal, static_cast<int32_t>(n));
    }
};

template <>
struct SubCompute<half> {
    __aicore__ static void Run(const AscendC::LocalTensor<half>& zLocal, const AscendC::LocalTensor<half>& xLocal,
                               const AscendC::LocalTensor<half>& yLocal, const AscendC::LocalTensor<float>& f0,
                               const AscendC::LocalTensor<float>& f1, uint32_t n)
    {
        AscendC::Cast<float, half>(f0, xLocal, AscendC::RoundMode::CAST_NONE, n);
        AscendC::Cast<float, half>(f1, yLocal, AscendC::RoundMode::CAST_NONE, n);
        // dst 与 src0 100% 重叠，满足通用地址重叠约束
        AscendC::Sub(f0, f0, f1, static_cast<int32_t>(n));
        AscendC::Cast<half, float>(zLocal, f0, AscendC::RoundMode::CAST_RINT, n);
    }
};

// ---------------------------------------------------------------------------
// KernelSub：z = x - y，每核分块循环计算（模板化，支持 float / half 等类型）
// ---------------------------------------------------------------------------
template <typename T>
class KernelSub {
public:
    __aicore__ inline KernelSub() {}

    __aicore__ inline void Init(AscendC::TPipe* pipeIn, GM_ADDR x, GM_ADDR y, GM_ADDR z,
                                const SubCustomTilingData& tiling)
    {
        pipe_ = pipeIn;
        totalLength_ = tiling.totalLength;
        tileNum_ = tiling.tileNum;
        if (tileNum_ == 0) {
            tileNum_ = 1;
        }

        // 按多核均分：blockLength = ceil(totalLength / coreNum)
        uint32_t coreNum = static_cast<uint32_t>(AscendC::GetBlockNum());
        if (coreNum == 0) {
            coreNum = 1;
        }
        blockLength_ = (totalLength_ + coreNum - 1) / coreNum;

        uint32_t blockIdx = static_cast<uint32_t>(AscendC::GetBlockIdx());
        uint32_t start = blockIdx * blockLength_;
        curLength_ = (start >= totalLength_) ? 0 : (totalLength_ - start);
        if (curLength_ > blockLength_) {
            curLength_ = blockLength_;
        }

        // 每核内再按 tileNum * BUFFER_NUM 分块
        tileLength_ = blockLength_ / (tileNum_ * BUFFER_NUM);
        if (tileLength_ == 0) {
            tileLength_ = 1;
        }

        xGm_.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(x) + start, curLength_);
        yGm_.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(y) + start, curLength_);
        zGm_.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(z) + start, curLength_);

        // 空核：不申请 UB、不搬运
        if (curLength_ == 0) {
            return;
        }

        pipe_->InitBuffer(inQueueX_, BUFFER_NUM, tileLength_ * sizeof(T));
        pipe_->InitBuffer(inQueueY_, BUFFER_NUM, tileLength_ * sizeof(T));
        pipe_->InitBuffer(outQueueZ_, BUFFER_NUM, tileLength_ * sizeof(T));
        // half 升精度路径的 FP32 临时空间（f0、f1 各 tileLength 个 float）
        pipe_->InitBuffer(tmpBuf_, 2 * tileLength_ * sizeof(float));
    }

    __aicore__ inline void Process()
    {
        if (curLength_ == 0) {
            return;
        }
        // 循环次数 = tileNum × BUFFER_NUM（考虑 Double Buffer）
        int32_t loopCount = static_cast<int32_t>(tileNum_ * BUFFER_NUM);
        // 依次处理每个数据块
        for (int32_t i = 0; i < loopCount; i++) {
            uint32_t offset = static_cast<uint32_t>(i) * tileLength_;
            if (offset >= curLength_) {
                break;
            }
            uint32_t n = curLength_ - offset;
            if (n > tileLength_) {
                n = tileLength_;
            }
            CopyIn(i, offset, n);    // 搬入第 i 块数据
            Compute(i, n);           // 计算第 i 块数据
            CopyOut(i, offset, n);   // 搬出第 i 块结果
        }
    }

private:
    __aicore__ inline void CopyIn(int32_t progress, uint32_t offset, uint32_t n)
    {
        (void)progress;
        AscendC::LocalTensor<T> xLocal = inQueueX_.AllocTensor<T>();
        AscendC::LocalTensor<T> yLocal = inQueueY_.AllocTensor<T>();
        if ((n * sizeof(T)) % 32 == 0) {
            AscendC::DataCopy(xLocal, xGm_[offset], n);
            AscendC::DataCopy(yLocal, yGm_[offset], n);
        } else {
            AscendC::DataCopyExtParams copyParams{1, static_cast<uint32_t>(n * sizeof(T)), 0, 0, 0};
            AscendC::DataCopyPadExtParams<T> padParams{false, 0, 0, 0};
            AscendC::DataCopyPad(xLocal, xGm_[offset], copyParams, padParams);
            AscendC::DataCopyPad(yLocal, yGm_[offset], copyParams, padParams);
        }
        inQueueX_.EnQue(xLocal);
        inQueueY_.EnQue(yLocal);
    }

    __aicore__ inline void Compute(int32_t progress, uint32_t n)
    {
        (void)progress;
        AscendC::LocalTensor<T> xLocal = inQueueX_.DeQue<T>();
        AscendC::LocalTensor<T> yLocal = inQueueY_.DeQue<T>();
        AscendC::LocalTensor<T> zLocal = outQueueZ_.AllocTensor<T>();

        AscendC::LocalTensor<float> tmp = tmpBuf_.Get<float>();
        AscendC::LocalTensor<float> f0 = tmp[0];
        AscendC::LocalTensor<float> f1 = tmp[tileLength_];
        SubCompute<T>::Run(zLocal, xLocal, yLocal, f0, f1, n);

        outQueueZ_.EnQue(zLocal);
        inQueueX_.FreeTensor(xLocal);
        inQueueY_.FreeTensor(yLocal);
    }

    __aicore__ inline void CopyOut(int32_t progress, uint32_t offset, uint32_t n)
    {
        (void)progress;
        AscendC::LocalTensor<T> zLocal = outQueueZ_.DeQue<T>();
        if ((n * sizeof(T)) % 32 == 0) {
            AscendC::DataCopy(zGm_[offset], zLocal, n);
        } else {
            AscendC::DataCopyExtParams copyParams{1, static_cast<uint32_t>(n * sizeof(T)), 0, 0, 0};
            AscendC::DataCopyPad(zGm_[offset], zLocal, copyParams);
        }
        outQueueZ_.FreeTensor(zLocal);
    }

private:
    AscendC::TPipe* pipe_ = nullptr;  // TPipe 在核函数作用域创建，指针传入
    AscendC::TQue<AscendC::QuePosition::VECIN, QUEUE_DEPTH> inQueueX_, inQueueY_;  // 输入数据队列管理对象，VECIN 位置
    AscendC::TQue<AscendC::QuePosition::VECOUT, QUEUE_DEPTH> outQueueZ_;  // 输出数据队列管理对象，VECOUT 位置
    AscendC::TBuf<AscendC::QuePosition::VECCALC> tmpBuf_;  // half 路径 FP32 临时空间
    AscendC::GlobalTensor<T> xGm_, yGm_, zGm_; // 管理输入输出 Global Memory 地址的对象，其中 xGm_、yGm_ 为输入，zGm_ 为输出

    uint32_t totalLength_ = 0;  // 展平后的元素总数
    uint32_t blockLength_ = 0;  // 每个核的计算数据长度
    uint32_t curLength_ = 0;    // 当前核实际处理的数据长度
    uint32_t tileNum_ = 0;      // 每个核需要计算的数据块个数，类似 batch 数量
    uint32_t tileLength_ = 0;   // 每个核内每个数据块的长度，类似 batch size
};

// ---------------------------------------------------------------------------
// 核函数入口：实例化 KernelSub<T> 并执行（T 由 run_kernel 按输入 dtype 选择）
// ---------------------------------------------------------------------------
template <typename T>
__global__ __vector__ void sub_custom(GM_ADDR x, GM_ADDR y, GM_ADDR z, SubCustomTilingData tiling)
{
    AscendC::TPipe pipe;
    KernelSub<T> op;
    op.Init(&pipe, x, y, z, tiling);
    op.Process();
}

// ---------------------------------------------------------------------------
// host 侧启动函数：从 TensorGroupInfo 推导 tiling 并启动核函数
// ---------------------------------------------------------------------------
extern "C" void run_kernel(GM_ADDR x, const TensorGroupInfo& info_x, GM_ADDR y, const TensorGroupInfo& info_y, GM_ADDR z, const TensorGroupInfo& info_z, int64_t availableCoreNum, aclrtStream stream)
{
    (void)info_y;
    (void)info_z;
    // 1. 取总元素数（x/y/z 形状一致）
    const TensorInfo& t0 = info_x.tensors[0];
    int64_t totalLength = 1;
    for (int64_t i = 0; i < t0.numDims; i++) {
        totalLength *= t0.shape[i];
    }
    // 2. 按输入 dtype 选择核函数实例（dtype 定义见 TensorInfo：0=fp32 1=fp16 2=bf16 ...）
    int32_t dtype = t0.dtype;
    // 为了简化计算，tileNum 设置为 8
    uint32_t tileNum = 8;

    // 3. blockDim = min(8, availableCoreNum, max(1, totalLength / (tileNum * BUFFER_NUM)))
    int64_t maxCoreByData = totalLength / (static_cast<int64_t>(tileNum) * BUFFER_NUM);
    if (maxCoreByData < 1) {
        maxCoreByData = 1;
    }
    int64_t blockDim = availableCoreNum;
    if (blockDim > 8) {
        blockDim = 8;
    }
    if (blockDim > maxCoreByData) {
        blockDim = maxCoreByData;
    }
    if (blockDim < 1) {
        blockDim = 1;
    }

    SubCustomTilingData tiling = {(uint32_t)totalLength, tileNum};
    if (dtype == 0) {
        // fp32：float 实例
        sub_custom<float><<<static_cast<uint32_t>(blockDim), nullptr, stream>>>(x, y, z, tiling);
    } else if (dtype == 1) {
        // fp16：half 实例
        sub_custom<half><<<static_cast<uint32_t>(blockDim), nullptr, stream>>>(x, y, z, tiling);
    }
}
