#include <cmath>
#include "kernel_operator.h"
/*
 * Sub Kernel — Ascend C Direct Invocation
 * z = x - y (element-wise), float32 / float16
 *
 * This file is #included by main.asc — no main(), no include guards.
 */

struct SubTilingData {
    uint32_t blockNum;
    uint32_t numPerCore;
    uint32_t tailNumLastCore;
};

constexpr uint32_t TILE_LENGTH = 4096;
constexpr uint32_t DOUBLE_BUFFER = 2;

template <typename T>
class KernelSub {
public:
    __aicore__ inline KernelSub(AscendC::TPipe* pipe) : pipe_(pipe) {}

    __aicore__ inline void Init(GM_ADDR x, GM_ADDR y, GM_ADDR z, const __gm__ SubTilingData* tiling)
    {
        uint32_t blockIdx = AscendC::GetBlockIdx();
        uint32_t offset = blockIdx * tiling->numPerCore;
        total_ = (blockIdx == tiling->blockNum - 1) ? tiling->tailNumLastCore : tiling->numPerCore;
        tileNum_ = (total_ + TILE_LENGTH - 1) / TILE_LENGTH;
        tailTileElemNum_ = total_ - TILE_LENGTH * (tileNum_ - 1);

        xGm_.SetGlobalBuffer((__gm__ T*)x + offset, total_);
        yGm_.SetGlobalBuffer((__gm__ T*)y + offset, total_);
        zGm_.SetGlobalBuffer((__gm__ T*)z + offset, total_);

        pipe_->InitBuffer(inQueueX_, DOUBLE_BUFFER, TILE_LENGTH * sizeof(T));
        pipe_->InitBuffer(inQueueY_, DOUBLE_BUFFER, TILE_LENGTH * sizeof(T));
        pipe_->InitBuffer(outQueueZ_, DOUBLE_BUFFER, TILE_LENGTH * sizeof(T));
    }

    __aicore__ inline void Process()
    {
        for (uint32_t i = 0; i < tileNum_; ++i) {
            uint32_t count = (i == tileNum_ - 1) ? tailTileElemNum_ : TILE_LENGTH;
            CopyIn(i, count);
            Compute(count);
            CopyOut(i, count);
        }
    }

private:
    __aicore__ inline void CopyIn(uint32_t tileIdx, uint32_t count)
    {
        AscendC::LocalTensor<T> xLocal = inQueueX_.AllocTensor<T>();
        AscendC::LocalTensor<T> yLocal = inQueueY_.AllocTensor<T>();

        AscendC::DataCopyExtParams copyParams;
        copyParams.blockCount = 1;
        copyParams.blockLen = count * sizeof(T);
        copyParams.srcStride = 0;
        copyParams.dstStride = 0;
        AscendC::DataCopyPadExtParams<T> padParams;

        AscendC::DataCopyPad(xLocal, xGm_[tileIdx * TILE_LENGTH], copyParams, padParams);
        AscendC::DataCopyPad(yLocal, yGm_[tileIdx * TILE_LENGTH], copyParams, padParams);

        inQueueX_.EnQue(xLocal);
        inQueueY_.EnQue(yLocal);
    }

    __aicore__ inline void Compute(uint32_t count)
    {
        AscendC::LocalTensor<T> xLocal = inQueueX_.DeQue<T>();
        AscendC::LocalTensor<T> yLocal = inQueueY_.DeQue<T>();
        AscendC::LocalTensor<T> zLocal = outQueueZ_.AllocTensor<T>();

        AscendC::Sub(zLocal, xLocal, yLocal, count);

        outQueueZ_.EnQue(zLocal);
        inQueueX_.FreeTensor(xLocal);
        inQueueY_.FreeTensor(yLocal);
    }

    __aicore__ inline void CopyOut(uint32_t tileIdx, uint32_t count)
    {
        AscendC::LocalTensor<T> zLocal = outQueueZ_.DeQue<T>();

        AscendC::DataCopyExtParams copyParams;
        copyParams.blockCount = 1;
        copyParams.blockLen = count * sizeof(T);
        copyParams.srcStride = 0;
        copyParams.dstStride = 0;

        AscendC::DataCopyPad(zGm_[tileIdx * TILE_LENGTH], zLocal, copyParams);
        outQueueZ_.FreeTensor(zLocal);
    }

    AscendC::TPipe* pipe_;
    AscendC::GlobalTensor<T> xGm_;
    AscendC::GlobalTensor<T> yGm_;
    AscendC::GlobalTensor<T> zGm_;

    AscendC::TQue<AscendC::TPosition::VECIN, 1> inQueueX_;
    AscendC::TQue<AscendC::TPosition::VECIN, 1> inQueueY_;
    AscendC::TQue<AscendC::TPosition::VECOUT, 1> outQueueZ_;

    uint32_t total_ = 0;
    uint32_t tileNum_ = 0;
    uint32_t tailTileElemNum_ = 0;
};

extern "C" __global__ __vector__ void sub_custom_fp32(GM_ADDR x, GM_ADDR y, GM_ADDR z, GM_ADDR tiling)
{
    AscendC::TPipe pipe;
    KernelSub<float> op(&pipe);
    op.Init(x, y, z, (__gm__ SubTilingData*)tiling);
    op.Process();
}

extern "C" __global__ __vector__ void sub_custom_fp16(GM_ADDR x, GM_ADDR y, GM_ADDR z, GM_ADDR tiling)
{
    AscendC::TPipe pipe;
    KernelSub<half> op(&pipe);
    op.Init(x, y, z, (__gm__ SubTilingData*)tiling);
    op.Process();
}

extern "C" void run_kernel(GM_ADDR x, const TensorGroupInfo& info_x, GM_ADDR y, const TensorGroupInfo& info_y, GM_ADDR z, const TensorGroupInfo& info_z, int64_t availableCoreNum, aclrtStream stream)
{
    int32_t dtype = info_x.tensors[0].dtype;
    if (dtype != 0 && dtype != 1) {
        return;
    }

    int64_t total = 1;
    const TensorInfo& zInfo = info_z.tensors[0];
    for (int64_t i = 0; i < zInfo.numDims; ++i) {
        total *= zInfo.shape[i];
    }
    if (total <= 0) {
        return;
    }

    uint32_t numTiles = static_cast<uint32_t>((total + TILE_LENGTH - 1) / TILE_LENGTH);
    uint32_t blockNum = static_cast<uint32_t>(availableCoreNum < (int64_t)numTiles ? availableCoreNum : (int64_t)numTiles);
    if (blockNum == 0) {
        blockNum = 1;
    }
    uint32_t tilesPerCore = (numTiles + blockNum - 1) / blockNum;

    SubTilingData tiling;
    tiling.blockNum = blockNum;
    tiling.numPerCore = tilesPerCore * TILE_LENGTH;
    tiling.tailNumLastCore = static_cast<uint32_t>(total) - tiling.numPerCore * (blockNum - 1);

    void* tilingDevice = nullptr;
    if (aclrtMalloc(&tilingDevice, sizeof(SubTilingData), ACL_MEM_MALLOC_HUGE_FIRST) != 0) {
        return;
    }
    aclrtMemcpy(tilingDevice, sizeof(SubTilingData), &tiling, sizeof(SubTilingData), ACL_MEMCPY_HOST_TO_DEVICE);

    if (dtype == 0) {
        sub_custom_fp32<<<blockNum, nullptr, stream>>>(x, y, z, (GM_ADDR)tilingDevice);
    } else {
        sub_custom_fp16<<<blockNum, nullptr, stream>>>(x, y, z, (GM_ADDR)tilingDevice);
    }

    aclrtSynchronizeStream(stream);
    aclrtFree(tilingDevice);
}
