#include "kernel_operator.h"

  using namespace AscendC;

  namespace {
  // Three UB queues of kTileElems each: 3 * 4096 * 4B = 48 KB, well inside the
  // 192 KB UB of the target Ascend 910B series SoC.
  constexpr int32_t kTileElems = 4096;

  template <typename T>
  class SubKernel {
  public:
      __aicore__ inline void Init(GM_ADDR x, GM_ADDR y, GM_ADDR z, int64_t total)
      {
          total_ = total;
          xGm_.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(x), total);
          yGm_.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(y), total);
          zGm_.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(z), total);

          pipe_.InitBuffer(xQue_, 1, kTileElems * sizeof(T));
          pipe_.InitBuffer(yQue_, 1, kTileElems * sizeof(T));
          pipe_.InitBuffer(zQue_, 1, kTileElems * sizeof(T));
      }

      __aicore__ inline void Process()
      {
          const int64_t numTiles = (total_ + kTileElems - 1) / kTileElems;
          const int64_t blockIdx = GetBlockIdx();
          const int64_t blockNum = GetBlockNum();

          for (int64_t tile = blockIdx; tile < numTiles; tile += blockNum) {
              const int64_t offset = tile * kTileElems;
              int64_t count = total_ - offset;
              if (count > kTileElems) {
                  count = kTileElems;
              }
              CopyIn(offset, count);
              Compute(count);
              CopyOut(offset, count);
          }
      }

  private:
      __aicore__ inline void CopyIn(int64_t offset, int64_t count)
      {
          DataCopyExtParams copyParams{1, static_cast<uint32_t>(count * sizeof(T)), 0, 0, 0};
          DataCopyPadExtParams<T> padParams{false, 0, 0, 0};
          LocalTensor<T> xLocal = xQue_.AllocTensor<T>();
          LocalTensor<T> yLocal = yQue_.AllocTensor<T>();
          DataCopyPad(xLocal, xGm_[offset], copyParams, padParams);
          DataCopyPad(yLocal, yGm_[offset], copyParams, padParams);
          xQue_.EnQue(xLocal);
          yQue_.EnQue(yLocal);
      }

      __aicore__ inline void Compute(int64_t count)
      {
          LocalTensor<T> xLocal = xQue_.DeQue<T>();
          LocalTensor<T> yLocal = yQue_.DeQue<T>();
          LocalTensor<T> zLocal = zQue_.AllocTensor<T>();
          Sub(zLocal, xLocal, yLocal, static_cast<int32_t>(count));
          zQue_.EnQue(zLocal);
          xQue_.FreeTensor(xLocal);
          yQue_.FreeTensor(yLocal);
      }

      __aicore__ inline void CopyOut(int64_t offset, int64_t count)
      {
          DataCopyExtParams copyParams{1, static_cast<uint32_t>(count * sizeof(T)), 0, 0, 0};
          LocalTensor<T> zLocal = zQue_.DeQue<T>();
          DataCopyPad(zGm_[offset], zLocal, copyParams);
          zQue_.FreeTensor(zLocal);
      }

      TPipe pipe_;
      TQue<QuePosition::VECIN, 1> xQue_;
      TQue<QuePosition::VECIN, 1> yQue_;
      TQue<QuePosition::VECOUT, 1> zQue_;
      GlobalTensor<T> xGm_;
      GlobalTensor<T> yGm_;
      GlobalTensor<T> zGm_;
      int64_t total_ = 0;
  };
  }  // namespace

  // dtype: 0=float32, 1=float16
  __global__ __vector__ void sub_custom(GM_ADDR x, GM_ADDR y, GM_ADDR z, int64_t total, int32_t dtype)
  {
      if (dtype == 0) {
          SubKernel<float> op;
          op.Init(x, y, z, total);
          op.Process();
      } else {
          SubKernel<half> op;
          op.Init(x, y, z, total);
          op.Process();
      }
  }
  
  extern "C" void run_kernel(GM_ADDR x, const TensorGroupInfo& info_x, GM_ADDR y, const TensorGroupInfo& info_y, GM_ADDR z, const TensorGroupInfo& info_z, int64_t availableCoreNum, aclrtStream stream)
  {
      const TensorInfo& tx = info_x.tensors[0];
      int64_t total = 1;
      for (int64_t i = 0; i < tx.numDims; ++i) {
          total *= tx.shape[i];
      }

      const int64_t numTiles = (total + kTileElems - 1) / kTileElems;
      int64_t blockNum = numTiles < availableCoreNum ? numTiles : availableCoreNum;
      if (blockNum < 1) {
          blockNum = 1;
      }

      sub_custom<<<static_cast<uint32_t>(blockNum), nullptr, stream>>>(x, y, z, total, tx.dtype);
  }