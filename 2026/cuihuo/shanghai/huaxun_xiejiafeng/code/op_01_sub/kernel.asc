#include "kernel_operator.h"

  /*
   * Element-wise Sub kernel: z = x - y
   * Shape: (8, 2048) ND, total 16384 elements.
   * Supported dtypes: float32 (TensorInfo.dtype == 0) and float16 (dtype == 1).
   *
   * Ascend C direct invocation: run_kernel dispatches on the runtime dtype and
   * launches the matching specialized vector kernel.
   */

  constexpr uint32_t SUB_TILE_ELEMS = 4096;
  constexpr uint32_t SUB_QUEUE_DEPTH = 2;

  template <typename T>
  class KernelSub {
  public:
      __aicore__ inline explicit KernelSub(AscendC::TPipe* pipe) : pipe_(pipe) {}

      __aicore__ inline void Init(GM_ADDR x, GM_ADDR y, GM_ADDR z,
                                  uint64_t totalElems, uint32_t blockNum)
      {
          totalElems_ = totalElems;

          uint32_t blockIdx = static_cast<uint32_t>(AscendC::GetBlockIdx());
          uint32_t totalTiles = static_cast<uint32_t>(
              (totalElems_ + SUB_TILE_ELEMS - 1) / SUB_TILE_ELEMS);
          uint32_t tilesPerBlock = (totalTiles + blockNum - 1) / blockNum;

          startTile_ = blockIdx * tilesPerBlock;
          endTile_ = startTile_ + tilesPerBlock;
          if (endTile_ > totalTiles) {
              endTile_ = totalTiles;
          }

          xGm_.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(x), totalElems_);
          yGm_.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(y), totalElems_);
          zGm_.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(z), totalElems_);

          pipe_->InitBuffer(inQueueX_, SUB_QUEUE_DEPTH, SUB_TILE_ELEMS * sizeof(T));
          pipe_->InitBuffer(inQueueY_, SUB_QUEUE_DEPTH, SUB_TILE_ELEMS * sizeof(T));
          pipe_->InitBuffer(outQueueZ_, SUB_QUEUE_DEPTH, SUB_TILE_ELEMS * sizeof(T));
      }

      __aicore__ inline void Process()
      {
          for (uint32_t tile = startTile_; tile < endTile_; ++tile) {
              uint64_t offset = static_cast<uint64_t>(tile) * SUB_TILE_ELEMS;
              uint32_t count = SUB_TILE_ELEMS;
              if (offset + count > totalElems_) {
                  count = static_cast<uint32_t>(totalElems_ - offset);
              }
              CopyIn(offset, count);
              Compute(count);
              CopyOut(offset, count);
          }
      }

  private:
      __aicore__ inline void CopyIn(uint64_t offset, uint32_t count)
      {
          AscendC::LocalTensor<T> xLocal = inQueueX_.template AllocTensor<T>();
          AscendC::LocalTensor<T> yLocal = inQueueY_.template AllocTensor<T>();

          AscendC::DataCopy(xLocal, xGm_[offset], count);
          AscendC::DataCopy(yLocal, yGm_[offset], count);

          inQueueX_.EnQue(xLocal);
          inQueueY_.EnQue(yLocal);
      }

      __aicore__ inline void Compute(uint32_t count)
      {
          AscendC::LocalTensor<T> xLocal = inQueueX_.template DeQue<T>();
          AscendC::LocalTensor<T> yLocal = inQueueY_.template DeQue<T>();
          AscendC::LocalTensor<T> zLocal = outQueueZ_.template AllocTensor<T>();

          AscendC::Sub(zLocal, xLocal, yLocal, count);

          outQueueZ_.EnQue(zLocal);
          inQueueX_.FreeTensor(xLocal);
          inQueueY_.FreeTensor(yLocal);
      }

      __aicore__ inline void CopyOut(uint64_t offset, uint32_t count)
      {
          AscendC::LocalTensor<T> zLocal = outQueueZ_.template DeQue<T>();
          AscendC::DataCopy(zGm_[offset], zLocal, count);
          outQueueZ_.FreeTensor(zLocal);
      }

      AscendC::TPipe* pipe_;
      AscendC::GlobalTensor<T> xGm_;
      AscendC::GlobalTensor<T> yGm_;
      AscendC::GlobalTensor<T> zGm_;
      AscendC::TQue<AscendC::TPosition::VECIN, SUB_QUEUE_DEPTH> inQueueX_;
      AscendC::TQue<AscendC::TPosition::VECIN, SUB_QUEUE_DEPTH> inQueueY_;
      AscendC::TQue<AscendC::TPosition::VECOUT, SUB_QUEUE_DEPTH> outQueueZ_;
      uint64_t totalElems_ = 0;
      uint32_t startTile_ = 0;
      uint32_t endTile_ = 0;
  };

  extern "C" __global__ __vector__ void sub_fp32_kernel(
      GM_ADDR x, GM_ADDR y, GM_ADDR z, uint64_t totalElems, uint32_t blockNum)
  {
      AscendC::TPipe pipe;
      KernelSub<float> op(&pipe);
      op.Init(x, y, z, totalElems, blockNum);
      op.Process();
  }

  extern "C" __global__ __vector__ void sub_fp16_kernel(
      GM_ADDR x, GM_ADDR y, GM_ADDR z, uint64_t totalElems, uint32_t blockNum)
  {
      AscendC::TPipe pipe;
      KernelSub<half> op(&pipe);
      op.Init(x, y, z, totalElems, blockNum);
      op.Process();
  }

  extern "C" void run_kernel(GM_ADDR x, const TensorGroupInfo& info_x,
                             GM_ADDR y, const TensorGroupInfo& info_y,
                             GM_ADDR z, const TensorGroupInfo& info_z,
                             int64_t availableCoreNum, aclrtStream stream)
  {
      if (info_x.numTensors < 1 || info_y.numTensors < 1 || info_z.numTensors < 1) {
          return;
      }

      const TensorInfo& tx = info_x.tensors[0];
      const TensorInfo& ty = info_y.tensors[0];
      const TensorInfo& tz = info_z.tensors[0];
      if (tx.dtype != ty.dtype || tx.dtype != tz.dtype || tx.numDims <= 0) {
          return;
      }

      int64_t totalElems = 1;
      for (int64_t dim = 0; dim < tx.numDims; ++dim) {
          if (tx.shape[dim] <= 0) {
              return;
          }
          totalElems *= tx.shape[dim];
      }
      if (totalElems <= 0) {
          return;
      }

      uint64_t total = static_cast<uint64_t>(totalElems);
      uint32_t tileCount = static_cast<uint32_t>((total + SUB_TILE_ELEMS - 1) / SUB_TILE_ELEMS);
      uint32_t coreLimit = (availableCoreNum > 0) ? static_cast<uint32_t>(availableCoreNum) : 1;
      uint32_t blockNum = (tileCount < coreLimit) ? tileCount : coreLimit;
      if (blockNum == 0) {
          return;
      }

      if (tx.dtype == 0) {
          sub_fp32_kernel<<<blockNum, nullptr, stream>>>(x, y, z, total, blockNum);
      } else if (tx.dtype == 1) {
          sub_fp16_kernel<<<blockNum, nullptr, stream>>>(x, y, z, total, blockNum);
      }
  }