#include <cmath>
#include "kernel_operator.h"
/*
 * Sub Kernel — Ascend C Direct Invocation
 * This file is #included — do NOT add main(), #pragma once, or include guards.
 *
 * TensorGroupInfo / TensorInfo (predefined):
 *   struct TensorInfo { const int64_t* shape; int64_t numDims; int32_t dtype; };
 *   struct TensorGroupInfo { const TensorInfo* tensors; int64_t numTensors; };
 *   dtype: 0=fp32 1=fp16 2=bf16 3=int8 4=int16 5=int32 6=int64 7=uint8 8=uint16 9=uint32 10=uint64 11=bool
 *   Usage: info_x.tensors[0].shape[0]  // first dim of first tensor in input x
 */

// ---------------------------------------------------------------------------
// Tiling constants
//   TILE_LENGTH: elements handled by one tile (2048 * sizeof(T); 8KB for fp32,
//                4KB for fp16).
//   BUFFER_NUM : TQue depth, 2 => double buffer (CopyIn/Compute/CopyOut overlap).
//   UB budget: 3 tensors (x, y, z) * BUFFER_NUM * TILE_LENGTH * sizeof(T)
//   = 48KB (fp32) / 24KB (fp16), statically within UB capacity.
// ---------------------------------------------------------------------------
namespace {
constexpr uint32_t TILE_LENGTH = 2048;
constexpr uint32_t BUFFER_NUM = 2;

// TensorInfo.dtype values understood by this operator.
constexpr int32_t DTYPE_FP32 = 0;
constexpr int32_t DTYPE_FP16 = 1;
}  // namespace

// T is the element type of the x/y/z buffers: float (fp32) or half (fp16).
template <typename T>
class KernelSub {
public:
    __aicore__ inline KernelSub() {}

    __aicore__ inline void Init(GM_ADDR x, GM_ADDR y, GM_ADDR z, uint32_t totalLength)
    {
        totalLength_ = totalLength;
        blockIdx_ = AscendC::GetBlockIdx();
        blockNum_ = AscendC::GetBlockNum();

        xGm_.SetGlobalBuffer(reinterpret_cast<__gm__ T *>(x), totalLength_);
        yGm_.SetGlobalBuffer(reinterpret_cast<__gm__ T *>(y), totalLength_);
        zGm_.SetGlobalBuffer(reinterpret_cast<__gm__ T *>(z), totalLength_);

        pipe_.InitBuffer(inQueueX_, BUFFER_NUM, TILE_LENGTH * sizeof(T));
        pipe_.InitBuffer(inQueueY_, BUFFER_NUM, TILE_LENGTH * sizeof(T));
        pipe_.InitBuffer(outQueueZ_, BUFFER_NUM, TILE_LENGTH * sizeof(T));
    }

    __aicore__ inline void Process()
    {
        uint32_t tileCount = (totalLength_ + TILE_LENGTH - 1) / TILE_LENGTH;
        // Multi-core split: tiles are interleaved round-robin across the AI cores.
        for (uint32_t tile = blockIdx_; tile < tileCount; tile += blockNum_) {
            uint32_t offset = tile * TILE_LENGTH;
            uint32_t count = totalLength_ - offset;
            if (count > TILE_LENGTH) {
                count = TILE_LENGTH;
            }
            CopyIn(offset, count);
            Compute(count);
            CopyOut(offset, count);
        }
    }

private:
    __aicore__ inline void CopyIn(uint32_t offset, uint32_t count)
    {
        AscendC::LocalTensor<T> xLocal = inQueueX_.AllocTensor<T>();
        AscendC::LocalTensor<T> yLocal = inQueueY_.AllocTensor<T>();

        if (count == TILE_LENGTH) {
            // Full tile: 32B-aligned on both GM and UB, plain DataCopy is enough.
            AscendC::DataCopy(xLocal, xGm_[offset], TILE_LENGTH);
            AscendC::DataCopy(yLocal, yGm_[offset], TILE_LENGTH);
        } else {
            // Tail tile: byte length may not be 32B aligned, DataCopyPad handles it.
            AscendC::DataCopyExtParams copyParams{1, count * static_cast<uint32_t>(sizeof(T)), 0, 0, 0};
            AscendC::DataCopyPadExtParams<T> padParams{false, 0, 0, static_cast<T>(0)};
            AscendC::DataCopyPad(xLocal, xGm_[offset], copyParams, padParams);
            AscendC::DataCopyPad(yLocal, yGm_[offset], copyParams, padParams);
        }

        inQueueX_.EnQue(xLocal);
        inQueueY_.EnQue(yLocal);
    }

    __aicore__ inline void Compute(uint32_t count)
    {
        AscendC::LocalTensor<T> xLocal = inQueueX_.DeQue<T>();
        AscendC::LocalTensor<T> yLocal = inQueueY_.DeQue<T>();
        AscendC::LocalTensor<T> zLocal = outQueueZ_.AllocTensor<T>();

        AscendC::Sub(zLocal, xLocal, yLocal, static_cast<int32_t>(count));

        outQueueZ_.EnQue<T>(zLocal);
        inQueueX_.FreeTensor(xLocal);
        inQueueY_.FreeTensor(yLocal);
    }

    __aicore__ inline void CopyOut(uint32_t offset, uint32_t count)
    {
        AscendC::LocalTensor<T> zLocal = outQueueZ_.DeQue<T>();

        if (count == TILE_LENGTH) {
            AscendC::DataCopy(zGm_[offset], zLocal, TILE_LENGTH);
        } else {
            AscendC::DataCopyExtParams copyParams{1, count * static_cast<uint32_t>(sizeof(T)), 0, 0, 0};
            AscendC::DataCopyPad(zGm_[offset], zLocal, copyParams);
        }

        outQueueZ_.FreeTensor(zLocal);
    }

    AscendC::TPipe pipe_;
    AscendC::GlobalTensor<T> xGm_;
    AscendC::GlobalTensor<T> yGm_;
    AscendC::GlobalTensor<T> zGm_;
    AscendC::TQue<AscendC::TPosition::VECIN, BUFFER_NUM> inQueueX_;
    AscendC::TQue<AscendC::TPosition::VECIN, BUFFER_NUM> inQueueY_;
    AscendC::TQue<AscendC::TPosition::VECOUT, BUFFER_NUM> outQueueZ_;
    uint32_t totalLength_ = 0;
    uint32_t blockIdx_ = 0;
    uint32_t blockNum_ = 1;
};

// Vector kernel entry for fp32. Launched from run_kernel() with
// blockNum = min(tileCount, availableCoreNum).
extern "C" __global__ __vector__ void sub_custom_fp32(GM_ADDR x, GM_ADDR y, GM_ADDR z, uint32_t totalLength)
{
    KernelSub<float> op;
    op.Init(x, y, z, totalLength);
    op.Process();
}

// Vector kernel entry for fp16.
extern "C" __global__ __vector__ void sub_custom_fp16(GM_ADDR x, GM_ADDR y, GM_ADDR z, uint32_t totalLength)
{
    KernelSub<half> op;
    op.Init(x, y, z, totalLength);
    op.Process();
}

extern "C" void run_kernel(GM_ADDR x, const TensorGroupInfo& info_x, GM_ADDR y, const TensorGroupInfo& info_y, GM_ADDR z, const TensorGroupInfo& info_z, int64_t availableCoreNum, aclrtStream stream)
{
    // Total element count = product of the first input tensor's shape dims.
    // numDims == 0 is a scalar: the product loop starts at 1, so it naturally
    // yields totalLength == 1, which must still be computed.
    if (info_x.numTensors < 1) {
        return;
    }
    const TensorInfo& xInfo = info_x.tensors[0];
    uint64_t totalLength = 1;
    for (int64_t i = 0; i < xInfo.numDims; ++i) {
        totalLength *= static_cast<uint64_t>(xInfo.shape[i]);
    }
    if (totalLength == 0 || totalLength > 0xFFFFFFFFULL) {
        return;
    }

    // Dispatch on the input dtype (z is assumed to share x's dtype).
    // Unsupported dtypes are returned without launching a kernel.
    const int32_t dtype = xInfo.dtype;
    if (dtype != DTYPE_FP32 && dtype != DTYPE_FP16) {
        return;
    }
    // UB budget is statically known: 3 tensors * BUFFER_NUM * TILE_LENGTH *
    // sizeof(T) = 48KB (fp32) / 24KB (fp16), well within any UB. No runtime
    // query is performed.
    uint32_t tileCount = static_cast<uint32_t>((totalLength + TILE_LENGTH - 1) / TILE_LENGTH);
    int64_t cores = availableCoreNum > 0 ? availableCoreNum : 1;
    uint32_t blockNum = tileCount;
    if (static_cast<uint64_t>(cores) < static_cast<uint64_t>(tileCount)) {
        blockNum = static_cast<uint32_t>(cores);
    }
    if (blockNum == 0) {
        blockNum = 1;
    }

    const uint32_t launchLength = static_cast<uint32_t>(totalLength);
    if (dtype == DTYPE_FP32) {
        sub_custom_fp32<<<blockNum, nullptr, stream>>>(x, y, z, launchLength);
    } else {
        sub_custom_fp16<<<blockNum, nullptr, stream>>>(x, y, z, launchLength);
    }
}