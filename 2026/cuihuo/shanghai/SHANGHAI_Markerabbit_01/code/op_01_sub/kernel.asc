#include "kernel_operator.h"

/*
 * Sub Kernel — Ascend C Direct Invocation
 * z = x - y, element-wise, for float32 and float16.
 *
 * The tensor is split across vector cores. Each core copies its slice from GM
 * to UB in tiles of TILE_ELEMS, computes Sub, and copies the result back.
 */

using namespace AscendC;

namespace {
constexpr uint32_t TILE_ELEMS = 2048;
}

template <typename T>
__aicore__ inline void SubCompute(GM_ADDR x, GM_ADDR y, GM_ADDR z,
                                  uint32_t totalElems, uint32_t perBlockElems)
{
    TPipe pipe;
    TQue<TPosition::VECIN, 1> inQueueX;
    TQue<TPosition::VECIN, 1> inQueueY;
    TQue<TPosition::VECOUT, 1> outQueueZ;

    pipe.InitBuffer(inQueueX, 1, TILE_ELEMS * sizeof(T));
    pipe.InitBuffer(inQueueY, 1, TILE_ELEMS * sizeof(T));
    pipe.InitBuffer(outQueueZ, 1, TILE_ELEMS * sizeof(T));

    GlobalTensor<T> xGm;
    GlobalTensor<T> yGm;
    GlobalTensor<T> zGm;
    xGm.SetGlobalBuffer(reinterpret_cast<__gm__ T *>(x), totalElems);
    yGm.SetGlobalBuffer(reinterpret_cast<__gm__ T *>(y), totalElems);
    zGm.SetGlobalBuffer(reinterpret_cast<__gm__ T *>(z), totalElems);

    uint32_t start = static_cast<uint32_t>(GetBlockIdx()) * perBlockElems;
    if (start >= totalElems) {
        return;
    }
    uint32_t length = totalElems - start;
    if (length > perBlockElems) {
        length = perBlockElems;
    }

    for (uint32_t offset = 0; offset < length; offset += TILE_ELEMS) {
        uint32_t count = length - offset;
        if (count > TILE_ELEMS) {
            count = TILE_ELEMS;
        }

        LocalTensor<T> xLocal = inQueueX.AllocTensor<T>();
        LocalTensor<T> yLocal = inQueueY.AllocTensor<T>();
        LocalTensor<T> zLocal = outQueueZ.AllocTensor<T>();

        DataCopy(xLocal, xGm[start + offset], static_cast<int32_t>(count));
        DataCopy(yLocal, yGm[start + offset], static_cast<int32_t>(count));
        inQueueX.EnQue(xLocal);
        inQueueY.EnQue(yLocal);

        xLocal = inQueueX.DeQue<T>();
        yLocal = inQueueY.DeQue<T>();
        Sub(zLocal, xLocal, yLocal, static_cast<int32_t>(count));
        outQueueZ.EnQue<T>(zLocal);

        inQueueX.FreeTensor(xLocal);
        inQueueY.FreeTensor(yLocal);

        zLocal = outQueueZ.DeQue<T>();
        DataCopy(zGm[start + offset], zLocal, static_cast<int32_t>(count));
        outQueueZ.FreeTensor(zLocal);
    }
}

__global__ __vector__ void sub_custom_fp32(GM_ADDR x, GM_ADDR y, GM_ADDR z,
                                           uint32_t totalElems, uint32_t perBlockElems)
{
    SubCompute<float>(x, y, z, totalElems, perBlockElems);
}

__global__ __vector__ void sub_custom_fp16(GM_ADDR x, GM_ADDR y, GM_ADDR z,
                                           uint32_t totalElems, uint32_t perBlockElems)
{
    SubCompute<half>(x, y, z, totalElems, perBlockElems);
}

extern "C" void run_kernel(GM_ADDR x, const TensorGroupInfo &info_x, GM_ADDR y, const TensorGroupInfo &info_y,
                           GM_ADDR z, const TensorGroupInfo &info_z, int64_t availableCoreNum, aclrtStream stream)
{
    const TensorInfo &tensorInfo = info_x.tensors[0];
    uint32_t totalElems = 1;
    for (int64_t i = 0; i < tensorInfo.numDims; ++i) {
        totalElems *= static_cast<uint32_t>(tensorInfo.shape[i]);
    }

    uint32_t blockNum = 1;
    if (totalElems % TILE_ELEMS == 0 && availableCoreNum >= 8) {
        blockNum = 8;
    }
    uint32_t perBlockElems = totalElems / blockNum;

    if (tensorInfo.dtype == 0) {
        sub_custom_fp32<<<blockNum, nullptr, stream>>>(x, y, z, totalElems, perBlockElems);
    } else if (tensorInfo.dtype == 1) {
        sub_custom_fp16<<<blockNum, nullptr, stream>>>(x, y, z, totalElems, perBlockElems);
    }
}
