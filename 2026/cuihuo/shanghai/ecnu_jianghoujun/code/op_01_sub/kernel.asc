
#include <cmath>
#include "kernel_operator.h"

// 输入输出形状：(8, 2048)
constexpr uint32_t ROW_NUM = 8;
constexpr uint32_t COL_NUM = 2048;
constexpr uint32_t TOTAL_LENGTH = ROW_NUM * COL_NUM;
constexpr uint32_t BUFFER_NUM = 1;

// 通用减法 Kernel，支持 float 和 half
template <typename T>
class KernelSub {
public:
    __aicore__ inline KernelSub() {}

    __aicore__ inline void Init(
        GM_ADDR x, GM_ADDR y, GM_ADDR z)
    {
        // 初始化 Global Memory
        xGm.SetGlobalBuffer(
            (__gm__ T*)x, TOTAL_LENGTH);
        yGm.SetGlobalBuffer(
            (__gm__ T*)y, TOTAL_LENGTH);
        zGm.SetGlobalBuffer(
            (__gm__ T*)z, TOTAL_LENGTH);

        // 为每个输入输出分配 UB 空间
        pipe.InitBuffer(
            inQueueX, BUFFER_NUM,
            COL_NUM * sizeof(T));
        pipe.InitBuffer(
            inQueueY, BUFFER_NUM,
            COL_NUM * sizeof(T));
        pipe.InitBuffer(
            outQueueZ, BUFFER_NUM,
            COL_NUM * sizeof(T));
    }

    __aicore__ inline void Process(uint32_t blockNum)
    {
        // 不同核处理不同的行
        uint32_t blockIdx =
            (uint32_t)AscendC::GetBlockIdx();

        for (uint32_t row = blockIdx;
             row < ROW_NUM;
             row += blockNum) {

            uint32_t offset = row * COL_NUM;

            CopyIn(offset);
            Compute();
            CopyOut(offset);
        }
    }

private:
    __aicore__ inline void CopyIn(uint32_t offset)
    {
        // 申请输入 LocalTensor
        AscendC::LocalTensor<T> xLocal =
            inQueueX.AllocTensor<T>();
        AscendC::LocalTensor<T> yLocal =
            inQueueY.AllocTensor<T>();

        // GM -> UB
        AscendC::DataCopy(
            xLocal, xGm[offset], COL_NUM);
        AscendC::DataCopy(
            yLocal, yGm[offset], COL_NUM);

        // 输入数据入队
        inQueueX.EnQue(xLocal);
        inQueueY.EnQue(yLocal);
    }

    __aicore__ inline void Compute()
    {
        // 输入数据出队
        AscendC::LocalTensor<T> xLocal =
            inQueueX.DeQue<T>();
        AscendC::LocalTensor<T> yLocal =
            inQueueY.DeQue<T>();

        // 申请输出 LocalTensor
        AscendC::LocalTensor<T> zLocal =
            outQueueZ.AllocTensor<T>();

        // 核心计算：z = x - y
        AscendC::Sub(
            zLocal, xLocal, yLocal, COL_NUM);

        // 输出数据入队
        outQueueZ.EnQue(zLocal);

        // 释放输入 UB
        inQueueX.FreeTensor(xLocal);
        inQueueY.FreeTensor(yLocal);
    }

    __aicore__ inline void CopyOut(uint32_t offset)
    {
        // 输出数据出队
        AscendC::LocalTensor<T> zLocal =
            outQueueZ.DeQue<T>();

        // UB -> GM
        AscendC::DataCopy(
            zGm[offset], zLocal, COL_NUM);

        // 释放输出 UB
        outQueueZ.FreeTensor(zLocal);
    }

private:
    AscendC::TPipe pipe;

    AscendC::TQue<
        AscendC::TPosition::VECIN,
        BUFFER_NUM> inQueueX, inQueueY;

    AscendC::TQue<
        AscendC::TPosition::VECOUT,
        BUFFER_NUM> outQueueZ;

    AscendC::GlobalTensor<T> xGm;
    AscendC::GlobalTensor<T> yGm;
    AscendC::GlobalTensor<T> zGm;
};

// float32 Kernel
extern "C" __global__ __vector__
void sub_custom_fp32(
    GM_ADDR x, GM_ADDR y, GM_ADDR z,
    uint32_t blockNum)
{
    KernelSub<float> op;
    op.Init(x, y, z);
    op.Process(blockNum);
}

// float16 Kernel
extern "C" __global__ __vector__
void sub_custom_fp16(
    GM_ADDR x, GM_ADDR y, GM_ADDR z,
    uint32_t blockNum)
{
    KernelSub<half> op;
    op.Init(x, y, z);
    op.Process(blockNum);
}

// Host 侧算子启动入口
extern "C" void run_kernel(
    GM_ADDR x,
    const TensorGroupInfo& info_x,
    GM_ADDR y,
    const TensorGroupInfo& info_y,
    GM_ADDR z,
    const TensorGroupInfo& info_z,
    int64_t availableCoreNum,
    aclrtStream stream)
{
    if (availableCoreNum <= 0 ||
        info_x.numTensors < 1 ||
        info_y.numTensors < 1 ||
        info_z.numTensors < 1 ||
        info_x.tensors == nullptr ||
        info_y.tensors == nullptr ||
        info_z.tensors == nullptr) {
        return;
    }

    const TensorInfo& tx = info_x.tensors[0];
    const TensorInfo& ty = info_y.tensors[0];
    const TensorInfo& tz = info_z.tensors[0];

    // 验证数据类型一致
    if (tx.dtype != ty.dtype ||
        tx.dtype != tz.dtype) {
        return;
    }

    // 验证形状为 (8, 2048)
    if (tx.numDims != 2 ||
        ty.numDims != 2 ||
        tz.numDims != 2 ||
        tx.shape == nullptr ||
        ty.shape == nullptr ||
        tz.shape == nullptr) {
        return;
    }

    if (tx.shape[0] != ROW_NUM ||
        tx.shape[1] != COL_NUM ||
        ty.shape[0] != ROW_NUM ||
        ty.shape[1] != COL_NUM ||
        tz.shape[0] != ROW_NUM ||
        tz.shape[1] != COL_NUM) {
        return;
    }

    // 最多启动 8 个 Vector 核
    uint32_t blockNum =
        availableCoreNum < ROW_NUM
            ? static_cast<uint32_t>(availableCoreNum)
            : ROW_NUM;

    // dtype: 0=fp32, 1=fp16
    if (tx.dtype == 0) {
        sub_custom_fp32<<<blockNum, nullptr, stream>>>(
            x, y, z, blockNum);
    } else if (tx.dtype == 1) {
        sub_custom_fp16<<<blockNum, nullptr, stream>>>(
            x, y, z, blockNum);
    }
}
