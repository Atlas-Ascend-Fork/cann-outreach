
#include <stdint.h>
#include "kernel_operator.h"

using namespace AscendC;

constexpr uint32_t TILE_LENGTH = 2048;

// ============================================================
// Device Kernel: z[i] = x[i] - y[i]
// 支持 float32 和 float16
// ============================================================
template <typename T>
__global__ __aicore__ void sub_custom(
    GM_ADDR x,
    GM_ADDR y,
    GM_ADDR z,
    uint32_t totalLength,
    uint32_t blockNum)
{
    if (totalLength == 0 || blockNum == 0) {
        return;
    }

    TPipe pipe;

    TQue<QuePosition::VECIN, 1> inQueueX;
    TQue<QuePosition::VECIN, 1> inQueueY;
    TQue<QuePosition::VECOUT, 1> outQueueZ;

    constexpr uint32_t BUFFER_BYTES =
        TILE_LENGTH * sizeof(T);

    pipe.InitBuffer(inQueueX, 1, BUFFER_BYTES);
    pipe.InitBuffer(inQueueY, 1, BUFFER_BYTES);
    pipe.InitBuffer(outQueueZ, 1, BUFFER_BYTES);

    GlobalTensor<T> xGm;
    GlobalTensor<T> yGm;
    GlobalTensor<T> zGm;

    xGm.SetGlobalBuffer(
        reinterpret_cast<__gm__ T*>(x), totalLength);
    yGm.SetGlobalBuffer(
        reinterpret_cast<__gm__ T*>(y), totalLength);
    zGm.SetGlobalBuffer(
        reinterpret_cast<__gm__ T*>(z), totalLength);

    const uint32_t blockIdx = GetBlockIdx();
    const uint32_t tileCount =
        (totalLength + TILE_LENGTH - 1) / TILE_LENGTH;

    // 每个核按轮转方式领取 Tile
    for (uint32_t tileIndex = blockIdx;
         tileIndex < tileCount;
         tileIndex += blockNum)
    {
        const uint32_t offset = tileIndex * TILE_LENGTH;
        const uint32_t remain = totalLength - offset;
        const uint32_t validLength =
            (remain < TILE_LENGTH) ? remain : TILE_LENGTH;

        LocalTensor<T> xLocal = inQueueX.AllocTensor<T>();
        LocalTensor<T> yLocal = inQueueY.AllocTensor<T>();

        // 将有效字节数搬入 UB。
        // 注意：需确认当前 CANN 版本支持此 DataCopyPad 重载。
        DataCopyPad(
            xLocal,
            xGm[offset],
            {1, validLength * static_cast<uint32_t>(sizeof(T)),
             0, 0, 0},
            {false, 0, 0, 0});

        DataCopyPad(
            yLocal,
            yGm[offset],
            {1, validLength * static_cast<uint32_t>(sizeof(T)),
             0, 0, 0},
            {false, 0, 0, 0});

        inQueueX.EnQue(xLocal);
        inQueueY.EnQue(yLocal);

        xLocal = inQueueX.DeQue<T>();
        yLocal = inQueueY.DeQue<T>();

        LocalTensor<T> zLocal = outQueueZ.AllocTensor<T>();

        Sub(zLocal, xLocal, yLocal, validLength);

        outQueueZ.EnQue(zLocal);

        inQueueX.FreeTensor(xLocal);
        inQueueY.FreeTensor(yLocal);

        zLocal = outQueueZ.DeQue<T>();

        // 只写回有效字节，不覆盖输出张量边界之外的内存。
        DataCopyPad(
            zGm[offset],
            zLocal,
            {1, validLength * static_cast<uint32_t>(sizeof(T)),
             0, 0, 0});

        outQueueZ.FreeTensor(zLocal);
    }
}

// ============================================================
// Host Entry: 必须与 judge.asc 中的调用签名一致
// ============================================================
extern "C" void run_kernel(
    GM_ADDR x,
    const TensorGroupInfo& info_x,
    GM_ADDR y,
    const TensorGroupInfo& info_y,
    GM_ADDR z,
    const TensorGroupInfo& info_z,
    int32_t availableCoreNum,
    aclrtStream stream)
{
    // 防止非法核数
    if (availableCoreNum <= 0) {
        return;
    }

    // 以下按原评测代码中的二维张量约定计算。
    // 若输入可能为高维张量，应改为所有维度的乘积。
    const uint32_t dim0 = info_x.tensors[0].shape[0];
    const uint32_t dim1 = info_x.tensors[0].shape[1];
    const uint32_t totalLength = dim0 * dim1;

    if (totalLength == 0) {
        return;
    }

    // 输入输出应具有相同形状和类型。
    // 这里暂按原代码的 dtype 字段分发。
    const int32_t dtype = info_x.tensors[0].dtype;

    uint32_t blockNum =
        static_cast<uint32_t>(availableCoreNum);

    const uint32_t tileCount =
        (totalLength + TILE_LENGTH - 1) / TILE_LENGTH;

    if (blockNum > tileCount) {
        blockNum = tileCount;
    }

    if (blockNum == 0) {
        return;
    }

    // 注意：dtype == 0 / 1 必须与实际框架的枚举定义一致。
    if (dtype == 0) {
        sub_custom<float><<<blockNum, nullptr, stream>>>(
            x, y, z, totalLength, blockNum);
    } else if (dtype == 1) {
        sub_custom<half><<<blockNum, nullptr, stream>>>(
            x, y, z, totalLength, blockNum);
    }
}