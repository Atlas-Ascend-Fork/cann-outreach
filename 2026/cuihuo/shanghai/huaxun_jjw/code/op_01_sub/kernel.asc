#include <cmath>
#include "kernel_operator.h"
/*
 * Sub Kernel — Ascend C Direct Invocation
 * This file is #included — do NOT add main(), #pragma once, or include guards.
 *
 * TensorGroupInfo / TensorInfo (predefined):
 *   struct TensorInfo { const int64_t* shape; int64_t numDims; int32_t dtype; };
 *   struct TensorGroupInfo { const TensorInfo* tensors; int64_t numTensors; };
 *   dtype: 0=fp32 1=fp16 2=bf16 3=int8 4=int16 5=int32 6=int64 7=uint8 8=uint16 9=uint32 10=uint64 11=bool
 *   Usage: info_x.tensors[0].shape[0]  // first dim of first tensor in input x
 *
 * 实现说明（element-wise: z = x - y）:
 *   1. 总元素数由运行期 shape 计算，不写死 shape，任意维度/任意长度均可。
 *   2. 按 32B（一个 block）为单位把数据切分给各 vector core，保证每次
 *      DataCopy 的搬运长度都是 32B 的整数倍（GM/UB 搬运的对齐要求）。
 *   3. 主体走 DataCopy -> Sub -> DataCopy 的 tile 循环，TQue 双缓冲。
 *   4. 尾部不足一个 block 的零头由最后一个 core 补齐：
 *        - 4 字节类型（fp32）：标量单元可直接做减法，逐元素算；
 *        - half 等类型：AI Core 标量单元不支持 half 算术，改用 Vector 指令
 *          整 block 计算后再逐元素搬回 GM（见 DoTail 的两个重载）。
 */

using namespace AscendC;

namespace {
constexpr int32_t kBlockBytes = 32;         // 一个 block 的字节数（搬运对齐粒度）
constexpr int32_t kTileBytes = 16 * 1024;   // 每个 UB buffer 的大小（16KB）
constexpr int32_t kBufferNum = 2;           // 双缓冲

// 编译期分派用 tag：区分"标量单元能否直接做该 dtype 的算术"
template <bool kScalarArith>
struct TailTag {};
}  // namespace

template <typename T>
class SubKernel {
public:
    __aicore__ inline SubKernel() {}

    __aicore__ inline void Init(GM_ADDR x, GM_ADDR y, GM_ADDR z,
                                int64_t totalLength, int32_t alignElems,
                                int32_t tileLength, int32_t blockNum)
    {
        xGm_.SetGlobalBuffer((__gm__ T *)x, totalLength);
        yGm_.SetGlobalBuffer((__gm__ T *)y, totalLength);
        zGm_.SetGlobalBuffer((__gm__ T *)z, totalLength);

        const uint32_t bufBytes = static_cast<uint32_t>(tileLength) * static_cast<uint32_t>(sizeof(T));
        pipe_.InitBuffer(inQueX_, kBufferNum, bufBytes);
        pipe_.InitBuffer(inQueY_, kBufferNum, bufBytes);
        pipe_.InitBuffer(outQueZ_, kBufferNum, bufBytes);

        tileLength_ = tileLength;
        alignElems_ = alignElems;

        // 以 32B block 为单位做多核切分，保证每个 core 的起始偏移与长度都对齐
        const int64_t blockIdx = static_cast<int64_t>(GetBlockIdx());
        const int64_t totalBlocks = totalLength / alignElems;
        int64_t blocksPerCore = (totalBlocks + blockNum - 1) / blockNum;
        if (blocksPerCore < 1) {
            blocksPerCore = 1;
        }
        const int64_t startBlock = blockIdx * blocksPerCore;
        int64_t myBlocks = totalBlocks - startBlock;
        if (myBlocks > blocksPerCore) {
            myBlocks = blocksPerCore;
        }
        if (myBlocks < 0) {
            myBlocks = 0;
        }

        gmOffset_ = startBlock * alignElems;
        length_ = myBlocks * alignElems;

        // 尾部不足一个 block 的零头交给最后一个 core 处理
        tailOffset_ = totalBlocks * alignElems;
        tailLength_ = (blockIdx == static_cast<int64_t>(blockNum) - 1) ? (totalLength - tailOffset_) : 0;
        if (tailLength_ < 0) {
            tailLength_ = 0;
        }
    }

    __aicore__ inline void Process()
    {
        int64_t done = 0;
        while (done < length_) {
            const int64_t remain = length_ - done;
            const int64_t cur = (remain < static_cast<int64_t>(tileLength_)) ? remain : static_cast<int64_t>(tileLength_);
            ComputeTile(gmOffset_ + done, static_cast<int32_t>(cur));
            done += cur;
        }

        if (tailLength_ > 0) {
            // sizeof(T) == 4（fp32 等）走标量重载，其余（fp16）走 Vector 重载；
            // 未被选中的那个重载不会被实例化，因此 half 不会触发标量算术检查。
            DoTail(TailTag<(sizeof(T) == 4)>{});
        }
    }

private:
    __aicore__ inline void ComputeTile(int64_t gmOffset, int32_t count)
    {
        const uint32_t calCount = static_cast<uint32_t>(count);

        LocalTensor<T> xLocal = inQueX_.AllocTensor<T>();
        LocalTensor<T> yLocal = inQueY_.AllocTensor<T>();
        DataCopy(xLocal, xGm_[gmOffset], calCount);
        DataCopy(yLocal, yGm_[gmOffset], calCount);
        inQueX_.EnQue(xLocal);
        inQueY_.EnQue(yLocal);

        LocalTensor<T> xIn = inQueX_.DeQue<T>();
        LocalTensor<T> yIn = inQueY_.DeQue<T>();
        LocalTensor<T> zLocal = outQueZ_.AllocTensor<T>();
        Sub(zLocal, xIn, yIn, count);
        outQueZ_.EnQue<T>(zLocal);
        inQueX_.FreeTensor(xIn);
        inQueY_.FreeTensor(yIn);

        LocalTensor<T> zOut = outQueZ_.DeQue<T>();
        DataCopy(zGm_[gmOffset], zOut, calCount);
        outQueZ_.FreeTensor(zOut);
    }

    // 4 字节类型：标量单元可直接做算术，逐元素从 GM 读改写
    __aicore__ inline void DoTail(TailTag<true>)
    {
        const int64_t end = tailOffset_ + tailLength_;
        for (int64_t i = tailOffset_; i < end; ++i) {
            zGm_.SetValue(i, xGm_.GetValue(i) - yGm_.GetValue(i));
        }
    }

    // half 等类型：标量单元不支持该 dtype 的算术运算，改为
    //   整 block 搬进 UB -> Vector Sub -> 逐元素标量搬回 GM。
    // block 起点 32B 对齐，长度固定为一个 block，因此末尾最多读到 tensor
    // 之后 <=31B 的 padding（只读不回写，GM 按页分配，不会影响其它数据）；
    // 回写只覆盖真实存在的 tailLength_ 个元素，不会越界写。
    __aicore__ inline void DoTail(TailTag<false>)
    {
        const uint32_t blockLen = static_cast<uint32_t>(alignElems_);

        LocalTensor<T> xLocal = inQueX_.AllocTensor<T>();
        LocalTensor<T> yLocal = inQueY_.AllocTensor<T>();
        DataCopy(xLocal, xGm_[tailOffset_], blockLen);
        DataCopy(yLocal, yGm_[tailOffset_], blockLen);
        inQueX_.EnQue(xLocal);
        inQueY_.EnQue(yLocal);

        LocalTensor<T> xIn = inQueX_.DeQue<T>();
        LocalTensor<T> yIn = inQueY_.DeQue<T>();
        LocalTensor<T> zLocal = outQueZ_.AllocTensor<T>();
        Sub(zLocal, xIn, yIn, static_cast<int32_t>(blockLen));
        inQueX_.FreeTensor(xIn);
        inQueY_.FreeTensor(yIn);

        // Vector 写 UB 之后标量读，需要 V_S 同步
        SetFlag<HardEvent::V_S>(EVENT_ID0);
        WaitFlag<HardEvent::V_S>(EVENT_ID0);
        for (int64_t i = 0; i < tailLength_; ++i) {
            zGm_.SetValue(tailOffset_ + i, zLocal.GetValue(static_cast<int32_t>(i)));
        }
        outQueZ_.FreeTensor(zLocal);
    }

    TPipe pipe_;
    TQue<TPosition::VECIN, kBufferNum> inQueX_;
    TQue<TPosition::VECIN, kBufferNum> inQueY_;
    TQue<TPosition::VECOUT, kBufferNum> outQueZ_;
    GlobalTensor<T> xGm_;
    GlobalTensor<T> yGm_;
    GlobalTensor<T> zGm_;
    int64_t gmOffset_ = 0;
    int64_t length_ = 0;
    int64_t tailOffset_ = 0;
    int64_t tailLength_ = 0;
    int32_t tileLength_ = 0;
    int32_t alignElems_ = 0;
};

// ---------------------------------------------------------------------------
// device kernels（每个 dtype 一个非模板入口，便于 <<<>>> 启动）
// ---------------------------------------------------------------------------
__global__ __vector__ void sub_custom(GM_ADDR x, GM_ADDR y, GM_ADDR z,
                                      int64_t totalLength, int32_t alignElems,
                                      int32_t tileLength, int32_t blockNum)
{
    SubKernel<float> op;
    op.Init(x, y, z, totalLength, alignElems, tileLength, blockNum);
    op.Process();
}

__global__ __vector__ void sub_custom_fp16(GM_ADDR x, GM_ADDR y, GM_ADDR z,
                                           int64_t totalLength, int32_t alignElems,
                                           int32_t tileLength, int32_t blockNum)
{
    SubKernel<half> op;
    op.Init(x, y, z, totalLength, alignElems, tileLength, blockNum);
    op.Process();
}

// ---------------------------------------------------------------------------
// host 侧启动
// ---------------------------------------------------------------------------
extern "C" void run_kernel(GM_ADDR x, const TensorGroupInfo& info_x, GM_ADDR y, const TensorGroupInfo& info_y, GM_ADDR z, const TensorGroupInfo& info_z, int64_t availableCoreNum, aclrtStream stream)
{
    if (info_x.numTensors < 1 || info_x.tensors == nullptr) {
        return;
    }

    const TensorInfo &ti = info_x.tensors[0];
    int64_t totalLength = 1;
    for (int64_t d = 0; d < ti.numDims; ++d) {
        totalLength *= ti.shape[d];
    }
    if (totalLength <= 0) {
        return;
    }

    // x / y / z 为同 shape 的 element-wise 运算，取最小长度以防越界
    if (info_y.numTensors >= 1 && info_y.tensors != nullptr) {
        int64_t ny = 1;
        for (int64_t d = 0; d < info_y.tensors[0].numDims; ++d) {
            ny *= info_y.tensors[0].shape[d];
        }
        if (ny < totalLength) {
            totalLength = ny;
        }
    }
    if (info_z.numTensors >= 1 && info_z.tensors != nullptr) {
        int64_t nz = 1;
        for (int64_t d = 0; d < info_z.tensors[0].numDims; ++d) {
            nz *= info_z.tensors[0].shape[d];
        }
        if (nz < totalLength) {
            totalLength = nz;
        }
    }
    if (totalLength <= 0) {
        return;
    }

    int64_t coreLimit = (availableCoreNum > 0) ? availableCoreNum : 1;
    if (coreLimit > 65535) {
        coreLimit = 65535;
    }

    const int32_t dtype = ti.dtype;
    const int32_t elemBytes = (dtype == 1) ? 2 : 4;       // fp16 -> 2B，其余按 fp32 处理
    const int32_t alignElems = kBlockBytes / elemBytes;   // 一个 block 容纳的元素个数
    const int32_t tileLength = kTileBytes / elemBytes;    // 每个 tile 的元素个数

    // block 数不超过实际可切分的 block 数，避免空核
    const int64_t totalBlocks = totalLength / alignElems;
    int64_t blockNum = coreLimit;
    if (totalBlocks > 0 && blockNum > totalBlocks) {
        blockNum = totalBlocks;
    }
    if (blockNum < 1) {
        blockNum = 1;
    }

    if (dtype == 1) {
        sub_custom_fp16<<<static_cast<uint32_t>(blockNum), nullptr, stream>>>(
            x, y, z, totalLength, alignElems, tileLength, static_cast<int32_t>(blockNum));
    } else {
        sub_custom<<<static_cast<uint32_t>(blockNum), nullptr, stream>>>(
            x, y, z, totalLength, alignElems, tileLength, static_cast<int32_t>(blockNum));
    }
}
