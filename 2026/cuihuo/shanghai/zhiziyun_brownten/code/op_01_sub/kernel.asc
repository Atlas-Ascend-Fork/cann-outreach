#include <cmath>
#include "kernel_operator.h"

template <typename T>
class KernelSubCustom {
public:
    __aicore__ inline void Init(GM_ADDR x, GM_ADDR y, GM_ADDR z)
    {
        // 本题固定形状为 (8, 2048)
        xGm.SetGlobalBuffer((__gm__ T *)x, 16384);
        yGm.SetGlobalBuffer((__gm__ T *)y, 16384);
        zGm.SetGlobalBuffer((__gm__ T *)z, 16384);

        // 每次处理 2048 个元素
        pipe.InitBuffer(xQueue, 1, 2048 * sizeof(T));
        pipe.InitBuffer(yQueue, 1, 2048 * sizeof(T));
        pipe.InitBuffer(zQueue, 1, 2048 * sizeof(T));
    }

    __aicore__ inline void Process()
    {
        // 共 8 块，按核心编号轮流分配。
        // 当可用核心少于 8 个时，一个核心处理多块。
        for (uint32_t tile = AscendC::GetBlockIdx();
             tile < 8;
             tile += AscendC::GetBlockNum()) {
            CopyIn(tile);
            Compute();
            CopyOut(tile);
        }
    }

private:
    __aicore__ inline void CopyIn(uint32_t tile)
    {
        AscendC::LocalTensor<T> xLocal = xQueue.AllocTensor<T>();
        AscendC::LocalTensor<T> yLocal = yQueue.AllocTensor<T>();

        uint32_t offset = tile * 2048;

        AscendC::DataCopy(xLocal, xGm[offset], 2048);
        AscendC::DataCopy(yLocal, yGm[offset], 2048);

        xQueue.EnQue(xLocal);
        yQueue.EnQue(yLocal);
    }

    __aicore__ inline void Compute()
    {
        AscendC::LocalTensor<T> xLocal = xQueue.DeQue<T>();
        AscendC::LocalTensor<T> yLocal = yQueue.DeQue<T>();
        AscendC::LocalTensor<T> zLocal = zQueue.AllocTensor<T>();

        // 注意输入顺序：x - y
        AscendC::Sub(zLocal, xLocal, yLocal, 2048);

        zQueue.EnQue(zLocal);

        xQueue.FreeTensor(xLocal);
        yQueue.FreeTensor(yLocal);
    }

    __aicore__ inline void CopyOut(uint32_t tile)
    {
        AscendC::LocalTensor<T> zLocal = zQueue.DeQue<T>();

        AscendC::DataCopy(zGm[tile * 2048], zLocal, 2048);

        zQueue.FreeTensor(zLocal);
    }

    AscendC::TPipe pipe;

    AscendC::TQue<AscendC::TPosition::VECIN, 1> xQueue;
    AscendC::TQue<AscendC::TPosition::VECIN, 1> yQueue;
    AscendC::TQue<AscendC::TPosition::VECOUT, 1> zQueue;

    AscendC::GlobalTensor<T> xGm;
    AscendC::GlobalTensor<T> yGm;
    AscendC::GlobalTensor<T> zGm;
};

template <typename T>
__global__ __vector__ void sub_custom(GM_ADDR x, GM_ADDR y, GM_ADDR z)
{
    KernelSubCustom<T> op;
    op.Init(x, y, z);
    op.Process();
}

extern "C" void run_kernel(
    GM_ADDR x, const TensorGroupInfo& info_x,
    GM_ADDR y, const TensorGroupInfo& info_y,
    GM_ADDR z, const TensorGroupInfo& info_z,
    int64_t availableCoreNum,
    aclrtStream stream)
{
    if (availableCoreNum <= 0) {
        return;
    }

    uint32_t blockNum =
        static_cast<uint32_t>(availableCoreNum < 8 ? availableCoreNum : 8);

    // dtype 来自题目模板：0 = fp32，1 = fp16
    if (info_x.tensors[0].dtype == 0) {
        sub_custom<float><<<blockNum, nullptr, stream>>>(x, y, z);
    } else if (info_x.tensors[0].dtype == 1) {
        sub_custom<half><<<blockNum, nullptr, stream>>>(x, y, z);
    }
}