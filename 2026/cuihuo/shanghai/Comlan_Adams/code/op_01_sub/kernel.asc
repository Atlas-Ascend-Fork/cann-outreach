#include <cstdint>
#include "kernel_operator.h"
/*
 * Sub Kernel — Ascend C Direct Invocation
 * z = x - y, shape (8, 2048), ND layout, fp32 (dtype=0) / fp16 (dtype=1).
 *
 * This file is #included by main.asc — do NOT add main() or include guards.
 *
 * TensorGroupInfo / TensorInfo (predefined by the host harness):
 *   struct TensorInfo { const int64_t* shape; int64_t numDims; int32_t dtype; };
 *   struct TensorGroupInfo { const TensorInfo* tensors; int64_t numTensors; };
 */

namespace {
constexpr uint32_t SUB_TILE_LEN = 2048;
constexpr uint32_t SUB_DOUBLE_BUFFER = 2;
}  // namespace

template <typename T>
class KernelSub {
public:
    __aicore__ inline explicit KernelSub(AscendC::TPipe* pipe) : pipe_(pipe) {}

    __aicore__ inline void Init(GM_ADDR x, GM_ADDR y, GM_ADDR z,
                                uint32_t totalElem, uint32_t elemPerCore)
    {
        uint32_t blockIdx = static_cast<uint32_t>(AscendC::GetBlockIdx());
        uint32_t offset = blockIdx * elemPerCore;
        if (offset < totalElem) {
            uint32_t remain = totalElem - offset;
            len_ = (remain < elemPerCore) ? remain : elemPerCore;
            xGm_.SetGlobalBuffer((__gm__ T*)x + offset, len_);
            yGm_.SetGlobalBuffer((__gm__ T*)y + offset, len_);
            zGm_.SetGlobalBuffer((__gm__ T*)z + offset, len_);
        }

        pipe_->InitBuffer(inQueueX_, SUB_DOUBLE_BUFFER, SUB_TILE_LEN * sizeof(T));
        pipe_->InitBuffer(inQueueY_, SUB_DOUBLE_BUFFER, SUB_TILE_LEN * sizeof(T));
        pipe_->InitBuffer(outQueueZ_, SUB_DOUBLE_BUFFER, SUB_TILE_LEN * sizeof(T));
    }

    __aicore__ inline void Process()
    {
        uint32_t tileNum = (len_ + SUB_TILE_LEN - 1) / SUB_TILE_LEN;
        for (uint32_t i = 0; i < tileNum; ++i) {
            uint32_t remain = len_ - i * SUB_TILE_LEN;
            uint32_t count = (remain < SUB_TILE_LEN) ? remain : SUB_TILE_LEN;
            CopyIn(i, count);
            Compute(count);
            CopyOut(i, count);
        }
    }

private:
    __aicore__ inline void CopyIn(uint32_t tileIdx, uint32_t count)
    {
        AscendC::LocalTensor<T> xLocal = inQueueX_.AllocTensor<T>();
        AscendC::LocalTensor<T> yLocal = inQueueY_.AllocTensor<T>();

        AscendC::DataCopyExtParams copyParams{1, static_cast<uint32_t>(count * sizeof(T)), 0, 0, 0};
        AscendC::DataCopyPadExtParams<T> padParams{false, 0, 0, static_cast<T>(0)};
        AscendC::DataCopyPad(xLocal, xGm_[tileIdx * SUB_TILE_LEN], copyParams, padParams);
        AscendC::DataCopyPad(yLocal, yGm_[tileIdx * SUB_TILE_LEN], copyParams, padParams);

        inQueueX_.EnQue(xLocal);
        inQueueY_.EnQue(yLocal);
    }

    __aicore__ inline void Compute(uint32_t count)
    {
        AscendC::LocalTensor<T> xLocal = inQueueX_.DeQue<T>();
        AscendC::LocalTensor<T> yLocal = inQueueY_.DeQue<T>();
        AscendC::LocalTensor<T> zLocal = outQueueZ_.AllocTensor<T>();

        AscendC::Sub(zLocal, xLocal, yLocal, static_cast<int32_t>(count));

        outQueueZ_.EnQue<T>(zLocal);
        inQueueX_.FreeTensor(xLocal);
        inQueueY_.FreeTensor(yLocal);
    }

    __aicore__ inline void CopyOut(uint32_t tileIdx, uint32_t count)
    {
        AscendC::LocalTensor<T> zLocal = outQueueZ_.DeQue<T>();
        AscendC::DataCopyExtParams copyParams{1, static_cast<uint32_t>(count * sizeof(T)), 0, 0, 0};
        AscendC::DataCopyPad(zGm_[tileIdx * SUB_TILE_LEN], zLocal, copyParams);
        outQueueZ_.FreeTensor(zLocal);
    }

    AscendC::TPipe* pipe_;
    AscendC::GlobalTensor<T> xGm_;
    AscendC::GlobalTensor<T> yGm_;
    AscendC::GlobalTensor<T> zGm_;
    AscendC::TQue<AscendC::TPosition::VECIN, SUB_DOUBLE_BUFFER> inQueueX_;
    AscendC::TQue<AscendC::TPosition::VECIN, SUB_DOUBLE_BUFFER> inQueueY_;
    AscendC::TQue<AscendC::TPosition::VECOUT, SUB_DOUBLE_BUFFER> outQueueZ_;
    uint32_t len_ = 0;
};

extern "C" __global__ __vector__ void sub_custom_kernel_fp32(
    GM_ADDR x, GM_ADDR y, GM_ADDR z, uint32_t totalElem, uint32_t elemPerCore)
{
    AscendC::TPipe pipe;
    KernelSub<float> op(&pipe);
    op.Init(x, y, z, totalElem, elemPerCore);
    op.Process();
}

extern "C" __global__ __vector__ void sub_custom_kernel_fp16(
    GM_ADDR x, GM_ADDR y, GM_ADDR z, uint32_t totalElem, uint32_t elemPerCore)
{
    AscendC::TPipe pipe;
    KernelSub<half> op(&pipe);
    op.Init(x, y, z, totalElem, elemPerCore);
    op.Process();
}

extern "C" void run_kernel(GM_ADDR x, const TensorGroupInfo& info_x,
                           GM_ADDR y, const TensorGroupInfo& info_y,
                           GM_ADDR z, const TensorGroupInfo& info_z,
                           int64_t availableCoreNum, aclrtStream stream)
{
    if (info_x.numTensors < 1) {
        return;
    }
    const TensorInfo& in = info_x.tensors[0];
    uint32_t totalElem = 1;
    for (int64_t d = 0; d < in.numDims; ++d) {
        totalElem *= static_cast<uint32_t>(in.shape[d]);
    }

    uint32_t tileNum = (totalElem + SUB_TILE_LEN - 1) / SUB_TILE_LEN;
    uint32_t blockNum = (availableCoreNum > 0) ? static_cast<uint32_t>(availableCoreNum) : 1;
    if (blockNum > tileNum) {
        blockNum = tileNum;
    }
    if (blockNum > totalElem) {
        blockNum = totalElem;
    }
    if (blockNum == 0) {
        return;
    }
    uint32_t elemPerCore = (totalElem + blockNum - 1) / blockNum;

    if (in.dtype == 0) {
        sub_custom_kernel_fp32<<<blockNum, nullptr, stream>>>(x, y, z, totalElem, elemPerCore);
    } else if (in.dtype == 1) {
        sub_custom_kernel_fp16<<<blockNum, nullptr, stream>>>(x, y, z, totalElem, elemPerCore);
    }
}
