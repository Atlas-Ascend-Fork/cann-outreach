#include <cmath>
#include <cstdint>
#include "kernel_operator.h"
/*
 * Sub Kernel — Ascend C Direct Invocation
 * This file is #included by the entry source. Do not add main().
 *
 * TensorGroupInfo / TensorInfo (predefined):
 *   #define GM_ADDR __gm__ uint8_t*
 *   struct TensorInfo {
 *       const int64_t* shape;
 *       int64_t numDims;
 *       int32_t dtype;
 *   };
 *   struct TensorGroupInfo {
 *       const TensorInfo* tensors;
 *       int64_t numTensors;
 *   };
 *   dtype: 0=float32 1=float16 2=bfloat16 3=int8 4=int16 5=int32 6=int64
 *          7=uint8 8=uint16 9=uint32 10=uint64 11=bool
 *          12=float64 13=complex32 14=complex64 15=complex128
 *   Usage: info_x.tensors[0].shape[0]  // first dim of first tensor in input x
 */

constexpr static int64_t kMinElemsPerCore = 1024;
constexpr static int64_t kQueueDepth = 2;
constexpr static uint32_t kTileBytes = 16U * 1024U;

template <typename T>
__global__ __vector__ void sub_kernel(GM_ADDR x, GM_ADDR y, GM_ADDR z,
                                      int64_t totalLength, int64_t blockLength,
                                      uint32_t tileSize)
{
    AscendC::TPipe pipe;
    AscendC::TQue<AscendC::TPosition::VECIN, kQueueDepth> inQueueX;
    AscendC::TQue<AscendC::TPosition::VECIN, kQueueDepth> inQueueY;
    AscendC::TQue<AscendC::TPosition::VECOUT, kQueueDepth> outQueueZ;
    pipe.InitBuffer(inQueueX, kQueueDepth, tileSize);
    pipe.InitBuffer(inQueueY, kQueueDepth, tileSize);
    pipe.InitBuffer(outQueueZ, kQueueDepth, tileSize);

    const int64_t gmOffset = static_cast<int64_t>(AscendC::GetBlockIdx()) * blockLength;
    int64_t currentBlockLength = totalLength - gmOffset;
    if (currentBlockLength <= 0) {
        return;
    }
    if (currentBlockLength > blockLength) {
        currentBlockLength = blockLength;
    }

    AscendC::GlobalTensor<T> xGm;
    AscendC::GlobalTensor<T> yGm;
    AscendC::GlobalTensor<T> zGm;
    xGm.SetGlobalBuffer((__gm__ T*)x + gmOffset, static_cast<uint64_t>(currentBlockLength));
    yGm.SetGlobalBuffer((__gm__ T*)y + gmOffset, static_cast<uint64_t>(currentBlockLength));
    zGm.SetGlobalBuffer((__gm__ T*)z + gmOffset, static_cast<uint64_t>(currentBlockLength));

    const int64_t elementNumPerTile = static_cast<int64_t>(tileSize) / static_cast<int64_t>(sizeof(T));
    for (int64_t done = 0; done < currentBlockLength; done += elementNumPerTile) {
        int64_t count = currentBlockLength - done;
        if (count > elementNumPerTile) {
            count = elementNumPerTile;
        }

        AscendC::DataCopyExtParams copyParams{1, static_cast<uint32_t>(count * static_cast<int64_t>(sizeof(T))),
                                              0, 0, 0};
        AscendC::DataCopyPadExtParams<T> padParams{false, 0, 0, 0};

        AscendC::LocalTensor<T> xLocal = inQueueX.AllocTensor<T>();
        AscendC::LocalTensor<T> yLocal = inQueueY.AllocTensor<T>();
        AscendC::DataCopyPad(xLocal, xGm[done], copyParams, padParams);
        AscendC::DataCopyPad(yLocal, yGm[done], copyParams, padParams);
        inQueueX.EnQue(xLocal);
        inQueueY.EnQue(yLocal);

        xLocal = inQueueX.DeQue<T>();
        yLocal = inQueueY.DeQue<T>();
        AscendC::LocalTensor<T> zLocal = outQueueZ.AllocTensor<T>();
        AscendC::Sub(zLocal, xLocal, yLocal, static_cast<int32_t>(count));
        outQueueZ.EnQue(zLocal);
        inQueueX.FreeTensor(xLocal);
        inQueueY.FreeTensor(yLocal);

        zLocal = outQueueZ.DeQue<T>();
        AscendC::DataCopyPad(zGm[done], zLocal, copyParams);
        outQueueZ.FreeTensor(zLocal);
    }
}

extern "C" void run_kernel(
    GM_ADDR x,
    const TensorGroupInfo& info_x,
    GM_ADDR y,
    const TensorGroupInfo& info_y,
    GM_ADDR z,
    const TensorGroupInfo& info_z,
    int64_t availableCoreNum,
    aclrtStream stream)
{
    if (info_x.tensors == nullptr || info_x.numTensors < 1) {
        return;
    }
    const TensorInfo& tensorX = info_x.tensors[0];
    if (tensorX.shape == nullptr || tensorX.numDims <= 0) {
        return;
    }

    int64_t totalLength = 1;
    for (int64_t dim = 0; dim < tensorX.numDims; ++dim) {
        if (tensorX.shape[dim] <= 0) {
            return;
        }
        totalLength *= tensorX.shape[dim];
    }

    if (tensorX.dtype != 0 && tensorX.dtype != 1) {
        return;
    }
    if (info_y.tensors == nullptr || info_y.numTensors < 1 ||
        info_z.tensors == nullptr || info_z.numTensors < 1) {
        return;
    }
    if (info_y.tensors[0].dtype != tensorX.dtype || info_z.tensors[0].dtype != tensorX.dtype) {
        return;
    }

    const int64_t elementSize = (tensorX.dtype == 0) ? 4 : 2;
    const int64_t coreLimit = (availableCoreNum > 0) ? availableCoreNum : 1;

    int64_t numBlocks = (totalLength + kMinElemsPerCore - 1) / kMinElemsPerCore;
    if (numBlocks > coreLimit) {
        numBlocks = coreLimit;
    }
    if (numBlocks < 1) {
        numBlocks = 1;
    }

    const int64_t alignElements = 32 / elementSize;
    int64_t blockLength = (totalLength + numBlocks - 1) / numBlocks;
    blockLength = (blockLength + alignElements - 1) / alignElements * alignElements;

    int64_t usedBlocks = (totalLength + blockLength - 1) / blockLength;
    if (usedBlocks < numBlocks) {
        numBlocks = usedBlocks;
    }

    const uint32_t gridDim = static_cast<uint32_t>(numBlocks);
    if (tensorX.dtype == 0) {
        sub_kernel<float><<<gridDim, nullptr, stream>>>(
            x, y, z, totalLength, blockLength, kTileBytes);
    } else {
        sub_kernel<half><<<gridDim, nullptr, stream>>>(
            x, y, z, totalLength, blockLength, kTileBytes);
    }
}