#include <cmath>
#include "kernel_operator.h"

template <typename T>
class SubKernel {
public:
    __aicore__ inline void Init(GM_ADDR x, GM_ADDR y, GM_ADDR z)
    {
        xGm.SetGlobalBuffer((__gm__ T*)x, 8 * 2048);
        yGm.SetGlobalBuffer((__gm__ T*)y, 8 * 2048);
        zGm.SetGlobalBuffer((__gm__ T*)z, 8 * 2048);
        pipe.InitBuffer(xQueue, 1, 2048 * sizeof(T));
        pipe.InitBuffer(yQueue, 1, 2048 * sizeof(T));
        pipe.InitBuffer(zQueue, 1, 2048 * sizeof(T));
    }

    __aicore__ inline void Process()
    {
        for (uint32_t row = AscendC::GetBlockIdx(); row < 8;
             row += AscendC::GetBlockNum()) {
            const uint32_t offset = row * 2048;
            auto xLocal = xQueue.AllocTensor<T>();
            auto yLocal = yQueue.AllocTensor<T>();
            AscendC::DataCopy(xLocal, xGm[offset], 2048);
            AscendC::DataCopy(yLocal, yGm[offset], 2048);
            xQueue.EnQue(xLocal);
            yQueue.EnQue(yLocal);

            xLocal = xQueue.DeQue<T>();
            yLocal = yQueue.DeQue<T>();
            auto zLocal = zQueue.AllocTensor<T>();
            AscendC::Sub(zLocal, xLocal, yLocal, 2048);
            zQueue.EnQue(zLocal);
            xQueue.FreeTensor(xLocal);
            yQueue.FreeTensor(yLocal);

            zLocal = zQueue.DeQue<T>();
            AscendC::DataCopy(zGm[offset], zLocal, 2048);
            zQueue.FreeTensor(zLocal);
        }
    }

private:
    AscendC::TPipe pipe;
    AscendC::TQue<AscendC::QuePosition::VECIN, 1> xQueue, yQueue;
    AscendC::TQue<AscendC::QuePosition::VECOUT, 1> zQueue;
    AscendC::GlobalTensor<T> xGm, yGm, zGm;
};

template <typename T>
__global__ __vector__ void sub_custom(GM_ADDR x, GM_ADDR y, GM_ADDR z)
{
    SubKernel<T> kernel;
    kernel.Init(x, y, z);
    kernel.Process();
}

extern "C" void run_kernel(
    GM_ADDR x,
    const TensorGroupInfo& info_x,
    GM_ADDR y,
    const TensorGroupInfo& info_y,
    GM_ADDR z,
    const TensorGroupInfo& info_z,
    int64_t availableCoreNum,
    aclrtStream stream)
{
    const uint32_t blockNum = static_cast<uint32_t>(
        availableCoreNum < 8 ? availableCoreNum : 8);
    if (info_x.tensors[0].dtype == 1) {
        sub_custom<half><<<blockNum, nullptr, stream>>>(x, y, z);
    } else {
        sub_custom<float><<<blockNum, nullptr, stream>>>(x, y, z);
    }
}
