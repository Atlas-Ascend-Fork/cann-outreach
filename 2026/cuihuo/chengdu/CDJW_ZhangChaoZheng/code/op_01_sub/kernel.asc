#include <cmath>
#include <cstdint>
#include "kernel_operator.h"

/* Sub Kernel — Ascend C Direct Invocation (z = x - y)
 * This file is #included by the entry source. Do not add main().
 */

constexpr int32_t SUB_PIPELINE_DEPTH = 2;
constexpr uint32_t SUB_TILE_BYTES = 16384;
constexpr int64_t SUB_MIN_ELEMS_PER_CORE = 1024;

template <typename T>
__global__ __vector__ void sub_custom(
    GM_ADDR x, GM_ADDR y, GM_ADDR z,
    int64_t totalLength, int64_t blockLength, uint32_t tileBytes)
{
    AscendC::TPipe pipe;
    AscendC::TQue<AscendC::TPosition::VECIN, SUB_PIPELINE_DEPTH> inQueueX;
    AscendC::TQue<AscendC::TPosition::VECIN, SUB_PIPELINE_DEPTH> inQueueY;
    AscendC::TQue<AscendC::TPosition::VECOUT, SUB_PIPELINE_DEPTH> outQueueZ;
    pipe.InitBuffer(inQueueX, SUB_PIPELINE_DEPTH, tileBytes);
    pipe.InitBuffer(inQueueY, SUB_PIPELINE_DEPTH, tileBytes);
    pipe.InitBuffer(outQueueZ, SUB_PIPELINE_DEPTH, tileBytes);

    const int64_t offset = static_cast<int64_t>(AscendC::GetBlockIdx()) * blockLength;
    int64_t current = totalLength - offset;
    if (current <= 0) {
        return;
    }
    if (current > blockLength) {
        current = blockLength;
    }

    AscendC::GlobalTensor<T> xGm, yGm, zGm;
    xGm.SetGlobalBuffer(reinterpret_cast<__gm__ T *>(x) + offset);
    yGm.SetGlobalBuffer(reinterpret_cast<__gm__ T *>(y) + offset);
    zGm.SetGlobalBuffer(reinterpret_cast<__gm__ T *>(z) + offset);

    const int64_t elemsPerTile = static_cast<int64_t>(tileBytes / sizeof(T));
    const int64_t tileNum = (current + elemsPerTile - 1) / elemsPerTile;
    for (int64_t i = 0; i < tileNum; ++i) {
        const int64_t base = i * elemsPerTile;
        int64_t count = current - base;
        if (count > elemsPerTile) {
            count = elemsPerTile;
        }
        const AscendC::DataCopyExtParams copyParams{
            1, static_cast<uint32_t>(count * sizeof(T)), 0, 0, 0};
        const AscendC::DataCopyPadExtParams<T> padParams{false, 0, 0, 0};

        auto xLocal = inQueueX.AllocTensor<T>();
        auto yLocal = inQueueY.AllocTensor<T>();
        AscendC::DataCopyPad(xLocal, xGm[base], copyParams, padParams);
        AscendC::DataCopyPad(yLocal, yGm[base], copyParams, padParams);
        inQueueX.EnQue(xLocal);
        inQueueY.EnQue(yLocal);

        xLocal = inQueueX.DeQue<T>();
        yLocal = inQueueY.DeQue<T>();
        auto zLocal = outQueueZ.AllocTensor<T>();
        AscendC::Sub(zLocal, xLocal, yLocal, static_cast<uint32_t>(count));
        outQueueZ.EnQue<T>(zLocal);
        inQueueX.FreeTensor(xLocal);
        inQueueY.FreeTensor(yLocal);

        zLocal = outQueueZ.DeQue<T>();
        AscendC::DataCopyPad(zGm[base], zLocal, copyParams);
        outQueueZ.FreeTensor(zLocal);
    }
}

static inline int64_t sub_round_up(int64_t value, int64_t align)
{
    return (value + align - 1) / align * align;
}

static inline int64_t sub_total_length(const TensorGroupInfo &info)
{
    if (info.tensors == nullptr || info.numTensors <= 0) {
        return 0;
    }
    const TensorInfo &t = info.tensors[0];
    if (t.shape == nullptr || t.numDims <= 0) {
        return 0;
    }
    int64_t total = 1;
    for (int64_t i = 0; i < t.numDims; ++i) {
        total *= t.shape[i];
    }
    return total;
}

extern "C" void run_kernel(
    GM_ADDR x,
    const TensorGroupInfo& info_x,
    GM_ADDR y,
    const TensorGroupInfo& info_y,
    GM_ADDR z,
    const TensorGroupInfo& info_z,
    int64_t availableCoreNum,
    aclrtStream stream)
{
    (void)info_y;
    (void)info_z;
    const int64_t totalLength = sub_total_length(info_x);
    if (totalLength <= 0) {
        return;
    }
    int64_t coreNum = availableCoreNum > 0 ? availableCoreNum : 1;
    int64_t numBlocks = (totalLength + SUB_MIN_ELEMS_PER_CORE - 1) / SUB_MIN_ELEMS_PER_CORE;
    if (numBlocks > coreNum) {
        numBlocks = coreNum;
    }
    if (numBlocks < 1) {
        numBlocks = 1;
    }

    const int32_t dtype = info_x.tensors[0].dtype;
    if (dtype == 0) {
        const int64_t alignElems = 32 / static_cast<int64_t>(sizeof(float));
        int64_t blockLength = (totalLength + numBlocks - 1) / numBlocks;
        blockLength = sub_round_up(blockLength, alignElems);
        sub_custom<float><<<static_cast<uint32_t>(numBlocks), nullptr, stream>>>(
            x, y, z, totalLength, blockLength, SUB_TILE_BYTES);
    } else if (dtype == 1) {
        const int64_t alignElems = 32 / static_cast<int64_t>(sizeof(half));
        int64_t blockLength = (totalLength + numBlocks - 1) / numBlocks;
        blockLength = sub_round_up(blockLength, alignElems);
        sub_custom<half><<<static_cast<uint32_t>(numBlocks), nullptr, stream>>>(
            x, y, z, totalLength, blockLength, SUB_TILE_BYTES);
    }
}