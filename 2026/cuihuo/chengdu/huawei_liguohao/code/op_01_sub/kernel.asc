#include <cmath>
#include "kernel_operator.h"
/*
 * Sub Kernel — Ascend C Direct Invocation
 * This file is #included by the entry source. Do not add main().
 *
 * z = x - y  (elementwise, fp32 / fp16)
 */

// Elements per tile (shared by host tiling and device kernel).
constexpr uint32_t SUB_TILE_ELEMS = 2048;

template <typename T>
class KernelSub {
public:
    __aicore__ inline explicit KernelSub(AscendC::TPipe* pipe) : pipe_(pipe) {}

    __aicore__ inline void Init(GM_ADDR x, GM_ADDR y, GM_ADDR z,
                                uint32_t totalLength, uint32_t numPerCore)
    {
        pipe_->InitBuffer(inQueueX_, 1, SUB_TILE_ELEMS * sizeof(T));
        pipe_->InitBuffer(inQueueY_, 1, SUB_TILE_ELEMS * sizeof(T));
        pipe_->InitBuffer(outQueueZ_, 1, SUB_TILE_ELEMS * sizeof(T));

        uint32_t blockIdx = static_cast<uint32_t>(AscendC::GetBlockIdx());
        uint64_t start64 = static_cast<uint64_t>(blockIdx) * numPerCore;
        if (start64 >= totalLength) {
            total_ = 0;
            return;
        }
        uint32_t start = static_cast<uint32_t>(start64);
        total_ = totalLength - start;
        if (total_ > numPerCore) {
            total_ = numPerCore;
        }
        xGm_.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(x) + start, total_);
        yGm_.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(y) + start, total_);
        zGm_.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(z) + start, total_);
    }

    __aicore__ inline void Process()
    {
        uint32_t offset = 0;
        while (offset < total_) {
            uint32_t count = total_ - offset;
            if (count > SUB_TILE_ELEMS) {
                count = SUB_TILE_ELEMS;
            }
            CopyIn(offset, count);
            Compute(count);
            CopyOut(offset, count);
            offset += count;
        }
    }

private:
    __aicore__ inline void CopyIn(uint32_t offset, uint32_t count)
    {
        AscendC::LocalTensor<T> xLocal = inQueueX_.template AllocTensor<T>();
        AscendC::LocalTensor<T> yLocal = inQueueY_.template AllocTensor<T>();
        AscendC::DataCopyPad(xLocal, xGm_[offset],
            {1, static_cast<uint16_t>(count * sizeof(T)), 0, 0}, {false, 0, 0, 0});
        AscendC::DataCopyPad(yLocal, yGm_[offset],
            {1, static_cast<uint16_t>(count * sizeof(T)), 0, 0}, {false, 0, 0, 0});
        inQueueX_.EnQue(xLocal);
        inQueueY_.EnQue(yLocal);
    }

    __aicore__ inline void Compute(uint32_t count)
    {
        AscendC::LocalTensor<T> xLocal = inQueueX_.template DeQue<T>();
        AscendC::LocalTensor<T> yLocal = inQueueY_.template DeQue<T>();
        AscendC::LocalTensor<T> zLocal = outQueueZ_.template AllocTensor<T>();

        AscendC::Sub(zLocal, xLocal, yLocal, count);

        outQueueZ_.EnQue<T>(zLocal);
        inQueueX_.FreeTensor(xLocal);
        inQueueY_.FreeTensor(yLocal);
    }

    __aicore__ inline void CopyOut(uint32_t offset, uint32_t count)
    {
        AscendC::LocalTensor<T> zLocal = outQueueZ_.template DeQue<T>();
        AscendC::DataCopyPad(zGm_[offset], zLocal,
            {1, static_cast<uint16_t>(count * sizeof(T)), 0, 0});
        outQueueZ_.FreeTensor(zLocal);
    }

    AscendC::TPipe* pipe_;
    AscendC::GlobalTensor<T> xGm_;
    AscendC::GlobalTensor<T> yGm_;
    AscendC::GlobalTensor<T> zGm_;
    AscendC::TQue<AscendC::TPosition::VECIN, 1> inQueueX_;
    AscendC::TQue<AscendC::TPosition::VECIN, 1> inQueueY_;
    AscendC::TQue<AscendC::TPosition::VECOUT, 1> outQueueZ_;
    uint32_t total_ = 0;
};

extern "C" __global__ __vector__ void sub_custom_fp32(
    GM_ADDR x, GM_ADDR y, GM_ADDR z, uint32_t totalLength, uint32_t numPerCore)
{
    AscendC::TPipe pipe;
    KernelSub<float> op(&pipe);
    op.Init(x, y, z, totalLength, numPerCore);
    op.Process();
}

extern "C" __global__ __vector__ void sub_custom_fp16(
    GM_ADDR x, GM_ADDR y, GM_ADDR z, uint32_t totalLength, uint32_t numPerCore)
{
    AscendC::TPipe pipe;
    KernelSub<half> op(&pipe);
    op.Init(x, y, z, totalLength, numPerCore);
    op.Process();
}

static inline int64_t SubNumElements(const TensorGroupInfo& info)
{
    const TensorInfo& t = info.tensors[0];
    int64_t n = 1;
    for (int64_t i = 0; i < t.numDims; ++i) {
        n *= t.shape[i];
    }
    return n;
}

extern "C" void run_kernel(
    GM_ADDR x,
    const TensorGroupInfo& info_x,
    GM_ADDR y,
    const TensorGroupInfo& info_y,
    GM_ADDR z,
    const TensorGroupInfo& info_z,
    int64_t availableCoreNum,
    aclrtStream stream)
{
    const int32_t dtype = info_x.tensors[0].dtype;
    if (dtype != 0 && dtype != 1) {
        return;
    }
    const int64_t total = SubNumElements(info_x);
    if (total <= 0) {
        return;
    }

    int64_t totalTiles = (total + SUB_TILE_ELEMS - 1) / SUB_TILE_ELEMS;
    int64_t blocks = availableCoreNum > 0 ? availableCoreNum : 1;
    if (blocks > totalTiles) {
        blocks = totalTiles;
    }
    int64_t tilesPerCore = (totalTiles + blocks - 1) / blocks;
    blocks = (totalTiles + tilesPerCore - 1) / tilesPerCore;
    const uint32_t numPerCore = static_cast<uint32_t>(tilesPerCore * SUB_TILE_ELEMS);

    if (dtype == 0) {
        sub_custom_fp32<<<blocks, nullptr, stream>>>(
            x, y, z, static_cast<uint32_t>(total), numPerCore);
    } else {
        sub_custom_fp16<<<blocks, nullptr, stream>>>(
            x, y, z, static_cast<uint32_t>(total), numPerCore);
    }
}