#include <algorithm>
#include "kernel_operator.h"
/*
 * Sub Kernel — Ascend C Direct Invocation
 * This file is #included by the entry source. Do not add main().
 *
 * TensorGroupInfo / TensorInfo (predefined):
 *   #define GM_ADDR __gm__ uint8_t*
 *   struct TensorInfo {
 *       const int64_t* shape;
 *       int64_t numDims;
 *       int32_t dtype;
 *   };
 *   struct TensorGroupInfo {
 *       const TensorInfo* tensors;
 *       int64_t numTensors;
 *   };
 *   dtype: 0=float32 1=float16 2=bfloat16 3=int8 4=int16 5=int32 6=int64
 *          7=uint8 8=uint16 9=uint32 10=uint64 11=bool
 *          12=float64 13=complex32 14=complex64 15=complex128
 *   Usage: info_x.tensors[0].shape[0]  // first dim of first tensor in input x
 */

constexpr static int64_t PIPELINE_DEPTH = 2;
// 3 queues * 2 buffers * 16 KB = 96 KB, fits the 192 KB UB of 910B (and 128 KB UB parts).
constexpr static int64_t TILE_BYTES = 16 * 1024;
constexpr static int64_t MIN_ELEMS_PER_CORE = 1024;

// The 8 x 2048 case fits in one transfer per core. Static UB tensors avoid
// TPipe/queue setup, double buffering, and the generic tail-copy path.
template <typename T, uint32_t BlockElements>
__global__ __vector__ void sub_fixed(GM_ADDR x, GM_ADDR y, GM_ADDR z)
{
    AscendC::InitSocState();

    constexpr uint32_t blockBytes = BlockElements * sizeof(T);
    static_assert(blockBytes % 32 == 0, "DataCopy requires 32-byte alignment");
    const uint32_t offset = AscendC::GetBlockIdx() * BlockElements;

    AscendC::GlobalTensor<T> xGm, yGm, zGm;
    xGm.SetGlobalBuffer((__gm__ T*)x + offset, BlockElements);
    yGm.SetGlobalBuffer((__gm__ T*)y + offset, BlockElements);
    zGm.SetGlobalBuffer((__gm__ T*)z + offset, BlockElements);

    AscendC::LocalTensor<T> xLocal(AscendC::TPosition::VECCALC, 0, BlockElements);
    AscendC::LocalTensor<T> yLocal(AscendC::TPosition::VECCALC, blockBytes, BlockElements);
    AscendC::LocalTensor<T> zLocal(AscendC::TPosition::VECCALC, 2 * blockBytes, BlockElements);

    AscendC::DataCopy(xLocal, xGm, BlockElements);
    AscendC::DataCopy(yLocal, yGm, BlockElements);
    AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);
    AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);

    AscendC::Sub(zLocal, xLocal, yLocal, BlockElements);
    AscendC::SetFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
    AscendC::WaitFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
    AscendC::DataCopy(zGm, zLocal, BlockElements);
}

template <typename T>
__global__ __vector__ void sub_custom(GM_ADDR x, GM_ADDR y, GM_ADDR z,
                                      int64_t totalLength, int64_t blockLength, uint32_t tileSize)
{
    AscendC::TPipe pipe;
    AscendC::TQue<AscendC::QuePosition::VECIN, PIPELINE_DEPTH> inQueueX;
    AscendC::TQue<AscendC::QuePosition::VECIN, PIPELINE_DEPTH> inQueueY;
    AscendC::TQue<AscendC::QuePosition::VECOUT, PIPELINE_DEPTH> outQueueZ;
    pipe.InitBuffer(inQueueX, PIPELINE_DEPTH, tileSize);
    pipe.InitBuffer(inQueueY, PIPELINE_DEPTH, tileSize);
    pipe.InitBuffer(outQueueZ, PIPELINE_DEPTH, tileSize);

    int64_t blockOffset = blockLength * AscendC::GetBlockIdx();
    AscendC::GlobalTensor<T> xGm, yGm, zGm;
    xGm.SetGlobalBuffer((__gm__ T*)x + blockOffset);
    yGm.SetGlobalBuffer((__gm__ T*)y + blockOffset);
    zGm.SetGlobalBuffer((__gm__ T*)z + blockOffset);

    int64_t currentBlockLength = totalLength - blockOffset;
    if (currentBlockLength > blockLength) currentBlockLength = blockLength;
    if (currentBlockLength <= 0) return;

    int64_t elementNumPerTile = tileSize / sizeof(T);
    int64_t tileNum = currentBlockLength / elementNumPerTile;
    int64_t tailTileElementNum = currentBlockLength - tileNum * elementNumPerTile;

    for (int64_t i = 0; i < tileNum; ++i) {
        int64_t offset = i * elementNumPerTile;
        AscendC::DataCopyExtParams copyParams{1, static_cast<uint32_t>(elementNumPerTile * sizeof(T)), 0, 0, 0};
        AscendC::DataCopyPadExtParams<T> padParams{false, 0, 0, 0};
        auto xLocal = inQueueX.AllocTensor<T>();
        auto yLocal = inQueueY.AllocTensor<T>();
        AscendC::DataCopyPad(xLocal, xGm[offset], copyParams, padParams);
        AscendC::DataCopyPad(yLocal, yGm[offset], copyParams, padParams);
        inQueueX.EnQue(xLocal);
        inQueueY.EnQue(yLocal);
        xLocal = inQueueX.DeQue<T>();
        yLocal = inQueueY.DeQue<T>();
        auto zLocal = outQueueZ.AllocTensor<T>();
        AscendC::Sub(zLocal, xLocal, yLocal, elementNumPerTile);
        outQueueZ.EnQue(zLocal);
        inQueueX.FreeTensor(xLocal);
        inQueueY.FreeTensor(yLocal);
        zLocal = outQueueZ.DeQue<T>();
        AscendC::DataCopyPad(zGm[offset], zLocal, copyParams);
        outQueueZ.FreeTensor(zLocal);
    }

    if (tailTileElementNum > 0) {
        int64_t offset = tileNum * elementNumPerTile;
        AscendC::DataCopyExtParams copyParams{1, static_cast<uint32_t>(tailTileElementNum * sizeof(T)), 0, 0, 0};
        AscendC::DataCopyPadExtParams<T> padParams{false, 0, 0, 0};
        auto xLocal = inQueueX.AllocTensor<T>();
        auto yLocal = inQueueY.AllocTensor<T>();
        AscendC::DataCopyPad(xLocal, xGm[offset], copyParams, padParams);
        AscendC::DataCopyPad(yLocal, yGm[offset], copyParams, padParams);
        inQueueX.EnQue(xLocal);
        inQueueY.EnQue(yLocal);
        xLocal = inQueueX.DeQue<T>();
        yLocal = inQueueY.DeQue<T>();
        auto zLocal = outQueueZ.AllocTensor<T>();
        AscendC::Sub(zLocal, xLocal, yLocal, tailTileElementNum);
        outQueueZ.EnQue(zLocal);
        inQueueX.FreeTensor(xLocal);
        inQueueY.FreeTensor(yLocal);
        zLocal = outQueueZ.DeQue<T>();
        AscendC::DataCopyPad(zGm[offset], zLocal, copyParams);
        outQueueZ.FreeTensor(zLocal);
    }
}

template <typename T>
inline void launch_sub(GM_ADDR x, GM_ADDR y, GM_ADDR z,
                       int64_t totalLength, int64_t availableCoreNum,
                       aclrtStream stream)
{
    if (totalLength == 8 * 2048) {
        // Power-of-two core counts give aligned, equal blocks for both dtypes.
        // With one available core, use tiling to keep the UB footprint bounded.
        if (availableCoreNum >= 16) {
            sub_fixed<T, 1024><<<16, nullptr, stream>>>(x, y, z);
            return;
        }
        if (availableCoreNum >= 8) {
            sub_fixed<T, 2048><<<8, nullptr, stream>>>(x, y, z);
            return;
        }
        if (availableCoreNum >= 4) {
            sub_fixed<T, 4096><<<4, nullptr, stream>>>(x, y, z);
            return;
        }
        if (availableCoreNum >= 2) {
            sub_fixed<T, 8192><<<2, nullptr, stream>>>(x, y, z);
            return;
        }
    }

    const int64_t coreNum = availableCoreNum > 0 ? availableCoreNum : 1;
    const int64_t numBlocks = std::max<int64_t>(1, std::min(
        coreNum, (totalLength + MIN_ELEMS_PER_CORE - 1) / MIN_ELEMS_PER_CORE));
    const int64_t blockLength = (totalLength + numBlocks - 1) / numBlocks;
    sub_custom<T><<<numBlocks, nullptr, stream>>>(
        x, y, z, totalLength, blockLength, static_cast<uint32_t>(TILE_BYTES));
}

extern "C" void run_kernel(
    GM_ADDR x,
    const TensorGroupInfo& info_x,
    GM_ADDR y,
    const TensorGroupInfo& info_y,
    GM_ADDR z,
    const TensorGroupInfo& info_z,
    int64_t availableCoreNum,
    aclrtStream stream)
{
    const TensorInfo& xInfo = info_x.tensors[0];
    int64_t totalLength = 1;
    for (int64_t i = 0; i < xInfo.numDims; ++i)
        totalLength *= xInfo.shape[i];

    if (totalLength <= 0) return;

    if (xInfo.dtype == 0) {
        launch_sub<float>(x, y, z, totalLength, availableCoreNum, stream);
    } else if (xInfo.dtype == 1) {
        launch_sub<half>(x, y, z, totalLength, availableCoreNum, stream);
    }
}