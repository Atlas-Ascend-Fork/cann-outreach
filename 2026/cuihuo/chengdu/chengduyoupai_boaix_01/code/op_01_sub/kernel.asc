#include <cmath>
#include "kernel_operator.h"
/*
 * Sub Kernel — Ascend C Direct Invocation
 * This file is #included by the entry source. Do not add main().
 *
 * TensorGroupInfo / TensorInfo (predefined):
 *   #define GM_ADDR __gm__ uint8_t*
 *   struct TensorInfo {
 *       const int64_t* shape;
 *       int64_t numDims;
 *       int32_t dtype;
 *   };
 *   struct TensorGroupInfo {
 *       const TensorInfo* tensors;
 *       int64_t numTensors;
 *   };
 *   dtype: 0=float32 1=float16 2=bfloat16 3=int8 4=int16 5=int32 6=int64
 *          7=uint8 8=uint16 9=uint32 10=uint64 11=bool
 *          12=float64 13=complex32 14=complex64 15=complex128
 *   Usage: info_x.tensors[0].shape[0]  // first dim of first tensor in input x
 */

namespace {

constexpr uint32_t kTileElements = 2048;

template <typename T>
__aicore__ inline void SubCompute(GM_ADDR x, GM_ADDR y, GM_ADDR z,
                                  uint32_t totalLength, uint32_t numPerCore)
{
    AscendC::TPipe pipe;
    AscendC::TQue<AscendC::TPosition::VECIN, 1> inQueueX;
    AscendC::TQue<AscendC::TPosition::VECIN, 1> inQueueY;
    AscendC::TQue<AscendC::TPosition::VECOUT, 1> outQueueZ;
    pipe.InitBuffer(inQueueX, 1, kTileElements * sizeof(T));
    pipe.InitBuffer(inQueueY, 1, kTileElements * sizeof(T));
    pipe.InitBuffer(outQueueZ, 1, kTileElements * sizeof(T));

    uint32_t start = static_cast<uint32_t>(AscendC::GetBlockIdx()) * numPerCore;
    if (start >= totalLength) {
        return;
    }
    uint32_t length = numPerCore;
    if (length > totalLength - start) {
        length = totalLength - start;
    }

    AscendC::GlobalTensor<T> xGm;
    AscendC::GlobalTensor<T> yGm;
    AscendC::GlobalTensor<T> zGm;
    xGm.SetGlobalBuffer((__gm__ T*)x + start, length);
    yGm.SetGlobalBuffer((__gm__ T*)y + start, length);
    zGm.SetGlobalBuffer((__gm__ T*)z + start, length);

    for (uint32_t offset = 0; offset < length; offset += kTileElements) {
        uint32_t count = length - offset;
        if (count > kTileElements) {
            count = kTileElements;
        }

        AscendC::LocalTensor<T> xLocal = inQueueX.AllocTensor<T>();
        AscendC::LocalTensor<T> yLocal = inQueueY.AllocTensor<T>();
        AscendC::DataCopyPad(xLocal, xGm[offset],
            {1, static_cast<uint16_t>(count * sizeof(T)), 0, 0},
            {false, 0, 0, 0});
        AscendC::DataCopyPad(yLocal, yGm[offset],
            {1, static_cast<uint16_t>(count * sizeof(T)), 0, 0},
            {false, 0, 0, 0});
        inQueueX.EnQue(xLocal);
        inQueueY.EnQue(yLocal);

        xLocal = inQueueX.DeQue<T>();
        yLocal = inQueueY.DeQue<T>();
        AscendC::LocalTensor<T> zLocal = outQueueZ.AllocTensor<T>();
        AscendC::Sub(zLocal, xLocal, yLocal, count);
        outQueueZ.EnQue<T>(zLocal);
        inQueueX.FreeTensor(xLocal);
        inQueueY.FreeTensor(yLocal);

        zLocal = outQueueZ.DeQue<T>();
        AscendC::DataCopyPad(zGm[offset], zLocal,
            {1, static_cast<uint16_t>(count * sizeof(T)), 0, 0});
        outQueueZ.FreeTensor(zLocal);
    }
}

}  // namespace

__global__ __vector__ void sub_custom_fp32(GM_ADDR x, GM_ADDR y, GM_ADDR z,
                                           uint32_t totalLength, uint32_t numPerCore)
{
    SubCompute<float>(x, y, z, totalLength, numPerCore);
}

__global__ __vector__ void sub_custom_fp16(GM_ADDR x, GM_ADDR y, GM_ADDR z,
                                           uint32_t totalLength, uint32_t numPerCore)
{
    SubCompute<half>(x, y, z, totalLength, numPerCore);
}

extern "C" void run_kernel(
    GM_ADDR x,
    const TensorGroupInfo& info_x,
    GM_ADDR y,
    const TensorGroupInfo& info_y,
    GM_ADDR z,
    const TensorGroupInfo& info_z,
    int64_t availableCoreNum,
    aclrtStream stream)
{
    const TensorInfo& tensor = info_x.tensors[0];
    uint32_t totalLength = 1;
    for (int64_t i = 0; i < tensor.numDims; ++i) {
        totalLength *= static_cast<uint32_t>(tensor.shape[i]);
    }

    uint32_t blockNum = (totalLength + kTileElements - 1) / kTileElements;
    if (blockNum > static_cast<uint32_t>(availableCoreNum)) {
        blockNum = static_cast<uint32_t>(availableCoreNum);
    }
    if (blockNum == 0) {
        blockNum = 1;
    }
    uint32_t numPerCore = (totalLength + blockNum - 1) / blockNum;

    if (tensor.dtype == 0) {
        sub_custom_fp32<<<blockNum, nullptr, stream>>>(x, y, z, totalLength, numPerCore);
    } else if (tensor.dtype == 1) {
        sub_custom_fp16<<<blockNum, nullptr, stream>>>(x, y, z, totalLength, numPerCore);
    }
}