#include <cmath>
  #include "kernel_operator.h"
  /*
   * Sub Kernel — Ascend C Direct Invocation
   * This file is #included by the entry source. Do not add main().
   *
   * TensorGroupInfo / TensorInfo (predefined):
   *   #define GM_ADDR __gm__ uint8_t*
   *   struct TensorInfo {
   *       const int64_t* shape;
   *       int64_t numDims;
   *       int32_t dtype;
   *   };
   *   struct TensorGroupInfo {
   *       const TensorInfo* tensors;
   *       int64_t numTensors;
   *   };
   *   dtype: 0=float32 1=float16 2=bfloat16 3=int8 4=int16 5=int32 6=int64
   *          7=uint8 8=uint16 9=uint32 10=uint64 11=bool
   *          12=float64 13=complex32 14=complex64 15=complex128
   *   Usage: info_x.tensors[0].shape[0]  // first dim of first tensor in input x
   */

  namespace {
  constexpr int64_t kTileElems = 1024;   // elements per UB tile
  constexpr int64_t kAlignBytes = 32;    // DataCopy alignment in bytes
  }  // namespace

  template <typename T>
  __global__ __vector__ void sub_custom(GM_ADDR x, GM_ADDR y, GM_ADDR z, int64_t totalElems)
  {
      AscendC::TPipe pipe;
      AscendC::TQue<AscendC::TPosition::VECIN, 2> inQueueX;
      AscendC::TQue<AscendC::TPosition::VECIN, 2> inQueueY;
      AscendC::TQue<AscendC::TPosition::VECOUT, 2> outQueueZ;

      AscendC::GlobalTensor<T> xGm;
      AscendC::GlobalTensor<T> yGm;
      AscendC::GlobalTensor<T> zGm;
      xGm.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(x), totalElems);
      yGm.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(y), totalElems);
      zGm.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(z), totalElems);

      pipe.InitBuffer(inQueueX, 2, kTileElems * sizeof(T));
      pipe.InitBuffer(inQueueY, 2, kTileElems * sizeof(T));
      pipe.InitBuffer(outQueueZ, 2, kTileElems * sizeof(T));

      const int64_t tileCount = (totalElems + kTileElems - 1) / kTileElems;
      const int64_t blockNum = static_cast<int64_t>(AscendC::GetBlockNum());
      const int64_t blockIdx = static_cast<int64_t>(AscendC::GetBlockIdx());

      for (int64_t tile = blockIdx; tile < tileCount; tile += blockNum) {
          const int64_t offset = tile * kTileElems;
          const int64_t remain = totalElems - offset;
          const uint32_t count = static_cast<uint32_t>(remain < kTileElems ? remain : kTileElems);
          const uint32_t bytes = count * static_cast<uint32_t>(sizeof(T));
          const bool aligned = (bytes % kAlignBytes) == 0;

          AscendC::LocalTensor<T> xLocal = inQueueX.AllocTensor<T>();
          AscendC::LocalTensor<T> yLocal = inQueueY.AllocTensor<T>();
          if (aligned) {
              AscendC::DataCopy(xLocal, xGm[offset], count);
              AscendC::DataCopy(yLocal, yGm[offset], count);
          } else {
              AscendC::DataCopyPad(xLocal, xGm[offset],
                                   AscendC::DataCopyExtParams(1, bytes, 0, 0, 0),
                                   AscendC::DataCopyPadExtParams<T>(false, 0, 0, static_cast<T>(0.0f)));
              AscendC::DataCopyPad(yLocal, yGm[offset],
                                   AscendC::DataCopyExtParams(1, bytes, 0, 0, 0),
                                   AscendC::DataCopyPadExtParams<T>(false, 0, 0, static_cast<T>(0.0f)));
          }
          inQueueX.EnQue(xLocal);
          inQueueY.EnQue(yLocal);

          xLocal = inQueueX.DeQue<T>();
          yLocal = inQueueY.DeQue<T>();
          AscendC::LocalTensor<T> zLocal = outQueueZ.AllocTensor<T>();
          AscendC::Sub(zLocal, xLocal, yLocal, static_cast<int32_t>(count));
          outQueueZ.EnQue<T>(zLocal);
          inQueueX.FreeTensor(xLocal);
          inQueueY.FreeTensor(yLocal);

          zLocal = outQueueZ.DeQue<T>();
          if (aligned) {
              AscendC::DataCopy(zGm[offset], zLocal, count);
          } else {
              AscendC::DataCopyPad(zGm[offset], zLocal, AscendC::DataCopyExtParams(1, bytes, 0, 0, 0));
          }
          outQueueZ.FreeTensor(zLocal);
      }
  }

  extern "C" void run_kernel(
      GM_ADDR x,
      const TensorGroupInfo& info_x,
      GM_ADDR y,
      const TensorGroupInfo& info_y,
      GM_ADDR z,
      const TensorGroupInfo& info_z,
      int64_t availableCoreNum,
      aclrtStream stream)
  {
      (void)info_x;
      (void)info_y;

      const TensorInfo& out = info_z.tensors[0];
      int64_t totalElems = 1;
      for (int64_t i = 0; i < out.numDims; ++i) {
          totalElems *= out.shape[i];
      }
      if (totalElems <= 0) {
          return;
      }

      const int64_t tileCount = (totalElems + kTileElems - 1) / kTileElems;
      int64_t blocks = availableCoreNum > 0 ? availableCoreNum : 1;
      if (blocks > tileCount) {
          blocks = tileCount;
      }
      const uint32_t blockNum = static_cast<uint32_t>(blocks);

      if (out.dtype == 1) {  // float16
          sub_custom<half><<<blockNum, nullptr, stream>>>(x, y, z, totalElems);
      } else {  // float32
          sub_custom<float><<<blockNum, nullptr, stream>>>(x, y, z, totalElems);
      }
  }
