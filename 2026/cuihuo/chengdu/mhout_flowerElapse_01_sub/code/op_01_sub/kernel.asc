#include <algorithm>
#include <cstdint>
#include <cmath>
#include "kernel_operator.h"
/*
 * Sub Kernel — Ascend C Direct Invocation
 * This file is #included by the entry source. Do not add main().
 *
 * TensorGroupInfo / TensorInfo (predefined):
 *   dtype: 0=float32 1=float16 2=bfloat16 ...
 */

namespace {
constexpr int64_t kPipelineDepth = 2;
constexpr int64_t kMinElemsPerCore = 1024;
constexpr int64_t kMaxTileBytes = 16 * 1024;

template <typename T>
__global__ __aicore__ void sub_custom(GM_ADDR x, GM_ADDR y, GM_ADDR z,
                                      int64_t totalLength, int64_t blockLength,
                                      uint32_t tileSize)
{
    AscendC::TPipe pipe;
    AscendC::TQue<AscendC::QuePosition::VECIN, kPipelineDepth> inQueueX;
    AscendC::TQue<AscendC::QuePosition::VECIN, kPipelineDepth> inQueueY;
    AscendC::TQue<AscendC::QuePosition::VECOUT, kPipelineDepth> outQueueZ;
    pipe.InitBuffer(inQueueX, kPipelineDepth, tileSize);
    pipe.InitBuffer(inQueueY, kPipelineDepth, tileSize);
    pipe.InitBuffer(outQueueZ, kPipelineDepth, tileSize);

    int64_t coreOffset = blockLength * AscendC::GetBlockIdx();
    AscendC::GlobalTensor<T> xGm, yGm, zGm;
    xGm.SetGlobalBuffer((__gm__ T*)x + coreOffset);
    yGm.SetGlobalBuffer((__gm__ T*)y + coreOffset);
    zGm.SetGlobalBuffer((__gm__ T*)z + coreOffset);

    int64_t currentBlockLength = totalLength - coreOffset;
    if (currentBlockLength > blockLength) currentBlockLength = blockLength;
    if (currentBlockLength <= 0) return;

    int64_t elementNumPerTile = static_cast<int64_t>(tileSize) / static_cast<int64_t>(sizeof(T));
    int64_t tileNum = currentBlockLength / elementNumPerTile;
    int64_t tailTileElementNum = currentBlockLength - tileNum * elementNumPerTile;

    for (int64_t i = 0; i < tileNum; ++i) {
        int64_t offset = i * elementNumPerTile;
        AscendC::DataCopyExtParams copyParams{1, static_cast<uint32_t>(elementNumPerTile * sizeof(T)), 0, 0, 0};
        AscendC::DataCopyPadExtParams<T> padParams{false, 0, 0, 0};
        auto xLocal = inQueueX.AllocTensor<T>();
        auto yLocal = inQueueY.AllocTensor<T>();
        AscendC::DataCopyPad(xLocal, xGm[offset], copyParams, padParams);
        AscendC::DataCopyPad(yLocal, yGm[offset], copyParams, padParams);
        inQueueX.EnQue(xLocal);
        inQueueY.EnQue(yLocal);
        xLocal = inQueueX.DeQue<T>();
        yLocal = inQueueY.DeQue<T>();
        auto zLocal = outQueueZ.AllocTensor<T>();
        AscendC::Sub(zLocal, xLocal, yLocal, static_cast<int32_t>(elementNumPerTile));
        outQueueZ.EnQue(zLocal);
        inQueueX.FreeTensor(xLocal);
        inQueueY.FreeTensor(yLocal);
        zLocal = outQueueZ.DeQue<T>();
        AscendC::DataCopyPad(zGm[offset], zLocal, copyParams);
        outQueueZ.FreeTensor(zLocal);
    }

    if (tailTileElementNum > 0) {
        int64_t offset = tileNum * elementNumPerTile;
        AscendC::DataCopyExtParams copyParams{1, static_cast<uint32_t>(tailTileElementNum * sizeof(T)), 0, 0, 0};
        AscendC::DataCopyPadExtParams<T> padParams{false, 0, 0, 0};
        auto xLocal = inQueueX.AllocTensor<T>();
        auto yLocal = inQueueY.AllocTensor<T>();
        AscendC::DataCopyPad(xLocal, xGm[offset], copyParams, padParams);
        AscendC::DataCopyPad(yLocal, yGm[offset], copyParams, padParams);
        inQueueX.EnQue(xLocal);
        inQueueY.EnQue(yLocal);
        xLocal = inQueueX.DeQue<T>();
        yLocal = inQueueY.DeQue<T>();
        auto zLocal = outQueueZ.AllocTensor<T>();
        AscendC::Sub(zLocal, xLocal, yLocal, static_cast<int32_t>(tailTileElementNum));
        outQueueZ.EnQue(zLocal);
        inQueueX.FreeTensor(xLocal);
        inQueueY.FreeTensor(yLocal);
        zLocal = outQueueZ.DeQue<T>();
        AscendC::DataCopyPad(zGm[offset], zLocal, copyParams);
        outQueueZ.FreeTensor(zLocal);
    }
}

inline int64_t numel(const TensorGroupInfo& group)
{
    const TensorInfo& t = group.tensors[0];
    int64_t n = 1;
    for (int64_t i = 0; i < t.numDims; ++i) n *= t.shape[i];
    return n;
}

template <typename T>
void launch_sub(GM_ADDR x, GM_ADDR y, GM_ADDR z, int64_t totalLength,
                int64_t availableCoreNum, aclrtStream stream)
{
    int64_t blocks = std::min(availableCoreNum, (totalLength + kMinElemsPerCore - 1) / kMinElemsPerCore);
    if (blocks < 1) blocks = 1;
    int64_t blockLength = (totalLength + blocks - 1) / blocks;

    int64_t tileBytes = std::min(kMaxTileBytes, blockLength * static_cast<int64_t>(sizeof(T)));
    tileBytes -= tileBytes % 32;
    if (tileBytes < 32) tileBytes = 32;

    sub_custom<T><<<blocks, nullptr, stream>>>(
        x, y, z, totalLength, blockLength, static_cast<uint32_t>(tileBytes));
}
} // namespace

extern "C" void run_kernel(
    GM_ADDR x,
    const TensorGroupInfo& info_x,
    GM_ADDR y,
    const TensorGroupInfo& info_y,
    GM_ADDR z,
    const TensorGroupInfo& info_z,
    int64_t availableCoreNum,
    aclrtStream stream)
{
    (void)info_y;
    (void)info_z;
    int64_t totalLength = numel(info_x);
    int32_t dtype = info_x.tensors[0].dtype;
    if (dtype == 0) {
        launch_sub<float>(x, y, z, totalLength, availableCoreNum, stream);
    } else if (dtype == 1) {
        launch_sub<half>(x, y, z, totalLength, availableCoreNum, stream);
    }
}
