#include "kernel_operator.h"

namespace {
constexpr int64_t kTileElems = 4096;
constexpr int32_t kQueueDepth = 1;
}  // namespace

template <typename T>
class KernelSub {
public:
    __aicore__ inline explicit KernelSub(AscendC::TPipe* pipe) : pipe_(pipe) {}

    __aicore__ inline void Init(GM_ADDR x, GM_ADDR y, GM_ADDR z, int64_t totalElems)
    {
        constexpr int64_t kAlignElems = 32 / static_cast<int64_t>(sizeof(T));
        const int64_t blockNum = static_cast<int64_t>(AscendC::GetBlockNum());
        const int64_t blockIdx = static_cast<int64_t>(AscendC::GetBlockIdx());

        int64_t perCore = (totalElems + blockNum - 1) / blockNum;
        perCore = (perCore + kAlignElems - 1) / kAlignElems * kAlignElems;

        int64_t start = blockIdx * perCore;
        if (start > totalElems) {
            start = totalElems;
        }
        int64_t remain = totalElems - start;
        len_ = remain < perCore ? remain : perCore;

        xGm_.SetGlobalBuffer((__gm__ T*)x + start, len_);
        yGm_.SetGlobalBuffer((__gm__ T*)y + start, len_);
        zGm_.SetGlobalBuffer((__gm__ T*)z + start, len_);

        pipe_->InitBuffer(inQueueX_, kQueueDepth, kTileElems * sizeof(T));
        pipe_->InitBuffer(inQueueY_, kQueueDepth, kTileElems * sizeof(T));
        pipe_->InitBuffer(outQueueZ_, kQueueDepth, kTileElems * sizeof(T));
    }

    __aicore__ inline void Process()
    {
        for (int64_t offset = 0; offset < len_; offset += kTileElems) {
            int64_t count = len_ - offset;
            if (count > kTileElems) {
                count = kTileElems;
            }
            CopyIn(offset, count);
            Compute(count);
            CopyOut(offset, count);
        }
    }

private:
    __aicore__ inline void CopyIn(int64_t offset, int64_t count)
    {
        AscendC::LocalTensor<T> xLocal = inQueueX_.AllocTensor<T>();
        AscendC::LocalTensor<T> yLocal = inQueueY_.AllocTensor<T>();

        AscendC::DataCopyPad(xLocal, xGm_[offset],
            {1, static_cast<uint16_t>(count * static_cast<int64_t>(sizeof(T))), 0, 0},
            {false, 0, 0, 0});
        AscendC::DataCopyPad(yLocal, yGm_[offset],
            {1, static_cast<uint16_t>(count * static_cast<int64_t>(sizeof(T))), 0, 0},
            {false, 0, 0, 0});

        inQueueX_.EnQue(xLocal);
        inQueueY_.EnQue(yLocal);
    }

    __aicore__ inline void Compute(int64_t count)
    {
        AscendC::LocalTensor<T> xLocal = inQueueX_.DeQue<T>();
        AscendC::LocalTensor<T> yLocal = inQueueY_.DeQue<T>();
        AscendC::LocalTensor<T> zLocal = outQueueZ_.AllocTensor<T>();

        AscendC::Sub(zLocal, xLocal, yLocal, static_cast<int32_t>(count));

        outQueueZ_.EnQue(zLocal);
        inQueueX_.FreeTensor(xLocal);
        inQueueY_.FreeTensor(yLocal);
    }

    __aicore__ inline void CopyOut(int64_t offset, int64_t count)
    {
        AscendC::LocalTensor<T> zLocal = outQueueZ_.DeQue<T>();

        AscendC::DataCopyPad(zGm_[offset], zLocal,
            {1, static_cast<uint16_t>(count * static_cast<int64_t>(sizeof(T))), 0, 0});

        outQueueZ_.FreeTensor(zLocal);
    }

    AscendC::TPipe* pipe_;
    AscendC::GlobalTensor<T> xGm_;
    AscendC::GlobalTensor<T> yGm_;
    AscendC::GlobalTensor<T> zGm_;
    AscendC::TQue<AscendC::TPosition::VECIN, kQueueDepth> inQueueX_;
    AscendC::TQue<AscendC::TPosition::VECIN, kQueueDepth> inQueueY_;
    AscendC::TQue<AscendC::TPosition::VECOUT, kQueueDepth> outQueueZ_;
    int64_t len_ = 0;
};

extern "C" __global__ __vector__ void sub_kernel_fp32(
    GM_ADDR x, GM_ADDR y, GM_ADDR z, int64_t totalElems)
{
    AscendC::TPipe pipe;
    KernelSub<float> op(&pipe);
    op.Init(x, y, z, totalElems);
    op.Process();
}

extern "C" __global__ __vector__ void sub_kernel_fp16(
    GM_ADDR x, GM_ADDR y, GM_ADDR z, int64_t totalElems)
{
    AscendC::TPipe pipe;
    KernelSub<half> op(&pipe);
    op.Init(x, y, z, totalElems);
    op.Process();
}

extern "C" void run_kernel(
    GM_ADDR x,
    const TensorGroupInfo& info_x,
    GM_ADDR y,
    const TensorGroupInfo& info_y,
    GM_ADDR z,
    const TensorGroupInfo& info_z,
    int64_t availableCoreNum,
    aclrtStream stream)
{
    const TensorInfo& tensor = info_x.tensors[0];
    int64_t totalElems = 1;
    for (int64_t i = 0; i < tensor.numDims; ++i) {
        totalElems *= tensor.shape[i];
    }
    if (totalElems <= 0) {
        return;
    }

    const bool isFp16 = (tensor.dtype == 1);
    const int64_t alignElems = isFp16 ? 16 : 8;
    const int64_t maxBlocks = (totalElems + alignElems - 1) / alignElems;
    int64_t blockNum = availableCoreNum > 0 ? availableCoreNum : 1;
    if (blockNum > maxBlocks) {
        blockNum = maxBlocks;
    }
    if (blockNum < 1) {
        blockNum = 1;
    }

    if (isFp16) {
        sub_kernel_fp16<<<static_cast<uint32_t>(blockNum), nullptr, stream>>>(
            x, y, z, totalElems);
    } else {
        sub_kernel_fp32<<<static_cast<uint32_t>(blockNum), nullptr, stream>>>(
            x, y, z, totalElems);
    }
}