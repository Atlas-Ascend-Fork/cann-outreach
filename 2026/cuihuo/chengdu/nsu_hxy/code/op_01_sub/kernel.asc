#include <cmath>
#include "kernel_operator.h"
/*
 * Sub Kernel — Ascend C Direct Invocation
 * z = x - y, elementwise, fp16/fp32.
 */

namespace {
constexpr int64_t TILE_BYTES = 8192;          // per UB tile (x, y, z each)
constexpr int64_t MIN_ELEMS_PER_CORE = 1024;  // launch granularity
}  // namespace

template <typename T>
class KernelSub {
public:
    __aicore__ inline KernelSub() {}

    __aicore__ inline void Init(GM_ADDR x, GM_ADDR y, GM_ADDR z,
                                int64_t totalLength, int64_t blockLength)
    {
        int64_t start = static_cast<int64_t>(AscendC::GetBlockIdx()) * blockLength;
        length_ = totalLength - start;
        if (length_ > blockLength) {
            length_ = blockLength;
        }
        if (length_ < 0) {
            length_ = 0;
        }
        xGm_.SetGlobalBuffer((__gm__ T*)x + start, length_);
        yGm_.SetGlobalBuffer((__gm__ T*)y + start, length_);
        zGm_.SetGlobalBuffer((__gm__ T*)z + start, length_);

        tileElems_ = TILE_BYTES / static_cast<int64_t>(sizeof(T));
        pipe_.InitBuffer(inQueueX_, 1, tileElems_ * sizeof(T));
        pipe_.InitBuffer(inQueueY_, 1, tileElems_ * sizeof(T));
        pipe_.InitBuffer(outQueueZ_, 1, tileElems_ * sizeof(T));
    }

    __aicore__ inline void Process()
    {
        for (int64_t offset = 0; offset < length_; offset += tileElems_) {
            int64_t count = length_ - offset;
            if (count > tileElems_) {
                count = tileElems_;
            }
            CopyIn(offset, count);
            Compute(count);
            CopyOut(offset, count);
        }
    }

private:
    __aicore__ inline void CopyIn(int64_t offset, int64_t count)
    {
        AscendC::LocalTensor<T> xLocal = inQueueX_.AllocTensor<T>();
        AscendC::LocalTensor<T> yLocal = inQueueY_.AllocTensor<T>();

        AscendC::DataCopyExtParams params;
        params.blockCount = 1;
        params.blockLen = static_cast<uint32_t>(count * sizeof(T));
        params.srcStride = 0;
        params.dstStride = 0;
        AscendC::DataCopyPadExtParams<T> padParams{false, 0, 0, 0};
        AscendC::DataCopyPad(xLocal, xGm_[offset], params, padParams);
        AscendC::DataCopyPad(yLocal, yGm_[offset], params, padParams);

        inQueueX_.EnQue(xLocal);
        inQueueY_.EnQue(yLocal);
    }

    __aicore__ inline void Compute(int64_t count)
    {
        AscendC::LocalTensor<T> xLocal = inQueueX_.DeQue<T>();
        AscendC::LocalTensor<T> yLocal = inQueueY_.DeQue<T>();
        AscendC::LocalTensor<T> zLocal = outQueueZ_.AllocTensor<T>();

        AscendC::Sub(zLocal, xLocal, yLocal, static_cast<int32_t>(count));

        outQueueZ_.EnQue(zLocal);
        inQueueX_.FreeTensor(xLocal);
        inQueueY_.FreeTensor(yLocal);
    }

    __aicore__ inline void CopyOut(int64_t offset, int64_t count)
    {
        AscendC::LocalTensor<T> zLocal = outQueueZ_.DeQue<T>();
        AscendC::DataCopyExtParams params;
        params.blockCount = 1;
        params.blockLen = static_cast<uint32_t>(count * sizeof(T));
        params.srcStride = 0;
        params.dstStride = 0;
        AscendC::DataCopyPad(zGm_[offset], zLocal, params);
        outQueueZ_.FreeTensor(zLocal);
    }

    AscendC::TPipe pipe_;
    AscendC::GlobalTensor<T> xGm_, yGm_, zGm_;
    AscendC::TQue<AscendC::TPosition::VECIN, 1> inQueueX_, inQueueY_;
    AscendC::TQue<AscendC::TPosition::VECOUT, 1> outQueueZ_;
    int64_t length_ = 0;
    int64_t tileElems_ = 0;
};

template <typename T>
__global__ __aicore__ __vector__ void sub_custom(
    GM_ADDR x, GM_ADDR y, GM_ADDR z, int64_t totalLength, int64_t blockLength)
{
    KernelSub<T> op;
    op.Init(x, y, z, totalLength, blockLength);
    op.Process();
}

namespace {
inline int64_t TensorNumel(const TensorInfo& info)
{
    int64_t total = 1;
    for (int64_t i = 0; i < info.numDims; ++i) {
        total *= info.shape[i];
    }
    return total;
}
}  // namespace

extern "C" void run_kernel(
    GM_ADDR x,
    const TensorGroupInfo& info_x,
    GM_ADDR y,
    const TensorGroupInfo& info_y,
    GM_ADDR z,
    const TensorGroupInfo& info_z,
    int64_t availableCoreNum,
    aclrtStream stream)
{
    const TensorInfo& tx = info_x.tensors[0];
    int64_t totalLength = TensorNumel(tx);
    if (totalLength <= 0) {
        return;
    }

    int64_t coreNum = availableCoreNum > 0 ? availableCoreNum : 1;
    int64_t blockNum = (totalLength + MIN_ELEMS_PER_CORE - 1) / MIN_ELEMS_PER_CORE;
    if (blockNum > coreNum) {
        blockNum = coreNum;
    }
    if (blockNum < 1) {
        blockNum = 1;
    }

    // Keep every core's GM base 32-byte aligned for DataCopyPad.
    int64_t alignElems = 32 / static_cast<int64_t>(tx.dtype == 1 ? sizeof(half) : sizeof(float));
    int64_t blockLength = (totalLength + blockNum - 1) / blockNum;
    blockLength = ((blockLength + alignElems - 1) / alignElems) * alignElems;
    blockNum = (totalLength + blockLength - 1) / blockLength;

    if (tx.dtype == 1) {
        sub_custom<half><<<blockNum, nullptr, stream>>>(x, y, z, totalLength, blockLength);
    } else {
        sub_custom<float><<<blockNum, nullptr, stream>>>(x, y, z, totalLength, blockLength);
    }
}