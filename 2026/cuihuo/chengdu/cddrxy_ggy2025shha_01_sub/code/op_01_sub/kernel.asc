#include <cmath>
#include "kernel_operator.h"
/*
 * Sub Kernel — Ascend C Direct Invocation
 * This file is #included by the entry source. Do not add main().
 *
 * TensorGroupInfo / TensorInfo (predefined):
 *   #define GM_ADDR __gm__ uint8_t*
 *   struct TensorInfo {
 *       const int64_t* shape;
 *       int64_t numDims;
 *       int32_t dtype;
 *   };
 *   struct TensorGroupInfo {
 *       const TensorInfo* tensors;
 *       int64_t numTensors;
 *   };
 *   dtype: 0=float32 1=float16 2=bfloat16 3=int8 4=int16 5=int32 6=int64
 *          7=uint8 8=uint16 9=uint32 10=uint64 11=bool
 *          12=float64 13=complex32 14=complex64 15=complex128
 *   Usage: info_x.tensors[0].shape[0]  // first dim of first tensor in input x
 *
 * __global__ __vector__ void sub_custom(...)
 * {
 *     // TODO: implement your kernel logic
 *     // Available APIs: AscendC::TPipe, AscendC::TQue, AscendC::DataCopy, AscendC::Add, ...
 * }
 */

using namespace AscendC;

namespace {

constexpr int32_t kTileElem = 2048;  // elements per UB tile

template <typename T>
__aicore__ inline void SubBody(GM_ADDR x, GM_ADDR y, GM_ADDR z, int64_t total)
{
    constexpr int32_t kAlignElem = 32 / sizeof(T);  // 32B alignment in elements
    constexpr int32_t kTileBytes = kTileElem * sizeof(T);

    TPipe pipe;
    TQue<QuePosition::VECIN, 1> inX;
    TQue<QuePosition::VECIN, 1> inY;
    TQue<QuePosition::VECOUT, 1> outZ;
    pipe.InitBuffer(inX, 1, kTileBytes);
    pipe.InitBuffer(inY, 1, kTileBytes);
    pipe.InitBuffer(outZ, 1, kTileBytes);

    int64_t blockNum = static_cast<int64_t>(GetBlockNum());
    int64_t blockIdx = static_cast<int64_t>(GetBlockIdx());

    // Per-core chunk rounded up to 32B so every core start stays aligned.
    int64_t chunk = (total + blockNum - 1) / blockNum;
    chunk = (chunk + kAlignElem - 1) / kAlignElem * kAlignElem;

    int64_t start = blockIdx * chunk;
    if (start >= total) {
        return;
    }
    int64_t len = (total - start < chunk) ? (total - start) : chunk;

    GlobalTensor<T> gx;
    GlobalTensor<T> gy;
    GlobalTensor<T> gz;
    gx.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(x) + start, len);
    gy.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(y) + start, len);
    gz.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(z) + start, len);

    int64_t loops = (len + kTileElem - 1) / kTileElem;
    for (int64_t i = 0; i < loops; ++i) {
        int64_t off = i * kTileElem;
        int64_t n = (len - off < kTileElem) ? (len - off) : kTileElem;

        LocalTensor<T> lx = inX.AllocTensor<T>();
        LocalTensor<T> ly = inY.AllocTensor<T>();
        DataCopy(lx, gx[off], n);
        DataCopy(ly, gy[off], n);
        inX.EnQue(lx);
        inY.EnQue(ly);

        lx = inX.DeQue<T>();
        ly = inY.DeQue<T>();
        LocalTensor<T> lz = outZ.AllocTensor<T>();
        Sub(lz, lx, ly, n);
        inX.FreeTensor(lx);
        inY.FreeTensor(ly);
        outZ.EnQue(lz);

        lz = outZ.DeQue<T>();
        DataCopy(gz[off], lz, n);
        outZ.FreeTensor(lz);
    }
}

}  // namespace

template <typename T>
__global__ __vector__ void sub_custom(GM_ADDR x, GM_ADDR y, GM_ADDR z, int64_t total)
{
    SubBody<T>(x, y, z, total);
}

extern "C" void run_kernel(
    GM_ADDR x,
    const TensorGroupInfo& info_x,
    GM_ADDR y,
    const TensorGroupInfo& info_y,
    GM_ADDR z,
    const TensorGroupInfo& info_z,
    int64_t availableCoreNum,
    aclrtStream stream)
{
    (void)info_y;
    (void)info_z;

    int64_t total = 1;
    int64_t ndim = info_x.tensors[0].numDims;
    const int64_t* shape = info_x.tensors[0].shape;
    for (int64_t i = 0; i < ndim; ++i) {
        total *= shape[i];
    }

    int64_t tiles = (total + kTileElem - 1) / kTileElem;
    int64_t blockNum = (availableCoreNum > 0) ? availableCoreNum : 1;
    if (blockNum > tiles) {
        blockNum = tiles;
    }
    if (blockNum < 1) {
        blockNum = 1;
    }

    if (info_x.tensors[0].dtype == 1) {  // float16
        sub_custom<half><<<static_cast<uint32_t>(blockNum), nullptr, stream>>>(x, y, z, total);
    } else {  // float32
        sub_custom<float><<<static_cast<uint32_t>(blockNum), nullptr, stream>>>(x, y, z, total);
    }
}