  #include <cmath>
  #include "kernel_operator.h"
  /*
   * Sub Kernel — Ascend C Direct Invocation
   * This file is #included by the entry source. Do not add main().
   *
   * TensorGroupInfo / TensorInfo (predefined):
   *   #define GM_ADDR __gm__ uint8_t*
   *   struct TensorInfo {
   *       const int64_t* shape;
   *       int64_t numDims;
   *       int32_t dtype;
   *   };
   *   struct TensorGroupInfo {
   *       const TensorInfo* tensors;
   *       int64_t numTensors;
   *   };
   *   dtype: 0=float32 1=float16 2=bfloat16 3=int8 4=int16 5=int32 6=int64
   *          7=uint8 8=uint16 9=uint32 10=uint64 11=bool
   *          12=float64 13=complex32 14=complex64 15=complex128
   *   Usage: info_x.tensors[0].shape[0]  // first dim of first tensor in input x
   */

  constexpr int64_t SUB_TILE_ELEMENTS = 4096;
  constexpr int64_t SUB_ALIGN_ELEMENTS = 32;

  template <typename T>
  __global__ __vector__ void sub_custom(
      GM_ADDR x,
      GM_ADDR y,
      GM_ADDR z,
      int64_t totalLength,
      int64_t blockLength)
  {
      int64_t blockIdx = static_cast<int64_t>(AscendC::GetBlockIdx());
      int64_t offset = blockIdx * blockLength;
      if (offset >= totalLength) {
          return;
      }
      int64_t remainLength = totalLength - offset;
      int64_t curLength = remainLength < blockLength ? remainLength : blockLength;

      AscendC::TPipe pipe;
      AscendC::TQue<AscendC::TPosition::VECIN, 2> inQueueX;
      AscendC::TQue<AscendC::TPosition::VECIN, 2> inQueueY;
      AscendC::TQue<AscendC::TPosition::VECOUT, 2> outQueueZ;
      pipe.InitBuffer(inQueueX, 2, SUB_TILE_ELEMENTS * sizeof(T));
      pipe.InitBuffer(inQueueY, 2, SUB_TILE_ELEMENTS * sizeof(T));
      pipe.InitBuffer(outQueueZ, 2, SUB_TILE_ELEMENTS * sizeof(T));

      AscendC::GlobalTensor<T> xGm;
      AscendC::GlobalTensor<T> yGm;
      AscendC::GlobalTensor<T> zGm;
      xGm.SetGlobalBuffer((__gm__ T*)x + offset, curLength);
      yGm.SetGlobalBuffer((__gm__ T*)y + offset, curLength);
      zGm.SetGlobalBuffer((__gm__ T*)z + offset, curLength);

      AscendC::DataCopyExtParams copyParams{1, 0, 0, 0, 0};
      AscendC::DataCopyPadExtParams<T> padParams{false, 0, 0, 0};

      for (int64_t done = 0; done < curLength; done += SUB_TILE_ELEMENTS) {
          int64_t remain = curLength - done;
          uint32_t count = static_cast<uint32_t>(
              remain < SUB_TILE_ELEMENTS ? remain : SUB_TILE_ELEMENTS);
          copyParams.blockLen = count * sizeof(T);

          AscendC::LocalTensor<T> xLocal = inQueueX.AllocTensor<T>();
          AscendC::LocalTensor<T> yLocal = inQueueY.AllocTensor<T>();
          AscendC::DataCopyPad(xLocal, xGm[done], copyParams, padParams);
          AscendC::DataCopyPad(yLocal, yGm[done], copyParams, padParams);
          inQueueX.EnQue(xLocal);
          inQueueY.EnQue(yLocal);

          xLocal = inQueueX.DeQue<T>();
          yLocal = inQueueY.DeQue<T>();
          AscendC::LocalTensor<T> zLocal = outQueueZ.AllocTensor<T>();
          AscendC::Sub(zLocal, xLocal, yLocal, static_cast<int32_t>(count));
          outQueueZ.EnQue(zLocal);
          inQueueX.FreeTensor(xLocal);
          inQueueY.FreeTensor(yLocal);

          zLocal = outQueueZ.DeQue<T>();
          AscendC::DataCopyPad(zGm[done], zLocal, copyParams);
          outQueueZ.FreeTensor(zLocal);
      }
  }

  static int64_t get_element_count(const TensorGroupInfo& info)
  {
      if (info.tensors == nullptr || info.numTensors <= 0) {
          return 0;
      }
      const TensorInfo& tensor = info.tensors[0];
      if (tensor.shape == nullptr || tensor.numDims < 0) {
          return 0;
      }
      int64_t count = 1;
      for (int64_t i = 0; i < tensor.numDims; ++i) {
          if (tensor.shape[i] <= 0) {
              return 0;
          }
          count *= tensor.shape[i];
      }
      return count;
  }

  extern "C" void run_kernel(
      GM_ADDR x,
      const TensorGroupInfo& info_x,
      GM_ADDR y,
      const TensorGroupInfo& info_y,
      GM_ADDR z,
      const TensorGroupInfo& info_z,
      int64_t availableCoreNum,
      aclrtStream stream)
  {
      (void)info_y;
      (void)info_z;
      if (info_x.tensors == nullptr || info_x.numTensors <= 0) {
          return;
      }
      int32_t dtype = info_x.tensors[0].dtype;
      int64_t totalLength = get_element_count(info_x);
      if (totalLength <= 0 || availableCoreNum <= 0 || (dtype != 0 && dtype != 1)) {
          return;
      }

      int64_t blockNum = availableCoreNum < totalLength ? availableCoreNum : totalLength;
      int64_t blockLength = (totalLength + blockNum - 1) / blockNum;
      blockLength = (blockLength + SUB_ALIGN_ELEMENTS - 1) / SUB_ALIGN_ELEMENTS * SUB_ALIGN_ELEMENTS;
      blockNum = (totalLength + blockLength - 1) / blockLength;

      if (dtype == 0) {
          sub_custom<float><<<static_cast<uint32_t>(blockNum), nullptr, stream>>>(
              x, y, z, totalLength, blockLength);
      } else {
          sub_custom<half><<<static_cast<uint32_t>(blockNum), nullptr, stream>>>(
              x, y, z, totalLength, blockLength);
      }
  }