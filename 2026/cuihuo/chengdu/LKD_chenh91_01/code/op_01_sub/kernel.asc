#include <cmath>
#include "kernel_operator.h"
/*
 * Sub Kernel — Ascend C Direct Invocation
 * This file is #included — do NOT add main(), #pragma once, or include guards.
 *
 * TensorGroupInfo / TensorInfo (predefined):
 *   struct TensorInfo { const int64_t* shape; int64_t numDims; int32_t dtype; };
 *   struct TensorGroupInfo { const TensorInfo* tensors; int64_t numTensors; };
 *   dtype: 0=fp32 1=fp16 2=bf16 3=int8 4=int16 5=int32 6=int64 7=uint8 8=uint16 9=uint32 10=uint64 11=bool
 *   Usage: info_x.tensors[0].shape[0]  // first dim of first tensor in input x
 */

constexpr int64_t SUB_TILE_ELEMS = 4096;
constexpr int64_t SUB_MIN_ELEMS_CORE = 1024;
constexpr int32_t SUB_QUEUE_DEPTH = 2;

template <typename T>
class KernelSub {
public:
    __aicore__ inline explicit KernelSub(AscendC::TPipe* pipe) : pipe_(pipe) {}

    __aicore__ inline void Init(GM_ADDR x, GM_ADDR y, GM_ADDR z, int64_t totalLen, int64_t blockLen)
    {
        start_ = static_cast<int64_t>(AscendC::GetBlockIdx()) * blockLen;
        curLen_ = totalLen - start_;
        if (curLen_ > blockLen) {
            curLen_ = blockLen;
        }
        xGm_.SetGlobalBuffer((__gm__ T*)x, static_cast<uint64_t>(totalLen));
        yGm_.SetGlobalBuffer((__gm__ T*)y, static_cast<uint64_t>(totalLen));
        zGm_.SetGlobalBuffer((__gm__ T*)z, static_cast<uint64_t>(totalLen));
        pipe_->InitBuffer(inQueueX_, SUB_QUEUE_DEPTH, SUB_TILE_ELEMS * sizeof(T));
        pipe_->InitBuffer(inQueueY_, SUB_QUEUE_DEPTH, SUB_TILE_ELEMS * sizeof(T));
        pipe_->InitBuffer(outQueueZ_, SUB_QUEUE_DEPTH, SUB_TILE_ELEMS * sizeof(T));
    }

    __aicore__ inline void Process()
    {
        if (curLen_ <= 0) {
            return;
        }
        for (int64_t offset = 0; offset < curLen_; offset += SUB_TILE_ELEMS) {
            int64_t count = curLen_ - offset;
            if (count > SUB_TILE_ELEMS) {
                count = SUB_TILE_ELEMS;
            }
            CopyIn(offset, count);
            Compute(count);
            CopyOut(offset, count);
        }
    }

private:
    __aicore__ inline void CopyIn(int64_t offset, int64_t count)
    {
        AscendC::DataCopyExtParams copyParams{1, static_cast<uint32_t>(count * sizeof(T)), 0, 0, 0};
        AscendC::DataCopyPadExtParams<T> padParams{false, 0, 0, 0};
        AscendC::LocalTensor<T> xLocal = inQueueX_.AllocTensor<T>();
        AscendC::LocalTensor<T> yLocal = inQueueY_.AllocTensor<T>();
        AscendC::DataCopyPad(xLocal, xGm_[start_ + offset], copyParams, padParams);
        AscendC::DataCopyPad(yLocal, yGm_[start_ + offset], copyParams, padParams);
        inQueueX_.EnQue(xLocal);
        inQueueY_.EnQue(yLocal);
    }

    __aicore__ inline void Compute(int64_t count)
    {
        AscendC::LocalTensor<T> xLocal = inQueueX_.DeQue<T>();
        AscendC::LocalTensor<T> yLocal = inQueueY_.DeQue<T>();
        AscendC::LocalTensor<T> zLocal = outQueueZ_.AllocTensor<T>();
        AscendC::Sub(zLocal, xLocal, yLocal, static_cast<int32_t>(count));
        outQueueZ_.EnQue(zLocal);
        inQueueX_.FreeTensor(xLocal);
        inQueueY_.FreeTensor(yLocal);
    }

    __aicore__ inline void CopyOut(int64_t offset, int64_t count)
    {
        AscendC::DataCopyExtParams copyParams{1, static_cast<uint32_t>(count * sizeof(T)), 0, 0, 0};
        AscendC::LocalTensor<T> zLocal = outQueueZ_.DeQue<T>();
        AscendC::DataCopyPad(zGm_[start_ + offset], zLocal, copyParams);
        outQueueZ_.FreeTensor(zLocal);
    }

    AscendC::TPipe* pipe_;
    AscendC::GlobalTensor<T> xGm_;
    AscendC::GlobalTensor<T> yGm_;
    AscendC::GlobalTensor<T> zGm_;
    AscendC::TQue<AscendC::TPosition::VECIN, SUB_QUEUE_DEPTH> inQueueX_;
    AscendC::TQue<AscendC::TPosition::VECIN, SUB_QUEUE_DEPTH> inQueueY_;
    AscendC::TQue<AscendC::TPosition::VECOUT, SUB_QUEUE_DEPTH> outQueueZ_;
    int64_t start_ = 0;
    int64_t curLen_ = 0;
};

template <typename T>
__global__ __vector__ void sub_custom(GM_ADDR x, GM_ADDR y, GM_ADDR z, int64_t totalLen, int64_t blockLen)
{
    AscendC::TPipe pipe;
    KernelSub<T> op(&pipe);
    op.Init(x, y, z, totalLen, blockLen);
    op.Process();
}

extern "C" void run_kernel(GM_ADDR x, const TensorGroupInfo& info_x, GM_ADDR y, const TensorGroupInfo& info_y,
                           GM_ADDR z, const TensorGroupInfo& info_z, int64_t availableCoreNum, aclrtStream stream)
{
    const TensorInfo& tensorX = info_x.tensors[0];
    int64_t totalLen = 1;
    for (int64_t i = 0; i < tensorX.numDims; ++i) {
        totalLen *= tensorX.shape[i];
    }
    if (totalLen <= 0) {
        return;
    }

    int64_t alignElems = (tensorX.dtype == 0) ? 8 : 16;
    int64_t coreNum = (availableCoreNum > 0) ? availableCoreNum : 1;
    int64_t blockNum = (totalLen + SUB_MIN_ELEMS_CORE - 1) / SUB_MIN_ELEMS_CORE;
    if (blockNum > coreNum) {
        blockNum = coreNum;
    }
    if (blockNum < 1) {
        blockNum = 1;
    }
    int64_t blockLen = (totalLen + blockNum - 1) / blockNum;
    blockLen = (blockLen + alignElems - 1) / alignElems * alignElems;
    uint32_t blockDim = static_cast<uint32_t>(blockNum);

    if (tensorX.dtype == 0) {
        sub_custom<float><<<blockDim, nullptr, stream>>>(x, y, z, totalLen, blockLen);
    } else if (tensorX.dtype == 1) {
        sub_custom<half><<<blockDim, nullptr, stream>>>(x, y, z, totalLen, blockLen);
    }
}