#include <cmath>
#include "kernel_operator.h"
/*
 * Sub Kernel — Ascend C Direct Invocation
 * This file is #included by the entry source. Do not add main().
 *
 * TensorGroupInfo / TensorInfo (predefined):
 *   #define GM_ADDR __gm__ uint8_t*
 *   struct TensorInfo {
 *       const int64_t* shape;
 *       int64_t numDims;
 *       int32_t dtype;
 *   };
 *   struct TensorGroupInfo {
 *       const TensorInfo* tensors;
 *       int64_t numTensors;
 *   };
 *   dtype: 0=float32 1=float16 2=bfloat16 3=int8 4=int16 5=int32 6=int64
 *          7=uint8 8=uint16 9=uint32 10=uint64 11=bool
 *          12=float64 13=complex32 14=complex64 15=complex128
 *   Usage: info_x.tensors[0].shape[0]  // first dim of first tensor in input x
 *
 * __global__ __vector__ void sub_custom(...)
 * {
 *     // TODO: implement your kernel logic
 *     // Available APIs: AscendC::TPipe, AscendC::TQue, AscendC::DataCopy, AscendC::Add, ...
 * }
 */

constexpr uint32_t kTotalElems = 8 * 2048;
constexpr uint32_t kTileElems = 1024;

template <typename T>
class KernelSub {
public:
    __aicore__ inline explicit KernelSub(AscendC::TPipe* pipe) : pipe_(pipe)
    {
    }

    __aicore__ inline void Init(GM_ADDR x, GM_ADDR y, GM_ADDR z)
    {
        uint32_t blockNum = static_cast<uint32_t>(AscendC::GetBlockNum());
        uint32_t blockIdx = static_cast<uint32_t>(AscendC::GetBlockIdx());
        uint32_t chunk = kTotalElems / blockNum;
        uint32_t start = blockIdx * chunk;
        tileNum_ = chunk / kTileElems;

        xGm_.SetGlobalBuffer((__gm__ T*)x + start, chunk);
        yGm_.SetGlobalBuffer((__gm__ T*)y + start, chunk);
        zGm_.SetGlobalBuffer((__gm__ T*)z + start, chunk);

        pipe_->InitBuffer(inQueueX_, 1, kTileElems * sizeof(T));
        pipe_->InitBuffer(inQueueY_, 1, kTileElems * sizeof(T));
        pipe_->InitBuffer(outQueueZ_, 1, kTileElems * sizeof(T));
    }

    __aicore__ inline void Process()
    {
        for (uint32_t i = 0; i < tileNum_; ++i) {
            CopyIn(i);
            Compute();
            CopyOut(i);
        }
    }

private:
    __aicore__ inline void CopyIn(uint32_t i)
    {
        AscendC::LocalTensor<T> xLocal = inQueueX_.AllocTensor<T>();
        AscendC::LocalTensor<T> yLocal = inQueueY_.AllocTensor<T>();
        AscendC::DataCopy(xLocal, xGm_[i * kTileElems], kTileElems);
        AscendC::DataCopy(yLocal, yGm_[i * kTileElems], kTileElems);
        inQueueX_.EnQue(xLocal);
        inQueueY_.EnQue(yLocal);
    }

    __aicore__ inline void Compute()
    {
        AscendC::LocalTensor<T> xLocal = inQueueX_.DeQue<T>();
        AscendC::LocalTensor<T> yLocal = inQueueY_.DeQue<T>();
        AscendC::LocalTensor<T> zLocal = outQueueZ_.AllocTensor<T>();
        AscendC::Sub(zLocal, xLocal, yLocal, static_cast<int32_t>(kTileElems));
        outQueueZ_.EnQue<T>(zLocal);
        inQueueX_.FreeTensor(xLocal);
        inQueueY_.FreeTensor(yLocal);
    }

    __aicore__ inline void CopyOut(uint32_t i)
    {
        AscendC::LocalTensor<T> zLocal = outQueueZ_.DeQue<T>();
        AscendC::DataCopy(zGm_[i * kTileElems], zLocal, kTileElems);
        outQueueZ_.FreeTensor(zLocal);
    }

    AscendC::TPipe* pipe_;
    AscendC::GlobalTensor<T> xGm_;
    AscendC::GlobalTensor<T> yGm_;
    AscendC::GlobalTensor<T> zGm_;
    AscendC::TQue<AscendC::TPosition::VECIN, 1> inQueueX_;
    AscendC::TQue<AscendC::TPosition::VECIN, 1> inQueueY_;
    AscendC::TQue<AscendC::TPosition::VECOUT, 1> outQueueZ_;
    uint32_t tileNum_;
};

extern "C" __global__ __vector__ void sub_custom_fp32(GM_ADDR x, GM_ADDR y, GM_ADDR z)
{
    AscendC::TPipe pipe;
    KernelSub<float> op(&pipe);
    op.Init(x, y, z);
    op.Process();
}

extern "C" __global__ __vector__ void sub_custom_fp16(GM_ADDR x, GM_ADDR y, GM_ADDR z)
{
    AscendC::TPipe pipe;
    KernelSub<half> op(&pipe);
    op.Init(x, y, z);
    op.Process();
}

extern "C" void run_kernel(
    GM_ADDR x,
    const TensorGroupInfo& info_x,
    GM_ADDR y,
    const TensorGroupInfo& info_y,
    GM_ADDR z,
    const TensorGroupInfo& info_z,
    int64_t availableCoreNum,
    aclrtStream stream)
{
    uint32_t blockNum = availableCoreNum > 16 ? 16u : static_cast<uint32_t>(availableCoreNum);
    if (blockNum == 0) {
        blockNum = 1;
    }
    while (blockNum & (blockNum - 1)) {
        blockNum &= blockNum - 1;
    }

    int32_t dtype = info_x.numTensors > 0 ? info_x.tensors[0].dtype : 0;
    if (dtype == 1) {
        sub_custom_fp16<<<blockNum, nullptr, stream>>>(x, y, z);
    } else {
        sub_custom_fp32<<<blockNum, nullptr, stream>>>(x, y, z);
    }
}