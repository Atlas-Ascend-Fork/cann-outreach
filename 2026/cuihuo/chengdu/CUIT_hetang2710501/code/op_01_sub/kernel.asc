#include <cstdint>
#include "kernel_operator.h"

/*
 * Sub Kernel — Ascend C Direct Invocation
 * z = x - y, element-wise, fp32/fp16, shape {8, 2048}.
 */

namespace {
constexpr uint32_t TILE_LENGTH = 4096;
constexpr uint32_t BUFFER_DEPTH = 1;

template <typename T>
class KernelSub {
public:
    __aicore__ inline explicit KernelSub(AscendC::TPipe* pipe) : pipe_(pipe) {}

    __aicore__ inline void Init(GM_ADDR x, GM_ADDR y, GM_ADDR z,
                                uint32_t totalLength, uint32_t perCore)
    {
        uint32_t blockIdx = AscendC::GetBlockIdx();
        uint32_t offset = blockIdx * perCore;
        if (offset < totalLength) {
            uint32_t remaining = totalLength - offset;
            length_ = remaining < perCore ? remaining : perCore;
        } else {
            length_ = 0;
        }
        xGm_.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(x) + offset, length_);
        yGm_.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(y) + offset, length_);
        zGm_.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(z) + offset, length_);

        pipe_->InitBuffer(inQueueX_, BUFFER_DEPTH, TILE_LENGTH * sizeof(T));
        pipe_->InitBuffer(inQueueY_, BUFFER_DEPTH, TILE_LENGTH * sizeof(T));
        pipe_->InitBuffer(outQueueZ_, BUFFER_DEPTH, TILE_LENGTH * sizeof(T));
    }

    __aicore__ inline void Process()
    {
        for (uint32_t i = 0; i < length_; i += TILE_LENGTH) {
            uint32_t remaining = length_ - i;
            uint32_t count = remaining < TILE_LENGTH ? remaining : TILE_LENGTH;
            CopyIn(i, count);
            Compute(count);
            CopyOut(i, count);
        }
    }

private:
    __aicore__ inline void CopyIn(uint32_t offset, uint32_t count)
    {
        AscendC::LocalTensor<T> xLocal = inQueueX_.AllocTensor<T>();
        AscendC::LocalTensor<T> yLocal = inQueueY_.AllocTensor<T>();
        AscendC::DataCopyPad(xLocal, xGm_[offset],
            {1, static_cast<uint16_t>(count * sizeof(T)), 0, 0},
            {false, 0, 0, 0});
        AscendC::DataCopyPad(yLocal, yGm_[offset],
            {1, static_cast<uint16_t>(count * sizeof(T)), 0, 0},
            {false, 0, 0, 0});
        inQueueX_.EnQue(xLocal);
        inQueueY_.EnQue(yLocal);
    }

    __aicore__ inline void Compute(uint32_t count)
    {
        AscendC::LocalTensor<T> xLocal = inQueueX_.DeQue<T>();
        AscendC::LocalTensor<T> yLocal = inQueueY_.DeQue<T>();
        AscendC::LocalTensor<T> zLocal = outQueueZ_.AllocTensor<T>();
        AscendC::Sub(zLocal, xLocal, yLocal, count);
        outQueueZ_.EnQue<T>(zLocal);
        inQueueX_.FreeTensor(xLocal);
        inQueueY_.FreeTensor(yLocal);
    }

    __aicore__ inline void CopyOut(uint32_t offset, uint32_t count)
    {
        AscendC::LocalTensor<T> zLocal = outQueueZ_.DeQue<T>();
        AscendC::DataCopyPad(zGm_[offset], zLocal,
            {1, static_cast<uint16_t>(count * sizeof(T)), 0, 0});
        outQueueZ_.FreeTensor(zLocal);
    }

    AscendC::TPipe* pipe_;
    AscendC::GlobalTensor<T> xGm_;
    AscendC::GlobalTensor<T> yGm_;
    AscendC::GlobalTensor<T> zGm_;
    AscendC::TQue<AscendC::TPosition::VECIN, BUFFER_DEPTH> inQueueX_;
    AscendC::TQue<AscendC::TPosition::VECIN, BUFFER_DEPTH> inQueueY_;
    AscendC::TQue<AscendC::TPosition::VECOUT, BUFFER_DEPTH> outQueueZ_;
    uint32_t length_ = 0;
};

__global__ __vector__ void sub_kernel_fp32(GM_ADDR x, GM_ADDR y, GM_ADDR z,
                                           uint32_t totalLength, uint32_t perCore)
{
    AscendC::TPipe pipe;
    KernelSub<float> op(&pipe);
    op.Init(x, y, z, totalLength, perCore);
    op.Process();
}

__global__ __vector__ void sub_kernel_fp16(GM_ADDR x, GM_ADDR y, GM_ADDR z,
                                           uint32_t totalLength, uint32_t perCore)
{
    AscendC::TPipe pipe;
    KernelSub<half> op(&pipe);
    op.Init(x, y, z, totalLength, perCore);
    op.Process();
}
}  // namespace

extern "C" void run_kernel(
    GM_ADDR x,
    const TensorGroupInfo& info_x,
    GM_ADDR y,
    const TensorGroupInfo& info_y,
    GM_ADDR z,
    const TensorGroupInfo& info_z,
    int64_t availableCoreNum,
    aclrtStream stream)
{
    int64_t totalLength = 1;
    const TensorInfo& shape = info_x.tensors[0];
    for (int64_t i = 0; i < shape.numDims; ++i)
        totalLength *= shape.shape[i];
    if (totalLength <= 0)
        return;

    uint32_t totalTiles =
        static_cast<uint32_t>((totalLength + TILE_LENGTH - 1) / TILE_LENGTH);
    uint32_t blockNum =
        availableCoreNum > 0 ? static_cast<uint32_t>(availableCoreNum) : 1;
    if (blockNum > totalTiles)
        blockNum = totalTiles;
    uint32_t tilesPerCore = (totalTiles + blockNum - 1) / blockNum;
    blockNum = (totalTiles + tilesPerCore - 1) / tilesPerCore;
    uint32_t perCore = tilesPerCore * TILE_LENGTH;

    if (shape.dtype == 1) {
        sub_kernel_fp16<<<blockNum, nullptr, stream>>>(
            x, y, z, static_cast<uint32_t>(totalLength), perCore);
    } else {
        sub_kernel_fp32<<<blockNum, nullptr, stream>>>(
            x, y, z, static_cast<uint32_t>(totalLength), perCore);
    }
}