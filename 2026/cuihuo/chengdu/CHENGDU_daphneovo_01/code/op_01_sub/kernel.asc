#include <cmath>
#include <cstdint>
#include "kernel_operator.h"
/*
 * Sub Kernel — Ascend C Direct Invocation
 * This file is #included by the entry source. Do not add main().
 *
 * z = x - y, elementwise; supports float32 (dtype 0) and float16 (dtype 1).
 */

namespace {
constexpr uint32_t BUFFER_NUM = 2;
constexpr uint32_t MAX_TILE_ELEMS = 4096;

template <typename T>
class KernelSub {
public:
    __aicore__ inline KernelSub() {}

    __aicore__ inline void Init(GM_ADDR x, GM_ADDR y, GM_ADDR z, uint32_t totalLength)
    {
        uint32_t blockNum = AscendC::GetBlockNum();
        uint32_t blockIdx = AscendC::GetBlockIdx();

        // Round the per-core span up to 32 bytes so every GM base stays aligned.
        uint32_t alignElems = 32u / sizeof(T);
        perCore = (totalLength + blockNum - 1) / blockNum;
        perCore = (perCore + alignElems - 1) / alignElems * alignElems;

        uint32_t start = blockIdx * perCore;
        if (start >= totalLength) {
            perCore = 0;
            return;
        }
        uint32_t remain = totalLength - start;
        perCore = remain < perCore ? remain : perCore;

        xGm.SetGlobalBuffer((__gm__ T*)x + start, perCore);
        yGm.SetGlobalBuffer((__gm__ T*)y + start, perCore);
        zGm.SetGlobalBuffer((__gm__ T*)z + start, perCore);

        tileElems = perCore < MAX_TILE_ELEMS ? perCore : MAX_TILE_ELEMS;
        uint32_t tileBytes = static_cast<uint32_t>(tileElems * sizeof(T));
        tileBytes = (tileBytes + 31u) / 32u * 32u;
        pipe.InitBuffer(inQueueX, BUFFER_NUM, tileBytes);
        pipe.InitBuffer(inQueueY, BUFFER_NUM, tileBytes);
        pipe.InitBuffer(outQueueZ, BUFFER_NUM, tileBytes);
    }

    __aicore__ inline void Process()
    {
        for (uint32_t offset = 0; offset < perCore; offset += tileElems) {
            uint32_t count = perCore - offset < tileElems ? perCore - offset : tileElems;
            CopyIn(offset, count);
            Compute(count);
            CopyOut(offset, count);
        }
    }

private:
    __aicore__ inline void CopyIn(uint32_t offset, uint32_t count)
    {
        AscendC::LocalTensor<T> xLocal = inQueueX.template AllocTensor<T>();
        AscendC::LocalTensor<T> yLocal = inQueueY.template AllocTensor<T>();
        AscendC::DataCopyExtParams copyParams(
            1, static_cast<uint32_t>(count * sizeof(T)), 0, 0, 0);
        AscendC::DataCopyPadExtParams<T> padParams(false, 0, 0, 0);
        AscendC::DataCopyPad(xLocal, xGm[offset], copyParams, padParams);
        AscendC::DataCopyPad(yLocal, yGm[offset], copyParams, padParams);
        inQueueX.EnQue(xLocal);
        inQueueY.EnQue(yLocal);
    }

    __aicore__ inline void Compute(uint32_t count)
    {
        AscendC::LocalTensor<T> xLocal = inQueueX.template DeQue<T>();
        AscendC::LocalTensor<T> yLocal = inQueueY.template DeQue<T>();
        AscendC::LocalTensor<T> zLocal = outQueueZ.template AllocTensor<T>();
        AscendC::Sub(zLocal, xLocal, yLocal, static_cast<int32_t>(count));
        outQueueZ.EnQue<T>(zLocal);
        inQueueX.FreeTensor(xLocal);
        inQueueY.FreeTensor(yLocal);
    }

    __aicore__ inline void CopyOut(uint32_t offset, uint32_t count)
    {
        AscendC::LocalTensor<T> zLocal = outQueueZ.template DeQue<T>();
        AscendC::DataCopyExtParams copyParams(
            1, static_cast<uint32_t>(count * sizeof(T)), 0, 0, 0);
        AscendC::DataCopyPad(zGm[offset], zLocal, copyParams);
        outQueueZ.FreeTensor(zLocal);
    }

private:
    AscendC::TPipe pipe;
    AscendC::TQue<AscendC::TPosition::VECIN, BUFFER_NUM> inQueueX, inQueueY;
    AscendC::TQue<AscendC::TPosition::VECOUT, BUFFER_NUM> outQueueZ;
    AscendC::GlobalTensor<T> xGm;
    AscendC::GlobalTensor<T> yGm;
    AscendC::GlobalTensor<T> zGm;
    uint32_t perCore = 0;
    uint32_t tileElems = 0;
};

__global__ __vector__ void sub_custom(GM_ADDR x, GM_ADDR y, GM_ADDR z,
                                     uint32_t totalLength, uint32_t dtype)
{
    if (dtype == 1) {
        KernelSub<half> op;
        op.Init(x, y, z, totalLength);
        op.Process();
    } else {
        KernelSub<float> op;
        op.Init(x, y, z, totalLength);
        op.Process();
    }
}
} // namespace

extern "C" void run_kernel(
    GM_ADDR x,
    const TensorGroupInfo& info_x,
    GM_ADDR y,
    const TensorGroupInfo& info_y,
    GM_ADDR z,
    const TensorGroupInfo& info_z,
    int64_t availableCoreNum,
    aclrtStream stream)
{
    (void)info_y;
    (void)info_z;

    uint64_t totalLength = 1;
    const TensorInfo& tx = info_x.tensors[0];
    for (int64_t i = 0; i < tx.numDims; ++i)
        totalLength *= static_cast<uint64_t>(tx.shape[i]);

    uint64_t blockNum = availableCoreNum > 0 ? static_cast<uint64_t>(availableCoreNum) : 1;
    while (blockNum > 1 && totalLength % blockNum != 0)
        --blockNum;

    sub_custom<<<static_cast<uint32_t>(blockNum), nullptr, stream>>>(
        x, y, z, static_cast<uint32_t>(totalLength), static_cast<uint32_t>(tx.dtype));
}