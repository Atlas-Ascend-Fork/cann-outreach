#include <cstdint>
#include "kernel_operator.h"
/*
 * Sub Kernel — Ascend C Direct Invocation
 * This file is #included by the entry source. Do not add main().
 *
 * TensorGroupInfo / TensorInfo (predefined):
 *   #define GM_ADDR __gm__ uint8_t*
 *   struct TensorInfo {
 *       const int64_t* shape;
 *       int64_t numDims;
 *       int32_t dtype;
 *   };
 *   struct TensorGroupInfo {
 *       const TensorInfo* tensors;
 *       int64_t numTensors;
 *   };
 *   dtype: 0=float32 1=float16 2=bfloat16 3=int8 4=int16 5=int32 6=int64
 *          7=uint8 8=uint16 9=uint32 10=uint64 11=bool
 *          12=float64 13=complex32 14=complex64 15=complex128
 */

namespace {
constexpr uint32_t SUB_PIPELINE_DEPTH = 2;
constexpr uint32_t SUB_TILE_LENGTH = 1024;
constexpr int64_t SUB_MIN_ELEMS_PER_CORE = 1024;

template <typename T>
__aicore__ inline void SubBody(GM_ADDR x, GM_ADDR y, GM_ADDR z,
                               int64_t totalLength, int64_t blockLength)
{
    int64_t blockIdx = static_cast<int64_t>(AscendC::GetBlockIdx());
    int64_t offset = blockIdx * blockLength;
    int64_t current = totalLength - offset;
    if (current <= 0) {
        return;
    }
    if (current > blockLength) {
        current = blockLength;
    }

    AscendC::TPipe pipe;
    AscendC::GlobalTensor<T> xGm;
    AscendC::GlobalTensor<T> yGm;
    AscendC::GlobalTensor<T> zGm;
    xGm.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(x) + offset, static_cast<uint64_t>(current));
    yGm.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(y) + offset, static_cast<uint64_t>(current));
    zGm.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(z) + offset, static_cast<uint64_t>(current));

    AscendC::TQue<AscendC::QuePosition::VECIN, SUB_PIPELINE_DEPTH> inQueueX;
    AscendC::TQue<AscendC::QuePosition::VECIN, SUB_PIPELINE_DEPTH> inQueueY;
    AscendC::TQue<AscendC::QuePosition::VECOUT, SUB_PIPELINE_DEPTH> outQueueZ;
    pipe.InitBuffer(inQueueX, SUB_PIPELINE_DEPTH,
                    static_cast<uint32_t>(SUB_TILE_LENGTH * sizeof(T)));
    pipe.InitBuffer(inQueueY, SUB_PIPELINE_DEPTH,
                    static_cast<uint32_t>(SUB_TILE_LENGTH * sizeof(T)));
    pipe.InitBuffer(outQueueZ, SUB_PIPELINE_DEPTH,
                    static_cast<uint32_t>(SUB_TILE_LENGTH * sizeof(T)));

    for (int64_t pos = 0; pos < current; pos += SUB_TILE_LENGTH) {
        int64_t count = current - pos;
        if (count > static_cast<int64_t>(SUB_TILE_LENGTH)) {
            count = static_cast<int64_t>(SUB_TILE_LENGTH);
        }
        AscendC::DataCopyExtParams copyParams{
            1, static_cast<uint32_t>(count * sizeof(T)), 0, 0, 0};
        AscendC::DataCopyPadExtParams<T> padParams{false, 0, 0, static_cast<T>(0)};

        auto xLocal = inQueueX.AllocTensor<T>();
        auto yLocal = inQueueY.AllocTensor<T>();
        AscendC::DataCopyPad(xLocal, xGm[pos], copyParams, padParams);
        AscendC::DataCopyPad(yLocal, yGm[pos], copyParams, padParams);
        inQueueX.EnQue(xLocal);
        inQueueY.EnQue(yLocal);

        xLocal = inQueueX.DeQue<T>();
        yLocal = inQueueY.DeQue<T>();
        auto zLocal = outQueueZ.AllocTensor<T>();
        AscendC::Sub(zLocal, xLocal, yLocal, static_cast<int32_t>(count));
        outQueueZ.EnQue(zLocal);
        inQueueX.FreeTensor(xLocal);
        inQueueY.FreeTensor(yLocal);

        zLocal = outQueueZ.DeQue<T>();
        AscendC::DataCopyPad(zGm[pos], zLocal, copyParams);
        outQueueZ.FreeTensor(zLocal);
    }
}
}  // namespace

__global__ __vector__ void sub_custom_float(GM_ADDR x, GM_ADDR y, GM_ADDR z,
                                            int64_t totalLength, int64_t blockLength)
{
    SubBody<float>(x, y, z, totalLength, blockLength);
}

__global__ __vector__ void sub_custom_half(GM_ADDR x, GM_ADDR y, GM_ADDR z,
                                           int64_t totalLength, int64_t blockLength)
{
    SubBody<half>(x, y, z, totalLength, blockLength);
}

static int64_t GetTotalLength(const TensorGroupInfo& info)
{
    if (info.numTensors <= 0 || info.tensors == nullptr) {
        return 0;
    }
    const TensorInfo& tensor = info.tensors[0];
    int64_t total = 1;
    for (int64_t i = 0; i < tensor.numDims; ++i) {
        total *= tensor.shape[i];
    }
    return total;
}

extern "C" void run_kernel(
    GM_ADDR x,
    const TensorGroupInfo& info_x,
    GM_ADDR y,
    const TensorGroupInfo& info_y,
    GM_ADDR z,
    const TensorGroupInfo& info_z,
    int64_t availableCoreNum,
    aclrtStream stream)
{
    int64_t totalLength = GetTotalLength(info_x);
    if (totalLength <= 0) {
        return;
    }

    int64_t numBlocks =
        (totalLength + SUB_MIN_ELEMS_PER_CORE - 1) / SUB_MIN_ELEMS_PER_CORE;
    if (availableCoreNum > 0 && numBlocks > availableCoreNum) {
        numBlocks = availableCoreNum;
    }
    if (numBlocks < 1) {
        numBlocks = 1;
    }
    int64_t blockLength = (totalLength + numBlocks - 1) / numBlocks;
    uint32_t launchBlocks = static_cast<uint32_t>(numBlocks);

    int32_t dtype = info_x.tensors[0].dtype;
    if (dtype == 1) {
        sub_custom_half<<<launchBlocks, nullptr, stream>>>(
            x, y, z, totalLength, blockLength);
    } else {
        sub_custom_float<<<launchBlocks, nullptr, stream>>>(
            x, y, z, totalLength, blockLength);
    }
}