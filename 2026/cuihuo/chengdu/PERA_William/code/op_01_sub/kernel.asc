#include <cmath>
#include "kernel_operator.h"
/*
 * Sub Kernel — Ascend C Direct Invocation
 * This file is #included by the entry source. Do not add main().
 *
 * TensorGroupInfo / TensorInfo (predefined):
 *   #define GM_ADDR __gm__ uint8_t*
 *   struct TensorInfo {
 *       const int64_t* shape;
 *       int64_t numDims;
 *       int32_t dtype;
 *   };
 *   struct TensorGroupInfo {
 *       const TensorInfo* tensors;
 *       int64_t numTensors;
 *   };
 *   dtype: 0=float32 1=float16 2=bfloat16 3=int8 4=int16 5=int32 6=int64
 *          7=uint8 8=uint16 9=uint32 10=uint64 11=bool
 *          12=float64 13=complex32 14=complex64 15=complex128
 *   Usage: info_x.tensors[0].shape[0]  // first dim of first tensor in input x
 */

namespace {
constexpr uint32_t TILE_ELEMENTS = 2048;
constexpr uint32_t PIPELINE_DEPTH = 2;

template <typename T>
__global__ __vector__ void sub_custom(GM_ADDR x, GM_ADDR y, GM_ADDR z,
                                      int64_t totalLength, uint32_t tileElements)
{
    AscendC::TPipe pipe;
    AscendC::TQue<AscendC::TPosition::VECIN, PIPELINE_DEPTH> inQueueX;
    AscendC::TQue<AscendC::TPosition::VECIN, PIPELINE_DEPTH> inQueueY;
    AscendC::TQue<AscendC::TPosition::VECOUT, PIPELINE_DEPTH> outQueueZ;
    pipe.InitBuffer(inQueueX, PIPELINE_DEPTH, tileElements * sizeof(T));
    pipe.InitBuffer(inQueueY, PIPELINE_DEPTH, tileElements * sizeof(T));
    pipe.InitBuffer(outQueueZ, PIPELINE_DEPTH, tileElements * sizeof(T));

    AscendC::GlobalTensor<T> xGm, yGm, zGm;
    xGm.SetGlobalBuffer((__gm__ T*)x, totalLength);
    yGm.SetGlobalBuffer((__gm__ T*)y, totalLength);
    zGm.SetGlobalBuffer((__gm__ T*)z, totalLength);

    const int64_t tileNum = (totalLength + tileElements - 1) / tileElements;
    const int64_t blockNum = AscendC::GetBlockNum();
    for (int64_t tile = AscendC::GetBlockIdx(); tile < tileNum; tile += blockNum) {
        const int64_t offset = tile * static_cast<int64_t>(tileElements);
        const int64_t remain = totalLength - offset;
        const uint32_t count = remain < static_cast<int64_t>(tileElements)
                                   ? static_cast<uint32_t>(remain)
                                   : tileElements;

        AscendC::DataCopyExtParams params;
        params.blockCount = 1;
        params.blockLen = count * static_cast<uint32_t>(sizeof(T));
        params.srcStride = 0;
        params.dstStride = 0;
        AscendC::DataCopyPadExtParams<T> pad;

        AscendC::LocalTensor<T> xLocal = inQueueX.AllocTensor<T>();
        AscendC::LocalTensor<T> yLocal = inQueueY.AllocTensor<T>();
        AscendC::DataCopyPad(xLocal, xGm[offset], params, pad);
        AscendC::DataCopyPad(yLocal, yGm[offset], params, pad);
        inQueueX.EnQue(xLocal);
        inQueueY.EnQue(yLocal);

        xLocal = inQueueX.DeQue<T>();
        yLocal = inQueueY.DeQue<T>();
        AscendC::LocalTensor<T> zLocal = outQueueZ.AllocTensor<T>();
        AscendC::Sub(zLocal, xLocal, yLocal, static_cast<int32_t>(count));
        outQueueZ.EnQue(zLocal);
        inQueueX.FreeTensor(xLocal);
        inQueueY.FreeTensor(yLocal);

        zLocal = outQueueZ.DeQue<T>();
        AscendC::DataCopyPad(zGm[offset], zLocal, params);
        outQueueZ.FreeTensor(zLocal);
    }
}
}  // namespace

extern "C" void run_kernel(
    GM_ADDR x,
    const TensorGroupInfo& info_x,
    GM_ADDR y,
    const TensorGroupInfo& info_y,
    GM_ADDR z,
    const TensorGroupInfo& info_z,
    int64_t availableCoreNum,
    aclrtStream stream)
{
    int64_t totalLength = 1;
    for (int64_t d = 0; d < info_x.tensors[0].numDims; ++d)
        totalLength *= info_x.tensors[0].shape[d];
    if (totalLength <= 0)
        return;

    const int64_t tileNum = (totalLength + TILE_ELEMENTS - 1) / TILE_ELEMENTS;
    int64_t blockNum = availableCoreNum > 0 ? availableCoreNum : 1;
    if (blockNum > tileNum)
        blockNum = tileNum;

    if (info_x.tensors[0].dtype == 1)
        sub_custom<half><<<blockNum, nullptr, stream>>>(x, y, z, totalLength, TILE_ELEMENTS);
    else
        sub_custom<float><<<blockNum, nullptr, stream>>>(x, y, z, totalLength, TILE_ELEMENTS);
}