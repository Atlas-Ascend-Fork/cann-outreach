#include <algorithm>
#include <cmath>
#include <cstdint>
#include "kernel_operator.h"
/*
 * Sub Kernel — Ascend C Direct Invocation
 * This file is #included by the entry source. Do not add main().
 *
 * z = x - y, elementwise. Supports fp16/fp32.
 */

constexpr int64_t kPipelineDepth = 2;
constexpr uint32_t kTileBytes = 8192;

template <typename T>
__global__ __aicore__ __vector__ void sub_custom(
    GM_ADDR x,
    GM_ADDR y,
    GM_ADDR z,
    int64_t totalLength,
    int64_t blockLength,
    uint32_t tileBytes)
{
    AscendC::TPipe pipe;
    AscendC::TQue<AscendC::QuePosition::VECIN, kPipelineDepth> inQueueX;
    AscendC::TQue<AscendC::QuePosition::VECIN, kPipelineDepth> inQueueY;
    AscendC::TQue<AscendC::QuePosition::VECOUT, kPipelineDepth> outQueueZ;
    pipe.InitBuffer(inQueueX, kPipelineDepth, tileBytes);
    pipe.InitBuffer(inQueueY, kPipelineDepth, tileBytes);
    pipe.InitBuffer(outQueueZ, kPipelineDepth, tileBytes);

    int64_t blockStart = blockLength * static_cast<int64_t>(AscendC::GetBlockIdx());
    int64_t currentBlockLength = totalLength - blockStart;
    if (currentBlockLength > blockLength) {
        currentBlockLength = blockLength;
    }
    if (currentBlockLength <= 0) {
        return;
    }

    AscendC::GlobalTensor<T> xGm;
    AscendC::GlobalTensor<T> yGm;
    AscendC::GlobalTensor<T> zGm;
    xGm.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(x) + blockStart);
    yGm.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(y) + blockStart);
    zGm.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(z) + blockStart);

    int64_t elementNumPerTile = static_cast<int64_t>(tileBytes) / static_cast<int64_t>(sizeof(T));
    AscendC::DataCopyPadExtParams<T> padParams{false, 0, 0, 0};

    for (int64_t offset = 0; offset < currentBlockLength; offset += elementNumPerTile) {
        int64_t elementNum = currentBlockLength - offset;
        if (elementNum > elementNumPerTile) {
            elementNum = elementNumPerTile;
        }
        AscendC::DataCopyExtParams copyParams{1, static_cast<uint32_t>(elementNum * sizeof(T)), 0, 0, 0};

        AscendC::LocalTensor<T> xLocal = inQueueX.AllocTensor<T>();
        AscendC::LocalTensor<T> yLocal = inQueueY.AllocTensor<T>();
        AscendC::DataCopyPad(xLocal, xGm[offset], copyParams, padParams);
        AscendC::DataCopyPad(yLocal, yGm[offset], copyParams, padParams);
        inQueueX.EnQue(xLocal);
        inQueueY.EnQue(yLocal);

        xLocal = inQueueX.DeQue<T>();
        yLocal = inQueueY.DeQue<T>();
        AscendC::LocalTensor<T> zLocal = outQueueZ.AllocTensor<T>();
        AscendC::Sub(zLocal, xLocal, yLocal, static_cast<int32_t>(elementNum));
        outQueueZ.EnQue(zLocal);
        inQueueX.FreeTensor(xLocal);
        inQueueY.FreeTensor(yLocal);

        zLocal = outQueueZ.DeQue<T>();
        AscendC::DataCopyPad(zGm[offset], zLocal, copyParams);
        outQueueZ.FreeTensor(zLocal);
    }
}

static int64_t numelOf(const TensorGroupInfo& group)
{
    if (group.numTensors <= 0) {
        return 0;
    }
    const TensorInfo& tensor = group.tensors[0];
    int64_t numel = 1;
    for (int64_t i = 0; i < tensor.numDims; ++i) {
        numel *= tensor.shape[i];
    }
    return numel;
}

extern "C" void run_kernel(
    GM_ADDR x,
    const TensorGroupInfo& info_x,
    GM_ADDR y,
    const TensorGroupInfo& info_y,
    GM_ADDR z,
    const TensorGroupInfo& info_z,
    int64_t availableCoreNum,
    aclrtStream stream)
{
    int64_t totalLength = numelOf(info_z);
    if (totalLength <= 0) {
        totalLength = numelOf(info_x);
    }
    if (totalLength <= 0) {
        return;
    }

    constexpr int64_t kMinElemsPerCore = 1024;
    int64_t coreNum = availableCoreNum > 0 ? availableCoreNum : 1;
    int64_t numBlocks = (totalLength + kMinElemsPerCore - 1) / kMinElemsPerCore;
    numBlocks = std::min(numBlocks, coreNum);
    numBlocks = std::max(numBlocks, static_cast<int64_t>(1));
    int64_t blockLength = (totalLength + numBlocks - 1) / numBlocks;

    int32_t dtype = info_x.numTensors > 0 ? info_x.tensors[0].dtype : 0;
    if (dtype == 1) {
        sub_custom<half><<<numBlocks, nullptr, stream>>>(
            x, y, z, totalLength, blockLength, kTileBytes);
    } else {
        sub_custom<float><<<numBlocks, nullptr, stream>>>(
            x, y, z, totalLength, blockLength, kTileBytes);
    }
}