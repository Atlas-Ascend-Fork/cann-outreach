#include <cmath>
#include <cstdint>
#include "kernel_operator.h"

namespace {
constexpr uint32_t SUB_TILE_LENGTH = 4096;
constexpr uint32_t SUB_BUFFER_NUM = 2;
}

template <typename T>
class KernelSub {
public:
    __aicore__ inline explicit KernelSub(AscendC::TPipe* pipe) : pipe_(pipe) {}

    __aicore__ inline void Init(GM_ADDR x, GM_ADDR y, GM_ADDR z,
                                uint32_t totalLength, uint32_t tilesPerCore)
    {
        uint32_t totalTiles = (totalLength + SUB_TILE_LENGTH - 1) / SUB_TILE_LENGTH;
        uint32_t blockIdx = AscendC::GetBlockIdx();
        uint32_t startTile = blockIdx * tilesPerCore;
        if (startTile >= totalTiles) {
            return;
        }
        uint32_t endTile = startTile + tilesPerCore;
        if (endTile > totalTiles) {
            endTile = totalTiles;
        }
        tileNum_ = endTile - startTile;

        uint64_t startOffset = static_cast<uint64_t>(startTile) * SUB_TILE_LENGTH;
        uint64_t coreLength = static_cast<uint64_t>(totalLength) - startOffset;
        uint64_t coreSpan = static_cast<uint64_t>(tileNum_) * SUB_TILE_LENGTH;
        coreLength_ = static_cast<uint32_t>(coreLength < coreSpan ? coreLength : coreSpan);

        xGm_.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(x) + startOffset, coreLength_);
        yGm_.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(y) + startOffset, coreLength_);
        zGm_.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(z) + startOffset, coreLength_);

        pipe_->InitBuffer(inQueueX_, SUB_BUFFER_NUM, SUB_TILE_LENGTH * sizeof(T));
        pipe_->InitBuffer(inQueueY_, SUB_BUFFER_NUM, SUB_TILE_LENGTH * sizeof(T));
        pipe_->InitBuffer(outQueueZ_, SUB_BUFFER_NUM, SUB_TILE_LENGTH * sizeof(T));
    }

    __aicore__ inline void Process()
    {
        for (uint32_t i = 0; i < tileNum_; ++i) {
            uint32_t offset = i * SUB_TILE_LENGTH;
            uint32_t count = coreLength_ - offset;
            if (count > SUB_TILE_LENGTH) {
                count = SUB_TILE_LENGTH;
            }
            CopyIn(offset, count);
            Compute(count);
            CopyOut(offset, count);
        }
    }

private:
    __aicore__ inline void CopyIn(uint32_t offset, uint32_t count)
    {
        AscendC::LocalTensor<T> xLocal = inQueueX_.template AllocTensor<T>();
        AscendC::LocalTensor<T> yLocal = inQueueY_.template AllocTensor<T>();

        AscendC::DataCopyExtParams copyParams{
            1, static_cast<uint32_t>(count * sizeof(T)), 0, 0, 0};
        AscendC::DataCopyPadExtParams<T> padParams{false, 0, 0, 0};
        AscendC::DataCopyPad(xLocal, xGm_[offset], copyParams, padParams);
        AscendC::DataCopyPad(yLocal, yGm_[offset], copyParams, padParams);

        inQueueX_.EnQue(xLocal);
        inQueueY_.EnQue(yLocal);
    }

    __aicore__ inline void Compute(uint32_t count)
    {
        AscendC::LocalTensor<T> xLocal = inQueueX_.template DeQue<T>();
        AscendC::LocalTensor<T> yLocal = inQueueY_.template DeQue<T>();
        AscendC::LocalTensor<T> zLocal = outQueueZ_.template AllocTensor<T>();

        AscendC::Sub(zLocal, xLocal, yLocal, static_cast<int32_t>(count));

        outQueueZ_.EnQue(zLocal);
        inQueueX_.FreeTensor(xLocal);
        inQueueY_.FreeTensor(yLocal);
    }

    __aicore__ inline void CopyOut(uint32_t offset, uint32_t count)
    {
        AscendC::LocalTensor<T> zLocal = outQueueZ_.template DeQue<T>();

        AscendC::DataCopyExtParams copyParams{
            1, static_cast<uint32_t>(count * sizeof(T)), 0, 0, 0};
        AscendC::DataCopyPad(zGm_[offset], zLocal, copyParams);

        outQueueZ_.FreeTensor(zLocal);
    }

    AscendC::TPipe* pipe_;
    AscendC::GlobalTensor<T> xGm_;
    AscendC::GlobalTensor<T> yGm_;
    AscendC::GlobalTensor<T> zGm_;
    AscendC::TQue<AscendC::TPosition::VECIN, 1> inQueueX_;
    AscendC::TQue<AscendC::TPosition::VECIN, 1> inQueueY_;
    AscendC::TQue<AscendC::TPosition::VECOUT, 1> outQueueZ_;
    uint32_t tileNum_ = 0;
    uint32_t coreLength_ = 0;
};

extern "C" __global__ __vector__ void sub_custom_fp32(
    GM_ADDR x, GM_ADDR y, GM_ADDR z, uint32_t totalLength, uint32_t tilesPerCore)
{
    AscendC::TPipe pipe;
    KernelSub<float> op(&pipe);
    op.Init(x, y, z, totalLength, tilesPerCore);
    op.Process();
}

extern "C" __global__ __vector__ void sub_custom_fp16(
    GM_ADDR x, GM_ADDR y, GM_ADDR z, uint32_t totalLength, uint32_t tilesPerCore)
{
    AscendC::TPipe pipe;
    KernelSub<half> op(&pipe);
    op.Init(x, y, z, totalLength, tilesPerCore);
    op.Process();
}

extern "C" void run_kernel(
    GM_ADDR x,
    const TensorGroupInfo& info_x,
    GM_ADDR y,
    const TensorGroupInfo& info_y,
    GM_ADDR z,
    const TensorGroupInfo& info_z,
    int64_t availableCoreNum,
    aclrtStream stream)
{
    const TensorInfo& inputInfo = info_x.tensors[0];
    uint32_t totalLength = 1;
    for (int64_t i = 0; i < inputInfo.numDims; ++i) {
        totalLength *= static_cast<uint32_t>(inputInfo.shape[i]);
    }
    if (totalLength == 0) {
        return;
    }

    uint32_t totalTiles = (totalLength + SUB_TILE_LENGTH - 1) / SUB_TILE_LENGTH;
    uint32_t cores = availableCoreNum > 0 ? static_cast<uint32_t>(availableCoreNum) : 1;
    uint32_t tilesPerCore = (totalTiles + cores - 1) / cores;
    uint32_t blockNum = (totalTiles + tilesPerCore - 1) / tilesPerCore;

    if (inputInfo.dtype == 1) {
        sub_custom_fp16<<<blockNum, nullptr, stream>>>(x, y, z, totalLength, tilesPerCore);
    } else {
        sub_custom_fp32<<<blockNum, nullptr, stream>>>(x, y, z, totalLength, tilesPerCore);
    }
}