#include <cmath>
#include "kernel_operator.h"

/*
 * Sub kernel: z = x - y (element-wise), Ascend C direct invocation.
 * Host entry run_kernel() dispatches on the tensor dtype (0=fp32, 1=fp16).
 */

namespace {
constexpr int64_t kUbTileBytes = 16384;    // UB buffer size per queue
constexpr int64_t kMinElemsPerCore = 256;  // lower bound when splitting across cores
}  // namespace

template <typename T>
class KernelSub {
public:
    __aicore__ inline KernelSub() = default;

    __aicore__ inline void Init(GM_ADDR x, GM_ADDR y, GM_ADDR z,
                                int64_t totalLength, int64_t blockLength)
    {
        int64_t start = static_cast<int64_t>(AscendC::GetBlockIdx()) * blockLength;
        int64_t remain = totalLength - start;
        if (remain < 0) {
            remain = 0;
        }
        length_ = remain < blockLength ? remain : blockLength;

        xGm_.SetGlobalBuffer((__gm__ T*)x + start, length_);
        yGm_.SetGlobalBuffer((__gm__ T*)y + start, length_);
        zGm_.SetGlobalBuffer((__gm__ T*)z + start, length_);

        pipe_.InitBuffer(inQueueX_, 1, kUbTileBytes);
        pipe_.InitBuffer(inQueueY_, 1, kUbTileBytes);
        pipe_.InitBuffer(outQueueZ_, 1, kUbTileBytes);
    }

    __aicore__ inline void Process()
    {
        constexpr int64_t tileElements = kUbTileBytes / (int64_t)sizeof(T);
        for (int64_t offset = 0; offset < length_; offset += tileElements) {
            int64_t count = length_ - offset;
            if (count > tileElements) {
                count = tileElements;
            }

            AscendC::LocalTensor<T> xLocal = inQueueX_.AllocTensor<T>();
            AscendC::LocalTensor<T> yLocal = inQueueY_.AllocTensor<T>();
            AscendC::DataCopy(xLocal, xGm_[offset], count);
            AscendC::DataCopy(yLocal, yGm_[offset], count);

            inQueueX_.EnQue(xLocal);
            inQueueY_.EnQue(yLocal);
            xLocal = inQueueX_.DeQue<T>();
            yLocal = inQueueY_.DeQue<T>();

            AscendC::LocalTensor<T> zLocal = outQueueZ_.AllocTensor<T>();
            AscendC::Sub(zLocal, xLocal, yLocal, count);
            outQueueZ_.EnQue(zLocal);
            inQueueX_.FreeTensor(xLocal);
            inQueueY_.FreeTensor(yLocal);

            zLocal = outQueueZ_.DeQue<T>();
            AscendC::DataCopy(zGm_[offset], zLocal, count);
            outQueueZ_.FreeTensor(zLocal);
        }
    }

private:
    AscendC::TPipe pipe_;
    AscendC::TQue<AscendC::TPosition::VECIN, 1> inQueueX_;
    AscendC::TQue<AscendC::TPosition::VECIN, 1> inQueueY_;
    AscendC::TQue<AscendC::TPosition::VECOUT, 1> outQueueZ_;
    AscendC::GlobalTensor<T> xGm_;
    AscendC::GlobalTensor<T> yGm_;
    AscendC::GlobalTensor<T> zGm_;
    int64_t length_ = 0;
};

__global__ __vector__ void sub_custom_float(GM_ADDR x, GM_ADDR y, GM_ADDR z,
                                            int64_t totalLength, int64_t blockLength)
{
    KernelSub<float> op;
    op.Init(x, y, z, totalLength, blockLength);
    op.Process();
}

__global__ __vector__ void sub_custom_half(GM_ADDR x, GM_ADDR y, GM_ADDR z,
                                           int64_t totalLength, int64_t blockLength)
{
    KernelSub<half> op;
    op.Init(x, y, z, totalLength, blockLength);
    op.Process();
}

static int64_t TensorLength(const TensorGroupInfo& info)
{
    if (info.numTensors <= 0) {
        return 0;
    }
    const TensorInfo& tensor = info.tensors[0];
    int64_t length = 1;
    for (int64_t i = 0; i < tensor.numDims; ++i) {
        length *= tensor.shape[i];
    }
    return length;
}

extern "C" void run_kernel(
    GM_ADDR x,
    const TensorGroupInfo& info_x,
    GM_ADDR y,
    const TensorGroupInfo& info_y,
    GM_ADDR z,
    const TensorGroupInfo& info_z,
    int64_t availableCoreNum,
    aclrtStream stream)
{
    (void)info_y;
    (void)info_z;

    int64_t totalLength = TensorLength(info_x);
    int32_t dtype = info_x.tensors[0].dtype;

    int64_t numBlocks = availableCoreNum > 0 ? availableCoreNum : 1;
    int64_t maxBlocks = totalLength / kMinElemsPerCore;
    if (maxBlocks < 1) {
        maxBlocks = 1;
    }
    if (numBlocks > maxBlocks) {
        numBlocks = maxBlocks;
    }

    // Keep every core's start offset 32B aligned so DataCopy stays aligned.
    int64_t align = (dtype == 1) ? 16 : 8;
    int64_t blockLength =
        ((totalLength + numBlocks - 1) / numBlocks + align - 1) / align * align;

    if (dtype == 1) {
        sub_custom_half<<<(uint32_t)numBlocks, nullptr, stream>>>(
            x, y, z, totalLength, blockLength);
    } else {
        sub_custom_float<<<(uint32_t)numBlocks, nullptr, stream>>>(
            x, y, z, totalLength, blockLength);
    }
}
