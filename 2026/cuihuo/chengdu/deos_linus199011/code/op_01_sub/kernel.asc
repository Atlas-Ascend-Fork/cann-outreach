#include <cstdint>
#include "kernel_operator.h"
/*
 * Sub Kernel — Ascend C Direct Invocation
 * z = x - y, elementwise, contiguous.
 * Supports dtype 0 (float32) and 1 (float16).
 */

namespace {

constexpr uint32_t kTileElems = 2048;

template <typename T>
__aicore__ inline void SubImpl(GM_ADDR x, GM_ADDR y, GM_ADDR z, uint32_t total)
{
    const uint32_t blockNum = AscendC::GetBlockNum();
    const uint32_t blockIdx = AscendC::GetBlockIdx();
    const uint32_t perCore = (total + blockNum - 1) / blockNum;
    const uint32_t start = blockIdx * perCore;
    if (start >= total) {
        return;
    }
    const uint32_t count = (total - start < perCore) ? (total - start) : perCore;

    AscendC::TPipe pipe;
    AscendC::TQue<AscendC::TPosition::VECIN, 1> inQueueX;
    AscendC::TQue<AscendC::TPosition::VECIN, 1> inQueueY;
    AscendC::TQue<AscendC::TPosition::VECOUT, 1> outQueueZ;
    pipe.InitBuffer(inQueueX, 1, kTileElems * sizeof(T));
    pipe.InitBuffer(inQueueY, 1, kTileElems * sizeof(T));
    pipe.InitBuffer(outQueueZ, 1, kTileElems * sizeof(T));

    for (uint32_t off = 0; off < count; off += kTileElems) {
        const uint32_t n = (count - off < kTileElems) ? (count - off) : kTileElems;
        const uint16_t bytes = static_cast<uint16_t>(n * sizeof(T));

        AscendC::GlobalTensor<T> xGm;
        AscendC::GlobalTensor<T> yGm;
        AscendC::GlobalTensor<T> zGm;
        xGm.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(x) + start + off, n);
        yGm.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(y) + start + off, n);
        zGm.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(z) + start + off, n);

        AscendC::LocalTensor<T> xLocal = inQueueX.AllocTensor<T>();
        AscendC::LocalTensor<T> yLocal = inQueueY.AllocTensor<T>();
        AscendC::DataCopyPad(xLocal, xGm, {1, bytes, 0, 0}, {false, 0, 0, 0});
        AscendC::DataCopyPad(yLocal, yGm, {1, bytes, 0, 0}, {false, 0, 0, 0});
        inQueueX.EnQue(xLocal);
        inQueueY.EnQue(yLocal);

        xLocal = inQueueX.DeQue<T>();
        yLocal = inQueueY.DeQue<T>();
        AscendC::LocalTensor<T> zLocal = outQueueZ.AllocTensor<T>();
        AscendC::Sub(zLocal, xLocal, yLocal, n);
        outQueueZ.EnQue<T>(zLocal);
        inQueueX.FreeTensor(xLocal);
        inQueueY.FreeTensor(yLocal);

        zLocal = outQueueZ.DeQue<T>();
        AscendC::DataCopyPad(zGm, zLocal, {1, bytes, 0, 0});
        outQueueZ.FreeTensor(zLocal);
    }
}

}  // namespace

extern "C" __global__ __vector__ void sub_custom_fp32(
    GM_ADDR x, GM_ADDR y, GM_ADDR z, uint32_t total)
{
    SubImpl<float>(x, y, z, total);
}

extern "C" __global__ __vector__ void sub_custom_fp16(
    GM_ADDR x, GM_ADDR y, GM_ADDR z, uint32_t total)
{
    SubImpl<half>(x, y, z, total);
}

extern "C" void run_kernel(
    GM_ADDR x,
    const TensorGroupInfo& info_x,
    GM_ADDR y,
    const TensorGroupInfo& info_y,
    GM_ADDR z,
    const TensorGroupInfo& info_z,
    int64_t availableCoreNum,
    aclrtStream stream)
{
    const TensorInfo& tx = info_x.tensors[0];
    uint32_t total = 1;
    for (int64_t i = 0; i < tx.numDims; ++i) {
        total *= static_cast<uint32_t>(tx.shape[i]);
    }
    if (total == 0) {
        return;
    }

    uint32_t blockNum = (availableCoreNum > 0) ? static_cast<uint32_t>(availableCoreNum) : 1;
    if (blockNum > total) {
        blockNum = total;
    }

    if (tx.dtype == 0) {
        sub_custom_fp32<<<blockNum, nullptr, stream>>>(x, y, z, total);
    } else if (tx.dtype == 1) {
        sub_custom_fp16<<<blockNum, nullptr, stream>>>(x, y, z, total);
    }
}
