#include <cmath>
#include <cstdint>
#include "kernel_operator.h"
/*
 * Sub Kernel — Ascend C Direct Invocation
 * This file is #included by the entry source. Do not add main().
 *
 * TensorGroupInfo / TensorInfo (predefined):
 *   #define GM_ADDR __gm__ uint8_t*
 *   struct TensorInfo {
 *       const int64_t* shape;
 *       int64_t numDims;
 *       int32_t dtype;
 *   };
 *   struct TensorGroupInfo {
 *       const TensorInfo* tensors;
 *       int64_t numTensors;
 *   };
 *   dtype: 0=float32 1=float16 2=bfloat16 3=int8 4=int16 5=int32 6=int64
 *          7=uint8 8=uint16 9=uint32 10=uint64 11=bool
 *          12=float64 13=complex32 14=complex64 15=complex128
 *   Usage: info_x.tensors[0].shape[0]  // first dim of first tensor in input x
 *
 * __global__ __vector__ void sub_custom(...)
 * {
 *     // TODO: implement your kernel logic
 *     // Available APIs: AscendC::TPipe, AscendC::TQue, AscendC::DataCopy, AscendC::Add, ...
 * }
 */

using namespace AscendC;

namespace {

constexpr int64_t kMaxTileElems = 4096;

template <typename T>
class SubKernel {
public:
    __aicore__ inline SubKernel() {}

    __aicore__ inline void Init(GM_ADDR x, GM_ADDR y, GM_ADDR z,
                                int64_t totalLen, int64_t offset, int64_t len,
                                int64_t tileLen)
    {
        xGm_.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(x), totalLen);
        yGm_.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(y), totalLen);
        zGm_.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(z), totalLen);
        offset_ = offset;
        len_ = len;
        tileLen_ = tileLen;
        pipe_.InitBuffer(inQueueX_, 1, tileLen_ * sizeof(T));
        pipe_.InitBuffer(inQueueY_, 1, tileLen_ * sizeof(T));
        pipe_.InitBuffer(outQueueZ_, 1, tileLen_ * sizeof(T));
    }

    __aicore__ inline void Process()
    {
        for (int64_t start = 0; start < len_; start += tileLen_) {
            int64_t count = len_ - start;
            if (count > tileLen_) {
                count = tileLen_;
            }
            CopyIn(start, count);
            Compute(count);
            CopyOut(start, count);
        }
    }

private:
    __aicore__ inline void CopyIn(int64_t start, int64_t count)
    {
        LocalTensor<T> xLocal = inQueueX_.AllocTensor<T>();
        LocalTensor<T> yLocal = inQueueY_.AllocTensor<T>();
        DataCopy(xLocal, xGm_[offset_ + start], static_cast<uint32_t>(count));
        DataCopy(yLocal, yGm_[offset_ + start], static_cast<uint32_t>(count));
        inQueueX_.EnQue(xLocal);
        inQueueY_.EnQue(yLocal);
    }

    __aicore__ inline void Compute(int64_t count)
    {
        LocalTensor<T> xLocal = inQueueX_.DeQue<T>();
        LocalTensor<T> yLocal = inQueueY_.DeQue<T>();
        LocalTensor<T> zLocal = outQueueZ_.AllocTensor<T>();
        Sub(zLocal, xLocal, yLocal, static_cast<int32_t>(count));
        outQueueZ_.EnQue(zLocal);
        inQueueX_.FreeTensor(xLocal);
        inQueueY_.FreeTensor(yLocal);
    }

    __aicore__ inline void CopyOut(int64_t start, int64_t count)
    {
        LocalTensor<T> zLocal = outQueueZ_.DeQue<T>();
        DataCopy(zGm_[offset_ + start], zLocal, static_cast<uint32_t>(count));
        outQueueZ_.FreeTensor(zLocal);
    }

    TPipe pipe_;
    TQue<QuePosition::VECIN, 1> inQueueX_;
    TQue<QuePosition::VECIN, 1> inQueueY_;
    TQue<QuePosition::VECOUT, 1> outQueueZ_;
    GlobalTensor<T> xGm_, yGm_, zGm_;
    int64_t offset_ = 0;
    int64_t len_ = 0;
    int64_t tileLen_ = 0;
};

}  // namespace

__global__ __vector__ void sub_custom_fp32(
    GM_ADDR x, GM_ADDR y, GM_ADDR z,
    int64_t totalLen, int64_t coreLen, int64_t tileLen)
{
    int64_t offset = static_cast<int64_t>(GetBlockIdx()) * coreLen;
    int64_t len = totalLen - offset;
    if (len <= 0) {
        return;
    }
    if (len > coreLen) {
        len = coreLen;
    }
    SubKernel<float> op;
    op.Init(x, y, z, totalLen, offset, len, tileLen);
    op.Process();
}

__global__ __vector__ void sub_custom_fp16(
    GM_ADDR x, GM_ADDR y, GM_ADDR z,
    int64_t totalLen, int64_t coreLen, int64_t tileLen)
{
    int64_t offset = static_cast<int64_t>(GetBlockIdx()) * coreLen;
    int64_t len = totalLen - offset;
    if (len <= 0) {
        return;
    }
    if (len > coreLen) {
        len = coreLen;
    }
    SubKernel<half> op;
    op.Init(x, y, z, totalLen, offset, len, tileLen);
    op.Process();
}

static int64_t ShapeSize(const TensorInfo& info)
{
    int64_t size = 1;
    for (int64_t i = 0; i < info.numDims; ++i) {
        size *= info.shape[i];
    }
    return size;
}

extern "C" void run_kernel(
    GM_ADDR x,
    const TensorGroupInfo& info_x,
    GM_ADDR y,
    const TensorGroupInfo& info_y,
    GM_ADDR z,
    const TensorGroupInfo& info_z,
    int64_t availableCoreNum,
    aclrtStream stream)
{
    const int64_t totalLen = ShapeSize(info_x.tensors[0]);
    if (totalLen <= 0) {
        return;
    }

    const int32_t dtype = info_x.tensors[0].dtype;
    const int64_t alignElems = (dtype == 1) ? 16 : 8;  // 32 bytes

    int64_t blockNum = 1;
    for (int64_t candidate = 1;
         candidate <= availableCoreNum && candidate <= totalLen; ++candidate) {
        if (totalLen % candidate != 0) {
            continue;
        }
        if ((totalLen / candidate) % alignElems != 0) {
            continue;
        }
        blockNum = candidate;
    }

    const int64_t coreLen = totalLen / blockNum;
    const int64_t tileLen = coreLen < kMaxTileElems ? coreLen : kMaxTileElems;

    if (dtype == 1) {
        sub_custom_fp16<<<blockNum, nullptr, stream>>>(
            x, y, z, totalLen, coreLen, tileLen);
    } else {
        sub_custom_fp32<<<blockNum, nullptr, stream>>>(
            x, y, z, totalLen, coreLen, tileLen);
    }
}