  #include <cstdint>
  #include "kernel_operator.h"
  /*
   * Sub Kernel — Ascend C Direct Invocation
   * z = x - y (elementwise, fp16 / fp32)
   *
   * This file is #included by the entry source. Do not add main().
   */

  namespace {

  constexpr int64_t kTileElems = 2048;

  template <typename T>
  class KernelSub {
  public:
      __aicore__ inline void Init(GM_ADDR x, GM_ADDR y, GM_ADDR z, int64_t total)
      {
          const int64_t alignElems = static_cast<int64_t>(32 / sizeof(T));
          const int64_t blockNum = static_cast<int64_t>(AscendC::GetBlockNum());
          const int64_t blockIdx = static_cast<int64_t>(AscendC::GetBlockIdx());

          // Split [0, total) into contiguous per-core chunks, aligned to 32B.
          chunk_ = (total + blockNum - 1) / blockNum;
          chunk_ = ((chunk_ + alignElems - 1) / alignElems) * alignElems;
          start_ = blockIdx * chunk_;
          count_ = start_ < total ? (chunk_ < total - start_ ? chunk_ : total - start_) : 0;

          const int64_t tile = chunk_ < kTileElems ? chunk_ : kTileElems;
          const uint32_t bytes = static_cast<uint32_t>(tile * sizeof(T));
          pipe_.InitBuffer(inX_, 2, bytes);
          pipe_.InitBuffer(inY_, 2, bytes);
          pipe_.InitBuffer(outZ_, 2, bytes);

          if (count_ == 0) {
              return;
          }
          xGm_.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(x) + start_, count_);
          yGm_.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(y) + start_, count_);
          zGm_.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(z) + start_, count_);
      }

      __aicore__ inline void Process()
      {
          if (count_ == 0) {
              return;
          }
          for (int64_t offset = 0; offset < count_; offset += kTileElems) {
              const int64_t remain = count_ - offset;
              const uint32_t n = static_cast<uint32_t>(remain < kTileElems ? remain : kTileElems);

              AscendC::LocalTensor<T> xLocal = inX_.template AllocTensor<T>();
              AscendC::LocalTensor<T> yLocal = inY_.template AllocTensor<T>();
              AscendC::DataCopy(xLocal, xGm_[offset], n);
              AscendC::DataCopy(yLocal, yGm_[offset], n);
              inX_.EnQue(xLocal);
              inY_.EnQue(yLocal);

              xLocal = inX_.template DeQue<T>();
              yLocal = inY_.template DeQue<T>();
              AscendC::LocalTensor<T> zLocal = outZ_.template AllocTensor<T>();
              AscendC::Sub(zLocal, xLocal, yLocal, n);
              outZ_.EnQue<T>(zLocal);
              inX_.FreeTensor(xLocal);
              inY_.FreeTensor(yLocal);

              zLocal = outZ_.template DeQue<T>();
              AscendC::DataCopy(zGm_[offset], zLocal, n);
              outZ_.FreeTensor(zLocal);
          }
      }

  private:
      AscendC::TPipe pipe_;
      AscendC::TQue<AscendC::TPosition::VECIN, 2> inX_;
      AscendC::TQue<AscendC::TPosition::VECIN, 2> inY_;
      AscendC::TQue<AscendC::TPosition::VECOUT, 2> outZ_;
      AscendC::GlobalTensor<T> xGm_;
      AscendC::GlobalTensor<T> yGm_;
      AscendC::GlobalTensor<T> zGm_;
      int64_t start_ = 0;
      int64_t count_ = 0;
      int64_t chunk_ = 0;
  };

  }  // namespace

  __global__ __vector__ void sub_custom_fp32(GM_ADDR x, GM_ADDR y, GM_ADDR z, int64_t total)
  {
      KernelSub<float> op;
      op.Init(x, y, z, total);
      op.Process();
      AscendC::PipeBarrier<PIPE_ALL>();
  }

  __global__ __vector__ void sub_custom_fp16(GM_ADDR x, GM_ADDR y, GM_ADDR z, int64_t total)
  {
      KernelSub<half> op;
      op.Init(x, y, z, total);
      op.Process();
      AscendC::PipeBarrier<PIPE_ALL>();
  }

  extern "C" void run_kernel(
      GM_ADDR x,
      const TensorGroupInfo& info_x,
      GM_ADDR y,
      const TensorGroupInfo& info_y,
      GM_ADDR z,
      const TensorGroupInfo& info_z,
      int64_t availableCoreNum,
      aclrtStream stream)
  {
      (void)info_y;
      (void)info_z;
      if (info_x.numTensors < 1) {
          return;
      }
      const TensorInfo& tensor = info_x.tensors[0];
      int64_t total = 1;
      for (int64_t i = 0; i < tensor.numDims; ++i) {
          total *= tensor.shape[i];
      }
      if (total <= 0) {
          return;
      }

      int64_t maxBlocks = total / 1024;
      if (maxBlocks < 1) {
          maxBlocks = 1;
      }
      int64_t blockNum = availableCoreNum > 0 ? availableCoreNum : 1;
      if (blockNum > maxBlocks) {
          blockNum = maxBlocks;
      }

      if (tensor.dtype == 0) {
          sub_custom_fp32<<<blockNum, nullptr, stream>>>(x, y, z, total);
      } else if (tensor.dtype == 1) {
          sub_custom_fp16<<<blockNum, nullptr, stream>>>(x, y, z, total);
      }
  }
