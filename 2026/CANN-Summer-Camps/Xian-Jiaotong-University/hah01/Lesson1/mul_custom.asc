// mul_custom.asc
#include <cstdint>
#include <iostream>
#include <vector>
#include <algorithm>
#include <iterator>
#include "acl/acl.h"
#include "kernel_operator.h"

using namespace AscendC;

constexpr uint32_t BUFFER_NUM = 2; // tensor num for each queue
constexpr uint32_t TILE_ELEM = 2048;

struct MulCustomTilingData
{
    uint32_t totalLength;
    uint32_t tileNum;
};

class KernelMul {
public:
    __aicore__ inline KernelMul() {}

    __aicore__ inline void Init(GM_ADDR x, GM_ADDR y, GM_ADDR z,
        uint32_t totalLength, uint32_t tileNum)
    {
        inputX.SetGlobalBuffer(
            reinterpret_cast<__gm__ float *>(x), totalLength);
        inputY.SetGlobalBuffer(
            reinterpret_cast<__gm__ float *>(y), totalLength);
        outputZ.SetGlobalBuffer(
            reinterpret_cast<__gm__ float *>(z), totalLength);

        elementCount = totalLength;

        const uint32_t requiredTiles =
            (totalLength + TILE_ELEM - 1U) / TILE_ELEM;

        tileCount =
            (tileNum == requiredTiles) ? tileNum : requiredTiles;

        pipe.InitBuffer(
            queueX, BUFFER_NUM, TILE_ELEM * sizeof(float));
        pipe.InitBuffer(
            queueY, BUFFER_NUM, TILE_ELEM * sizeof(float));
        pipe.InitBuffer(
            queueZ, BUFFER_NUM, TILE_ELEM * sizeof(float));
    }

    __aicore__ inline void Process()
    {
        for (uint32_t tile = 0; tile < tileCount; ++tile) {
            const uint32_t offset = tile * TILE_ELEM;
            const uint32_t remain = elementCount - offset;
            const uint32_t validCount =
                remain < TILE_ELEM ? remain : TILE_ELEM;

            LoadTile(offset, validCount);
            MultiplyTile(validCount);
            StoreTile(offset, validCount);
        }
    }

private:
    __aicore__ inline void LoadTile(
        uint32_t offset, uint32_t validCount)
    {
        LocalTensor<float> localX =
            queueX.AllocTensor<float>();
        LocalTensor<float> localY =
            queueY.AllocTensor<float>();

        DataCopy(localX, inputX[offset], validCount);
        DataCopy(localY, inputY[offset], validCount);

        queueX.EnQue(localX);
        queueY.EnQue(localY);
    }

    __aicore__ inline void MultiplyTile(
        uint32_t validCount)
    {
        LocalTensor<float> localX =
            queueX.DeQue<float>();
        LocalTensor<float> localY =
            queueY.DeQue<float>();
        LocalTensor<float> localZ =
            queueZ.AllocTensor<float>();

        Mul(
            localZ,
            localX,
            localY,
            static_cast<int32_t>(validCount));

        queueZ.EnQue(localZ);
        queueX.FreeTensor(localX);
        queueY.FreeTensor(localY);
    }

    __aicore__ inline void StoreTile(
        uint32_t offset, uint32_t validCount)
    {
        LocalTensor<float> localZ =
            queueZ.DeQue<float>();

        DataCopy(outputZ[offset], localZ, validCount);

        queueZ.FreeTensor(localZ);
    }

private:
    TPipe pipe;

    TQue<QuePosition::VECIN, BUFFER_NUM> queueX;
    TQue<QuePosition::VECIN, BUFFER_NUM> queueY;
    TQue<QuePosition::VECOUT, BUFFER_NUM> queueZ;

    GlobalTensor<float> inputX;
    GlobalTensor<float> inputY;
    GlobalTensor<float> outputZ;

    uint32_t elementCount = 0;
    uint32_t tileCount = 0;
};

__global__ __aicore__ void mul_custom(
    GM_ADDR x,
    GM_ADDR y,
    GM_ADDR z,
    MulCustomTilingData tiling)
{
    KernelMul kernel;

    kernel.Init(
        x,
        y,
        z,
        tiling.totalLength,
        tiling.tileNum);

    kernel.Process();
}

std::vector<float> kernel_mul(
    std::vector<float> &x,
    std::vector<float> &y)
{
    const size_t count = std::min(x.size(), y.size());
    std::vector<float> result(count);

    std::transform(
        x.begin(),
        x.begin() + count,
        y.begin(),
        result.begin(),
        [](float lhs, float rhs) {
            return lhs * rhs;
        });

    return result;
}

uint32_t VerifyResult(
    std::vector<float> &output,
    std::vector<float> &golden)
{
    auto printTensor =
        [](std::vector<float> &tensor, const char *name) {
            constexpr size_t maxPrintSize = 20;

            std::cout << name << ": ";

            std::copy(
                tensor.begin(),
                tensor.begin() +
                    std::min(tensor.size(), maxPrintSize),
                std::ostream_iterator<float>(
                    std::cout, " "));

            if (tensor.size() > maxPrintSize) {
                std::cout << "...";
            }

            std::cout << std::endl;
        };

    printTensor(output, "Output");
    printTensor(golden, "Golden");

    const bool sameSize =
        output.size() == golden.size();

    const bool sameValue =
        sameSize &&
        std::equal(
            output.begin(),
            output.end(),
            golden.begin());

    if (sameValue) {
        std::cout
            << "[Success] Case accuracy is verification passed."
            << std::endl;

        return 0;
    }

    std::cout
        << "[Failed] Case accuracy is verification failed!"
        << std::endl;

    return 1;
}

int32_t main(int32_t argc, char *argv[])
{
    constexpr uint32_t totalLength = 8 * 2048;
    constexpr float valueX = 1.2f;
    constexpr float valueY = 2.3f;

    std::vector<float> x(totalLength, valueX);
    std::vector<float> y(totalLength, valueY);

    std::vector<float> output =
        kernel_mul(x, y);

    std::vector<float> golden(
        totalLength,
        valueX * valueY);

    return VerifyResult(output, golden);
}
